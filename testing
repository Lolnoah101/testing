    local function AchievementDefinitionByTitle(
        Title
    )

        if not AchievementConfig
            or type(
                AchievementConfig.achievements
            ) ~= "table"
        then

            return nil
        end


        for _, Definition in pairs(
            AchievementConfig.achievements
        ) do

            if type(Definition)
                == "table"
                and tostring(
                    Definition.Title
                ) == tostring(
                    Title
                )
            then

                return Definition
            end
        end


        return nil
    end


    local function IsAchievementComplete(
        Data,
        Id
    )

        return Data
            and Data.achievements
            and Data.achievements.completed
            and Data.achievements.completed[
                Id
            ] == true
    end


    local function IsAchievementClaimed(
        Data,
        Id
    )

        return Data
            and Data.achievements
            and Data.achievements.claimed
            and Data.achievements.claimed[
                Id
            ] == true
    end


    local function AchievementProgress(
        Data,
        Id
    )

        return tonumber(
            Data
            and Data.achievements
            and Data.achievements.progress
            and Data.achievements.progress[
                Id
            ]
        ) or 0
    end


    local function NextAchievement(
        Data
    )

        if not AchievementConfig
            or type(
                AchievementConfig.order
            ) ~= "table"
        then

            return nil
        end


        for _, Id in ipairs(
            AchievementConfig.order
        ) do

            local Definition =
                AchievementConfig
                    .achievements[
                        Id
                    ]


            if Definition
                and Advanced.AchievementTargets[
                    Definition.Title
                ] == true
                and not IsAchievementComplete(
                    Data,
                    Id
                )
            then

                return Definition
            end
        end


        return nil
    end


    local function ClaimAchievement(
        Data,
        Definition
    )

        if Advanced
            .AutoClaimAchievementRewards
            ~= true
            or not IsLobby()
            or not LobbyPackets
            or not LobbyPackets
                .claimAchievementReward
            or IsAchievementClaimed(
                Data,
                Definition.Id
            )
        then

            return
        end


        if os.clock()
            - Runtime.LastAchievementClaim
            < 1.25
        then

            return
        end


        Runtime.LastAchievementClaim =
            os.clock()


        pcall(function()

            LobbyPackets
                .claimAchievementReward
                :fire({
                    achievementId =
                        Definition.Id,

                    requestId =
                        NextRequestId(),
                })
        end)
    end


