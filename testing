    UserInputService.InputChanged:Connect(
        function(input)
            if not dragging
                or input ~= dragInput
                or not dragStart
                or not startPosition then

                return
            end

            local delta =
                input.Position
                - dragStart

            frame.Position =
                UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset
                        + delta.X,
                    startPosition.Y.Scale,
                    startPosition.Y.Offset
                        + delta.Y
                )
        end
    )
end

