-- V31: Player > Skip Cutscenes (including chest reveals).
-- rather than simulating key presses or mutating camera state by hand.
-- BossCutscene.skip() also sends the correct BossCutsceneSkip server request.
do -- isolate cutscene state from the main chunk's Lua local-variable limit
local cutsceneSkip = {
    enabled = false,
    boss = nil,
    rebirth = nil,
    nextLoad = 0,
    nextScan = 0,
    bossLastAttempt = -100,
    bossLastId = nil,
    bossLastIdAt = -100,
    bossPending = nil,
    rebirthStarted = nil,
    rebirthSkipAttempt = nil,
    rebirthFallbackUsed = false,
}

local function getCutsceneController(name)
    local scripts = player:FindFirstChild("PlayerScripts")
    local folder = scripts and scripts:FindFirstChild("Controllers")
    local module = folder and folder:FindFirstChild(name)
    if not (module and module:IsA("ModuleScript")) then return nil end
    local ok, result = pcall(require, module)
    if ok and type(result) == "table" then return result end
    return nil
end

local function cutscenePlaying(controller)
    if not (controller and type(controller.isPlaying) == "function") then return false end
    local ok, active = pcall(controller.isPlaying)
    return ok and active == true
end

local function currentBossId(controller)
    if not (controller and type(controller.current) == "function") then return nil end
    local ok, payload = pcall(controller.current)
    if ok and type(payload) == "table" and type(payload.id) == "number" then
        return payload.id
    end
    return nil
end

-- The controller's isPlaying() checks the watch/camera state and may be false
-- during a newly received entrance. The MatchEvent payload is an additional
-- authoritative signal that a boss intro has actually begun.
local rawMatchEvent = ReplicatedStorage:FindFirstChild("Remotes")
rawMatchEvent = rawMatchEvent and rawMatchEvent:FindFirstChild("MatchEvent")
if rawMatchEvent and rawMatchEvent:IsA("RemoteEvent") then
    table.insert(s.connections, rawMatchEvent.OnClientEvent:Connect(function(packet)
        if not cutsceneSkip.enabled or type(packet) ~= "table" then return end
        if packet.type ~= "bossCutscene" then return end
        if type(packet.id) ~= "number" then return end
        cutsceneSkip.bossPending = {id = packet.id, at = os.clock(), remoteSent = false}
        cutsceneSkip.nextScan = 0
    end))
end

local function tickSkipCutscenes()
    if not cutsceneSkip.enabled then return end
    local now = os.clock()
    if now < cutsceneSkip.nextScan then return end
    cutsceneSkip.nextScan = now + 0.04

    -- Refresh missing modules after a new place loads.
    if now >= cutsceneSkip.nextLoad and (not cutsceneSkip.boss or not cutsceneSkip.rebirth) then
        cutsceneSkip.nextLoad = now + 0.7
        cutsceneSkip.boss = cutsceneSkip.boss or getCutsceneController("BossCutscene")
        cutsceneSkip.rebirth = cutsceneSkip.rebirth or getCutsceneController("RebirthCutscene")
    end

    local boss = cutsceneSkip.boss
    local bossId = currentBossId(boss)
    local pending = cutsceneSkip.bossPending
    local active = cutscenePlaying(boss)
    local matchingEvent = pending and bossId == pending.id

    -- Calling the controller's own skip also restores controls/camera and
    -- calls BossCutsceneSkip with the active ID. Do not manipulate the camera.
    if (active or matchingEvent or bossId ~= nil)
        and bossId ~= nil
        and not (bossId == cutsceneSkip.bossLastId and now - cutsceneSkip.bossLastIdAt < 20)
        and now - cutsceneSkip.bossLastAttempt >= 0.12
        and boss and type(boss.skip) == "function" then
        cutsceneSkip.bossLastAttempt = now
        local ok = pcall(boss.skip)
        if ok then
            cutsceneSkip.bossLastId = bossId
            cutsceneSkip.bossLastIdAt = now
            if matchingEvent then cutsceneSkip.bossPending = nil end
        end
    end

    -- If the incoming event arrived before the controller created its scene
    -- (or that module is unavailable), send the real skip remote once using
    -- the event's numeric ID. Never guess an ID or spam the server.
    pending = cutsceneSkip.bossPending
    if pending and now - pending.at >= 0.3
        and now - pending.at <= 2.5
        and not pending.remoteSent then
        if cutsceneSkip.bossLastId == pending.id then
            cutsceneSkip.bossPending = nil
        else
            local remoteFolder = ReplicatedStorage:FindFirstChild("Remotes")
            local remote = remoteFolder and remoteFolder:FindFirstChild("BossCutsceneSkip")
            if remote and remote:IsA("RemoteEvent") then
                pending.remoteSent = true
                pcall(function() remote:FireServer(pending.id) end)
            end
        end
    elseif pending and now - pending.at > 2.5 then
        cutsceneSkip.bossPending = nil
    end

    local rebirth = cutsceneSkip.rebirth
    if cutscenePlaying(rebirth) then
        if not cutsceneSkip.rebirthStarted then
            cutsceneSkip.rebirthStarted = now
            cutsceneSkip.rebirthFallbackUsed = false
            cutsceneSkip.rebirthSkipAttempt = now
            if type(rebirth.skip) == "function" then
                pcall(rebirth.skip)
            end
        elseif not cutsceneSkip.rebirthFallbackUsed
            and now - cutsceneSkip.rebirthSkipAttempt >= 0.75 then
            cutsceneSkip.rebirthFallbackUsed = true
            if type(rebirth.stop) == "function" then
                pcall(rebirth.stop)
            end
        end
    else
        cutsceneSkip.rebirthStarted = nil
        cutsceneSkip.rebirthSkipAttempt = nil
        cutsceneSkip.rebirthFallbackUsed = false
    end
end

table.insert(s.connections, RunService.Heartbeat:Connect(function()
    local ok, err = pcall(tickSkipCutscenes)
    if not ok and cutsceneSkip.enabled then
        warn("[HollowMoonHub Skip Cutscenes] " .. tostring(err))
        cutsceneSkip.nextScan = os.clock() + 0.5
    end
end))

