-- A model's runtime Name often contains level prefixes, spawn IDs or a
-- separate display name. Never assume the NpcDataLibrary key is its model Name.
local function compactNpcName(value)
    local text = tostring(value or ""):lower()
    text = text:gsub("%b[]", " "):gsub("%b()", " ")
    text = text:gsub("level%s*%d+", " "):gsub("lvl?%.?%s*%d+", " ")
    text = text:gsub("%s*#%d+%s*$", " "):gsub("%s+%d+%s*$", " ")
    local normalized = text:gsub("[^%w]", "")
    return normalized
end
-- Some NPCs (including Phantom Raiders) are nested rigs with their visible
-- identity on the parent Model or overhead BillboardGui, not on Humanoid.Name.
-- Resolve the whole nearby rig, but never look above the live NPC container.
local function identityNames(model, hum)
    local names, seen = {}, {}
    local function add(value)
        if type(value) ~= "string" then return end
        local label = value:gsub("^%s+", ""):gsub("%s+$", "")
        if label == "" or label == "Humanoid" or #label > 90 then return end
        if not seen[label] then
            seen[label] = true
            table.insert(names, label)
        end
    end
    local function inspect(obj)
        add(obj.Name)
        for _, attr in ipairs({"NPCName", "NpcName", "NPCType", "NpcType", "MobName",
            "BossName", "EntityName", "EnemyName", "DisplayName", "RealName",
            "CharacterName", "MobType", "NPCId", "NpcId"}) do
            add(obj:GetAttribute(attr))
        end
    end
    inspect(model)
    if hum then
        add(hum.DisplayName)
        for _, attr in ipairs({"NPCName", "DisplayName", "EnemyName", "NpcType"}) do
            add(hum:GetAttribute(attr))
        end
    end
    local ancestor = model.Parent
    for _ = 1, 3 do
        if not ancestor or ancestor == workspace then break end
        if ancestor:IsA("Model") then inspect(ancestor) end
        if ancestor.Name == "Live" or ancestor.Name == "NPC" or ancestor.Name == "NPCs"
            or ancestor.Name == "Enemies" or ancestor.Name == "Mobs" then break end
        ancestor = ancestor.Parent
    end
    -- Cache only short visual labels: a quest giver's unrelated UI text must
    -- not turn that NPC into a combat mob. The name matcher validates the label.
    local checked = 0
    for _, node in ipairs(model:GetDescendants()) do
        checked += 1
        if checked > 160 then break end
        if node:IsA("TextLabel") and node.Parent
            and (node:FindFirstAncestorOfClass("BillboardGui") ~= nil) then
            add(node.Text)
        elseif node:IsA("StringValue") and ({NPCName=true, NpcName=true,
            MobName=true, EnemyName=true, DisplayName=true, NPCType=true})[node.Name] then
            add(node.Value)
        end
    end
    return names
end
-- IdentityName labels can require a full descendant walk. Keep a short-lived
-- per-NPC cache rather than walking a Raider's BillboardGui every Heartbeat.
local function cachedIdentityNames(record)
    if not record or not record.Model or not record.Model.Parent then return {} end
    local now = os.clock()
    if not record.IdentityCache or now >= (record.IdentityRefreshAt or 0) then
        record.IdentityCache = identityNames(record.Model, record.Hum)
        record.IdentityRefreshAt = now + 2
    end
    return record.IdentityCache
end
local function characterBelongsToPlayer(model)
    local node = model
    for _ = 1, 5 do
        if not node or node == workspace then break end
        if node:IsA("Model") and Players:GetPlayerFromCharacter(node) then return true end
        node = node.Parent
    end
    return false
end
local function canonicalNpcName(model, hum)
    if not model or characterBelongsToPlayer(model) then return nil end
    local candidates = identityNames(model, hum)
    -- Exact match first; the alias resolves to the same backend NPC data.
    for _, raw in ipairs(candidates) do
        local key = compactNpcName(raw)
        for _, name in ipairs(AllNpcNames) do
            if key == compactNpcName(name) then return npcCanonical(name) end
        end
    end
    -- Account for runtime labels such as '[Lv. 6] Phantom Raider' or
    -- 'Phantom Raider #24'. Check longest names first to avoid overlap.
    for _, raw in ipairs(candidates) do
        local key = compactNpcName(raw)
        for _, name in ipairs(AllNpcNames) do
            local expected = compactNpcName(name)
            if #expected >= 5 then
                local at=key:find(expected,1,true)
                if at then
                    local before=key:sub(1,at-1)
                    local after=key:sub(at+#expected)
                    -- Do not identify "Fake Stone Eye" as Stone Eye or a
                    -- "Fox Bear Claws" weapon label as the Fox Bear boss.
                    local prefixOK=(before=="" or before=="the" or
                        before=="npc" or before=="mob" or before=="enemy" or before=="boss")
                    local suffixOK=(after=="" or after=="npc" or after=="mob"
                        or after=="enemy" or after=="boss")
                    if prefixOK and suffixOK then return npcCanonical(name) end
                end
            end
        end
    end
    return nil
end
local function selectionMatches(record, selected)
    if not record or type(selected) ~= "string" or selected == "None" then
        return false
    end
    local wanted = compactNpcName(selected)
    if wanted == "" then return false end
    -- Resolve player-facing names to the internal name. Critical fix:
    -- selecting Phantom Raider must match a Phantom Goon/NPCDataLibrary spawn.
    local selectedCanonical = npcCanonical(selected)
    if record.NPCName and compactNpcName(record.NPCName) == compactNpcName(selectedCanonical) then
        return true
    end
    for _, name in ipairs(cachedIdentityNames(record)) do
        local compact = compactNpcName(name)
        if compact == wanted or compact == compactNpcName(selectedCanonical) then
            return true
        end
        -- Names with level/ID prefixes are normalized by compactNpcName.
        -- Do not substring-match "Foxbear" to "Foxbear Hunter", for example.
    end
    return false
end
