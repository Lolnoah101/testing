    local function CurrencyAmount(
        Data,
        Currency
    )

        local FromCurrencies =
            Data
            and Data.currencies
            and tonumber(
                Data.currencies[
                    Currency
                ]
            )


        if FromCurrencies ~= nil then
            return FromCurrencies
        end


        return tonumber(
