                AutoJoinMap = true,
                AutoRetry = true,
                AutoLeave = true,
                AutoNext = true,
                MatchesBeforeLeave = true,
                AutoLeaveAfterMatches = true,
                LobbyEndlessMap = true,
                LobbyEndlessDifficulty = true,
