            and now-(entry.Started or now)<4.5 and entry.Record
            and entry.Record.Root and entry.Record.Root.Parent
            and entry.Record.Hum and entry.Record.Hum.Health>0
            and (entry.Record.Root.Position-root.Position).Magnitude<27
            and (not focus or entry.Record==focus
                or (entry.Record.Root.Position-root.Position).Magnitude<12)
    end
    if closeEnough(existing) then return existing end
    for _,entry in pairs(Hub.Tracks) do
