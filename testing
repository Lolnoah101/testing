            local function StartSelectedMode()

                StopAllModes()

                ApplyMaterialStrategy()


                local Mode =
                    AdvancedAutomationSettings
                        .AutomationMode


                if Mode == "Off" then

                    AdvancedAutomationSettings
                        .RunAutomation =
                        false

                    PersistAdvanced()


                    local Toggle =
                        GENV.__AZ_MAIN_AUTOMATION_RUN_TOGGLE


                    if Toggle then

                        task.defer(function()

                            pcall(function()

                                Toggle:Set(
                                    false
                                )
                            end)
                        end)
                    end


                    return false
                end


                GENV.__AZ_MAIN_CONTROLLER_APPLYING =
                    true


                if Mode == "Title Grinder" then

                    TitleAutomationSettings
                        .AutoGrindTitle =
                        true

                    SaveTitleState()


                elseif Mode == "Multi-Title Grinder" then

                    AdvancedAutomationSettings
                        .AutoMultiTitle =
                        true


                elseif Mode == "Accessory Farm & Craft" then

                    local Accessory =
                        GENV.__AZ_ACCESSORY_AUTOMATION_SETTINGS


                    if type(Accessory) == "table" then

                        Accessory.AutoCraftAccessories =
                            true

                        SaveAccessoryState()
                    end


                elseif Mode == "Full Auto Evolve" then

                    AdvancedAutomationSettings
                        .AutoFullEvolve =
                        true


                elseif Mode == "Achievement Grinder" then

                    AdvancedAutomationSettings
                        .AutoAchievementGrinder =
                        true


                elseif Mode == "Automation Queue" then

                    if (
                        tonumber(
