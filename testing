local function createRayfieldWindow(rayfield)
    if not rayfield then
        return nil
    end

    local theme =
        normalizeRayfieldTheme(
            Config.UITheme
        )

    local fullProps = {
        name = "Fishing Suite",
        subtitle =
            "Automation • v19.4 • 35 studs/s",
        sidebarLayout = true,
        theme = theme,
        profile = "Fishing Automation",
        showName = "Fishing",
        showIconOnly = false,
        configuration = {
            autoSave = true,
            autoLoad = true,
            fileName =
                "FullAutoFishing_DualMode_v19_4",
            customFolder = "FishingSuite",
        },
    }

    local okFull, fullResult =
        pcall(function()
            return rayfield:
                CreateWindow(
                    fullProps
                )
        end)

    if okFull
        and fullResult then

        State.RayfieldError = ""
        return fullResult
    end

    local firstError =
        okFull
        and "CreateWindow returned nil"
        or tostring(fullResult)

    warnf(
        "Rayfield full CreateWindow failed:",
        firstError
    )

    local safeProps = {
        name = "Fishing Suite",
        subtitle =
            "Automation • v19.4",
        sidebarLayout = true,
        theme = "cobalt",
        configuration = {
            autoSave = true,
            autoLoad = true,
            fileName =
                "FullAutoFishing_DualMode_v19_4",
        },
    }

    local okSafe, safeResult =
        pcall(function()
            return rayfield:
                CreateWindow(
                    safeProps
                )
        end)

    if okSafe
        and safeResult then

        Config.UITheme =
            "cobalt"

        State.RayfieldError = ""
        return safeResult
    end

    local secondError =
        okSafe
        and "safe CreateWindow returned nil"
        or tostring(safeResult)

    State.RayfieldError =
        "CreateWindow failed: "
        .. tostring(firstError)
        .. " | retry: "
        .. tostring(secondError)

    warnf(
        "Rayfield CreateWindow failed:",
        State.RayfieldError
    )

    return nil
end

