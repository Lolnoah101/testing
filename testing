                    PartyBonus = 0,
                    Waves = 0,
                    Currency = "money",
                    Earned = 0,
                    Bonus = 0,
                    Gems = 0,
                    XP = 0,
                    Crystals = 0,
                    Materials = "",
                    Unit = "",
                    Elapsed = 0,
