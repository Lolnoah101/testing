--// OCT 18: DUO ULTIMATE (INCOMING OFFER ONLY)
--// The game's DuoUltController.Press() sends "Accept" when an offer is
--// active. Offer initiation remains a manual/native action.
--//============================================================
;(function()
    local Players = game:GetService("Players")
    local RS = game:GetService("ReplicatedStorage")
    local Runtime = { accepted = 0, lastOfferUntil = 0, lastAttemptAt = 0,
        lastResult = "idle", enabled = false, featureAvailable = nil }
    GENV.__AZ_DUO_RUNTIME = Runtime
    local function FeatureEnabled()
        local Global = RS:FindFirstChild("global")
        local Mod = Global and Global:FindFirstChild("Flags")
        if not Mod then return false end
        local Ok, Flags = pcall(require, Mod)
        if not Ok or type(Flags) ~= "table" or type(Flags.IsOn) ~= "function" then
            return false
        end
        local Good, Enabled = pcall(Flags.IsOn, "feature:duoUlt")
        return Good and Enabled == true
    end
    GENV.__AZ_DUO_STATUS = function()
        local LP = Players.LocalPlayer
        local Now = workspace:GetServerTimeNow()
        local Result = {
            enabled = Settings.AutoDuoAccept == true,
            autoUltimate = Settings.AutoUltimate == true,
            offerSecondsLeft = LP and math.max(0, (tonumber(LP:GetAttribute("DuoOfferUntil")) or 0) - Now) or 0,
            partner = LP and tostring(LP:GetAttribute("DuoPartner") or "none") or "none",
            attempts = Runtime.accepted,
            lastResult = Runtime.lastResult,
            featureEnabled = FeatureEnabled(),
        }
        for Key, Value in pairs(Result) do
            print("[Anime Zero][Duo Ultimate]", Key, "=", tostring(Value))
        end
        return Result
    end
    GENV.__AZ_TRY_DUO_ACCEPT = function()
        if Settings.AutoDuoAccept ~= true or Settings.AutoUltimate ~= true
            or not FeatureEnabled() then return false end
        local LP = Players.LocalPlayer
        if not LP then return false end
        local Now = workspace:GetServerTimeNow()
        local Until = tonumber(LP:GetAttribute("DuoOfferUntil")) or 0
        if Until <= Now then return false end
        -- At most one accept request per distinct server offer window.
        if Runtime.lastOfferUntil == Until then return false end
        if os.clock() - Runtime.lastAttemptAt < 0.5 then return false end
        local Remote = RS:FindFirstChild("DuoUltRemote")
        if not Remote or not Remote:IsA("RemoteEvent") then
            Runtime.lastResult = "DuoUltRemote missing"
            return false
        end
        Runtime.lastOfferUntil = Until
        Runtime.lastAttemptAt = os.clock()
        local Ok, Err = pcall(function() Remote:FireServer("Accept") end)
        Runtime.lastResult = Ok and "Accept request sent (not server-confirmed)"
            or tostring(Err)
        if Ok then Runtime.accepted = Runtime.accepted + 1 end
        return Ok
    end
    -- Run independently of enemy proximity, since an offer may arrive between waves.
    task.spawn(function()
        while GENV.__AZ_DUO_RUNTIME == Runtime do
            task.wait(0.2)
            pcall(GENV.__AZ_TRY_DUO_ACCEPT)
        end
    end)
end)()

