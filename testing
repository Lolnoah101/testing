--//============================================================
--// IMMEDIATE FARM RUNTIME RESCUE
--//
--// The updated run place can finish building the UI before the large legacy
--// dungeon engine reaches its heartbeat bind.  Every Farm control changes the
--// shared Settings table immediately, so keep a small independent runtime
--// alive from this point onward.  If the full engine later becomes active it
--// takes priority and this rescue runtime idles automatically.
--//
--// Everything is kept in this nested scope so it does not consume the main
--// chunk's already-tight Luau local-register budget.
--//============================================================

;(function()

    if type(GENV.__AZ_FARM_RESCUE_RUNTIME) == "table" then
        GENV.__AZ_FARM_RESCUE_RUNTIME.Active = false

        local OldConnection =
            GENV.__AZ_FARM_RESCUE_RUNTIME.Connection

        if typeof(OldConnection) == "RBXScriptConnection" then
            pcall(function()
                OldConnection:Disconnect()
            end)
        end

        local OldSpikeCleanup =
            GENV.__AZ_FARM_RESCUE_RUNTIME.SpikeListenerCleanup

        if type(OldSpikeCleanup) == "function" then
            pcall(OldSpikeCleanup)
        end
    end


    local Rescue = {
        Active = true,
        Ready = false,
        Connection = nil,
        Sequence = 0,
        SkillCursor = 1,
        NextM1 = 0,
        NextSkill = 0,
        NextUltimate = 0,
        NextBlock = 0,
        NextLoot = 0,
        NextEndAction = 0,
        BlockSent = false,
        LastDebug = 0,
        LootState = "Idle",
        EndActionState = "Idle",
        RunPackets = nil,

        -- Spirited Away raid route state. Keep this on the runtime table so
        -- the main Luau chunk stays safely below the 200-local limit.
        RaidLastAreaAt = 0,
        RaidLastPromptAt = 0,
        RaidLastWorld = nil,
        RaidAreaPart = nil,
        RaidState = "Idle",

        -- Area-3 spawn settling. Mainhall can begin by replicating only one
        -- enemy; leaving the middle immediately delays the rest of the wave.
        RaidLastWave = nil,
        RaidLastVisibleCount = 0,
        RaidSpawnStableSince = 0,
        RaidHoldUntil = 0,

        -- No-Face immunity / hazard state.
        RaidGuardedBoss = false,
        RaidDodgeState = "Idle",
        SpikeHazards = {},
        SpikeListenerCleanup = nil,
        LastDodgeAt = 0,

        -- Dodge lock. Once an AOE forces us away from the boss, farming is
        -- suspended until the telegraph actually clears. This prevents the
        -- old dodge -> farm boss -> dodge loop every other heartbeat.
        RaidDodgeActive = false,
        RaidDodgeGoal = nil,
        RaidDodgeHoldUntil = 0,
        RaidDodgeReason = "Idle",

        -- Above/Below must own character rotation while active. Position is
        -- smoothed separately, but orientation is applied exactly so Roblox's
        -- humanoid upright correction cannot leave the avatar merely leaning.
        HorizontalHoldActive = false,
        HorizontalAutoRotateWas = nil,

        -- Story / Endless rescue progression state. This is only used when the
        -- large legacy engine is late/broken, or as a rubble/area assist while
        -- that engine is active. It never chases enemies when the full engine
        -- already owns normal-map movement.
        NormalState = "Idle",
        NormalRubbleGoal = nil,
        NormalRubbleDistance = math.huge,

        -- Normal-map anti-idle watchdog. If the run state stops changing while
        -- there are no enemies/rubble, force the character back through the
        -- live Area volume instead of allowing an infinite false-idle state.
        NormalProgressKey = nil,
        NormalProgressAt = 0,
        NormalFallbackStage = 0,
        NormalLastFallbackAt = 0,
        NormalReentryToken = 0,
        NormalFallbackReason = "Idle",

        -- Cached vertical offsets keep Above/Below anchored to one stable
        -- head/feet height instead of following animated limbs every frame.
        VerticalFarmOffsets = {},
    }

    GENV.__AZ_FARM_RESCUE_RUNTIME = Rescue
    GENV.__AZ_FARM_RESCUE_ACTIVE = false
    GENV.__AZ_FARM_FULL_ENGINE_ACTIVE = false


    task.spawn(function()

        local PlayersService =
            game:GetService("Players")

        local ReplicatedStorageService =
            game:GetService("ReplicatedStorage")

        local RunServiceService =
            game:GetService("RunService")

        local LocalPlayerObject =
            PlayersService.LocalPlayer


        -- This runtime is only useful in the run place.  Do not stall lobby UI.
        local GameFolderObject =
            ReplicatedStorageService:FindFirstChild("game")

        if not GameFolderObject then
            local Deadline = os.clock() + 60

            while Rescue.Active
                and os.clock() < Deadline
                and not GameFolderObject
            do
                GameFolderObject =
                    ReplicatedStorageService:FindFirstChild("game")

                if GameFolderObject then
                    break
                end

                task.wait(0.10)
            end
        end


        if not Rescue.Active or not GameFolderObject then
            return
        end


        local PacketsFolderObject =
            GameFolderObject:FindFirstChild("packets")
            or GameFolderObject:WaitForChild("packets", 20)

        local StoresFolderObject =
            GameFolderObject:FindFirstChild("stores")
            or GameFolderObject:WaitForChild("stores", 20)

        if not PacketsFolderObject
            or not StoresFolderObject
        then
            warn("[Anime Zero][Farm Rescue] game packets/stores unavailable")
            return
        end


        local CharacterPacketsObject =
            PacketsFolderObject:FindFirstChild("characterPackets")
            or PacketsFolderObject:WaitForChild("characterPackets", 20)

        local PlayerNamespaceObject2 =
            StoresFolderObject:FindFirstChild("playerNamespace")
            or StoresFolderObject:WaitForChild("playerNamespace", 20)

        if not CharacterPacketsObject
            or not PlayerNamespaceObject2
        then
            warn("[Anime Zero][Farm Rescue] combat modules unavailable")
            return
        end


        local CharacterPackets2
        local PlayerNamespace2
        local DropStore2
        local RewardPackets2
        local EnemyStore2
        local RunStore2
        local EnemyPackets2
        local EnemyConstants2

        local OkPackets, PacketResult =
            pcall(require, CharacterPacketsObject)

        local OkPlayers, PlayerResult =
            pcall(require, PlayerNamespaceObject2)

        if not OkPackets or type(PacketResult) ~= "table"
            or not OkPlayers or type(PlayerResult) ~= "table"
        then
            warn(
                "[Anime Zero][Farm Rescue] require failed:",
                tostring(PacketResult),
                tostring(PlayerResult)
            )
            return
        end

        CharacterPackets2 = PacketResult
        PlayerNamespace2 = PlayerResult


        pcall(function()
            local DropObject =
                StoresFolderObject:FindFirstChild("dropStore")

            if DropObject then
                DropStore2 = require(DropObject)
            end
        end)

        pcall(function()
            local RewardObject =
                PacketsFolderObject:FindFirstChild("rewardPackets")

            if RewardObject then
                RewardPackets2 = require(RewardObject)
            end
        end)


        pcall(function()
            local RunPacketsObject2 =
                PacketsFolderObject:FindFirstChild("runPackets")

            if RunPacketsObject2 then
                Rescue.RunPackets = require(RunPacketsObject2)
            end
        end)


        pcall(function()
            local EnemyStoreObject2 =
                StoresFolderObject:FindFirstChild("enemyStore")

            if EnemyStoreObject2 then
                EnemyStore2 = require(EnemyStoreObject2)
            end
        end)


        pcall(function()
            local RunStoreObject2 =
                StoresFolderObject:FindFirstChild("runStore")

            if RunStoreObject2 then
                RunStore2 = require(RunStoreObject2)
            end
        end)


        pcall(function()
            local EnemyPacketsObject2 =
                PacketsFolderObject:FindFirstChild("enemyPackets")

            if EnemyPacketsObject2 then
                EnemyPackets2 = require(EnemyPacketsObject2)
            end
        end)


        pcall(function()
            local GlobalFolder2 =
                ReplicatedStorageService:FindFirstChild("global")

            local ConstantsFolder2 =
                GlobalFolder2
                and GlobalFolder2:FindFirstChild("constants")

            local EnemiesObject2 =
                ConstantsFolder2
                and ConstantsFolder2:FindFirstChild("enemies")

            if EnemiesObject2 then
                EnemyConstants2 = require(EnemiesObject2)
            end
        end)


        local function GetRoot2()
            local Character = LocalPlayerObject.Character

            return Character
                and Character:FindFirstChild("HumanoidRootPart")
        end


        local function Alive2()
            local Character = LocalPlayerObject.Character
            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")

            return Character ~= nil
                and Humanoid ~= nil
                and Humanoid.Health > 0
                and GetRoot2() ~= nil
        end


        local function GetPlayerStore2()
            local Success, Store = pcall(function()
                return PlayerNamespace2.getLocalPlayerStore()
            end)

            if Success then
                return Store
            end

            return nil
        end


        local function ReadLeaf(Leaf)
            if Leaf == nil then
                return nil
            end

            if type(Leaf) == "table"
                and type(Leaf.get) == "function"
            then
                local Success, Value = pcall(function()
                    return Leaf:get()
                end)

                if Success then
                    return Value
                end
            end

            return Leaf
        end


        local function GetEnemyState2(Model)
            if not Model
                or not EnemyStore2
                or not EnemyStore2.store
                or not EnemyStore2.store.state
            then
                return nil
            end

            local Id =
                tonumber(Model.Name)
                or Model.Name

            local Success, State =
                pcall(function()
                    return EnemyStore2.store.state:get(Id)
                end)

            if Success then
                return State
            end

            return nil
        end


        local function GetEnemyName2(Model, State)
            local Name = nil

            if State and State.name then
                Name = ReadLeaf(State.name)
            end

            if type(Name) == "string" then
                return Name
            end

            local AttributeName =
                Model
                and Model:GetAttribute("EnemyName")

            if type(AttributeName) == "string" then
                return AttributeName
            end

            return Model and Model.Name or "unknown"
        end


        local function IsGuardedEnemy2(State)
            if not State or not State.guardedAt then
                return false
            end

            return ReadLeaf(State.guardedAt) ~= nil
        end


        local function ReadRunValue2(Name)
            if not RunStore2
                or not RunStore2.store
                or not RunStore2.store.state
            then
                return nil
            end

            local Leaf =
                RunStore2.store.state[Name]

            return ReadLeaf(Leaf)
        end


        local function GetInstancePosition2(Object)
            if not Object or not Object.Parent then
                return nil
            end

            if Object:IsA("Attachment") then
                return Object.WorldPosition
            end

            if Object:IsA("BasePart") then
                return Object.Position
            end

            if Object:IsA("Model") then
                return Object:GetPivot().Position
            end

            local Part = Object:FindFirstChildWhichIsA("BasePart", true)

            return Part and Part.Position or nil
        end


        Rescue.FindNormalRubble = function(Root)
            Rescue.NormalRubbleGoal = nil
            Rescue.NormalRubbleDistance = math.huge

            if not Root
                or GENV.__AZ_IS_RAID_MODE()
            then
                return nil
            end

            local World = workspace:FindFirstChild("World")
            local WorldMap = World and World:FindFirstChild("Map")

            if not WorldMap then
                return nil
            end

            local Best = nil
            local BestDistance = math.huge

            for _, Border in ipairs(WorldMap:GetDescendants()) do
                local MaxHealth = Border:GetAttribute("RubbleMaxHealth")

                if MaxHealth ~= nil then
                    local Health = Border:GetAttribute("RubbleHealth")

                    if Health == nil then
                        Health = MaxHealth
                    end

                    Health = tonumber(Health)

                    if Health and Health > 0 then
                        local Blocker = Border:FindFirstChild("Blocker")
                        local Rubble = Border:FindFirstChild("Rubble")
                        local RubbleBar =
                            (Blocker and Blocker:FindFirstChild("RubbleBar", true))
                            or Border:FindFirstChild("RubbleBar", true)

                        local TargetPosition = nil

                        if RubbleBar and RubbleBar:IsA("Attachment") then
                            local Position = RubbleBar.WorldPosition

                            TargetPosition = Vector3.new(
                                Position.X,
                                Root.Position.Y,
                                Position.Z
                            )
                        end

                        if not TargetPosition
                            and Blocker
                            and Blocker:IsA("BasePart")
                        then
                            local Look = Blocker.CFrame.LookVector
                            local Flat = Vector3.new(Look.X, 0, Look.Z)

                            if Flat.Magnitude < 0.01 then
                                Flat = Vector3.new(0, 0, 1)
                            else
                                Flat = Flat.Unit
                            end

                            local Position = Blocker.Position + Flat * 8

                            TargetPosition = Vector3.new(
                                Position.X,
                                Root.Position.Y,
                                Position.Z
                            )
                        end

                        if not TargetPosition then
                            local Position =
                                GetInstancePosition2(Rubble)
                                or GetInstancePosition2(Border)

                            if Position then
                                TargetPosition = Vector3.new(
                                    Position.X,
                                    Root.Position.Y,
                                    Position.Z
                                )
                            end
                        end

                        if TargetPosition then
                            local Distance =
                                (Root.Position - TargetPosition).Magnitude

                            if Distance < BestDistance then
                                local LookAt =
                                    GetInstancePosition2(Blocker)
                                    or GetInstancePosition2(Rubble)
                                    or TargetPosition + Vector3.new(0, 0, -1)

                                LookAt = Vector3.new(
                                    LookAt.X,
                                    Root.Position.Y,
                                    LookAt.Z
                                )

                                BestDistance = Distance
                                Best = {
                                    Border = Border,
                                    Blocker = Blocker,
                                    Rubble = Rubble,
                                    Health = Health,
                                    Goal = CFrame.lookAt(
                                        TargetPosition,
                                        LookAt,
                                        Vector3.yAxis
                                    ),
                                }
                            end
                        end
                    end
                end
            end

            if Best then
                Rescue.NormalRubbleGoal = Best.Goal
                Rescue.NormalRubbleDistance = BestDistance
            end

            return Best
        end


        Rescue.GetNormalAreaGoal = function(Root)
            if not Root
                or GENV.__AZ_IS_RAID_MODE()
            then
                return nil
            end

            local AreaNumber = tonumber(ReadRunValue2("area"))

            if not AreaNumber then
                return nil
            end

            local World = workspace:FindFirstChild("World")
            local Areas = World and World:FindFirstChild("Areas")
            local Area = Areas and Areas:FindFirstChild(tostring(AreaNumber))

            if not Area or not Area:IsA("BasePart") then
                return nil
            end

            local LocalRoot = Area.CFrame:PointToObjectSpace(Root.Position)
            local Half = Area.Size * 0.5
            local SafeY = math.clamp(
                LocalRoot.Y,
                -math.max(Half.Y - 2, 0),
                math.max(Half.Y - 2, 0)
            )

            return Area.CFrame * CFrame.new(0, SafeY, 0), Area, AreaNumber
        end


        Rescue.IsInsideNormalArea = function(Root, Area)
            if not Root or not Area or not Area:IsA("BasePart") then
                return false
            end

            local LocalPosition = Area.CFrame:PointToObjectSpace(Root.Position)
            local Half = Area.Size * 0.5

            return math.abs(LocalPosition.X) <= math.max(Half.X - 1, 0)
                and math.abs(LocalPosition.Y) <= Half.Y
                and math.abs(LocalPosition.Z) <= math.max(Half.Z - 1, 0)
        end


        Rescue.MoveToGoal = function(Root, Goal, DeltaTime, Speed)
            if not Root or not Goal then
                return false
            end

            if Settings.FarmMethod == "Tween" then
                local Distance = (Root.Position - Goal.Position).Magnitude

                if Distance > 0.05 then
                    local Alpha = math.clamp(
                        ((Speed or 135) * (DeltaTime or 0.016))
                            / math.max(Distance, 0.001),
                        0,
                        1
                    )

                    Root.CFrame = Root.CFrame:Lerp(Goal, Alpha)
                else
                    Root.CFrame = Goal
                end
            else
                Root.CFrame = Goal
            end

            return true
        end


        Rescue.RunNormalProgressionAssist = function(DeltaTime)
            Rescue.NormalState = "Idle"

            if GENV.__AZ_IS_RAID_MODE()
                or not Settings.AutoFarm
                or not Alive2()
            then
                Rescue.NormalProgressKey = nil
                Rescue.NormalProgressAt = 0
                Rescue.NormalFallbackStage = 0
                Rescue.NormalFallbackReason = "Inactive"
                return false
            end

            local Now = os.clock()
            local EnemyFolder = workspace:FindFirstChild("enemies")
            local VisibleEnemyCount = 0

            if EnemyFolder then
                for _, Model in ipairs(EnemyFolder:GetChildren()) do
                    local EnemyRoot =
                        Model:FindFirstChild("HumanoidRootPart")
                        or Model.PrimaryPart

                    if EnemyRoot and EnemyRoot:IsA("BasePart") then
                        VisibleEnemyCount = VisibleEnemyCount + 1
                    end
                end
            end

            if VisibleEnemyCount > 0 then
                Rescue.NormalState = "Enemy"
                Rescue.NormalProgressKey =
                    "enemy:"
                    .. tostring(ReadRunValue2("area"))
                    .. ":"
                    .. tostring(ReadRunValue2("wave"))
                    .. ":"
                    .. tostring(ReadRunValue2("remaining"))
                Rescue.NormalProgressAt = Now
                Rescue.NormalFallbackStage = 0
                Rescue.NormalFallbackReason = "EnemyActive"
                return false
            end

            local Root = GetRoot2()

            if not Root then
                return false
            end

            local Rubble = Rescue.FindNormalRubble(Root)

            if Rubble and Rubble.Goal then
                Rescue.NormalState =
                    "Rubble " .. tostring(math.floor((Rubble.Health or 0) + 0.5))

                local RubbleKey =
                    "rubble:"
                    .. tostring(ReadRunValue2("area"))
                    .. ":"
                    .. tostring(math.floor((Rubble.Health or 0) + 0.5))

                if Rescue.NormalProgressKey ~= RubbleKey then
                    Rescue.NormalProgressKey = RubbleKey
                    Rescue.NormalProgressAt = Now
                    Rescue.NormalFallbackStage = 0
                end

                Rescue.NormalFallbackReason = "Rubble"
                Rescue.MoveToGoal(Root, Rubble.Goal, DeltaTime, 125)

                local Distance =
                    (Root.Position - Rubble.Goal.Position).Magnitude

                -- Match the pre-update behavior: rubble damage uses M1, so the
                -- user's Auto M1 toggle remains the attack permission.
                if Settings.AutoM1
                    and Distance <= 12
                    and CharacterPackets2.performM1
                    and os.clock() >= Rescue.NextM1
                then
                    Rescue.NextM1 = os.clock() + 0.40

                    pcall(function()
                        CharacterPackets2.performM1:fire()
                    end)
                end

                return true
            end

            local AreaNumber = tonumber(ReadRunValue2("area"))
            local Wave = tonumber(ReadRunValue2("wave")) or 0
            local Remaining = tonumber(ReadRunValue2("remaining")) or 0
            local Status = tostring(ReadRunValue2("status") or "?")
            local WaveStartedAt = ReadRunValue2("waveStartedAt")
            local FinishedAt = ReadRunValue2("finishedAt")

            if FinishedAt ~= nil then
                Rescue.NormalState = "Finished"
                Rescue.NormalFallbackReason = "Finished"
                Rescue.NormalProgressKey = nil
                Rescue.NormalProgressAt = 0
                Rescue.NormalFallbackStage = 0
                return false
            end

            local ProgressKey =
                tostring(AreaNumber)
                .. ":"
                .. tostring(Wave)
                .. ":"
                .. tostring(Remaining)
                .. ":"
                .. Status
                .. ":"
                .. tostring(WaveStartedAt)

            if Rescue.NormalProgressKey ~= ProgressKey then
                Rescue.NormalProgressKey = ProgressKey
                Rescue.NormalProgressAt = Now
                Rescue.NormalFallbackStage = 0
                Rescue.NormalLastFallbackAt = 0
                Rescue.NormalFallbackReason = "Progress"
            elseif Rescue.NormalProgressAt <= 0 then
                Rescue.NormalProgressAt = Now
            end

            local StuckFor =
                math.max(0, Now - (Rescue.NormalProgressAt or Now))

            local Goal, Area, GoalAreaNumber =
                Rescue.GetNormalAreaGoal(Root)

            -- Normal progression still gets first priority. The watchdog below
            -- deliberately ignores Wave/Remaining after enough idle time because
            -- the updated game can report a non-zero wave while still waiting for
            -- the player to physically cross the next Area trigger.
            local ShouldEnterNormally =
                Wave == 0
                or Remaining > 0

            local WatchdogTriggered =
                StuckFor >= 12

            if Goal and Area
                and (ShouldEnterNormally or WatchdogTriggered)
            then
                local Inside =
                    Rescue.IsInsideNormalArea(Root, Area)

                if not WatchdogTriggered then
                    Rescue.NormalState =
                        (Wave == 0 and "Enter Area " or "Wave Recovery ")
                        .. tostring(GoalAreaNumber)
                    Rescue.NormalFallbackReason = "NormalEntry"

                    if not Inside
                        or (Root.Position - Goal.Position).Magnitude > 6
                    then
                        Rescue.MoveToGoal(Root, Goal, DeltaTime, 145)
                    end

                    return true
                end

                -- Escalate every six seconds of continued no-progress. Stage 1
                -- hard-snaps to the Area center. Stage 2+ deliberately crosses an
                -- Area boundary (outside -> inside) to retrigger touch/zone logic.
                local Stage =
                    math.max(
                        1,
                        math.floor((StuckFor - 12) / 6) + 1
                    )

                Rescue.NormalFallbackStage = Stage
                Rescue.NormalFallbackReason =
                    "NoProgress " .. tostring(math.floor(StuckFor)) .. "s"

                if Stage == 1 then
                    Rescue.NormalState =
                        "Fallback Center Area "
                        .. tostring(GoalAreaNumber)

                    if Now - (Rescue.NormalLastFallbackAt or 0) >= 1.5 then
                        Rescue.NormalLastFallbackAt = Now
                        Root.CFrame = Goal

                        print(
                            "[Anime Zero][Normal Fallback] forcing Area center | area:",
                            tostring(GoalAreaNumber),
                            "| wave:",
                            tostring(Wave),
                            "| remaining:",
                            tostring(Remaining)
                        )
                    end

                    return true
                end

                Rescue.NormalState =
                    "Fallback Re-enter Area "
                    .. tostring(GoalAreaNumber)
                    .. " #"
                    .. tostring(Stage)

                if Now - (Rescue.NormalLastFallbackAt or 0) >= 3 then
                    Rescue.NormalLastFallbackAt = Now
                    Rescue.NormalReentryToken =
                        (Rescue.NormalReentryToken or 0) + 1

                    local Token = Rescue.NormalReentryToken
                    local LocalRoot =
                        Area.CFrame:PointToObjectSpace(Root.Position)
                    local Half = Area.Size * 0.5
                    local SafeY = math.clamp(
                        LocalRoot.Y,
                        -math.max(Half.Y - 2, 0),
                        math.max(Half.Y - 2, 0)
                    )
                    local SafeX = math.clamp(
                        LocalRoot.X,
                        -math.max(Half.X - 4, 0),
                        math.max(Half.X - 4, 0)
                    )
                    local SafeZ = math.clamp(
                        LocalRoot.Z,
                        -math.max(Half.Z - 4, 0),
                        math.max(Half.Z - 4, 0)
                    )
                    local XGap = Half.X - math.abs(LocalRoot.X)
                    local ZGap = Half.Z - math.abs(LocalRoot.Z)
                    local OutsideLocal
                    local InsideLocal

                    if XGap <= ZGap then
                        local Sign = LocalRoot.X >= 0 and 1 or -1

                        OutsideLocal = Vector3.new(
                            Sign * (Half.X + 4),
                            SafeY,
                            SafeZ
                        )

                        InsideLocal = Vector3.new(
                            Sign * math.max(Half.X - 10, 0),
                            SafeY,
                            SafeZ
                        )
                    else
                        local Sign = LocalRoot.Z >= 0 and 1 or -1

                        OutsideLocal = Vector3.new(
                            SafeX,
                            SafeY,
                            Sign * (Half.Z + 4)
                        )

                        InsideLocal = Vector3.new(
                            SafeX,
                            SafeY,
                            Sign * math.max(Half.Z - 10, 0)
                        )
                    end

                    Root.CFrame =
                        Area.CFrame * CFrame.new(OutsideLocal)

                    task.delay(0.18, function()
                        if Rescue.Active
                            and Settings.AutoFarm
                            and not GENV.__AZ_IS_RAID_MODE()
                            and Rescue.NormalReentryToken == Token
                        then
                            local CurrentRoot = GetRoot2()

                            if CurrentRoot then
                                CurrentRoot.CFrame =
                                    Area.CFrame * CFrame.new(InsideLocal)
                            end
                        end
                    end)

                    print(
                        "[Anime Zero][Normal Fallback] re-enter pulse | area:",
                        tostring(GoalAreaNumber),
                        "| stuck:",
                        tostring(math.floor(StuckFor)),
                        "s | stage:",
                        tostring(Stage)
                    )
                end

                return true
            end

            Rescue.NormalState =
                WatchdogTriggered
                and ("Fallback Waiting " .. tostring(math.floor(StuckFor)) .. "s")
                or "Waiting"

            Rescue.NormalFallbackReason =
                WatchdogTriggered
                and "AreaGoalMissing"
                or "Waiting"

            return false
        end


        local function GetEnemySnapshot2()
            local Root = GetRoot2()
            local Folder = workspace:FindFirstChild("enemies")
            local Snapshot = {}
            local VisibleCount = 0
            local AttackableCount = 0
            local GuardedBoss = false

            if not Folder then
                return Snapshot, 0, 0, false
            end

            for _, Model in ipairs(Folder:GetChildren()) do
                local EnemyRoot =
                    Model:FindFirstChild("HumanoidRootPart")
                    or Model.PrimaryPart

                if EnemyRoot and EnemyRoot:IsA("BasePart") then
                    local State = GetEnemyState2(Model)
                    local Name = GetEnemyName2(Model, State)
                    local Guarded = IsGuardedEnemy2(State)
                    local Distance =
                        Root
                        and (Root.Position - EnemyRoot.Position).Magnitude
                        or math.huge

                    VisibleCount = VisibleCount + 1

                    if Guarded
                        and GENV.__AZ_IS_RAID_MODE()
                    then
                        GuardedBoss = true
                    end

                    if not Guarded then
                        AttackableCount = AttackableCount + 1
                    end

                    table.insert(Snapshot, {
                        Model = Model,
                        Root = EnemyRoot,
                        State = State,
                        Name = Name,
                        Guarded = Guarded,
                        Distance = Distance,
                    })
                end
            end

            Rescue.RaidGuardedBoss = GuardedBoss

            return Snapshot,
                VisibleCount,
                AttackableCount,
                GuardedBoss
        end


        local function NearestEnemy2()
            local Snapshot = GetEnemySnapshot2()
            local Best = nil
            local BestScore = math.huge

            for _, Info in ipairs(Snapshot) do
                -- guardedAt is exactly what the game's boss bar uses to show
                -- [IMMUNE]. Never tunnel into an immune No-Face while summons
                -- or the Shadow clone are the real objective.
                if not Info.Guarded then
                    local Score = Info.Distance

                    local Mode =
                        workspace:GetAttribute("Mode")

                    -- Shadow Gate oath phases are timed. Oath Knights are the
                    -- objective that removes Igris's protection, so they must
                    -- beat ordinary adds in target priority.
                    if Mode == "sololevelingraid"
                        and Info.Name == "soloOathKnight"
                    then
                        Score = Score - 700
                    end

                    -- Shadow Igris is the next most important add during the
                    -- boss phase. Keep the old No-Face clone priority too for
                    -- compatibility with older Spirited Away servers.
                    if Mode == "sololevelingraid"
                        and Info.Name == "soloIgrisShadow"
                    then
                        Score = Score - 350
                    elseif Rescue.RaidGuardedBoss
                        and Info.Name == "spiritedkaonashiclone"
                    then
                        Score = Score - 250
                    end

                    if Score < BestScore then
                        BestScore = Score
                        Best = Info
                    end
                end
            end

            if Best then
                return Best.Model,
                    Best.Root,
                    Best.Distance,
                    Best.State,
                    Best.Name
            end

            return nil, nil, math.huge, nil, nil
        end


        Rescue.SetHorizontalHoldActive = function(Active)
            local Character = LocalPlayerObject.Character
            local Humanoid = Character
                and Character:FindFirstChildOfClass("Humanoid")
                or nil

            if Active then
                if not Rescue.HorizontalHoldActive then
                    Rescue.HorizontalAutoRotateWas =
                        Humanoid and Humanoid.AutoRotate or nil
                end

                Rescue.HorizontalHoldActive = true

                if Humanoid then
                    Humanoid.AutoRotate = false
                end
            else
                if Rescue.HorizontalHoldActive
                    and Humanoid
                    and Rescue.HorizontalAutoRotateWas ~= nil
                then
                    Humanoid.AutoRotate = Rescue.HorizontalAutoRotateWas
                end

                Rescue.HorizontalHoldActive = false
                Rescue.HorizontalAutoRotateWas = nil
            end
        end


        -- Build an exact 90-degree horizontal body orientation. The avatar's
        -- local forward axis points straight down/up while its body-up axis is
        -- parallel to the floor. Using fromMatrix avoids lookAt's near-vertical
        -- interpolation ambiguity and never follows enemy yaw.
        Rescue.MakeHorizontalFarmCFrame = function(Position, LookDown)
            if LookDown then
                -- Right = +X, Up = -Z, Back = +Y -> LookVector = -Y.
                return CFrame.fromMatrix(
                    Position,
                    Vector3.xAxis,
                    -Vector3.zAxis,
                    Vector3.yAxis
                )
            end

            -- Right = +X, Up = +Z, Back = -Y -> LookVector = +Y.
            return CFrame.fromMatrix(
                Position,
                Vector3.xAxis,
                Vector3.zAxis,
                -Vector3.yAxis
            )
        end


        local function DesiredEnemyCFrame2(EnemyRoot)
            if not EnemyRoot then
                return nil
            end

            local Distance =
                math.clamp(
                    tonumber(Settings.FarmDistance) or 7,
                    1,
                    30
                )

            -- Above/Below use the enemy root as the movement anchor. Head and
            -- feet offsets are sampled once per enemy so attack animations do
            -- not make the player bob up/down. An explicit orthonormal basis keeps the character exactly 90 degrees
            -- horizontal without spinning when the enemy turns.
            if Settings.FarmPosition == "Above"
                or Settings.FarmPosition == "Below"
            then
                local Model = EnemyRoot.Parent
                local Offsets =
                    Model
                    and Rescue.VerticalFarmOffsets[Model]
                    or nil

                if not Offsets then
                    local HeadOffset = 3
                    local FeetOffset = 3

                    if Model then
                        local Head = Model:FindFirstChild("Head")

                        if Head and Head:IsA("BasePart") then
                            HeadOffset = math.clamp(
                                Head.Position.Y - EnemyRoot.Position.Y,
                                1.5,
                                12
                            )
                        end

                        local LowestY = math.huge

                        for _, Name in ipairs({
                            "LeftFoot",
                            "RightFoot",
                            "Left Foot",
                            "Right Foot",
                            "Left Leg",
                            "Right Leg",
                        }) do
                            local Part = Model:FindFirstChild(Name)

                            if Part and Part:IsA("BasePart") then
                                local Bottom =
                                    Part.Position.Y
                                    - Part.Size.Y / 2

                                if Bottom < LowestY then
                                    LowestY = Bottom
                                end
                            end
                        end

                        if LowestY < math.huge then
                            FeetOffset = math.clamp(
                                EnemyRoot.Position.Y - LowestY,
                                1.5,
                                12
                            )
                        end
                    end

                    Offsets = {
                        Head = HeadOffset,
                        Feet = FeetOffset,
                    }

                    if Model then
                        Rescue.VerticalFarmOffsets[Model] = Offsets
                    end
                end

                local RootPosition = EnemyRoot.Position

                if Settings.FarmPosition == "Above" then
                    local Aim =
                        RootPosition
                        + Vector3.new(0, Offsets.Head, 0)

                    local Position =
                        Aim
                        + Vector3.new(0, Distance, 0)

                    return Rescue.MakeHorizontalFarmCFrame(
                        Position,
                        true
                    )
                end

                local Aim =
                    RootPosition
                    - Vector3.new(0, Offsets.Feet, 0)

                local Position =
                    Aim
                    - Vector3.new(0, Distance, 0)

                return Rescue.MakeHorizontalFarmCFrame(
                    Position,
                    false
                )
            end

            return EnemyRoot.CFrame * CFrame.new(0, 0, Distance)
        end


        --//========================================================
        --// RAID ROUTE - AREA BASED
        --//
        --// The raid does NOT need individual EnemySpawns to be visited.
        --// Each live segment exposes a large activation volume at:
        --//     workspace.World.Areas["1"]
        --//
        --// The server advances the raid through bathhouse -> shaft -> mainhall.
        --// Between waves, stay/return inside the current segment's Areas volume
        --// so the normal game progression can spawn the next wave. When the
        --// server opens RaidExitOpen, use the elevator ExitPrompt and let the
        --// next World segment load before resuming area entry.
        --//========================================================

        Rescue.ResetRaidRoute = function()
            Rescue.RaidLastAreaAt = 0
            Rescue.RaidLastWorld = nil
            Rescue.RaidAreaPart = nil
            Rescue.RaidState = "Idle"
            Rescue.RaidLastWave = nil
            Rescue.RaidLastVisibleCount = 0
            Rescue.RaidSpawnStableSince = 0
            Rescue.RaidHoldUntil = 0
            Rescue.RaidGuardedBoss = false
            Rescue.RaidDodgeState = "Idle"
            table.clear(Rescue.SpikeHazards)
        end


        Rescue.GetRaidRouteObjects = function()
            local World =
                workspace:FindFirstChild("World")

            if not World then
                return nil, nil, nil, nil
            end

            local Areas =
                World:FindFirstChild("Areas")

            local Area =
                Areas
                and Areas:FindFirstChild("1")

            -- Future-proofing: if a later raid segment renames zone 1, use the
            -- first actual area BasePart instead of falling back to spawn points.
            if not Area and Areas then
                for _, Object in ipairs(Areas:GetChildren()) do
                    if Object:IsA("BasePart") then
                        Area = Object
                        break
                    end
                end
            end

            local Markers =
                World:FindFirstChild("Markers")

            local Exit =
                Markers
                and Markers:FindFirstChild("Exit")

            local ExitPrompt =
                Exit
                and Exit:FindFirstChild("ExitPrompt")

            return World, Area, Exit, ExitPrompt
        end


        Rescue.FireRaidExitPrompt = function(Prompt)
            if not Prompt then
                return false
            end

            if os.clock() - Rescue.RaidLastPromptAt < 0.80 then
                return false
            end

            Rescue.RaidLastPromptAt =
                os.clock()

            if type(fireproximityprompt) == "function" then
                local Success =
                    pcall(
                        fireproximityprompt,
                        Prompt
                    )

                if Success then
                    return true
                end
            end

            task.spawn(function()
                pcall(function()
                    Prompt:InputHoldBegin()

                    task.wait(
                        math.max(
                            tonumber(Prompt.HoldDuration) or 0,
                            0
                        ) + 0.05
                    )

                    Prompt:InputHoldEnd()
                end)
            end)

            return true
        end


        Rescue.IsInsideRaidArea = function(Root, Area)
            if not Root
                or not Area
                or not Area:IsA("BasePart")
            then
                return false
            end

            local LocalPosition =
                Area.CFrame:PointToObjectSpace(
                    Root.Position
                )

            local Half =
                Area.Size * 0.5

            return math.abs(LocalPosition.X) <= Half.X
                and math.abs(LocalPosition.Y) <= Half.Y
                and math.abs(LocalPosition.Z) <= Half.Z
        end


        Rescue.GetRaidAreaGoal = function(Root, Area)
            if not Root or not Area then
                return nil
            end

            -- Keep the player's current Y whenever it already falls within the
            -- area's vertical bounds. This avoids teleporting to the geometric
            -- center of a tall trigger volume high above the actual floor.
            local LocalRoot =
                Area.CFrame:PointToObjectSpace(
                    Root.Position
                )

            local HalfY =
                math.max(
                    Area.Size.Y * 0.5 - 2,
                    0
                )

            local SafeLocalY =
                math.clamp(
                    LocalRoot.Y,
                    -HalfY,
                    HalfY
                )

            return Area.CFrame
                * CFrame.new(
                    0,
                    SafeLocalY,
                    0
                )
        end


        Rescue.PointInsideRaidArea = function(Position, Area)
            if typeof(Position) ~= "Vector3"
                or not Area
                or not Area:IsA("BasePart")
            then
                return false
            end

            local LocalPosition =
                Area.CFrame:PointToObjectSpace(Position)

            local Half = Area.Size * 0.5

            return math.abs(LocalPosition.X) <= math.max(Half.X - 2, 0)
                and math.abs(LocalPosition.Y) <= Half.Y
                and math.abs(LocalPosition.Z) <= math.max(Half.Z - 2, 0)
        end


        Rescue.ShouldHoldRaidCenter = function(Root, Area)
            if workspace:GetAttribute("Mode") ~= "spiritedawayraid"
                or not Root
                or not Area
            then
                return false
            end

            local ServerArea =
                tonumber(ReadRunValue2("area")) or 0

            if ServerArea ~= 3 then
                Rescue.RaidLastWave = nil
                Rescue.RaidLastVisibleCount = 0
                Rescue.RaidSpawnStableSince = 0
                Rescue.RaidHoldUntil = 0
                return false
            end

            local Wave =
                tonumber(ReadRunValue2("wave")) or 0

            local Remaining =
                tonumber(ReadRunValue2("remaining")) or 0

            local _,
                VisibleCount,
                AttackableCount,
                GuardedBoss =
                GetEnemySnapshot2()

            local Now = os.clock()

            if Wave ~= Rescue.RaidLastWave then
                Rescue.RaidLastWave = Wave
                Rescue.RaidLastVisibleCount = VisibleCount
                Rescue.RaidSpawnStableSince = Now
                Rescue.RaidHoldUntil = Now + 1.15

            elseif VisibleCount > Rescue.RaidLastVisibleCount then
                -- Only an INCREASE extends the settle timer. Enemy deaths should
                -- not pull the player back to center after the wave is populated.
                Rescue.RaidSpawnStableSince = Now
                Rescue.RaidHoldUntil =
                    math.max(
                        Rescue.RaidHoldUntil or 0,
                        Now + 0.80
                    )
            end

            Rescue.RaidLastVisibleCount = VisibleCount

            if Wave <= 0 then
                return false
            end

            if Now < (Rescue.RaidHoldUntil or 0) then
                Rescue.RaidState =
                    "Area3 Spawn Hold"
                return true
            end

            -- Normal mainhall waves are count=10. `remaining` includes enemies
            -- that still have to be brought in, so do not chase the first one
            -- away from center while the rest are pending.
            if Wave <= 3
                and Remaining > 0
                and VisibleCount < Remaining
            then
                Rescue.RaidHoldUntil = Now + 0.30
                Rescue.RaidState =
                    "Area3 Waiting Spawns "
                    .. tostring(VisibleCount)
                    .. "/"
                    .. tostring(Remaining)
                return true
            end

            -- Final No-Face becomes [IMMUNE] through guardedAt while summons /
            -- clone phases are active. Give those adds a short center settle so
            -- the full group can appear before we choose one and leave center.
            if GuardedBoss then
                if AttackableCount <= 0 then
                    Rescue.RaidState =
                        "Boss Immune - Waiting Adds"
                    return true
                end

                if Now - (Rescue.RaidSpawnStableSince or 0) < 0.80 then
                    Rescue.RaidState =
                        "Boss Immune - Settling Adds"
                    return true
                end
            end

            return false
        end


        Rescue.PruneSpikeHazards = function()
            local ServerNow = workspace:GetServerTimeNow()

            for Index = #Rescue.SpikeHazards, 1, -1 do
                local Hazard = Rescue.SpikeHazards[Index]

                if not Hazard
                    or ServerNow > (Hazard.ExpiresAt or 0)
                then
                    table.remove(Rescue.SpikeHazards, Index)
                end
            end
        end


        Rescue.CollectRaidThreats = function(Position)
            local Threats = {}
            local ServerNow = workspace:GetServerTimeNow()

            Rescue.PruneSpikeHazards()

            for _, Hazard in ipairs(Rescue.SpikeHazards) do
                local TimeToImpact =
                    (Hazard.EruptAt or ServerNow)
                    - ServerNow

                if TimeToImpact <= 0.85
                    and TimeToImpact >= -0.22
                then
                    table.insert(Threats, {
                        Position = Hazard.Position,
                        Radius = (Hazard.Radius or 4.5) + 4,
                        Kind = "Spike",
                    })
                end
            end

            -- The game's enemy controller creates aoeIndicator parts for
            -- telegraphed boss attacks (including No-Face's slam). Reading the
            -- real indicator makes the dodge generic instead of hardcoding one
            -- boss animation.
            local Effects = workspace:FindFirstChild("effects")

            if Effects then
                for _, Object in ipairs(Effects:GetChildren()) do
                    if Object:IsA("BasePart")
                        and string.find(
                            string.lower(Object.Name),
                            "aoe",
                            1,
                            true
                        )
                    then
                        table.insert(Threats, {
                            Position = Object.Position,
                            Radius =
                                math.max(Object.Size.X, Object.Size.Z)
                                * 0.5
                                + 4,
                            Kind = "Indicator",
                        })
                    end
                end
            end

            local CurrentDanger = false

            if typeof(Position) == "Vector3" then
                for _, Threat in ipairs(Threats) do
                    local Delta =
                        Vector3.new(
                            Position.X - Threat.Position.X,
                            0,
                            Position.Z - Threat.Position.Z
                        )

                    if Delta.Magnitude <= Threat.Radius then
                        CurrentDanger = true
                        break
                    end
                end
            end

            return Threats, CurrentDanger
        end


        Rescue.PositionSafeFromThreats = function(Position, Threats)
            for _, Threat in ipairs(Threats or {}) do
                local Delta =
                    Vector3.new(
                        Position.X - Threat.Position.X,
                        0,
                        Position.Z - Threat.Position.Z
                    )

                if Delta.Magnitude <= Threat.Radius then
                    return false
                end
            end

            return true
        end


        Rescue.GetRaidDodgeGoal = function(Root, Area, FarmGoal)
            if Settings.AutoDodgeRaidAOE == false
                or not GENV.__AZ_IS_RAID_MODE()
                or not Root
                or not Area
            then
                Rescue.RaidDodgeState = "Idle"
                Rescue.RaidDodgeActive = false
                Rescue.RaidDodgeGoal = nil
                return nil
            end

            local Threats, InDanger =
                Rescue.CollectRaidThreats(Root.Position)

            local Now = os.clock()
            local FarmDanger = false

            -- The old detector only checked the player's CURRENT position.
            -- After one dodge frame the player was safe, so Auto Farm pulled
            -- them straight back onto the boss/AOE. Also test the farm goal.
            if FarmGoal and #Threats > 0 then
                FarmDanger =
                    not Rescue.PositionSafeFromThreats(
                        FarmGoal.Position,
                        Threats
                    )
            end

            -- Once a dodge starts, keep the safe point as exclusive movement
            -- ownership while the telegraph exists. A short clear hold absorbs
            -- one-frame indicator flicker before Auto Farm is allowed back in.
            if Rescue.RaidDodgeActive then
                if #Threats == 0 then
                    if Rescue.RaidDodgeGoal
                        and Now < (Rescue.RaidDodgeHoldUntil or 0)
                    then
                        Rescue.RaidDodgeState = "ClearHold"
                        return Rescue.RaidDodgeGoal
                    end

                    Rescue.RaidDodgeActive = false
                    Rescue.RaidDodgeGoal = nil
                    Rescue.RaidDodgeReason = "Cleared"
                    Rescue.RaidDodgeState = "Safe"
                    return nil
                end

                if Rescue.RaidDodgeGoal
                    and Rescue.PointInsideRaidArea(
                        Rescue.RaidDodgeGoal.Position,
                        Area
                    )
                    and Rescue.PositionSafeFromThreats(
                        Rescue.RaidDodgeGoal.Position,
                        Threats
                    )
                then
                    Rescue.RaidDodgeHoldUntil = Now + 0.55
                    Rescue.RaidDodgeState =
                        "Locked " .. tostring(Rescue.RaidDodgeReason)
                    return Rescue.RaidDodgeGoal
                end
            end

            if (not InDanger and not FarmDanger) or #Threats == 0 then
                Rescue.RaidDodgeState = "Safe"
                return nil
            end

            local Closest = nil
            local ClosestDistance = math.huge
            local Origin = Root.Position

            -- If the boss-farm point is what's dangerous, choose a direction
            -- away from the threat around that point instead of waiting until
            -- the player has already been pulled into it.
            local ThreatReference =
                (FarmDanger and FarmGoal and FarmGoal.Position)
                or Root.Position

            for _, Threat in ipairs(Threats) do
                local Distance =
                    Vector3.new(
                        ThreatReference.X - Threat.Position.X,
                        0,
                        ThreatReference.Z - Threat.Position.Z
                    ).Magnitude

                if Distance < ClosestDistance then
                    ClosestDistance = Distance
                    Closest = Threat
                end
            end

            local Away = Vector3.new(1, 0, 0)

            if Closest then
                local Delta =
                    Vector3.new(
                        ThreatReference.X - Closest.Position.X,
                        0,
                        ThreatReference.Z - Closest.Position.Z
                    )

                if Delta.Magnitude > 0.05 then
                    Away = Delta.Unit
                end
            end

            local Angles = {
                0,
                math.rad(45),
                math.rad(-45),
                math.rad(90),
                math.rad(-90),
                math.rad(135),
                math.rad(-135),
                math.rad(180),
            }

            local Distances = { 12, 18, 26, 34 }

            for _, Distance in ipairs(Distances) do
                for _, Angle in ipairs(Angles) do
                    local Direction =
                        CFrame.Angles(0, Angle, 0)
                            :VectorToWorldSpace(Away)

                    local Candidate =
                        Origin + Direction * Distance

                    if Rescue.PointInsideRaidArea(Candidate, Area)
                        and Rescue.PositionSafeFromThreats(
                            Candidate,
                            Threats
                        )
                    then
                        local Reason =
                            Closest and Closest.Kind or "AOE"

                        local Goal = CFrame.new(Candidate)
                            * Root.CFrame.Rotation

                        Rescue.RaidDodgeActive = true
                        Rescue.RaidDodgeGoal = Goal
                        Rescue.RaidDodgeReason = Reason
                        Rescue.RaidDodgeState = Reason
                        Rescue.RaidDodgeHoldUntil = Now + 0.75
                        Rescue.LastDodgeAt = Now

                        return Goal
                    end
                end
            end

            -- Last-resort fallback: the center of the active raid area is often
            -- safer than remaining inside an imminent ground marker.
            local CenterGoal =
                Rescue.GetRaidAreaGoal(Root, Area)

            if CenterGoal
                and Rescue.PositionSafeFromThreats(
                    CenterGoal.Position,
                    Threats
                )
            then
                CenterGoal = CFrame.new(CenterGoal.Position)
                    * Root.CFrame.Rotation

                Rescue.RaidDodgeActive = true
                Rescue.RaidDodgeGoal = CenterGoal
                Rescue.RaidDodgeReason = "CenterFallback"
                Rescue.RaidDodgeState = "CenterFallback"
                Rescue.RaidDodgeHoldUntil = Now + 0.75
                Rescue.LastDodgeAt = Now
                return CenterGoal
            end

            Rescue.RaidDodgeState = "NoSafePoint"
            return nil
        end


        if EnemyPackets2
            and EnemyPackets2.spikes
            and type(EnemyPackets2.spikes.on) == "function"
        then
            pcall(function()
                Rescue.SpikeListenerCleanup =
                    EnemyPackets2.spikes:on(function(Data)

                        if not Rescue.Active
                            or type(Data) ~= "table"
                            or type(Data.spots) ~= "table"
                        then
                            return
                        end

                        local ServerNow = workspace:GetServerTimeNow()

                        for Index, Position in pairs(Data.spots) do
                            if typeof(Position) == "Vector3" then
                                local Delay =
                                    type(Data.delays) == "table"
                                    and tonumber(Data.delays[Index])
                                    or 0

                                local Radius =
                                    type(Data.radii) == "table"
                                    and tonumber(Data.radii[Index])
                                    or tonumber(Data.radius)
                                    or 4.5

                                local EruptAt =
                                    (tonumber(Data.eruptAt) or ServerNow)
                                    + (Delay or 0)

                                table.insert(
                                    Rescue.SpikeHazards,
                                    {
                                        Position = Position,
                                        Radius = Radius,
                                        EruptAt = EruptAt,
                                        ExpiresAt = EruptAt + 0.45,
                                    }
                                )
                            end
                        end
                    end)
            end)
        end


        Rescue.HandleRaidRoute = function(Root, EnemyRoot)
            if not GENV.__AZ_IS_RAID_MODE() then
                Rescue.RaidState = "NotRaid"
                return false
            end

            local World,
                Area,
                Exit,
                ExitPrompt =
                Rescue.GetRaidRouteObjects()

            -- Every elevator transition swaps/rebuilds the active World segment.
            -- Treat that as a new area route immediately.
            if World ~= Rescue.RaidLastWorld then
                Rescue.RaidLastWorld = World
                Rescue.RaidAreaPart = Area
                Rescue.RaidLastAreaAt = 0
                Rescue.RaidState = "NewArea"
            elseif Area ~= Rescue.RaidAreaPart then
                Rescue.RaidAreaPart = Area
                Rescue.RaidLastAreaAt = 0
            end

            local ExitOpen =
                workspace:GetAttribute("RaidExitOpen")
                    == true
                or (
                    ExitPrompt
                    and ExitPrompt.Enabled == true
                )

            -- Exit state is authoritative. A dead/stale enemy model should never
            -- hold the farm in the finished segment.
            if ExitOpen and Exit then
                Rescue.RaidState = "Elevator"

                local GoalPosition =
                    Exit.Position
                    + Vector3.new(0, 0, 5)

                if (
                    Root.Position
                    - GoalPosition
                ).Magnitude > 2.5
                then
                    Root.CFrame =
                        CFrame.lookAt(
                            GoalPosition,
                            Exit.Position
                        )
                end

                if ExitPrompt
                    and (
                        Root.Position
                        - Exit.Position
                    ).Magnitude
                        <= math.max(
                            tonumber(
                                ExitPrompt.MaxActivationDistance
                            ) or 14,
                            14
                        )
                then
                    if Rescue.FireRaidExitPrompt(
                        ExitPrompt
                    ) then
                        Rescue.RaidState = "ElevatorPrompt"
                        Rescue.RaidLastAreaAt = 0
                    end
                end

                return true
            end

            -- Area 3 must stay in the middle long enough for the full wave /
            -- summon group to materialize. Do this BEFORE following the first
            -- replicated enemy away from the activation volume.
            if Area
                and Rescue.ShouldHoldRaidCenter(
                    Root,
                    Area
                )
            then
                local CenterGoal =
                    Rescue.GetRaidAreaGoal(
                        Root,
                        Area
                    )

                if CenterGoal
                    and (
                        Root.Position
                        - CenterGoal.Position
                    ).Magnitude > 2
                then
                    Root.CFrame = CenterGoal
                end

                return true
            end

            -- Once an ATTACKABLE enemy exists, normal rescue movement/combat
            -- follows it. Guarded/immune No-Face is filtered by NearestEnemy2.
            if EnemyRoot then
                Rescue.RaidState =
                    Rescue.RaidGuardedBoss
                    and "Adds / Shadow"
                    or "Enemy"
                return false
            end

            if not World then
                Rescue.RaidState = "WaitingForWorld"
                return true
            end

            if not Area then
                Rescue.RaidState = "WaitingForArea"
                return true
            end

            if Rescue.IsInsideRaidArea(Root, Area) then
                Rescue.RaidState = "AreaReady"
                return true
            end

            local Now = os.clock()

            if Now - Rescue.RaidLastAreaAt < 0.35 then
                Rescue.RaidState = "EnteringArea"
                return true
            end

            Rescue.RaidLastAreaAt = Now

            local Goal =
                Rescue.GetRaidAreaGoal(
                    Root,
                    Area
                )

            if Goal then
                Rescue.RaidState =
                    "EnterArea "
                    .. tostring(Area.Name)

                -- Area activation should be reliable and immediate. This mirrors
                -- the Story/Join-map behavior of moving inside the real area
                -- volume rather than chasing individual enemy spawn positions.
                Root.CFrame = Goal
            else
                Rescue.RaidState = "AreaGoalMissing"
            end

            return true
        end


        local function MoveFarm2(DeltaTime)
            local IsRaid =
                GENV.__AZ_IS_RAID_MODE()

            local FarmEnabled =
                (IsRaid and Settings.AutoRaidFarm == true)
                or (not IsRaid and Settings.AutoFarm == true)

            local WantsHorizontalHold =
                FarmEnabled
                and (
                    Settings.FarmPosition == "Above"
                    or Settings.FarmPosition == "Below"
                )

            Rescue.SetHorizontalHoldActive(WantsHorizontalHold)

            if not FarmEnabled or not Alive2() then
                Rescue.RaidDodgeActive = false
                Rescue.RaidDodgeGoal = nil
                return
            end

            local _, EnemyRoot =
                NearestEnemy2()

            local Root =
                GetRoot2()

            if not Root then
                return
            end

            local EnemyFarmGoal =
                EnemyRoot
                and DesiredEnemyCFrame2(EnemyRoot)
                or nil

            if not IsRaid then
                Rescue.RaidState = "Inactive"
                Rescue.RaidDodgeState = "Idle"

                if not EnemyRoot
                    and Rescue.RunNormalProgressionAssist(DeltaTime)
                then
                    return
                end
            end

            -- AOE safety has first movement priority while the raid is active.
            -- It consumes the exact enemySpikes telegraph packet plus the
            -- game's own aoeIndicator parts for other telegraphed boss slams.
            if IsRaid
                and workspace:GetAttribute("RaidExitOpen") ~= true
            then
                local _, RaidArea =
                    Rescue.GetRaidRouteObjects()

                local DodgeGoal =
                    Rescue.GetRaidDodgeGoal(
                        Root,
                        RaidArea,
                        EnemyFarmGoal
                    )

                if DodgeGoal then
                    -- Dodge movement has EXCLUSIVE priority. Move quickly but
                    -- smoothly to the locked safe point; do not teleport back
                    -- and forth between the boss and the hazard.
                    local DodgeDistance =
                        (Root.Position - DodgeGoal.Position).Magnitude

                    if DodgeDistance > 0.05 then
                        local DodgeAlpha =
                            math.clamp(
                                (240 * DeltaTime)
                                / math.max(DodgeDistance, 0.001),
                                0,
                                1
                            )

                        local DodgePosition =
                            Root.Position:Lerp(
                                DodgeGoal.Position,
                                DodgeAlpha
                            )

                        Root.CFrame =
                            CFrame.new(DodgePosition)
                            * Root.CFrame.Rotation
                    end

                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero

                    Rescue.RaidState =
                        "Dodge "
                        .. tostring(
                            Rescue.RaidDodgeState
                        )
                    return
                end
            end

            -- Raid routing handles no-enemy periods by staying inside the live
            -- World.Areas volume, then uses the elevator when RaidExitOpen opens.
            if IsRaid
                and Rescue.HandleRaidRoute(
                    Root,
                    EnemyRoot
                )
            then
                return
            end

            if not EnemyRoot then
                return
            end

            local Goal =
                EnemyFarmGoal
                or DesiredEnemyCFrame2(
                    EnemyRoot
                )

            if not Goal then
                return
            end

            local HorizontalHold =
                Settings.FarmPosition == "Above"
                or Settings.FarmPosition == "Below"

            if HorizontalHold then
                local HoldDistance =
                    (
                        Root.Position
                        - Goal.Position
                    ).Magnitude

                -- Teleport mode still gets into range immediately when far
                -- away, but once in range it becomes a damped horizontal hold
                -- instead of hard-setting CFrame every heartbeat. Tween mode
                -- uses its normal travel speed while far away and the same
                -- damped hold once close. No extra UI sliders are needed.
                if Settings.FarmMethod ~= "Tween"
                    and HoldDistance > 24
                then
                    Root.CFrame = Goal

                else
                    local Alpha

                    if Settings.FarmMethod == "Tween"
                        and HoldDistance > 12
                    then
                        Alpha = math.clamp(
                            (135 * DeltaTime)
                            / math.max(HoldDistance, 0.001),
                            0,
                            1
                        )
                    else
                        Alpha = math.clamp(
                            1 - math.exp(-20 * DeltaTime),
                            0,
                            1
                        )
                    end

                    local SmoothPosition =
                        Root.Position:Lerp(
                            Goal.Position,
                            Alpha
                        )

                    -- Position is damped, orientation is exact. Lerp-ing the
                    -- full CFrame let the humanoid upright correction win part
                    -- of every frame, which looked like a forward lean.
                    Root.CFrame =
                        CFrame.new(SmoothPosition)
                        * Goal.Rotation
                end

                -- Kill leftover physics motion that otherwise makes a
                -- horizontal character bounce, roll, or wobble in place.
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero

                return
            end

            if Settings.FarmMethod == "Tween" then
                local Distance =
                    (
                        Root.Position
                        - Goal.Position
                    ).Magnitude

                if Distance > 0.05 then
                    local Alpha =
                        math.clamp(
                            (
                                135
                                * DeltaTime
                            )
                            / math.max(
                                Distance,
                                0.001
                            ),
                            0,
                            1
                        )

                    Root.CFrame =
                        Root.CFrame:Lerp(
                            Goal,
                            Alpha
                        )
                end
            else
                Root.CFrame =
                    Goal
            end
        end


        local function CooldownReady2(Store, Slot)
            if not Store
                or not Store.state
                or not Store.state.cooldowns
            then
                return true
            end

            local CharacterName = nil

            pcall(function()
                CharacterName = Store.state.character:get()
            end)

            if not CharacterName then
                return true
            end

            local Key =
                type(PlayerNamespace2.skillCooldownKey) == "function"
                and PlayerNamespace2.skillCooldownKey(CharacterName, Slot)
                or (tostring(CharacterName) .. ".skill" .. tostring(Slot))

            local Success, CooldownLeaf = pcall(function()
                return Store.state.cooldowns:get(Key)
            end)

            if not Success or not CooldownLeaf then
                return true
            end

            local Till = tonumber(ReadLeaf(CooldownLeaf))

            return not Till
                or workspace:GetServerTimeNow() >= Till
        end


        local function FireSkill2(Slot)
            if not Alive2()
                or not CharacterPackets2.performSkill
            then
                return false
            end

            local Store = GetPlayerStore2()

            if not Store or not CooldownReady2(Store, Slot) then
                return false
            end

            if Slot == 4 then
                local Progress = nil

                pcall(function()
                    Progress = Store.state.ultProgress:get()
                end)

                if (tonumber(Progress) or 0) < 100
                    or LocalPlayerObject:GetAttribute("UltimateLocked")
                then
                    return false
                end
            end

            local CharacterName = nil

            pcall(function()
                CharacterName = Store.state.character:get()
            end)

            if not CharacterName then
                return false
            end

            Rescue.Sequence =
                (Rescue.Sequence % 4294967295) + 1

            local Request = {
                id = Rescue.Sequence,
                char = CharacterName,
                character = LocalPlayerObject.Character,
                skill = Slot,
                expiresAt = workspace:GetServerTimeNow() + 5,
            }

            local Success = pcall(function()
                CharacterPackets2.performSkill:fire(Request)
            end)

            return Success
        end


        local function RunCombat2()
            if not Alive2() then
                return
            end

            -- Skills/M1s can contain their own movement and pull the character
            -- back toward the boss. While a Raid AOE dodge lock is active,
            -- movement safety wins completely; combat resumes automatically
            -- after the telegraph clears.
            if GENV.__AZ_IS_RAID_MODE()
                and Rescue.RaidDodgeActive
            then
                return
            end

            local _, EnemyRoot, EnemyDistance = NearestEnemy2()
            local Root = GetRoot2()
            local Now = os.clock()

            if not EnemyRoot then
                if not GENV.__AZ_IS_RAID_MODE()
                    and Settings.AutoFarm
                    and Settings.AutoM1
                    and Root
                    and CharacterPackets2.performM1
                then
                    local Rubble = Rescue.FindNormalRubble(Root)

                    if Rubble and Rubble.Goal
                        and (Root.Position - Rubble.Goal.Position).Magnitude <= 12
                        and Now >= Rescue.NextM1
                    then
                        Rescue.NextM1 = Now + 0.40

                        pcall(function()
                            CharacterPackets2.performM1:fire()
                        end)
                    end
                end

                return
            end

            if Settings.AutoM1
                and Now >= Rescue.NextM1
                and CharacterPackets2.performM1
            then
                Rescue.NextM1 = Now + 0.42

                pcall(function()
                    CharacterPackets2.performM1:fire()
                end)
            end


            if Settings.AutoSkills
                and Now >= Rescue.NextSkill
            then
                Rescue.NextSkill = Now + 0.16

                local Slots = {}

                for Slot = 1, 3 do
                    local Name = "Skill " .. tostring(Slot)

                    if type(Settings.SelectedSkills) ~= "table"
                        or Settings.SelectedSkills[Name] ~= false
                    then
                        table.insert(Slots, Slot)
                    end
                end

                if #Slots > 0 then
                    Rescue.SkillCursor =
                        ((Rescue.SkillCursor - 1) % #Slots) + 1

                    FireSkill2(Slots[Rescue.SkillCursor])

                    Rescue.SkillCursor =
                        (Rescue.SkillCursor % #Slots) + 1
                end
            end


            if Settings.AutoUltimate
                and Now >= Rescue.NextUltimate
            then
                Rescue.NextUltimate = Now + 0.35
                FireSkill2(4)
            end


            if Settings.AutoBlock
                and CharacterPackets2.performBlock
            then
                if Settings.BlockMode == "Hold Block" then
                    if Now >= Rescue.NextBlock then
                        Rescue.NextBlock = Now + 0.30
                        Rescue.BlockSent = true

                        pcall(function()
                            CharacterPackets2.performBlock:fire(true)
                        end)
                    end
                elseif EnemyDistance <= 14
                    and Now >= Rescue.NextBlock
                then
                    Rescue.NextBlock = Now + 0.45
                    Rescue.BlockSent = true

                    pcall(function()
                        CharacterPackets2.performBlock:fire(true)
                    end)

                    task.delay(0.10, function()
                        if Rescue.Active
                            and CharacterPackets2.performBlock
                        then
                            pcall(function()
                                CharacterPackets2.performBlock:fire(false)
                            end)
                        end
                    end)
                end
            elseif Rescue.BlockSent
                and CharacterPackets2.performBlock
            then
                Rescue.BlockSent = false

                pcall(function()
                    CharacterPackets2.performBlock:fire(false)
                end)
            end
        end


        local function RunLoot2()
            Rescue.LootState = "Idle"

            if not Settings.AutoPickupLoot
                or not DropStore2
                or not DropStore2.store
                or not RewardPackets2
                or not RewardPackets2.recoverDrop
            then
                return
            end

            if os.clock() < Rescue.NextLoot then
                return
            end

            Rescue.NextLoot = os.clock() + 0.16

            local Root = GetRoot2()

            if not Root then
                return
            end

            local Success, Drops = pcall(function()
                return DropStore2.store.state:getAll()
            end)

            if not Success or type(Drops) ~= "table" then
                Rescue.LootState = "StoreUnavailable"
                return
            end

            local BestId = nil
            local BestPosition = nil
            local BestDistance = math.huge
            local DropCount = 0

            for Id, DropState in pairs(Drops) do
                local Position = nil

                pcall(function()
                    Position = ReadLeaf(DropState.position)
                end)

                if typeof(Position) == "Vector3" then
                    DropCount = DropCount + 1

                    local Distance =
                        (Root.Position - Position).Magnitude

                    if Distance < BestDistance then
                        BestDistance = Distance
                        BestId = Id
                        BestPosition = Position
                    end
                end
            end

            if BestId == nil or not BestPosition then
                Rescue.LootState = "NoDrops"
                return
            end

            Rescue.LootState =
                "Drop "
                .. tostring(BestId)
                .. " ("
                .. tostring(DropCount)
                .. ")"

            -- The game's own drop controller only finishes recoverDrop after
            -- the player is close enough for the magnet pickup (about 12 studs).
            -- The old rescue code refused to move to loot whenever Auto Farm was
            -- enabled, so raid drops outside that radius could never be recovered.
            -- Snap briefly into pickup range even while farming; normal farm/raid
            -- movement resumes on the next heartbeat.
            if BestDistance > 10 then
                local PickupCF =
                    CFrame.new(
                        BestPosition
                        + Vector3.new(0, 2.5, 0)
                    )

                Root.CFrame = PickupCF
                Rescue.LootState =
                    "Collecting "
                    .. tostring(BestId)

                -- Fire once immediately and once after a short replication beat.
                -- The second attempt covers executors/servers where the CFrame
                -- reaches the server one network step after the remote.
                pcall(function()
                    RewardPackets2.recoverDrop:fire(BestId)
                end)

                task.delay(0.07, function()
                    if Rescue.Active
                        and Settings.AutoPickupLoot
                        and RewardPackets2
                        and RewardPackets2.recoverDrop
                    then
                        pcall(function()
                            RewardPackets2.recoverDrop:fire(BestId)
                        end)
                    end
                end)

                return
            end

            if BestDistance <= 15 then
                Rescue.LootState =
                    "Recover "
                    .. tostring(BestId)

                pcall(function()
                    RewardPackets2.recoverDrop:fire(BestId)
                end)
            end
        end


        -- Reliable end-action fallback for the updated run place. This runs
        -- independently of the legacy Story automation engine, so Raid retry
        -- still works when the rescue runtime is the active farm controller.
        Rescue.RunEndAction = function()
            if not Settings.AutoRetry
                or workspace:GetAttribute("Mode") == "infinite"
                or not Rescue.RunPackets
                or not Rescue.RunPackets.endAction
                or not RunStore2
                or not RunStore2.store
                or not RunStore2.store.state
            then
                Rescue.EndActionState = "Idle"
                return
            end

            local Now = os.clock()

            if Now < Rescue.NextEndAction then
                return
            end

            local State = RunStore2.store.state
            local UserId = tostring(LocalPlayerObject.UserId)
            local Participant = nil

            pcall(function()
                Participant = State.participants:get(UserId)
            end)

            if not Participant then
                Rescue.EndActionState = "NoParticipant"
                return
            end

            local Status = ReadLeaf(Participant.status)

            if Status == "active" then
                Rescue.EndActionState = "RunActive"
                return
            end

            local ParticipantFinishedAt =
                ReadLeaf(Participant.finishedAt)

            local RunFinishedAt =
                ReadRunValue2("finishedAt")

            local ResultEndsAt =
                ReadRunValue2("resultEndsAt")

            -- Do not vote during a pre-run/waiting state that merely happens to
            -- use a non-active participant status. At least one result marker
            -- must exist before we send the Retry vote.
            if ParticipantFinishedAt == nil
                and RunFinishedAt == nil
                and ResultEndsAt == nil
            then
                Rescue.EndActionState =
                    "WaitingResult"
                return
            end

            local TravelStatus =
                ReadLeaf(Participant.travelStatus)

            if TravelStatus ~= "idle" then
                Rescue.EndActionState =
                    "Travel "
                    .. tostring(TravelStatus)
                return
            end

            local OwnVote = nil

            pcall(function()
                local VoteLeaf =
                    State.resultVotes:get(UserId)

                OwnVote = ReadLeaf(VoteLeaf)
            end)

            if tonumber(OwnVote) == 1 then
                Rescue.EndActionState = "RetryAccepted"
                Rescue.NextEndAction = Now + 0.75
                return
            end

            if type(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION) == "function" then
                local GuardOK, Ready = pcall(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION)
                if GuardOK and Ready == false then
                    Rescue.EndActionState = "WebhookPending"
                    Rescue.NextEndAction = Now + 0.30
                    return
                end
            end

            Rescue.NextEndAction = Now + 1.00
            Rescue.EndActionState = "RetrySent"

            local Fired, FireError =
                pcall(function()
                    Rescue.RunPackets.endAction:fire(1)
                end)

            if Fired then
                print(
                    "[Anime Zero] Auto Retry | rescue vote sent | mode:",
                    tostring(workspace:GetAttribute("Mode")),
                    "| status:",
                    tostring(Status)
                )
            else
                Rescue.EndActionState = "RetryError"
                warn(
                    "[Anime Zero][Auto Retry]",
                    tostring(FireError)
                )
            end
        end


        Rescue.Ready = true
        GENV.__AZ_FARM_RESCUE_ACTIVE = true
        GENV.__AZ_FARM_ENGINE_ACTIVE = true

        print(
            "[Anime Zero] Immediate Farm Rescue ACTIVE | PlaceId:",
            game.PlaceId
        )


        Rescue.Connection =
            RunServiceService.Heartbeat:Connect(function(DeltaTime)

                if not Rescue.Active then
                    return
                end

                -- End-action voting is kept independent of movement/combat so
                -- Retry works in Raid even when the legacy farm engine is idle.
                local SuccessEndAction, EndActionError =
                    pcall(Rescue.RunEndAction)

                -- Outside Raid, the full legacy engine still owns enemy
                -- movement. The rescue runtime only assists the exact pieces
                -- that can strand Story/Endless after an update: active rubble
                -- and entering/recovering the current area when no enemy exists.
                -- Inside Raid modes, the rescue runtime owns movement.
                if GENV.__AZ_FARM_FULL_ENGINE_ACTIVE == true
                    and not GENV.__AZ_IS_RAID_MODE()
                then
                    GENV.__AZ_FARM_ENGINE_ACTIVE = true

                    local AssistOK, AssistError =
                        pcall(
                            Rescue.RunNormalProgressionAssist,
                            DeltaTime
                        )

                    if not AssistOK then
                        warn(
                            "[Anime Zero][Normal Progression Assist]",
                            tostring(AssistError)
                        )
                    end

                    return
                end

                GENV.__AZ_FARM_ENGINE_ACTIVE = true

                local SuccessMove, MoveError =
                    pcall(MoveFarm2, DeltaTime)

                local SuccessCombat, CombatError =
                    pcall(RunCombat2)

                local SuccessLoot, LootError =
                    pcall(RunLoot2)

                if os.clock() - Rescue.LastDebug >= 2 then
                    Rescue.LastDebug = os.clock()

                    local _, _, EnemyDistance = NearestEnemy2()
                    local Folder = workspace:FindFirstChild("enemies")

                    print(
                        "[Anime Zero][Rescue] enemies=",
                        Folder and #Folder:GetChildren() or 0,
                        "distance=",
                        EnemyDistance < math.huge
                            and math.floor(EnemyDistance * 10) / 10
                            or "none",
                        "wave=",
                        ReadRunValue2("wave") or "?",
                        "remaining=",
                        ReadRunValue2("remaining") or "?",
                        "farm=",
                        Settings.AutoFarm == true,
                        "raidFarm=",
                        Settings.AutoRaidFarm == true,
                        "normal=",
                        Rescue.NormalState,
                        "stuckFor=",
                        Rescue.NormalProgressAt > 0
                            and math.floor(os.clock() - Rescue.NormalProgressAt)
                            or 0,
                        "fallback=",
                        Rescue.NormalFallbackReason,
                        "m1=",
                        Settings.AutoM1 == true,
                        "skills=",
                        Settings.AutoSkills == true,
                        "raid=",
                        Rescue.RaidState,
                        "immuneBoss=",
                        Rescue.RaidGuardedBoss == true,
                        "dodge=",
                        Rescue.RaidDodgeState,
                        "exit=",
                        workspace:GetAttribute("RaidExitOpen") == true,
                        "loot=",
                        Rescue.LootState,
                        "retry=",
                        Rescue.EndActionState,
                        "ok=",
                        SuccessMove and SuccessCombat and SuccessLoot and SuccessEndAction
                    )

                    if not SuccessMove then
                        warn("[Anime Zero][Rescue] movement:", MoveError)
                    end

                    if not SuccessCombat then
                        warn("[Anime Zero][Rescue] combat:", CombatError)
                    end

                    if not SuccessLoot then
                        warn("[Anime Zero][Rescue] loot:", LootError)
                    end

                    if not SuccessEndAction then
                        warn("[Anime Zero][Rescue] retry:", EndActionError)
                    end
                end
            end)
    end)
end)()



