local function questDebugSnapshot()
    local info=Hub.QuestSelectedData
    local id=info and info.id or "None"
    local active=nil
    if id~="None" then
        local ok,value=pcall(Hub.QuestFns.questProgressState,id)
        if ok and type(value)=="table" then active=value end
    end
    local char,root=myCharacter()
    local stage=active and tonumber(active.stage) or nil
    local progress=active and tonumber(active.stage_progress) or nil
    local def=info and type(info.definition)=="table" and info.definition or nil
    local steps=def and type(def.STAGES)=="table" and def.STAGES or nil
    local step=steps and stage and steps[stage] or nil
    local function v3(pos)
        if typeof(pos)~="Vector3" then return "None" end
        return string.format("(%.1f, %.1f, %.1f)",pos.X,pos.Y,pos.Z)
    end
    local distance="N/A"
    if root and typeof(Hub.QuestMoveTo)=="Vector3" then
        distance=string.format("%.1f studs",(Hub.QuestMoveTo-root.Position).Magnitude)
    end
    local target=Hub.QuestTarget
    local targetName="None"
    local targetHealth="N/A"
    if target and target.Model and target.Model.Parent then
        targetName=target.Model.Name
        if target.Hum then
            local okHP,hp,maxHP=pcall(function()
                return target.Hum.Health,target.Hum.MaxHealth
            end)
            if okHP then targetHealth=string.format("%.0f/%.0f",hp,maxHP) end
        end
    end
    local mode=stage and string.format("%d/%d | %s/%s",stage,
        #(steps or {}),tostring(progress or 0),tostring(step and step.needs or 1))
        or (active and "Active (stage unreported)" or "Not active")
    local carryingText="N/A"
    if id=="HouseRepairs" then carryingText=tostring(Hub.QuestFns.questCarryingPlank()) end
    local lines={
        "Quest: "..tostring(info and info.name or "None").." ["..tostring(id).."]",
        "Category: "..tostring(Hub.QuestSelectedCategory).." | Auto Quest: "..tostring(Hub.AutoQuest),
