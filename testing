;(function()

    local TeleportService =
        game:GetService("TeleportService")

    local HttpService =
        game:GetService("HttpService")

    local Key =
        "__AZ_LOBBY_UI_STATE_V1"

    local DiskFile =
        "AnimeZero/lobby_ui_state_v1.json"

    local LegacyFile =
        "AnimeZero/cross_place_ui_state.json"


    local function Copy(Value)

        if type(Value) ~= "table" then
            return Value
        end


        local Result = {}

        for KeyName, Entry in pairs(Value) do
            Result[KeyName] =
                type(Entry) == "table"
                and Copy(Entry)
                or Entry
        end

        return Result
    end


    local function ReadJson(FileName)

        if type(readfile) ~= "function"
            or type(isfile) ~= "function"
            or not isfile(FileName)
        then
            return nil
        end


        local Success, Data =
            pcall(function()
                return HttpService:JSONDecode(
                    readfile(FileName)
                )
            end)


        return Success
            and type(Data) == "table"
            and Data
            or nil
    end


    local function Single(Value)

        if type(Value) == "string" then
            return Value
        end


        if type(Value) == "table" then

            if type(Value[1]) == "string" then
                return Value[1]
            end


            for Name, Enabled in pairs(Value) do
                if type(Name) == "string"
                    and Enabled == true
                then
                    return Name
                end
            end
        end


        return nil
    end


    local Saved =
        GENV[Key]


    if type(Saved) ~= "table"
        or next(Saved) == nil
    then

        local Success,
            TeleportSaved =
            pcall(function()
                return TeleportService
                    :GetTeleportSetting(Key)
            end)


        if Success
            and type(TeleportSaved) == "table"
            and next(TeleportSaved) ~= nil
        then

            Saved = TeleportSaved
        else
            Saved = ReadJson(DiskFile)
        end
    end


    if type(Saved) ~= "table"
        or next(Saved) == nil
    then

        local Legacy =
            ReadJson(LegacyFile)


        if type(Legacy) == "table" then

            Saved = {
                SelectedMap = Single(Legacy.LobbyMap),
                SelectedAct = Single(Legacy.LobbyAct),
                SelectedMapDifficulty =
                    Single(Legacy.LobbyMapDifficulty),
                AutoJoinMap = Legacy.AutoJoinMap,

                AutoRetry = Legacy.AutoRetry,
                AutoLeave = Legacy.AutoLeave,
                AutoNext = Legacy.AutoNext,
                LeaveAfterMatches = Legacy.MatchesBeforeLeave,
                AutoLeaveAfterMatches =
                    Legacy.AutoLeaveAfterMatches,

                SelectedEndlessMap =
                    Single(Legacy.LobbyEndlessMap),
                SelectedEndlessDifficulty =
                    Single(Legacy.LobbyEndlessDifficulty),
                AutoJoinEndless = Legacy.AutoJoinEndless,
                SelectedRaidMap =
                    Single(Legacy.LobbyRaidMap)
                    or Single(Legacy.SelectedRaidMap),
                AutoJoinRaid = Legacy.AutoJoinRaid,
                EndlessLeaveWave = Legacy.EndlessWaveToLeave,
                AutoLeaveEndlessAtWave =
                    Legacy.AutoLeaveEndlessAtWave,
            }
        end
    end


    Saved =
        type(Saved) == "table"
        and Saved
        or {}


    local User = {
        SelectedMap =
            type(Saved.SelectedMap) == "string"
            and Saved.SelectedMap
            or Settings.SelectedMap,

        SelectedAct =
            (
                Saved.SelectedAct == "Act 1"
                or Saved.SelectedAct == "Act 2"
                or Saved.SelectedAct == "Act 3"
            )
            and Saved.SelectedAct
            or Settings.SelectedAct,

        SelectedMapDifficulty =
            (
                Saved.SelectedMapDifficulty == "Easy"
                or Saved.SelectedMapDifficulty == "Medium"
                or Saved.SelectedMapDifficulty == "Hard"
                or Saved.SelectedMapDifficulty == "Nightmare"
            )
            and Saved.SelectedMapDifficulty
            or Settings.SelectedMapDifficulty,

        AutoJoinMap =
            type(Saved.AutoJoinMap) == "boolean"
            and Saved.AutoJoinMap
            or Settings.AutoJoinMap,

        AutoRetry =
            type(Saved.AutoRetry) == "boolean"
            and Saved.AutoRetry
            or Settings.AutoRetry,

        AutoLeave =
            type(Saved.AutoLeave) == "boolean"
            and Saved.AutoLeave
            or Settings.AutoLeave,

        AutoNext =
            type(Saved.AutoNext) == "boolean"
            and Saved.AutoNext
            or Settings.AutoNext,

        LeaveAfterMatches =
            math.clamp(
                math.floor(
                    tonumber(Saved.LeaveAfterMatches)
                    or tonumber(Settings.LeaveAfterMatches)
                    or 5
                ),
                1,
                999
            ),

        AutoLeaveAfterMatches =
            type(Saved.AutoLeaveAfterMatches) == "boolean"
            and Saved.AutoLeaveAfterMatches
            or Settings.AutoLeaveAfterMatches,

        SelectedEndlessMap =
            type(Saved.SelectedEndlessMap) == "string"
            and Saved.SelectedEndlessMap
            or Settings.SelectedEndlessMap,

        SelectedEndlessDifficulty =
            (
                Saved.SelectedEndlessDifficulty == "Easy"
                or Saved.SelectedEndlessDifficulty == "Medium"
                or Saved.SelectedEndlessDifficulty == "Hard"
                or Saved.SelectedEndlessDifficulty == "Nightmare"
            )
            and Saved.SelectedEndlessDifficulty
            or Settings.SelectedEndlessDifficulty,

        AutoJoinEndless =
            type(Saved.AutoJoinEndless) == "boolean"
            and Saved.AutoJoinEndless
            or Settings.AutoJoinEndless,

        SelectedRaidMap =
            Saved.SelectedRaidMap == "BathTub"
                and "Spirit's Bathtub"
            or Saved.SelectedRaidMap == "ShadowGate"
                and "Shadow Gate"
            or (
                Saved.SelectedRaidMap == "Spirit's Bathtub"
                or Saved.SelectedRaidMap == "Shadow Gate"
            )
                and Saved.SelectedRaidMap
            or Settings.SelectedRaidMap,

        AutoJoinRaid =
            type(Saved.AutoJoinRaid) == "boolean"
            and Saved.AutoJoinRaid
            or Settings.AutoJoinRaid,

        EndlessLeaveWave =
            math.clamp(
                math.floor(
                    tonumber(Saved.EndlessLeaveWave)
                    or tonumber(Settings.EndlessLeaveWave)
                    or 10
                ),
                1,
                99999
            ),

        AutoLeaveEndlessAtWave =
            type(Saved.AutoLeaveEndlessAtWave) == "boolean"
            and Saved.AutoLeaveEndlessAtWave
            or Settings.AutoLeaveEndlessAtWave,
    }


    GENV.__AZ_LOBBY_USER_SETTINGS =
        User


    local function ApplyToRuntime()

        Settings.SelectedMap =
            User.SelectedMap

        Settings.SelectedAct =
            User.SelectedAct

        Settings.SelectedMapDifficulty =
            User.SelectedMapDifficulty

        Settings.AutoJoinMap =
            User.AutoJoinMap == true

        Settings.AutoRetry =
            User.AutoRetry == true

        Settings.AutoLeave =
            User.AutoLeave == true

        Settings.AutoNext =
            User.AutoNext == true

        Settings.LeaveAfterMatches =
            User.LeaveAfterMatches

        Settings.AutoLeaveAfterMatches =
            User.AutoLeaveAfterMatches == true

        Settings.SelectedEndlessMap =
            User.SelectedEndlessMap

        Settings.SelectedEndlessDifficulty =
            User.SelectedEndlessDifficulty

        Settings.AutoJoinEndless =
            User.AutoJoinEndless == true

        Settings.SelectedRaidMap =
            User.SelectedRaidMap

        Settings.AutoJoinRaid =
            User.AutoJoinRaid == true

        Settings.EndlessLeaveWave =
            User.EndlessLeaveWave

        Settings.AutoLeaveEndlessAtWave =
            User.AutoLeaveEndlessAtWave == true
    end


    local function Persist()

        local Snapshot =
            Copy(User)


        GENV[Key] =
            Snapshot


        pcall(function()
            TeleportService
                :SetTeleportSetting(
                    Key,
                    Snapshot
                )
        end)


        if type(writefile) == "function" then

            if makefolder then
                pcall(makefolder, "AnimeZero")
            end


            pcall(function()
                writefile(
                    DiskFile,
                    HttpService:JSONEncode(
                        Snapshot
                    )
                )
            end)
        end


        return true
    end


    Settings.SetLobbyUserPreference =
        function(Name, Value)

            if User[Name] == nil then
                return false
            end


            User[Name] =
                Copy(Value)

            Persist()

            return true
        end


    Settings.PersistLobbyPreferences =
        Persist


    Settings.ReloadLobbyUserPreferences =
        function()

            ApplyToRuntime()

            return true
        end


    ApplyToRuntime()

    Persist()

end)()


