function Systems.getCurrentQuest(data)
    local quest = data and data.Quest
    local current = quest and quest.Current

    if type(current) ~= "table" then
        return nil
    end

    if type(current.Id) ~= "string" or current.Id == "" then
        return nil
    end

    return current
end

function Systems.isQuestDone(data, questId)
    local unlockIsland = Systems.QuestUnlockedIslandMap[questId]

    if unlockIsland and Systems.isIslandAvailable(data, unlockIsland) then
        return true
    end

    return type(data) == "table"
        and type(data.Quest) == "table"
        and type(data.Quest.Done) == "table"
        and data.Quest.Done[questId] == true
end

function Systems.isQuestVisibleNow(data, questId)
    local quest = QuestConfig.Data[questId]
    if not quest then
        return false
    end

    local visibleIsland = quest.visibleWhenIslandUnlocked

    if visibleIsland
        and not Systems.isIslandAvailable(data, visibleIsland) then
        return false
    end

    if quest.repeatable == true then
        return true
    end

    return not Systems.isQuestDone(data, questId)
end

function Systems.countQuestFish(
    data,
    islandId,
    rarity,
    minimumWeight,
    exactFishId
)
    local count = 0

    for _, fish in pairs(getFishInventory(data)) do
        if type(fish) == "table" then
            local fishId = fish.fishId
            local info = fishId and Catalog.Fish.GetById(fishId)
            local weight = tonumber(fish.weight) or 0

            if (not exactFishId or fishId == exactFishId)
                and (not rarity or info and info.rarity == rarity)
                and (not islandId or fishBelongsToIsland(fishId, islandId))
                and weight >= (tonumber(minimumWeight) or 0) then

                count += 1
            end
        end
    end

    return count
end

function Systems.hasRequiredSpecificFishes(data, required)
    if type(required) ~= "table" then
        return true
    end

    for fishId, amount in pairs(required) do
        if Systems.countQuestFish(data, nil, nil, 0, fishId)
            < (tonumber(amount) or 0) then
            return false
        end
    end

    return true
end

function Systems.hasUnlock6Fishes(data)
    for fishId, minimumWeight in pairs(
        QuestConfig.UnlockIsland6MinWeightKg or {}
    ) do
        if Systems.countQuestFish(
            data,
            "island_volcano",
            nil,
            minimumWeight,
            fishId
        ) < 1 then
            return false
        end
    end

    return true
end

function Systems.availableSkillBookCount(data, skillId)
    local ok, counts = pcall(function()
        return skillBookAvailability.GetCounts(data, skillId)
    end)

    if ok and type(counts) == "table" then
        return tonumber(counts.available) or 0
    end

    local books =
        data
        and data.Inventory
        and data.Inventory.Books

    return type(books) == "table"
        and (tonumber(books[skillId]) or 0)
        or 0
end

function Systems.hasRequiredBooks(data, required)
    if type(required) ~= "table" then
        return true
    end

    for skillId, amount in pairs(required) do
        if Systems.availableSkillBookCount(data, skillId)
            < (tonumber(amount) or 0) then
            return false
        end
    end

    return true
end

function Systems.questReadyToComplete(data, questId)
    local current = Systems.getCurrentQuest(data)

    if not current or current.Id ~= questId then
        return false
    end

    local progress =
        type(current.Progress) == "table"
        and current.Progress
        or {}

    local coin = tonumber(data.Coin) or 0
    local requiredCoin = tonumber(progress.RequiredCoin) or 0

    if coin < requiredCoin then
        return false
    end

    if questId == "unlock_island_2"
        or questId == "unlock_island_3" then
        return true
    end

    if questId == "unlock_island_4" then
        return Systems.countQuestFish(
            data,
            "island_desert",
            "Legendary",
            0
        ) >= (tonumber(progress.RequiredFish) or 3)
    end

    if questId == "unlock_island_5" then
        return Systems.hasRequiredSpecificFishes(
            data,
            progress.RequiredFishes or {
                frozen_crown_dragonfish = 1,
                frosttusk_seal = 1,
                frostmaw_monster = 1,
            }
        )
    end

    if questId == "unlock_island_6" then
        return Systems.hasUnlock6Fishes(data)
    end

    if questId == "crimson_bead_rod" then
        return (tonumber(progress.CurrentFished) or 0)
            >= (tonumber(progress.RequiredFished) or 100)
    end

    if questId == "bamboo_rod" then
        return getItemCount(data, "bamboo_fragment")
            >= (tonumber(progress.RequiredBamboo) or 20)
    end

    if questId == "heaven_piercer_turtle_rod" then
        return Systems.countQuestFish(
            data,
            "island_fossil",
            "Legendary",
            0
        ) >= (tonumber(progress.RequiredFish) or 5)
    end

    if questId == "zen_staff_rod" then
        return (tonumber(progress.CurrentFish) or 0)
            >= (tonumber(progress.RequiredFish) or 5)
    end

    if questId == "dread_fish_rod" then
        return Systems.countQuestFish(
            data,
            "island_fossil",
            "Mythical",
            0
        ) >= (tonumber(progress.RequiredFish) or 1)
    end

    if questId == "white_tiger" then
        return Systems.countQuestFish(
            data,
            "island_desert",
            "Legendary",
            tonumber(QuestConfig.WhiteTigerMinWeightKg) or 1000
        ) >= (tonumber(progress.RequiredFish) or 3)
    end

    if questId == "phoenix" then
        return Systems.hasRequiredBooks(
            data,
            QuestConfig.PhoenixRequiredBooks or {}
        )
        and Systems.countQuestFish(
            data,
            "island_snow",
            "Legendary",
            0
        ) >= (tonumber(progress.RequiredFish) or 3)
    end

    if questId == "azure_dragon" then
        return (tonumber(progress.CurrentKills) or 0)
            >= (tonumber(progress.RequiredKills) or 100)
        and Systems.countQuestFish(
            data,
            "island_volcano",
            "Legendary",
            0
        ) >= (tonumber(progress.RequiredFish) or 3)
    end

    if questId == "supreme_king" then
        return Systems.hasRequiredBooks(
            data,
            progress.RequiredBooks or {
                rod_gate_20_percent = 1,
            }
        )
        and (tonumber(progress.CurrentUsedSkill) or 0)
            >= (tonumber(progress.CatchWithSkill) or 5)
    end

    if questId == "taiji_hooking_art_v2" then
        return (tonumber(progress.CurrentKills) or 0)
            >= (tonumber(progress.RequiredKills) or 100)
        and Systems.availableSkillBookCount(
            data,
            "taiji_hooking_art"
        ) >= (tonumber(progress.RequiredBookCount) or 1)
    end

    return false
end

function Systems.questProgressSummary(data, questId)
    local current = Systems.getCurrentQuest(data)

    if not current or current.Id ~= questId then
        return "Not active"
    end

    local p = current.Progress or {}

    if questId == "crimson_bead_rod" then
        return string.format(
            "Fish with Legacy Rod: %d/%d | Coins: %d/%d",
            tonumber(p.CurrentFished) or 0,
            tonumber(p.RequiredFished) or 100,
            tonumber(data.Coin) or 0,
            tonumber(p.RequiredCoin) or 3000000
        )
    end

    if questId == "bamboo_rod" then
        return string.format(
            "Bamboo Fragments: %d/%d | Coins: %d/%d",
            getItemCount(data, "bamboo_fragment"),
            tonumber(p.RequiredBamboo) or 20,
            tonumber(data.Coin) or 0,
            tonumber(p.RequiredCoin) or 3600000
        )
    end

    if questId == "zen_staff_rod" then
        return string.format(
            "Taiji V2 finishers: %d/%d | Coins: %d/%d",
            tonumber(p.CurrentFish) or 0,
            tonumber(p.RequiredFish) or 5,
            tonumber(data.Coin) or 0,
            tonumber(p.RequiredCoin) or 5000000
        )
    end

    if questId == "azure_dragon"
        or questId == "taiji_hooking_art_v2" then
        return string.format(
            "Skill finishers: %d/%d | Coins: %d/%d",
            tonumber(p.CurrentKills) or 0,
            tonumber(p.RequiredKills) or 100,
            tonumber(data.Coin) or 0,
            tonumber(p.RequiredCoin) or 0
        )
    end

    if questId == "supreme_king" then
        return string.format(
            "Rod Gate finishers: %d/%d",
            tonumber(p.CurrentUsedSkill) or 0,
            tonumber(p.CatchWithSkill) or 5
        )
    end

    return Systems.questReadyToComplete(data, questId)
        and "Requirements ready"
        or "Requirements still in progress"
end

function Systems.currentRodHasSkill(data, skillId)
    local rodId = data and data.RodEquip
    local rod = rodId and data.Rods and data.Rods[rodId]
    local slots = rod and rod.BookSlots

    if type(slots) ~= "table" then
        return nil
    end

    for index = 1, 4 do
        local slotName = "Slot" .. tostring(index)

        if slots[slotName] == skillId then
            return index
        end
    end

    return nil
end

function Systems.equipQuestSkill(skillId)
    local data = getPlayerData()
    if not data or not skillId then
        return false
    end

    local existingSlot = Systems.currentRodHasSkill(data, skillId)

    if existingSlot then
        State.QuestForcedSkillId = skillId
        State.QuestForcedSkillSlot = existingSlot
        return true
    end

    if Systems.availableSkillBookCount(data, skillId) <= 0 then
        State.QuestLastStatus =
            "Need skill book: " .. tostring(skillId)
        return false
    end

    if not EquipmentsController
        or not EquipmentsController.EquipMoveset then
        State.QuestLastStatus = "EquipMoveset unavailable"
        return false
    end

    local rodId = data.RodEquip
    local rod = rodId and data.Rods and data.Rods[rodId]
    local slots = rod and rod.BookSlots

    if type(slots) ~= "table" then
        State.QuestLastStatus = "Equipped rod has no skill slots"
        return false
    end

    if not State.QuestSkillOverrideActive then
        State.QuestPreviousSlot1 = slots.Slot1 or ""
    end

    local ok, result = pcall(function()
        return EquipmentsController.EquipMoveset:Fire(skillId, 1)
    end)

    if not ok or result ~= "Success" then
        State.QuestLastStatus =
            "Could not equip quest skill: " .. tostring(result)
        return false
    end

    State.QuestSkillOverrideActive = true
    State.QuestForcedSkillId = skillId
    State.QuestForcedSkillSlot = 1
    State.QuestLastStatus =
        "Quest skill equipped: " .. tostring(skillId)
    return true
end

function Systems.restoreQuestSkill()
    if not State.QuestSkillOverrideActive then
        State.QuestForcedSkillId = nil
        State.QuestForcedSkillSlot = nil
        return
    end

    if EquipmentsController
        and EquipmentsController.EquipMoveset then

        pcall(function()
            EquipmentsController.EquipMoveset:Fire(
                State.QuestPreviousSlot1 or "",
                1
            )
        end)
    end

    State.QuestPreviousSlot1 = nil
    State.QuestSkillOverrideActive = false
    State.QuestForcedSkillId = nil
    State.QuestForcedSkillSlot = nil
end

function Systems.clearQuestOverrides()
    State.QuestForcedRodId = nil
    State.QuestTargetIslandId = nil
    Systems.restoreQuestSkill()
end

function Systems.configureQuestFarming(questId)
    local profile = Systems.QuestProfiles[questId] or {}

    State.QuestTargetIslandId = profile.targetIsland
    State.QuestForcedRodId = profile.requiredRod

    if profile.requiredRod then
        local data = getPlayerData()

        if data
            and type(data.Rods) == "table"
            and data.Rods[profile.requiredRod] ~= nil
            and data.RodEquip ~= profile.requiredRod then

            Systems.equipRodById(profile.requiredRod)
        end
    end

    if profile.requiredSkill then
        Systems.equipQuestSkill(profile.requiredSkill)
    else
        Systems.restoreQuestSkill()
    end

    if profile.targetIsland
        and not Systems.isAtIsland(profile.targetIsland)
        and Systems.isTravelSafe() then

        if Config.AutoProgression then
            Systems.progressionNavigateToIsland(
                profile.targetIsland
            )
        else
            Systems.travelToIsland(
                profile.targetIsland
            )
        end
    end
end

function Systems.acceptQuest(questId)
    if not QuestController or not QuestController.Accept then
        State.QuestLastStatus = "QuestController unavailable"
        return false
    end

    local data = getPlayerData()
    if not data then
        return false
    end

    local current = Systems.getCurrentQuest(data)

    if current then
        State.QuestLastStatus =
            "Already on quest: "
            .. tostring(
                (QuestConfig.Data[current.Id] or {}).name
                or current.Id
            )
        return current.Id == questId
    end

    if not Systems.isQuestVisibleNow(data, questId) then
        State.QuestLastStatus = "Quest is locked or already completed"
        return false
    end

    State.QuestBusy = true

    local ok, accepted, reason = pcall(function()
        return QuestController:Accept(questId)
    end)

    State.QuestBusy = false

    if not ok or accepted ~= true then
        State.QuestLastStatus =
            "Accept failed: " .. tostring(reason or accepted)
        return false
    end

    State.QuestAccepts += 1
    State.QuestLastId = questId
    State.QuestLastStatus =
        "Accepted: "
        .. tostring((QuestConfig.Data[questId] or {}).name or questId)

    log("Quest:", State.QuestLastStatus)
    return true
end

function Systems.completeQuest(questId)
    if not QuestController or not QuestController.Complete then
        State.QuestLastStatus = "QuestController unavailable"
        return false
    end

    local data = getPlayerData()

    if not Systems.questReadyToComplete(data, questId) then
        State.QuestLastStatus =
            "Not ready: " .. Systems.questProgressSummary(data, questId)
        return false
    end

    State.QuestBusy = true

    local ok, completed, reason = pcall(function()
        return QuestController:Complete(questId)
    end)

    State.QuestBusy = false

    if not ok or completed ~= true then
        State.QuestLastStatus =
            "Complete failed: " .. tostring(reason or completed)
        return false
    end

    State.QuestCompletes += 1
    State.AutoQuestCompletedThisSession[questId] = true
    State.QuestLastId = questId
    State.QuestLastStatus =
        "Completed: "
        .. tostring((QuestConfig.Data[questId] or {}).name or questId)

    Systems.clearQuestOverrides()
    log("Quest:", State.QuestLastStatus)
    return true
end

function Systems.cancelCurrentQuest()
    if not QuestController or not QuestController.Cancel then
        State.QuestLastStatus = "QuestController unavailable"
        return false
    end

    local data = getPlayerData()
    local current = Systems.getCurrentQuest(data)

    if not current then
        State.QuestLastStatus = "No active quest"
        return false
    end

    local questId = current.Id
    State.QuestBusy = true

    local ok, cancelled, reason = pcall(function()
        return QuestController:Cancel(questId)
    end)

    State.QuestBusy = false

    if not ok or cancelled ~= true then
        State.QuestLastStatus =
            "Cancel failed: " .. tostring(reason or cancelled)
        return false
    end

    State.QuestLastStatus = "Cancelled: " .. tostring(questId)
    Systems.clearQuestOverrides()
    return true
end

Systems.AllQuestOrder = {
    "unlock_island_2",
    "unlock_island_3",
    "unlock_island_4",
    "unlock_island_5",
    "unlock_island_6",
    "crimson_bead_rod",
    "bamboo_rod",
    "heaven_piercer_turtle_rod",
    "zen_staff_rod",
    "dread_fish_rod",
    "white_tiger",
    "phoenix",
    "azure_dragon",
    "supreme_king",
    "taiji_hooking_art_v2",
}

function Systems.getNextAllQuestId(data)
    for _, questId in ipairs(Systems.AllQuestOrder) do
        local quest = QuestConfig.Data[questId]

        if quest
            and Systems.isQuestVisibleNow(data, questId)
            and not Systems.isQuestDone(data, questId) then

            if quest.repeatable == true
                and State.AutoQuestCompletedThisSession[questId] then
                continue
            end

            return questId
        end
    end

    return nil
end

function Systems.stepQuestAutomation()
    if not Config.AutoAllQuests
        or State.QuestBusy
        or State.AutoSellBusy
        or State.TravelBusy then
        return
    end

    local now = os.clock()

    if now - State.LastQuestCheck
        < math.max(
            0.50,
            tonumber(Config.QuestCheckInterval) or 1
        ) then
        return
    end

    State.LastQuestCheck = now

    local data = getPlayerData()

    if not data then
        return
    end

    local current = Systems.getCurrentQuest(data)
    local questId =
        current
        and current.Id
        or Systems.getNextAllQuestId(data)

    if not questId then
        State.QuestLastStatus = "All available quests complete"
        Systems.clearQuestOverrides()
        return
    end

    if not current then
        Systems.clearQuestOverrides()

        if not Systems.acceptQuest(questId) then
            return
        end

        task.wait(0.15)
        data = getPlayerData() or data
        current = Systems.getCurrentQuest(data)
    end

    if not current then
        return
    end

    questId = current.Id
    State.QuestLastId = questId

    Systems.configureQuestFarming(questId)

    data = getPlayerData() or data

    if Systems.questReadyToComplete(data, questId) then
        Systems.completeQuest(questId)
    else
        State.QuestLastStatus =
            Systems.questProgressSummary(data, questId)
    end
end

