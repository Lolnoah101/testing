local function getNumber(key, fallback)
    local n = tonumber(ClientData.Get(key))
    if n == nil then return fallback or 0 end
    return n
end

local function compactNumber(n)
    n = tonumber(n) or 0
    local absN = math.abs(n)
    local suffixes = {
        {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"},
    }
    for _, entry in ipairs(suffixes) do
        if absN >= entry[1] then
            return string.format("%.2f%s", n / entry[1], entry[2])
        end
    end
    return tostring(math.floor(n))
end

local function notify(title, content)
    if not running then return end
    pcall(function()
        Window:Notify({title = title, content = content})
    end)
end

