    if target and root and (target.HumanoidRootPart.Position-root.Position).Magnitude < 34 then
        X.Status = "Stage 2: Clearing prisoner"
        fight(target)
        return
    end
    if X.MazeRoute and #X.MazeRoute > 0 then
        local i = math.clamp(X.MazeIndex, 1, #X.MazeRoute)
        local point = X.MazeRoute[i]
        X.Status = string.format("Stage 2: Maze %d/%d", i, #X.MazeRoute)
        if root and (point-root.Position).Magnitude <= 8 and i < #X.MazeRoute then
            i += 1;X.MazeIndex=i;point=X.MazeRoute[i]
        end
