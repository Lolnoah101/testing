    local function stationAvailable(machine)
        if not machine or not machine.Parent then return false end
        local id = tostring(machine:GetAttribute("MachineId") or "")
        if id == "" then return false end
        local occupant = tonumber(machine:GetAttribute("Occupant")) or 0
        if occupant > 0 and occupant ~= player.UserId then return false end
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other:GetAttribute("Training") == id then
                return false
            end
        end
        -- The game marks the 1.5x area with an Unlock string and exposes
        -- unlock status through the server-set BoostUnlocked player attribute.
        local requirement = machine:GetAttribute("Unlock")
        if type(requirement) == "string" and requirement ~= ""
            and player:GetAttribute("BoostUnlocked") ~= true then
            return false
        end
        return true
    end
    local function boostOf(machine)
        return math.clamp(tonumber(machine and machine:GetAttribute("Boost")) or 1, 1, 10)
    end
    local function machineByTrainingId(trainingId)
        local lobby = workspace:FindFirstChild("Lobby")
        local gym = lobby and lobby:FindFirstChild("Gym")
        local barbells = gym and gym:FindFirstChild("Barbells")
        if not barbells or type(trainingId) ~= "string" or trainingId == "" then return nil end
        for _, desc in ipairs(barbells:GetDescendants()) do
            if desc:IsA("Model") and tostring(desc:GetAttribute("MachineId") or "") == trainingId then
