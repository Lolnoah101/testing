local function observeTrack(record, track)
    if not Hub.Running or not (Hub.AutoParry or Hub.AutoBlock or Hub.AutoDodge
        or Hub.LearnAttacks) then return end
    if not track or Hub.Tracks[track] then return end
    local meta = attackTrack(track)
    -- Runtime animation clones sometimes have a new ID and an unfamiliar
    -- non-combat-looking name. Trust the NPC's declared move list if it matches
    -- exactly; otherwise never pretend that an idle animation is an attack.
    if not meta and track.Animation and record.NPCName then
        local animationName=tostring(track.Animation.Name):lower()
        for _, declared in ipairs(NpcSpecialMoves[record.NPCName] or {}) do
            if declared:lower()==animationName then
                meta=classifyMove(declared,true)
                break
            end
        end
    end
    if not meta then return end
    record.LastAttacking = os.clock()
    local entry = {Record = record, Started = os.clock(), Expires = os.clock() + 5,
        Handled = false, Signals = {}, Track = track, Meta = meta,
        Attempts = 0, NextImpactAt = nil, LastMarkerAt = 0}
    Hub.Tracks[track] = entry
    if Hub.LearnAttacks then
        entry.Learned=Hub:AttackProfile(record,track,true)
        if entry.Learned then
            local profile=entry.Learned
            profile.Seen=(profile.Seen or 0)+1
            local now=os.clock()
            local gap=now-(record.LastLearnedAttackAt or 0)
            if record.LastLearnedAttackAt and gap>=0.1 and gap<7 then
                profile.TypicalInterval=profile.TypicalInterval
                    and (profile.TypicalInterval*0.78+gap*0.22) or gap
                profile.IntervalSamples=(profile.IntervalSamples or 0)+1
                if record.LastLearnedAttackKey then
                    profile.PreviousMoves=profile.PreviousMoves or {}
                    local previous=record.LastLearnedAttackKey
                    profile.PreviousMoves[previous]=(profile.PreviousMoves[previous] or 0)+1
                end
            end
            record.LastLearnedAttackAt=now
            record.LastLearnedAttackKey=profile.Key
            profile.LastSeen=now
            Hub.AttackLearningLast=profile.Npc.." / "..profile.Animation
        end
    else
        entry.Learned=Hub:AttackProfile(record,track,false)
    end
    local id = animId(track.Animation)
    if id and knownFractions[id] == nil then
        local ok, fraction = pcall(function() return FistsAnimations.GetMarkerFraction(track, "Hit") end)
        if ok and type(fraction) == "number" and fraction > 0 and fraction < 1 then
            knownFractions[id] = fraction
        end
    end
    -- Automatically calibrate later swings when Hit markers occur.
    if id then
        for _, marker in ipairs({"Hit", "Damage", "Impact"}) do
            local ok, signal = pcall(function() return track:GetMarkerReachedSignal(marker) end)
            if ok and signal then
                table.insert(entry.Signals, signal:Connect(function()
                    local length = track.Length
                    if length > 0 then
                        local frac = math.clamp(track.TimePosition / length, 0.05, 0.95)
                        knownFractions[id] = frac
                    end
                    -- A repeated Hit marker confirms a multi-impact animation.
                    -- Its next expected hit will be learned from real marker spacing.
                    local t = os.clock()
                    if t-(entry.LastLearnedMarkerAt or 0)>0.065 then
                        entry.LastLearnedMarkerAt=t
                        Hub:LearnAttackImpact(entry,"Marker")
                    end
                    if entry.LastMarkerAt > 0 then
                        local gap = t - entry.LastMarkerAt
                        if gap >= 0.10 and gap <= 1.1 then
                            entry.MarkerGap = gap
                            entry.Meta.Multi = true
                            if Hub.LearnAttacks and entry.Learned then
                                local profile=entry.Learned
                                profile.MarkerGap=profile.MarkerGap and
                                    (profile.MarkerGap*0.7+gap*0.3) or gap
                                profile.GapSamples=(profile.GapSamples or 0)+1
                                profile.Multi=true
                            end
                            entry.NextImpactAt = t + gap
                            entry.Handled = false
                        end
                    end
                    entry.LastMarkerAt = t
                end))
            end
        end
    end
    table.insert(entry.Signals, track.Stopped:Connect(function() cleanupTrack(track) end))
end
