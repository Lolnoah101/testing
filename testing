--//============================================================
--// TRIALS: select highest unlocked floor from live account progress.
--// Matches the game lobby's GetOpenRoom() + 1 calculation.
--//============================================================
GENV.__AZ_GET_TOP_TRIALS_FLOOR = function()
    local RS = game:GetService("ReplicatedStorage")
    local Global = RS:FindFirstChild("global")
    local Assets = RS:FindFirstChild("assets")
    local AccountModule = Global and Global:FindFirstChild("stores")
        and Global.stores:FindFirstChild("accountNamespace")
    local SeasonModule = Assets and Assets:FindFirstChild("config")
        and Assets.config:FindFirstChild("LeaderboardSeasonConfig")
    if not AccountModule or not SeasonModule then
        return nil, "Account or season module not replicated yet"
    end

    local ok, floorOrError = pcall(function()
        local AccountNamespace = require(AccountModule)
        local SeasonConfig = require(SeasonModule)
        local Account = AccountNamespace.getLocalPlayerAccount()
        local season = SeasonConfig.Season
        if not Account or not season or season.Id == nil then
            return nil
        end
        local Progress = Account.state.achievements.progress
        local Prefix = "trials.s" .. tostring(season.Id) .. "."
        local function ReadProgress(Suffix)
            local Key = Progress:get(Prefix .. Suffix)
            if not Key then return 0 end
            return math.max(tonumber(Key:get()) or 0, 0)
        end
        local best = ReadProgress("room")
        local unlocked = ReadProgress("unlocked")
        return math.clamp(math.floor(math.max(best, unlocked) + 1), 1, 65535)
    end)
    if not ok then return nil, tostring(floorOrError) end
    if type(floorOrError) ~= "number" then
        return nil, "Waiting for the player account"
    end
    return floorOrError, nil
end

