    if Settings.FarmMethod == "Legit" then
        local Arrived = GENV.__AZ_LEGIT_NAV.Go(Goal, 7.0, "Loot " .. tostring(Token))
        Ext.LootStatus = Arrived and "At loot pickup range" or "Walking to loot"
        return Arrived
    end
    if (Root.Position - Goal.Position).Magnitude <= 10 then
        return true
    end
    if Ext.LootLastTeleportToken == Token then
        return false
    end

    Ext.LootLastTeleportToken = Token
    Root.CFrame = CFrame.new(Goal.Position) * Root.CFrame.Rotation
    Root.AssemblyLinearVelocity = Vector3.zero
    Root.AssemblyAngularVelocity = Vector3.zero
