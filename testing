                    item.count = item.count + 1
                    local isEquipped = false
                    for _, eqUid in pairs(equipped) do
                        if eqUid == uid then isEquipped = true; break end
                    end
                    if not isEquipped and not (type(locks.Armor) == "table" and locks.Armor[uid] == true) then
