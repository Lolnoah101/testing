            end
            if E.ProgressWatcher then
                local content=string.format("%s | %s\n%s",E.AutoProgression and "AUTO" or "MANUAL",E.ProgressFocus,E.ProgressStatus)
                pcall(function() E.ProgressWatcher:Set(content) end)
            end
            if E.NenWatcher then pcall(function()
                local talk=E.NenMasterVisits and (" | Master encounters: "..E.NenMasterVisits.."/7") or ""
                E.NenWatcher:Set(E.NenStatus..talk.."\n"..self:V71NodeSummary().."\n"..E.AbilityStatus)
            end) end
            if E.CraftWatcher then pcall(function() E.CraftWatcher:Set(E.CraftStatus) end) end
            if E.FishSpotDropdown then pcall(function() self:V50FishWaters() end) end
            if E.MineWatcher then
                local label=E.AutoMine and (E.MineStatus or "Waiting") or "Off"
                pcall(function() E.MineWatcher:Set(label) end)
            end
            if E.FishWatcher then
                local label=E.AutoFish and (E.FishStatus or "Waiting") or "Off"
                local result=string.format("%s\nFish caught: %d | Chests caught: %d",
                    label,tonumber(E.FishCaught) or 0,tonumber(E.FishChestCaught) or 0)
                pcall(function() E.FishWatcher:Set(result) end)
            end
            if E.XPStat then pcall(function() E.XPStat:Set(math.floor(E.XPPerMinute or 0)) end) end
            if E.LevelStat then pcall(function() E.LevelStat:Set(tonumber(LocalPlayer:GetAttribute("Level")) or 0) end) end
            if E.RouteProgress then
                local required=tonumber(LocalPlayer:GetAttribute("RequiredExp")) or tonumber(LocalPlayer:GetAttribute("ExpToLevel"))
                local experience=tonumber(LocalPlayer:GetAttribute("Experience")) or tonumber(LocalPlayer:GetAttribute("XP"))
                if required and experience and required>0 then pcall(function() E.RouteProgress:Set(math.floor(math.clamp(experience/required*100,0,100))) end) end
            end
            if E.SessionKills then pcall(function() E.SessionKills:Set(self.Stats.TargetAcquisitions or 0) end) end
            if E.SessionRewards then pcall(function() E.SessionRewards:Set(self.ChestOpened or 0) end) end
            if E.SessionProgress then
                local done=0
                for _,key in ipairs({"AutoProgression","AutoNenUnlock","AutoNenSkills","AutoCraft","AutoMissions","AutoMine"}) do if E[key] then done+=1 end end
                pcall(function() E.SessionProgress:Set(done) end)
            end
            task.wait(0.48)
        end
    end)
end

