local lastWatcherText = {}
local disabledWatcher = {}
local function setWatcherText(handle, value, label)
    if not handle or disabledWatcher[handle] then return end
    if lastWatcherText[handle] == value then return end
    local ok, err = pcall(function()
        handle:Set(value)
