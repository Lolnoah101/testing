local function tryClaimTowerPass(data)
    if not state.AutoClaimTowerPass then return false end
    if type(data.Stats) ~= "table" or type(data.TowerPass) ~= "table" then return false end
    local claimed = data.TowerPass.Claimed
    local highest = tonumber(data.Stats["Tower Wave"])
    if type(claimed) ~= "table" or not highest then return false end
    local limit = math.min(50, math.max(0, math.floor(highest)))
    for level = 1, limit do
        if not claimed["Reward" .. level] then
            local now = os.clock()
            if now - (state.TowerPassClaimAttempt[level] or -math.huge) >= 15 then
                state.TowerPassClaimAttempt[level] = now
                bridge:FireServer("General", "TowerPass", "Claim", level)
                return true
            end
        end
    end
    return false
end

