local function installAutoExec()
    if not autoExecuteEnabled then return false, "Disabled" end
    local writer, reader = executorFileAPIs()
    local queue = executorQueueAPI()
    if not writer or not reader or not queue then
        return false, "Queue/readfile/writefile not all available in this session"
    end
    local source = AUTO_EXEC_BUNDLED_SOURCE
    if type(source) ~= "string" or #source < 50000 then
        local ok, cached = pcall(reader, AUTOEXEC_MAIN_FILE)
        if ok and type(cached) == "string" and #cached > 50000 then source = cached end
    end
    if type(source) ~= "string" or #source < 50000 then
        return false, "V45 source not cached; execute complete V45 file once"
    end
    local okWrite, writeError = pcall(writer, AUTOEXEC_MAIN_FILE, source)
    if not okWrite then return false, "Source write error: " .. tostring(writeError) end
    local okLoader, loaderError = pcall(writer, AUTOEXEC_QUEUE_FILE, AUTOEXEC_TELEPORT_LOADER)
    if not okLoader then return false, "Loader write error: " .. tostring(loaderError) end
    local session = tostring(game.PlaceId) .. ":" .. tostring(game.JobId)
    if autoExecInstalledSession ~= session
        and Env.TameAnimalPersistentQueuedSession ~= session then
        local queued, err = pcall(queue, AUTOEXEC_TELEPORT_LOADER)
        if not queued then return false, "Queue error: " .. tostring(err) end
        Env.TameAnimalPersistentQueuedSession = session
    end
    autoExecInstalledSession = session
    disableLegacyAutoExec()
    writeMarker(true) -- Keep ON between lobby and dungeon; never auto-disable on errors.
    return true, "ON | main and dungeon transitions queued"
end

