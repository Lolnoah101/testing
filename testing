    --//========================================================
    --// CRAFTING HELPERS
    --//========================================================

    local function CheckCraftMaterials(
        Recipe
    )

        local Missing = {}


        for MaterialId,
            Required in pairs(
                Recipe.Materials
            )
        do

            local Have =
                GetExtraMaterialCount(
                    MaterialId
                )


            if Have < Required then

                table.insert(
                    Missing,
                    {
                        Id = MaterialId,
                        Have = Have,
                        Need = Required,
                        Missing = Required - Have,
                    }
                )
            end
        end


        return #Missing == 0,
            Missing
    end


    local function MissingMaterialsText(
        Missing
    )

        local Lines = {}


        for _, Info in ipairs(
            Missing
        ) do

            table.insert(
                Lines,
                (
                    MaterialNames[
                        Info.Id
                    ]
                    or tostring(
                        Info.Id
                    )
                )
                    .. ": Have "
                    .. tostring(
                        Info.Have
                    )
                    .. " / Need "
                    .. tostring(
                        Info.Need
                    )
                    .. " / Missing "
                    .. tostring(
                        Info.Missing
                    )
            )
        end


        return table.concat(
            Lines,
            "\n"
        )
    end


    local function CraftSnapshot(
        Recipe
    )

        local Data = {

            Accessory =
                GetExtraAccessoryCount(
                    Recipe.AccessoryId
                ),

            Materials = {},
        }


        for MaterialId in pairs(
            Recipe.Materials
        ) do

            Data.Materials[
                MaterialId
            ] =
                GetExtraMaterialCount(
                    MaterialId
                )
        end


        return Data
    end


    local function CraftChanged(
        Before,
        After
    )

        if After.Accessory
            > Before.Accessory
        then

            return true
        end


        for MaterialId,
            OldAmount in pairs(
                Before.Materials
            )
        do

            if (
                After.Materials[
                    MaterialId
                ] or 0
            ) < OldAmount
            then

                return true
            end
        end


        return false
    end


