local LobbyReady = false


if LobbyFolder then
    local Enums = LobbyFolder:FindFirstChild("enums")
    local Stores = LobbyFolder:FindFirstChild("stores")

    local function SafeRequire(Parent, ModuleName, Timeout)
        local Module = Parent and (
            Parent:FindFirstChild(ModuleName)
            or (Timeout and Parent:WaitForChild(ModuleName, Timeout))
        )
        if not Module then
            return nil, "Missing " .. tostring(ModuleName)
        end
        local OK, Result = pcall(require, Module)
        if OK then
            return Result
        end
        return nil, tostring(Result)
    end

    local PacketError, StatusError, RoomError
    LobbyPackets, PacketError = SafeRequire(LobbyFolder, "packets", 12)
    QueueStatusEnum, StatusError = SafeRequire(Enums, "ququeStatusEnum", 4)
    QueueRoomStore, RoomError = SafeRequire(Stores, "ququeRoomStore", 4)
    GamemodeSelectEnum = select(1, SafeRequire(Enums, "gamemodeSelectEnum"))

    -- The native CreateQuque request only depends on packets. The room
    -- status store is an optimization for selecting an idle physical room;
    -- it must not disable the ENTIRE queue worker if replication is late.
    LobbyReady = LobbyPackets ~= nil
        and LobbyPackets.createQuque ~= nil
        and LobbyPackets.toggleQuqueWindow ~= nil

    if not LobbyReady then
        warn("[Anime Zero][Lobby] Queue packets unavailable:", tostring(PacketError))
    end
    if not QueueStatusEnum then
        warn("[Anime Zero][Lobby] Room status enum not loaded:", tostring(StatusError))
    end
    if not QueueRoomStore then
        warn("[Anime Zero][Lobby] Room store unavailable; using physical rooms:", tostring(RoomError))
    end
    if not GamemodeSelectEnum then
        warn("[Anime Zero][Lobby] Map catalog unavailable; using known map fallbacks")
    end
end

