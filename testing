        if a[flag] ~= b[flag] then
            if type(a[flag]) ~= "table" or type(b[flag]) ~= "table" then return false end
            for k,v in pairs(a[flag]) do if b[flag][k] ~= v then return false end end
            for k,v in pairs(b[flag]) do if a[flag][k] ~= v then return false end end
