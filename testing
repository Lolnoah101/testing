function Hub:NearbyNPCs(maxDistance)
    local _, root = myCharacter()
    local distance = tonumber(maxDistance) or 100
    local result = {}
    for _, record in pairs(self.Observed) do
        if activeNpcRecord(record) and root
            and (record.Root.Position - root.Position).Magnitude <= distance then
            table.insert(result, {
                Model = record.Model.Name,
                Display = record.Hum.DisplayName,
                Canonical = record.NPCName or "Unknown",
                Distance = math.floor((record.Root.Position - root.Position).Magnitude * 10) / 10,
                MatchesSelection = allowedSelection(record),
            })
        end
    end
    table.sort(result, function(a, b) return a.Distance < b.Distance end)
    return result
end

function Hub:TargetDebug(maxDistance)
    local _, root = myCharacter()
    local cap = tonumber(maxDistance) or 120
    local result = {}
    if not root then return result end
    for _, record in pairs(self.Observed) do
        if record.Model and record.Root and record.Root.Parent
            and (record.Root.Position-root.Position).Magnitude <= cap then
            local selected = self.QuestCombatActive and self.QuestSelectedData
                and self.QuestSelectedData.target or nil
            table.insert(result, {
                Model=record.Model:GetFullName(),
                Names=table.concat(identityNames(record.Model, record.Hum), " | "),
                Canonical=record.NPCName or "Unknown",
                HP=record.Hum and record.Hum.Health or -1,
                Anchored=record.Root.Anchored,
                Live=spawnIsLive(record),
                FarmSelection=allowedSelection(record),
                QuestSelection=selected and selectionMatches(record, selected) or false,
                Distance=math.floor((record.Root.Position-root.Position).Magnitude),
            })
        end
    end
    table.sort(result, function(a,b) return a.Distance < b.Distance end)
    return result
end

