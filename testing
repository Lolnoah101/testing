-- Include future controls too, through Window.Flags when the handle supports it.
local function captureFlagValues()
    local state, known = {}, {}
    local function include(flag, value)
        if type(flag) ~= "string" or flag == "AutoExecuteV44" then return end
        if value == nil then return end
        if type(value) == "boolean" or type(value) == "number"
            or type(value) == "string" or type(value) == "table" then
            state[flag] = value
            known[flag] = true
        end
    end
    for _, flag in ipairs(persistentFlags) do
        local ok, value = pcall(function() return Window:Get(flag) end)
        if ok then include(flag, value) end
    end
    pcall(function()
        for flag, value in pairs(Window.Flags) do
            if not known[flag] then include(flag, value) end
        end
    end)
    state.AutoExecuteV44 = nil -- Auto Execute is controlled by its own marker.
    return state
end

local function encodeFlagValues(flags)
    local ok, result = pcall(function()
        return HttpService:JSONEncode(flags)
    end)
    return ok and result or nil
end

local function saveAllPreferences(force)
    if not running or not preferenceInitialized then return false end
    local flags = captureFlagValues()
    local text = encodeFlagValues(flags)
    if not text then
        uiSaveStatus = "Unable to encode configuration"
        return false
    end
    if not force and text == lastPreferenceText then return true end
    local nativeOk, nativeErr = pcall(function() Window:Save() end)
    if not preferenceWriter then
        uiSaveStatus = nativeOk and "Rayfield saved; backup unavailable (no writefile)"
            or "Saving unavailable: " .. tostring(nativeErr)
        return nativeOk
    end
    local written, fileErr = pcall(preferenceWriter, UI_PREFS_PATH,
        HttpService:JSONEncode({Version = 47, Flags = flags}))
    if written then
        lastPreferenceText = text
        uiSaveStatus = "Saved controls + backup"
    else
        uiSaveStatus = "Backup unavailable: " .. tostring(fileErr)
    end
    return written or nativeOk
end

-- Rayfield is the source of truth. An old JSON backup must never
-- override values that Rayfield restored from the .rfld configuration.
-- Only migrate the old backup if we can PROVE there is no native profile.
local function nativeProfilePresent()
    local checker = (type(isfile) == "function" and isfile)
        or (type(Env.isfile) == "function" and Env.isfile)
    if not checker then return nil end -- unknown: prefer Rayfield state
    local ok, exists = pcall(checker,
        "Rayfield/Configurations/TameAnAnimal/TameAnimalV16.rfld")
    if not ok then return nil end
    return exists == true
end

local function restoreAllPreferences()
    local nativeExists = nativeProfilePresent()
    local migrated = 0
    if nativeExists == false and type(preferenceSnapshot) == "table" then
        for flag, value in pairs(preferenceSnapshot) do
            if flag ~= "AutoExecuteV44" and flag ~= "AutoExecuteV40"
                and flag ~= "SpiritRemoteRangeV30" then
                local ok, current = pcall(function() return Window:Get(flag) end)
                if ok and current ~= nil then
                    local changed = pcall(function() Window:Set(flag, value) end)
                    if changed then migrated += 1 end
                end
            end
        end
    end
    preferenceInitialized = true
    if migrated > 0 then
        uiSaveStatus = "Migrated " .. tostring(migrated) .. " old flags"
    else
        uiSaveStatus = nativeExists == false
            and "No native config; saving controls" or "Native Rayfield settings restored"
    end
    saveAllPreferences(true)
end


