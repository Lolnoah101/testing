function Systems.updateRayfieldDashboard()
    local dashboard =
        Systems.Dashboard

    if not dashboard then
        return
    end

    local owner =
        tostring(
            State.CoordinatorOwner
            or "Idle"
        )

    local stepText =
        Systems.getAutomationStepText
        and Systems.getAutomationStepText()
        or tostring(
            State.CoordinatorStatus
            or "Idle"
        )

    if dashboard.Status
        and type(
            dashboard.Status.Set
        ) == "function" then

        dashboard.Status:Set(
            "Owner: "
            .. owner
            .. "\nStep: "
            .. tostring(stepText)
            .. "\nEngine: OP • Fishing: "
            .. (
                Config.Enabled
                and "ON"
                or (
                    State.FullAutoManualDisabled
                    and "OFF (manual)"
                    or "OFF"
                )
            )
        )
    end

    local statValues = {
        Caught =
            tonumber(State.Caught) or 0,
        Huge =
            tonumber(State.HugeCaught) or 0,
        Skills =
            tonumber(State.SkillsSent) or 0,
        Boss =
            tonumber(State.BossCatches) or 0,
    }

    for key, value in pairs(
        statValues
    ) do
        local handle =
            dashboard[key]

        if handle
            and type(handle.Set)
                == "function" then

            pcall(
                handle.Set,
                handle,
                value
            )
        end
    end

    local data =
        getPlayerData()

    if dashboard.Inventory
        and data then

        local count, capacity =
            getFishCountAndCapacity(
                data
            )

        capacity =
            math.max(
                1,
                tonumber(capacity) or 1
            )

        count =
            math.clamp(
                tonumber(count) or 0,
                0,
                capacity
            )

        pcall(function()
            dashboard.Inventory:SetRange(
                0,
                capacity
            )

            dashboard.Inventory:Set(
                count
            )

            dashboard.Inventory:SetText(
                tostring(count)
                .. "/"
                .. tostring(capacity)
            )
        end)
    end

    if dashboard.Islands
        and data then

        local unlocked = 0

        for _, island in ipairs(
            Systems.IslandDefinitions
        ) do
            if Systems.isIslandAvailable(
                data,
                island.id
            ) then

                unlocked += 1
            end
        end

        local total =
            #Systems.IslandDefinitions

        pcall(function()
            dashboard.Islands:SetRange(
                0,
                math.max(1, total)
            )

            dashboard.Islands:Set(
                unlocked
            )

            dashboard.Islands:SetText(
                tostring(unlocked)
                .. "/"
                .. tostring(total)
            )
        end)
    end

    if dashboard.Priority then
        local stageMap = {
            Idle = 0,
            Fishing = 1,
            Progression = 2,
            Quest = 3,
            AutoSell = 4,
            Boss = 5,
        }

        local stage =
            stageMap[
                State.CoordinatorOwner
            ] or 0

        pcall(function()
            dashboard.Priority:Set(
                stage
            )

            dashboard.Priority:SetText(
                owner
            )
        end)
    end

    if dashboard.Gacha
        and type(
            dashboard.Gacha.Set
        ) == "function"
        and Systems.getGachaTrackerText then

        local ok, lines =
            pcall(
                Systems.getGachaTrackerText
            )

        if ok
            and type(lines) == "table" then

            dashboard.Gacha:Set(
                table.concat(
                    lines,
                    "\n"
                )
            )
        end
    end

    if dashboard.Persistence
        and type(
            dashboard.Persistence.Set
        ) == "function" then

        dashboard.Persistence:Set(
            "Rayfield config: Auto Save ON"
            .. "\nLocal settings: "
            .. tostring(
                State.AutoSaveStatus
                or "Idle"
            )
            .. "\nMovement: Closest merchant spawner • 35 studs/s"
            .. "\nBoss fallback: Free boat when no land is in cast range"
            .. "\nAnti AFK: "
            .. tostring(
                State.AntiAFKStatus
                or "Off"
            )
            .. "\nRod transaction: "
            .. tostring(
                State.RodTransactionStatus
                or "Idle"
            )
            .. "\nAFK stability: "
            .. tostring(
                State.AFKStatus
                or "Idle"
            )
            .. "\nRayfield: "
            .. tostring(
                State.RayfieldSource ~= ""
                and State.RayfieldSource
                or "fallback"
            )
        )
    end
end

