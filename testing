local function avatarDefinitions()
    local defs = readShared("Avatars") or {}
    -- Avatar aggregate definitions are populated asynchronously in the
    -- captured client, so load direct per-world modules if they aren't ready.
    if next(defs) then return defs end
    local avatarRoot = shared and shared:FindFirstChild("Avatars")
    if not avatarRoot then return defs end
    for _, entry in ipairs(AVATAR_NAMES) do
        local worldModule = avatarRoot:FindFirstChild(entry.world)
        for _, suffix in ipairs({ "", " Shiny" }) do
            local key = entry.name .. suffix
            local config = worldModule and worldModule:FindFirstChild(key)
            if config and config:IsA("ModuleScript") then
                local ok, result = pcall(require, config)
                if ok and type(result) == "table" then defs[key] = result end
            end
        end
    end
    return defs
end

local function describeAvatarBuff(definition)
    if type(definition) ~= "table" then return "Not available" end
    local stats = definition.Buffs or definition.Buff or definition.Bonus or definition.Stats
    if type(stats) == "string" or type(stats) == "number" then
        return tostring(stats)
    end
    if type(stats) == "table" then
        local segments = {}
        for k, v in pairs(stats) do
            if (type(v) == "number" or type(v) == "string") and #segments < 4 then
                segments[#segments+1] = tostring(k) .. ": " .. tostring(v)
            end
        end
        table.sort(segments)
        if #segments > 0 then return table.concat(segments, " | ") end
    end
    return "See in-game avatar buffs"
end

