-- One scheduler, throttled and cancellable. The Farm, Quest and Units toggles
-- are NEVER modified by matchmaking features.
task.spawn(function()
    while state.Running do
        state.UpdateModeRejoinGates()
        local inTrial = player:GetAttribute("Mode") == "Trial"
        local trialFolder = gameModes and gameModes:FindFirstChild("Trial")
        local currentWave = inTrial and tonumber(readModeValue(trialFolder, "Wave")) or 0
        if not inTrial then
            state.TrialGoalNotified = false
        elseif not state.TrialGoalNotified and currentWave >= (trialGoalByName[state.TrialDifficultyGoal] or 10) then
            state.TrialGoalNotified = true
            pcall(function()
                window:Notify({
                    title = "Trial milestone reached",
                    content = state.TrialDifficultyGoal .. " goal achieved at wave " .. tostring(currentWave),
                    duration = 5,
                })
            end)
        end
        if inTrial and state.AutoLeaveTrial and currentWave >= state.TrialLeaveWave
            and os.clock() - state.TrialLastLeave >= 12 then
            state.TrialLastLeave = os.clock()
            sendModeRequest("Gamemodes", "Trial", "Leave")
        end
        -- Wave-based leaving is independent of joining and mode auto-farming.
        local now = os.clock()
        if player:GetAttribute("Mode") == "Tower" and state.AutoLeaveTower
            and now - state.TowerLastLeave >= 12 then
            local wave = readActiveWave("Tower")
            if wave and wave >= state.TowerLeaveWave then
                state.TowerLastLeave = now
                sendModeRequest("Gamemodes", "Tower", "Leave")
            end
        end
        if player:GetAttribute("Mode") == "Raid" then
            local raidId = player:GetAttribute("RaidId")
            local wave = readActiveWave("Raid")
            if wave and raidId == "Solo City" and state.AutoLeaveSoloRaid
                and wave >= state.SoloLeaveWave
                and now - state.SoloLastLeave >= 12 then
                state.SoloLastLeave = now
                sendModeRequest("Gamemodes", "Raid", "Leave")
            elseif wave and raidId == "Ninja Village" and state.AutoLeaveNinjaRaid
                and wave >= state.NinjaLeaveWave
                and now - state.NinjaLastLeave >= 12 then
                state.NinjaLastLeave = now
                sendModeRequest("Gamemodes", "Raid", "Leave")
            end
        end
        if state.AutoJoinTimeTrial or state.AutoCreateJoinTower or state.AutoJoinRaid then
            local ok, err = pcall(function()
                local now = os.clock()
                if state.AutoJoinTimeTrial then
                    tryJoinTimeTrial(now)
                elseif state.AutoCreateJoinTower then
                    tryJoinOrCreateTower(now)
                elseif state.AutoJoinRaid then
                    tryJoinRaid(now)
                end
            end)
            if not ok then warn("[Paraiso Modes] Auto-join failed:", err) end
        end
        task.wait(1.0)
    end
end)

