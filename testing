function Hub:V71NodeSummary()
    local nodes,talked=self:V71ReadNenState()
    if not nodes then return "Aura nodes: waiting for replicated PlayerData (7 total)" end
    local unlocked,locked,damaged,unknown={},{},{},{}
    local unlockCount=0
    for i=1,7 do
        local entry=nodes[i] or nodes[tostring(i)]
        if type(entry)~="table" then
            table.insert(unknown,"#"..i)
        else
            if entry.unlocked==true then
                table.insert(unlocked,"#"..i);unlockCount+=1
            else table.insert(locked,"#"..i) end
            if entry.damaged==true then table.insert(damaged,"#"..i) end
        end
    end
    local function label(list) return #list==0 and "None" or table.concat(list,", ") end
    local result=string.format("Aura Nodes: %d/7 unlocked | Open: %s | Heal: %s",
        unlockCount,label(locked),label(damaged))
    result=result.."\nUnlocked: "..label(unlocked)
    if #unknown>0 then result=result.." | Not synced: "..label(unknown) end
    if type(talked)=="table" then
        local visited,count={},0
        for i=1,7 do
            if talked[i] == true or talked[tostring(i)] == true or
                (type(talked[i])=="table" and talked[i].talked==true) then
                table.insert(visited,"#"..i);count+=1
            end
        end
        if count>0 then result=result.."\nMasters spoken to: "..count.."/7 ("..label(visited)..")" end
    end
    return result
end
