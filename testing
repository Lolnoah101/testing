local function serializeCFrameMap(map)
    local out = {}

    for islandId, cf in pairs(map) do
        if typeof(cf) == "CFrame" then
            out[islandId] = {
                X = cf.Position.X,
                Y = cf.Position.Y,
                Z = cf.Position.Z,

                R00 = cf.XVector.X,
                R01 = cf.YVector.X,
                R02 = cf.ZVector.X,

                R10 = cf.XVector.Y,
                R11 = cf.YVector.Y,
                R12 = cf.ZVector.Y,

                R20 = cf.XVector.Z,
                R21 = cf.YVector.Z,
                R22 = cf.ZVector.Z,
