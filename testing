    if Hub.Running then registerTelegraph(inst) end
end))
local DODGE_PADDING = 4.0
local function telegraphOverlap(part, pos)
    if not part or not part.Parent then return false, nil end
    local proxy = part
    local shapeName
    -- Full-radius outline isn't parented when an art asset exists. Its
    -- sibling VFX clone (Circle/Square/Line) contains the finished dimensions.
    if part.Name == "BossTelegraphFill" then
        local bestDistance = 6
        for _, sibling in ipairs(part.Parent:GetChildren()) do
            if sibling:IsA("Model") and (sibling.Name == "Circle"
                or sibling.Name == "Square" or sibling.Name == "Line") then
                local candidate = sibling:FindFirstChild("Effects")
                if candidate and candidate:IsA("BasePart") then
                    local dist = (candidate.Position - part.Position).Magnitude
                    if dist < bestDistance then
                        proxy, shapeName, bestDistance = candidate, sibling.Name, dist
                    end
                end
            end
        end
    end
    -- The visual telegraphs are ground-aligned; moderate elevation can still
    -- be dangerous depending on the boss's 3D server hitbox.
    if math.abs(proxy.Position.Y - pos.Y) > 19 then return false, nil end
    local localPos = proxy.CFrame:PointToObjectSpace(pos)
    if proxy.Shape == Enum.PartType.Cylinder or shapeName == "Circle" then
        local radius = shapeName and math.max(proxy.Size.X, proxy.Size.Z) * 0.5
            or math.max(part.Size.Y, part.Size.Z) * 0.5
        local delta = Vector3.new(pos.X - proxy.Position.X, 0,
            pos.Z - proxy.Position.Z)
        local inside = delta.Magnitude < radius + 1.4
        return inside, {Type = "Circle", Radius = radius,
            Position = proxy.Position, Part = part}
    end
    local hx, hz = proxy.Size.X * 0.5, proxy.Size.Z * 0.5
    local inside = math.abs(localPos.X) < hx + 1.4
        and math.abs(localPos.Z) < hz + 1.4
    return inside, {Type = "Box", HalfX = hx, HalfZ = hz,
        CFrame = proxy.CFrame, Position = proxy.Position, Part = part}
end
-- v75: see the *approaching edge*, not merely the already-overlapping AoE.
-- The returned clearance is an estimate from client-visible telegraph geometry;
-- server damage volumes can differ. No network calls are made here.
function Hub:V75NearbyWarning(position, padding)
    if typeof(position) ~= "Vector3" then return false, nil, math.huge end
    local nearest, clearance, count = nil, math.huge, 0
    for part in pairs(self.Hazards) do
        if not part.Parent then
            self.Hazards[part] = nil
        else
            count += 1
            local _, info = telegraphOverlap(part,position)
            if info then
                local gap
                if info.Type == "Circle" then
                    local dx=position.X-info.Position.X
                    local dz=position.Z-info.Position.Z
                    gap=math.sqrt(dx*dx+dz*dz)-info.Radius
                else
                    local relative=info.CFrame:PointToObjectSpace(position)
                    gap=math.max(math.abs(relative.X)-info.HalfX,
                        math.abs(relative.Z)-info.HalfZ)
                end
                if gap < clearance then
                    clearance,nearest=gap,info
                end
            end
        end
    end
    self.LastHazardCount=count
    return nearest~=nil and clearance<=(padding or 0),nearest,clearance
end
local function telegraphCountAndDanger(root)
    local warned,info,clearance=Hub:V75NearbyWarning(root.Position,7.0)
    Hub.DodgeLastClearance=clearance
    return warned and info or nil
end
local function insideAnyTelegraph(position)
    for part in pairs(Hub.Hazards) do
        if part.Parent then
            local inDanger = telegraphOverlap(part, position)
            if inDanger then return true end
        end
    end
    return false
end
-- Defined after the visual hazard scanner, consumed by the earlier movement
-- functions at runtime. No new top-level local registers are needed.
function Hub:FarmDestinationUnsafe(position)
    return self.AutoDodge and typeof(position)=="Vector3"
        and self:V75NearbyWarning(position, 3.5)
end
-- A warning centered on the boss can make the nominal Above/Behind point
-- unsafe for several seconds. Instead of parking far away, seek a *nearby*
-- safe orbit around the intended farm position. The sample search never
-- assumes a red client warning is an authoritative server hitbox.
function Hub:FindSafeFarmOrbit(desired, current, record)
    if typeof(desired)~="Vector3" or typeof(current)~="Vector3"
        or not record or not record.Root or not record.Root.Parent then
        return nil
    end
    -- Preserve a safe side for a few frames; calculating a different orbit
    -- at 120 Hz would make the character zigzag along the warning edge.
    local cached=self.SafeOrbitCache
    local now=os.clock()
    if cached and cached.Record==record and now-cached.At<0.17
        and (cached.Desired-desired).Magnitude<4.0
        and (not cached.Position or not self:V75NearbyWarning(cached.Position,3.5)) then
        return cached.Position
    end
    local boss = record.Root.Position
    local wasSafe = not self:V75NearbyWarning(current,2.0)
    local best, cost = nil, math.huge
    for _, radius in ipairs({5,9,13,17,22,27}) do
        for index=0,15 do
            local angle = index * math.pi / 8
            local proposal=desired + Vector3.new(
                math.cos(angle)*radius,0,math.sin(angle)*radius)
            proposal=self:BoundBossDestination(record,current,proposal)
            if not self:V75NearbyWarning(proposal,3.5) then
                local separation=Vector3.new(
                    proposal.X-boss.X,0,proposal.Z-boss.Z).Magnitude
                -- While fighting, avoid a technically safe point that would
                -- abandon the boss and encourage a leash/HP reset.
                if separation <= 34 then
                    local crosses=false
                    if wasSafe then
                        for step=1,3 do
                            if insideAnyTelegraph(current:Lerp(proposal,step/4)) then
                                crosses=true
                                break
                            end
                        end
                    end
                    local score=(proposal-current).Magnitude*0.7
                        + (proposal-desired).Magnitude*0.35
                        + math.max(0,separation-20)*2.1
                        + (crosses and 50 or 0)
                    if score < cost then
                        best,cost=proposal,score
                    end
                end
            end
        end
    end
    self.SafeOrbitCache={Record=record,Desired=desired,Position=best,At=now}
    return best
end
-- Multiple hits are possible while a boss animation continues. When a
-- warning vanishes, the projectile or lingering hitbox may still exist.
local function trackIsActive(entry)
    local track = entry and entry.Track
    if not track then return false end
    local ok, playing = pcall(function() return track.IsPlaying end)
    return ok and playing == true
end
local function sustainedAnimation(entry)
    if not entry or not entry.Meta then return false end
    local move = tostring(entry.Meta.Move or ""):lower()
    return entry.Meta.Multi or entry.Meta.Rush
        or move:find("orbit",1,true)
        or move:find("beam",1,true) or move:find("tornado",1,true)
        or move:find("rain",1,true) or move:find("barrage",1,true)
        or move:find("onslaught",1,true) or move:find("burst",1,true)
end
local function directionalRisk(root, threat)
    if not threat or not threat.OtherRoot then return false end
    local enemyRoot = threat.OtherRoot
    local delta = enemyRoot.CFrame:PointToObjectSpace(root.Position)
    local move = tostring(threat.Meta.Move or ""):lower()
    -- Bolt Orbit is a repeated 32x8x32 hitbox around Beach King, NOT a
    -- projectile that can be escaped merely by walking behind the boss.
    if move:find("bolt orbit", 1, true) then
        return threat.Horizontal < 23
    end
    local line = threat.Meta.Ranged or move:find("shot",1,true)
        or move:find("pierce",1,true) or move:find("throw",1,true)
    if line then
        -- Aimed skill telegraphs provide better geometry when available;
        -- this fallback uses the boss's current aim and a conservative width.
        return delta.Z < 9 and delta.Z > -52 and math.abs(delta.X) < 12
    end
