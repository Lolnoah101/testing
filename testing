        value={"All"},flag="WavesEquipChoiceV76",callback=function(v) W.pick.Equip=selections(v) end})
    waves:CreateToggle({name="Auto Upgrade Equipment",value=false,flag="WavesAutoEquipV73",callback=function(v) W.flags.equip=v==true end})
