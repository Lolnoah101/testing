            if PendingSkillTree
                and os.clock() - PendingSkillTree.sentAt >= 7
            then
                PendingSkillTree = nil
                NextSkillTreeAt = os.clock() + 1.5
            end

            task.wait(0.20)
        end
    end)

    --//========================================================
    --// AUTO REDEEM ALL AVAILABLE CODES
    --//========================================================

    local RedeemingCodes = false

    local function BuildRedeemedCodeSet(Data)
        local Set = {}

        if Data and type(Data.cdk) == "table" then
            for _, Code in pairs(Data.cdk) do
                if type(Code) == "string" then
                    Set[string.upper(Code)] = true
                end
            end
        end

        return Set
    end

    RedeemAllAvailableCodes = function()
        if RedeemingCodes then
            Notify(
                "Codes",
                "Code redemption is already running.",
                4
            )
            return
        end

        if not Packets.redeemCode then
            Notify(
                "Codes",
                "Code redemption is unavailable.",
                5
            )
            return
        end

        local Data = GetAccountData()
        local Level = GetPlayerLevel(Data)

        if not Data or Level == nil then
            Notify(
                "Codes",
                "Account level is not ready yet.",
                5
            )
            return
        end

        RedeemingCodes = true

        local Redeemed = BuildRedeemedCodeSet(Data)
        local Available = {}
        local Locked = 0
        local AlreadyRedeemed = 0

        local SeenCodes = {}


        local function AddCode(Code, MinimumLevel)

            if type(Code) ~= "string"
                or Code == ""
            then
                return
            end


            local Upper =
                string.upper(Code)


            if SeenCodes[Upper] then
                return
            end


            SeenCodes[Upper] = true
            MinimumLevel = tonumber(MinimumLevel) or 0


            if Redeemed[Upper] then
                AlreadyRedeemed += 1
            elseif Level < MinimumLevel then
                Locked += 1
            else
                table.insert(
                    Available,
                    {
                        code = Code,
                        minimumLevel = MinimumLevel,
                    }
                )
            end
        end


        if type(CodesConfig) == "table" then

            for _, Definition in pairs(CodesConfig) do

                if type(Definition) == "table" then

                    AddCode(
                        Definition.Code,
                        Definition.MinimumLevel
                    )
                end
            end
        end


        -- These two are published in the current Update Log but are not
        -- present in codesConfig in this build. Keep them as an additional
        -- source and de-duplicate automatically if the config gains them.
        AddCode("SORRYFORDELAY", 25)
