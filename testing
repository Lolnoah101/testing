--//============================================================
--// FIND IDLE PHYSICAL ROOM
--//============================================================

local function FindIdleQueueRoom()

    local Rooms =
        GetQueueRoomsFolder()


    if not Rooms then
        return nil, nil
    end


    local Children =
        Rooms:GetChildren()


    table.sort(
        Children,

        function(A, B)

            return (
                tonumber(A.Name)
                or 999
            )
            <
            (
                tonumber(B.Name)
                or 999
            )
        end
    )


    local FallbackNumber = nil
    local FallbackRoom = nil
    local KnownStatuses = 0


    for _, Room
        in ipairs(
            Children
        )
    do

        local RoomNumber =
            tonumber(
                Room.Name
            )


        if RoomNumber then

            local JoinHitbox =
                Room
                    :FindFirstChild(
                        "JoinHitbox",
                        true
                    )


            if JoinHitbox then

                if not FallbackRoom then

                    FallbackNumber =
                        RoomNumber


                    FallbackRoom =
                        Room
                end


                local Status =
                    GetQueueRoomStatus(
                        RoomNumber
                    )


                if Status ~= nil then
                    KnownStatuses += 1
                end

                if QueueStatusEnum
                    and Status == QueueStatusEnum.room.idle
                then
                    return RoomNumber, Room
                end
            end
        end
    end


    -- If no room stores are replicated, let the server choose on entry.
    -- When all statuses are available and busy, don't repeatedly invade
    -- someone else's occupied queue room.
    if KnownStatuses > 0 then
        return nil, nil
    end

    return FallbackNumber, FallbackRoom
end


--//============================================================
--// IS QUEUED
--//============================================================

local function IsLobbyQueued()
    -- IMPORTANT: QueueRoom can become non-nil when the server identifies the
    -- physical room being entered. That is NOT the same thing as an actual
    -- match queue. Blocking on it prevented CreateQuque from ever firing.
    if LocalPlayer:GetAttribute("MatchSearching") == true then
        return true
    end

    return LobbyClientStatus == "inQuque"
        or LobbyClientStatus == "teleporting"
end

--//============================================================
--// MOVE INTO JOIN HITBOX
--//============================================================

local function MoveIntoQueueRoom(
    RoomNumber,
    Room
)

    local Root =
        GetRoot()


    if not Root
        or not Room
    then

        return false
    end


    local Hitbox =
        Room
            :FindFirstChild(
                "JoinHitbox",
                true
            )


    if not Hitbox
        or not Hitbox:IsA(
            "BasePart"
        )
    then

        return false
    end


    -- The place dump sets JoinHitbox.CanTouch=false, so a fresh
    -- enter/re-enter is safer than relying on Roblox .Touched events.
    local Rotation = Root.CFrame - Root.Position
    local AlreadyInside = (
        Hitbox.CFrame:PointToObjectSpace(Root.Position)
    )
    local Reenter = (
        PendingLobbyRoom == RoomNumber
        and math.abs(AlreadyInside.X) <= Hitbox.Size.X * 0.5
        and math.abs(AlreadyInside.Y) <= Hitbox.Size.Y * 0.5
        and math.abs(AlreadyInside.Z) <= Hitbox.Size.Z * 0.5
    )

    PendingLobbyRoom = RoomNumber
    LastLobbyRoomMove = os.clock()

    local function PlaceAt(Position)
        local LiveRoot = GetRoot()
        if LiveRoot and SessionAlive() then
            LiveRoot.AssemblyLinearVelocity = Vector3.zero
            LiveRoot.AssemblyAngularVelocity = Vector3.zero
            LiveRoot.CFrame = CFrame.new(Position) * Rotation
        end
    end

    if Reenter then
        -- Teleporting directly *inside* a zone can fail to produce the
        -- server-side enter transition. Move outside, let replication
        -- settle, then walk into the room like the normal game client.
        local Outside = Hitbox.Position +
            Hitbox.CFrame.LookVector * (Hitbox.Size.Z * 0.5 + 3)
        PlaceAt(Outside)
        task.delay(0.45, function()
            if SessionAlive()
                and PendingLobbyRoom == RoomNumber
                and not IsLobbyQueued()
            then
                local Human = GetHumanoid()
                if Human and Human.Health > 0 then
                    Human:MoveTo(Hitbox.Position)
                else
                    PlaceAt(Hitbox.Position)
                end
            end
        end)
    else
        PlaceAt(Hitbox.Position)
    end

    print(
        "[Anime Zero] Entering Queue Room:",
        RoomNumber,
        "| re-enter:",
        Reenter
    )

    return true
end


