-- The first request is sent immediately. Only unanswered requests or
-- explicit server rejections incur a wait. These cannot be bypassed locally.
local GAME_INTERACT_RANGE = tonumber(SummonConfig.InteractRange) or 22
-- Client-side selection limit only. It does not change the server's allowed range.
local RANGE = GAME_INTERACT_RANGE
local POSITION_CHECK = 0.05
local TAME_RESPONSE_TIMEOUT = 2.5
local RELEASE_CONFIRM_WAIT = 0.75
local RELEASE_MAX_TRIES = 3
-- Per-spirit adaptive pacing.  Start fast and slow down only when the
-- server rejects early attempts; never send a new tame request while pending.
local INITIAL_TAME_GAP = 0.22
local MIN_TAME_GAP = 0.16
local MAX_TAME_GAP = 2.0

local stats = {
    tameSent = 0,
    tameResults = 0,
    totalTameResponse = 0,
    timedResults = 0,
    cooldowns = 0,
    releaseSent = 0,
    releaseRemoved = 0,
    totalReleaseResponse = 0,
    untrackedTameResults = 0,
    tameTimeouts = 0,
    distantTameSent = 0,
    distantTameReplies = 0,
    distantReleaseSent = 0,
    distantReleaseRemovals = 0,
    rangeRejects = 0,
    reasons = {},
}

-- V46: tame-list is for wild spirits, separate from protected BACKPACK pets.
-- Empty list preserves the previous "tame anything" behavior.
local tameNamesText = ""
local tameNames = {}
local function normalSpecies(value)
    if value == nil then return "" end
    return string.lower(tostring(value):gsub("[^%w]", ""))
end
local function setTameNames(value)
    tameNamesText = tostring(value or "")
    table.clear(tameNames)
    for item in tameNamesText:gmatch("[^,\n]+") do
        local key = normalSpecies(item)
        if key ~= "" then tameNames[key] = true end
    end
end
local function speciesForSpirit(s)
    if not s then return nil end
    local species = s.species
    local model = s.model
    if (species == nil or species == "") and typeof(model) == "Instance" and model.Parent then
        species = model:GetAttribute("Species") or model:GetAttribute("AnimalId")
        if not species and Animals[model.Name] then species = model.Name end
    end
    if not species or species == "" then return nil end
    return tostring(species)
end
local function selectedForTame(s)
    local species = speciesForSpirit(s)
    if not species then return nil end -- unknown species: do not auto-release
    local def = Animals[species]
    local display = s.displayName or (def and def.DisplayName)
    return tameNames[normalSpecies(species)] == true
        or (display ~= nil and tameNames[normalSpecies(display)] == true)
end
local function hasTameNameFilter()
    return next(tameNames) ~= nil
end
-- Single decision function for both movement and remote dispatch.
local function spiritAction(s, full)
    if not s or recentlyRemoved[s.id] then return nil end
    local attempts = tonumber(s.attempts) or 0
    if hasTameNameFilter() then
        local listed = selectedForTame(s)
        if listed == nil then return nil end
        if not listed then
            return (autoRelease and not s.noRelease) and "Release" or nil
        end
        if autoTame and attempts > 0 and not full and not s.blocked then
            return "Tame"
        end
        -- After three failed attempts, a listed species can still be
        -- released for gems; its successful captures stay untouched.
        if autoRelease and attempts <= 0 and not s.noRelease then
            return "Release"
        end
        return nil
    end
    -- Legacy behavior when no names were entered.
    if autoTame and attempts > 0 and not full and not s.blocked then
        return "Tame"
    end
    if autoRelease and not s.noRelease
        and (not autoTame or attempts <= 0 or full or s.blocked) then
        return "Release"
    end
    return nil
end

local function getSpirit(id)
    if id == nil then return nil end
    local s = spirits[id]
    if not s then
        s = {
            id = id,
            attempts = tonumber(SummonConfig.Attempts) or 3,
            nextAction = 0,
            tamePendingUntil = 0,
            releaseTries = 0,
            releasePendingUntil = 0,
            blocked = false,
            noRelease = false,
            lastTameDistance = 0,
            lastReleaseDistance = 0,
            tameGap = INITIAL_TAME_GAP,
            cooldownStreak = 0,
        }
        spirits[id] = s
    end
    return s
end

local function findPosition(s)
    local model = s.model
    if typeof(model) == "Instance" and model.Parent then
        if model:IsA("BasePart") then
            return model.Position
        elseif model:IsA("Model") then
            local part = model.PrimaryPart
                or model:FindFirstChild("HumanoidRootPart")
                or model:FindFirstChildWhichIsA("BasePart", true)
            if part and part:IsA("BasePart") then
                return part.Position
            end
        end
    end
    return typeof(s.position) == "Vector3" and s.position or nil
end

local function refreshVisibleSpirits()
    local folder = Workspace:FindFirstChild("Spirits")
    if not folder then return end
    for _, child in ipairs(folder:GetChildren()) do
        local id = child:GetAttribute("SpiritId")
        if id ~= nil and not recentlyRemoved[id] then
            local fresh = spirits[id] == nil
            local s = getSpirit(id)
            s.model = child
            s.species = s.species or child:GetAttribute("Species") or child:GetAttribute("AnimalId")
            if s.species == nil and Animals[child.Name] then s.species = child.Name end
            if fresh then
                s.attempts = tonumber(child:GetAttribute("AttemptsLeft"))
                    or tonumber(child:GetAttribute("Tries"))
                    or tonumber(SummonConfig.Attempts) or 3
            end
            s.expiresAt = tonumber(child:GetAttribute("ExpiresAt")) or s.expiresAt
        end
    end
end

local function storageIsFull()
    local animals = ClientData.Get("Animals")
    if type(animals) ~= "table" then return false end
    local count = 0
    for _ in pairs(animals) do count += 1 end

    local cap = tonumber(Player:GetAttribute("StorageCap"))
    if not cap then
        local rank = tonumber(ClientData.Get("TamerRank")) or 1
        local ok, result = pcall(Formulas.StorageCap, rank)
        cap = ok and tonumber(result) or nil
    end
    return cap ~= nil and count >= cap
end

-- V32: Complete the defeated mob's spirit before taking the next farm target.
-- A short spawn grace avoids leaving the corpse before SpiritAvailable arrives.
-- The game decides whether a tame/release request is accepted; proximity is
-- still checked against its NORMAL 22-stud distance while prioritizing.
local wake
local priority = {
    enabled = true,
    focusId = nil,
    deadline = 0,
    graceUntil = 0,
    forceClose = false,
    preferPayload = false,
    arrivedAt = nil,
    lastKillModel = nil,
    lastKillPosition = nil,
    status = "Idle",
    skipped = {}, -- timed-out/unavailable spirits are skipped until removed
}
-- The model can animate away from the original spawn point.  After a
-- TooFar response, prefer the spirit's server-provided payload position.
local function interactionPosition(s)
    if priority and priority.focusId == s.id and priority.preferPayload
        and typeof(s.position) == "Vector3" then
        return s.position
    end
    return findPosition(s)
end

local SPAWN_GRACE = 1.55
local MAX_SPIRIT_FOCUS = 13
local APPROACH_RANGE = 5.0
local APPROACH_TOLERANCE = 0.45
local FOCUS_DETECTION_RANGE = 250
local NORMAL_PRIORITY_RANGE = math.max(3, GAME_INTERACT_RANGE - 1.0)
local function canPrioritizeSpirit()
    return running and priority.enabled and (autoTame or autoRelease)
        and (Aux.autoMobFarm or Aux.dungeonFarmEnabled or Aux.autoCommandEnabled)
end
local function setPriorityStatus(status, active)
    priority.status = status
    Aux.spiritPriorityStatus = status
    Aux.spiritPriorityActive = active == true
end
local function stopPriority(reason)
    priority.forceClose = false
    priority.preferPayload = false
    priority.arrivedAt = nil
    priority.focusId = nil
    priority.graceUntil = 0
    priority.deadline = 0
    if farmMover.EndSpiritFocus then farmMover.EndSpiritFocus() end
    setPriorityStatus(reason or "Idle", false)
end
local function focusSpirit(id, position)
    if id == nil or not canPrioritizeSpirit() then return false end
    if priority.skipped[id] then return false end
    if not spiritAction(spirits[id], storageIsFull()) then return false end
    if priority.focusId and priority.focusId ~= id then return false end
    local root = getRoot()
    if not root or not position then return false end
    local distance = (root.Position - position).Magnitude
    -- Farm Distance may be 20 studs, so allow finding spirits before we
    -- reach interaction range. Actual tame/release requests wait until close.
    if distance > FOCUS_DETECTION_RANGE then return false end
    priority.focusId = id
    priority.forceClose = false
    priority.preferPayload = false
    priority.arrivedAt = nil
    priority.graceUntil = 0
    priority.deadline = os.clock() + MAX_SPIRIT_FOCUS
    setPriorityStatus(string.format("Approaching spirit: %.1f -> %.0f studs", distance, APPROACH_RANGE), true)
    print(string.format("[Tame V47] Following spirit %s | %s/%s | target distance %d studs | initial %.1f studs",
        tostring(id), farmMethod, farmPosition, APPROACH_RANGE, distance))
    if farmMover.ApproachSpirit then farmMover.ApproachSpirit(id, position) end
    return true
end
local function isDefeated(model)
    if typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
    if not model:IsDescendantOf(Workspace) then return true end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then return true end
    local hp = tonumber(model:GetAttribute("Health"))
    return hp ~= nil and hp <= 0
end
Aux.noteFarmKill = function(model, lastPos)
    if not canPrioritizeSpirit() or not isDefeated(model) then return false end
    if priority.lastKillModel == model then return Aux.spiritPriorityActive end
    priority.lastKillModel = model
    if priority.focusId then return true end -- spirit event arrived before death polling
    priority.lastKillPosition = typeof(lastPos) == "Vector3" and lastPos or nil
    priority.graceUntil = os.clock() + SPAWN_GRACE
    priority.focusId = nil
    setPriorityStatus("Enemy defeated; awaiting spirit spawn", true)
    return true
end
-- Pet kills and farm kills share the same SpiritAvailable event.  Scan all
-- live spirits (not just the last mob's corpse), complete them sequentially,
-- then resume the original farm target/distance.
Aux.updateSpiritPriority = function()
    if not canPrioritizeSpirit() then
        if Aux.spiritPriorityActive then stopPriority("Disabled") end
        return false
    end
    local now = os.clock()
    refreshVisibleSpirits()
    if priority.focusId then
        local id = priority.focusId
        local s = spirits[id]
        if recentlyRemoved[id] or not s then
            stopPriority("Spirit completed; checking next")
        elseif (s.expiresAt and Workspace:GetServerTimeNow() >= s.expiresAt)
            or now >= priority.deadline then
            priority.skipped[id] = true
            stopPriority("Spirit expired or timed out")
        elseif not spiritAction(s, storageIsFull()) then
            priority.skipped[id] = true
            stopPriority("Spirit no longer eligible")
        elseif s.releaseTries >= RELEASE_MAX_TRIES
            and now >= (s.releasePendingUntil or 0) then
            priority.skipped[id] = true
            stopPriority("Release unconfirmed; checking next")
        else
            local pos = interactionPosition(s)
            local root = getRoot()
            if pos and root then
                local distance = (root.Position - pos).Magnitude
                local desiredRange = priority.forceClose
                    and math.min(APPROACH_RANGE, 1.5) or APPROACH_RANGE
                local action = spiritAction(s, storageIsFull()) or "Waiting"
                setPriorityStatus(string.format("%s %s: %.1f -> %.1f studs",
                    action, tostring(speciesForSpirit(s) or "spirit"),
                    distance, desiredRange), true)
            end
        end
    end
    if not priority.focusId then
        local root = getRoot()
        if root then
            local bestId, bestPosition = nil, nil
            local bestExpiry, bestDistance = math.huge, math.huge
            local full = storageIsFull()
            for id, s in pairs(spirits) do
                if not priority.skipped[id] and not recentlyRemoved[id]
                    and (not s.expiresAt or Workspace:GetServerTimeNow() < s.expiresAt)
                    and spiritAction(s, full) ~= nil
                    and (s.releaseTries or 0) < RELEASE_MAX_TRIES then
                    local pos = findPosition(s)
                    if pos then
                        local distance = (root.Position - pos).Magnitude
                        if distance <= FOCUS_DETECTION_RANGE then
                            local expiry = tonumber(s.expiresAt) or math.huge
                            if not bestId or expiry < bestExpiry
                                or (expiry == bestExpiry and distance < bestDistance) then
                                bestId, bestPosition = id, pos
                                bestExpiry, bestDistance = expiry, distance
                            end
                        end
                    end
                end
            end
            if bestId then
                priority.graceUntil = 0
                focusSpirit(bestId, bestPosition)
            end
        end
    end
    if not priority.focusId then
        if priority.graceUntil > now then
            setPriorityStatus("Awaiting defeated mob's spirit", true)
        elseif priority.graceUntil > 0 then
            stopPriority("No spirit appeared; farming resumed")
        else
            setPriorityStatus("No eligible spirits", false)
        end
    end
    if Aux.spiritPriorityActive then
        if priority.focusId then
            local s = spirits[priority.focusId]
            local position = s and interactionPosition(s)
            if position and farmMover.ApproachSpirit then
                farmMover.ApproachSpirit(priority.focusId, position)
            end
        elseif farmMover.Hold then
            farmMover.Hold()
        end
    end
    return Aux.spiritPriorityActive
end

local queued = false
local processing = false
local needsPass = false

local function tryNearbySpirits()
    if not running or (not autoTame and not autoRelease) then return end
    local root = getRoot()
    if not root or not ClientData.IsReady() then return end

    local now = os.clock()
    local serverNow = Workspace:GetServerTimeNow()
    local storageFull = storageIsFull()
    refreshVisibleSpirits()
    -- Arm the next eligible spirit focus before dispatching any remote.
    -- This applies even when SpiritAvailable was missed and the spirit was
    -- discovered by scanning workspace.Spirits.
    if canPrioritizeSpirit() and not priority.focusId then
        Aux.updateSpiritPriority()
    end

    -- Do not contact distant spirits during the pause for this kill.
    if Aux.spiritPriorityActive and not priority.focusId then return end
    -- Process every eligible nearby spirit independently. This does not
    -- accelerate the server's response for a particular spirit.
    for id, s in pairs(spirits) do
        if not (Aux.spiritPriorityActive and priority.focusId and id ~= priority.focusId) then
        if s.expiresAt and serverNow >= s.expiresAt then
            spirits[id] = nil
        elseif now >= s.nextAction then
            local position = interactionPosition(s)
            local distance = position and (root.Position - position).Magnitude
            -- Wait briefly after the character arrives so unanchored root
            -- movement has a chance to replicate before server validation.
            local focused = priority.focusId == id and Aux.spiritPriorityActive
            local desiredRange = priority.forceClose
                and math.min(APPROACH_RANGE, 1.5) or APPROACH_RANGE
            if focused then
                if distance and distance <= desiredRange + APPROACH_TOLERANCE
                    and not root.Anchored then
                    priority.arrivedAt = priority.arrivedAt or now
                else
                    priority.arrivedAt = nil
                end
            end
            local settled = not focused or (
                priority.arrivedAt ~= nil and now - priority.arrivedAt >= 0.20)
            -- When completing the previous mob's spirit, don't fire before
            -- our temporary, slider-controlled approach has reached the spirit.
            local effectiveRange = focused
                and (desiredRange + APPROACH_TOLERANCE) or RANGE
            if settled and distance and distance <= effectiveRange then
                local action = spiritAction(s, storageFull)
                if action == "Tame" then
                    if now >= s.tamePendingUntil and not s.releaseSentAt then
                        if s.lastTameSent then
                            -- No SummonResult; don't hammer a distant spirit repeatedly.
                            stats.tameTimeouts += 1
                            s.lastTameSent = nil
                            if s.lastTameDistance > GAME_INTERACT_RANGE then
                                s.nextAction = now + 5
                            end
                        end
                        if now >= s.nextAction then
                            s.tamePendingUntil = now + TAME_RESPONSE_TIMEOUT
                            s.lastTameSent = now
                            s.lastTameDistance = distance
                            stats.tameSent += 1
                            if distance > GAME_INTERACT_RANGE then
                                stats.distantTameSent += 1
                                print(string.format("[Tame V34 Range] TAME request at %.1f studs (normal UI %.0f)", distance, GAME_INTERACT_RANGE))
                            end
                            if focused then
                                local modelPos = findPosition(s)
                                local payloadPos = typeof(s.position) == "Vector3"
                                    and s.position or nil
                                print(string.format(
                                    "[Tame V44] Request id=%s root->model=%.1f root->payload=%s anchored=%s",
                                    tostring(id), modelPos and (root.Position-modelPos).Magnitude or -1,
                                    payloadPos and string.format("%.1f", (root.Position-payloadPos).Magnitude) or "n/a",
                                    tostring(root.Anchored)))
                            end
                            TameRemote:FireServer(id)
                        end
                    end
                elseif action == "Release" then
                    if now >= s.releasePendingUntil and s.releaseTries < RELEASE_MAX_TRIES then
                        s.releaseTries += 1
                        s.releasePendingUntil = now + RELEASE_CONFIRM_WAIT
                        s.releaseSentAt = s.releaseSentAt or now
                        s.lastReleaseDistance = distance
                        stats.releaseSent += 1
                        if distance > GAME_INTERACT_RANGE then
                            stats.distantReleaseSent += 1
                            print(string.format("[Tame V34 Range] RELEASE request at %.1f studs (normal UI %.0f)", distance, GAME_INTERACT_RANGE))
                        end
                        ReleaseRemote:FireServer(id)
                    end
                end
            end
        end
        end -- focus filter
    end
end

wake = function()
    if not running then return end
    if processing then
        needsPass = true
        return
    end
    if queued then return end
    queued = true
    task.defer(function()
        queued = false
        if not running then return end
        processing = true
        local ok, err = pcall(tryNearbySpirits)
        processing = false
        if not ok then
            warn("[Tame V44] Worker error:", err)
        end
        if needsPass then
            needsPass = false
            wake()
        end
    end)
end

table.insert(listeners, SpiritAvailable.OnClientEvent:Connect(function(payload)
    if type(payload) ~= "table" or payload.SpiritId == nil then return end
    local id = payload.SpiritId
    recentlyRemoved[id] = nil
    local s = getSpirit(id)
    if payload.AttemptsLeft ~= nil then
        s.attempts = tonumber(payload.AttemptsLeft) or s.attempts
    end
    if typeof(payload.Model) == "Instance" then s.model = payload.Model end
    if typeof(payload.Position) == "Vector3" then s.position = payload.Position end
    s.species = payload.Species or s.species
    s.displayName = payload.DisplayName or s.displayName
    s.expiresAt = tonumber(payload.ExpiresAt) or s.expiresAt
    s.noRelease = payload.NoRelease == true or payload.FirstTame == true
    priority.skipped[id] = nil
    if spiritAction(s, storageIsFull()) then
        -- Works for any pet-defeated animal, not just the farm's current mob.
        focusSpirit(id, findPosition(s))
    end
    wake()
end))

table.insert(listeners, SummonResult.OnClientEvent:Connect(function(result)
    if type(result) ~= "table" or result.SpiritId == nil then return end
    stats.tameResults += 1
    local s = spirits[result.SpiritId]
    if not s then
        stats.untrackedTameResults += 1
        return
    end
    local now = os.clock()
    if s.lastTameSent then
        stats.totalTameResponse += now - s.lastTameSent
        stats.timedResults += 1
        s.lastTameSent = nil
    end
    s.tamePendingUntil = 0
    s.nextAction = 0
    if s.lastTameDistance > GAME_INTERACT_RANGE then
        stats.distantTameReplies += 1
        print(string.format(
            "[Tame V34 Range] TAME response at %.1f studs | Success=%s | Reason=%s | AttemptsLeft=%s",
            s.lastTameDistance, tostring(result.Success), tostring(result.Reason), tostring(result.AttemptsLeft)
        ))
    end

    if result.Success then
        spirits[result.SpiritId] = nil
        recentlyRemoved[result.SpiritId] = true
        wake()
        return
    end

    if result.AttemptsLeft ~= nil then
        s.attempts = tonumber(result.AttemptsLeft) or s.attempts
    elseif result.Reason == "Failed" or result.Reason == "Resisted" then
        s.attempts = math.max(0, s.attempts - 1)
    end

    local reason = result.Reason
    if reason then
        stats.reasons[reason] = (stats.reasons[reason] or 0) + 1
    end
    if reason == "Cooldown" or reason == "Busy" then
        stats.cooldowns += 1
        s.cooldownStreak = (s.cooldownStreak or 0) + 1
        s.tameGap = math.min(MAX_TAME_GAP,
            math.max(0.4, (s.tameGap or INITIAL_TAME_GAP) * 1.75 + 0.12))
        -- Use any explicit server-provided retry delay if available.
        local serverDelay = tonumber(result.RetryAfter)
            or tonumber(result.CooldownRemaining)
            or tonumber(result.WaitTime)
        -- Ignore implausible values (some games send absolute timestamps).
        if serverDelay and (serverDelay < 0 or serverDelay > 30) then
            serverDelay = nil
        end
        s.nextAction = now + math.max(s.tameGap, serverDelay or 0)
    elseif reason == "Failed" or reason == "Resisted" then
        -- An accepted attempt, not a rejection. Reduce pacing gradually.
        s.cooldownStreak = 0
        s.tameGap = math.max(MIN_TAME_GAP, (s.tameGap or INITIAL_TAME_GAP) * 0.9)
        s.nextAction = now + (s.attempts > 0 and s.tameGap or 0)
    elseif reason == "OutOfRange" or reason == "TooFar" or reason == "TooFarAway"
        or reason == "NotInRange" or reason == "Distance" then
        stats.rangeRejects += 1
        -- Do not waste a 10-second spirit lifetime on a five-second backoff.
        -- A server rejection is not proof that the visual position is valid.
        if priority.focusId == result.SpiritId then
            priority.forceClose = true
            priority.preferPayload = typeof(s.position) == "Vector3"
            priority.arrivedAt = nil
            local root = getRoot()
            local modelPos = findPosition(s)
            local payloadPos = typeof(s.position) == "Vector3" and s.position or nil
            print(string.format(
                "[Tame V44] SERVER %s: root->model=%.1f, root->payload=%s, anchored=%s; retrying closer",
                tostring(reason), root and modelPos and (root.Position - modelPos).Magnitude or -1,
                root and payloadPos and string.format("%.1f", (root.Position - payloadPos).Magnitude) or "n/a",
                root and tostring(root.Anchored) or "no root"))
        end
        s.nextAction = now + 0.65
    elseif reason == "NotEligible" then
        s.blocked = true
    elseif reason == "StorageFull" then
        s.nextAction = now + 1
    elseif reason == "Expired" or reason == "Invalid" then
        spirits[result.SpiritId] = nil
        recentlyRemoved[result.SpiritId] = true
    elseif reason and reason ~= "Failed" and reason ~= "Resisted" then
        s.nextAction = now + math.max(0.7, s.tameGap)
    end
    if s.attempts <= 0 and autoRelease and not s.noRelease then
        -- Allow releasing an exhausted spirit without extra tame backoff.
        s.nextAction = 0
    end
    wake()
end))

