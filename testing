--//============================================================

local function GetRequestedEntryArea()

    local Area =
        GetRunValue(
            "area"
        )


    local Wave =
        GetRunValue(
            "wave"
        )


    local StartedAt =
        GetRunValue(
            "startedAt"
        )


    if not Area
        or Area <= 1
        or Wave ~= 0
        or not StartedAt
    then

        return nil
    end


    return Area
