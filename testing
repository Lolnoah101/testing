        AutoRetry =
            ReadSavedBool("AutoRetry", Settings.AutoRetry),

        AutoLeave =
            ReadSavedBool("AutoLeave", Settings.AutoLeave),

        AutoNext =
            ReadSavedBool("AutoNext", Settings.AutoNext),


        LeaveAfterMatches =
            math.clamp(
