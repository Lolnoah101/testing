-- The game's activateSummon() client action only performs UI checks,
-- rate limiting, increments a sequence, then sends this exact remote.
local function directSummon()
    if enabled._swordSwap.active and enabled.BestSword then return end
    if os.clock() < nextSummonTime then return end
    nextSummonTime = os.clock() + 1.0
    summonSequence = summonSequence + 1
    local ok, err = pcall(function()
        SummonRequest:FireServer("Summon", summonSequence)
    end)
    if not ok then warn("[Arise Combat] Summon remote:", err) end
end

-- The game's activateSkill() sends ("Skill", flat horizontal facing
-- direction, request sequence) after checking equipped weapon/cooldown.
-- Direct use avoids local predicted motion/VFX, but the game may still
-- play skill clips when it receives a server acceptance event.
local function directAbility(character, root)
    if enabled._swordSwap.active and enabled.BestSword then return end
    if enabled.AutoDodge and Scheduler.dodge and Scheduler.dodge.active then return end
    local now = os.clock()
    if now < nextAbilityAttempt then return end
    if character:GetAttribute("StationTraining")
        or character:GetAttribute("Training") == true then return end

    local serverNow = Workspace:GetServerTimeNow()
    local serverEnd = LocalPlayer:GetAttribute("SkillEnd")
    if type(serverEnd) == "number" and serverEnd > serverNow then return end
    if type(SkillState.SkillEnd) == "number" and SkillState.SkillEnd > serverNow then return end
    if SkillState.SkillPending then
        Scheduler.combat.preparing = false
        return
    end

    local skill = refreshSkillAnimationIds(character)
    if not skill then
        Scheduler.combat.preparing = false
        return
    end

    -- Attacks from BOTH Kill Aura and Dungeon Farm use directAttack().
    -- Reserve one gap so an equipped ability can start rather than being
    -- postponed forever by repeating combo requests.
    local priority = Scheduler.combat
    if not priority.preparing then
        priority.preparing = true
        priority.prepareUntil = now + math.max(0.38,
            math.min(0.72, math.max(0, nextAttackTime - now) + 0.12))
        priority.attackPauseUntil = priority.prepareUntil + 0.16
        return
    end
    if now < priority.prepareUntil then return end
    priority.preparing = false
    local forward = root.CFrame.LookVector
    local flat = Vector3.new(forward.X, 0, forward.Z)
    local aim = flat.Magnitude > 0.05 and flat.Unit or Vector3.new(0, 0, -1)

    -- The normal controller uses one incrementing request sequence for both
    -- attacks and skills. Reuse our sequence counter for both kinds.
    sequence = sequence + 1
    local ok, err = pcall(function()
        CombatRequest:FireServer("Skill", aim, sequence)
    end)
    if ok then
        nextAbilityAttempt = now + 1.5 -- Wait for server acceptance/cooldown.
        priority.lastSkillRequest = now
        -- Allow the server to process the ability before basic combos resume.
        priority.attackPauseUntil = now + math.clamp(tonumber(skill.Commit) or 0.5, 0.45, 1.6)
        nextAttackTime = math.max(nextAttackTime, priority.attackPauseUntil)
        comboIndex = 0
        lastAttackTime = -math.huge
        local duration = math.max(1.25, tonumber(skill.Commit) or 0, tonumber(skill.Cancel) or 0)
        for _, clips in ipairs({skill.Clip or {}, skill.Fallback or {}}) do
            for _, clip in ipairs(clips) do
                duration = math.max(duration, tonumber(clip.Until or clip.Stop or clip.At) or 0)
            end
        end
        abilityHideUntil = now + math.min(6, duration + 1.2)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        stopAttackTracks(animator)
    else
        nextAbilityAttempt = now + 1
        priority.attackPauseUntil = now + 0.12
        warn("[Arise Combat] Ability remote:", err)
    end
end

Scheduler.add("Summon", 0.15, function()
    if enabled.AutoSummon and not enabled._swordSwap.active and gameActionReady()
        and LocalPlayer:GetAttribute("SummonActive") ~= true
        and (LocalPlayer:GetAttribute("SummonCooldownEnd") or 0) <= Workspace:GetServerTimeNow()
