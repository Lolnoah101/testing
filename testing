function s:IsDowned()
    local state = player:GetAttribute("CombatState")
    local char = player.Character
    return state == "Downed" or state == "Eliminated"
        or (char ~= nil and (
            char:GetAttribute("Downed") == true
            or char:GetAttribute("CombatState") == "Downed"
            or char:GetAttribute("CombatState") == "Eliminated"
        ))
end

