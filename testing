-- Lookup is done by canonicalized NPC names; generated NPC IDs are not assumed.
function Hub:GetKnownNpcSpawns(targetName)
    if type(targetName) ~= "string" or targetName == "" or targetName == "None" then
        return {}, "No mob selected"
    end
    local key = compactNpcName(npcCanonical(targetName))
    -- Phantom Goon is the backend key; Phantom Raider is the map's spawn name.
    if key == compactNpcName("Phantom Goon") then key = compactNpcName("Phantom Raider") end
    local now = os.clock()
    local cached = self.KnownSpawnCache[key]
    if cached and now-cached.At<8 then return cached.Points, cached.Source end
    local points, source = {}, "Captured NpcSpawnPoints"
    local liveFolder = ReplicatedStorage:FindFirstChild("NpcSpawnPoints")
    if liveFolder then
        for _, node in ipairs(liveFolder:GetChildren()) do
            if node:IsA("Vector3Value")
                and (compactNpcName(npcCanonical(node.Name)) == key
                    or (key == compactNpcName("Phantom Raider")
                        and node.Name == "Phantom Raider")) then
                table.insert(points,node.Value)
            end
        end
        if #points>0 then source="ReplicatedStorage.NpcSpawnPoints" end
    end
    if #points==0 then
        for name, stored in pairs(self.CapturedNpcSpawns) do
            if compactNpcName(npcCanonical(name)) == key
                or (key == compactNpcName("Phantom Raider") and name == "Phantom Raider") then
                for _, pos in ipairs(stored) do table.insert(points,pos) end
            end
        end
    end
    -- Keep live-observed locations alongside saved spawn points. The exact
    -- replicated spawn list is not always exhaustive after a world update.
    local label=NpcPreferredVisible[npcCanonical(targetName)] or targetName
    local seen=self.LastKnownEnemyAreas[label]
    if seen and #seen>0 then
        if #points==0 then source="Previously observed living "..label
        else source=source.." + observed live spawns" end
        for _,position in ipairs(seen) do
            local distinct=true
            for _,existing in ipairs(points) do
                if (existing-position).Magnitude<24 then distinct=false;break end
            end
            if distinct then table.insert(points,position) end
        end
    end
    self.KnownSpawnCache[key]={Points=points,Source=source,At=now}
    return points,source
end
-- Separate routes keep manual farming and quest work independent.
-- We visit multiple verified spawn areas instead of waiting forever for a
-- currently invisible enemy. The target must be a LIVING streamed humanoid.
function Hub:NextKnownNpcArea(targetName, currentPosition, owner)
    if typeof(currentPosition)~="Vector3" then return nil,"No character" end
    local points,source=self:GetKnownNpcSpawns(targetName)
    if #points==0 then return nil,"No saved spawn point for "..tostring(targetName) end
    local route=self.KnownAreaRoutes[owner]
    if not route or route.Name~=targetName or route.Count~=#points then
        local ordered={}
        for _,p in ipairs(points) do table.insert(ordered,p) end
        table.sort(ordered,function(a,b)
            return (a-currentPosition).Magnitude<(b-currentPosition).Magnitude
        end)
        route={Name=targetName,Points=ordered,Count=#points,
            Index=1,ArrivedAt=0,StartAt=os.clock()}
        self.KnownAreaRoutes[owner]=route
    end
    local goal=route.Points[route.Index]
    local distance=(currentPosition-goal).Magnitude
    if distance < 35 then
        if route.ArrivedAt==0 then route.ArrivedAt=os.clock() end
        -- A missing NPC should not pin a quest at the first empty spawn.
        -- Nearby living matches are picked immediately by chooseQuestEnemy;
        -- after a brief streaming grace period, visit another verified spot.
        local grace=owner=="quest" and 2.7 or 3.8
        if os.clock()-route.ArrivedAt>grace and route.Count>1 then
            route.Index=route.Index % route.Count + 1
            route.ArrivedAt=0
            goal=route.Points[route.Index]
            distance=(currentPosition-goal).Magnitude
        end
    else
        route.ArrivedAt=0
    end
    return goal,source,route.Index,route.Count,distance
end

