local function getRange()
    if rangeStats and type(rangeStats.Player_Range) == "function" then
        local ok, distance = pcall(rangeStats.Player_Range, rangeStats, player)
        if ok and type(distance) == "number" and distance > 0 then
            return distance
        end
    end
    if player:GetAttribute("Mode") == "Dungeon" then return 20 end
    local attribute = player:GetAttribute("Range")
    return (type(attribute) == "number" and attribute > 0) and attribute or 12
end

-- The actual map comes from Paradise_Client.Data.Map; attribute and
-- server-folder checks are fallbacks while the client data is loading.
local KNOWN_WORLD_ORDER = {
    "Lobby", "Solo City", "Ninja Village", "Dragon World", "Marine Island"
}
local WORLD_MOBS = {
    ["Lobby"] = { "DummyTest" },
    ["Solo City"] = { "Ant", "Kangi", "Tuski", "Igros", "AntiKingi" },
    ["Ninja Village"] = { "Zabuze", "Hedan", "Sasore", "Paim", "Orochemaro" },
    ["Dragon World"] = { "Gran", "Boo", "GokoBlack", "Frieza", "Jeren" },
    ["Marine Island"] = { "Buggi", "Luzano", "Zawu", "Akainwu", "BlackBode", "Crocodele" }
}
local DIFFICULTY_ORDER = {
    Test = 0, Easy = 1, Medium = 2, Hard = 3,
    Impossible = 4, Boss = 5, ["Raid Boss"] = 6
}

local function getWorld()
    local data = nativeController and nativeController.Data
    if type(data) == "table" and type(data.Map) == "string" and data.Map ~= "" then
        return data.Map
    end
    for _, attributeName in ipairs({ "Map", "CurrentMap", "CurrentWorld" }) do
        local name = player:GetAttribute(attributeName)
        if type(name) == "string" and name ~= "" then return name end
    end

    local server = Workspace:FindFirstChild("Server")
    local all = server and server:FindFirstChild("Enemies")
    if all then
        local found = nil
        for _, world in ipairs(KNOWN_WORLD_ORDER) do
            local folder = all:FindFirstChild(world)
            if folder and #folder:GetChildren() > 0 then
                if found then return nil end -- multiple loaded worlds: do not guess
                found = world
            end
        end
        return found
    end
    return nil
end

local function getParts()
    local character = player.Character
    if not character then return nil, nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then return nil, nil end
    return root, humanoid
end

-- Quest movement is its own opt-in system. No Farm toggle is required.
-- The same movement engine is shared to avoid competing tweens/teleports.
local function hasActiveQuestTarget()
    return state.AutoQuest and state.QuestProgressState == "active"
        and state.QuestWorld == state.CurrentWorld
        and type(state.QuestMob) == "string" and state.QuestMob ~= ""
end

local function cancelTween()
    local tween = state.Tween
    state.Tween = nil
    state.TweenDestination = nil
    state.TweenTarget = nil
    if tween then pcall(function() tween:Cancel() end) end
end

-- A client-created support surface: physical size 12 x 12 studs (1 stud thick).
-- This is not a server-side part; the game's server may still correct movement.
local function removeBelowPlatform()
    local platform = state.BelowPlatform
    state.BelowPlatform = nil
    if platform then
        pcall(function() platform:Destroy() end)
    end
end

local function ensureBelowPlatform()
    local platform = state.BelowPlatform
    if platform and platform.Parent then return platform end
    platform = Instance.new("Part")
    platform.Name = "Paraiso_BelowFarm_Platform"
    platform.Size = Vector3.new(12, 1, 12)
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanTouch = false
    platform.CastShadow = false
    platform.Material = Enum.Material.SmoothPlastic
    platform.Color = Color3.fromRGB(65, 145, 205)
    platform.Transparency = 0.25
    platform.Parent = Workspace
    state.BelowPlatform = platform
    return platform
end

-- Set the top of the platform beneath the character's feet, not at the
-- HumanoidRootPart's center (that would leave the avatar half-submerged).
local function placeBelowPlatform(root, humanoid, rootDestination)
    local platform = ensureBelowPlatform()
    local footOffset
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        footOffset = 3 -- R6 root-to-feet spacing
    else
        footOffset = humanoid.HipHeight + root.Size.Y * 0.5
    end
    footOffset = math.max(1, footOffset)
    local topY = rootDestination.Y - footOffset
    platform.CFrame = CFrame.new(
        rootDestination.X,
        topY - platform.Size.Y * 0.5,
        rootDestination.Z
    )
end

-- Save the location when we ENTER Below farming, never while already moving
-- underground. This remains unchanged while farming/retargeting/sliding distance.
local function rememberSurfacePosition()
    local root = getParts()
    if not root then return end
    if state.BelowReturnCharacter ~= player.Character then
        state.BelowReturnCFrame = nil -- ignore saved location from an older life
    end
    if not state.BelowReturnCFrame then
        state.BelowReturnCFrame = root.CFrame
        state.BelowReturnCharacter = player.Character
        state.BelowReturnWorld = state.CurrentWorld
    end
    state.WasBelowFarming = true
end

-- If a script was loaded while already underground and no prior position was
-- recorded, raycast to find the physical map surface near the player.
local function surfaceFallback(root, humanoid)
    local at = root.Position
    local enemy = state.FarmTarget
    local enemyY = enemy and enemy.Parent and enemy.Position.Y or at.Y
    local origin = Vector3.new(at.X, math.max(at.Y, enemyY) + 250, at.Z)
    local ignore = { player.Character }
    if state.BelowPlatform then table.insert(ignore, state.BelowPlatform) end
    local serverFolder = Workspace:FindFirstChild("Server")
    if serverFolder then table.insert(ignore, serverFolder) end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, Vector3.new(0, -700, 0), params)
    if not result then return nil end
    local footOffset = humanoid.RigType == Enum.HumanoidRigType.R6
        and 3 or (humanoid.HipHeight + root.Size.Y * 0.5)
    local safeHeight = result.Position.Y + math.max(footOffset, 2) + 3
    local surface = Vector3.new(at.X, safeHeight, at.Z)
    return CFrame.new(surface) * root.CFrame.Rotation
end

-- Upgrade recovery: an older script may have left the character below map
-- during hot reload before we could capture a surface position.
if recoverOldBelowOnReload then
    local root, humanoid = getParts()
    local above = root and surfaceFallback(root, humanoid)
    if above then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        player.Character:PivotTo(above)
    else
        warn("[Paraiso Farm] Could not find surface while upgrading from older Below script")
    end
end

local function clearReturnPosition()
    state.BelowReturnCFrame = nil
    state.BelowReturnCharacter = nil
    state.BelowReturnWorld = nil
    state.WasBelowFarming = false
end

-- Key ordering: STOP movement -> RETURN ABOVE -> REMOVE PLATFORM.
-- Return first to avoid dropping the player into the void.
local function returnAboveMap()
    cancelTween()
    if not state.WasBelowFarming and not state.BelowReturnCFrame then
        removeBelowPlatform()
        return
    end

    local root, humanoid = getParts()
    local destination
    if root then
        if state.BelowReturnCharacter == player.Character
            and state.BelowReturnCFrame
            and state.BelowReturnWorld == state.CurrentWorld then
            -- Small lift helps prevent the character getting caught in the floor.
            destination = state.BelowReturnCFrame + Vector3.new(0, 3, 0)
        else
            destination = surfaceFallback(root, humanoid)
        end
        if destination then
            humanoid:MoveTo(root.Position)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            player.Character:PivotTo(destination)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            humanoid:MoveTo(root.Position)
        else
            warn("[Paraiso Farm] Could not identify a safe above-map return position")
        end
    end
    removeBelowPlatform()
    clearReturnPosition()
end

local function stopMoving()
    cancelTween()
    local root, humanoid = getParts()
    if root and humanoid then humanoid:MoveTo(root.Position) end
end

local function changeTarget()
    state.FarmTarget = nil
    state.LastMove = 0
    stopMoving()
    if not (state.AutoFarm or hasActiveQuestTarget()
        or state.AutoFarmTrial or state.AutoFarmTower
        or state.AutoFarmSoloRaid or state.AutoFarmNinjaRaid)
        or state.Position ~= "Below" then
        removeBelowPlatform()
    end
end

local function getEnemyFolder()
    local server = Workspace:FindFirstChild("Server")
    if not server then return nil end
    local mode = player:GetAttribute("Mode")
    if mode and mode ~= "" and mode ~= false then
        if mode == "Tower" then
            local tower = server:FindFirstChild("Tower")
            local rooms = tower and tower:FindFirstChild("ActiveRooms")
            local room = rooms and rooms:FindFirstChild(tostring(player:GetAttribute("TowerRoom")))
            return room and room:FindFirstChild("Enemies") or nil
        end
        local modeRoot = server:FindFirstChild(tostring(mode))
        return modeRoot and modeRoot:FindFirstChild("Enemies") or nil
    end
    local enemies = server:FindFirstChild("Enemies")
    return enemies and state.CurrentWorld and enemies:FindFirstChild(state.CurrentWorld) or nil
end

local function isAlive(enemy)
    return enemy and enemy.Parent and enemy:IsA("BasePart")
        and enemy:GetAttribute("ID") ~= nil
        and not enemy:GetAttribute("Died")
end

-- Pull live world definitions from ReplicatedStorage.Shared.Enemies[world].
-- The preset ID order guarantees Easy -> Medium -> Hard -> Impossible -> Boss.
-- Reload also discovers any newly spawned types not in those definitions.
local function buildMobOptions(world)
    local options, byLabel, entries = {}, {}, {}
    if type(world) ~= "string" then
        return { "Waiting for world..." }, {}, nil
    end
    local definitions = {}
    local enemyModules = shared and shared:FindFirstChild("Enemies")
    local module = enemyModules and enemyModules:FindFirstChild(world)
    if module and module:IsA("ModuleScript") then
        local ok, result = pcall(require, module)
        if ok and type(result) == "table" then definitions = result end
    end

    local preferredOrder = WORLD_MOBS[world] or {}
    local preferredIndex = {}
    for index, id in ipairs(preferredOrder) do preferredIndex[id] = index end

    for id, info in pairs(definitions) do
        if type(id) == "string" and type(info) == "table" then
            entries[id] = {
                Id = id,
                Name = (type(info.Name) == "string" and info.Name) or id,
                Difficulty = (type(info.Difficult) == "string" and info.Difficult) or "Mob",
                World = world
            }
        end
    end

    -- Fallback if definitions are still loading; preserve their known ordering.
    local defaultDifficulties = { "Easy", "Medium", "Hard", "Impossible", "Boss", "Raid Boss" }
    for index, id in ipairs(preferredOrder) do
        if not entries[id] then
            entries[id] = {
                Id = id, Name = id,
                Difficulty = world == "Lobby" and "Test" or defaultDifficulties[index] or "Mob",
                World = world
            }
        end
    end

    local folder = getEnemyFolder()
    if folder then
        for _, enemy in ipairs(folder:GetChildren()) do
            if isAlive(enemy) and not entries[enemy.Name] then
                entries[enemy.Name] = {
                    Id = enemy.Name, Name = enemy.Name,
                    Difficulty = "Mob", World = world
                }
            end
        end
    end

    local sorted = {}
    for _, entry in pairs(entries) do table.insert(sorted, entry) end
    table.sort(sorted, function(a, b)
        local aOrder, bOrder = preferredIndex[a.Id], preferredIndex[b.Id]
        if aOrder and bOrder then return aOrder < bOrder end
        if aOrder then return true end
        if bOrder then return false end
        local aRank = DIFFICULTY_ORDER[a.Difficulty] or 50
        local bRank = DIFFICULTY_ORDER[b.Difficulty] or 50
        if aRank ~= bRank then return aRank < bRank end
        return a.Name < b.Name
    end)

    for _, entry in ipairs(sorted) do
        local label = string.format("%s (%s)", entry.Name, entry.Difficulty)
        -- In case different enemy IDs have the same display name.
        if byLabel[label] then label = label .. " [" .. entry.Id .. "]" end
        table.insert(options, label)
        byLabel[label] = entry
    end
    if #options == 0 then options[1] = "No mobs in this world" end
    return options, byLabel, sorted
end

local function getMyShadows()
    local server = Workspace:FindFirstChild("Server")
    local shadows = server and server:FindFirstChild("Shadows")
    local mine = shadows and shadows:FindFirstChild(tostring(player.UserId))
    local result = {}
    if mine then
        for _, shadow in ipairs(mine:GetChildren()) do
            local target = shadow:FindFirstChild("Target_Enemy")
            if target and target:IsA("ObjectValue") then
                table.insert(result, shadow)
            end
        end
    end
    return result
end

local function hasAssignedEnemy(onlyEnemy)
    for _, shadow in ipairs(getMyShadows()) do
        local enemy = shadow.Target_Enemy.Value
        if isAlive(enemy) and (not onlyEnemy or enemy == onlyEnemy) then
            return true
        end
    end
    return false
end

-- If allowedMobIds is nil, finds any mob (used by Units Auto Attack).
-- If supplied, finds the closest mob whose ID was selected in the dropdown.
local function nearestEnemy(allowedMobIds)
    local root = getParts()
    local folder = getEnemyFolder()
    if not root or not folder then return nil, math.huge end
    local nearest, distance = nil, math.huge
    for _, enemy in ipairs(folder:GetChildren()) do
        if isAlive(enemy) and enemy:GetAttribute("Class") ~= nil
            and (player:GetAttribute("Mode") ~= "Raid"
                or (player:GetAttribute("RaidRoom") ~= nil
                    and enemy:GetAttribute("RaidRoom") == player:GetAttribute("RaidRoom")))
            and (not allowedMobIds or allowedMobIds[enemy.Name]) then
            local delta = (enemy.Position - root.Position).Magnitude
            if delta < distance then
                nearest, distance = enemy, delta
            end
        end
    end
    return nearest, distance
end

local lastAttack = setmetatable({}, { __mode = "k" })
local function assignShadows(enemy)
    if not isAlive(enemy) then return end
    local enemyClass = enemy:GetAttribute("Class")
    if not enemyClass then return end
    local now = os.clock()
    for _, shadow in ipairs(getMyShadows()) do
        local target = shadow:FindFirstChild("Target_Enemy")
        if target and target.Value ~= enemy and now - (lastAttack[shadow] or -1e9) >= 0.5 then
            lastAttack[shadow] = now
            bridge:FireServer("Shadows", "Attack", "Attack", enemyClass, enemy, shadow.Name)
        end
    end
end

local function updateUnitAutoAttack()
    if nativeController and nativeController.Auto_Attack then return end
    local enemy, distance = nearestEnemy(nil)
    if not enemy then return end

    -- Furthest Range removes only THIS SCRIPT'S local distance filter.
    -- It never alters the game's server-side attack-range validation.
    -- We still choose the closest living enemy among loaded world mobs,
    -- so the script doesn't prefer distant enemies over nearby ones.
    if state.AttackRangeMode == "Use Furthest Range" or distance <= getRange() then
        assignShadows(enemy)
    end
end

local function desiredPosition(enemy, range)
    -- Honor the requested distance only within the game's actual attack range.
    -- Otherwise Shadows would be assigned from outside the valid distance.
    local gap = math.clamp(state.FarmDistance, 3, math.max(3, range - 2))
    if state.Position == "Above" then
        return enemy.Position + Vector3.new(0, gap, 0)
    elseif state.Position == "Below" then
        return enemy.Position - Vector3.new(0, gap, 0)
    end
    local backwards = -enemy.CFrame.LookVector
    backwards = Vector3.new(backwards.X, 0, backwards.Z)
    if backwards.Magnitude < 0.01 then backwards = Vector3.new(0, 0, 1) end
    return enemy.Position + backwards.Unit * gap + Vector3.new(0, 2.5, 0)
end

-- Orient the character horizontally toward the mob (no vertical tipping).
local function facingCFrame(position, enemy)
    local look = Vector3.new(enemy.Position.X - position.X, 0, enemy.Position.Z - position.Z)
    if look.Magnitude < 0.01 then
        local root = getParts()
        if root then
            local forward = root.CFrame.LookVector
            look = Vector3.new(forward.X, 0, forward.Z)
        end
    end
    if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
    return CFrame.lookAt(position, position + look.Unit)
end

local function applyMovement(enemy, root, humanoid, destination)
    if state.Method == "Teleport" then
        cancelTween()
        if (root.Position - destination).Magnitude > 2.0 then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = facingCFrame(destination, enemy)
        end
        return
    end

    if state.Method == "Tween" then
        local distance = (root.Position - destination).Magnitude
        if distance <= 2.0 then
            cancelTween()
            return
        end
        if state.Tween and state.TweenTarget == enemy and state.TweenDestination
            and (state.TweenDestination - destination).Magnitude <= 3.0 then
            return -- Don't restart a tween every 0.1s.
        end
        cancelTween()
        humanoid:MoveTo(root.Position)
        local seconds = math.clamp(distance / 65, 0.12, 2.0)
        local tween = TweenService:Create(root, TweenInfo.new(seconds, Enum.EasingStyle.Linear), {
            CFrame = facingCFrame(destination, enemy)
        })
        state.Tween = tween
        state.TweenTarget = enemy
        state.TweenDestination = destination
        tween.Completed:Connect(function()
            if state.Tween == tween then
                state.Tween = nil
                state.TweenTarget = nil
                state.TweenDestination = nil
            end
        end)
        tween:Play()
        return
    end

    -- Legit: normal walking cannot descend through terrain to a Below platform.
    -- Walk horizontally only, at the avatar's current height; using Below with
    -- Teleport or Tween is needed to reach an underground destination.
    cancelTween()
    if os.clock() - state.LastMove >= 0.45 then
        state.LastMove = os.clock()
        if state.Position == "Below" or state.Position == "Above" then
            humanoid:MoveTo(Vector3.new(destination.X, root.Position.Y, destination.Z))
        else
            humanoid:MoveTo(destination)
        end
    end
end

-- One combat/movement scheduler handles selected world mobs, independent
-- quest farming, AND each game mode. Mode farming takes precedence while
-- inside that mode; it never changes the Farm or Auto Quest toggles.
local function activeModeFarm()
    local mode = player:GetAttribute("Mode")
    if mode == "Trial" and state.AutoFarmTrial then return "Trial" end
    if mode == "Tower" and state.AutoFarmTower then return "Tower" end
    if mode == "Raid" then
        local raidId = player:GetAttribute("RaidId")
        if raidId == "Solo City" and state.AutoFarmSoloRaid then return "Raid" end
        if raidId == "Ninja Village" and state.AutoFarmNinjaRaid then return "Raid" end
    end
    return nil
end

local function farmMobFilter()
    local mode = activeModeFarm()
    if mode then return nil, false, mode end -- nil means ANY mode mob
    local current = player:GetAttribute("Mode")
    if current == "Trial" or current == "Tower" or current == "Raid" then
        return {}, false, nil -- don't run regular world farm inside game modes
    end
    if hasActiveQuestTarget() then
        return { [state.QuestMob] = true }, true, nil
    end
    if state.AutoFarm then
        return state.SelectedMobs, false, nil
    end
    return {}, false, nil
end

local function updateAutoFarm()
    local activeMobs, questTargeting, modeTargeting = farmMobFilter()
    if not modeTargeting and (not next(activeMobs) or not state.CurrentWorld) then
        if state.FarmTarget then changeTarget() end
        if state.WasBelowFarming then
            returnAboveMap() -- nothing to fight; restore surface before cleanup
        else
            removeBelowPlatform()
        end
        return
    end

    local root, humanoid = getParts()
    if not root then return end

    -- Quest mode uses ONLY its requested mob. Manual mode uses ONLY selected
    -- mobs. Both keep a valid current target until defeated or changed.
    local enemy = state.FarmTarget
    local folder = getEnemyFolder()
    if not (isAlive(enemy) and folder and enemy.Parent == folder
        and (modeTargeting or activeMobs[enemy.Name])
        and (modeTargeting ~= "Raid" or enemy:GetAttribute("RaidRoom") == player:GetAttribute("RaidRoom"))
        and enemy:GetAttribute("Class") ~= nil) then
        enemy = nil
    end
    local distance
    if enemy then
        distance = (enemy.Position - root.Position).Magnitude
    else
        enemy, distance = nearestEnemy(modeTargeting and nil or activeMobs)
    end
    if state.FarmTarget ~= enemy then
        state.FarmTarget = enemy
        cancelTween()
        state.LastMove = 0
    end
    if not enemy then return end -- wait for selected/quest mob to spawn

    local range = getRange()
    local goal = desiredPosition(enemy, range)
    local goalDistance = (root.Position - goal).Magnitude

    -- Save our safe return location before the FIRST underground movement.
    -- Then place the 12x12 support platform before moving down.
    if state.Position == "Below" then
        rememberSurfacePosition()
        placeBelowPlatform(root, humanoid, goal)
    else
        removeBelowPlatform()
    end

    -- Attacks still use the game's genuine range and remote.
    if distance <= range - 0.5 then assignShadows(enemy) end

    if state.Method == "Legit" then
        -- Legit mode cannot reach an underground platform without a normal path.
        local xz = Vector3.new(goal.X - root.Position.X, 0, goal.Z - root.Position.Z)
        if xz.Magnitude > 2.5 or distance > range - 1.0 then
            applyMovement(enemy, root, humanoid, goal)
        end
    elseif goalDistance > 2.0 then
        applyMovement(enemy, root, humanoid, goal)
    end
end

