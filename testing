    local PendingEvolution = nil


    local function StopAutoEvolve()

        ExtraSettings.AutoEvolve =
            false


        RequestToggle(
            "EvolutionAuto",
            false
        )
    end


    RunEvolutionOnce = function()

        if not ExtraSettings.AutoEvolve then
            return
        end


        if PendingEvolution then
            return
        end


        local Character =
            ExtraSettings.EvolutionSelection


        if not Character then

            StopAutoEvolve()

            QueueNotification(
                "Evolutions",
                "Select one of your slot characters first.",
                5
            )

            return
        end


        local Data =
            GetExtraAccountData()


        if not Data then

            StopAutoEvolve()

            QueueNotification(
                "Evolutions",
                "Account data is not ready yet.",
                5
            )

            return
        end


        if not OwnsEvolutionCharacter(
            Data,
            Character
        )
        then

            StopAutoEvolve()

            RefreshEvolutionSlots(
                false
            )

            QueueNotification(
                "Evolutions",
                "That character is no longer in one of your unlocked slots.",
                5
            )

            return
        end


        local CharacterData =
            Data.CharactersData
            and Data.CharactersData[
                Character
            ]


        local DisplayName =
            WeaponIdToName[
                Character
            ]
            or Character


        if CharacterData
            and CharacterData.IsUltimateUnlocked
                == true
        then

            StopAutoEvolve()

            RefreshEvolutionSlots(
                false
            )

            QueueNotification(
                "Evolutions",
                DisplayName
                    .. " is already evolved.",
                5
            )

            return
        end


        local CanEvolve,
            Missing,
            Requirements =
            CheckEvolutionRequirements(
                Character,
                Data
            )


        if not Requirements then

            StopAutoEvolve()

            QueueNotification(
                "Evolutions",
                "No evolution requirements were found for "
                    .. DisplayName
                    .. ".",
                5
            )

            return
        end


        if not CanEvolve then

            StopAutoEvolve()

            QueueNotification(
                "Evolution Requirements - "
                    .. DisplayName,
                EvolutionMissingText(
                    Missing
                ),
                10
            )

            return
        end


        PendingEvolution = {
            character = Character,
            sentAt = os.clock(),
        }


        local Fired,
            ErrorMessage =
            pcall(function()

                ExtraPackets
                    .evolveCharacter
                    :fire(
                        Character
                    )
            end)


        if not Fired then

            PendingEvolution = nil

            StopAutoEvolve()

            warn(
                "[Anime Zero][Evolutions]",
                ErrorMessage
            )

            QueueNotification(
                "Evolutions",
                "Evolution request could not be sent.",
                5
            )

            return
        end


        local SentCharacter =
            Character


        task.delay(
            8,
            function()

                if not ExtraAlive()
                    or not PendingEvolution
                    or PendingEvolution.character
                        ~= SentCharacter
                then

                    return
                end


                PendingEvolution = nil

                StopAutoEvolve()

                QueueNotification(
                    "Evolutions",
                    "Evolution request timed out.",
                    5
                )
            end
        )
    end


    if ExtraPackets.evolveCharacterResult then

        local Connection =
            ExtraPackets
                .evolveCharacterResult
                :on(function(Result)

                    if not ExtraAlive()
                        or not Result
                        or not PendingEvolution
                    then

                        return
                    end


                    if tostring(
                        Result.character
                    ) ~= PendingEvolution.character
                    then

                        return
                    end


                    local Character =
                        PendingEvolution.character

                    PendingEvolution = nil

                    StopAutoEvolve()


                    local DisplayName =
                        WeaponIdToName[
                            Character
                        ]
                        or Character


                    if tostring(
                        Result.status
                    ) == "success"
                    then

                        QueueNotification(
                            "Evolution Complete",
                            DisplayName
                                .. " evolved successfully.",
                            7
                        )

                        task.delay(
                            0.25,
                            function()
                                if ExtraAlive() then
                                    RefreshEvolutionSlots(
                                        false
                                    )
                                end
                            end
                        )

                        return
                    end


                    local Data =
                        GetExtraAccountData()

                    local CanEvolve = false

                    local Missing = nil


                    if Data then

                        CanEvolve, Missing =
                            CheckEvolutionRequirements(
                                Character,
                                Data
                            )
                    end


                    if Data
                        and not CanEvolve
