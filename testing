    local PendingWeapon = nil


    SendWeaponSpinOnce = function()

        if PendingWeapon then
            return
        end


        local Now =
            os.clock()


        local Earliest =
            LastWeaponRequestAt
            + GetWeaponRollCooldown()


        if LastWeaponRequestAt > 0
            and Now < Earliest
        then

            NextWeaponAutoSpinAt =
                math.max(
                    NextWeaponAutoSpinAt,
                    Earliest
                    + WEAPON_ROLL_RETRY_GUARD
                )

            return
        end


        local SpinType =
            ExtraSettings.WeaponSpinType


        local PaymentCurrency


        if SpinType == "Lucky" then

            PaymentCurrency =
                "luckySpins"

        else

            PaymentCurrency =
                ExtraSettings
                    .WeaponPaymentCurrency
        end


        if PaymentCurrency == "rolls" then

            local Rolls =
                GetExtraCurrency(
                    "rolls"
                )


            if Rolls ~= nil
                and Rolls < 1
            then

                ExtraSettings.AutoSpinWeapon =
                    false

                RequestToggle(
                    "WeaponAuto",
                    false
                )

                QueueNotification(
                    "Weapons",
                    "You have no Dice Rolls. Auto Spin stopped.",
                    5
                )

                return
            end


        elseif PaymentCurrency == "luckySpins" then

            local LuckySpins =
                GetExtraCurrency(
                    "luckySpins"
                )


            if LuckySpins ~= nil
                and LuckySpins < 1
            then

                ExtraSettings.AutoSpinWeapon =
                    false

                RequestToggle(
                    "WeaponAuto",
                    false
                )

                QueueNotification(
                    "Weapons",
                    "You have no Lucky Spins. Auto Spin stopped.",
                    5
                )

                return
            end


        elseif PaymentCurrency == "money" then

            local Coins =
                GetExtraCurrency(
                    "money"
                )


            -- economyConfig: a Normal coin spin costs 500 money.
            if Coins ~= nil
                and Coins < 500
            then

                ExtraSettings.AutoSpinWeapon =
                    false

                RequestToggle(
                    "WeaponAuto",
                    false
                )

                QueueNotification(
                    "Weapons",
                    "Not enough Coins for another spin. Auto Spin stopped.",
                    5
                )

                return
            end
        end


        local Id =
            NextWeaponRequestId()


        PendingWeapon = {

            requestId = Id,

            slot =
                ExtraSettings.WeaponSlot,

            sentAt =
                os.clock(),
        }


        local Success,
            ErrorMessage =
            pcall(function()

                ExtraPackets
                    .rollCharacter
                    :fire({

                        spinType =
                            SpinType,

                        paymentCurrency =
                            PaymentCurrency,

                        slot =
                            ExtraSettings.WeaponSlot,

                        requestId =
                            Id,
                    })
            end)


        if Success then

            LastWeaponRequestAt =
                PendingWeapon.sentAt

            ScheduleNextWeaponRoll()

        else

            PendingWeapon = nil

            NextWeaponAutoSpinAt =
                math.max(
                    NextWeaponAutoSpinAt,
                    os.clock() + 0.15
                )

            warn(
                "[Anime Zero][Weapons] Temporary send failure; retrying:",
                ErrorMessage
            )
        end
    end


