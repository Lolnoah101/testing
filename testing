API.Unload = function()
    if not State.Alive then
        return
    end

    if Config.AutoSaveLocal then
        pcall(
            Systems.saveLocalAutoSave
        )
    end

    pcall(
        Systems.destroyStatusBox
    )

    State.FullAutoUserIntent = false
    State.FullAutoManualDisabled = true
    State.BossAutoEnabledFishing = false

    Config.Enabled = false
    Config.AutoBossFarm = false
    Config.AutoProgression = false
    Config.AutoAllQuests = false
    Config.AutoTravelSelectedIsland = false

    if Systems.syncUIFromConfig then
        pcall(
            Systems.syncUIFromConfig
        )
    end

    pcall(function()
        Systems.requestOPCancel(
            "script unload"
        )
    end)

    State.Alive = false
    State.BossSessionActive = false
    State.BossTargetPosition = nil

    Systems.clearESP()

    if State.ActiveMovementTween then
        pcall(function()
            State.ActiveMovementTween:Cancel()
        end)
        State.ActiveMovementTween = nil
    end

    Systems.stopCurrentCycle()
    mouseUp()

    if State.AutoSellBusy or next(State.AutoSellTempLocks) ~= nil then
        pcall(restoreTemporaryLocks)
    end

    for _, connection in ipairs(State.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(State.Connections)

    if State.Worker then
        pcall(task.cancel, State.Worker)
        State.Worker = nil
    end

    if State.Window and not State.Window.unloaded then
        pcall(State.Window.Unload, State.Window)
    end

    if State.FallbackGui then
        pcall(State.FallbackGui.Destroy, State.FallbackGui)
    end

    ENV.__FULL_AUTO_FISHING_DUAL_V20_4 = nil
    print("[FishingV20.4] Unloaded")
end

