function Systems.getActiveBossRegionPart()
    for _, part in ipairs(CollectionService:GetTagged(RegionConfig.BossTag)) do
        if part:IsA("BasePart") then
            local fx = BossSpawnerFX.GetForRegion(part)

            if fx and BossSpawnerFX.IsActive(fx) then
                local regionId =
                    part:GetAttribute(RegionConfig.BossAttribute)

                return part, regionId
