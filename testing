-- Anti AFK should not depend only on Player.Idled firing.  The Roblox client can
-- suppress/delay that event, and some executors restrict one of the input APIs.
-- A single Heartbeat watcher schedules a low-frequency pulse (not a per-frame input).
-- A successful pcall means a virtual input was sent; it does NOT prove the Roblox
-- client's built-in idle disconnect was reset on every platform.
function Hub:V74AntiAFKPulse(source)
    local E=self.V44
    if not self.Running or not E or not E.AntiAFK or E.AFKBusy then return end
    local now=os.clock()
    if source~="Idled" and now<(E.AFKNextPulseAt or 0) then return end
    E.AFKBusy=true
    E.AFKNextPulseAt=now+52
    E.AFKStatus="Sending anti-idle input"
    task.spawn(function()
        local methods={}
        local errors={}
        local camera=workspace.CurrentCamera
        local cf=camera and camera.CFrame or CFrame.new()
        local point=Vector2.new(0,0)
        local serviceOK,vu=pcall(function() return game:GetService("VirtualUser") end)
        if serviceOK and vu then
            local downOK,downErr=pcall(function()
                vu:CaptureController()
                vu:Button2Down(point,cf)
            end)
            if downOK then
                task.wait(0.055)
                local upOK,upErr=pcall(function() vu:Button2Up(point,cf) end)
                if upOK then
                    table.insert(methods,"VirtualUser")
                else
                    table.insert(errors,"VirtualUser release: "..tostring(upErr):sub(1,75))
                end
            else
                -- Some executor builds expose ClickButton2 but not Button2Down.
                local clickOK,clickErr=pcall(function()
                    vu:CaptureController()
                    vu:ClickButton2(point)
                end)
                if clickOK then
                    table.insert(methods,"VirtualUser click")
                else
                    table.insert(errors,"VirtualUser: "..tostring(clickErr or downErr):sub(1,75))
                end
            end
        else
            table.insert(errors,"VirtualUser unavailable")
        end

        -- F15 is deliberately chosen to avoid ordinary movement/combat keys.
        -- The key-up is attempted even if the key-down reports an error.
        local vimOK,vim=pcall(function() return game:GetService("VirtualInputManager") end)
        if vimOK and vim then
            local key=Enum.KeyCode.F15
            local downOK,downErr=pcall(function() vim:SendKeyEvent(true,key,false,game) end)
            if downOK then task.wait(0.045) end
            local upOK,upErr=pcall(function() vim:SendKeyEvent(false,key,false,game) end)
            if downOK and upOK then
                table.insert(methods,"VirtualInput")
            else
                table.insert(errors,"VirtualInput: "..tostring(downErr or upErr):sub(1,75))
            end
        else
            table.insert(errors,"VirtualInput unavailable")
        end

        -- Pulse complete: honor the toggle if it was turned off mid-pulse.
        E.AFKBusy=false
        if not self.Running or not E.AntiAFK then
            E.AFKStatus="Off"
            return
        end
        E.AFKLastPulseAt=os.clock()
        E.AFKLastMethod=#methods>0 and table.concat(methods," + ") or "None"
        E.AFKLastError=#errors>0 and table.concat(errors,"; ") or "None"
        if #methods>0 then
            E.AFKPulseCount=(E.AFKPulseCount or 0)+1
            E.AFKStatus="Input sent ("..E.AFKLastMethod..") via "..tostring(source)
            E.AFKNextPulseAt=os.clock()+52
        else
            E.AFKStatus="Input blocked by client/executor"
            E.AFKNextPulseAt=os.clock()+8  -- Retry, but do not flood the client.
        end
    end)
end

function Hub:InstallV44Continuity()
    local E=self.V44
    local TeleportService=game:GetService("TeleportService")
    local queue=(type(queue_on_teleport)=="function" and queue_on_teleport)
        or (type(queueonteleport)=="function" and queueonteleport)
        or (syn and type(syn.queue_on_teleport)=="function" and syn.queue_on_teleport)
    table.insert(self.Connections,LocalPlayer.OnTeleport:Connect(function(state)
        if not self.Running or not E.AutoExecute or not queue or self.AutoHunterExam then return end
        if state~=Enum.TeleportState.Started then return end
        local url=tostring(E.LoaderURL or "")
        if not url:match("^https://") then E.ContinuityStatus="Set a trusted raw HTTPS loader URL";return end
        local loader="loadstring(game:HttpGet("..string.format("%q",url).."))()"
        local ok,err=pcall(queue,loader)
        E.ContinuityStatus=ok and "Queued loader for teleport" or ("Queue failed: "..tostring(err))
    end))
    table.insert(self.Connections,LocalPlayer.Idled:Connect(function()
        if not self.Running or not E.AntiAFK then return end
        E.AFKIdleEvents=(E.AFKIdleEvents or 0)+1
        self:V74AntiAFKPulse("Idled")
    end))
    -- No actions are sent every frame; Heartbeat only checks a 52-second timer.
    table.insert(self.Connections,RunService.Heartbeat:Connect(function()
        if self.Running and E.AntiAFK and os.clock()>=(E.AFKNextPulseAt or 0) then
            self:V74AntiAFKPulse("Heartbeat")
        end
    end))
    table.insert(self.Connections,TeleportService.TeleportInitFailed:Connect(function(player)
        if player~=LocalPlayer or not E.AutoReconnect then return end
        E.ContinuityStatus="Teleport failed; trying to rejoin"
        task.delay(4,function()
            if self.Running and E.AutoReconnect then
                pcall(function() TeleportService:Teleport(game.PlaceId,LocalPlayer) end)
            end
        end)
    end))
end
