local function findExecutorAPI(name)
    local direct = Env[name]
    if type(direct) == "function" then return direct end
    local ok, global = pcall(function() return _G[name] end)
    if ok and type(global) == "function" then return global end
    return nil
end
local function executorFileAPIs()
    local writer = (type(writefile) == "function" and writefile)
        or findExecutorAPI("writefile")
    local reader = (type(readfile) == "function" and readfile)
        or findExecutorAPI("readfile")
    return writer, reader
end
local function executorQueueAPI()
    if type(queue_on_teleport) == "function" then return queue_on_teleport end
    if type(queueonteleport) == "function" then return queueonteleport end
    for _, key in ipairs({"queue_on_teleport", "queueonteleport"}) do
        local direct = findExecutorAPI(key)
        if direct then return direct end
    end
    local synObj = Env.syn or _G.syn
    if type(synObj) == "table" and type(synObj.queue_on_teleport) == "function" then
        return synObj.queue_on_teleport
    end
    return nil
end
local function setAutoExecStatus(message)
    print("[Tame V45 AutoExec] " .. tostring(message))
