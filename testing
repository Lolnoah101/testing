function Systems.getBestTitleId(data)
    local titles =
        data
        and data.Inventory
        and data.Inventory.Titles

    if type(titles) ~= "table" then
        return nil
    end

    local current =
        type(data.TitleEquip) == "string"
        and data.TitleEquip
        or nil

    local bestId = nil
    local bestScore = -math.huge

    for titleId, owned in pairs(titles) do
        if owned == true then
            local score = Systems.getTitleScore(titleId)

            if score > bestScore then
                bestScore = score
                bestId = titleId
            end
        end
    end

    -- If every owned title is cosmetic-only, keep the current owned title
    -- instead of changing it arbitrarily.
    if bestScore <= 0
        and current
        and titles[current] == true then
        return current
    end

    return bestId
end

function Systems.stepExtraEquipment()
    if not Config.AutoEquipBestAura
        and not Config.AutoEquipBestRodSkin
        and not Config.AutoEquipBestTitle then
        return
    end

    local now = os.clock()

    if now - State.LastExtraEquipmentCheck
        < math.max(
            0.5,
            tonumber(Config.ExtraEquipmentCheckInterval) or 1.5
        ) then
        return
    end

    State.LastExtraEquipmentCheck = now

    if State.ExtraEquipmentBusy
        or State.TravelBusy
        or State.AutoSellBusy then
        return
    end

    local data = getPlayerData()

    if not data then
        return
    end

    if Config.AutoEquipBestAura then
        local bestAura = Systems.getBestAuraKey(data)

        if bestAura and data.AuraEquip ~= bestAura then
            Systems.equipExtra("aura", bestAura)
            return
        end
    end

    if Config.AutoEquipBestRodSkin then
        local bestSkin = Systems.getBestRodSkinKey(data)

        if bestSkin and data.RodSkin ~= bestSkin then
            Systems.equipExtra("rodSkin", bestSkin)
            return
        end
    end

    if Config.AutoEquipBestTitle then
        local bestTitle = Systems.getBestTitleId(data)

        if bestTitle and data.TitleEquip ~= bestTitle then
            Systems.equipExtra("title", bestTitle)
            return
        end
    end
end

