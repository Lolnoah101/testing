local function refreshTraitUnits(data)
    if type(data.Shadows) ~= "table" then return end
    local entries = {}
    for uid, info in pairs(data.Shadows) do
        if type(info) == "table" then
            local shown = info.Custom_Name or info.Name or "Unit"
            local equipped = type(data.Shadows_Equipped) == "table" and data.Shadows_Equipped[uid] ~= nil
            local label = tostring(shown) .. (equipped and " (Equipped)" or "")
                .. (info.Shiny and " [Shiny]" or "") .. " | " .. tostring(uid)
            table.insert(entries, { label = label, uid = uid })
        end
    end
    table.sort(entries, function(a, b) return a.label < b.label end)
    local labels, map, ids = {}, {}, {}
    for _, entry in ipairs(entries) do
        table.insert(labels, entry.label)
        map[entry.label] = entry.uid
        table.insert(ids, tostring(entry.uid))
    end
    local signature = table.concat(labels, ";")
    if signature == state.TraitUnitSignature then return end
    state.TraitUnitSignature = signature
    state.TraitUnitByLabel = map
    local current = state.TraitTargetUID
    local currentLabel
    for label, uid in pairs(map) do
        if uid == current then currentLabel = label break end
    end
    if not currentLabel then
        state.TraitTargetUID = nil
        state.TraitRollPending = nil
        if state.AutoRollTraits then
            state.AutoRollTraits = false
            traitRollToggle:Set(false)
        end
    end
    unitChoice:Refresh(labels)
    unitChoice:Set(currentLabel and { currentLabel } or {})
end

local function stopTraitRolling(message)
    state.AutoRollTraits = false
    state.TraitRollPending = nil
    if traitRollToggle.value == true then traitRollToggle:Set(false) end
    setTraitStatus(message)
end
local function updateTraitRoll(data)
    if not state.AutoRollTraits then return end
    local uid = state.TraitTargetUID
    if uid == nil or type(data.Shadows) ~= "table" then
        setTraitStatus("Choose a unit before rolling.")
        return
    end
    local unit = data.Shadows[uid]
    if type(unit) ~= "table" then
        stopTraitRolling("Selected unit is no longer in your inventory.")
        return
    end
    if not next(state.TraitDesired) then
        setTraitStatus("Select at least one target trait.")
        return
    end
    if state.TraitDesired[unit.Trait] or state.TraitDesired[unit.SubTrait] then
        stopTraitRolling("TARGET TRAIT FOUND: " .. tostring(state.TraitDesired[unit.Trait] and unit.Trait or unit.SubTrait))
        return
    end
    local inv = data.Inventory
    local shards = type(inv) == "table" and tonumber(inv.TraitReroll) or 0
    if not shards or shards < 1 then
        stopTraitRolling("Stopped: no Trait Reroll shards left.")
        return
    end
    local now = os.clock()
    local snapshot = tostring(shards) .. "/" .. tostring(unit.Trait) .. "/" .. tostring(unit.SubTrait)
    local pending = state.TraitRollPending
    if pending then
        if pending.uid ~= uid then
            state.TraitRollPending = nil
        elseif pending.snapshot == snapshot then
            if now - pending.at > 10 then
                stopTraitRolling("No inventory/trait update after reroll. Stopped to avoid duplicate requests.")
            end
            return
        elseif now - pending.at < 0.75 then
            return
        else
            state.TraitRollPending = nil
        end
    end
    -- Match the game's auto-roll filter format: per trait, "Both" or "Nothing".
    local filters = {}
    for traitName in pairs(traitsDef) do
        filters[traitName] = state.TraitDesired[traitName] and "Both" or "Nothing"
    end
    state.TraitRollPending = { uid = uid, snapshot = snapshot, at = now }
    bridge:FireServer("General", "Traits", "Reroll", uid, filters)
    setTraitStatus("Reroll sent | Shards: " .. tostring(shards) .. " | Waiting for result...")
end

