-- Dropdown .value is always an array; in multiSelect callbacks it is also
-- an array. Do not treat a selection as a single string or a boolean-key set.
local function selectedLabels(handle)
    if not handle then return {} end
    local raw = handle.value
    if type(raw) == "string" then return { raw } end
    if type(raw) ~= "table" then return {} end
    local out = {}
    for _, label in ipairs(raw) do
        if type(label) == "string" then table.insert(out, label) end
    end
    return out
end

local function selectedIdsFromLabels(labels)
    local ids = {}
