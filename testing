;(function()

    local TeleportService =
        game:GetService("TeleportService")

    local HttpService =
        game:GetService("HttpService")

    local Key =
        "__AZ_INTERFACE_SETTINGS_V2"

    local DiskFile =
        "AnimeZero/interface_settings_v2.json"

    local LegacyFile =
        "AnimeZero/cross_place_ui_state.json"


    local function ReadJson(FileName)

        if type(readfile) ~= "function"
            or type(isfile) ~= "function"
            or not isfile(FileName)
        then
            return nil
        end


        local Success, Data =
            pcall(function()
                return HttpService:JSONDecode(
                    readfile(FileName)
                )
            end)


        return Success
            and type(Data) == "table"
            and Data
            or nil
    end


    local Saved =
        GENV[Key]


    if type(Saved) ~= "table"
        or next(Saved) == nil
    then

        local Success, TeleportSaved =
            pcall(function()
                return TeleportService
                    :GetTeleportSetting(Key)
            end)


        if Success
            and type(TeleportSaved) == "table"
            and next(TeleportSaved) ~= nil
        then
            Saved = TeleportSaved
        else
            Saved = ReadJson(DiskFile)
        end
    end


    if type(Saved) ~= "table"
        or next(Saved) == nil
    then

        local Legacy =
            ReadJson(LegacyFile)


        if type(Legacy) == "table" then
            Saved = {
                AutoExecuteOnTeleport =
                    Legacy.AutoExecuteOnTeleport,
                AntiAFK =
                    Legacy.AntiAFK,
                AutoReconnect =
                    Legacy.AutoReconnect,
                ReconnectDelay =
                    Legacy.ReconnectDelay,
            }
        end
    end


    if type(Saved) == "table" then

        if type(
            Saved.AutoExecuteOnTeleport
        ) == "boolean"
        then
            Settings.AutoExecuteOnTeleport =
                Saved.AutoExecuteOnTeleport
        end


        if type(Saved.AntiAFK) == "boolean" then
            Settings.AntiAFK =
                Saved.AntiAFK
        end


        if type(Saved.AutoReconnect) == "boolean" then
            Settings.AutoReconnect =
                Saved.AutoReconnect
        end


        if tonumber(Saved.ReconnectDelay) then
            Settings.ReconnectDelay =
                math.clamp(
                    tonumber(Saved.ReconnectDelay) or 5,
                    2,
                    30
                )
        end
    end


    -- Existing one-byte Auto Execute file is another migration / fallback.
    if type(readfile) == "function"
        and type(isfile) == "function"
        and isfile(
            "AnimeZero/autoexecute_enabled.txt"
        )
    then

        local Success, Value =
            pcall(
                readfile,
                "AnimeZero/autoexecute_enabled.txt"
            )


        if Success then
            Settings.AutoExecuteOnTeleport =
                tostring(Value) == "1"
        end
    end


    Settings.PersistInterfaceSettings =
        function()

            local Data = {
                AutoExecuteOnTeleport =
                    Settings.AutoExecuteOnTeleport
                    == true,

                AntiAFK =
                    Settings.AntiAFK
                    == true,

                AutoReconnect =
                    Settings.AutoReconnect
                    == true,

                ReconnectDelay =
                    math.clamp(
                        tonumber(Settings.ReconnectDelay) or 5,
                        2,
                        30
                    ),
            }


            GENV[Key] =
                Data


            pcall(function()
                TeleportService
                    :SetTeleportSetting(
                        Key,
                        Data
                    )
            end)


            if type(writefile) == "function" then

                if makefolder then
                    pcall(
                        makefolder,
                        "AnimeZero"
                    )
                end


                pcall(function()
                    writefile(
                        DiskFile,
                        HttpService:JSONEncode(
                            Data
                        )
                    )
                end)


                pcall(function()
                    writefile(
                        "AnimeZero/autoexecute_enabled.txt",
                        Settings.AutoExecuteOnTeleport
                            and "1"
                            or "0"
                    )
                end)
            end


            return Data
        end

end)()


--//============================================================
--// AUTO RECONNECT V2
--//
--// More defensive mobile reconnect flow:
--// - watches GuiService + Roblox disconnect prompt
--// - detects long iOS/Delta resume gaps and immediately rescans prompts
--// - de-duplicates repeated disconnect signals
--// - retries the SAME server twice for ordinary network drops
--// - skips a dead/shutdown server and goes straight to lobby
--// - uses progressive retry delays instead of hammering teleports
--// - watches LocalPlayer.OnTeleport + TeleportInitFailed
--// - queues the current script only once per reconnect cycle
--// - exposes a manual reconnect hook for the Settings tab
--//============================================================

;(function()

    if type(GENV.__AZ_RECONNECT_RUNTIME) == "table" then
        GENV.__AZ_RECONNECT_RUNTIME.Active = false

        if type(GENV.__AZ_RECONNECT_RUNTIME.Connections) == "table" then
            for _, Connection in pairs(
                GENV.__AZ_RECONNECT_RUNTIME.Connections
            ) do
                if typeof(Connection) == "RBXScriptConnection" then
                    pcall(function()
                        Connection:Disconnect()
                    end)
                end
            end
        end
    end


    local PlayersService =
        game:GetService("Players")

    local TeleportService =
        game:GetService("TeleportService")

    local GuiService =
        game:GetService("GuiService")

    local CoreGui =
        game:GetService("CoreGui")

    local LocalPlayer =
        PlayersService.LocalPlayer


    local Runtime = {
        Active = true,
        Busy = false,
        State = "Idle",
        LastReason = "",
        LastTriggerAt = 0,
        Cycle = 0,
        SameServerAttempts = 0,
        MaxSameServerAttempts = 2,
        QueuePrepared = false,
        Persisted = false,
        FallbackStarted = false,
        TeleportStarted = false,
        StartedAt = 0,
        Connections = {},
    }

    GENV.__AZ_RECONNECT_RUNTIME = Runtime


    -- Anime Zero lobby. If the dungeon/raid instance died, this is the safest
    -- place to recover because saved Auto Join settings can start a fresh run.
    local LOBBY_PLACE_ID =
        114574503491412


    local function AddConnection(Connection)
        if typeof(Connection) == "RBXScriptConnection" then
            table.insert(Runtime.Connections, Connection)
        end

        return Connection
    end


    local function SetState(State)
        Runtime.State = tostring(State or "Unknown")
    end


    local function PersistBeforeReconnect()

        if Runtime.Persisted then
            return
        end

        Runtime.Persisted = true

        for _, FunctionName in ipairs({
            "PersistInterfaceSettings",
            "PersistWebhookSettings",
            "PersistDungeonAutomation",
            "PersistFarmSettings",
            "PersistLobbyPreferences",
            "PersistEndActionSettings",
        }) do

            local Callback =
                Settings[FunctionName]

            if type(Callback) == "function" then
                pcall(Callback)
            end
        end
    end


    local function QueueCurrentScript()

        if Runtime.QueuePrepared then
            return true
        end

        local Queue =
            queue_on_teleport
            or queueonteleport

        if type(Queue) ~= "function"
            or type(readfile) ~= "function"
            or type(isfile) ~= "function"
            or not isfile("AnimeZero/AnimeZero_AutoExec.lua")
        then
            return false
        end

        local Queued = [[
task.wait(1)
local source = "AnimeZero/AnimeZero_AutoExec.lua"
if readfile and isfile and isfile(source) then
    local code = readfile(source)
    if code and code ~= "" then
        local fn = loadstring(code)
        if fn then fn() end
    end
end
]]

        local Success =
            pcall(Queue, Queued)

        if Success then
            Runtime.QueuePrepared = true
        end

        return Success
    end


    local function NormalizeReason(Message)
        return string.lower(
            tostring(Message or "")
        )
    end


    local function IsBlockedReason(Message)

        local Lower =
            NormalizeReason(Message)

        for _, Phrase in ipairs({
            "banned",
            "moderation",
            "moderated",
            "kicked by",
            "you have been kicked",
            "another device",
            "same account launched",
            "same account",
            "error code: 267",
            "error code 267",
            "error code: 268",
            "error code 268",
            "error code: 273",
            "error code 273",
        }) do
            if string.find(Lower, Phrase, 1, true) then
                return true
            end
        end

        return false
    end


    local function IsDeadServerReason(Message)

        local Lower =
            NormalizeReason(Message)

        for _, Phrase in ipairs({
            "server shut down",
            "server shutdown",
            "server has shut down",
            "server is shutting down",
            "server no longer available",
            "reserved server",
        }) do
            if string.find(Lower, Phrase, 1, true) then
                return true
            end
        end

        return false
    end


    local function IsDisconnectReason(Message)

        local Lower =
            NormalizeReason(Message)

        if Lower == ""
            or IsBlockedReason(Lower)
        then
            return false
        end

        for _, Phrase in ipairs({
            "disconnected",
            "connection",
            "error code",
            "please check your internet",
            "server shut down",
            "server shutdown",
            "lost connection",
            "failed to connect",
            "teleport failed",
            "timed out",
            "timeout",
        }) do
            if string.find(Lower, Phrase, 1, true) then
                return true
            end
        end

        return false
    end


    local function ReconnectDelayForAttempt(Attempt)

        local Base =
            math.clamp(
                tonumber(Settings.ReconnectDelay) or 5,
                2,
                30
            )

        -- First attempt respects the UI value. Later attempts back off a little
        -- so poor mobile data does not spam Roblox's teleport service.
        return math.clamp(
            Base + math.max(0, Attempt - 1) * 3,
            2,
            30
        )
    end


    local BeginSameServerAttempt
    local FallbackToLobby


    FallbackToLobby = function(Cycle, Reason, Manual)

        if not Runtime.Active
            or Runtime.Cycle ~= Cycle
            or Runtime.FallbackStarted
            or (not Manual and not Settings.AutoReconnect)
            or not LocalPlayer
        then
            return
        end

        Runtime.FallbackStarted = true
        Runtime.Busy = true
        Runtime.TeleportStarted = false
        SetState("LobbyFallback")

        print(
            "[Anime Zero][Reconnect] Falling back to lobby | reason:",
            tostring(Reason or Runtime.LastReason)
        )

        PersistBeforeReconnect()
        QueueCurrentScript()

        local Started =
            pcall(function()
                TeleportService:Teleport(
                    LOBBY_PLACE_ID,
                    LocalPlayer
                )
            end)

        if not Started then
            Runtime.FallbackStarted = false
            SetState("LobbyRetryWait")

            task.delay(5, function()
                if Runtime.Active
                    and Runtime.Cycle == Cycle
                    and Runtime.Busy
                then
                    FallbackToLobby(
                        Cycle,
                        "Lobby teleport call failed",
                        Manual
                    )
                end
            end)

            return
        end

        -- If the call was accepted but the client never transitions, retry the
        -- lobby request. This is common after a long mobile network outage.
        task.delay(15, function()
            if Runtime.Active
                and Runtime.Cycle == Cycle
                and Runtime.Busy
                and not Runtime.TeleportStarted
            then
                Runtime.FallbackStarted = false
                SetState("LobbyTimeout")

                FallbackToLobby(
                    Cycle,
                    "Lobby teleport timeout",
                    Manual
                )
            end
        end)
    end


    BeginSameServerAttempt = function(Cycle, Reason, Manual)

        if not Runtime.Active
            or Runtime.Cycle ~= Cycle
            or (not Manual and not Settings.AutoReconnect)
            or not LocalPlayer
        then
            return
        end

        if Runtime.SameServerAttempts
            >= Runtime.MaxSameServerAttempts
        then
            FallbackToLobby(
                Cycle,
                "Same-server retries exhausted",
                Manual
            )
            return
        end

        if not game.JobId
            or game.JobId == ""
        then
            FallbackToLobby(
                Cycle,
                "No current server id",
                Manual
            )
            return
        end

        Runtime.SameServerAttempts =
            Runtime.SameServerAttempts + 1

        local Attempt =
            Runtime.SameServerAttempts

        local Delay =
            ReconnectDelayForAttempt(Attempt)

        SetState(
            "SameServerWait"
            .. tostring(Attempt)
        )

        print(
            "[Anime Zero][Reconnect] Same-server attempt",
            Attempt,
            "of",
            Runtime.MaxSameServerAttempts,
            "in",
            Delay,
            "seconds"
        )

        task.delay(Delay, function()

            if not Runtime.Active
                or Runtime.Cycle ~= Cycle
                or (not Manual and not Settings.AutoReconnect)
            then
                return
            end

            Runtime.TeleportStarted = false
            SetState(
                "SameServerAttempt"
                .. tostring(Attempt)
            )

            PersistBeforeReconnect()
            QueueCurrentScript()

            local CallSucceeded =
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(
                        game.PlaceId,
                        game.JobId,
                        LocalPlayer
                    )
                end)

            if CallSucceeded then
                print(
                    "[Anime Zero][Reconnect] Rejoining current server | attempt",
                    Attempt
                )
            else
                warn(
                    "[Anime Zero][Reconnect] Same-server teleport call failed | attempt",
                    Attempt
                )
            end

            -- TeleportInitFailed usually fires quickly, but some mobile
            -- failures simply stall. Treat no transition after 12s as failed.
            task.delay(12, function()

                if not Runtime.Active
                    or Runtime.Cycle ~= Cycle
                    or not Runtime.Busy
                    or Runtime.TeleportStarted
                then
                    return
                end

                if Runtime.SameServerAttempts
                    < Runtime.MaxSameServerAttempts
                then
                    BeginSameServerAttempt(
                        Cycle,
                        "Same-server attempt timed out",
                        Manual
                    )
                else
                    FallbackToLobby(
                        Cycle,
                        "Same-server timeout",
                        Manual
                    )
                end
            end)
        end)
    end


    local function StartReconnect(Reason, Manual)

        if not Runtime.Active
            or not LocalPlayer
            or (not Manual and not Settings.AutoReconnect)
        then
            return
        end

        if IsBlockedReason(Reason) then
            warn(
                "[Anime Zero][Reconnect] Not reconnecting from account/moderation kick."
            )
            return
        end

        local Now =
            os.clock()

        -- GuiService + ErrorPrompt often report the same disconnect within the
        -- same second. Only one reconnect cycle should be created.
        if Runtime.Busy
            or (
                not Manual
                and Now - Runtime.LastTriggerAt < 2
            )
        then
            return
        end

        Runtime.LastTriggerAt = Now
        Runtime.LastReason =
            tostring(Reason or "Disconnected")
        Runtime.Busy = true
        Runtime.FallbackStarted = false
        Runtime.TeleportStarted = false
        Runtime.SameServerAttempts = 0
        Runtime.QueuePrepared = false
        Runtime.Persisted = false
        Runtime.StartedAt = Now
        Runtime.Cycle = Runtime.Cycle + 1

        local Cycle =
            Runtime.Cycle

        print(
            "[Anime Zero][Reconnect] Recovery started | reason:",
            Runtime.LastReason
        )

        -- A server-shutdown message means the old JobId is useless. Going
        -- straight to lobby is faster and avoids two guaranteed failures.
        if IsDeadServerReason(Runtime.LastReason) then
            SetState("DeadServer")

            FallbackToLobby(
                Cycle,
                Runtime.LastReason,
                Manual
            )
        else
            BeginSameServerAttempt(
                Cycle,
                Runtime.LastReason,
                Manual
            )
        end
    end


    local function ReadPromptText(Prompt)

        if not Prompt then
            return ""
        end

        local Parts = {}

        pcall(function()
            for _, Item in ipairs(
                Prompt:GetDescendants()
            ) do
                if Item:IsA("TextLabel")
                    or Item:IsA("TextButton")
                then
                    local Value =
                        tostring(Item.Text or "")

                    if Value ~= "" then
                        table.insert(Parts, Value)
                    end
                end
            end
        end)

        return table.concat(Parts, " ")
    end


    local function CheckPrompt(Prompt)

        if not Runtime.Active
            or not Settings.AutoReconnect
            or not Prompt
        then
            return
        end

        task.delay(0.15, function()

            if not Runtime.Active
                or not Settings.AutoReconnect
                or not Prompt.Parent
            then
                return
            end

            local Message =
                ReadPromptText(Prompt)

            if IsBlockedReason(Message) then
                return
            end

            if Prompt.Name == "ErrorPrompt"
                or IsDisconnectReason(Message)
            then
                StartReconnect(
                    Message ~= ""
                        and Message
                        or "Roblox ErrorPrompt",
                    false
                )
            end
        end)
    end


    -- Expose lightweight status/manual controls for the Settings tab.
    GENV.__AZ_RECONNECT_NOW =
        function()
            StartReconnect(
                "Manual reconnect requested",
                true
            )
        end

    GENV.__AZ_RECONNECT_GET_STATUS =
        function()
            return {
                active = Runtime.Active,
                busy = Runtime.Busy,
                state = Runtime.State,
                attempts = Runtime.SameServerAttempts,
                reason = Runtime.LastReason,
            }
        end


    pcall(function()
        AddConnection(
            GuiService.ErrorMessageChanged
                :Connect(function(Message)
                    if IsDisconnectReason(Message) then
                        StartReconnect(
                            Message,
                            false
                        )
                    end
                end)
        )
    end)


    pcall(function()
        AddConnection(
            LocalPlayer.OnTeleport
                :Connect(function(State)

                    local Name =
                        tostring(State)

                    if string.find(
                        Name,
                        "Started",
                        1,
                        true
                    )
                        or string.find(
                            Name,
                            "InProgress",
                            1,
                            true
                        )
                    then
                        Runtime.TeleportStarted = true
                        SetState("Teleporting")

                    elseif string.find(
                        Name,
                        "Failed",
                        1,
                        true
                    )
                        and Runtime.Busy
                    then
                        Runtime.TeleportStarted = false
                    end
                end)
        )
    end)


    pcall(function()
        AddConnection(
            TeleportService.TeleportInitFailed
                :Connect(function(
                    Player,
                    _,
                    ErrorMessage
                )

                    if Player ~= LocalPlayer
                        or not Runtime.Busy
                    then
                        return
                    end

                    Runtime.TeleportStarted = false

                    warn(
                        "[Anime Zero][Reconnect] TeleportInitFailed:",
                        tostring(ErrorMessage or "unknown")
                    )

                    local Cycle =
                        Runtime.Cycle

                    if Runtime.FallbackStarted then
                        Runtime.FallbackStarted = false

                        task.delay(4, function()
                            FallbackToLobby(
                                Cycle,
                                ErrorMessage,
                                true
                            )
                        end)

                    elseif Runtime.SameServerAttempts
                        < Runtime.MaxSameServerAttempts
                    then
                        BeginSameServerAttempt(
                            Cycle,
                            ErrorMessage,
                            true
                        )
                    else
                        FallbackToLobby(
                            Cycle,
                            ErrorMessage,
                            true
                        )
                    end
                end)
        )
    end)


    task.spawn(function()

        local PromptOverlay = nil

        pcall(function()
            local PromptGui =
                CoreGui:WaitForChild(
                    "RobloxPromptGui",
                    15
                )

            PromptOverlay =
                PromptGui
                and PromptGui:FindFirstChild(
                    "promptOverlay"
                )
        end)

        if PromptOverlay then

            AddConnection(
                PromptOverlay.ChildAdded
                    :Connect(CheckPrompt)
            )

            for _, Child in ipairs(
                PromptOverlay:GetChildren()
            ) do
                CheckPrompt(Child)
            end
        end


        local LastLoopAt =
            os.clock()

        while Runtime.Active do

            task.wait(2)

            local Now =
                os.clock()

            local ResumeGap =
                Now - LastLoopAt

            LastLoopAt = Now

            if Settings.AutoReconnect
                and not Runtime.Busy
            then

                -- On iOS, Roblox/Delta may be suspended for a while. When the
                -- script resumes, do an immediate full prompt/error rescan.
                if ResumeGap >= 12 then
                    print(
                        "[Anime Zero][Reconnect] Mobile resume detected | gap:",
                        math.floor(ResumeGap),
                        "seconds"
                    )
                end

                if PromptOverlay then
                    for _, Child in ipairs(
                        PromptOverlay:GetChildren()
                    ) do
                        CheckPrompt(Child)
                    end
                end

                pcall(function()
                    local Message =
                        GuiService:GetErrorMessage()

                    if IsDisconnectReason(Message) then
                        StartReconnect(
                            Message,
                            false
                        )
                    end
                end)
            end

            -- Safety valve: if Roblox never produces a teleport transition or
            -- failure event, don't leave the reconnect runtime permanently busy.
            if Runtime.Busy
                and not Runtime.TeleportStarted
                and Runtime.StartedAt > 0
                and Now - Runtime.StartedAt > 75
            then
                local Cycle = Runtime.Cycle

                Runtime.FallbackStarted = false

                FallbackToLobby(
                    Cycle,
                    "Reconnect cycle watchdog timeout",
                    true
                )
            end
        end
    end)

end)()


