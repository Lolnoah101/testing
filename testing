--//============================================================
--// LEGIT FARM METHOD: game-native Humanoid walking + pathfinding.
--// Update (2026-10-15): The game's StarterCharacterScripts.Animate is empty.
--// Its custom movementController detects Humanoid.MoveDirection to play run.
--// Drive Humanoid:Move AFTER Roblox's default controls each render frame,
--// instead of intermittent MoveTo calls that can be overwritten by controls.
--// A failed path must NEVER turn into blind straight-line movement into walls.
--//============================================================
;(function()
    local RunService = game:GetService("RunService")
    local PathfindingService = game:GetService("PathfindingService")
    local PlayersService = game:GetService("Players")
    local BindName = "AnimeZeroLegitMovement"
    pcall(function() RunService:UnbindFromRenderStep(BindName) end)

    local Nav = {
        State = "Idle", Owner = nil, Target = nil, Waypoints = nil,
        Index = 1, Token = 0, Computing = false, LastPathAt = 0,
        NextPathAt = 0, LastProgressAt = 0, LastProgressPos = nil,
        LastError = nil, Character = nil, Human = nil,
        DrivePoint = nil, DriveJump = false, LastRequestAt = 0,
        PathBlockConnection = nil, Path = nil, PathsComputed = 0,
        PathFailures = 0, StuckRepaths = 0, UsedAlternateGoal = false,
        -- Fate entry uses a short-hop + early-repath assist on stair lips.
        StairAssist = false, LastStairJumpAt = 0, StairAssistJumps = 0,
    }

    local function ClearPath()
        if Nav.PathBlockConnection then
            pcall(function() Nav.PathBlockConnection:Disconnect() end)
            Nav.PathBlockConnection = nil
        end
        Nav.Path = nil
        Nav.Waypoints = nil
        Nav.Index = 1
    end

    local function StopWalking()
        Nav.DrivePoint = nil
        Nav.DriveJump = false
        local Human = Nav.Human
        if Human and Human.Parent then
            pcall(function() Human:Move(Vector3.zero, false) end)
        end
    end

    function Nav.Reset(Reason)
        Nav.Token = Nav.Token + 1
        ClearPath()
        StopWalking()
        Nav.Target = nil
        Nav.Owner = nil
        Nav.Computing = false
        Nav.LastProgressPos = nil
        Nav.LastProgressAt = os.clock()
        Nav.State = tostring(Reason or "Idle")
        Nav.LastError = nil
        Nav.StairAssist = false
        Nav.LastStairJumpAt = 0
    end

    -- PlayerModule can overwrite MoveTo's MoveDirection every render frame.
    -- Feed walking direction after the controls, allowing the game to play
    -- its OWN character run/idle animations, not an injected animation ID.
    RunService:BindToRenderStep(BindName,
        Enum.RenderPriority.Character.Value + 1,
        function()
            local Human = Nav.Human
            local Char = Nav.Character
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")
            if Settings.FarmMethod ~= "Legit"
                or not Nav.DrivePoint
                or os.clock() - Nav.LastRequestAt > 0.80
                or not Human or not Human.Parent or Human.Health <= 0
                or not Root or not Root.Parent
            then
                return
            end
            if Human.WalkSpeed <= 0 then
                -- Respect stun, blocking and skill movement locks.
                Human:Move(Vector3.zero, false)
                return
            end
            local Delta = Nav.DrivePoint - Root.Position
            local Flat = Vector3.new(Delta.X, 0, Delta.Z)
            local Now = os.clock()
            local StairLip = Nav.StairAssist and Delta.Y > 1.7
                and Flat.Magnitude < 7

            -- Pathfinding sometimes places a waypoint directly above a
            -- staircase lip. Pure X/Z steering becomes zero there. Look
            -- forward to the next path point instead of freezing in place.
            if StairLip and Flat.Magnitude < 1.15 and Nav.Waypoints then
                local Next = Nav.Waypoints[Nav.Index + 1]
                if Next then
                    local Ahead = Next.Position - Root.Position
                    local Forward = Vector3.new(Ahead.X, 0, Ahead.Z)
                    if Forward.Magnitude >= 1.0 then
                        Flat = Forward
                    end
                end
            end

            if Flat.Magnitude >= 0.8 then
                Human:Move(Flat.Unit, false)
            else
                Human:Move(Vector3.zero, false)
            end

            -- Only help with a jump after a genuine stair stall. Keep normal
            -- jumps for Roblox's PathWaypointAction.Jump as before.
            local StalledAtLip = Nav.StairAssist
                and Now - (Nav.LastProgressAt or Now) >= 0.85
                and (StairLip or Flat.Magnitude < 8.0)
            if (Nav.DriveJump or StalledAtLip)
                and Human.FloorMaterial ~= Enum.Material.Air
                and Now - Nav.LastStairJumpAt >= 0.85
            then
                Human.Jump = true
                Nav.LastStairJumpAt = Now
                if StalledAtLip then
                    Nav.StairAssistJumps = Nav.StairAssistJumps + 1
                end
            end
        end
    )

    local function ClearRayToGoal(Root, Goal, Char)
        local Difference = Goal - Root.Position
        local Flat = Vector3.new(Difference.X, 0, Difference.Z)
        if Flat.Magnitude < 2 then return true end
        local Parameters = RaycastParams.new()
        Parameters.FilterType = Enum.RaycastFilterType.Exclude
        local Ignore = {Char}
        local EnemyFolder = workspace:FindFirstChild("enemies")
        if EnemyFolder then table.insert(Ignore, EnemyFolder) end
        Parameters.FilterDescendantsInstances = Ignore
        pcall(function() Parameters.RespectCanCollide = true end)
        -- Check at the character's waist height, not against the floor.
        local Hit = workspace:Raycast(Root.Position, Flat.Unit * math.max(Flat.Magnitude - 1, 0), Parameters)
        return Hit == nil
    end

    local function GroundTarget(Pos, Root, Human, Char)
        local Parameters = RaycastParams.new()
        Parameters.FilterType = Enum.RaycastFilterType.Exclude
        local Ignore = { Char }
        local EnemyFolder = workspace:FindFirstChild("enemies")
        if EnemyFolder then table.insert(Ignore, EnemyFolder) end
        Parameters.FilterDescendantsInstances = Ignore
        local Ray = workspace:Raycast(Pos + Vector3.new(0, 16, 0),
            Vector3.new(0, -75, 0), Parameters)
        if Ray and math.abs(Ray.Position.Y - Root.Position.Y) < 24 then
            return Vector3.new(Pos.X, Ray.Position.Y + Human.HipHeight + Root.Size.Y * 0.5, Pos.Z)
        end
        return Pos
    end

    local function ComputePath(Start, Goal, CandidateRoot, Human, Char, StairPath)
        -- Try the exact goal first; only sample nearby grounded positions if
        -- the target happens to be inside a solid rubble/building collision.
        local FromTarget = Start - Goal
        local Flat = Vector3.new(FromTarget.X, 0, FromTarget.Z)
        local Direction = Flat.Magnitude > 0.1 and Flat.Unit or Vector3.zAxis
        local Side = Vector3.new(-Direction.Z, 0, Direction.X)
        local Candidates = {
            Goal,
            Goal + Direction * 4,
            Goal + Side * 4,
            Goal - Side * 4,
            Goal + Direction * 8,
        }
        for i, Candidate in ipairs(Candidates) do
            if i > 1 then
                Candidate = GroundTarget(Candidate, CandidateRoot, Human, Char)
            end
            for _, AgentRadius in ipairs({2, 1.5}) do
                local OK, Result = pcall(function()
                    local Path = PathfindingService:CreatePath({
                        AgentRadius = AgentRadius,
                        AgentHeight = 5,
                        AgentCanJump = true,
                        AgentCanClimb = true,
                        -- Denser waypoints prevent cutting across the
                        -- stair-edge collision near the Fate arena.
                        WaypointSpacing = StairPath and 2 or 4,
                    })
                    Path:ComputeAsync(Start, Candidate)
                    if Path.Status == Enum.PathStatus.Success then
                        local Points = Path:GetWaypoints()
                        if #Points >= 2 then return { Path, Points, Candidate } end
                    end
                    return nil
                end)
                if OK and Result then return Result end
            end
        end
        return nil
    end

    function Nav.Go(Target, Radius, Owner)
        if Settings.FarmMethod ~= "Legit" then return false end
        local Player = PlayersService.LocalPlayer
        local Char = Player and Player.Character
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")
        local Human = Char and Char:FindFirstChildOfClass("Humanoid")
        if not Root or not Human or Human.Health <= 0 then
            Nav.State = "Waiting for character"
            StopWalking()
            return false
        end
        if Char ~= Nav.Character then
            Nav.Reset("Character changed")
            Nav.Character = Char
        end
        Nav.Human = Human
        Nav.LastRequestAt = os.clock()
        -- Switching from Above/Below previously disabled AutoRotate.
        -- Restore the farm's old hold, but don't override ability-specific
        -- rotation locks applied by the game's own character controller.
        local Ext = GENV.__AZ_FARM_EXT
        if Ext.HorizontalHoldActive then
            if Ext.HorizontalAutoRotateWas ~= nil then
                Human.AutoRotate = Ext.HorizontalAutoRotateWas
            end
            Ext.HorizontalHoldActive = false
            Ext.HorizontalAutoRotateWas = nil
        end
        local Pos = typeof(Target) == "CFrame" and Target.Position or Target
        if typeof(Pos) ~= "Vector3" then return false end
        Radius = math.clamp(tonumber(Radius) or 3, 1.5, 12)
        Owner = tostring(Owner or "Farm")
        Nav.StairAssist = workspace:GetAttribute("Mode") == "fateraid"
            or workspace:GetAttribute("Mode") == "floodescape"
            and string.sub(Owner, 1, 5) == "Fate "
        Pos = GroundTarget(Pos, Root, Human, Char)
        local Distance = (Root.Position - Pos).Magnitude
        if Distance <= Radius then
            -- Reaching a new owner must also cancel any previous movement.
            -- Otherwise a stale Enemy path can pull us away from rubble/AREA.
            if Nav.Owner ~= nil then
                Nav.Token = Nav.Token + 1
                ClearPath()
                StopWalking()
                Nav.Computing = false
                Nav.Owner = Owner
                Nav.Target = Pos
                Nav.State = "Arrived " .. Owner
            end
            return true
        end

        local Now = os.clock()
        local Changed = Nav.Owner ~= Owner or Nav.Target == nil
            or (Nav.Target - Pos).Magnitude > 5
        if Changed then
            Nav.Token = Nav.Token + 1
            ClearPath()
            StopWalking()
            Nav.Computing = false
            Nav.Owner = Owner
            Nav.Target = Pos
            Nav.LastProgressPos = Root.Position
            Nav.LastProgressAt = Now
            Nav.NextPathAt = 0
            Nav.State = "Finding path to " .. Owner
        end

        if Nav.LastProgressPos == nil then
            Nav.LastProgressPos = Root.Position
            Nav.LastProgressAt = Now
        elseif (Root.Position - Nav.LastProgressPos).Magnitude
                > (Nav.StairAssist and 0.95 or 2.0) then
            Nav.LastProgressPos = Root.Position
            Nav.LastProgressAt = Now
        elseif Nav.DrivePoint and Now - Nav.LastProgressAt
                > (Nav.StairAssist and 1.8 or 2.5) then
            -- Navigation stalled. Throw away this path and find another.
            Nav.Token = Nav.Token + 1
            ClearPath()
            StopWalking()
            Nav.Computing = false
            Nav.StuckRepaths = Nav.StuckRepaths + 1
            Nav.LastProgressAt = Now
            Nav.NextPathAt = Now + (Nav.StairAssist and 0.12 or 0.3)
            Nav.State = Nav.StairAssist
                and "Stairs stalled; recomputing path" or "Blocked; rerouting around obstacle"
        end

        if not Nav.Computing and not Nav.Waypoints
            and Now >= (Nav.NextPathAt or 0)
        then
            Nav.Computing = true
            Nav.LastPathAt = Now
            Nav.State = "Calculating path to " .. Owner
            local Token = Nav.Token
            local From = Root.Position
            local To = Pos
            local StairPath = Nav.StairAssist
            task.spawn(function()
                local PathResult = ComputePath(From, To, Root, Human, Char, StairPath)
                if Nav.Token ~= Token then return end
                Nav.Computing = false
                Nav.PathsComputed = Nav.PathsComputed + 1
                if PathResult then
                    ClearPath()
                    local Path, Waypoints, Chosen = table.unpack(PathResult)
                    Nav.Path = Path
                    Nav.Waypoints = Waypoints
                    Nav.Index = 1
                    Nav.UsedAlternateGoal = (Chosen - To).Magnitude > 2
                    Nav.LastError = nil
                    Nav.State = "Following path: " .. Owner
                    Nav.LastProgressPos = Root.Position
                    Nav.LastProgressAt = os.clock()
                    Nav.PathBlockConnection = Path.Blocked:Connect(function(BlockedIndex)
                        if Nav.Path == Path and BlockedIndex >= Nav.Index then
                            Nav.Token = Nav.Token + 1
                            ClearPath()
                            StopWalking()
                            Nav.NextPathAt = os.clock() + 0.25
                            Nav.State = "Path blocked; finding alternate route"
                        end
                    end)
                else
                    ClearPath()
                    StopWalking()
                    Nav.PathFailures = Nav.PathFailures + 1
                    Nav.NextPathAt = os.clock() + 1.5
                    Nav.LastError = "No walkable path to target"
                    Nav.State = "No valid route: " .. Owner
                    -- Only allow direct walking when there is actually a
                    -- clear line of sight. Never charge into a building.
                    if ClearRayToGoal(Root, Pos, Char) then
                        Nav.DrivePoint = Pos
                        Nav.State = "Clear direct walk: " .. Owner
                    end
                end
            end)
        end

        local Waypoints = Nav.Waypoints
        if Waypoints and #Waypoints > 0 then
            while Nav.Index < #Waypoints do
                local Point = Waypoints[Nav.Index].Position
                local Delta = Point - Root.Position
                -- A waypoint directly above the player is NOT reached:
                -- the old X/Z-only check discarded it on staircases.
                if Vector3.new(Delta.X, 0, Delta.Z).Magnitude > 2.2
                    or (Nav.StairAssist and math.abs(Delta.Y) > 3.0)
                then
                    break
                end
                Nav.Index = Nav.Index + 1
            end
            local Point = Waypoints[Nav.Index]
            if Point then
                Nav.DrivePoint = Point.Position
                Nav.DriveJump = Point.Action == Enum.PathWaypointAction.Jump
            end
        end
        return false
    end

    GENV.__AZ_LEGIT_NAV = Nav
    GENV.__AZ_LEGIT_STATUS = function()
        local H = Nav.Human
        local R = {
            method = Settings.FarmMethod, state = Nav.State,
            owner = Nav.Owner, target = Nav.Target,
            waypoint = Nav.Index, waypointCount = Nav.Waypoints and #Nav.Waypoints or 0,
            movingToward = Nav.DrivePoint,
            computing = Nav.Computing, lastError = Nav.LastError,
            walkSpeed = H and H.WalkSpeed or nil,
