        and Prompt.Enabled
end

local function BoxWaitingForDelivery()
    local Prompt =
        GetBoxTakePrompt()

    return
        Prompt
        and Prompt.Parent
        and not Prompt.Enabled
end

local function PickupBox()
    local Part =
        GetBoxTakePart()

    local Prompt =
        GetBoxTakePrompt()

    if not Part
        or not Prompt
    then
        return false
    end

    if not Prompt.Enabled then
        return true
    end

    local Target =
        GetTargetCFrame(
            Part
        )

    if not Target then
        return false
    end

    print(
        "[Box] Going to pickup"
    )

    local Reached =
        MoveToJobTarget(
            Target,

            function()
                return Settings.AutoBox
            end
        )

    if not Reached
        or not Settings.AutoBox
    then
        return false
    end

    local LastTrigger = 0

    while Settings.AutoBox
        and Prompt.Parent
        and Prompt.Enabled
    do
        if
            os.clock()
            - LastTrigger
            >= Settings.BoxRetryDelay
        then
            TriggerPrompt(
                Prompt
            )

            LastTrigger =
                os.clock()
        end

        task.wait(0.05)
    end

    return BoxWaitingForDelivery()
end

local function DeliverBox()
    local Part =
        GetBoxDeliverPart()

    local Prompt =
        GetBoxDeliverPrompt()

    if not Part
        or not Prompt
    then
        return false
    end

    local Target =
        GetTargetCFrame(
            Part
        )

    if not Target then
        return false
    end

    print(
        "[Box] Going to delivery"
    )

    local Reached =
        MoveToJobTarget(
            Target,

            function()
                return Settings.AutoBox
            end
        )

    if not Reached
        or not Settings.AutoBox
    then
        return false
    end

    local LastTrigger = 0

    while Settings.AutoBox
        and BoxWaitingForDelivery()
    do
        if Prompt.Parent
            and Prompt.Enabled
            and os.clock()
                - LastTrigger
                >= Settings.BoxRetryDelay
        then
            TriggerPrompt(
                Prompt
            )

            LastTrigger =
                os.clock()
        end

        task.wait(0.05)
    end

    return BoxReadyForPickup()
end

local function StartAutoBox()
    if BoxThread then
        return
    end

    BoxThread =
        task.spawn(function()

            print(
                "[Box] Started"
            )

            while Settings.AutoBox do
                local TakePrompt =
                    GetBoxTakePrompt()

                local DeliverPrompt =
                    GetBoxDeliverPrompt()

                if not TakePrompt
                    or not DeliverPrompt
                then
                    task.wait(1)
                    continue
                end

                if BoxReadyForPickup() then
                    PickupBox()

                elseif BoxWaitingForDelivery() then
                    DeliverBox()

                else
                    task.wait(0.25)
                end

                task.wait(0.1)
            end

            BoxThread = nil

            print(
                "[Box] Stopped"
            )
        end)
end

