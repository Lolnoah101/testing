        for _, node in ipairs(prompt:GetDescendants()) do
            if node:IsA("TextLabel") or node:IsA("TextButton") then
                local message = tostring(node.Text or "")
                if message ~= "" then parts[#parts + 1] = message end
            end
        end
    end)
    return ok and table.concat(parts, " ") or ""
end

local function inspectPrompt(prompt)
    if not permitted(false) or not prompt or not prompt.Parent then return end
