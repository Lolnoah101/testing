-- Published PlayerDataController events are a faster and lighter source
-- than aggressively rescanning inventory each Heartbeat. A short periodic
-- fallback remains in place when a state change has no event.
local function watchData(path, jobs)
    local ok, signal = pcall(function()
        return PlayerDataController.onDataChanged({path}, function()
            if alive then Scheduler.pokeMany(jobs) end
        end)
    end)
    if ok and signal then Scheduler.track(signal) end
end
