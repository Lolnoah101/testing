        if s.noclipActive then restoreCollisions() end
        return
    end
    s.noclipActive = true
    for _, instance in ipairs(char:GetDescendants()) do
        if instance:IsA("BasePart") then
            if s.collisions[instance] == nil then s.collisions[instance] = instance.CanCollide end
            if instance.CanCollide then instance.CanCollide = false end
        end
    end
end
local function ensureLift(root)
    if s.lift and s.lift.Parent == root then return end
    removeLift()
    -- Y-only stabilization prevents falling between CFrame tween frames.
    local body = Instance.new("BodyVelocity")
    body.Name = "HollowMoonBelowVerticalHold"
    body.Velocity = Vector3.zero
    body.P = 12000
    body.MaxForce = Vector3.new(0, 1e8, 0)
    body.Parent = root
    s.lift = body
end

-- Floor samples are restricted to arena geometry whenever that model exists.
-- This prevents airborne NPCs, crates and temporary FX from becoming our Y reference.
local function surfaceAt(x, z, startingY)
    local arena = workspace:FindFirstChild("Arena")
    local params = RaycastParams.new()
    params.FilterType = arena and Enum.RaycastFilterType.Include or Enum.RaycastFilterType.Exclude
    if arena then
        params.FilterDescendantsInstances = {arena}
    else
        local omit = {player.Character}
        local enemies = workspace:FindFirstChild("ActiveEnemies")
        if enemies then table.insert(omit, enemies) end
        if s.platform then table.insert(omit, s.platform) end
        if s.focus then table.insert(omit, s.focus) end
        params.FilterDescendantsInstances = omit
    end
    params.IgnoreWater = true
    pcall(function() params.RespectCanCollide = true end)
    local ray = workspace:Raycast(Vector3.new(x, startingY, z), Vector3.new(0, -220, 0), params)
    if ray and ray.Normal.Y > 0.72 then return ray end
    return nil
end
local function calibrateFloor(root)
    local hit = surfaceAt(root.Position.X, root.Position.Z, root.Position.Y + 14)
    if hit then return hit.Position.Y end
    -- The fallback is approximate; prefer a real raycast floor in the arena.
    return root.Position.Y - 3
end
local function undergroundY()
    return (s.floorY or 0) - s.depth
end

-- Prevent built-in movement controls from turning the character away from
-- the target while Auto Farm owns the avatar's position. Restore its previous
-- value exactly when the farm stops or the character changes.
local function restoreFarmFacing()
    if s.facingHumanoid and s.facingHumanoid.Parent then
        pcall(function()
            s.facingHumanoid.AutoRotate = s.facingOriginalAutoRotate
        end)
    end
    s.facingHumanoid = nil
    s.facingOriginalAutoRotate = nil
    s.facingGoal = nil
end
local function enableFarmFacing(humanoid)
    if s.facingHumanoid ~= humanoid then
        restoreFarmFacing()
        s.facingHumanoid = humanoid
        s.facingOriginalAutoRotate = humanoid.AutoRotate
    end
    -- This affects Auto Farm only; Auto Attack is still fully independent.
    if humanoid.AutoRotate then humanoid.AutoRotate = false end
end

-- Look horizontally from our position toward the target's projected floor
-- position. Only yaw changes, so a jumping boss cannot tilt the avatar up.
-- Rotate at a bounded speed to avoid abrupt 180-degree snaps.
local function facingRotation(root, nextPosition)
    local goal = s.facingGoal
    if typeof(goal) ~= "Vector3" then return root.CFrame.Rotation end
    local delta = Vector3.new(goal.X - nextPosition.X, 0, goal.Z - nextPosition.Z)
    if delta.Magnitude < 0.08 then return root.CFrame.Rotation end
    local currentLook = root.CFrame.LookVector
    local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
    if flatLook.Magnitude < 0.001 then flatLook = delta.Unit end
    local currentYaw = math.atan2(flatLook.X, flatLook.Z)
    local wantedYaw = math.atan2(delta.X, delta.Z)
    local diff = math.atan2(math.sin(wantedYaw - currentYaw), math.cos(wantedYaw - currentYaw))
    local turnStep = math.rad(420) * math.clamp(s.facingFrameDt or (1 / 60), 0, 0.065)
    local nextYaw = currentYaw + math.clamp(diff, -turnStep, turnStep)
    local forward = Vector3.new(math.sin(nextYaw), 0, math.cos(nextYaw))
    return CFrame.lookAt(nextPosition, nextPosition + forward).Rotation
end
local function rootPlacement(root, x, z, y)
    local nextPosition = Vector3.new(x, y, z)
    root.CFrame = CFrame.new(nextPosition) * facingRotation(root, nextPosition)
    root.AssemblyLinearVelocity = Vector3.zero
end
local function findReturnPoint(char, humanoid, root)
    local saved = s.startPosition or root.Position
    local offsets = {
        Vector3.zero,
        Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0),
        Vector3.new(0, 0, 4), Vector3.new(0, 0, -4),
    }
    for _, basis in ipairs({root.Position, saved}) do
        for _, offset in ipairs(offsets) do
            local x, z = basis.X + offset.X, basis.Z + offset.Z
            local hit = surfaceAt(x, z, (s.floorY or saved.Y) + 20)
            if hit and (not s.floorY or math.abs(hit.Position.Y - s.floorY) < 6) then
                local above = humanoid.HipHeight + root.Size.Y * .5 + .8
                return Vector3.new(x, hit.Position.Y + above, z)
            end
        end
    end
    -- Return to the last known above-floor position if the floor ray misses.
    return saved
end

local function removeCamera()
    local camera = workspace.CurrentCamera
    if camera and s.cameraOriginal then
        pcall(function()
            camera.CameraType = s.cameraUnlocked and Enum.CameraType.Scriptable or s.cameraOriginal.cameraType
            local subject = s.cameraOriginal.subject
            if subject and subject.Parent then camera.CameraSubject = subject
            else
                local _, humanoid = characterReady()
                if humanoid then camera.CameraSubject = humanoid end
            end
        end)
    end
    s.cameraOriginal = nil
    if s.focus then s.focus:Destroy(); s.focus = nil end
    if s.outline then s.outline:Destroy(); s.outline = nil end
end
local function makeCamera(char, root)
    removeCamera()
    local camera = workspace.CurrentCamera
    if not camera then return end
    s.cameraOriginal = {cameraType = camera.CameraType, subject = camera.CameraSubject}
    local focus = Instance.new("Part")
    focus.Name = "HollowMoonArenaCameraFocus"
    focus.Size = Vector3.new(1, 1, 1)
    focus.Transparency = 1
    focus.Anchored = true
    focus.CanCollide = false
    focus.CanTouch = false
    focus.CanQuery = false
    focus.Position = Vector3.new(root.Position.X, (s.floorY or root.Position.Y) + 3, root.Position.Z)
    focus.Parent = workspace
    s.focus = focus
    -- Normal Roblox camera orbit remains available; we do not force its CFrame.
    camera.CameraType = s.cameraUnlocked and Enum.CameraType.Scriptable or Enum.CameraType.Custom
    camera.CameraSubject = focus
    -- A local outline helps show your underground avatar through the arena floor.
    local outline = Instance.new("Highlight")
    outline.Name = "HollowMoonUndergroundCharacterOutline"
    outline.Adornee = char
    outline.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    outline.FillTransparency = .94
    outline.OutlineTransparency = .08
    outline.Parent = char
    s.outline = outline
end
local function updateCamera(root, dt)
    if s.focus and s.focus.Parent and s.floorY then
        local goal = Vector3.new(root.Position.X, s.floorY + 3, root.Position.Z)
        s.focus.Position = s.focus.Position:Lerp(goal, 1 - math.exp(-dt * 9))
    end
end

-- Orbit camera with NO occlusion-based zoom/collision. The camera continues
-- to follow the character (or the arena-surface focus when Below Farm runs).
-- The camera cannot fly independently; users can rotate, pitch, and zoom it.
local CAMERA_BINDING = "HollowMoonBelowFarmNoClipOrbitV8"

local function cameraOrbitTarget()
    if s.enabled and s.focus and s.focus.Parent then
        return s.focus.Position
    end
    local _, _, root = characterReady()
    if root then return root.Position + Vector3.new(0, 2, 0) end
    local camera = workspace.CurrentCamera
    return camera and camera.Focus.Position or Vector3.zero
end

local function rotateOrbit(dx, dy)
    s.cameraOrbitYaw = s.cameraOrbitYaw - dx * .004
    s.cameraOrbitPitch = math.clamp(s.cameraOrbitPitch + dy * .004, -1.42, 1.42)
end

-- Fade ONLY local parts between the character/focus and the orbit camera.
-- This is useful if the chosen orbit moves behind a solid arena wall.
local function resetCameraFade()
    for part, previous in pairs(s.cameraFadedParts) do
        if part and part.Parent then
            pcall(function() part.LocalTransparencyModifier = previous end)
        end
        s.cameraFadedParts[part] = nil
    end
end

local function fadeCameraObstructions(focus, cameraPosition, now)
    if now < s.cameraFadeCheck then return end
    s.cameraFadeCheck = now + .12
    resetCameraFade()
    local direction = cameraPosition - focus
    if direction.Magnitude < .5 then return end
    local excluded = {}
    local character = player.Character
    if character then table.insert(excluded, character) end
    if s.focus then table.insert(excluded, s.focus) end
    if s.platform then table.insert(excluded, s.platform) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    for _ = 1, 8 do
        params.FilterDescendantsInstances = excluded
        local result = workspace:Raycast(focus, direction, params)
        if not result then break end
        local part = result.Instance
        if not part then break end
        table.insert(excluded, part)
        if part:IsA("BasePart") then
            s.cameraFadedParts[part] = part.LocalTransparencyModifier
            part.LocalTransparencyModifier = math.max(part.LocalTransparencyModifier, .82)
        end
    end
end

-- The built-in Roblox camera owns RMB input only in Custom mode. When we use
-- Scriptable to prevent wall collision, we must implement RMB capture ourselves.
local function releaseCameraMouse()
    s.cameraMouseDrag = false
    if s.cameraPriorMouseBehavior ~= nil then
        pcall(function() UserInputService.MouseBehavior = s.cameraPriorMouseBehavior end)
        s.cameraPriorMouseBehavior = nil
    end
    if s.cameraPriorMouseIcon ~= nil then
        pcall(function() UserInputService.MouseIconEnabled = s.cameraPriorMouseIcon end)
        s.cameraPriorMouseIcon = nil
    end
end

local function captureCameraMouse()
    if s.cameraMouseDrag then return end
    s.cameraMouseDrag = true
    s.cameraPriorMouseBehavior = UserInputService.MouseBehavior
    s.cameraPriorMouseIcon = UserInputService.MouseIconEnabled
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    UserInputService.MouseIconEnabled = false
end

local function renderUnlockedCamera(dt)
    if not s.cameraUnlocked then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    dt = math.clamp(dt or 0, 0, .065)
    camera.CameraType = Enum.CameraType.Scriptable

    if s.cameraMouseDrag then
        -- Cursor capture prevents the mouse stopping at the screen edges.
        -- Read mouse delta once per frame; no double rotation via InputChanged.
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCurrentPosition then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
        local delta = UserInputService:GetMouseDelta()
        if delta.Magnitude > 0 then
            rotateOrbit(delta.X, delta.Y)
        end
    end
    if s.cameraThumbstick.Magnitude > .15 then
        rotateOrbit(s.cameraThumbstick.X * dt * 270, -s.cameraThumbstick.Y * dt * 270)
    end

    local desired = cameraOrbitTarget()
    local smoothing = 1 - math.exp(-dt * 15)
    s.cameraOrbitFocus = s.cameraOrbitFocus and s.cameraOrbitFocus:Lerp(desired, smoothing) or desired
    local focus = s.cameraOrbitFocus
    local yaw, pitch = s.cameraOrbitYaw, s.cameraOrbitPitch
    local radius = s.cameraOrbitDistance
    local offset = Vector3.new(
        math.sin(yaw) * math.cos(pitch) * radius,
        math.sin(pitch) * radius,
        math.cos(yaw) * math.cos(pitch) * radius
    )
    local position = focus + offset
    -- Intentionally skip camera collision raycasts: the camera can pass through walls.
    camera.CFrame = CFrame.lookAt(position, focus)
    camera.Focus = CFrame.new(focus)
    fadeCameraObstructions(focus, position, os.clock())
end

local function cameraInputBegan(input, processed)
    if not s.cameraUnlocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        -- Roblox's default camera/other core input can mark RMB as processed.
        -- Do not discard it, except when typing into a textbox.
        if not UserInputService:GetFocusedTextBox() then
            captureCameraMouse()
        end
    elseif input.UserInputType == Enum.UserInputType.Touch and not processed and not s.cameraActiveTouch then
        s.cameraActiveTouch = input
    end
end
local function cameraInputEnded(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        releaseCameraMouse()
    elseif input == s.cameraActiveTouch then
        s.cameraActiveTouch = nil
    end
end
local function cameraInputChanged(input, processed)
    if not s.cameraUnlocked then return end
    local kind = input.UserInputType
    if kind == Enum.UserInputType.Touch and input == s.cameraActiveTouch and not processed then
        rotateOrbit(input.Delta.X, input.Delta.Y)
    elseif kind == Enum.UserInputType.MouseWheel and not processed then
        s.cameraOrbitDistance = math.clamp(
            s.cameraOrbitDistance * (1 - input.Position.Z * .12), 3, 110
        )
    elseif kind == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick2 then
        s.cameraThumbstick = Vector2.new(input.Position.X, input.Position.Y)
    end
end

function s:SetCameraUnlocked(enabled)
    enabled = enabled == true
    if self.cameraUnlocked == enabled then return end
    self.cameraUnlocked = enabled
    local camera = workspace.CurrentCamera
    if enabled then
        self.cameraUnlockPrevious = camera and {
            cameraType = camera.CameraType, subject = camera.CameraSubject,
        } or nil
        releaseCameraMouse()
        self.cameraActiveTouch = nil
        self.cameraThumbstick = Vector2.zero
        self.cameraFadeCheck = 0
        self.cameraOrbitFocus = cameraOrbitTarget()
        if camera then
            local offset = camera.CFrame.Position - self.cameraOrbitFocus
            local distance = offset.Magnitude
            if distance > .1 then
                self.cameraOrbitDistance = math.clamp(distance, 3, 110)
                self.cameraOrbitPitch = math.asin(math.clamp(offset.Y / distance, -1, 1))
                self.cameraOrbitYaw = math.atan2(offset.X, offset.Z)
            end
            camera.CameraType = Enum.CameraType.Scriptable
        end
        table.insert(self.cameraBindings, UserInputService.InputBegan:Connect(cameraInputBegan))
        table.insert(self.cameraBindings, UserInputService.InputEnded:Connect(cameraInputEnded))
        table.insert(self.cameraBindings, UserInputService.InputChanged:Connect(cameraInputChanged))
        -- Don't leave the mouse locked after alt-tabbing or losing window focus.
        table.insert(self.cameraBindings, UserInputService.WindowFocusReleased:Connect(releaseCameraMouse))
        RunService:BindToRenderStep(CAMERA_BINDING, Enum.RenderPriority.Camera.Value + 1, renderUnlockedCamera)
    else
        RunService:UnbindFromRenderStep(CAMERA_BINDING)
        releaseCameraMouse()
        for _, connection in ipairs(self.cameraBindings) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self.cameraBindings)
        resetCameraFade()
        self.cameraActiveTouch = nil
        self.cameraThumbstick = Vector2.zero
        self.cameraOrbitFocus = nil
        if camera then
            if self.enabled and self.focus and self.focus.Parent then
                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = self.focus
            else
                local previous = self.cameraUnlockPrevious
                camera.CameraType = previous and previous.cameraType or Enum.CameraType.Custom
                if previous and previous.subject and previous.subject.Parent then
                    camera.CameraSubject = previous.subject
                else
                    local _, humanoid = characterReady()
                    if humanoid then camera.CameraSubject = humanoid end
                end
            end
        end
        self.cameraUnlockPrevious = nil
    end
end

local function visualFootOffset(char, humanoid, root)
    -- On R15 characters, use actual feet to align the waiting platform.
    -- Fall back to Humanoid.HipHeight for R6/custom rigs.
    local lowest
    for _, name in ipairs({"LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local footY = part.Position.Y - part.Size.Y * 0.5
            if not lowest or footY < lowest then lowest = footY end
        end
    end
    local fallback = humanoid.HipHeight + root.Size.Y * 0.5
    if lowest then
        local offset = root.Position.Y - lowest
        if offset > 1 and offset < 9 then return offset end
    end
    return fallback
end
local function makePlatform(char, humanoid, root)
    -- Park only ONCE on arrival: repeatedly unanchoring/reanchoring and
    -- replacing the vertical lift was causing the screenshot's jitter.
    if s.parkRoot ~= root then
        releasePark()
        stopTween()
        removeLift()
        setNoclip(char, true)
        s.parkRoot = root
        s.parkOriginalAnchor = root.Anchored
        s.parkLocation = Vector3.new(root.Position.X, undergroundY(), root.Position.Z)
        root.Anchored = true
    end
    -- A slider change only adjusts the depth; X/Z remain stationary.
    local waitAt = Vector3.new(s.parkLocation.X, undergroundY(), s.parkLocation.Z)
    s.parkLocation = waitAt
    if (root.Position - waitAt).Magnitude > 0.04 then
        rootPlacement(root, waitAt.X, waitAt.Z, waitAt.Y)
    end

    if not s.platform then
        local part = Instance.new("Part")
        part.Name = "HollowMoon12x12WaitingPlatform"
        part.Size = Vector3.new(12, 1, 12)
        part.Anchored = true
        part.CanCollide = true
        part.CanTouch = false
        part.CanQuery = false
        part.Color = Color3.fromRGB(70, 83, 112)
        part.Material = Enum.Material.SmoothPlastic
        part.Transparency = .15
        part.Parent = workspace
        s.platform = part
    end
    local feetBelowRoot = visualFootOffset(char, humanoid, root)
    s.platform.CFrame = CFrame.new(waitAt.X, waitAt.Y - feetBelowRoot - 0.5, waitAt.Z)
    -- Root remains anchored until an NPC arrives or Auto Farm is disabled.
    -- The platform is visually under the feet, not relied upon for physics.
end

-- Keep an event-driven NPC cache, including newly spawned enemies.
local function track(m)
    if m and m:IsA("Model") then
        s.enemies[m] = true
        -- Reconsider an available target on the next attack Heartbeat.
        s.nextAttackScan = 0
        s.nextScan = 0
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
        if not s.dodgeEnemySubscriptions[m] then
            local connections = {}
            for _, attribute in ipairs({"AIState", "WindupEnd", "AttackKind"}) do
                connections[#connections + 1] = m:GetAttributeChangedSignal(attribute):Connect(function()
                    s.dodgeNextHazardRefresh = 0
                    s.dodgeNextScan = 0
                    s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
                end)
            end
            s.dodgeEnemySubscriptions[m] = connections
        end
    end
end
local function untrack(m)
    local subs = s.dodgeEnemySubscriptions[m]
    if subs then
        for _, connection in ipairs(subs) do connection:Disconnect() end
        s.dodgeEnemySubscriptions[m] = nil
    end
    s.enemies[m] = nil
    if s.attackTarget == m then s.attackTarget = nil end
    s.nextAttackScan = 0
    s.nextScan = 0
end
local function bindFolder()
    local folder = workspace:FindFirstChild("ActiveEnemies")
    if folder == s.activeFolder then return end
    for _, c in ipairs(s.folderConnections) do c:Disconnect() end
    table.clear(s.folderConnections)
    s.activeFolder = folder
    if folder then
        for _, m in ipairs(folder:GetChildren()) do track(m) end
        connect(folder.ChildAdded, track, s.folderConnections)
        connect(folder.ChildRemoved, function(m)
            if not CollectionService:HasTag(m, "Enemy") then untrack(m) end
        end, s.folderConnections)
    end
end
for _, m in ipairs(CollectionService:GetTagged("Enemy")) do track(m) end
connect(CollectionService:GetInstanceAddedSignal("Enemy"), track)
connect(CollectionService:GetInstanceRemovedSignal("Enemy"), untrack)
-- Tag events can precede the visible warning's next render frame.
for _, tag in ipairs({"VolleyMark", "BossMech"}) do
    connect(CollectionService:GetInstanceAddedSignal(tag), function()
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
        s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
    end)
    connect(CollectionService:GetInstanceRemovedSignal(tag), function()
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
    end)
end
connect(workspace.ChildAdded, function(child)
    if child.Name == "ActiveEnemies" then bindFolder() end
end)
connect(workspace.ChildRemoved, function(child)
    if child == s.activeFolder then s.activeFolder = nil; bindFolder() end
end)
bindFolder()

-- Targets are sticky: one boss remains the priority until it dies or the
-- challenge changes. Ordinary NPC targets use a short lock to avoid jitter.
local function isBoss(model)
    if not model then return false end
    if model:GetAttribute("IsBoss") == true or model:GetAttribute("Boss") == true
        or model:GetAttribute("IsChampion") == true
        or CollectionService:HasTag(model, "Boss")
        or CollectionService:HasTag(model, "Champion") then return true end
    local name = tostring(model:GetAttribute("EnemyType") or model.Name):lower()
    return name:find("champion", 1, true) ~= nil
        or name:find("boss", 1, true) ~= nil
end
local function isRival(model)
    local name = (model and model.Name or ""):lower()
    return name:find("rival",1,true) ~= nil
        or (model and model:GetAttribute("Rival") == true)
        or (model and CollectionService:HasTag(model,"Rival"))
end
local function isChallengeEnemy(model, id)
    return (id == "Champion" and isBoss(model))
        or (id == "Rivals" and isRival(model))
end
local function objectivePosition(instance)
    if not instance or not instance:IsDescendantOf(workspace) then return nil end
    if instance:IsA("BasePart") then return instance.Position end
    if instance:IsA("Attachment") then return instance.WorldPosition end
    if instance:IsA("Model") then return instance:GetPivot().Position end
    return nil
end
local function firstTaggedPosition(tag, fallbackName)
    for _, instance in ipairs(CollectionService:GetTagged(tag)) do
        local p = objectivePosition(instance)
        if p then return p end
    end
    local folder = workspace:FindFirstChild("ChallengeObjects")
    return objectivePosition(folder and folder:FindFirstChild(fallbackName))
end
local function readObjective(now)
    if now < s.lastObjectiveScan then return s.objectiveId end
    s.lastObjectiveScan = now + .20
    if matchHud and type(matchHud.objective) == "function" then
        local ok, objective = pcall(matchHud.objective)
        if ok and type(objective) == "table" and type(objective.id) == "string" then
            s.objectiveDone = objective.completed == true
            s.objectiveId = s.objectiveDone and nil or objective.id
        end
    end
    if gameAttribute("ObjectiveActive") == false then
        s.objectiveDone = true
        s.objectiveId = nil
    end
    local id = not s.objectiveDone and s.objectiveId or nil
    local pos
    if id == "Chariot" then
        pos = firstTaggedPosition("ChallengeChariot", "Chariot")
            or gameAttribute("ObjectivePos")
    elseif id == "Eye" then
        pos = gameAttribute("ObjectivePos") or gameAttribute("EyeStart")
    elseif id == "Treasure" then
        local best, bestDist = nil, math.huge
        local here = s.lastGrounded or s.startPosition or Vector3.zero
        for _, purse in ipairs(CollectionService:GetTagged("Purse")) do
            if not purse:GetAttribute("Taken") and not purse:GetAttribute("Collected") then
                local p = objectivePosition(purse)
                if p then
                    local d = horizontal(here, p)
                    if d < bestDist then best, bestDist = p, d end
                end
            end
        end
        pos = best
    end
    s.objectivePos = typeof(pos) == "Vector3" and pos or nil
    return id
end
local function findTarget(root, now, id)
    local current = rootOf(s.target)
    -- When a boss is alive, stay with it regardless of other NPCs spawning.
    if current and s.focusKind == "Boss" then
        if not (id == "Champion" or id == "Rivals") or isChallengeEnemy(s.target, id) then
            return s.target, current.Position.Y > (s.floorY or 0) + 9, "Boss locked"
        end
    end
    if current and s.focusKind == "Objective NPC" and isChallengeEnemy(s.target, id) then
        return s.target, current.Position.Y > (s.floorY or 0) + 9, "Objective NPC locked"
    end
    local bestBoss, bestBossDist = nil, math.huge
    local bestObjective, bestObjectiveDist = nil, math.huge
    local bestNormal, bestNormalDist = nil, math.huge
    for model in pairs(s.enemies) do
        local enemyRoot = rootOf(model)
        if enemyRoot then
            local d = horizontal(root.Position, enemyRoot.Position)
            if isBoss(model) and d < bestBossDist then
                bestBoss, bestBossDist = model, d
            end
            if id and isChallengeEnemy(model, id) and d < bestObjectiveDist then
                bestObjective, bestObjectiveDist = model, d
            end
            if d < bestNormalDist then bestNormal, bestNormalDist = model, d end
        elseif not model:IsDescendantOf(workspace) then
            s.enemies[model] = nil
        end
    end
    local selected, mode
    if bestObjective then selected, mode = bestObjective, "Objective NPC"
    elseif bestBoss then selected, mode = bestBoss, "Boss"
    elseif current and now < s.lockUntil then selected, mode = s.target, "Normal lock"
    else selected, mode = bestNormal, "Nearest NPC" end
    if selected ~= s.target then
        s.targetSince = now
        s.lockUntil = now + .85
        s.lastGrounded = nil
    end
    s.focusKind = mode
    s.focusName = selected and selected.Name or "None"
    local er = rootOf(selected)
    return selected, er and er.Position.Y > (s.floorY or 0) + 9 or false, mode
end

-- Challenge event handler: only changes the objective ID, never fires
-- undocumented challenge remotes or attempts underground interactions.
local function onMatchPacket(eventName, packet)
    if type(packet) ~= "table" then packet = {} end
    if eventName == "challenge" then
        s.objectiveId = packet.id or packet.challenge or s.objectiveId
        s.objectiveDone = false
        s.lastObjectiveScan = 0
        s.lockUntil = 0
    elseif eventName == "roundStart" then
        s.objectiveId = packet.challenge
        s.objectiveDone = false
        s.lastObjectiveScan = 0
        s.lockUntil = 0
    elseif eventName == "challengeComplete" or eventName == "matchEnd" then
        s.objectiveDone = true
        s.objectiveId = nil
        s.objectivePos = nil
        s.lockUntil = 0
    end
end
if clientState and type(clientState.onMatchEvent) == "function" then
    for _, kind in ipairs({"challenge", "roundStart", "challengeComplete", "matchEnd"}) do
        local ok, con = pcall(clientState.onMatchEvent, kind, function(packet)
            onMatchPacket(kind, packet)
        end)
        if ok and con and (typeof(con) == "RBXScriptConnection"
            or type(con) == "table" and type(con.Disconnect) == "function") then
            table.insert(s.connections, con)
        end
    end
end
local matchRemote = remotes and remotes:FindFirstChild("MatchEvent")
if matchRemote and matchRemote:IsA("RemoteEvent") then
    connect(matchRemote.OnClientEvent, function(eventName, packet)
        if type(eventName) == "table" then
            local kind = eventName.t or eventName.type or eventName.kind
            onMatchPacket(kind, eventName.payload or eventName.data or eventName)
        elseif type(eventName) == "string" then
            onMatchPacket(eventName, packet)
        end
    end)
end

local function startSegment(root, dest)
    stopTween()
    local from = root.Position
    local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
    local d = flat.Magnitude
    if d < .7 then return end
    -- Short continuous segments, with no wait for a pathfinder or waypoint callbacks.
    local travel = math.min(d, s.speed * .85)
    local endXZ = from + flat.Unit * travel
    s.segment = {from = from, to = endXZ, target = dest}
    s.driver.Value = 0
    local t = math.max(.05, travel / s.speed)
    s.tween = TweenService:Create(s.driver, TweenInfo.new(t, Enum.EasingStyle.Linear), {Value = 1})
    s.tween:Play()
end
-- Enemy-relative positioning: the enemy's facing changes the horizontal
-- destination continuously, while the avatar Y is ALWAYS tied to arena floor.
-- This means a jumping Lion never lifts the farming character into the sky.
-- Creature IDs in Defs.Creatures include "cerberus". This override applies
-- only to its Behind + Below horizontal offset, never the underground depth.
local function isCerberus(model)
    if not model or not model:IsA("Model") then return false end
    local labels = {
        model.Name,
        model:GetAttribute("CreatureId"),
        model:GetAttribute("CreatureType"),
        model:GetAttribute("EnemyType"),
        model:GetAttribute("EnemyId"),
        model:GetAttribute("TypeId"),
        model:GetAttribute("NPCType"),
    }
    for _, value in pairs(labels) do
        if value ~= nil then
            local id = tostring(value):lower():gsub("[^%a]", "")
            if id:find("cerberus", 1, true) or id:find("cerebrus", 1, true) then
                return true
            end
        end
    end
    return false
end

local function effectiveBehindOffset(target)
    if isCerberus(target) then return 10 end
    return s.behindOffset
end

local function behindGoal(target, enemyRoot, airborne, dt)
    if s.behindTarget ~= target then
        s.behindTarget = target
        s.behindYaw = nil
    end

    -- HumanoidRootPart usually represents NPC facing more reliably than a
    -- decorative or hitbox PrimaryPart; the active model root is fallback.
    local facingRoot = target:FindFirstChild("HumanoidRootPart")
    if not (facingRoot and facingRoot:IsA("BasePart")) then
        facingRoot = enemyRoot
    end
    local look = facingRoot.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > .02 then
        local wantedYaw = math.atan2(flatLook.X, flatLook.Z)
        if s.behindYaw == nil then
            s.behindYaw = wantedYaw
        elseif not airborne then
            -- Smooth angular rotation with wraparound, avoiding abrupt side
            -- flips when the enemy turns across the -pi/+pi boundary.
            local diff = math.atan2(
                math.sin(wantedYaw - s.behindYaw),
                math.cos(wantedYaw - s.behindYaw)
            )
            local maxTurn = math.rad(300) * math.clamp(dt, 0, .08)
            s.behindYaw = s.behindYaw + math.clamp(diff, -maxTurn, maxTurn)
        end
    end

    local yaw = s.behindYaw or 0
    local behind = Vector3.new(math.sin(yaw), 0, math.cos(yaw))
    local base = airborne and s.lastGrounded or enemyRoot.Position
    base = base or enemyRoot.Position
    local behindOffset = effectiveBehindOffset(target)
    return Vector3.new(
        base.X - behind.X * behindOffset,
        0,
        base.Z - behind.Z * behindOffset
    )
end

-- Smooth pursuit for continuously rotating targets. Instead of restarting
-- a TweenService animation every time a target turns, interpolate one small
-- step per Heartbeat, capped by the selected Tween Speed in studs/second.
-- The Teleport option still positions immediately at the current behind spot.
local function moveBehindBelow(root, goal, dt)
    if not s.behindActive then
        stopTween()
        s.behindActive = true
    end
    local y = undergroundY()
    local here = root.Position
    local flat = Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)
    local distance = flat.Magnitude
    if s.method == "Teleport" then
        if distance > .45 or math.abs(here.Y - y) > .04 then
            rootPlacement(root, goal.X, goal.Z, y)
        else
            -- Keep turning smoothly even while our behind spot is stationary.
            rootPlacement(root, here.X, here.Z, y)
        end
        return
    end
    if distance <= .20 then
        rootPlacement(root, here.X, here.Z, y)
        return
    end
    local frame = math.clamp(dt, 0, .065)
    local cap = s.speed * frame
    local easedStep = distance * (1 - math.exp(-frame * 13))
    local step = math.min(cap, easedStep, distance)
    local nextXZ = here + flat.Unit * step
    rootPlacement(root, nextXZ.X, nextXZ.Z, y)
end

local function resetBehind()
    s.behindActive = false
    s.behindTarget = nil
    s.behindYaw = nil
end

local function moveBelow(root, goal, now)
    local y = undergroundY()
    if s.method == "Teleport" then
        stopTween()
        local xz = Vector3.new(root.Position.X, y, root.Position.Z)
        if horizontal(xz, goal) > 1.65 then
            rootPlacement(root, goal.X, goal.Z, y)
        else
            rootPlacement(root, xz.X, xz.Z, y)
        end
        return
    end
    -- Replan a moving target without cancelling the tween every Heartbeat.
    local seg = s.segment
    local changed = seg and horizontal(seg.target, goal) > 3.3
    local finished = not seg or s.driver.Value >= .999
    if (finished or (changed and now >= s.nextPlan)) then
        startSegment(root, goal)
        s.nextPlan = now + .20
    end
    local p = root.Position
    if s.segment then
        p = s.segment.from:Lerp(s.segment.to, math.clamp(s.driver.Value, 0, 1))
    end
    rootPlacement(root, p.X, p.Z, y)
end

-- Runtime kit definitions take precedence; fallback durations are from
-- captured client move definitions (not server bypass timings).
local fallbackMoves = {
    Gladiator = {
        {id = "glad_slash1", duration = .42},
        {id = "glad_slash2", duration = .42},
        {id = "glad_bash", duration = .60, recovery = .15},
    },
    Lancer = {
        {id = "lance_thrust1", duration = .50},
        {id = "lance_thrust2", duration = .50},
        {id = "lance_sweep", duration = .70, recovery = .15},
    },
    Berserker = {
        {id = "bers_cleave", duration = .55},
        {id = "bers_reaver", duration = .60},
        {id = "bers_earthsplit", duration = .80, recovery = .15},
    },
    Archer = {
        {id = "bow_shot", duration = .45},
        {id = "bow_shot", duration = .45},
        {id = "bow_volley", duration = .60},
    },
}
local attackRanges = {Gladiator = 7, Lancer = 11, Berserker = 8, Archer = 95}
local function currentSnapshot()
    if clientState and type(clientState.get) == "function" then
        local ok, val = pcall(clientState.get)
        if ok and type(val) == "table" then return val end
    end
    return {}
end
local function cooldownMultiplier(char)
    local data = currentSnapshot()
    local tool = char:FindFirstChildOfClass("Tool")
    local weaponId = player:GetAttribute("WeaponId")
        or (tool and tool:GetAttribute("WeaponId")) or data.SelectedWeapon
    local weapon = lookup(weapons, weaponId)
    local statSheet = data.StatSheet
    if type(statSheet) == "table" and statSheet.weaponId == weaponId then
        local actual = finite(statSheet.cooldownMult, nil)
        if actual then return math.clamp(actual, .5, 2) end
    end
    local skills = type(data.Skills) == "table" and data.Skills or {}
    local skillSpeed = finite(skills.AttackSpeed, 0)
    local weaponSpeed = math.clamp(finite(weapon and weapon.attackSpeed, 0), 0, .9)
    if formulas and type(formulas.attackCooldownMult) == "function" then
        local ok, result = pcall(formulas.attackCooldownMult, skillSpeed, weaponSpeed)
        if ok and finite(result, nil) then
            return math.clamp(result, .5, 2)
        end
    end
    return math.clamp((1 - skillSpeed * .03) * (1 - weaponSpeed), .5, 2)
end
local function currentMove(kit, stage)
    local fallback = (fallbackMoves[kit] or fallbackMoves.Gladiator)[stage]
    if not fallback then return {id = "unknown", duration = .5} end
    local kitDef = lookup(kits, kit)
    local combo = kitDef and (kitDef.combo or kitDef.Combo or kitDef.comboMoves)
    local moveId = type(combo) == "table" and combo[stage] or fallback.id
    local move = lookup(kits and kits.moves, moveId)
        or lookup(kits and kits.Moves, moveId)
        or lookup(kitDef and kitDef.moves, moveId)
    local result = table.clone(fallback)
    if type(move) == "table" then
        for k, v in pairs(move) do result[k] = v end
    end
    result.id = moveId
    return result
end

local function tryEquip(char, humanoid, now)
    if char:FindFirstChildOfClass("Tool") then return true end
    if now < (s.nextEquip or 0) then return false end
    s.nextEquip = now + .7
    local bag = player:FindFirstChildOfClass("Backpack")
    if not bag then return false end
    for _, tool in ipairs(bag:GetChildren()) do
        if tool:IsA("Tool") and (tool:GetAttribute("WeaponId") or tool:GetAttribute("WeaponModelId")) then
            humanoid:EquipTool(tool)
            break
        end
    end
    return false
end
-- Combat direction is separate from camera orbit: changing the view never
-- changes the NPC Auto Attack aim or the farm movement target.
local function predictedPoint(enemyRoot, kit, origin)
    local velocity = enemyRoot.AssemblyLinearVelocity
    if velocity.Magnitude > 65 then velocity = velocity.Unit * 65 end
    if kit == "Archer" then
        -- Cap the lead to avoid arrows scattering when an enemy changes direction.
        local dt = math.clamp((enemyRoot.Position - origin).Magnitude / 180, .04, .22)
        return enemyRoot.Position + Vector3.new(0, 1.1, 0) + velocity * dt
    end
    return enemyRoot.Position + velocity * .035
end
local groupedMeleeAim -- forward-declared: attackNpc uses it before its definition
local function attackNpc(char, humanoid, root, npc, now)
    if not attackRemote then
        s.attackStatus = "Direct Attack remote unavailable"
        return
    end
    if now < s.nextAttack then return end
    if char:GetAttribute("Downed") or char:GetAttribute("Stunned")
        or char:GetAttribute("AttackDisabled") then
        s.attackStatus = "Combat unavailable (disabled state)"
        return
    end
    if not tryEquip(char, humanoid, now) then
        s.attackStatus = "Equipping weapon"
        return
    end
    local enemyRoot = rootOf(npc)
    if not enemyRoot then return end
    local kit = kitName()
    if kit ~= s.attackLastKit then
        s.combo, s.comboLast = 0, 0
        s.attackLastKit = kit
    end
    local reach = attackRanges[kit] or 7
    local delta = enemyRoot.Position - root.Position
    local distance = delta.Magnitude
    s.attackDistance = distance
    -- Deliberately DO NOT gate attack requests by distance. Auto Attack
    -- attempts as long as a living NPC exists; the server still validates
    -- hitboxes and effective attack reach.
    local withinReach = distance <= reach - .12
    local aim
    if kit == "Archer" then
        s.attackGroupEstimate = 1
        local from = root.Position + Vector3.new(0, 1.4, 0)
        local deltaShot = predictedPoint(enemyRoot, kit, from) - from
        if deltaShot.Magnitude < .01 then return end
        aim = deltaShot.Unit
    else
        local flat = Vector3.new(delta.X, 0, delta.Z)
        aim = groupedMeleeAim(root, npc, delta)
    end
    local comboCount = #(fallbackMoves[kit] or fallbackMoves.Gladiator)
    -- Combo reset should happen only after a substantial time without attacking.
    if now - s.comboLast > 1.2 then s.combo = 0 end
    local stage = s.combo % comboCount + 1
    local move = currentMove(kit, stage)
    local remoteSeq = finite(char:GetAttribute("MoveSeq"), nil)
    -- A rapid client sequence can move far beyond the last server-reported
    -- sequence. Rebase after a sustained lack of acknowledgements so one
    -- rejected burst cannot make every later request invalid.
    if remoteSeq and s.seq - remoteSeq > 12
        and now - (s.attackLastAcknowledgedAt or 0) > 1.0 then
        s.seq = remoteSeq
        s.attackResyncs = s.attackResyncs + 1
        s.paceStatus = "Resynced attack sequence after missing acknowledgements"
    end
    s.seq = math.max(s.seq, remoteSeq or 0) + 1
    local ok = pcall(function()
        if kit == "Archer" then
            attackRemote:FireServer(s.seq, aim, false)
        else
            attackRemote:FireServer(s.seq, aim)
        end
    end)
    if not ok then
        s.nextAttack = now + .30
        s.attackStatus = "Attack remote request failed"
        return
    end
    s.combo = stage
    s.comboLast = now
    s.requests = s.requests + 1
    s.attackMove = tostring(move.id or "Attack")
    s.cooldownMult = cooldownMultiplier(char)
    s.attackLastRequest = now
    s.attackLastSeqTime = now
    s.attackLastSeq = s.seq
    -- Track multiple outstanding requests. At rapid rates, tracking only the
    -- latest request would incorrectly discard acknowledgements of earlier ones.
    table.insert(s.pendingAttackSeqs, {seq = s.seq, at = now})
    if #s.pendingAttackSeqs > 40 then table.remove(s.pendingAttackSeqs, 1) end
    -- No speed slider or 3D range gate. Bounded 50ms requests while at
    -- least one living NPC exists. Do not fire every Heartbeat: this keeps
    -- network traffic predictable even on high-FPS devices.
    local interval = .05
    s.lastExpectedAttack = interval
    s.nextAttack = now + interval
    table.insert(s.recentAttackRequests, now)
    while #s.recentAttackRequests > 0 and now - s.recentAttackRequests[1] > 3 do
        table.remove(s.recentAttackRequests, 1)
    end
    if withinReach then
        s.attackStatus = "Rapid attack sent (in class range); server validation pending"
    else
        s.attackStatus = "Rapid attack sent (out of class range; damage not guaranteed)"
    end
end

-- Auto Leave on eliminated teammates or the local player.
-- When the local self-death toggle is enabled, V38 first declines the
-- optional paid revive offer using the game's actual No thanks action.
-- MatchHUDController confirms "Downed" is revivable and "Eliminated"
-- is the team HUD's "Fallen" state. We do not infer death from health=0.
local function matchState(name)
    local stateFolder = ReplicatedStorage:FindFirstChild("GameState")
    local value = stateFolder and stateFolder:GetAttribute(name)
    if value == nil and clientState and type(clientState.game) == "table" then
        value = clientState.game[name]
    end
    return value
end
local function arenaMatchKey()
    local matchId = player:GetAttribute("MatchId")
    if type(matchId) ~= "string" or matchId == "" then
        matchId = matchState("MatchId")
    end
    if type(matchId) ~= "string" then matchId = "" end
    return matchId
end
local function participantIds()
    local ids = {}
    local raw = matchState("Participants")
    if type(raw) == "string" and raw ~= "" then
        for token in raw:gmatch("[^,]+") do
            local id = tonumber(token)
            if id then ids[math.floor(id)] = true end
        end
    end
    return ids, next(ids) ~= nil
end
local function findFullyEliminatedTeammate()
    local ids, hasParticipantList = participantIds()
    local currentId = arenaMatchKey()
    -- Players: check only active match participants, not spectators/lobby.
    for _, member in ipairs(Players:GetPlayers()) do
        local sameMatch = currentId == ""
            or member == player
            or (hasParticipantList and ids[member.UserId] == true)
            or member:GetAttribute("MatchId") == currentId
        local eligible = member ~= player and (
            (hasParticipantList and ids[member.UserId] == true)
            or (not hasParticipantList and member:GetAttribute("Zone") == "Arena" and sameMatch)
        )
        if eligible and sameMatch and member:GetAttribute("CombatState") == "Eliminated" then
            return member.DisplayName, false
        end
    end
    -- AI teammates: MatchHUD gets their state from models tagged "Bot".
    for _, bot in ipairs(CollectionService:GetTagged("Bot")) do
        if bot:IsA("Model") and bot:IsDescendantOf(workspace) then
            local botId = bot:GetAttribute("MatchId")
            local sameMatch = currentId == "" or botId == nil or botId == "" or botId == currentId
            if sameMatch and bot:GetAttribute("CombatState") == "Eliminated" then
                return tostring(bot:GetAttribute("DisplayName") or bot.Name), false
            end
        end
    end
    return nil, false
end
-- GloryBound's SummaryController builds a custom Bronze Kit.button: its
-- visual wrapper is not necessarily a GuiButton. GuiButton:Activate() is not
-- a Roblox API method, and attempting it caused "Activate unavailable".
-- The *actual* Back to the prison action sends LeaveMatch("continue").
-- First detect the visible results screen, then send precisely that action.
local function resultsReturnVisible()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return false end
    local function visible(object)
        while object and object ~= gui do
            if object:IsA("GuiObject") and not object.Visible then return false end
            if object:IsA("ScreenGui") and not object.Enabled then return false end
            object = object.Parent
        end
        return true
    end
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel") or item:IsA("TextButton")) and visible(item) then
            local label = tostring(item.Text or ""):lower():gsub("%s+", " ")
            if label:find("back to the prison", 1, true) or label:find("back to prison", 1, true) then
                return true
            end
        end
    end
    return false
end

local function sendResultsContinue()
    -- SummaryController calls ClientState.fire("LeaveMatch", "continue").
    -- Prefer its built-in wrapper when available, then fall back to the
    -- identical direct RemoteEvent call. Neither path clicks Retry.
    if clientState and type(clientState.fire) == "function" then
        local ok, accepted = pcall(clientState.fire, "LeaveMatch", "continue")
        if ok and accepted ~= false then
            return true, "ClientState"
        end
    end
    local remote = remotes and remotes:FindFirstChild("LeaveMatch")
    if remote and remote:IsA("RemoteEvent") then
        local ok = pcall(function() remote:FireServer("continue") end)
        if ok then return true, "LeaveMatch remote" end
    end
    return false, "Continue request unavailable"
end

local function clickResultReturn(now)
    if not resultsReturnVisible() then
        s.leaveStatus = "Waiting for results-screen return control"
        return false
    end
    if now < s.leaveButtonAttemptAt then return true end
    -- Don't spam the return command during a teleport. Retry only if the
    -- actual results screen is still visible a few seconds later.
    s.leaveButtonAttemptAt = now + 3.0
    s.leaveButtonTries = s.leaveButtonTries + 1
    local sent, method = sendResultsContinue()
    if sent then
        s.leaveStatus = "Return requested via " .. method .. " (attempt " .. s.leaveButtonTries .. ")"
    else
        s.leaveStatus = "Return failed: " .. method
    end
    return true
end

-- V38: The actual "No thanks" choice in ReviveOfferController sends
-- ClientState.fire("ReviveOfferAnswer", activeOffer.id, "decline").
-- Handle that *only* for the local player's enabled self-death toggle.
-- Declining skips the optional self-revive offer; we do not buy a revive.
s.localIsDowned = function()
    if player:GetAttribute("CombatState") == "Downed" then return true end
    local character = player.Character
    return character ~= nil and character:GetAttribute("Downed") == true
end

s.tryDeclineOwnReviveOffer = function()
    if not s.leaveSelfEnabled or not s.localIsDowned() then return false end
    if type(s.leaveOfferId) ~= "number" or s.leaveOfferState ~= "open" then return false end
    local now = os.clock()
    if now < s.leaveOfferNextAt or s.leaveOfferTries >= 3 then return false end
    s.leaveOfferNextAt = now + 0.75
    s.leaveOfferTries = s.leaveOfferTries + 1

    local didSend = false
    if clientState and type(clientState.fire) == "function" then
        local ok, result = pcall(clientState.fire, "ReviveOfferAnswer", s.leaveOfferId, "decline")
        didSend = ok and result == true
    end
    if not didSend then
        local remote = remotes and remotes:FindFirstChild("ReviveOfferAnswer")
        if remote and remote:IsA("RemoteEvent") then
            didSend = pcall(function()
                remote:FireServer(s.leaveOfferId, "decline")
            end)
        end
    end

    if didSend then
        s.leaveStatus = "No thanks requested; awaiting elimination"
    else
        s.leaveStatus = "Revive decline request unavailable"
    end
    return didSend
end

s.observeLocalReviveOffer = function(packet)
    if not s.leaveSelfEnabled or type(packet) ~= "table" then return end
    local id = tonumber(packet.id)
    if not id or id % 1 ~= 0 then return end
    if packet.state == "closed" then
        if s.leaveOfferId == id then
            s.leaveOfferId, s.leaveOfferState = nil, nil
        end
        return
    end
    if packet.state ~= "open" then return end
    if s.leaveOfferId ~= id then
        s.leaveOfferId = id
        s.leaveOfferTries = 0
        s.leaveOfferNextAt = 0
    end
    s.leaveOfferState = "open"
    -- Event-driven response is faster than waiting for the next scan tick.
    s.tryDeclineOwnReviveOffer()
end

s.checkCurrentReviveOffer = function()
    if not s.leaveSelfEnabled or not s.localIsDowned() then return end
    -- Supports enabling Auto Leave while a revive offer is already visible.
    if not s.leaveOfferId then
        local module = controllers and controllers:FindFirstChild("ReviveOfferController")
        local controller = readModule(module)
        if controller and type(controller.current) == "function" then
            local ok, packet = pcall(controller.current)
            if ok and type(packet) == "table" then
                s.observeLocalReviveOffer(packet)
            end
        end
    end
    s.tryDeclineOwnReviveOffer()
end

local function tickAutoLeave()
    if not s.leaveEnabled then return end
    local now = os.clock()
    if now < s.nextLeaveScan then return end
    s.nextLeaveScan = now + .10

    -- While downed, immediately choose No thanks (if the optional revive
    -- offer is open) so the server can confirm elimination sooner.
    s.checkCurrentReviveOffer()

    -- Always handle the results screen when Auto Leave is enabled, even if
    -- the arena ended normally and this script did not issue the initial leave.
    -- Do not mistake the boon picker for the results screen.
    if resultsReturnVisible() then
        -- Prefer the visible result screen over the Zone attribute: the latter
        -- can change before the result UI/teleport transition finishes.
        if not s.leaveReturnPending then
            s.leaveReturnPending = true
            s.leaveButtonAttemptAt = 0
            s.leaveButtonTries = 0
        end
        clickResultReturn(now)
        return
    elseif player:GetAttribute("Zone") == "Lobby" then
        if s.leaveReturnPending then
            s.leaveStatus = "Returned to the prison/lobby"
        end
        s.leaveReturnPending = false
        s.leaveRequested = false
        s.leaveButtonTries = 0
        s.leaveButtonAttemptAt = 0
    elseif s.leaveReturnPending then
        -- An initial LeaveMatch may have happened before the report appeared.
        -- Wait for the real results-screen action, rather than guessing success.
        s.leaveStatus = "Waiting for results screen / server transition"
        return
    end

    if player:GetAttribute("Zone") ~= "Arena" then
        s.leaveRequested = false
        s.leaveMatchKey = nil
        s.leaveStatus = "Waiting for an arena match"

        return
    end
    local phase = matchState("Phase")
    if phase ~= nil and phase ~= "InMatch" then
        s.leaveStatus = "Waiting for an active match"

        return
    end
    local key = arenaMatchKey()
    if key ~= s.leaveMatchKey then
        s.leaveMatchKey = key
        s.leaveRequested = false
    end
    if s.leaveRequested then

        return
    end
    -- Revivable Downed is never a full death. Self and teammate triggers
    -- are independent; only the matching enabled toggle can request leaving.
    local name, isSelf = nil, false
    if s.leaveSelfEnabled and player:GetAttribute("CombatState") == "Eliminated" then
        name, isSelf = player.DisplayName, true
    elseif s.leaveTeammateEnabled then
        name = findFullyEliminatedTeammate()
    end
    if name then
        local leaveRemote = remotes and remotes:FindFirstChild("LeaveMatch")
        if leaveRemote and leaveRemote:IsA("RemoteEvent") then
            -- The game's MatchHUD sends "continue" for already-eliminated
            -- local players, and "leave" while alive (teammate trigger).
            local command = isSelf and "continue" or "leave"
            local success = pcall(function() leaveRemote:FireServer(command) end)
            if success then
                s.leaveRequested = true
                s.leaveReturnPending = true
                s.leaveTarget = name
                s.leaveButtonTries = 0
                s.leaveButtonAttemptAt = 0
                s.leaveStatus = "Leave sent (" .. command .. "); waiting for results"
            else
                s.leaveStatus = "Failed to send leave request"
            end
        else
            s.leaveStatus = "LeaveMatch remote unavailable"
        end
    else
        s.leaveStatus = "Watching enabled full-death conditions (ignores Downed)"
    end

end
-- One shared scanner for two separately configurable death triggers.
-- It runs only if at least one Auto Leave toggle is enabled.
function s:UpdateAutoLeave()
    local active = self.leaveTeammateEnabled or self.leaveSelfEnabled
    if self.leaveEnabled == active then return end
    self.leaveEnabled = active
    self.leaveRequested = false
    self.leaveReturnPending = false
    self.leaveMatchKey = nil
    self.leaveButtonAttemptAt = 0
    self.leaveButtonTries = 0
    self.nextLeaveScan = 0
    if active then
        self.leaveStatus = "Watching enabled full-death conditions"
        if self.leaveHeartbeat then self.leaveHeartbeat:Disconnect() end
        self.leaveHeartbeat = RunService.Heartbeat:Connect(function()
            local success, err = pcall(tickAutoLeave)
            if not success then
                self.leaveStatus = "Leave watcher error"
                if os.clock() >= (self.nextLeaveWarning or 0) then
                    self.nextLeaveWarning = os.clock() + 8
                    warn("[HollowMoonHub Auto Leave] " .. tostring(err))
                end
            end
        end)
    else
        if self.leaveHeartbeat then self.leaveHeartbeat:Disconnect(); self.leaveHeartbeat = nil end
        self.leaveStatus = "Off"
        self.leaveTarget = nil
    end
    self.nextLeaveUi = 0
end

function s:SetAutoLeave(value)
    -- Retain the original saved toggle flag, now teammate-only.
    self.leaveTeammateEnabled = value == true
    self.nextLeaveScan = 0
    self:UpdateAutoLeave()
end

function s:SetAutoLeaveSelf(value)
    self.leaveSelfEnabled = value == true
    self.nextLeaveScan = 0
    if self.leaveReviveOfferConn then
        self.leaveReviveOfferConn:Disconnect()
        self.leaveReviveOfferConn = nil
    end
    self.leaveOfferId, self.leaveOfferState = nil, nil
    self.leaveOfferTries = 0
    self.leaveOfferNextAt = 0
    if self.leaveSelfEnabled then
        local offerEvent = remotes and remotes:FindFirstChild("ReviveOffer")
        if offerEvent and offerEvent:IsA("RemoteEvent") then
            self.leaveReviveOfferConn = offerEvent.OnClientEvent:Connect(function(packet)
                local ok, err = pcall(observeLocalReviveOffer, packet)
                if not ok then warn("[HollowMoonHub No Thanks] " .. tostring(err)) end
            end)
        end
        s.checkCurrentReviveOffer()
    end
    self:UpdateAutoLeave()
end

-- Server-reported NPC hits are more informative than counting requests.
local function attachCombatFeedback(remote)
    if not remote or remote.Name ~= "CombatFx" then return end
    if not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) then return end
    if s.combatFxRemote == remote then return end
    s.combatFxRemote = remote
    connect(remote.OnClientEvent, function(packet)
        if not s.attackEnabled or type(packet) ~= "table" or packet.t ~= "hit" then return end
        if packet.category == "Player" or packet.burn then return end
        local source = finite(packet.byUserId or packet.by, nil)
        local amount = finite(packet.amount, nil)
        if source == player.UserId and amount and amount > 0 then
            s.attackConfirmed = s.attackConfirmed + 1
            s.attackDamage = s.attackDamage + amount
        end
    end)
end
if remotes then
    attachCombatFeedback(remotes:FindFirstChild("CombatFx"))
    connect(remotes.ChildAdded, attachCombatFeedback)
end

-- Separate attack scheduler: Auto Attack can be enabled without Auto Farm.
-- It NEVER moves the player or changes the camera. Farm's movement state
-- and Auto Attack's cooldown / target state are deliberately independent.
local function nearestSpawnedNpc(root, kit)
    local limit = (attackRanges[kit] or attackRanges.Gladiator) - .12
    local spawned = {}
    local inRange = {}
    for npc in pairs(s.enemies) do
        local er = rootOf(npc)
        if er then
            local distance = (er.Position - root.Position).Magnitude
            local entry = {npc = npc, root = er, distance = distance}
            spawned[#spawned + 1] = entry
            if distance <= limit then
                inRange[#inRange + 1] = entry
            end
        elseif not npc:IsDescendantOf(workspace) then
            s.enemies[npc] = nil
        end
    end
    table.sort(spawned, function(a, b) return a.distance < b.distance end)
    table.sort(inRange, function(a, b) return a.distance < b.distance end)
    -- Group aim still uses only the enemies that could be hit by a melee
    -- swing. Target selection itself is intentionally NOT range-limited.
    s.attackCandidates = inRange
    s.attackNearbyCount = #inRange
    s.attackSpawnedCount = #spawned
    if #spawned == 0 then return nil end

    -- Keep the farm's locked boss/objective target when it remains alive.
    if s.enabled and s.target then
        for _, entry in ipairs(spawned) do
            if entry.npc == s.target then return entry.npc end
        end
    end
    -- Hold a current target when it is almost as near as the nearest one.
    -- Prevents flickering between piled-up enemies.
    local nearest = spawned[1]
    for _, entry in ipairs(spawned) do
        if entry.npc == s.attackTarget and entry.distance <= nearest.distance + 2 then
            return entry.npc
        end
    end
    return nearest.npc
end

-- A single accepted melee swing may naturally hit multiple NPCs. Choose an
-- aim vector through the densest nearby cone, without sending extra remotes.
groupedMeleeAim = function(root, npc, delta)
    local primary = Vector3.new(delta.X, 0, delta.Z)
    if primary.Magnitude < .02 then
        s.attackGroupEstimate = 0
        return root.CFrame.LookVector
    end
    local selectedDir = primary.Unit
    local entries = s.attackCandidates or {}
    local bestDir, bestHits, bestWeight = selectedDir, 1, -math.huge
    local candidateCount = math.min(#entries, 16)
    local origin = root.Position
    for index = 1, candidateCount do
        local entry = entries[index]
        if rootOf(entry.npc) then
            local proposed = Vector3.new(entry.root.Position.X - origin.X, 0,
                entry.root.Position.Z - origin.Z)
            if proposed.Magnitude > .03 then
                proposed = proposed.Unit
                -- If the farm's boss/champion is in reach, group aim must
                -- stay oriented around that lock instead of swinging away.
                local focusLocked = s.enabled and s.target == npc
                    and (s.focusKind == "Boss" or s.focusKind == "Objective NPC")
                if not focusLocked or proposed:Dot(selectedDir) >= .75 then
                local sum = Vector3.zero
                local hits, weight = 0, 0
                for _, other in ipairs(entries) do
                    local er = rootOf(other.npc)
                    if er then
                        local direction = Vector3.new(er.Position.X-origin.X, 0,
                            er.Position.Z-origin.Z)
                        if direction.Magnitude > .03 then
                            direction = direction.Unit
                            if proposed:Dot(direction) >= .75 then
                                hits = hits + 1
                                local w = 1 / math.max(2, other.distance)
                                sum = sum + direction*w
                                weight = weight + w
                            end
                        end
                    end
                end
                -- Small stability preference for the farm's locked target.
                local bias = (entry.npc == npc and .20 or 0)
                local quality = hits * 2 + weight + bias
                if quality > bestWeight and sum.Magnitude > .02 then
                    bestWeight, bestDir, bestHits = quality, sum.Unit, hits
                end
                end -- stay within the boss/champion aim cone when locked
            end
        end
    end
    s.attackGroupEstimate = bestHits -- potential targets in aim cone, NOT confirmed hits
    return bestDir
end

-- Every ~1.6s, use server-observed MoveSeq ACKs and damage feedback to
-- find a useful request pace. This cannot increase the game's server limit.
-- If feedback is unavailable, retain the fast default instead of guessing.
local function tuneAttackPace(now)
    if not s.paceWindowAt then
        s.paceWindowAt = now
        s.paceWindowRequests = s.requests
        s.paceWindowAcks = s.attackAccepted
        s.paceWindowHits = s.attackConfirmed
        return
    end
    if now - s.paceWindowAt < 1.6 then return end
    local attempts = math.max(0, s.requests - s.paceWindowRequests)
    local acks = math.max(0, s.attackAccepted - s.paceWindowAcks)
    local hits = math.max(0, s.attackConfirmed - s.paceWindowHits)
    s.attackInterval = .05
    if attempts == 0 then
        s.paceStatus = "Waiting for spawned NPCs"
    elseif hits > 0 then
        s.paceStatus = "Rapid mode: server-reported hits observed"
    elseif acks > 0 then
        s.paceStatus = "Rapid mode: move acknowledgements observed"
    else
        s.paceStatus = "Rapid requests sent; no confirmed damage yet"
    end
    s.paceWindowAt = now
    s.paceWindowRequests = s.requests
    s.paceWindowAcks = s.attackAccepted
    s.paceWindowHits = s.attackConfirmed
end

local function tickAttack()
    if not s.attackEnabled then return end
    if s.reviveHolding then
        s.attackStatus = "Paused while holding teammate revive"
        return
    end
    if s.botBlocking then
        s.attackStatus = "Bot AI | holding a timed defensive block"
        return
    end
    if s:IsDowned() then
        s.attackTarget = nil
        s.attackStatus = "Paused - downed or eliminated"
        return
    end
    local now = os.clock()
    local char, humanoid, root = characterReady()
    if not char then
        s.attackTarget = nil
        s.attackStatus = "Waiting for a living character"

        return
    end
    if s.lastAttackCharacter ~= char then
        s.lastAttackCharacter = char
        s.seq = finite(char:GetAttribute("MoveSeq"), 0)
        s.combo = 0
        s.nextAttack = 0
        s.attackTarget = nil
        s.attackDistance = nil
        s.attackCandidates = {}
        s.attackNearbyCount = 0
        s.attackSpawnedCount = 0
        s.attackGroupEstimate = 0
        s.nextAttackScan = 0
        s.attackBuffer = .006
        s.attackPace = 1
        s.attackInterval = .05
        s.paceWindowAt = nil
        s.paceStatus = "Fast mode: restarted after respawn"
        s.pendingAttackSeqs = {}
        s.attackAckStreak = 0
        s.attackAckAvailable = false
        s.lastExpectedAttack = .5
        s.observedSeq = finite(char:GetAttribute("MoveSeq"), 0)
        s.attackAckAvailable = false
        s.attackLastKit = nil
        s.attackLastSeq = nil
        s.attackLastAcknowledgedAt = now
        table.clear(s.recentAttackRequests)
    end
    -- MoveSeq advances are feedback, NOT proof of hit or extra damage.
    -- Keep acknowledgements for the watcher while allowing rapid requests.
    local moveSeq = finite(char:GetAttribute("MoveSeq"), nil)
    if moveSeq and moveSeq ~= s.observedSeq then
        if moveSeq > (s.observedSeq or 0) then
            local acknowledged = 0
            for i = #s.pendingAttackSeqs, 1, -1 do
                if s.pendingAttackSeqs[i].seq <= moveSeq then
                    table.remove(s.pendingAttackSeqs, i)
                    acknowledged = acknowledged + 1
                end
            end
            if acknowledged > 0 then
                s.attackAckAvailable = true
                -- One MoveSeq advance is one observed acknowledgement event,
                -- not proof that every skipped request was accepted.
                s.attackAccepted = s.attackAccepted + 1
                s.attackLastAcknowledgedAt = now
            end
        end
        s.observedSeq = moveSeq
    end
    -- Discard old outstanding requests so long sessions don't accumulate data.
    for i = #s.pendingAttackSeqs, 1, -1 do
        if now - s.pendingAttackSeqs[i].at > 3 then
            table.remove(s.pendingAttackSeqs, i)
        end
    end
    tuneAttackPace(now)
    local kit = kitName()
    if now >= s.nextAttackScan or not rootOf(s.attackTarget) then
        local found = nearestSpawnedNpc(root, kit)
        s.attackScanCount = s.attackScanCount + 1
        if found ~= s.attackTarget then
            s.attackTargetSwitches = s.attackTargetSwitches + 1
            -- When a newly reachable target appears, do not wait for the
            -- previous target's scan interval. Attack cooldown is still respected.
            s.attackTarget = found
        end
        -- 25ms scan cadence; event-driven cache updates force prompt scans.
        s.nextAttackScan = now + .025
    end
    if s.attackTarget then
        if now >= s.nextAttack then
            attackNpc(char, humanoid, root, s.attackTarget, now)
        end
    else
        s.attackDistance = nil
        s.attackStatus = "Waiting: no living NPC spawned"
    end

end

-- Independent Auto Dodge: all ground-attack danger zones are evaluated in XZ
-- even when the player is 30+ studs below the arena surface.
local function dangerScore(point, zone)
    local dx, dz = point.X-zone.center.X, point.Z-zone.center.Z
    local dist = math.sqrt(dx*dx + dz*dz)
    if zone.shape == "safe-inside" then
        return dist > zone.radius and (dist-zone.radius)*10 + 45 or 0
    end
    if zone.shape == "rectangle" and zone.dir then
        local f = zone.dir
        local forward, across = dx*f.X+dz*f.Z, -dx*f.Z+dz*f.X
        local outsideX = math.abs(forward) - (zone.halfLength or zone.radius)
        local outsideY = math.abs(across) - (zone.halfWidth or 3)
        if outsideX <= 0 and outsideY <= 0 then return 75 end
        return math.max(0, 20-math.max(outsideX, outsideY)*5)
    end
    if zone.shape == "cone" and zone.dir then
        if dist < 1 then return 80 end
        local dot=(dx*zone.dir.X+dz*zone.dir.Z)/dist
        if dot < math.cos(zone.arc or math.rad(55)) then return 0 end
    end
    local margin = zone.radius - dist
    return margin > 0 and 70 + margin*10 or math.max(0, 18 + margin*4)
end
local function flatVector(v)
    if typeof(v) ~= "Vector3" then return nil end
    local h = Vector3.new(v.X, 0, v.Z)
    return h.Magnitude > .001 and h.Unit or nil
end
local function addDanger(list, center, radius, kind, extra)
    if typeof(center) ~= "Vector3" then return end
    local zone={center=center, radius=math.clamp(finite(radius, 8),2,160),kind=kind,shape="circle"}
    if extra then for k,v in pairs(extra) do zone[k]=v end end
    list[#list+1]=zone
end
local function impactTime(value)
    local raw = finite(value, nil)
    if not raw then return nil end
    local serverNow = workspace:GetServerTimeNow()
    -- Some game builds emit match-relative timestamps.
    if raw < 100000000 and serverNow > 100000000 then
        return serverNow + raw - workspace.DistributedGameTime
    end
    return raw
end

-- Keep scheduled warning data that arrives before visible marker objects spawn.
local function registerVolleyFx(packet)
    if type(packet) ~= "table" or packet.kind ~= "volley" then return end
    local now = workspace:GetServerTimeNow()
    local at = impactTime(packet.impactAt or packet.at) or (now + 1)
    if at < now - .12 or at > now + 9 then return end
    local entries = packet.rings or packet.points or packet.marks
    if type(entries) ~= "table" then return end
    for _, entry in ipairs(entries) do
        local pos = typeof(entry) == "Vector3" and entry
            or type(entry) == "table" and (entry.pos or entry.position or entry.center)
        if typeof(pos) == "Vector3" then
            local r = type(entry) == "table" and entry.radius or packet.radius
            local duplicate = false
            for _, old in ipairs(s.eventVolleys) do
                if math.abs(old.at - at) < .2 and horizontal(old.pos, pos) < 1.5 then
                    duplicate = true
                    break
                end
            end
            if not duplicate then
                table.insert(s.eventVolleys, {pos = pos, radius = math.clamp(finite(r, 9), 2, 55), at = at})
                s.dodgeNextHazardRefresh = 0
                s.dodgeNextScan = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end
    end
end
if clientState and type(clientState.onMatchEvent) == "function" then
    local ok, connection = pcall(clientState.onMatchEvent, "challengeFx", registerVolleyFx)
    if ok and connection then table.insert(s.connections, connection) end
end
if remotes then
    local matchEvent = remotes:FindFirstChild("MatchEvent")
    if matchEvent and matchEvent:IsA("RemoteEvent") then
        connect(matchEvent.OnClientEvent, function(packet, data)
            if packet == "challengeFx" and type(data) == "table" then
                registerVolleyFx(data)
            elseif type(packet) == "table" then
                local eventKind = packet.t or packet.event or packet.type or packet.action
                if eventKind == "challengeFx" then
                    registerVolleyFx(packet.payload or packet.data or packet)
                elseif packet.kind == "volley" then
                    registerVolleyFx(packet)
                end
            end
        end)
    end
    local combatFx = remotes:FindFirstChild("CombatFx")
    if combatFx and (combatFx:IsA("RemoteEvent") or combatFx:IsA("UnreliableRemoteEvent")) then
        connect(combatFx.OnClientEvent, function(packet)
            if not s.dodgeEnabled or type(packet) ~= "table" or packet.t ~= "enemyArrow" then return end
            if typeof(packet.o) ~= "Vector3" or typeof(packet.d) ~= "Vector3" then return end
            local dir = Vector3.new(packet.d.X, 0, packet.d.Z)
            if dir.Magnitude < .01 then return end
            local char, hum, root = characterReady()
            if not root then return end
            dir = dir.Unit
            local delta = Vector3.new(root.Position.X - packet.o.X, 0, root.Position.Z - packet.o.Z)
            local along = delta:Dot(dir)
            local side = (delta - dir * along).Magnitude
            if along > 0 and along < 65 and side < 8 then
                local center = packet.o + dir * math.clamp(along, 0, 60)
                table.insert(s.projectileThreats, {pos = center, dir = dir, untilAt = os.clock() + .65})
                s.dodgeNextHazardRefresh = 0
                s.dodgeNextScan = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end)
    end
end
-- A recent hit is a fallback for attacks that expose no detectable warning.
local observedHealthHumanoid, observedHealthConnection, observedHealth = nil, nil, 0
local function bindDamageFallback(char)
    if observedHealthConnection then observedHealthConnection:Disconnect() end
    observedHealthConnection = nil
    observedHealthHumanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not observedHealthHumanoid then return end
    observedHealth = observedHealthHumanoid.Health
    observedHealthConnection = observedHealthHumanoid.HealthChanged:Connect(function(current)
        if s.dodgeEnabled and current > 0 and current < observedHealth then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                s.recentDamagePos = root.Position
                s.recentDamageUntil = os.clock() + .42
                s.dodgeNextScan = 0
                s.dodgeNextHazardRefresh = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end
        observedHealth = current
    end)
end
connect(player.CharacterAdded, function(char)
    task.defer(function() if char.Parent then bindDamageFallback(char) end end)
end)
if player.Character then bindDamageFallback(player.Character) end

local function collectDangers()
    local zones={}
    local now=workspace:GetServerTimeNow()
    for _, mark in ipairs(CollectionService:GetTagged("VolleyMark")) do
        if mark:IsDescendantOf(workspace) then
            local impact = impactTime(mark:GetAttribute("ImpactAt"))
            if not impact or (impact>=now-.12 and impact<=now+5) then
                addDanger(zones, objectivePosition(mark),
                    finite(mark:GetAttribute("Radius"),9)+2,"Volley")
            end
        end
    end
    local visual=workspace:FindFirstChild("ChallengeWorldFx")
    if visual then
        local count=0
        for _, part in ipairs(visual:GetChildren()) do
            if part:IsA("BasePart") and part.Name=="VolleyRing"
                and part.Position.Y > -1000 then
                count=count+1
                if count>80 then break end
                for _,adornment in ipairs(part:GetChildren()) do
                    if adornment:IsA("CylinderHandleAdornment") and adornment.Visible
                        and adornment.Radius>1 then
                        addDanger(zones,part.Position,adornment.Radius+2,"Volley ring")
                        break
                    end
                end
            end
        end
    end
    for _,mark in ipairs(CollectionService:GetTagged("BossMech")) do
        if mark:IsDescendantOf(workspace) and not mark:GetAttribute("Result") then
            local impact=impactTime(mark:GetAttribute("ImpactAt"))
            if not impact or (impact>=now-.12 and impact<=now+5) then
                local kind=mark:GetAttribute("Kind")
                local center=mark:GetAttribute("Center")
                if kind=="ring" then
                    addDanger(zones,center,math.max(3,finite(mark:GetAttribute("Inner"),13)-1),
                        "Boss ring",{shape="safe-inside"})
                elseif kind=="leap" then
                    addDanger(zones,center,finite(mark:GetAttribute("Radius"),10)+2,"Boss leap")
                elseif kind=="slam" or kind=="circle" or kind=="impact" or kind=="shockwave" then
                    addDanger(zones,center,finite(mark:GetAttribute("Radius"),11)+2,"Boss "..kind)
                elseif kind=="line" or kind=="charge" then
                    local direction=flatVector(mark:GetAttribute("Direction"))
                    local length=math.clamp(finite(mark:GetAttribute("Length"),25),4,75)
                    local width=math.clamp(finite(mark:GetAttribute("Width"),7),2,30)
                    if direction and typeof(center)=="Vector3" then
                        addDanger(zones,center + direction*(length/2),length/2,"Boss lane",
                            {shape="rectangle",dir=direction,halfLength=length/2+2,halfWidth=width/2+2})
                    end
                end
            end
        end
    end
    local fx=workspace:FindFirstChild("FX")
    local telegraphs=fx and fx:FindFirstChild("LocalTelegraphs")
    if telegraphs then
        local count=0
        for _,part in ipairs(telegraphs:GetChildren()) do
            if part:IsA("BasePart") and part:GetAttribute("Busy")==true
                and part.Position.Y > -1000 then
                count=count+1
                if count>80 then break end
                if part.Name=="Telegraph_disc" then
                    addDanger(zones,part.Position,math.max(part.Size.Y,part.Size.Z)/2+1.5,"NPC slam")
                elseif part.Name=="Telegraph_box" or part.Name=="Telegraph_wedge" then
                    addDanger(zones,part.Position,math.max(part.Size.X,part.Size.Z)/2+2,"NPC lane",
                        {shape="rectangle",dir=flatVector(part.CFrame.LookVector),
                         halfLength=part.Size.Z/2+2,halfWidth=part.Size.X/2+2})
                end
            end
        end
    end
    -- Windups can be detected before warning visuals appear.
    for model in pairs(s.enemies) do
        if model:GetAttribute("AIState")=="Windup" then
            local er=rootOf(model)
            if er then
                local endAt=impactTime(model:GetAttribute("WindupEnd"))
                if not endAt or (endAt>=now-.12 and endAt<=now+3) then
                    local attackId=tostring(model:GetAttribute("AttackKind") or ""):lower()
                    local id=model:GetAttribute("CreatureId") or model:GetAttribute("EnemyType")
                    local def=lookup(creatures,id)
                    -- Some builds identify Cerberus only by its model/rig name.
                    if not def and isCerberus(model) then def=lookup(creatures,"cerberus") end
                    local attacks=def and (def.attacks or def.Attacks)
                    local atk=lookup(attacks,attackId)
                    if not atk and type(attacks)=="table" then
                        for _,candidate in pairs(attacks) do
                            if type(candidate)=="table" and
                                (tostring(candidate.id or ""):lower()==attackId or
                                 tostring(candidate.kind or ""):lower()==attackId) then
                                atk=candidate
                                break
                            end
                        end
                    end
                    local kind=tostring(atk and atk.kind or attackId):lower()
                    -- Confirmed in Defs.Creatures: Cerberus uses
                    -- {id="stomp", kind="slam", radius=12, windup=1}.
                    -- Previous versions tested `attackId == "slam"` and missed it.
                    local cerberusStomp=isCerberus(model) and
                        (attackId=="stomp" or attackId=="cerberus_stomp")
                    if cerberusStomp then
                        local stompRadius=math.clamp(finite(atk and atk.radius,12),8,24)+2.5
                        local remaining=endAt and math.max(0,endAt-now) or
                            math.clamp(finite(atk and atk.windup,1),.5,1.5)
                        s.cerberusStompWarnings[model]={
                            center=er.Position, radius=stompRadius,
                            expires=now+math.max(.18,remaining)+.25
                        }
                    elseif kind=="slam" or attackId=="stomp" then
                        addDanger(zones,er.Position,finite(atk and (atk.radius or atk.range),9)+2,
                            "Windup slam")
                    elseif kind=="charge" or kind=="projectile" or kind=="lunge" then
                        local length=math.clamp(finite(atk and (atk.distance or atk.range),20),5,42)
                        addDanger(zones,er.Position + er.CFrame.LookVector*(length/2),length/2+3,
                            "Windup lane",{shape="rectangle",dir=flatVector(er.CFrame.LookVector),
                            halfLength=length/2+1,halfWidth=finite(atk and atk.width,5)/2+1.5})
                    elseif kind=="breath" or kind=="melee" then
                        local radius=finite(atk and (atk.radius or atk.range),9)
                        addDanger(zones,er.Position,radius+2,"Windup cone",
                            {shape="cone",dir=flatVector(er.CFrame.LookVector),arc=math.rad(55)})
                    end
                end
            end
        end
    end
    -- Hold the Cerberus stomp circle briefly after the windup switches to
    -- Strike/Recovery so the dodge cannot be cancelled at the exact impact.
    for model, warning in pairs(s.cerberusStompWarnings) do
        if now > warning.expires or not rootOf(model) then
            s.cerberusStompWarnings[model] = nil
        else
            addDanger(zones,warning.center,warning.radius,"Cerberus stomp")
        end
    end
    -- Preserve volley events until their impact; a missing pooled ring is not safety.
    for i=#s.eventVolleys,1,-1 do
        local item=s.eventVolleys[i]
        if now > item.at+.15 then
            table.remove(s.eventVolleys,i)
        else
            addDanger(zones,item.pos,item.radius+2,"Volley event")
        end
    end
    for i=#s.projectileThreats,1,-1 do
        local item=s.projectileThreats[i]
        if os.clock() > item.untilAt then
            table.remove(s.projectileThreats,i)
        else
            addDanger(zones,item.pos,5.5,"Incoming arrow")
        end
    end
    if s.recentDamagePos and os.clock() < s.recentDamageUntil then
        addDanger(zones,s.recentDamagePos,9,"Recent untelegraphed hit")
    end
    local sources={volley=0,arrow=0,boss=0,windup=0,cerberus=0}
    for _,zone in ipairs(zones) do
        if string.find(zone.kind,"Cerberus stomp") then sources.cerberus=sources.cerberus+1
        elseif string.find(zone.kind,"Volley") then sources.volley=sources.volley+1
        elseif string.find(zone.kind,"arrow") then sources.arrow=sources.arrow+1
        elseif string.find(zone.kind,"Boss") then sources.boss=sources.boss+1
        elseif string.find(zone.kind,"Windup") or string.find(zone.kind,"NPC") then sources.windup=sources.windup+1 end
    end
    s.hazardSources=sources
    return zones
end
-- Fast two-stage escape search: cheap mathematical scoring for all points,
-- then physical floor checks ONLY for a handful of promising destinations.
-- V14 did a raycast for every candidate on every scan, causing visible delays.
local function chooseEscape(root, zones)
    local here = root.Position
    local function score(point)
        local sum = 0
        for _, zone in ipairs(zones) do sum = sum + dangerScore(point, zone) end
        return sum
    end
    local current = score(here)
    if current <= 8 then return nil, current, 0 end

    local candidates = {}
    for _, zone in ipairs(zones) do
        if zone.shape == "safe-inside" then
            candidates[#candidates+1] = zone.center
            for i=0,7 do
                local angle = i * math.pi / 4
                local r = math.max(1,zone.radius*.42)
                candidates[#candidates+1] = zone.center + Vector3.new(math.cos(angle)*r,0,math.sin(angle)*r)
            end
        end
    end
    -- These distances are sufficient for most telegraphs while minimizing
    -- the time to select a nearby exit.
    for _, radius in ipairs({6,12,20,29}) do
        for i=0,11 do
            local angle=i*math.pi/6
            candidates[#candidates+1]=here+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius)
        end
    end
    if s.dodgeGoal then candidates[#candidates+1]=s.dodgeGoal end

    local ranked = {}
    for _, candidate in ipairs(candidates) do
        local danger = score(candidate)
        if danger < current then
            local distance = horizontal(here,candidate)
            local worst = 0
            -- A clear endpoint reached by crossing an AoE is not a safe escape.
            for step=1,3 do
                worst = math.max(worst,score(here:Lerp(candidate,step/4)))
            end
            local staying=s.dodgeGoal and horizontal(candidate,s.dodgeGoal)<2
            local cost=danger*12+worst*.16+distance*.32-(staying and 6 or 0)
            ranked[#ranked+1]={p=candidate,cost=cost}
        end
    end
    table.sort(ranked,function(a,b) return a.cost<b.cost end)

    -- Raycast at most the best eight destinations, not every sample.
    -- When farm is off, normal humanoid movement uses the same safe-goal search.
    local limit=math.min(#ranked,8)
    for index=1,limit do
        local candidate=ranked[index].p
        local groundOK=true
        if s.enabled and s.floorY then
            local hit=surfaceAt(candidate.X,candidate.Z,s.floorY+24)
            groundOK=hit ~= nil and math.abs(hit.Position.Y-s.floorY)<8
        end
        if groundOK then
            return Vector3.new(candidate.X,0,candidate.Z),current,#zones
        end
    end
    return nil,current,#zones
end
local function tickDodge()
    if not s.dodgeEnabled then return end
    if (s.parryCommitUntil or 0) > os.clock()
        and kitName() == "Gladiator" and s.method == "Legit" then
        -- Timed shield raise takes priority over stepping away.
        s.dodgeGoal, s.dodgeUntil = nil, 0
        s.dodgeStatus = "Holding position for parry"
        return
    end
    if s:IsDowned() then
        -- Do not let the independent dodge Heartbeat keep walking after a knock.
        if s.dodgeFreeMove then
            local char = player.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid:Move(Vector3.zero, false) end
        end
        s.dodgeFreeMove = false
        s.dodgeGoal = nil
        s.dodgeUntil = 0
        s.dodgeStatus = "Paused - downed or eliminated"
        return
    end
    local now=os.clock()
    if now<s.dodgeNextScan then return end
    s.dodgeNextScan=now+(s.dodgeGoal and .016 or .025)
    local char,humanoid,root=characterReady()
    if not char or not workspace:FindFirstChild("Arena") then
        s.dodgeGoal=nil
        s.dodgeStatus="Waiting for arena"

        return
    end

    -- Keep warning collection independent from decision rate. The cached scan
    -- is immediately invalidated by new Volley, BossMech, arrow and windup events.
    if now>=s.dodgeNextHazardRefresh then
        local t0=os.clock()
        s.dodgeCachedHazards=collectDangers()
        s.dodgeScanLatencyMs=(os.clock()-t0)*1000
        s.dodgeNextHazardRefresh=now+(#s.dodgeCachedHazards>0 and .045 or .075)
    end
    local zones=s.dodgeCachedHazards
    s.dodgeHazards=#zones
    local t0=os.clock()
    local escape, danger=chooseEscape(root,zones)
    s.dodgeEscapeLatencyMs=(os.clock()-t0)*1000
    s.dodgeChecks=s.dodgeChecks+1
    if s.dodgeLastEventAt>0 and s.dodgeLastReactMs==nil then
        s.dodgeLastReactMs=(os.clock()-s.dodgeLastEventAt)*1000
    end

    if escape then
        s.dodgeSafeSince=nil
        local old=s.dodgeGoal
        local oldDanger=0
        if old then
            for _,zone in ipairs(zones) do
                oldDanger=oldDanger+dangerScore(old,zone)
            end
        end
        local changed=not old or (horizontal(escape,old)>3.5 and
            (oldDanger>12 or now>s.dodgeUntil))
        if changed then
            s.dodgeGoal=escape
            s.dodgeGoalStart=now
            s.dodgeCount=s.dodgeCount+1
            s.dodgeStatus=string.format("Escaping %d warnings; danger %.0f",#zones,danger)
            -- This cancels the existing non-dodge Tween immediately.
            stopTween()
            local distance=horizontal(root.Position,escape)
            s.dodgeUntil=now+math.clamp(distance/math.max(12,s.speed)+.14,.20,1.5)
        end
        -- If we're still inside danger after reaching the expected deadline,
        -- allow a fresh decision; do not extend the deadline every Heartbeat.
        if s.dodgeGoal and now>s.dodgeUntil and danger>8 then
            s.dodgeUntil=now+.20
        end
    else
        if s.dodgeGoal then
            if danger<=8 then
                s.dodgeSafeSince=s.dodgeSafeSince or now
                -- A brief stable-safe window prevents an oscillating dodge.
                if now-s.dodgeSafeSince>=.07 then
                    s.dodgeGoal=nil
                    s.dodgeUntil=0
                    s.dodgeStatus="Safe position reached"
                end
            elseif now>s.dodgeUntil then
                s.dodgeGoal=nil
                s.dodgeStatus="Rechecking danger / no clear exit"
                s.dodgeNextHazardRefresh=0
            end
        else
            s.dodgeStatus=#zones>0 and "Monitoring warning zones" or "No visible danger"
        end
    end

    if not s.enabled then
        if s.dodgeGoal then
            local diff=Vector3.new(s.dodgeGoal.X-root.Position.X,0,s.dodgeGoal.Z-root.Position.Z)
            if diff.Magnitude>.7 then
                humanoid:Move(diff.Unit,false)
                s.dodgeFreeMove=true
            elseif s.dodgeFreeMove then
                humanoid:Move(Vector3.zero,false)
                s.dodgeFreeMove=false
            end
        elseif s.dodgeFreeMove then
            humanoid:Move(Vector3.zero,false)
            s.dodgeFreeMove=false
        end
    end

end
function s:SetAutoDodge(value)
    value=value==true
    if self.dodgeEnabled==value then return end
    self.dodgeEnabled=value
    self.dodgeNextScan=0
    self.dodgeNextHazardRefresh=0
    self.dodgeCachedHazards={}
    self.cerberusStompWarnings=setmetatable({}, {__mode="k"})
    self.dodgeSafeSince=nil
    self.dodgeLastReactMs=nil
    if value then
        self.dodgeStatus="Watching hazards"
        self.dodgeHeartbeat=RunService.Heartbeat:Connect(function()
            local ok,err=pcall(tickDodge)
            if not ok and os.clock()>(self.nextDodgeWarn or 0) then
                self.nextDodgeWarn=os.clock()+8
                warn("[HollowMoonHub Auto Dodge] "..tostring(err))
                self.dodgeStatus="Dodge error"
            end
        end)
    else
        if self.dodgeHeartbeat then self.dodgeHeartbeat:Disconnect(); self.dodgeHeartbeat=nil end
        if self.dodgeFreeMove then
            local _,humanoid=characterReady()
            if humanoid then humanoid:Move(Vector3.zero,false) end
        end
        self.dodgeFreeMove=false
        self.dodgeGoal=nil
        self.dodgeGoalStart=0
        self.dodgeUntil=0
        self.dodgeHazards=0
        self.dodgeCachedHazards={}
        self.dodgeStatus="Off"
    end
    self.dodgeNextUi=0

end


-- V45: Legit farm follows safe paths and uses CombatController's real dashes.
-- Crucially, never issue a direct MoveTo(goal) when a path is unavailable:
-- V43's direct fallback walked straight into obstacles and walls.
do
    local PathfindingService = game:GetService("PathfindingService")
    local nav = {
        char = nil, mode = "idle", target = nil, path = nil,
        blockedConnection = nil, waypoints = {}, index = 1,
        pathGoal = nil, routeEndpoint = nil, computing = false,
        token = 0, nextCompute = 0, needsRepath = false, blocked = false,
        lastMoveTo = 0, lastMovePoint = nil, lastMoveIndex = 0,
        -- V58: stable MoveTo commands, safe corner anticipation.
        nextCornerCheck = 0,
        faceRoot = nil, faceHumanoid = nil, faceAutoRotate = nil,
        faceAttachment = nil, faceAlign = nil,
        progressWaypoint = 0, progressDistance = math.huge,
        lastProgressAt = 0, stuckCount = 0, failed = false,
        lastObstacleAt = 0, nextObstacleCheck = 0,
        -- Cache short-lived ground/corridor probes to avoid 60Hz raycast spikes.
        nextShortcutCheck = 0, shortcutClear = false,
        shortcutGoal = nil, shortcutFrom = nil,
        nextLookaheadCheck = 0,
        routeFails = 0,
        cachedTacticalGoal = nil, cachedTacticalTarget = nil,
        cachedTacticalMode = nil, nextTacticalAt = 0,
        dashController = nil, nextDashModuleCheck = 0,
        lastDashAt = -100, dashRetryAt = 0,
        dashPending = nil, dashRecoveryUntil = 0,
        nextDashRollAt = 0, nextJumpRollAt = 0,
        nextDecisionAt = 0, nextRetargetAt = 0,
        strafeUntil = 0, strafeGoal = nil, strafeTarget = nil,
        retreatUntil = 0, retreatCooldown = 0, dashMode = "chase",
        lastMeaningfulProgress = 0, lastRootCheck = nil,
        nextEmergency = 0,
        roamGoal = nil, nextRoamAt = 0, nextRoamPick = 0,
        brainState = "Idle", lastBrainAt = 0,
        visionGoal = nil, visionTarget = nil, nextVisionAt = 0,
        retreatGoal = nil, retreatTarget = nil, nextEscapeAt = 0,
        tacticalEnemyPosition = nil, tacticalLastChoice = 0,
    }
    -- V53 teammate revives are separate from attack targeting. This state
    -- survives normal path replans and is reset only when a revive ends.
    local revive = {
        target = nil, owner = nil, prompt = nil, name = nil,
        nextScan = 0, nextRetry = 0, holdStarted = 0,
        holding = false, shieldActive = false, tries = 0, targetSince = 0,
        unavailableUntil = setmetatable({}, {__mode = "k"}),
        nextWarning = 0,
    }
    local function ai() return s.legitAI end
    -- Live bot observations are read-only. Replicated IsBot/Move/MoveAt,
    -- Dashing and Blocking identify actual friendly bot activity, but not
    -- the server's private intentions or an exact bot movement algorithm.
    local botSense = {
        nextAlliesAt = 0, allies = {}, lastDashAt = -100,
        lastMoveAt = -100, lastBlockAt = -100, strafeSign = 0,
        liveCount = 0, threatAt = 0, blockCooldown = 0,
        parryReleaseAt = 0, parryNextAt = 0, parryTarget = nil,
    }
    local blockRemote = remotes and remotes:FindFirstChild("Block")
    if blockRemote and not blockRemote:IsA("RemoteEvent") then blockRemote = nil end
    local function setBotBlock(active)
        active = active == true
        if s.botBlocking == active then return end
        if active and (not blockRemote or s:IsDowned()) then return end
        s.botBlocking = active
        if blockRemote then
            pcall(function()
                blockRemote:FireServer(active,
                    active and workspace:GetServerTimeNow() or nil)
            end)
        end
    end
    function s:ReleaseBotBlock()
        self.parryCommitUntil = 0
        botSense.parryReleaseAt = 0
        botSense.parryTarget = nil
        setBotBlock(false)
    end

    local function discardPath()
        if nav.blockedConnection then
            nav.blockedConnection:Disconnect()
            nav.blockedConnection = nil
        end
        if nav.path then
            nav.path:Destroy()
            nav.path = nil
        end
        nav.waypoints = {}
        nav.index = 1
        nav.routeEndpoint = nil
        nav.pathGoal = nil
        nav.lastMovePoint = nil
        nav.lastMoveIndex = 0
        nav.nextCornerCheck = 0
        nav.progressWaypoint = 0
        nav.progressDistance = math.huge
        nav.nextLookaheadCheck = 0
    end

    local function halt(humanoid, root)
        if humanoid and root and humanoid.Parent and root.Parent then
            -- Stop pending path commands when downed, changing targets or reviving.
            humanoid:Move(Vector3.zero, false)
            humanoid:MoveTo(root.Position)
        end
        nav.lastMovePoint = nil
        nav.lastMoveIndex = 0
    end

    -- V57: turning is independent of world-space steering. An AlignOrientation
    -- smoothly faces the actual Auto Attack target without CFrame teleporting
    -- the root or forcing movement toward that target.
    local function releaseBotFacing()
        if nav.faceAlign then nav.faceAlign:Destroy(); nav.faceAlign = nil end
        if nav.faceAttachment then nav.faceAttachment:Destroy(); nav.faceAttachment = nil end
        if nav.faceHumanoid and nav.faceHumanoid.Parent
            and nav.faceAutoRotate ~= nil then
            nav.faceHumanoid.AutoRotate = nav.faceAutoRotate
        end
        nav.faceRoot, nav.faceHumanoid, nav.faceAutoRotate = nil, nil, nil
    end

    local function updateBotFacing(humanoid, root, now)
        if not s.legitCombatFacing or s:IsDowned()
            or nav.mode == "dodge"
            or nav.dashPending or now < nav.dashRecoveryUntil
            or (nav.char and nav.char:GetAttribute("Dashing")) then
            if nav.faceAlign then nav.faceAlign.Enabled = false end
            if nav.faceHumanoid and nav.faceAutoRotate ~= nil then
                nav.faceHumanoid.AutoRotate = nav.faceAutoRotate
            end
            return
        end
        local enemyRoot
        if revive.holding or s.botBlocking then
            -- Blocking only protects the forward shield arc. Aim at the
            -- predicted parry attacker first, otherwise the closest threat.
            if now < botSense.parryReleaseAt then
                enemyRoot = rootOf(botSense.parryTarget)
            end
            local closest = enemyRoot and 0 or 18
            for model in pairs(s.enemies) do
                local part = rootOf(model)
                if part then
                    local gap = horizontal(root.Position, part.Position)
                    if gap < closest then enemyRoot, closest = part, gap end
                end
            end
        end
        if not enemyRoot then
            enemyRoot = s.attackEnabled and rootOf(s.attackTarget) or nil
        end
        if not enemyRoot then enemyRoot = rootOf(s.target) end
        if not enemyRoot then
            if nav.faceAlign then nav.faceAlign.Enabled = false end
            if nav.faceHumanoid and nav.faceAutoRotate ~= nil then
                nav.faceHumanoid.AutoRotate = nav.faceAutoRotate
            end
            return
        end
        if nav.faceRoot ~= root then
            releaseBotFacing()
            nav.faceRoot, nav.faceHumanoid = root, humanoid
            nav.faceAutoRotate = humanoid.AutoRotate
            local attachment = Instance.new("Attachment")
            attachment.Name = "HollowMoonBotFacingAttachment"
            attachment.Parent = root
            local orient = Instance.new("AlignOrientation")
            orient.Name = "HollowMoonBotCombatFacing"
            orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
            orient.Attachment0 = attachment
            orient.RigidityEnabled = false
            orient.Responsiveness = 55
            orient.MaxTorque = 1000000
            orient.MaxAngularVelocity = 40
            orient.Enabled = false
            orient.Parent = root
            nav.faceAttachment, nav.faceAlign = attachment, orient
        end
        local offset = enemyRoot.Position - root.Position
        local flat = Vector3.new(offset.X, 0, offset.Z)
        if flat.Magnitude > .12 then
            humanoid.AutoRotate = false
            nav.faceAlign.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit, Vector3.yAxis)
            nav.faceAlign.Enabled = true
        end
    end

    -- V58: path following always uses Humanoid:MoveTo(). PreSimulation owns
    -- ONLY facing, never walking, so it cannot fight the waypoint controller.
    connect(RunService.PreSimulation, function()
        if not s.enabled or s.method ~= "Legit" then return end
        local char = nav.char
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if humanoid and root and humanoid.Health > 0 then
            updateBotFacing(humanoid, root, os.clock())
        end
    end)

    local function resetRoute(humanoid, root)
        -- Invalidate outstanding ComputeAsync results on stop, respawn,
        -- a new target, or an emergency dodge.
        nav.token = nav.token + 1
        nav.computing = false
        discardPath()
        nav.needsRepath = false
        nav.blocked = false
        nav.failed = false
        nav.nextCompute = 0
        nav.lastMoveTo = 0
        nav.lastProgressAt = 0
        nav.stuckCount = 0
        nav.nextObstacleCheck = 0
        nav.nextShortcutCheck = 0
        nav.shortcutClear = false
        nav.shortcutGoal, nav.shortcutFrom = nil, nil
        nav.cachedTacticalGoal, nav.cachedTacticalTarget = nil, nil
        nav.cachedTacticalMode, nav.nextTacticalAt = nil, 0
        nav.tacticalEnemyPosition, nav.tacticalLastChoice = nil, 0
        nav.routeFails = 0
        nav.dashPending = nil
        nav.dashRecoveryUntil = 0
        nav.nextDecisionAt = 0
        nav.strafeUntil = 0
        nav.strafeGoal = nil
        nav.strafeTarget = nil
        nav.retreatUntil = 0
        nav.retreatCooldown = 0
        nav.nextRetargetAt = 0
        nav.roamGoal = nil
        nav.retreatGoal, nav.retreatTarget, nav.nextEscapeAt = nil, nil, 0
        nav.nextRoamAt = 0
        nav.nextRoamPick = 0
        nav.brainState = "Idle"
        nav.lastMeaningfulProgress = os.clock()
        nav.lastRootCheck = nil
        halt(humanoid, root)
    end

    -- Release an active hold before resetting movement so a disabled toggle,
    -- downed state or method switch never leaves E held on a revive prompt.
    local function cancelReviveHold()
        if revive.holding and revive.prompt and revive.prompt.Parent then
            pcall(function() revive.prompt:InputHoldEnd() end)
        end
        if revive.shieldActive then
            setBotBlock(false)
            revive.shieldActive = false
        end
        revive.holding = false
        revive.holdStarted = 0
        s.reviveHolding = false
    end

    function s:CancelReviveHold()
        cancelReviveHold()
        revive.target, revive.owner, revive.prompt, revive.name = nil, nil, nil, nil
        revive.tries, revive.nextRetry, revive.nextScan = 0, 0, 0
        self.reviveStatus = self.reviveEnabled and "Scanning teammates" or "Off"
    end

    function s:SetAutoReviveTeammates(enabled)
        self.reviveEnabled = enabled == true
        if not self.reviveEnabled then
            self:CancelReviveHold()
            if nav.mode == "revive" then
                local _, human, part = characterReady()
                resetRoute(human, part)
                nav.mode = "idle"
                nav.target = nil
            end
        else
            revive.nextScan = 0
            self.reviveStatus = "Watching for downed teammates (Bot AI)"
        end
    end

    function s:StopLegitFarm()
        self:ReleaseBotBlock()
        self:CancelReviveHold()
        local _, humanoid, root = characterReady()
        resetRoute(humanoid, root)
        releaseBotFacing()
        nav.char = nil
        nav.mode = "idle"
        nav.target = nil
    end

    -- Aim at a walkable floor level. For an enemy above the player (jumping),
    -- never request an airborne target position from PathfindingService.
    local function surfaceGoal(x, z, expectedY, humanoid, root)
        local hit = surfaceAt(x, z, expectedY + 30)
        if not hit then
            -- Some arena floors live outside the Arena container. Raycast
            -- against physical world geometry as a fallback, excluding NPCs.
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            local exclude = {nav.char}
            local enemyFolder = workspace:FindFirstChild("ActiveEnemies")
            if enemyFolder then table.insert(exclude, enemyFolder) end
            if s.platform then table.insert(exclude, s.platform) end
            if s.focus then table.insert(exclude, s.focus) end
            params.FilterDescendantsInstances = exclude
            params.IgnoreWater = true
            pcall(function() params.RespectCanCollide = true end)
            local fallback = workspace:Raycast(Vector3.new(x, expectedY + 24, z),
                Vector3.new(0, -105, 0), params)
            if fallback and fallback.Normal.Y > 0.7 then hit = fallback end
        end
        if not hit then return nil end
        local footHeight = humanoid.HipHeight + root.Size.Y * .5
        return Vector3.new(x, hit.Position.Y + footHeight, z)
    end

    local function rayParams(char)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local exclude = {char}
        if s.focus then table.insert(exclude, s.focus) end
        if s.platform then table.insert(exclude, s.platform) end
        params.FilterDescendantsInstances = exclude
        params.IgnoreWater = true
        -- Sensor should only stop for physical blockers, not visual FX.
        pcall(function() params.RespectCanCollide = true end)
        return params
    end

    -- Inspect the corridor to the next waypoint, not the entire distance to
    -- the enemy (an indirect valid path can have many walls between endpoints).
    local function obstacleAhead(char, root, waypoint)
        local flat = Vector3.new(waypoint.X - root.Position.X, 0,
            waypoint.Z - root.Position.Z)
        if flat.Magnitude < 1 then return false end
        local direction = flat.Unit
        -- Never look beyond the active waypoint into an upcoming path corner.
        local distance = math.min(flat.Magnitude, ai().obstacleRange, 5)
        local sideways = Vector3.new(-direction.Z, 0, direction.X)
        local params = rayParams(char)
        for _, lane in ipairs({0, -0.65, 0.65}) do
            local origin = root.Position + sideways * lane - Vector3.new(0, 0.25, 0)
            local result = workspace:Raycast(origin, direction * distance, params)
            if result and result.Instance and result.Instance.CanCollide then
                return true
            end
        end
        return false
    end

    -- A direct walking segment is allowed ONLY after checking the whole
    -- corridor (three lanes, two body heights) and sampled ground support.
    -- This makes open paths immediate while keeping corners/ledges path-driven.
    local function clearWalkingCorridor(char, humanoid, root, destination, limit)
        local delta = destination - root.Position
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local length = flat.Magnitude
        if length < 0.8 then return true end
        if length > (limit or 23) or math.abs(delta.Y) > 2.6 then return false end
        local direction = flat.Unit
        local sideways = Vector3.new(-direction.Z, 0, direction.X)
        local params = rayParams(char)
        for _, side in ipairs({0, -1.1, 1.1}) do
            for _, height in ipairs({-0.3, 1.0}) do
                local origin = root.Position + sideways * side + Vector3.new(0, height, 0)
                local hit = workspace:Raycast(origin, direction * length, params)
                if hit and hit.Instance and hit.Instance.CanCollide then
                    return false
                end
            end
        end
        local previousY = root.Position.Y
        local steps = math.ceil(length / 2.6)
        for i = 1, steps do
            local sample = root.Position + direction * (length * i / steps)
            local ground = surfaceGoal(sample.X, sample.Z, previousY, humanoid, root)
            if not ground or math.abs(ground.Y - previousY) > 2.8 then
                return false
            end
            previousY = ground.Y
        end
        return true
    end

    -- Do not choose an enemy-centered goal that is inside a wall or model.
    -- Try nearby approach angles if the preferred behind-enemy point is not
    -- connected to the navigable mesh. This retains normal walk locomotion.
    local function candidateGoals(root, goal, humanoid)
        local out = {goal}
        local flat = Vector3.new(goal.X - root.Position.X, 0,
            goal.Z - root.Position.Z)
        local forward = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local side = Vector3.new(-forward.Z, 0, forward.X)
        local sidestep = math.min(9, math.max(3, ai().obstacleRange * 0.18))
        local offsets = {side * sidestep, -side * sidestep}
        if nav.stuckCount > 0 or nav.routeFails > 0 then
            table.insert(offsets, side * 9 + forward * 3)
            table.insert(offsets, -side * 9 + forward * 3)
        end
        -- Choose a different flank after consecutive failures rather than
        -- repeatedly computing the same unreachable goal first.
        if (nav.routeFails + nav.stuckCount) % 2 == 1 then
            offsets[1], offsets[2] = offsets[2], offsets[1]
        end
        for _, delta in ipairs(offsets) do
            local alt = surfaceGoal(goal.X + delta.X, goal.Z + delta.Z,
                goal.Y, humanoid, root)
            if alt then table.insert(out, alt) end
        end
        return out
    end

    -- V58: retain the smooth native MoveTo behavior. A fixed waypoint needs
    -- ONE command, not a duplicate every 0.15s. Moving enemy goals update
    -- when they shift meaningfully, without creating turn jitter.
    local function moveTo(humanoid, position, now, waypointIndex)
        local direct = waypointIndex == -1
        local switched = nav.lastMoveIndex ~= waypointIndex
        local drift = nav.lastMovePoint
            and horizontal(nav.lastMovePoint, position) or math.huge
        local changed = not nav.lastMovePoint or switched
            or drift >= (direct and 1.2 or 0.65)
        local refresh = direct and math.max(0.36,
            math.min(0.7, ai().moveInterval * 3)) or 1.5
        if (changed and (switched or now - nav.lastMoveTo >= 0.15))
            or now - nav.lastMoveTo >= refresh then
            humanoid:MoveTo(position)
            nav.lastMoveTo = now
            nav.lastMovePoint = position
            nav.lastMoveIndex = waypointIndex
        end
    end

    local function beginPath(char, humanoid, root, goal, now)
        if nav.computing then return end
        nav.computing = true
        nav.needsRepath = false
        nav.nextCompute = now + (nav.mode == "dodge" and 0.09
            or math.clamp(ai().moveInterval * .7, .08, .75))
        nav.token = nav.token + 1
        local requestId = nav.token
        local expectedChar, expectedMode, expectedTarget = nav.char, nav.mode, nav.target
        local start = root.Position
        local goals = candidateGoals(root, goal, humanoid)
        -- Prefer the side of a persistent obstruction, but keep normal
        -- approach selection stable while the path is clear.
        if (nav.stuckCount > 0 or nav.routeFails > 0) and #goals >= 3 then
            local slot = 2 + ((nav.stuckCount + nav.routeFails) % 2)
            goals[1], goals[slot] = goals[slot], goals[1]
        end
        task.spawn(function()
            local foundPath, foundPoints, endpoint
            local lastError
            for i, candidate in ipairs(goals) do
                -- Config.Enemy.MaxPathsPerTick: limit route candidates per retry.
                if i > ai().maxPaths then break end
                local path
                local ok, err = pcall(function()
                    path = PathfindingService:CreatePath({
                        AgentRadius = 2,
                        AgentHeight = 5,
                        AgentCanJump = ai().climbMode ~= "Off",
                        AgentCanClimb = ai().climbMode == "Jump + Truss",
                        WaypointSpacing = 3,
                    })
                    path:ComputeAsync(start, candidate)
                end)
                if nav.token ~= requestId or not s.enabled
                    or s.method ~= "Legit" or nav.char ~= expectedChar
                    or nav.mode ~= expectedMode or nav.target ~= expectedTarget
                    or not root.Parent then
                    if path then path:Destroy() end
                    return
                end
                if ok and path and path.Status == Enum.PathStatus.Success then
                    local points = path:GetWaypoints()
                    if #points >= 2 then
                        foundPath, foundPoints, endpoint = path, points, candidate
                        break
                    end
                end
                if not ok then lastError = err end
                if path then path:Destroy() end
            end

            nav.computing = false
            if foundPath then
                discardPath()
                nav.needsRepath = false
                nav.path = foundPath
                nav.waypoints = foundPoints
                nav.index = 2
                nav.pathGoal = goal
                nav.routeEndpoint = endpoint
                nav.failed = false
                nav.blocked = false
                nav.routeFails = 0
                nav.lastMoveTo = 0
                nav.lastProgressAt = os.clock()
                nav.lastMeaningfulProgress = os.clock()
                nav.blockedConnection = foundPath.Blocked:Connect(function(blockedIndex)
                    if blockedIndex >= nav.index then
                        nav.blocked = true
                        nav.needsRepath = true
                        nav.nextCompute = 0
                    end
                end)
            else
                -- A failed path must NOT become a direct MoveTo through a wall.
                halt(humanoid, root)
                discardPath()
                nav.needsRepath = false
                nav.pathGoal = goal
                nav.failed = true
                nav.routeFails = math.min(6, nav.routeFails + 1)
                nav.blocked = false
                -- Back off a little on repeated failures, but don't stall
                -- a second or more before trying a new side of the obstacle.
                nav.nextCompute = os.clock() + math.min(0.85,
                    0.32 + 0.10 * nav.routeFails)
                if lastError and os.clock() >= (s.legitPathWarningAt or 0) then
                    s.legitPathWarningAt = os.clock() + 10
                    warn("[HollowMoonHub Legit Farm] Route calculation failed: " .. tostring(lastError))
                end
            end
        end)
    end

    -- V45: Use GloryBound's real CombatController.dash(), NOT a made-up remote.
    -- The controller itself chooses direction from Humanoid.MoveDirection, applies
    -- the local dash-slide physics/FX, and enforces the game's actual cooldown.
    local function dashController(now)
        if nav.dashController and type(nav.dashController.dash) == "function" then
            return nav.dashController
        end
        if now < nav.nextDashModuleCheck then return nil end
        nav.nextDashModuleCheck = now + 2
        local scripts = player:FindFirstChild("PlayerScripts")
        local folder = scripts and scripts:FindFirstChild("Controllers")
        local module = folder and folder:FindFirstChild("CombatController")
        if not (module and module:IsA("ModuleScript")) then return nil end
        local ok, result = pcall(require, module)
        if ok and type(result) == "table" and type(result.dash) == "function" then
            nav.dashController = result
            return result
        end
        return nil
    end

    local function dashAvailable(now, humanoid, char)
        if s.legitSmartDash == false or now < nav.dashRetryAt
            or now - nav.lastDashAt < 0.25 or nav.dashPending
            or now < nav.dashRecoveryUntil then return nil end
        if char:GetAttribute("Downed") or char:GetAttribute("Stunned")
            or char:GetAttribute("AttackDisabled")
            or humanoid.FloorMaterial == Enum.Material.Air
            or humanoid.Sit then return nil end
        local controller = dashController(now)
        if not controller then return nil end
        if type(controller.isActive) == "function" then
            local ok, active = pcall(controller.isActive)
            if not ok or not active then return nil end
        end
        if type(controller.getCooldowns) == "function" then
            local ok, cd = pcall(controller.getCooldowns)
            if not ok or type(cd) ~= "table" or tonumber(cd.dash) == nil
                or tonumber(cd.dash) > .04 then return nil end
        else
            -- No verified cooldown info: do not spam guesses into the game.
            return nil
        end
        return controller
    end

    -- Dash reach can grow with Agility upgrades. Read the same StatSheet or
    -- shared Formula the game's CombatController uses and leave 3 studs margin.
    local function dashSafeDistance()
        local state = currentSnapshot()
        local stats = type(state.StatSheet) == "table" and state.StatSheet or nil
        local actual = finite(stats and stats.dashDistance, nil)
        if not actual and formulas and type(formulas.dashDistance) == "function" then
            local skills = type(state.Skills) == "table" and state.Skills or nil
            local agility = finite(skills and skills.Agility, 0)
            local ok, value = pcall(formulas.dashDistance, agility)
            if ok then actual = finite(value, nil) end
        end
        if not actual then actual = 16 end
        return math.clamp(actual + 3, 8, 100)
    end

    -- Never dash through a navmesh corner, obstacle, ledge or nearby target.
    local function safeDashLine(char, humanoid, root, direction, distance)
        local flat = Vector3.new(direction.X, 0, direction.Z)
        if flat.Magnitude < .9 then return false end
        local dir = flat.Unit
        local sideways = Vector3.new(-dir.Z, 0, dir.X)
        local params = rayParams(char)
        for _, side in ipairs({0, -1.05, 1.05}) do
            for _, height in ipairs({-0.7, 1.2}) do
                local start = root.Position + sideways * side + Vector3.new(0, height, 0)
                local hit = workspace:Raycast(start, dir * distance, params)
                if hit and hit.Instance and hit.Instance.CanCollide then return false end
            end
        end
        -- Stable terrain for the full slide, not just an apparently free wall ray.
        for fraction = 0.25, 1, 0.25 do
            local point = root.Position + dir * (distance * fraction)
            local ground = surfaceGoal(point.X, point.Z, root.Position.Y, humanoid, root)
            if not ground or math.abs(ground.Y - root.Position.Y) > 3.6 then
                return false
            end
        end
        return true
    end

    local function straightRouteAhead(root, direction, distance)
        local waypoints = nav.waypoints
        local index = nav.index
        if not nav.path or index > #waypoints then return false end
        local origin = root.Position
        local dir = Vector3.new(direction.X, 0, direction.Z).Unit
        local reached = 0
        -- A dash can traverse only a straight stretch of a computed safe path.
        for i = index, #waypoints do
            local offset = waypoints[i].Position - origin
            local flat = Vector3.new(offset.X, 0, offset.Z)
            local forward = flat:Dot(dir)
            local lateral = (flat - dir * forward).Magnitude
            if forward < -1 or lateral > 2.5
                or waypoints[i].Action == Enum.PathWaypointAction.Jump
                or math.abs(offset.Y) > 3.5 then return false end
            reached = math.max(reached, forward)
            if reached >= distance + 1 then return true end
        end
        return false
    end

    local function safeDashLanding(root, direction, distance)
        if nav.mode ~= "dodge" then return true end
        local endpoint = root.Position + direction.Unit * distance
        local score = 0
        local actualLanding = root.Position + direction.Unit * (distance - 3)
        for _, danger in ipairs(s.dodgeCachedHazards or {}) do
            score = score + math.max(dangerScore(endpoint, danger),
                dangerScore(actualLanding, danger))
        end
        return score <= 5
    end

    local function prepareDash(char, humanoid, root, now, goal, reason)
        if not dashAvailable(now, humanoid, char) then return false end
        if now < nav.nextDashRollAt then return false end
        if ai().reserveDash and (reason == "chase" or reason == "strafe") then
            local hp = humanoid.MaxHealth > 0 and humanoid.Health / humanoid.MaxHealth or 1
            -- An imminent windup should keep dash charges for emergency evasion.
            -- Distance and windup are replicated observations, not hidden AI intent.
            local imminent = false
            if ai().predictThreats then
                local serverNow = workspace:GetServerTimeNow()
                for enemy in pairs(s.enemies) do
                    local er = rootOf(enemy)
                    if er and horizontal(er.Position, root.Position) < 15 then
                        local ending = tonumber(enemy:GetAttribute("WindupEnd"))
                        local state = tostring(enemy:GetAttribute("AIState") or ""):lower()
                        if (ending and ending >= serverNow - .1 and ending <= serverNow + 1.1)
                            or state:find("windup", 1, true) then
                            imminent = true
                            break
                        end
                    end
                end
            end
            if imminent or hp < .37 then return false end
        end
        local chance = reason == "evade" and ai().dashEvade
            or reason == "retreat" and ai().dashRetreat
            or reason == "strafe" and ai().dashStrafe
            or ai().dashEngage
        nav.nextDashRollAt = now + (reason == "evade" and .32 or .72)
        if ai().observeLiveBots and reason == "chase"
            and now - botSense.lastDashAt < 1.2 then
            chance = math.min(100, chance + 12)
        end
        if math.random(1, 100) > chance then return false end
        local offset = goal - root.Position
        local flat = Vector3.new(offset.X, 0, offset.Z)
        local distance = dashSafeDistance()
        if flat.Magnitude < (reason == "strafe" and 3
            or distance + (reason == "evade" and 2 or 5)) then return false end
        local dir = flat.Unit
        -- For urgent evasion, a fully clear, grounded straight corridor is
        -- enough: waiting for ComputeAsync could miss the enemy's windup.
        if (nav.mode ~= "dodge" and reason ~= "strafe"
            and not straightRouteAhead(root, dir, distance))
            or not safeDashLine(char, humanoid, root, dir, distance)
            or not safeDashLanding(root, dir, distance) then return false end
        nav.dashPending = {direction = dir, distance = distance,
            created = now, reason = reason}
        -- Dash temporarily takes movement ownership; normal path resumes after.
        if nav.faceAlign then nav.faceAlign.Enabled = false end
        humanoid.AutoRotate = true
        humanoid:Move(dir, false)
        s.status = "Bot AI | positioning for " .. reason .. " dash"
        return true
    end

    local function updateDash(char, humanoid, root, now)
        if now < nav.dashRecoveryUntil then
            s.status = "Bot AI | dash movement"
            return true
        end
        local pending = nav.dashPending
        if not pending then return false end
        if now - pending.created > 0.28 then
            nav.dashPending = nil
            nav.dashRetryAt = now + 0.7
            nav.lastMovePoint = nil
            return false
        end
        local direction = pending.direction
        humanoid.AutoRotate = true
        humanoid:Move(direction, false)
        local look = root.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local moving = humanoid.MoveDirection
        if flatLook.Magnitude < .8 or flatLook.Unit:Dot(direction) < .83
            or moving.Magnitude < .45 or moving.Unit:Dot(direction) < .8 then
            s.status = "Bot AI | facing for dash"
            return true
        end
        -- The pending dash already passed the initial gate. Check the real
        -- controller again before executing in case gameplay state changed.
        local controller = dashController(now)
        if not controller then
            nav.dashPending = nil
            return false
        end
        if char:GetAttribute("Downed") or char:GetAttribute("Stunned")
            or humanoid.FloorMaterial == Enum.Material.Air then
            nav.dashPending = nil
            return false
        end
        local okCooldown, cd = pcall(controller.getCooldowns)
        if not okCooldown or type(cd) ~= "table" or (tonumber(cd.dash) or 999) > .04 then
            nav.dashPending = nil
            return false
        end
        if not safeDashLine(char, humanoid, root, direction, pending.distance)
            or not safeDashLanding(root, direction, pending.distance) then
            nav.dashPending = nil
            nav.dashRetryAt = now + .8
            return false
        end
        local ok, didDash = pcall(controller.dash)
        nav.dashPending = nil
        if ok and didDash == true then
            nav.lastDashAt = now
            nav.dashRecoveryUntil = now + .27
            nav.lastMovePoint = nil
            nav.lastMoveIndex = 0
            -- Forget old waypoints after the actual dash completes; continuing
            -- from the pre-dash route would tug the player back toward walls.
            nav.needsRepath = true
            nav.blocked = true
            nav.nextCompute = nav.dashRecoveryUntil
            s.status = "Bot AI | " .. pending.reason .. " dash"
            return true
        end
        nav.dashRetryAt = now + 1
        return false
    end

    local function followRoute(char, humanoid, root, goal, now)
        if updateDash(char, humanoid, root, now) then return end
        -- Progress by either shortcuts or waypoints counts as movement.
        if not nav.lastRootCheck or horizontal(root.Position, nav.lastRootCheck) > 1.2 then
            nav.lastRootCheck = root.Position
            nav.lastMeaningfulProgress = now
        end
        if nav.pathGoal and horizontal(nav.pathGoal, goal) > 6 then
            nav.needsRepath = true
        end
        if now - nav.lastMeaningfulProgress > ai().rescueTime
            and now > nav.nextEmergency and not nav.computing then
            nav.nextEmergency = now + ai().rescueTime
            nav.routeFails = math.max(nav.routeFails, 3)
            nav.needsRepath = true
            nav.blocked = true
            -- Unlike the server's bots, Legit uses no emergency teleport.
            if ai().climbMode ~= "Off" then humanoid.Jump = true end
            s.status = "Bot AI | recovery: switching approach"
        end
        -- A visible, ground-supported route is quicker than waiting for
        -- ComputeAsync. The cached test expires quickly as both actors move.
        local checkShortcut = now >= nav.nextShortcutCheck
            or not nav.shortcutFrom or not nav.shortcutGoal
            or horizontal(nav.shortcutFrom, root.Position) > 3
            or horizontal(nav.shortcutGoal, goal) > 2.5
        if checkShortcut then
            nav.nextShortcutCheck = now + math.clamp(ai().moveInterval * .5, .08, .35)
            nav.shortcutFrom, nav.shortcutGoal = root.Position, goal
            nav.shortcutClear = clearWalkingCorridor(char, humanoid, root, goal,
                math.min(ai().obstacleRange, 36))
        end
        if nav.shortcutClear then
            -- Do not cancel an ongoing server computation: its token still
            -- checks the active character/mode when it eventually returns.
            moveTo(humanoid, goal, now, -1)
            s.status = "Bot AI | clear ground - direct approach"
            return
        end
        -- If the old path is known to be blocked, stop immediately instead
        -- of continuing along stale waypoints while another ComputeAsync runs.
        if nav.blocked then
            halt(humanoid, root)
            discardPath()
            nav.blocked = false
            nav.needsRepath = true
            nav.nextCompute = 0
        end
        if (nav.needsRepath or not nav.path) and not nav.computing
            and now >= nav.nextCompute then
            beginPath(char, humanoid, root, goal, now)
        end

        local points = nav.waypoints
        local index = nav.index
        while index <= #points do
            local wp = points[index]
            if (root.Position - wp.Position).Magnitude <= 2.5
                or (horizontal(root.Position, wp.Position) <= 1.9
                    and math.abs(root.Position.Y - wp.Position.Y) <= 5) then
                index = index + 1
            else
                break
            end
        end
        if nav.index ~= index then
            nav.index = index
            nav.lastMovePoint = nil
            nav.progressWaypoint = 0
            nav.lastProgressAt = now
            -- Preserve stuck history long enough to choose a new flank.
            nav.stuckCount = math.max(0, nav.stuckCount - 1)
        end

        -- V58: round close corners without stopping at an already-visible
        -- waypoint. Use the SAME collision + floor test as route shortcuts;
        -- if the direct lane is blocked, preserve the exact path corner.
        if index < #points and now >= nav.nextCornerCheck then
            nav.nextCornerCheck = now + 0.18
            local current = points[index]
            local following = points[index + 1]
            if horizontal(root.Position, current.Position) <= 4.2
                and current.Action ~= Enum.PathWaypointAction.Jump
                and following.Action ~= Enum.PathWaypointAction.Jump
                and clearWalkingCorridor(char, humanoid, root,
                    following.Position, math.min(ai().obstacleRange, 12)) then
                index = index + 1
                nav.index = index
                nav.progressWaypoint = 0
                nav.lastMovePoint = nil
            end
        end

        -- Skip several tiny waypoints only when the complete lane and
        -- intermediate walking waypoints are demonstrably clear and flat.
        if now >= nav.nextLookaheadCheck and index <= #points then
            -- Limit expensive multi-ray ground checks on mobile to at most
            -- two candidates per quarter-second while retaining shortcuts.
            nav.nextLookaheadCheck = now + math.clamp(ai().moveInterval, .12, .65)
            local furthest = math.min(index + 5, #points)
            for _, look in ipairs({furthest, math.min(index + 2, #points)}) do
                local possible = true
                for j = index, look do
                    local wpj = points[j]
                    if wpj.Action == Enum.PathWaypointAction.Jump
                        or math.abs(wpj.Position.Y - root.Position.Y) > 2.6 then
                        possible = false
                        break
                    end
                end
                if possible and clearWalkingCorridor(char, humanoid, root,
                    points[look].Position, math.min(ai().obstacleRange, 36)) then
                    index = look
                    nav.index = look
                    nav.progressWaypoint = 0
                    nav.lastMovePoint = nil
                    break
                end
            end
        end

        if index > #points then
            -- The route ended but the target moved or was never truly reached.
            -- Recalculate, never walk directly across intervening obstacles.
            if #points > 0 then
                halt(humanoid, root)
                discardPath()
                nav.needsRepath = true
                nav.nextCompute = 0
            end
            if not nav.computing and now >= nav.nextCompute then
                beginPath(char, humanoid, root, goal, now)
            end
            if nav.lastMovePoint then halt(humanoid, root) end
            s.status = nav.failed and "Bot AI | no walkable route; retrying"
                or "Bot AI | calculating safe route"
            return
        end

        local wp = points[index]
        local distance = horizontal(root.Position, wp.Position)
        if nav.progressWaypoint ~= index then
            nav.progressWaypoint = index
            nav.progressDistance = distance
            nav.lastProgressAt = now
            nav.lastMeaningfulProgress = now
        elseif distance < nav.progressDistance - 0.65 then
            nav.progressDistance = distance
            nav.lastProgressAt = now
            nav.lastMeaningfulProgress = now
        elseif now - nav.lastProgressAt > ai().stuckTime then
            nav.stuckCount = nav.stuckCount + 1
            nav.needsRepath = true
            nav.blocked = true
            nav.nextCompute = 0
            nav.lastProgressAt = now
            if ai().climbMode ~= "Off" then humanoid.Jump = true end
            s.status = "Bot AI | stuck; finding another route"
            return
        end

        if now >= nav.nextObstacleCheck then
            nav.nextObstacleCheck = now + ai().obstacleInterval
            if wp.Action ~= Enum.PathWaypointAction.Jump
                and obstacleAhead(char, root, wp.Position) then
                nav.lastObstacleAt = now
                nav.stuckCount = nav.stuckCount + 1
                nav.blocked = true
                nav.needsRepath = true
                nav.nextCompute = 0
                halt(humanoid, root)
                s.status = "Bot AI | wall ahead; rerouting"
                return
            end
        end

        if wp.Action == Enum.PathWaypointAction.Jump
            and ai().climbMode ~= "Off" then
            local rise = wp.Position.Y - root.Position.Y
            if rise <= ai().climbRise then
                humanoid.Jump = true
            else
                -- The selected jump-rise test is too low for this waypoint.
                nav.blocked = true
                nav.needsRepath = true
                nav.nextCompute = 0
                halt(humanoid, root)
                s.status = "Bot AI | jump exceeds selected rise; rerouting"
                return
            end
        end
        local dashReason = nav.mode == "dodge" and "evade" or nav.dashMode or "chase"
        if prepareDash(char, humanoid, root, now, goal, dashReason) then return end
        moveTo(humanoid, wp.Position, now, index)
        s.status = "Bot AI | navigating around obstacles " .. index .. "/" .. #points
    end

    -- V52 Bot Brain: multi-factor target evaluation (game-bot-inspired).
    -- This only selects a destination. The separate Attack remote is never
    -- restricted by distance, visibility, or the tactical target score.
    -- V54: Unlike V53, squad awareness includes real match bots in
    -- Workspace.ArenaBots, not just Players:GetPlayers(). Cache scans so
    -- target selection, footwork and spacing do not rewalk characters at 60Hz.
    local function botTeammates(root)
        local now = os.clock()
        if now < botSense.nextAlliesAt then return botSense.allies end
        botSense.nextAlliesAt = now + 0.15
        local allies, botCount = {}, 0
        local matchId = arenaMatchKey()
        local ids, hasIds = participantIds()
        for _, member in ipairs(Players:GetPlayers()) do
            if member ~= player and member:GetAttribute("Zone") == "Arena"
                and (matchId == "" or member:GetAttribute("MatchId") == matchId
                    or (hasIds and ids[member.UserId] == true)) then
                local ch = member.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hrp and hum and (hum.Health > 0 or ch:GetAttribute("Downed") == true) then
                    allies[#allies + 1] = {root = hrp, model = ch,
                        downed = ch:GetAttribute("Downed") == true,
                        health = hum.Health / math.max(1, hum.MaxHealth),
                        isBot = false, attacking = false}
                end
            end
        end
        local folder = workspace:FindFirstChild("ArenaBots")
        if folder then
            for _, bot in ipairs(folder:GetChildren()) do
                if bot:IsA("Model") and bot:GetAttribute("IsBot") == true
                    and (matchId == "" or bot:GetAttribute("MatchId") == matchId) then
                    local br = bot:FindFirstChild("HumanoidRootPart")
                    local bh = bot:FindFirstChildOfClass("Humanoid")
                    if br and bh and (bh.Health > 0 or bot:GetAttribute("Downed") == true) then
                        local move = bot:GetAttribute("Move")
                        local moveAt = tonumber(bot:GetAttribute("MoveAt"))
                        local attacking = type(move) == "string" and move ~= ""
                            and move ~= "None" and moveAt ~= nil
                            and math.abs(workspace:GetServerTimeNow() - moveAt) < 1.3
                        local dashing = bot:GetAttribute("Dashing") == true
                        local blocking = bot:GetAttribute("Blocking") == true
                        botCount = botCount + 1
                        allies[#allies + 1] = {root = br, model = bot,
                            downed = bot:GetAttribute("Downed") == true,
                            health = bh.Health / math.max(1, bh.MaxHealth),
                            isBot = true, attacking = attacking,
                            dashing = dashing, blocking = blocking,
                            kit = bot:GetAttribute("Kit")}
                        if ai().observeLiveBots then
                            if dashing then botSense.lastDashAt = now end
                            if blocking then botSense.lastBlockAt = now end
                            if attacking then botSense.lastMoveAt = now end
                            if attacking or dashing then
                                local velocity = br.AssemblyLinearVelocity
                                local flat = Vector3.new(velocity.X, 0, velocity.Z)
                                if flat.Magnitude > 3 then
                                    -- Learn local strafe direction when a bot is
                                    -- visibly circling a nearby enemy.
                                    local nearest, dist = nil, 25
                                    for enemy in pairs(s.enemies) do
                                        local er = rootOf(enemy)
                                        if er then
                                            local d = horizontal(er.Position, br.Position)
                                            if d < dist then nearest, dist = er, d end
                                        end
                                    end
                                    if nearest then
                                        local radial = br.Position - nearest.Position
                                        radial = Vector3.new(radial.X, 0, radial.Z)
                                        if radial.Magnitude > 1 then
                                            local side = Vector3.new(-radial.Unit.Z, 0, radial.Unit.X)
                                            local lateral = side:Dot(flat.Unit)
                                            if math.abs(lateral) > 0.55 then
                                                botSense.strafeSign = lateral > 0 and 1 or -1
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        botSense.allies, botSense.liveCount = allies, botCount
        s.botObservationStatus = botCount > 0
            and ("Watching " .. tostring(botCount) .. " live bot(s)")
            or "No live bot observed"
        return allies
    end

    local function enemyDanger(position)
        local total = 0
        local serverNow = workspace:GetServerTimeNow()
        for npc in pairs(s.enemies) do
            local er = rootOf(npc)
            if er then
                local distance = horizontal(er.Position, position)
                if distance < 25 then
                    local near = math.max(0, 1 - distance / 25)
                    total = total + near * (isBoss(npc) and 18 or 9)
                    local untilAt = tonumber(npc:GetAttribute("WindupEnd"))
                    local state = tostring(npc:GetAttribute("AIState") or ""):lower()
                    local winding = (untilAt and untilAt >= serverNow - 0.1
                        and untilAt <= serverNow + 1.3)
                        or state:find("windup", 1, true) ~= nil
                    if winding and distance < 17 then
                        total = total + (17 - distance) * (isBoss(npc) and 2.8 or 1.6)
                    end
                end
            end
        end
        return total
    end

    local function dangerMultiplier()
        local posture = ai().dangerPosture
        return posture == "Survival" and 1.65
            or (posture == "Aggressive" and 0.5 or 1)
    end

    local function botSelectEnemy(root, objective)
        local options = ai()
        local priority = options.targetPriority
        local allies = botTeammates(root)
        local best, bestScore = nil, -math.huge
        for enemy in pairs(s.enemies) do
            local er = rootOf(enemy)
            if er then
                local d = horizontal(root.Position, er.Position)
                local hp = finite(enemy:GetAttribute("Health"), nil)
                local maxHP = finite(enemy:GetAttribute("MaxHealth"), nil)
                local weak = hp and maxHP and maxHP > 0 and (1 - hp / maxHP) or 0
                local boss = isBoss(enemy)
                local objectiveEnemy = isChallengeEnemy(enemy, objective)
                local allyThreat = 0
                for _, ally in ipairs(allies) do
                    local separation = horizontal(er.Position, ally.root.Position)
                    if separation < 20 then
                        allyThreat = math.max(allyThreat,
                            (20 - separation) * (ally.downed and 1.2 or 0.7))
                    end
                end
                local score = 75 - math.min(d, 260) * 0.33
                if priority == "Nearest" then
                    score = 150 - d * 0.8
                elseif priority == "Boss First" then
                    score = score + (boss and 175 or 0)
                elseif priority == "Finish Weak" then
                    score = score + weak * 100
                elseif priority == "Defend Allies" then
                    score = score + allyThreat * 4
                else
                    -- Config.Bots.BigGame, ObjectiveEnemyRadius, AllyWeight.
                    score = score + (boss and options.bossBias * 2.5 or 0)
                        + weak * 20 + allyThreat *
                          (options.persona == "Support" and 3 or 1)
                end
                if options.objectiveMode ~= "Ignore" and s.objectivePos
                    and horizontal(er.Position, s.objectivePos) <= 15 then
                    score = score + (options.objectiveMode == "Priority" and 90 or 35)
                end
                if objectiveEnemy then score = score + 400 end
                if options.observeLiveBots and options.squadMode ~= "Independent" then
                    for _, ally in ipairs(allies) do
                        if ally.isBot and ally.root and not ally.downed then
                            local gap = horizontal(er.Position, ally.root.Position)
                            if gap < 18 then
                                local supportWeight = options.squadMode == "Assist Bots" and 20 or 9
                                if ally.attacking then score = score + supportWeight * (1 - gap / 24) end
                                if ally.health < 0.45 then score = score + 17 end
                                -- A bot almost finishing a weak NPC usually
                                -- doesn't need us stealing its target, unless
                                -- our explicit priority is Finish Weak.
                                if ally.attacking and weak >= 0.72 and priority ~= "Finish Weak"
                                    and not boss and not objectiveEnemy then
                                    score = score - 15
                                end
                            end
                        end
                    end
                end
                if options.adaptiveTactics and not objectiveEnemy then
                    local myChar = player.Character
                    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                    local lowHealth = hum and hum.MaxHealth > 0
                        and hum.Health / hum.MaxHealth < 0.5
                    -- Limit expensive nested scans to wounded or survival play.
                    -- At full health, proximity and objective scores remain fast.
                    local risk = (lowHealth or options.dangerPosture == "Survival")
                        and enemyDanger(er.Position) or 0
                    -- At full health, punish dangerous clusters lightly;
                    -- when wounded, avoid charging into several windups.
                    score = score - risk * dangerMultiplier()
                        * (lowHealth and 0.9 or 0.24)
                end
                if enemy == s.target then score = score + options.targetStickiness end
                if score > bestScore then best, bestScore = enemy, score end
            end
        end
        if best ~= s.target then
            s.targetSince = os.clock()
            s.lastGrounded = nil
        end
        s.focusKind = best and (isBoss(best) and "Boss" or "Bot target") or "Idle"
        s.focusName = best and best.Name or "None"
        return best
    end

    local function botCrowdCount(pos)
        local total = 0
        for npc in pairs(s.enemies) do
            local er = rootOf(npc)
            if er and horizontal(er.Position, pos) <= 8 then
                total = total + 1
            end
        end
        return total
    end

    local function tacticalEscape(root, humanoid, enemyRoot, now)
        if nav.retreatGoal and nav.retreatTarget == enemyRoot
            and now < nav.nextEscapeAt then return nav.retreatGoal end
        nav.nextEscapeAt = now + 0.6
        nav.retreatTarget = enemyRoot
        local away = root.Position - enemyRoot.Position
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
        away = away.Unit
        local best, bestCost = nil, math.huge
        local radius = 14
        for _, deltaAngle in ipairs({0, 0.6, -0.6, 1.2, -1.2, 1.8, -1.8}) do
            local dir = Vector3.new(
                away.X * math.cos(deltaAngle) - away.Z * math.sin(deltaAngle), 0,
                away.X * math.sin(deltaAngle) + away.Z * math.cos(deltaAngle))
            local where = root.Position + dir * radius
            local grounded = surfaceGoal(where.X, where.Z, root.Position.Y, humanoid, root)
            if grounded and math.abs(grounded.Y - root.Position.Y) < 3.5 then
                local danger = enemyDanger(grounded) * dangerMultiplier()
                local rotationCost = math.abs(deltaAngle) * 2.2
                local cost = danger + rotationCost
                if cost < bestCost then best, bestCost = grounded, cost end
            end
        end
        nav.retreatGoal = best
        return best
    end

    local function botAllySpacing(root, goal)
        local options = ai()
        if options.assistAllies == "Off" then return goal end
        if options.assistAllies == "Support Only"
            and options.persona ~= "Support" then return goal end
        for _, ally in ipairs(botTeammates(root)) do
            local diff = Vector3.new(goal.X - ally.root.Position.X, 0,
                goal.Z - ally.root.Position.Z)
            if diff.Magnitude < options.allySpacing then
                local away = diff.Magnitude > 0.1 and diff.Unit or
                    Vector3.new(1, 0, 0)
                goal = ally.root.Position + away * options.allySpacing
            end
        end
        return goal
    end

    local function botRoam(root, humanoid, now)
        local options = ai()
        if options.roamMode == "Hold" then return nil end
        if options.assistAllies ~= "Off" and
            (options.persona == "Support" or options.assistAllies == "All") then
            local closest, best = nil, math.huge
            for _, ally in ipairs(botTeammates(root)) do
                local range = horizontal(root.Position, ally.root.Position)
                if range < 65 and (ally.downed or ally.health < 0.6) and range < best then
                    closest, best = ally, range
                end
            end
            if closest and best > options.allySpacing + 2 then
                local dir = root.Position - closest.root.Position
                dir = Vector3.new(dir.X, 0, dir.Z)
                if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 0) end
                local guard = closest.root.Position + dir.Unit * options.allySpacing
                local spot = surfaceGoal(guard.X, guard.Z,
                    closest.root.Position.Y, humanoid, root)
                if spot then
                    nav.brainState = "Cover Teammate"
                    return spot
                end
            end
        end
        if options.roamMode == "Hold" then return nil end
        if nav.roamGoal and now < nav.nextRoamAt
            and horizontal(root.Position, nav.roamGoal) > 3 then
            return nav.roamGoal
        end
        if now < nav.nextRoamPick then return nil end
        nav.nextRoamPick = now + 1.2
        local radius = options.roamRadius
        local angle = math.random() * math.pi * 2
        local distance = options.roamMode == "Explore" and radius
            or radius * (0.4 + math.random() * 0.35)
        local x = root.Position.X + math.cos(angle) * distance
        local z = root.Position.Z + math.sin(angle) * distance
        local dest = surfaceGoal(x, z, root.Position.Y, humanoid, root)
        if dest then
            nav.roamGoal = dest
            nav.nextRoamAt = now + (options.roamMode == "Explore" and 8 or 5)
            return dest
        end
        return nil
    end

    -- V53: The client ReviveController uses each downed character's
    -- ProximityPrompt named ReviveP. Hold it normally instead of inventing a
    -- Revive remote or buying a paid self-revive. Only active match teammates
    -- (real players or tagged friendly Bots) are eligible.
    local function downedTeammate(model, member)
        if not model or not model.Parent then return false end
        local state = member and member:GetAttribute("CombatState") or model:GetAttribute("CombatState")
        if state == "Eliminated" or model:GetAttribute("CombatState") == "Eliminated" then return false end
        return state == "Downed" or model:GetAttribute("Downed") == true
            or model:GetAttribute("CombatState") == "Downed"
    end

    local function candidatePrompt(model)
        local prompt = model and model:FindFirstChild("ReviveP", true)
        return prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and prompt.Parent
            and prompt or nil
    end

    local function reviveTargetRoot(model)
        if not model or not model.Parent then return nil end
        local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        return part and part:IsA("BasePart") and part or nil
    end

    local function sameMatchMember(member, ids, hasList, matchId)
        if member == player or member:GetAttribute("Zone") ~= "Arena" then return false end
        if hasList then return ids[member.UserId] == true end
        if matchId ~= "" then return member:GetAttribute("MatchId") == matchId end
        return true -- Fall back to Arena when the server exposes no match identity.
    end

    local function reviveRadius()
        local persona = ai().persona
        return persona == "Support" and 160 or
            (persona == "Cautious" and 90 or (persona == "Explorer" and 80 or 60))
    end

    local function pickReviveTarget(root, now)
        local ids, hasList = participantIds()
        local matchId = arenaMatchKey()
        local best, bestMember, bestName, bestDistance = nil, nil, nil, math.huge
        local maxDist = reviveRadius()
        local function consider(model, member, displayName)
            if not downedTeammate(model, member) or now < (revive.unavailableUntil[model] or 0) then return end
            local part = reviveTargetRoot(model)
            if not part then return end
            local distance = (part.Position - root.Position).Magnitude
            if distance > maxDist then return end
            -- Gladiators may hold their shield through dangerous revives.
            -- Other kits retain the crowd safety limit.
            if not (kitName() == "Gladiator" and ai().reviveShield) then
                local nearby = 0
                for enemy in pairs(s.enemies) do
                    local enemyPart = rootOf(enemy)
                    if enemyPart and (enemyPart.Position - part.Position).Magnitude <= 4 then
                        nearby = nearby + 1
                        if nearby >= 3 then return end
                    end
                end
            end
            -- Give a currently selected downed teammate some stickiness so
            -- the bot does not oscillate between multiple revive candidates.
            local score = distance - (model == revive.target and 8 or 0)
            if score < bestDistance then
                best, bestMember, bestName, bestDistance = model, member, displayName, score
            end
        end
        for _, teammate in ipairs(Players:GetPlayers()) do
            if sameMatchMember(teammate, ids, hasList, matchId) then
                consider(teammate.Character, teammate, teammate.DisplayName)
            end
        end
        for _, bot in ipairs(CollectionService:GetTagged("Bot")) do
            if bot:IsA("Model") and bot:IsDescendantOf(workspace) then
                local botMatchId = bot:GetAttribute("MatchId")
                if matchId == "" or botMatchId == matchId then
                    consider(bot, nil, tostring(bot:GetAttribute("DisplayName") or bot.Name))
                end
            end
        end
        return best, bestMember, bestName
    end

    local function revivePromptPosition(prompt, fallback)
        local attached = prompt and prompt.Parent
        if attached and attached:IsA("Attachment") then return attached.WorldPosition end
        if attached and attached:IsA("BasePart") then return attached.Position end
        if attached then
            local part = attached:FindFirstAncestorWhichIsA("BasePart")
            if part then return part.Position end
        end
        return fallback
    end

    -- Handle the teammate revive before ordinary combat chasing. Returns true
    -- whenever revive owns the movement controller for this frame.
    local function tickTeamRevive(char, humanoid, root, now)
        if not s.reviveEnabled or not s.enabled or s.method ~= "Legit" then
            if revive.holding then cancelReviveHold() end
            return false
        end
        local threshold = math.clamp(ai().reviveAbandonHP or 30, 1, 90) / 100
        local hpRatio = humanoid.MaxHealth > 0
            and humanoid.Health / humanoid.MaxHealth or 0
        if hpRatio < threshold then
            -- "Leave" means abort the revive and RETREAT, not quit the match.
            -- Delay reassignment until health recovers; otherwise it would
            -- repeatedly run back into the same dangerous revive.
            if revive.target or revive.holding then
                if revive.target then
                    revive.unavailableUntil[revive.target] = now + 10
                end
                s:CancelReviveHold()
                resetRoute(humanoid, root)
                nav.mode, nav.target = "idle", nil
                nav.retreatUntil = now + math.max(3, ai().retreatBurst)
                nav.retreatCooldown = now + 1
            end
            s.reviveStatus = "Below " .. tostring(ai().reviveAbandonHP)
                .. "% HP - abandoning revive and retreating"
            return false
        end
        if revive.holding then
            local target = revive.target
            local prompt = revive.prompt
            local teammateRoot = reviveTargetRoot(target)
            local stillDown = downedTeammate(target, revive.owner)
            if not stillDown or not prompt or not prompt.Parent or not teammateRoot
                or (root.Position - teammateRoot.Position).Magnitude > 12 then
                cancelReviveHold()
                if not stillDown then
                    revive.target, revive.owner, revive.prompt = nil, nil, nil
                    revive.tries = 0
                    s.reviveStatus = "Teammate revived - resuming Bot AI"
                    resetRoute(humanoid, root)
                    nav.mode = "idle"
                    return false
                end
                revive.nextRetry = now + 0.4
                s.reviveStatus = "Revive interrupted; retrying"
                return true
            end
            if now >= revive.holdStarted + math.max(2.25, prompt.HoldDuration) + 0.18 then
                cancelReviveHold()
                revive.tries = revive.tries + 1
                revive.nextRetry = now + 0.8
                s.reviveStatus = "Revive hold completed; awaiting confirmation"
                if revive.tries >= 3 then
                    revive.unavailableUntil[target] = now + 3
                    revive.target, revive.owner, revive.prompt = nil, nil, nil
                    revive.tries = 0
                    resetRoute(humanoid, root)
                    nav.mode = "idle"
                    return false
                end
            else
                -- Keep the Gladiator shield UP for the entire revive hold.
                -- Parry pulses are paused while holding: a raised shield
                -- cannot be repeatedly re-raised for perfect-parry timing.
                if kitName() == "Gladiator" and ai().reviveShield then
                    setBotBlock(true)
                    revive.shieldActive = s.botBlocking
                end
                -- Holding is deliberately stationary. Reissuing MoveTo every
                -- Heartbeat could count as new movement and interrupt revival.
                s.status = "Bot AI | reviving " .. tostring(revive.name or "teammate")
                s.reviveStatus = "Holding ReviveP on " .. tostring(revive.name or "teammate")
                return true
            end
        end
        if now >= revive.nextScan then
            revive.nextScan = now + 0.20
            local found, owner, name = pickReviveTarget(root, now)
            if found ~= revive.target then
                revive.target, revive.owner, revive.name = found, owner, name
                revive.prompt, revive.tries, revive.nextRetry = nil, 0, 0
                revive.targetSince = now
                if nav.mode == "revive" then resetRoute(humanoid, root) end
            end
        end
        local target = revive.target
        if not target then
            if nav.mode == "revive" then
                resetRoute(humanoid, root)
                nav.mode, nav.target = "idle", nil
            end
            s.reviveStatus = "Watching for downed teammates"
            return false
        end
        local teammateRoot = reviveTargetRoot(target)
        if not teammateRoot or not downedTeammate(target, revive.owner) then
            revive.target, revive.owner, revive.prompt = nil, nil, nil
            revive.nextScan = 0
            return false
        end
        local spot = surfaceGoal(teammateRoot.Position.X, teammateRoot.Position.Z,
            teammateRoot.Position.Y, humanoid, root)
        if not spot then
            s.reviveStatus = "No walkable route to teammate"
            revive.unavailableUntil[target] = now + 1.5
            revive.target, revive.owner, revive.prompt = nil, nil, nil
            revive.nextScan = 0
            return false
        end
        if nav.mode ~= "revive" or nav.target ~= target then
            resetRoute(humanoid, root)
            nav.mode, nav.target = "revive", target
        end
        local prompt = candidatePrompt(target)
        revive.prompt = prompt
        local p = revivePromptPosition(prompt, teammateRoot.Position)
        local distance = (root.Position - p).Magnitude
        local allowed = prompt and math.min(8, math.max(2.5, prompt.MaxActivationDistance - 1)) or 7
        if prompt and distance <= allowed then
            halt(humanoid, root)
            if now < revive.nextRetry then
                s.status = "Bot AI | retrying revive shortly"
                return true
            end
            local ok, err = pcall(function() prompt:InputHoldBegin() end)
            if ok then
                revive.holding = true
                revive.holdStarted = now
                s.reviveHolding = true
                if kitName() == "Gladiator" and ai().reviveShield then
                    setBotBlock(true)
                    revive.shieldActive = s.botBlocking
                end
                s.reviveStatus = "Reviving " .. tostring(revive.name or "teammate")
                s.status = "Bot AI | holding revive on " .. tostring(revive.name or "teammate")
            else
                revive.nextRetry = now + 2
                s.reviveStatus = "Revive input not available"
                if now >= revive.nextWarning then
                    revive.nextWarning = now + 10
                    warn("[HollowMoonHub Revive] " .. tostring(err))
                end
            end
            return true
        end
        if distance <= 7.5 and not prompt then
            halt(humanoid, root)
            s.reviveStatus = "Waiting for teammate's ReviveP prompt"
            s.status = "Bot AI | revive prompt pending"
            if now - revive.targetSince > 3 then
                revive.unavailableUntil[target] = now + 1.5
                revive.target, revive.owner, revive.prompt = nil, nil, nil
                revive.nextScan = 0
            end
            return true
        end
        s.reviveStatus = "Going to downed teammate: " .. tostring(revive.name or "teammate")
        -- Reuse the same safe waypoints, obstacle checks and route recovery
        -- as normal Bot AI. Never blindly MoveTo through walls.
        nav.dashMode = "chase"
        followRoute(char, humanoid, root, spot, now)
        if nav.failed and now - revive.targetSince >= 3.5 then
            revive.unavailableUntil[target] = now + 2
            revive.target, revive.owner, revive.prompt = nil, nil, nil
            revive.nextScan = 0
            resetRoute(humanoid, root)
            nav.mode = "idle"
            s.reviveStatus = "Revive route unavailable; checking other allies"
            return false
        end
        s.status = "Bot AI | " .. s.reviveStatus
        return true
    end

    -- Visible enemy windup state can be read client-side; its exact
    -- hit timing and the server's hidden target choice cannot be inferred.
    local function detectVisibleThreat(root)
        local serverNow = workspace:GetServerTimeNow()
        local best, nearest = nil, 16
        for enemy in pairs(s.enemies) do
            local er = rootOf(enemy)
            if er then
                local dist = horizontal(root.Position, er.Position)
                if dist < nearest then
                    local windupEnd = tonumber(enemy:GetAttribute("WindupEnd"))
                    local state = tostring(enemy:GetAttribute("AIState") or ""):lower()
                    local imminent = (windupEnd and windupEnd >= serverNow - 0.15
                            and windupEnd <= serverNow + 1.5)
                        or state:find("windup", 1, true) ~= nil
                    if imminent then best, nearest = enemy, dist end
                end
            end
        end
        return best, nearest
    end

    -- A timed block activation is a *parry attempt*, not a guaranteed
    -- perfect result. The server judges the real hit/contact time. Attack
    -- WindupEnd is the best visible prediction, not server contact truth.
    local function botThreatResponse(char, humanoid, root, now)
        if revive.holding then
            if kitName() == "Gladiator" and ai().reviveShield then
                setBotBlock(true)
                revive.shieldActive = s.botBlocking
            end
            return
        end
        if now < botSense.parryReleaseAt then return end
        if botSense.parryReleaseAt > 0 then
            botSense.parryReleaseAt = 0
            botSense.parryTarget = nil
            s.parryCommitUntil = 0
            setBotBlock(false)
        end
        if not ai().threatRadar then
            setBotBlock(false)
            return
        end
        if now < botSense.threatAt then return end
        botSense.threatAt = now + (ai().autoParry and 0.025 or 0.12)
        local threat, distance = detectVisibleThreat(root)
        if ai().autoParry and kitName() == "Gladiator"
            and now >= botSense.parryNextAt and not s:IsDowned() then
            local earliest = math.huge
            local parryCandidate = nil
            local serverNow = workspace:GetServerTimeNow()
            for enemy in pairs(s.enemies) do
                local enemyRoot = rootOf(enemy)
                if enemyRoot and horizontal(root.Position, enemyRoot.Position) <= 9 then
                    local contactAt = tonumber(enemy:GetAttribute("WindupEnd"))
                    local state = tostring(enemy:GetAttribute("AIState") or ""):lower()
                    if contactAt and state:find("windup", 1, true) then
                        local remaining = contactAt - serverNow
                        if remaining >= -0.04 and remaining <= 0.18
                            and remaining < earliest then
                            parryCandidate, earliest = enemy, remaining
                        end
                    end
                end
            end
            if parryCandidate then
                setBotBlock(true)
                if s.botBlocking then
                    botSense.parryReleaseAt = now + 0.22
                    botSense.parryTarget = parryCandidate
                    s.parryCommitUntil = botSense.parryReleaseAt
                    s.dodgeGoal, s.dodgeUntil = nil, 0
                    -- Game ConfigParry includes a whiff lockout; do not spam
                    -- block presses at every frame or against every target.
                    botSense.parryNextAt = now + 0.85
                    s.status = "Bot AI | timed parry attempt"
                    return
                end
            end
        end
        if threat and distance < 13 then
            if not (s.dodgeGoal and now <= s.dodgeUntil) then
                nav.retreatUntil = math.max(nav.retreatUntil, now + 0.7)
                nav.retreatCooldown = math.max(nav.retreatCooldown, now + 1.1)
                nav.nextDecisionAt = 0
            end
            local k = lookup(kits, kitName())
            local shieldCapable = k and k.block ~= nil
            if ai().reactiveBlock and shieldCapable and distance <= 8
                and not (s.dodgeGoal and now <= s.dodgeUntil)
                and now >= botSense.blockCooldown then
                setBotBlock(true)
                botSense.blockCooldown = now + 0.4
            else
                setBotBlock(false)
            end
        else
            setBotBlock(false)
        end
    end

    local function openArcherLine(origin, targetPoint, target, char)
        local delta = targetPoint - origin
        if delta.Magnitude < 1 then return true end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignored = {char}
        local fx = workspace:FindFirstChild("FX")
        if fx then ignored[#ignored + 1] = fx end
        params.FilterDescendantsInstances = ignored
        params.IgnoreWater = true
        pcall(function() params.RespectCanCollide = true end)
        local hit = workspace:Raycast(origin, delta, params)
        return not hit or (target and hit.Instance:IsDescendantOf(target))
    end

    local function alternateArcherAngle(root, humanoid, char, target, enemyRoot, now)
        if nav.visionTarget == target and now < nav.nextVisionAt then
            return nav.visionGoal
        end
        nav.nextVisionAt = now + 0.55
        nav.visionTarget, nav.visionGoal = target, nil
        local center = enemyRoot.Position
        local away = root.Position - center
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.1 then away = Vector3.new(0, 0, 1) end
        local ideal = math.clamp(ai().archerIdeal, ai().archerMin, ai().archerMax)
        local baseAngle = math.atan2(away.Z, away.X)
        local best, bestCost = nil, math.huge
        for _, step in ipairs({1, -1, 2, -2, 3, -3}) do
            local angle = baseAngle + step * math.pi / 4
            local pos = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * ideal
            local grounded = surfaceGoal(pos.X, pos.Z, center.Y, humanoid, root)
            if grounded and openArcherLine(grounded + Vector3.new(0, 2, 0),
                center + Vector3.new(0, 1.2, 0), target, char) then
                local cost = horizontal(root.Position, grounded) + math.abs(step) * 2
                if cost < bestCost then best, bestCost = grounded, cost end
            end
        end
        nav.visionGoal = best
        return best
    end

    -- V56 Utility decision model. Unlike a random sidestep, score seven
    -- candidate positions by terrain, threats, distance, flanking and allies.
    -- This is a local imitation, not the developer's server-side decision tree.
    local function chooseUtilityPosition(char, humanoid, root, enemy, enemyRoot, base, now)
        local options = ai()
        if options.decisionModel ~= "Utility" then return nil end
        local archer = kitName() == "Archer"
        local old = nav.cachedTacticalGoal
        local unchanged = nav.cachedTacticalTarget == enemy
            and nav.cachedTacticalMode == (archer and "archer" or "melee")
            and nav.tacticalEnemyPosition
            and horizontal(nav.tacticalEnemyPosition, base) < 5
        if unchanged and now < nav.nextTacticalAt then return old end
        -- Fast distant chase should not spend time comparing close-range slots.
        if horizontal(root.Position, base) > (archer and 65 or 40) then
            nav.cachedTacticalGoal = nil
            nav.cachedTacticalTarget = enemy
            nav.nextTacticalAt = now + options.positionInterval
            return nil
        end
        local hp = humanoid.MaxHealth > 0
            and math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) or 1
        local front = enemyRoot.CFrame.LookVector
        front = Vector3.new(front.X, 0, front.Z)
        if front.Magnitude < .05 then front = Vector3.new(0, 0, -1) end
        front = front.Unit
        local fromEnemy = root.Position - base
        fromEnemy = Vector3.new(fromEnemy.X, 0, fromEnemy.Z)
        if fromEnemy.Magnitude < .5 then fromEnemy = -front end
        local axis = archer and fromEnemy.Unit or -front
        local tangent = Vector3.new(-axis.Z, 0, axis.X)
        local spacing = archer and math.clamp(options.archerIdeal,
            options.archerMin, options.archerMax)
            or math.clamp(s.behindOffset, 2.7, 5)
        local winner, bestCost = nil, math.huge
        for _, theta in ipairs({0, .6, -.6, 1.2, -1.2, 1.85, -1.85}) do
            local direction = axis * math.cos(theta) + tangent * math.sin(theta)
            local candidate = base + direction * spacing
            local ground = surfaceGoal(candidate.X, candidate.Z, base.Y, humanoid, root)
            if ground and math.abs(ground.Y - root.Position.Y) <= math.max(4, options.climbRise) then
                local travel = horizontal(root.Position, ground)
                local cost = travel * (archer and .16 or .22)
                local danger = options.adaptiveTactics and enemyDanger(ground) or 0
                cost = cost + danger * dangerMultiplier() * (.15 + (1 - hp) * .70)
                -- Position outside the target's forward windup arc.
                local exposure = direction:Dot(front)
                if not archer then cost = cost + math.max(0, exposure) * 15 end
                if options.predictThreats and exposure > .25 then
                    local windupAt = tonumber(enemy:GetAttribute("WindupEnd"))
                    local state = tostring(enemy:GetAttribute("AIState") or ""):lower()
                    if (windupAt and windupAt >= workspace:GetServerTimeNow() - .1)
                        or state:find("windup", 1, true) then
                        cost = cost + exposure * 24
                    end
                end
                if archer then
                    if not openArcherLine(ground + Vector3.new(0, 1.8, 0),
                        enemyRoot.Position + Vector3.new(0, 1.2, 0), enemy, char) then
                        cost = cost + 65
                    end
                end
                if travel <= 15 and not clearWalkingCorridor(char, humanoid,
                    root, ground, 16) then cost = cost + 10 end
                for _, ally in ipairs(botTeammates(root)) do
                    if ally.root and not ally.downed then
                        local gap = horizontal(ally.root.Position, ground)
                        if gap < options.allySpacing then
                            cost = cost + (options.allySpacing - gap) * 3
                        end
                    end
                end
                if unchanged and old and horizontal(ground, old) < 3 then
                    cost = cost - 5 -- keep a good choice; prevent route thrashing
                end
                if cost < bestCost then winner, bestCost = ground, cost end
            end
        end
        nav.cachedTacticalGoal, nav.cachedTacticalTarget = winner, enemy
        nav.cachedTacticalMode = archer and "archer" or "melee"
        nav.tacticalEnemyPosition = base
        nav.tacticalLastChoice = now
        nav.nextTacticalAt = now + options.positionInterval
        return winner
    end

    function s:TickLegitFarm(dt, char, humanoid, root)
        local now = os.clock()
        if nav.char ~= char then
            self:CancelReviveHold()
            self:ReleaseBotBlock()
            resetRoute(humanoid, root)
            nav.char = char
            nav.mode = "idle"
            nav.target = nil
            self.character = char
            self.floorY = calibrateFloor(root)
            self.target = nil
            self.focusObjective = nil
            self.lastGrounded = nil
            self.nextScan = 0
        end
        local gladiatorHold = revive.holding and kitName() == "Gladiator"
            and ai().reviveShield and humanoid.MaxHealth > 0
            and humanoid.Health / humanoid.MaxHealth >= ai().reviveAbandonHP / 100
        -- The timed Gladiator parry must get the first chance to react;
        -- afterward the independent dodge controller handles other hazards.
        botTeammates(root) -- refresh live bot state at a bounded rate
        botThreatResponse(char, humanoid, root, now)
        if s.dodgeEnabled and not gladiatorHold then tickDodge() end
        local dodging = s.dodgeEnabled and not gladiatorHold
            and now >= (s.parryCommitUntil or 0)
            and s.dodgeGoal and now <= s.dodgeUntil
        if dodging and revive.holding then
            cancelReviveHold()
            revive.nextRetry = now + 1
            self.reviveStatus = "Revive paused for incoming danger"
        end
        if not dodging and tickTeamRevive(char, humanoid, root, now) then
            return
        end
        if dodging then
            if nav.mode ~= "dodge" then
                resetRoute(humanoid, root)
                nav.mode = "dodge"
                nav.target = nil
            end
            local dodgePos = s.dodgeGoal
            -- Emergency response: dash using the real CombatController if a
            -- collision-free, grounded lane extends past the selected safe spot.
            -- If not, follow the ordinary safe path instead (no wall dashes).
            if nav.dashPending or now < nav.dashRecoveryUntil then
                if updateDash(char, humanoid, root, now) then return end
            end
            if s.legitSmartDash ~= false then
                local delta = Vector3.new(dodgePos.X - root.Position.X, 0,
                    dodgePos.Z - root.Position.Z)
                if delta.Magnitude > 3 then
                    local distance = dashSafeDistance()
                    local proposed = root.Position + delta.Unit * (distance + 7)
                    local grounded = surfaceGoal(proposed.X, proposed.Z,
                        root.Position.Y, humanoid, root)
                    if grounded and math.abs(grounded.Y - root.Position.Y) <= 3.6 then
                        if prepareDash(char, humanoid, root, now, grounded, "evade") then
                            return
                        end
                    end
                end
            end
            local destination = surfaceGoal(dodgePos.X, dodgePos.Z,
                root.Position.Y, humanoid, root)
            if destination then
                followRoute(char, humanoid, root, destination, now)
                self.status = "Bot AI | dodge: " .. self.status
            else
                halt(humanoid, root)
                self.status = "Bot AI | dodge route unavailable"
            end
            return
        end

        local objective = readObjective(now)
        local focusChanged = objective ~= s.focusObjective
        if focusChanged then
            s.focusObjective = objective
            s.target = nil
            s.lockUntil = 0
            s.lastGrounded = nil
            s.nextScan = 0
        end
        local target, airborne
        if now >= s.nextScan or not rootOf(s.target) or focusChanged then
            s.nextScan = now + (1 / ai().enemyTickHz)
            if now >= nav.nextRetargetAt or not rootOf(s.target) or focusChanged then
                target = botSelectEnemy(root, objective)
                local tr = rootOf(target)
                airborne = tr and tr.Position.Y > (s.floorY or 0) + 9
                s.target = target
                nav.nextRetargetAt = now + ai().retargetInterval
            else
                target = s.target
                local tr = rootOf(target)
                airborne = tr and tr.Position.Y > (s.floorY or 0) + 9
            end
        else
            target = s.target
            local targetRoot = rootOf(target)
            airborne = targetRoot and targetRoot.Position.Y > (s.floorY or 0) + 9
        end

        local destination, mode, stopDistance
        if s.objectivePos and ai().objectiveMode ~= "Ignore"
            and objective ~= "Champion" and objective ~= "Rivals"
            and (ai().objectiveMode == "Priority" or not rootOf(target)) then
            local p = s.objectivePos
            destination = surfaceGoal(p.X, p.Z, p.Y, humanoid, root)
            mode, stopDistance = "objective", 4
        elseif target then
            local enemyRoot = rootOf(target)
            if enemyRoot then
                local base = airborne and s.lastGrounded or enemyRoot.Position
                if not airborne then s.lastGrounded = enemyRoot.Position end
                base = base or enemyRoot.Position
                local archer = kitName() == "Archer"
                local distanceToEnemy = horizontal(root.Position, base)
                local look = enemyRoot.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude < 0.05 then flat = Vector3.new(0, 0, -1) end
                local xz
                local tuning = ai()
                local persona = tuning.persona
                local away = Vector3.new(root.Position.X - base.X, 0,
                    root.Position.Z - base.Z)
                if away.Magnitude < 0.5 then away = -flat end
                local awayDir = away.Unit
                local hp = humanoid.MaxHealth > 0
                    and humanoid.Health / humanoid.MaxHealth or 1
                local retreatAt = tuning.retreatHP / 100
                if persona == "Cautious" then retreatAt = math.min(0.85, retreatAt * 1.35) end
                if persona == "Support" then retreatAt = math.min(0.85, retreatAt * 1.2) end
                -- Roll strategic decisions at the bot's configured rate, not 60Hz.
                if now >= nav.nextDecisionAt then
                    nav.nextDecisionAt = now + 1 / tuning.decisionHz
                    local crowded = botCrowdCount(root.Position) >= tuning.crowdCount
                    local risky = tuning.crowdAvoid == "Always" or
                        (tuning.crowdAvoid == "Low HP" and hp < 0.6)
                    local dangerHere = tuning.adaptiveTactics and enemyDanger(root.Position) or 0
                    local urgent = tuning.adaptiveTactics and tuning.threatRadar
                        and hp < 0.7 and dangerHere > (tuning.dangerPosture == "Survival" and 18 or 30)
                    if (hp < retreatAt or (crowded and risky) or urgent)
                        and now >= nav.retreatCooldown and now >= nav.retreatUntil then
                        nav.retreatUntil = now + tuning.retreatBurst
                        nav.retreatCooldown = now + tuning.retreatBurst + 3
                    end
                    if now >= nav.strafeUntil
                        and now - nav.lastBrainAt >= tuning.reactionTime then
                        nav.lastBrainAt = now
                        nav.strafeGoal = nil
                        if distanceToEnemy <= (archer and tuning.archerMax or 16)
                            and math.random(1, 100) <= tuning.strafeChance then
                            local side = Vector3.new(-awayDir.Z, 0, awayDir.X)
                            if tuning.observeLiveBots and botSense.liveCount > 0
                                and botSense.strafeSign ~= 0 and math.random() < 0.65 then
                                if botSense.strafeSign < 0 then side = -side end
                            elseif math.random(1, 2) == 1 then
                                side = -side
                            end
                            local length = persona == "Explorer" and 10 or 6
                            if tuning.adaptiveTactics then
                                local best, bestCost = nil, math.huge
                                for _, sign in ipairs({1, -1}) do
                                    local p = root.Position + side * length * sign
                                    local candidate = surfaceGoal(p.X, p.Z,
                                        root.Position.Y, humanoid, root)
                                    if candidate then
                                        local danger = enemyDanger(candidate) * dangerMultiplier()
                                        local clear = clearWalkingCorridor(char, humanoid,
                                            root, candidate, 14)
                                        local cost = danger + (clear and 0 or 15)
                                        if sign < 0 then cost = cost + 0.75 end
                                        if cost < bestCost then best, bestCost = candidate, cost end
                                    end
                                end
                                nav.strafeGoal = best
                            else
                                nav.strafeGoal = root.Position + side * length
                            end
                            nav.strafeTarget = target
                            nav.strafeUntil = now + tuning.strafeTime
                        end
                    end
                end
                local retreating = now < nav.retreatUntil
                nav.brainState = retreating and "Retreat" or (archer and "Kite" or "Engage")
                nav.dashMode = retreating and "retreat" or "chase"
                if retreating then
                    -- Escape by pathfinding to grounded points, not blind movement.
                    if tuning.adaptiveTactics then
                        xz = tacticalEscape(root, humanoid, enemyRoot, now)
                            or (root.Position + awayDir * (archer and 21 or 15))
                        nav.brainState = "Safest retreat route"
                    else
                        xz = root.Position + awayDir * (archer and 21 or 15)
                    end
                elseif archer then
                    local low = math.min(tuning.archerMin, tuning.archerMax - 1)
                    local high = math.max(tuning.archerMax, low + 1)
                    local ideal = math.clamp(tuning.archerIdeal, low, high)
                    if distanceToEnemy < low then
                        xz = base + awayDir * ideal
                        nav.dashMode = "retreat"
                    elseif distanceToEnemy > high then
                        xz = base + awayDir * ideal
                    else
                        xz = root.Position
                    end
                else
                    -- Lead the enemy, then flank according to the selected persona.
                    local velocity = enemyRoot.AssemblyLinearVelocity
                    local lead = Vector3.new(velocity.X, 0, velocity.Z)
                    if lead.Magnitude > 24 then lead = lead.Unit * 24 end
                    if not airborne then
                        base = base + lead * math.clamp(distanceToEnemy / 110, 0.06, 0.23)
                    end
                    local rear = math.clamp(s.behindOffset, 2.5, 4.5)
                    if persona == "Cautious" then rear = math.max(rear, 6) end
                    if persona == "Support" then rear = math.max(rear, 7) end
                    xz = base - flat.Unit * rear
                end
                if not retreating and nav.strafeGoal and nav.strafeTarget == target
                    and now < nav.strafeUntil then
                    xz = nav.strafeGoal
                    if distanceToEnemy > 16 then nav.dashMode = "strafe" end
                end
                -- Archers seek a *walkable* firing angle around actual cover.
                -- This affects footwork only, not unrestricted Auto Attack.
                if archer and tuning.archerVision and not retreating
                    and tuning.decisionModel ~= "Utility"
                    and not openArcherLine(root.Position + Vector3.new(0, 1.8, 0),
                        enemyRoot.Position + Vector3.new(0, 1.2, 0), target, char) then
                    local flank = alternateArcherAngle(root, humanoid, char,
                        target, enemyRoot, now)
                    if flank then
                        xz = flank
                        nav.dashMode = "chase"
                        nav.brainState = "Archer flanking cover"
                    end
                end
                -- Utility model chooses a grounded combat slot based on
                -- danger, sightlines, distance and ally spacing.
                if not retreating and tuning.decisionModel == "Utility"
                    and not (nav.strafeGoal and now < nav.strafeUntil) then
                    local scored = chooseUtilityPosition(char, humanoid, root,
                        target, enemyRoot, base, now)
                    if scored then
                        xz = scored
                        nav.brainState = archer and "Utility kite / firing lane"
                            or "Utility flank / safe engagement"
                    end
                end
                xz = botAllySpacing(root, xz)
                destination = surfaceGoal(xz.X, xz.Z, base.Y, humanoid, root)
                mode, stopDistance = "enemy", archer and 3.5 or 3.2
                -- Fight-style jumps are optional and checked once per second.
                if now >= nav.nextJumpRollAt then
                    nav.nextJumpRollAt = now + 1
                    if tuning.climbMode ~= "Off" and distanceToEnemy < 15
                        and humanoid.FloorMaterial ~= Enum.Material.Air
                        and math.random(1, 100) <= tuning.jumpChance then
                        humanoid.Jump = true
                    end
                end
            end
        end

        if not destination and not target and not s.objectivePos then
            destination = botRoam(root, humanoid, now)
            if destination then
                mode, stopDistance = "roam", 3
                nav.brainState = "Patrol"
            end
        end
        if not destination then
            if nav.mode ~= "idle" then resetRoute(humanoid, root) end
            nav.mode = "idle"
            nav.target = nil
            self.status = target and "Bot AI | no walkable ground near enemy"
                or "Bot AI | standing, waiting for enemies"
            return
        end
        if nav.mode ~= mode or (mode == "enemy" and nav.target ~= target) then
            resetRoute(humanoid, root)
            nav.mode = mode
            nav.target = target
            if mode == "roam" then
                nav.roamGoal = destination
                nav.nextRoamAt = now + 5
                nav.nextRoamPick = now + 1
            end
        end
        -- Being close across a solid wall does not count as reaching the enemy.
        local closeEnough = horizontal(root.Position, destination) <= stopDistance
            and math.abs(root.Position.Y - destination.Y) < 7
        if closeEnough and not obstacleAhead(char, root, destination) then
            if nav.lastMovePoint then halt(humanoid, root) end
            self.status = mode == "enemy" and "Bot AI | enemy in attack range"
                or "Bot AI | arrived at objective"
            return
        end
        followRoute(char, humanoid, root, destination, now)
    end
end

local function beginForCharacter(char, humanoid, root)
    s.character = char
    enableFarmFacing(humanoid)
    s.startPosition = root.Position
    s.floorY = calibrateFloor(root)
    s.lastGrounded = nil
    s.target = nil
    s.focusKind = "Normal"
    s.focusObjective = nil
    s.lockUntil = 0
    s.dodgeNextHazardRefresh = 0
    s.dodgeNextScan = 0
    resetBehind()
    s.nextPlan = 0 -- Do not reset Auto Attack's independent combo/cooldown.
    releasePark()
    s.collisions = {}
    s.noclipActive = false
    setNoclip(char, true)
    ensureLift(root)
    rootPlacement(root, root.Position.X, root.Position.Z, undergroundY())
    makeCamera(char, root)
end

-- Release only the anchor added by the downed pause. Keep the original
-- anchored state of the waiting platform, if any.
local function releaseDownedHold()
    local held = s.downedHoldRoot
    if held and held.Parent then
        pcall(function() held.Anchored = s.downedHoldWasAnchored == true end)
    end
    s.downedHoldRoot = nil
    s.downedHoldWasAnchored = nil
end

-- Pause every movement owner immediately. Underground Tween/Teleport users
-- remain exactly where they were downed; never teleport them to the surface.
function s:PauseFarmDowned()
    if self.farmPausedDowned then return end
    self.farmPausedDowned = true
    self:StopLegitFarm() -- invalidate pending routes and dashes
    stopTween()
    resetBehind()
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local underground = self.method ~= "Legit" and self.character == char
        and self.floorY ~= nil and root ~= nil and root:IsA("BasePart")

    if underground then
        -- Freeze the present below-floor location without changing its CFrame.
        -- Preserve the calibrated arena floor, character, noclip, camera and
        -- platform for a correct resume after revival.
        self.downedHoldRoot = root
        self.downedHoldWasAnchored = root.Anchored
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = true
        -- The root is now anchored, so the moving lift is no longer necessary.
        removeLift()
    else
        -- Legit mode stops its normal ground movement as before.
        removeLift()
        removePlatform()
        releasePark()
        restoreCollisions()
        restoreFarmFacing()
        removeCamera()
        self.character = nil
        self.floorY = nil
        self.startPosition = nil
    end
    if humanoid then humanoid:Move(Vector3.zero, false) end
    self.facingGoal = nil
    self.target = nil
    self.focusKind = "Normal"
    self.focusObjective = nil
    self.lastGrounded = nil
    self.dodgeGoal = nil
    self.dodgeUntil = 0
    self.dodgeFreeMove = false
    self.status = underground and "Paused - downed; holding underground"
        or "Paused - downed; waiting for revive"
end

local function tickFarm(dt)
    if not s.enabled then return end
    if s:IsDowned() then
        if s.ReleaseBotBlock then s:ReleaseBotBlock() end
        s:PauseFarmDowned()
        return
    end
    local char, humanoid, root = characterReady()
    if not char then
        if s.character then s:PauseFarmDowned() end
        s.status = s.farmPausedDowned and "Paused - downed / respawning"
            or "Waiting for character"
        return
    end
    local zone = player:GetAttribute("Zone")
    if zone == "Lobby" or not workspace:FindFirstChild("Arena") then
        if (s.character or s.farmPausedDowned) and zone == "Lobby" then
            -- Avoid leaving the old underground avatar anchored after a
            -- match exit / server transition.
            s:SetEnabled(false)
            return
        end
        s.status = "Waiting for arena"

        return
    end
    if s.farmPausedDowned then
        -- Resume the existing underground position and original floor reference.
        -- A new character will be initialized normally below.
        releaseDownedHold()
        s.farmPausedDowned = false
        s.status = "Revived - restarting Auto Farm"
        s.dodgeNextScan = 0
        s.dodgeNextHazardRefresh = 0
        s.nextScan = 0
    end
    if s.method == "Legit" then
        -- Legit walks on the arena surface; never enter underground mode.
        return s:TickLegitFarm(dt, char, humanoid, root)
    end
    if s.character ~= char or not s.floorY then beginForCharacter(char, humanoid, root) end
    local now = os.clock()
    -- Emergency decisions first: objectives, enemy scans and boss locks can
    -- otherwise delay a time-sensitive dodge during busy challenge rounds.
    if s.dodgeEnabled then tickDodge() end
    local dodging=s.dodgeEnabled and s.dodgeGoal and now<=s.dodgeUntil
    local objective, target, airborne
    if not dodging then
        objective=readObjective(now)
        local focusChanged=(objective~=s.focusObjective)
        if focusChanged then
            s.lockUntil=0
            s.target=nil
            s.lastGrounded=nil
            s.focusObjective=objective
        end
        if now>=s.nextScan or not rootOf(s.target) or focusChanged then
            target,airborne=findTarget(root,now,objective)
            s.target=target
            s.nextScan=now+.16
        else
            target=s.target
            local tr=rootOf(target)
            airborne=tr and tr.Position.Y>s.floorY+9
        end
    end
    -- Each Heartbeat chooses a single facing target; dodges and objectives
    -- do not keep the previous NPC's orientation lock by accident.
    s.facingFrameDt = dt
    s.facingGoal = nil
    -- Dodge was evaluated BEFORE objective and target work above.
    if dodging then
        resetBehind()
        -- Always let emergency evasion interrupt a boss lock, objective or park.
        if s.parkRoot then releasePark() end
        removePlatform()
        setNoclip(char,true)
        ensureLift(root)
        moveBelow(root,s.dodgeGoal,now)
        s.status="DODGE priority - "..s.dodgeStatus
    elseif s.objectivePos and objective~="Champion" and objective~="Rivals" then
        resetBehind()
        -- Below-only routing focuses the objective position, but cannot
        -- complete surface proximity prompts from underground.
        if s.parkRoot then releasePark() end
        removePlatform()
        setNoclip(char,true)
        ensureLift(root)
        local p=s.objectivePos
        moveBelow(root,Vector3.new(p.X,0,p.Z),now)
        s.status="Objective priority: "..tostring(objective)
    elseif not target then
        resetBehind()
        makePlatform(char, humanoid, root)
        s.status="Anchored on 12x12 platform (waiting)"
    else
        if s.parkRoot then releasePark() end
        removePlatform()
        setNoclip(char,true)
        ensureLift(root)
        local tr=rootOf(target)
        if tr then
            -- Both Below and Behind + Below face the locked enemy.
            -- When airborne, look toward its last grounded X/Z instead.
            s.facingGoal = (airborne and s.lastGrounded) or tr.Position
            local goal
            if airborne then
                -- A boss jump NEVER changes farm height or causes retargeting.
                goal=s.lastGrounded or Vector3.new(root.Position.X,0,root.Position.Z)
                s.status="Airborne target - holding below floor ("..s.focusKind..")"
            else
                goal=Vector3.new(tr.Position.X,0,tr.Position.Z)
                s.lastGrounded=goal
                s.status="Locked: "..s.focusKind
            end
            -- Permanent Behind + Below method: face and follow the enemy's back.
            goal = behindGoal(target, tr, airborne, dt)
            moveBehindBelow(root, goal, dt)
            s.status = s.status .. " | following back side"
        end
    end
    updateCamera(root, dt)

end

function s:SetEnabled(enabled)
    enabled = enabled == true
    if self.enabled == enabled then return end
    self.enabled = enabled
    if enabled then
        self.status = self.method == "Legit"
            and "Starting Bot AI pathfinding" or "Starting below-floor farm"
        self.heartbeat = RunService.Heartbeat:Connect(function(dt)
            local ok, err = pcall(tickFarm, dt)
            if not ok then
                self.status = "Recovering from error: " .. tostring(err)
                if os.clock() >= (self.nextWarning or 0) then
                    self.nextWarning = os.clock() + 8
                    warn("[HollowMoonHub Below Farm] " .. tostring(err))
                end
            end
        end)
    else
        if self.heartbeat then self.heartbeat:Disconnect(); self.heartbeat = nil end
        local wasDownedPause = self.farmPausedDowned
        releaseDownedHold()
        self.farmPausedDowned = false
        self.facingGoal = nil
        self:StopLegitFarm()
        stopTween()
        resetBehind()
        removeLift()
        removePlatform()
        -- If waiting, first put the character back above the arena floor,
        -- then unanchor it after the return position is applied.
        local parkedRoot = self.parkRoot
        local char, humanoid, root = characterReady()
        if self.method ~= "Legit" and char and self.floorY
            and not (wasDownedPause and self:IsDowned()) then
            local safe = findReturnPoint(char, humanoid, root)
            rootPlacement(root, safe.X, safe.Z, safe.Y)
        end
        if parkedRoot then releasePark() end
        restoreCollisions()
        restoreFarmFacing()
        removeCamera()
        self.character = nil
        self.target = nil
        self.focusKind = "Normal"
        self.focusObjective = nil
        self.lastGrounded = nil
        self.floorY = nil
        self.startPosition = nil
        self.status = "Off - movement stopped"
        self.nextUi = 0
        self.nextAttackUi = 0


    end
end
function s:SetFarmMethod(choice)
    if choice == "Bot AI" then choice = "Legit" end
    if choice ~= "Legit" and choice ~= "Tween" and choice ~= "Teleport" then return end
    if self.method == choice then return end
    -- Restart only the independent movement controller when switching methods.
    -- A switch FROM underground safely returns to the arena first.
    local wasEnabled = self.enabled
    if wasEnabled then self:SetEnabled(false) end
    self.method = choice
    if wasEnabled then self:SetEnabled(true) end
end

-- V41: GloryBound uses procedural attack poses in its PlayerAnimator module.
-- Suppress only local-character combat moves while Auto Attack is enabled.
-- Training, rebirth, locomotion, dodge and other players are unaffected.
local attackAnimMute = {
    controller = nil, originalPlay = nil, replacementPlay = nil,
    character = nil, characterConnections = {}, characterAdded = nil,
    heartbeat = nil, nextModuleCheck = 0, warned = false,
}

local function isAttackMoveAnimation(moveId)
    if type(moveId) ~= "string" then return false end
    local id = moveId:lower()
    -- Confirmed kit attack prefixes from the supplied GloryBound game scripts.
    local combatPrefix = id:match("^glad_") or id:match("^lance_")
        or id:match("^bers_") or id:match("^bow_")
    if not combatPrefix then return false end
    -- Do not suppress non-attack movement poses from those same kits.
    if id:find("dodge", 1, true) or id:find("roll", 1, true)
        or id:find("idle", 1, true) or id:find("walk", 1, true)
        or id:find("run", 1, true) then return false end
    return true
end

local function stopCurrentAttackPose(character)
    if not s.attackEnabled or not character or character ~= player.Character then return end
    if not isAttackMoveAnimation(character:GetAttribute("Move")) then return end
    local controller = attackAnimMute.controller
    if controller and type(controller.stop) == "function" then
        pcall(controller.stop, character)
    end
end

local function bindAttackAnimationCharacter(character)
    local mute = attackAnimMute
    for _, connection in ipairs(mute.characterConnections) do
        connection:Disconnect()
    end
    table.clear(mute.characterConnections)
    mute.character = character
    if not character then return end
    -- The game's PlayerAnimator also starts poses from replicated MoveSeq;
    -- blocking PlayerAnimator.play alone would not prevent those poses.
    for _, attributeName in ipairs({"MoveSeq", "Move"}) do
        table.insert(mute.characterConnections,
            character:GetAttributeChangedSignal(attributeName):Connect(function()
                stopCurrentAttackPose(character)
            end))
    end
    stopCurrentAttackPose(character)
end

local function ensureAttackAnimationController()
    local mute = attackAnimMute
    if mute.controller then return end
    local scripts = player:FindFirstChild("PlayerScripts")
    local folder = scripts and scripts:FindFirstChild("Controllers")
    local module = folder and folder:FindFirstChild("PlayerAnimator")
    if not (module and module:IsA("ModuleScript")) then return end
    local ok, controller = pcall(require, module)
    if not ok or type(controller) ~= "table" then return end
    mute.controller = controller
    if type(controller.play) == "function" then
        local original = controller.play
        mute.originalPlay = original
        mute.replacementPlay = function(character, moveId, ...)
            if s.attackEnabled and character == player.Character
                and isAttackMoveAnimation(moveId) then
                stopCurrentAttackPose(character)
                return true
            end
            return original(character, moveId, ...)
        end
        controller.play = mute.replacementPlay
    end
    stopCurrentAttackPose(player.Character)
end

local function setAttackAnimationMute(enabled)
    local mute = attackAnimMute
    if enabled then
        ensureAttackAnimationController()
        if not mute.characterAdded then
            mute.characterAdded = player.CharacterAdded:Connect(bindAttackAnimationCharacter)
        end
        bindAttackAnimationCharacter(player.Character)
        if not mute.heartbeat then
            mute.nextModuleCheck = 0
            mute.heartbeat = RunService.Heartbeat:Connect(function()
                if not s.attackEnabled then return end
                local character = player.Character
                if character ~= mute.character then
                    bindAttackAnimationCharacter(character)
                end
                if not mute.controller and os.clock() >= mute.nextModuleCheck then
                    mute.nextModuleCheck = os.clock() + 1
                    ensureAttackAnimationController()
                end
                -- Cancels any server-confirmed pose immediately without touching
                -- movement, training or other non-combat animation states.
                stopCurrentAttackPose(character)
            end)
        end
    else
        if mute.heartbeat then mute.heartbeat:Disconnect(); mute.heartbeat = nil end
        if mute.characterAdded then mute.characterAdded:Disconnect(); mute.characterAdded = nil end
        for _, connection in ipairs(mute.characterConnections) do
            connection:Disconnect()
        end
        table.clear(mute.characterConnections)
        if mute.controller and mute.replacementPlay
            and mute.controller.play == mute.replacementPlay then
            mute.controller.play = mute.originalPlay
        end
        mute.character = nil
        mute.controller = nil
        mute.originalPlay = nil
        mute.replacementPlay = nil
    end
end

function s:SetAutoAttack(enabled)
    enabled = enabled == true
    if self.attackEnabled == enabled then return end
    self.attackEnabled = enabled
    -- Hide local attack poses only while Auto Attack is active.
    setAttackAnimationMute(enabled)
    self.attackTarget = nil
    self.attackDistance = nil
    self.attackCandidates = {}
    self.attackNearbyCount = 0
    self.attackSpawnedCount = 0
    self.attackGroupEstimate = 0
    self.nextAttackScan = 0
    self.nextAttack = 0
    self.pendingAttackSeqs = {}
    self.attackInterval = .05
    self.paceWindowAt = nil
    self.paceStatus = "Fast mode"
    if enabled then
        self.attackStatus = "Rapid attacks whenever living NPCs are spawned (no distance gate)"
        if self.attackHeartbeat then self.attackHeartbeat:Disconnect() end
        self.attackHeartbeat = RunService.Heartbeat:Connect(function()
            local ok, err = pcall(tickAttack)
            if not ok then
                self.attackStatus = "Attack scheduler error: " .. tostring(err):sub(1, 135)
                if os.clock() >= (self.nextAttackWarning or 0) then
                    self.nextAttackWarning = os.clock() + 8
                    warn("[HollowMoonHub Auto Attack] " .. tostring(err))
                end
            end
        end)
    else
        if self.attackHeartbeat then
            self.attackHeartbeat:Disconnect()
            self.attackHeartbeat = nil
        end
        self.attackStatus = "Off"
    end
    self.nextAttackUi = 0

end

function s:Destroy()
    self:SetAutoReviveTeammates(false)
    if observedHealthConnection then observedHealthConnection:Disconnect(); observedHealthConnection=nil end
    self:SetAutoDodge(false)
    for model, subs in pairs(self.dodgeEnemySubscriptions) do
        for _, conn in ipairs(subs) do conn:Disconnect() end
        self.dodgeEnemySubscriptions[model]=nil
    end
    self:SetAutoLeave(false)
    self:SetAutoLeaveSelf(false)
    self:SetAutoAttack(false)
    self:SetEnabled(false)
    self:SetCameraUnlocked(false)
    releasePark()
    restoreFarmFacing()
    for _, c in ipairs(self.connections) do c:Disconnect() end
    for _, c in ipairs(self.folderConnections) do c:Disconnect() end
    table.clear(self.connections)
    table.clear(self.folderConnections)
    table.clear(self.enemies)
    self.driver:Destroy()
    if env.HollowMoonBelowFarm == self then env.HollowMoonBelowFarm = nil end
end

