--========================================================
-- MODEL / NPC ANCHOR HELPERS
--========================================================

local function GetModelAnchorPart(
    Model
)
    if not Model
        or not Model:IsA("Model")
    then
        return nil
    end

    -- The delivery client itself waypoints to UpperTorso,
    -- so prefer character-root/torso parts before falling
    -- back to any BasePart in the model.
    local PreferredNames = {
        "HumanoidRootPart",
        "UpperTorso",
        "Torso",
        "Head",
    }

    for _, Name in ipairs(
        PreferredNames
    ) do
        local Part =
            Model:FindFirstChild(
                Name,
                true
            )

        if Part
            and Part:IsA("BasePart")
        then
            return Part
        end
    end

    if Model.PrimaryPart
        and Model.PrimaryPart:IsA("BasePart")
    then
        return Model.PrimaryPart
    end

    return Model:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function GetDeliveryNPCAnchorPart()
    return GetModelAnchorPart(
        GetDeliveryNPC()
    )
end

local function GetDeliveryNPCPrompt()
    local NPC =
        GetDeliveryNPC()

    if not NPC then
        return nil
    end

    -- The server-created delivery NPC is dynamic, so
    -- find its enabled interaction prompt instead of
    -- hardcoding a child path that may change.
    local Fallback = nil

    for _, Object in ipairs(
        NPC:GetDescendants()
    ) do
        if Object:IsA("ProximityPrompt") then
            if not Fallback then
                Fallback = Object
            end

            if Object.Enabled then
                return Object
            end
        end
    end

    return Fallback
end

local function GetPromptPart(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local Parent =
        Prompt.Parent

    if Parent:IsA("BasePart") then
        return Parent
    end

    if Parent:IsA("Attachment") then
        local AttachmentParent =
            Parent.Parent

        if AttachmentParent
            and AttachmentParent:IsA("BasePart")
        then
            return AttachmentParent
        end
    end

    -- ProximityPrompts may also be parented to Models.
    if Parent:IsA("Model") then
        local Anchor =
            GetModelAnchorPart(
                Parent
            )

        if Anchor then
            return Anchor
        end
    end

    local AncestorPart =
        Prompt:FindFirstAncestorWhichIsA(
            "BasePart"
        )

    if AncestorPart then
        return AncestorPart
    end

    local AncestorModel =
        Prompt:FindFirstAncestorWhichIsA(
            "Model"
        )

    if AncestorModel then
        local Anchor =
            GetModelAnchorPart(
                AncestorModel
            )

        if Anchor then
            return Anchor
        end
    end

    -- Final delivery-specific fallback: the dynamically
    -- created customer is known to expose UpperTorso.
    local NPC =
        GetDeliveryNPC()

    if NPC
        and Prompt:IsDescendantOf(NPC)
    then
        return GetDeliveryNPCAnchorPart()
    end

    return nil
end

--========================================================
-- DELIVERY PROMPT POSITION / RANGE
--========================================================

local function GetDeliveryPromptPosition(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local Parent =
        Prompt.Parent

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    local Part =
        GetPromptPart(
            Prompt
        )

    if Part then
        return Part.Position
    end

    -- Extra customer fallback in case the prompt lives
    -- directly under a non-physical container/model.
    local NPC =
        GetDeliveryNPC()

    if NPC
        and Prompt:IsDescendantOf(NPC)
    then
        local Anchor =
            GetDeliveryNPCAnchorPart()

        if Anchor then
            return Anchor.Position
        end
    end

    return nil
end

local function IsDeliveryPromptInRange(
    Prompt,
    ExtraDistance,
    IgnoreEnabled
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if not IgnoreEnabled
        and not Prompt.Enabled
    then
        return false
    end

    local Position =
        GetDeliveryPromptPosition(
            Prompt
        )

    if not Position then
        return false
    end

    local RootPart =
        GetRootPart()

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 10

    ExtraDistance =
        ExtraDistance or 0.75

    return (
        RootPart.Position
        - Position
    ).Magnitude <= (
        MaxDistance
        + ExtraDistance
    )
end

local function GetDeliveryPromptDistance(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return math.huge
    end

    local Position =
        GetDeliveryPromptPosition(
            Prompt
        )

    if not Position then
        return math.huge
    end

    return (
        GetRootPart().Position
        - Position
    ).Magnitude
end


--========================================================
-- STRICT DELIVERY BAG RANGE
--
-- Generic delivery movement uses a small tolerance so NPC
-- interactions do not jitter at the edge.  The restaurant bag
-- is different: we want the HumanoidRootPart comfortably INSIDE
-- the real ProximityPrompt radius before treating the approach as
-- complete.  This prevents the return loop from stopping at the
-- counter/door while the normal prompt still cannot appear.
--========================================================

local function IsDeliveryBagSafelyInRange(
    Prompt,
    IgnoreEnabled
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if not IgnoreEnabled
        and not Prompt.Enabled
    then
        return false
    end

    local Distance =
        GetDeliveryPromptDistance(
            Prompt
        )

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 7.5

    -- Keep a real margin inside the prompt radius.  The bag sits
    -- above the floor, so 3D root-to-prompt distance matters.
    local SafeDistance =
        math.max(
            1,
            MaxDistance - 0.65
        )

    return Distance <= SafeDistance
end

--========================================================
-- DELIVERY APPROACH POSITION
--
-- Delivery prompts are attached to character/NPC torso
-- parts. Those torso centers are not valid navmesh
-- destinations, so path to a nearby ground point instead.
