;(function()

    local RetryToggle
    local LeaveToggle
    local NextToggle
    local LeaveAfterToggle


    local function Persist()

        if type(
            Settings.PersistEndActionSettings
        ) == "function"
        then

            Settings
                .PersistEndActionSettings()
        end
    end


    RetryToggle =
        LobbyTab:CreateToggle({

            name = "Auto Retry",

            description = "Retry the same story run after the results screen.",

            value =
                Settings.AutoRetry,

            callback = function(Value)

                Settings.AutoRetry =
                    Value == true


                if Value then

                    Settings.AutoLeave =
                        false

                    Settings.AutoNext =
                        false


                    if LeaveToggle then
                        LeaveToggle:Set(
                            false,
                            true
                        )
                    end


                    if NextToggle then
                        NextToggle:Set(
                            false,
                            true
                        )
                    end
                end


                Persist()
            end,
        })


    LeaveToggle =
        LobbyTab:CreateToggle({

            name = "Auto Leave",

            description = "Return to the lobby after the story run ends.",

            value =
                Settings.AutoLeave,

            callback = function(Value)

                Settings.AutoLeave =
                    Value == true


                if Value then

                    Settings.AutoRetry =
                        false

                    Settings.AutoNext =
                        false


                    if RetryToggle then
                        RetryToggle:Set(
                            false,
                            true
                        )
                    end


                    if NextToggle then
                        NextToggle:Set(
                            false,
                            true
                        )
                    end
                end


                Persist()
            end,
        })


    NextToggle =
        LobbyTab:CreateToggle({

            name = "Auto Next",

            description = "Move to the next chapter when the game allows it.",

            value =
                Settings.AutoNext,

            callback = function(Value)

                Settings.AutoNext =
                    Value == true


                if Value then

                    Settings.AutoRetry =
                        false

                    Settings.AutoLeave =
                        false


                    if RetryToggle then
                        RetryToggle:Set(
                            false,
                            true
                        )
                    end


                    if LeaveToggle then
                        LeaveToggle:Set(
                            false,
                            true
                        )
                    end
                end


                Persist()
            end,
        })


    LobbyTab:CreateInput({

        name =
            "Matches Before Leave",

        placeholder =
            "Enter match count",

        numeric = true,

        clearOnFocus = false,

        value =
            tostring(
                Settings.LeaveAfterMatches
            ),

        callback = function(Value)

            local Number =
                tonumber(Value)


            if Number then

                Settings.LeaveAfterMatches =
                    math.clamp(
                        math.floor(Number),
                        1,
                        999
                    )
            end


            Persist()
        end,
    })


    LeaveAfterToggle =
        LobbyTab:CreateToggle({

            name =
                "Auto Leave After X Matches",

            value =
                Settings.AutoLeaveAfterMatches,

            callback = function(Value)

                local WasEnabled =
                    Settings.AutoLeaveAfterMatches


                Settings.AutoLeaveAfterMatches =
                    Value == true


                if Value
                    and not WasEnabled
                then

                    Settings.CompletedMatches =
                        0
                end


                if not Value then

                    Settings.CompletedMatches =
                        0
                end


                Persist()
            end,
        })


    Settings.EndActionControls = {

        Retry = RetryToggle,
        Leave = LeaveToggle,
        Next = NextToggle,
        LeaveAfter = LeaveAfterToggle,
    }
end)()


