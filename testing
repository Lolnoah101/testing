local function EquipWeaponSlot(
    Slot
)
    Slot =
        math.clamp(
            tonumber(Slot)
                or 1,
            1,
            5
        )

    Settings.WeaponSlot =
        Slot

    local ItemsConfig =
        LocalPlayer:FindFirstChild(
            "Items_Config"
        )

    local Equipped =
        ItemsConfig
        and ItemsConfig:FindFirstChild(
            "Equipped"
        )

    if Equipped
        and Equipped:IsA(
            "IntValue"
        )
    then
        -- The game's toolbar code listens to Equipped.Changed and
        -- sends Item_Equip with this value.
        if Equipped.Value ~= Slot then
            Equipped.Value =
                Slot
        else
            -- If the slot is already selected locally, send one exact
            -- captured equip request so selecting the dropdown still
            -- refreshes the equipped slot.
            pcall(function()
                CombatEvent:FireServer(
                    "Item_Equip",
                    Slot
                )
            end)
        end

        return true
    end

    -- Fallback if Items_Config has not replicated yet.
    local Success =
        pcall(function()
            CombatEvent:FireServer(
                "Item_Equip",
                Slot
            )
        end)

    return Success
end


task.spawn(function()
    while HubRunning do
        if Settings.AutoEquipSlot then
            local DesiredSlot =
                math.clamp(
                    tonumber(
                        Settings.WeaponSlot
                    ) or 1,
                    1,
                    5
                )

            local ItemsConfig =
                LocalPlayer:FindFirstChild(
                    "Items_Config"
                )

            local Equipped =
                ItemsConfig
                and ItemsConfig:FindFirstChild(
                    "Equipped"
                )

            if not Equipped
                or not Equipped:IsA(
                    "IntValue"
                )
                or Equipped.Value ~= DesiredSlot
            then
                EquipWeaponSlot(
                    DesiredSlot
                )
            end
        end

        task.wait(0.20)
    end
end)


local function SendCombatStage(Stage)
    if not HubRunning
        or not Settings.AutoClick
    then
        return false
    end

    local TimingValue =
        ComboValues[Stage]

    if TimingValue == nil then
        return false
    end

    local Success, ErrorMessage =
        pcall(function()
            CombatEvent:FireServer(
                "Combat_Service",
                "Combat",
                Stage,
                false,
                TimingValue,
                false,
                nil
            )
        end)

    if not Success then
        warn(
            "[Combat Hub] Combo "
                .. tostring(Stage)
                .. ": "
                .. tostring(ErrorMessage)
        )

        return false
    end

    return true
end


local function StartAutoClick()
    AutoClickLoopID += 1
    local LoopID = AutoClickLoopID

    task.spawn(function()
        while HubRunning
            and Settings.AutoClick
            and LoopID == AutoClickLoopID
        do
            for Stage = 1, 5 do
                if not HubRunning
                    or not Settings.AutoClick
                    or LoopID ~= AutoClickLoopID
                then
                    break
                end

                SendCombatStage(Stage)

                if Stage < 5 then
                    task.wait(COMBO_STEP_DELAY)
                end
            end

            if HubRunning
                and Settings.AutoClick
                and LoopID == AutoClickLoopID
            then
                task.wait(COMBO_RESET_DELAY)
            end
        end
    end)
end

local function StopAutoClick()
    Settings.AutoClick = false
    AutoClickLoopID += 1
end

