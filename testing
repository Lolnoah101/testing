local function RequestBlock(State)

    local Store =
        GetPlayerStore()


    if not Store then
        return
    end


    if IsBlocking(Store) == State then
        return
    end


    local Now =
        workspace:GetServerTimeNow()


    if (
        Now
        - LastBlockRequest
    ) < 0.025
    then

        return
    end


    LastBlockRequest =
        Now


    pcall(function()

        CharacterPackets
            .performBlock
            :fire(
                State
            )
    end)
end


local function IsEnemyTargetingUs(
    EnemyState
)

    local Target =
        EnemyGet(
            EnemyState,
            "target"
        )


    return Target ~= nil
        and tostring(Target)
            == tostring(
                LocalPlayer.UserId
            )
end


local function EnemyIsAttackingUs(
    EnemyState
)

    return IsEnemyTargetingUs(
        EnemyState
    )
        and EnemyGet(
            EnemyState,
            "attackStartedAt"
        ) ~= nil
end


local function ShouldHoldBlock()

    for _, EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
            and EnemyIsAttackingUs(
                EnemyState
            )
        then

            return true
        end
    end


    return false
end


local function GetEnemyConfig(
    EnemyName
)

    if EnemyConstants.enemiesByName then

        return EnemyConstants
            .enemiesByName[
                EnemyName
            ]
    end


    return EnemyConstants[
        EnemyName
    ]
end


local function FindParryAttack()

    local Now =
        workspace:GetServerTimeNow()


    for EnemyId,
        EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) <= 0
        then

            continue
        end


        if not IsEnemyTargetingUs(
            EnemyState
        )
        then

            continue
        end


        local StartedAt =
            EnemyGet(
                EnemyState,
                "attackStartedAt"
            )


        local AttackIndex =
            EnemyGet(
                EnemyState,
                "attackIndex"
            )


        local EnemyName =
            GetEnemyName(
                EnemyState
            )


        if not StartedAt
            or AttackIndex == nil
            or not EnemyName
        then

            continue
        end


        local Config =
            GetEnemyConfig(
                EnemyName
            )


        if not Config
            or not Config.attacks
        then

            continue
        end


        local Attack =
            Config.attacks[
                AttackIndex
            ]
            or Config.attacks[
                AttackIndex + 1
            ]


        if not Attack
            or not Attack.hitTime
        then

            continue
        end


        local AttackSpeed =
            Config.attackSpeed
            or 1


        local TimeUntilHit =
            Attack.hitTime
            - (
                Now
                - StartedAt
            )
            * AttackSpeed


        local Key =
            tostring(
                EnemyId
            )
            .. ":"
            .. tostring(
                StartedAt
            )


        if TimeUntilHit <= PARRY_LEAD
            and TimeUntilHit >= -PARRY_AFTER
            and not LastParriedAttack[Key]
        then

            LastParriedAttack[
                Key
            ] = true


            return true
        end
    end


    return false
end


local function RunPerfectParry()

    if not FindParryAttack() then
        return
    end


    RequestBlock(
        true
    )


    task.delay(
        PARRY_HOLD,

        function()

            if SessionAlive()
                and Settings.AutoBlock
                and Settings.BlockMode
                    == "Perfect Parry"
            then

                RequestBlock(
                    false
                )
            end
        end
    )
end


