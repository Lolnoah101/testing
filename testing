local function getFishingState()
    if FishingController then
        local ok, value = pcall(function()
            return FishingController:GetState()
        end)
        if ok and value then
            return value
        end
    end

    return State.CurrentFishingState or FState.Idling
end

local function updateFishingState(newState)
    if not newState or State.CurrentFishingState == newState then
        return
    end

    State.CurrentFishingState = newState
    State.StateEnteredAt = os.clock()

    if newState ~= FState.Holding and newState ~= FState.Throwing then
        mouseUp()
    end

    if newState == FState.Reeling then
        State.NextReelAt = 0
        State.NextSkillAt = 0
        State.SkillIndex = 1
    elseif newState == FState.Caught then
        State.NextLootClickAt = State.StateEnteredAt + Config.LootClickDelay
    elseif newState == FState.Idling then
        State.LastCastStarted = math.max(State.LastCastStarted, os.clock())
    end

    if Config.Mode == "Legit" then
        log("Legit state ->", newState)
    end
end

State.CurrentFishingState = getFishingState()
State.StateEnteredAt = os.clock()

if FishingController and FishingController.StateChanged then
    track(FishingController.StateChanged:Connect(updateFishingState))
else
    warnf("FishingController unavailable. Legit mode may not work; OP mode can still use packets.")
end

--==============================================================
-- COMMON QTE REMOTE
--==============================================================

local QTE_RESPONSE = {
    Left = "A",
    Right = "D",
    Up = "W",
    A = "A",
    D = "D",
    W = "W",
}

local function handleQTEPrompt(direction, windowSeconds)
    local key = QTE_RESPONSE[direction]
    if not key then
        warnf("Unknown QTE direction:", tostring(direction))
        return
    end

    local window = math.max(tonumber(windowSeconds) or 0, 0.15)

    State.QTEGeneration += 1
    local generation = State.QTEGeneration
    State.QTEActiveUntil = os.clock() + window

    if not Config.Enabled or not Config.AutoQTE then
        return
    end

    task.spawn(function()
        local floor = 0.11
        pcall(function()
            floor = math.max(floor, FishingConfig.Latency.QteReactionFloor + 0.01)
        end)

        local delaySeconds = math.max(floor, Config.QTEReactionDelay)
        delaySeconds = math.min(delaySeconds, math.max(floor, window - 0.04))
        task.wait(delaySeconds)

        if not State.Alive
            or not Config.Enabled
            or State.QTEGeneration ~= generation
            or os.clock() >= State.QTEActiveUntil then
            return
        end

        if Config.Mode == "Legit" then
            if getFishingState() ~= FState.Reeling then
                return
            end
        else
            if State.Phase ~= "Reeling" then
                return
            end
        end

        if safeFire(FishingPackets.FishQTEResponse, key) then
            State.QTECount += 1
            log("QTE remote", direction, "->", key, "mode=" .. Config.Mode)
        end
    end)
end

