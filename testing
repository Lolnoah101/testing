--//============================================================
--// MOVE INTO JOIN HITBOX
--//============================================================

local function MoveIntoQueueRoom(
    RoomNumber,
    Room
)

    local Root =
        GetRoot()


    if not Root
        or not Room
    then

        return false
    end


    local Hitbox =
        Room
            :FindFirstChild(
                "JoinHitbox",
                true
            )


    if not Hitbox
        or not Hitbox:IsA(
            "BasePart"
        )
    then

        return false
    end


    -- Preserve character orientation.
    -- Only move position.

    local Rotation =
        Root.CFrame
        - Root.Position


    Root.AssemblyLinearVelocity =
        Vector3.zero


    Root.AssemblyAngularVelocity =
        Vector3.zero


    Root.CFrame =
        CFrame.new(
            Hitbox.Position
        )
        * Rotation


    PendingLobbyRoom =
        RoomNumber


    LastLobbyRoomMove =
        os.clock()


    print(
        "[Anime Zero] Entering Queue Room:",
        RoomNumber
    )


    return true
end


