function Systems.getUnlockedSkillSlotCount(data, rodId)
    if type(data) ~= "table"
        or type(data.Rods) ~= "table"
        or type(rodId) ~= "string" then
        return 0
    end

    local rodCatalog = Catalog.Rod.GetById(rodId)
    local rodData = data.Rods[rodId]

    if type(rodCatalog) ~= "table"
        or type(rodData) ~= "table" then
        return 0
    end

    local authoredSlots =
        math.clamp(
            tonumber(rodCatalog.skillSlots) or 0,
            0,
            4
        )

    local masteryXp = tonumber(rodData.MasteryXp) or 0
    local masteryLevel = 1

    pcall(function()
        masteryLevel =
            Systems.RequiredExpLevel.getLevel(masteryXp)
    end)

    local unlocked = 0

    for index = 1, authoredSlots do
        local requiredLevel =
            type(rodCatalog.slotUnlockLevels) == "table"
            and tonumber(rodCatalog.slotUnlockLevels[index])
            or 1

        if not requiredLevel or requiredLevel <= masteryLevel then
            unlocked += 1
        end
    end

    return unlocked
end

function Systems.getSkillPowerScore(skillId)
    local skill = Catalog.Skill.GetById(skillId)

    if type(skill) ~= "table" then
        return -math.huge
    end

    local damage = tonumber(skill.damageCoef) or 0
    local cooldown = math.max(0.1, tonumber(skill.cooldown) or 999)
    local rarity =
        Systems.SkillRarityRank[tostring(skill.rarity or "")]
        or 0

    -- Favor actual combat output first, then rarity.
    -- Damage / cooldown makes "best" useful over a full fight rather
    -- than just picking one giant, extremely slow hit.
    return (damage / cooldown) * 100000
        + damage * 1000
        + rarity * 10
end

function Systems.getBestOwnedSkillIds(data, count)
    local owned = {}

    local books =
        type(data) == "table"
        and type(data.Inventory) == "table"
        and type(data.Inventory.Books) == "table"
        and data.Inventory.Books
        or {}

    for skillId, ownedCount in pairs(books) do
        if type(skillId) == "string"
            and type(ownedCount) == "number"
            and ownedCount > 0
            and Catalog.Skill.GetById(skillId) then
            owned[skillId] = true
        end
    end

    -- Equipped skill books are no longer present in the free Books count.
    -- Count anything currently sitting on any owned rod as owned too.
    for _, rodData in pairs(
        type(data) == "table"
        and type(data.Rods) == "table"
        and data.Rods
        or {}
    ) do
        if type(rodData) == "table"
            and type(rodData.BookSlots) == "table" then

            for index = 1, 4 do
                local skillId =
                    rodData.BookSlots["Slot" .. tostring(index)]

                if type(skillId) == "string"
                    and skillId ~= ""
                    and Catalog.Skill.GetById(skillId) then
                    owned[skillId] = true
                end
            end
        end
    end

    local candidates = {}

    for skillId in pairs(owned) do
        table.insert(candidates, {
            id = skillId,
            score = Systems.getSkillPowerScore(skillId),
        })
    end

    table.sort(candidates, function(a, b)
        if a.score == b.score then
            return a.id < b.id
        end

        return a.score > b.score
    end)

    local result = {}
    local used = {}

    if State.QuestForcedSkillId
        and owned[State.QuestForcedSkillId] then

        table.insert(result, State.QuestForcedSkillId)
        used[State.QuestForcedSkillId] = true
    end

    for _, candidate in ipairs(candidates) do
        if #result >= count then
            break
        end

        if not used[candidate.id] then
            used[candidate.id] = true
            table.insert(result, candidate.id)
        end
    end

    return result
end

function Systems.waitForRodEquip(rodId, timeoutSeconds)
    local deadline =
        os.clock() + math.max(0.2, timeoutSeconds or 2)

    while State.Alive and os.clock() < deadline do
        local data = getPlayerData()

        if data and data.RodEquip == rodId then
            return true
        end

        task.wait(0.05)
    end

    local data = getPlayerData()
    return data and data.RodEquip == rodId
end

function Systems.rawEquipRod(rodId)
    local data = getPlayerData()

    if not data
        or type(data.Rods) ~= "table"
        or data.Rods[rodId] == nil
        or not EquipmentsController
        or not EquipmentsController.EquipmentEquip then
        return false
    end

    if data.RodEquip == rodId then
        return true
    end

    local ok, accepted = pcall(function()
        return EquipmentsController.EquipmentEquip:Fire(
            "rod",
            rodId
        )
    end)

    if not ok or accepted ~= true then
        return false
    end

    return Systems.waitForRodEquip(rodId, 2)
end

function Systems.resetFishingForRodChange(reason)
    mouseUp()

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0
    State.SkillIndex = 1

    local shouldCancel = false

    if Config.Mode == "OP" then
        shouldCancel =
            State.Phase ~= "Idle"
    else
        local currentState =
            getFishingState()

        shouldCancel =
            currentState ~= nil
            and currentState ~= FState.Idling
            and currentState ~= FState.Holding
    end

    if shouldCancel then
        pcall(function()
            safeFire(FishingPackets.FishCancel)
        end)
    end

    if Config.Mode == "OP" then
        State.LastPacketAt = os.clock()
        resetOPSession(0.15)
    else
        State.LegitResumeAt = os.clock() + 0.18
        State.CurrentFishingState = getFishingState()
        State.StateEnteredAt = os.clock()

        task.delay(0.18, function()
            if State.Alive
                and Config.Enabled
                and Config.Mode == "Legit" then

                State.CurrentFishingState = getFishingState()
                State.StateEnteredAt = os.clock()
                State.LastCastStarted = 0
                State.LastPrimaryClick = 0
            end
        end)
    end

    State.RodWatchStatus =
        reason or "Fishing session reset for rod change"
end

function Systems.transferBestSkillsToRod(targetRodId)
    if State.SkillTransferBusy
        or not Config.AutoEquipBestSkills then
        return false
    end

    local data = getPlayerData()

    if not data
        or type(data.Rods) ~= "table"
        or data.Rods[targetRodId] == nil then
        State.SkillTransferStatus = "Target rod unavailable"
        return false
    end

    local unlockedSlots =
        Systems.getUnlockedSkillSlotCount(
            data,
            targetRodId
        )

    if unlockedSlots <= 0 then
        State.SkillTransferStatus =
            "No unlocked skill slots on "
            .. tostring(
                Systems.RodIdToName[targetRodId]
                or targetRodId
            )
        State.LastSkillTransferRodId = targetRodId
        return true
    end

    local desired =
        Systems.getBestOwnedSkillIds(
            data,
            unlockedSlots
        )

    if #desired == 0 then
        State.SkillTransferStatus = "No owned skill books"
        State.LastSkillTransferRodId = targetRodId
        return true
    end

    if not EquipmentsController
        or not EquipmentsController.EquipMoveset then
        State.SkillTransferStatus = "EquipMoveset unavailable"
        return false
    end

    State.SkillTransferBusy = true
    State.SkillTransferStatus =
        "Moving best skills to "
        .. tostring(
            Systems.RodIdToName[targetRodId]
            or targetRodId
        )

    local desiredSet = {}

    for _, skillId in ipairs(desired) do
        desiredSet[skillId] = true
    end

    -- First free the desired skill books from every other rod.
    -- EquipMoveset always edits the currently equipped rod, so source
    -- rods are equipped briefly, their desired skills are removed,
    -- then the target rod is restored.
    local sourceRemovals = {}

    for rodId, rodData in pairs(data.Rods) do
        if rodId ~= targetRodId
            and type(rodData) == "table"
            and type(rodData.BookSlots) == "table" then

            for index = 1, 4 do
                local slotName = "Slot" .. tostring(index)
                local skillId = rodData.BookSlots[slotName]

                if desiredSet[skillId] then
                    sourceRemovals[rodId] =
                        sourceRemovals[rodId] or {}

                    table.insert(
                        sourceRemovals[rodId],
                        index
                    )
                end
            end
        end
    end

    local function fail(message)
        State.SkillTransferBusy = false
        State.SkillTransferStatus = message
        return false
    end

    for sourceRodId, slotIndexes in pairs(sourceRemovals) do
        if not Systems.rawEquipRod(sourceRodId) then
            return fail(
                "Could not equip source rod for skill transfer"
            )
        end

        for _, slotIndex in ipairs(slotIndexes) do
            local ok, response = pcall(function()
                return EquipmentsController.EquipMoveset:Fire(
                    "",
                    slotIndex
                )
            end)

            if not ok or response ~= "Success" then
                return fail(
                    "Could not remove skill from old rod"
                )
            end

            task.wait(0.06)
        end
    end

    if not Systems.rawEquipRod(targetRodId) then
        return fail("Could not restore target rod")
    end

    -- Clear the target loadout so the new ranking is deterministic.
    for index = 1, unlockedSlots do
        local refreshed = getPlayerData()
        local targetData =
            refreshed
            and refreshed.Rods
            and refreshed.Rods[targetRodId]

        local slotName = "Slot" .. tostring(index)
        local currentSkill =
            targetData
            and targetData.BookSlots
            and targetData.BookSlots[slotName]
            or ""

        if currentSkill ~= "" then
            local ok, response = pcall(function()
                return EquipmentsController.EquipMoveset:Fire(
                    "",
                    index
                )
            end)

            if not ok or response ~= "Success" then
                return fail(
                    "Could not clear target skill slot "
                    .. tostring(index)
                )
            end

            task.wait(0.06)
        end
    end

    -- Equip strongest owned skills into every currently unlocked slot.
    local equippedNames = {}

    for index, skillId in ipairs(desired) do
        if index > unlockedSlots then
            break
        end

        local ok, response = pcall(function()
            return EquipmentsController.EquipMoveset:Fire(
                skillId,
                index
            )
        end)

        if not ok or response ~= "Success" then
            return fail(
                "Skill equip failed: "
                .. tostring(skillId)
                .. " -> Slot"
                .. tostring(index)
                .. " ("
                .. tostring(response)
                .. ")"
            )
        end

        local info = Catalog.Skill.GetById(skillId)

        table.insert(
            equippedNames,
            tostring(info and info.name or skillId)
        )

        task.wait(0.08)
    end

    State.SkillTransferBusy = false
    State.LastSkillTransferRodId = targetRodId
    State.LastObservedRodId = targetRodId
    State.SkillTransferStatus =
        "Best skills: "
        .. table.concat(equippedNames, ", ")

    Systems.resetFishingForRodChange(
        "Skill loadout ready; fishing resumed"
    )

    return true
end

function Systems.isBestSkillLoadout(data, rodId)
    if not data or not rodId then
        return true
    end

    local unlocked =
        Systems.getUnlockedSkillSlotCount(data, rodId)

    if unlocked <= 0 then
        return true
    end

    local desired =
        Systems.getBestOwnedSkillIds(data, unlocked)

    local rod =
        data.Rods
        and data.Rods[rodId]

    local slots =
        rod
        and rod.BookSlots

    if type(slots) ~= "table" then
        return false
    end

    for index = 1, unlocked do
        local current =
            slots["Slot" .. tostring(index)]
            or ""

        local wanted =
            desired[index]
            or ""

        if current ~= wanted then
            return false
        end
    end

    return true
end

function Systems.stepBestSkillLoadoutWatcher()
    if not Config.AutoEquipBestSkills then
        return true
    end

    if State.SkillTransferBusy
        or State.RodRecoveryBusy then
        return false
    end

    if State.TravelBusy
        or State.AutoSellBusy
        or State.ProgressionNavigationBusy then
        return true
    end

    local now = os.clock()

    if now - State.LastBestSkillCheck < 0.75 then
        return true
    end

    State.LastBestSkillCheck = now

    local data = getPlayerData()
    local rodId =
        data
        and type(data.RodEquip) == "string"
        and data.RodEquip ~= ""
        and data.RodEquip
        or nil

    if not rodId then
        return false
    end

    if Systems.isBestSkillLoadout(data, rodId) then
        State.SkillTransferStatus = "Best skills equipped"
        State.LastSkillTransferRodId = rodId
        return true
    end

    if not Systems.isRodChangeSafe() then
        State.SkillTransferStatus =
            "Better skill loadout found; waiting for fishing idle"
        return true
    end

    local changed =
        Systems.transferBestSkillsToRod(rodId)

    if changed then
        State.LegitResumeAt =
            math.max(
                State.LegitResumeAt,
                os.clock() + 0.18
            )
    end

    return false
end

function Systems.stepFishingRodWatchdog()
    if not Config.Enabled then
        State.RodMissingSince = 0
        return true
    end

    local now = os.clock()

    if State.TravelBusy
        or State.AutoSellBusy
        or State.ProgressionNavigationBusy
        or now < State.RodRecoveryHoldUntil then

        mouseUp()
        return false
    end

    if now - State.LastRodWatchCheck
        < math.max(
            0.10,
            tonumber(Config.RodWatchInterval) or 0.25
        ) then

        return not State.RodRecoveryBusy
            and not State.SkillTransferBusy
            and State.LastObservedRodId ~= nil
    end

    State.LastRodWatchCheck = now

    if State.SkillTransferBusy then
        mouseUp()
        return false
    end

    local data = getPlayerData()
    local rodId =
        data
        and data.RodEquip
        or nil

    local currentRod =
        type(rodId) == "string"
        and rodId ~= ""
        and rodId ~= "None"
        and type(data and data.Rods) == "table"
        and data.Rods[rodId] ~= nil
        and Catalog.Rod.GetById(rodId) ~= nil
        and rodId
        or nil

    if not currentRod then
        mouseUp()

        if State.RodMissingSince == 0 then
            State.RodMissingSince = now
            State.LastObservedRodId = nil
            State.LastSkillTransferRodId = nil
            Systems.resetFishingForRodChange(
                "Rod unequipped; waiting to recover"
            )
        end

        -- Give manual inventory changes a brief moment to settle.
        if now - State.RodMissingSince < 0.80 then
            return false
        end

        if not State.RodRecoveryBusy then
            local bestRod = Systems.getBestOwnedRod(data)

            if bestRod then
                State.RodRecoveryBusy = true
                State.RodWatchStatus =
                    "Rod missing; auto-equipping "
                    .. tostring(
                        Systems.RodIdToName[bestRod]
                        or bestRod
                    )

                task.spawn(function()
                    local equipped =
                        Systems.rawEquipRod(bestRod)

                    State.RodRecoveryBusy = false

                    if equipped then
                        State.RodMissingSince = 0
                        State.LastObservedRodId = bestRod
                        State.RodLastEquipped = bestRod

                        Systems.resetFishingForRodChange(
                            "Rod recovered automatically"
                        )

                        -- Best-skill watcher handles the recovered rod
                        -- on the next worker cycle.
                    else
                        State.RodWatchStatus =
                            "Rod recovery failed; retrying"
                    end
                end)
            else
                State.RodWatchStatus =
                    "No owned rod available to equip"
            end
        end

        return false
    end

    State.RodMissingSince = 0

    if State.LastObservedRodId ~= currentRod then
        local previousRod = State.LastObservedRodId

        State.LastObservedRodId = currentRod
        State.RodLastEquipped = currentRod
        State.LastSkillTransferRodId = nil

        Systems.resetFishingForRodChange(
            previousRod
                and "Rod changed; fishing session rebuilt"
                or "Rod detected; fishing session ready"
        )

        -- Skill loadout is handled by the dedicated watcher.
    end

    if State.RodRecoveryBusy
        or State.SkillTransferBusy then
        return false
    end

    State.RodWatchStatus =
        "Rod ready: "
        .. tostring(
            Systems.RodIdToName[currentRod]
            or currentRod
        )

    return true
end

function Systems.getRodStat(rod, statName)
    if type(rod) ~= "table" or type(rod.stats) ~= "table" then
        return 0
    end

    for _, modifier in ipairs(rod.stats) do
        if type(modifier) == "table"
            and modifier.stat == statName
            and modifier.op == "add" then
            return tonumber(modifier.value) or 0
        end
    end

    return 0
end

for _, rod in ipairs(Catalog.Rod.GetAll()) do
    if type(rod) == "table" and type(rod.id) == "string" then
        local entry = {
            id = rod.id,
            name = tostring(rod.name or rod.id),
            attack = Systems.getRodStat(rod, "attackDamage"),
            luck = Systems.getRodStat(rod, "luck"),
            rarity = tostring(rod.rarity or ""),
            shop = RodShopConfig[rod.id],
        }

        table.insert(Systems.RodDefinitions, entry)
        Systems.RodNameToId[entry.name] = entry.id
        Systems.RodIdToName[entry.id] = entry.name

        -- All scanned rods increase monotonically in attack and luck.
        -- Attack is the main sort value; luck breaks an unlikely tie.
        Systems.RodScore[entry.id] = entry.attack * 1000 + entry.luck
    end
end

table.sort(Systems.RodDefinitions, function(a, b)
    local aScore = Systems.RodScore[a.id] or 0
    local bScore = Systems.RodScore[b.id] or 0

    if aScore == bScore then
        return a.name < b.name
    end

    return aScore < bScore
end)

for _, rod in ipairs(Systems.RodDefinitions) do
    table.insert(Systems.RodOptions, rod.name)
end

function Systems.isIslandUnlocked(data, islandId)
    if not islandId or islandId == "" then
        return true
    end

    local islandConfig = IslandConfig[islandId]
    if islandConfig and islandConfig.defaultUnlocked then
        return true
    end

    return type(data) == "table"
        and type(data.UnlockedIslands) == "table"
        and data.UnlockedIslands[islandId] == true
end

function Systems.getBestOwnedRod(data)
    if type(data) ~= "table" or type(data.Rods) ~= "table" then
        return nil
    end

    local bestId = nil
    local bestScore = -math.huge

    for rodId, owned in pairs(data.Rods) do
        if owned ~= nil then
            local score = Systems.RodScore[rodId]

            if score and score > bestScore then
                bestScore = score
                bestId = rodId
            end
        end
    end

    return bestId
end

function Systems.getNextPurchasableShopRod(data, requireAffordable)
    if type(data) ~= "table" or type(data.Rods) ~= "table" then
        return nil
    end

    local candidates = {}

    for _, rod in ipairs(Systems.RodDefinitions) do
        local shop = rod.shop

        if shop and data.Rods[rod.id] == nil then
            table.insert(candidates, {
                id = rod.id,
                name = rod.name,
                price = tonumber(shop.price) or 0,
                islandId = shop.islandId,
                score = Systems.RodScore[rod.id] or 0,
            })
        end
    end

    table.sort(candidates, function(a, b)
        if a.score == b.score then
            return a.price < b.price
        end

        return a.score < b.score
    end)

    local coins = tonumber(data.Coin) or 0

    for _, candidate in ipairs(candidates) do
        if Systems.isIslandUnlocked(data, candidate.islandId) then
            if not requireAffordable or coins >= candidate.price then
                return candidate
            end
        end
    end

    return nil
end

function Systems.isRodChangeSafe()
    if State.AutoSellBusy or State.RodBusy then
        return false
    end

    if Config.Mode == "OP" then
        return State.Phase == "Idle"
    end

    local state = getFishingState()
    return state == FState.Idling or state == nil
end

function Systems.equipRodById(rodId)
    if State.RodBusy then
        return false
    end

    local data = getPlayerData()

    if not data or type(data.Rods) ~= "table" then
        State.RodLastStatus = "Player data unavailable"
        return false
    end

    if not rodId or data.Rods[rodId] == nil then
        State.RodLastStatus = "Rod not owned"
        return false
    end

    if data.RodEquip == rodId then
        State.RodLastEquipped = rodId
        State.RodLastStatus = "Already equipped: " .. (Systems.RodIdToName[rodId] or rodId)
        return true
    end

    if not Systems.isRodChangeSafe() then
        State.RodLastStatus = "Waiting for fishing to become idle"
        return false
    end

    if not EquipmentsController or not EquipmentsController.EquipmentEquip then
        State.RodLastStatus = "Equipment controller unavailable"
        return false
    end

    State.RodBusy = true

    local ok, accepted = pcall(function()
        return EquipmentsController.EquipmentEquip:Fire("rod", rodId)
    end)

    State.RodBusy = false

    if not ok or accepted ~= true then
        State.RodLastStatus = "Equip rejected: " .. (Systems.RodIdToName[rodId] or rodId)
        return false
    end

    State.RodLastEquipped = rodId
    State.RodLastStatus = "Equipped: " .. (Systems.RodIdToName[rodId] or rodId)
    log("Rod:", State.RodLastStatus)
    return true
end

function Systems.equipBestOwnedRod()
    local data = getPlayerData()
    local bestId = Systems.getBestOwnedRod(data)

    if not bestId then
        State.RodLastStatus = "No owned rod found"
        return false
    end

    return Systems.equipRodById(bestId)
end

function Systems.purchaseNextRod()
    if State.RodBusy then
        return false
    end

    local data = getPlayerData()
    local nextRod = Systems.getNextPurchasableShopRod(data, false)

    if not nextRod then
        State.RodLastStatus = "No remaining unlocked shop rod"
        return false
    end

    local coins = tonumber(data and data.Coin) or 0

    if coins < nextRod.price then
        State.RodLastStatus =
            string.format(
                "Need %d Coins for %s",
                nextRod.price,
                nextRod.name
            )
        return false
    end

    if not FishingRodShopController
        or not FishingRodShopController.PurchaseRod then
        State.RodLastStatus = "Rod shop controller unavailable"
        return false
    end

    if not Systems.isRodChangeSafe() then
        State.RodLastStatus = "Waiting for fishing to become idle"
        return false
    end

    State.RodBusy = true

    local ok, accepted = pcall(function()
        return FishingRodShopController.PurchaseRod:Fire(nextRod.id)
    end)

    State.RodBusy = false

    if not ok or accepted ~= true then
        State.RodLastStatus = "Purchase rejected: " .. nextRod.name
        return false
    end

    State.RodLastPurchased = nextRod.id
    State.RodLastStatus =
        string.format("Purchased %s for %d Coins", nextRod.name, nextRod.price)

    log("Rod:", State.RodLastStatus)

    -- Give replicated player data a short moment to receive the new rod.
    task.wait(0.15)

    if Config.AutoEquipBestRod then
        Systems.equipBestOwnedRod()
    end

    return true
end

function Systems.stepRodAutomation()
    if Config.AutoProgression then
        return
    end

    -- Quest-required rods take priority over ordinary "best rod" automation.
    if Config.AutoQuestManager
        and Config.AutoQuestConfigure
        and State.QuestForcedRodId then

        local data = getPlayerData()
        if data and data.RodEquip ~= State.QuestForcedRodId then
            Systems.equipRodById(State.QuestForcedRodId)
        end
        return
    end

    if not Config.AutoEquipBestRod and not Config.AutoBuyNextRod then
        return
    end

    local now = os.clock()

    if now - State.LastRodAutomationCheck
        < math.max(0.25, tonumber(Config.RodAutomationCheckInterval) or 1) then
        return
    end

    State.LastRodAutomationCheck = now

    if not Systems.isRodChangeSafe() then
        return
    end

    if Config.AutoBuyNextRod then
        local data = getPlayerData()
        local affordable = Systems.getNextPurchasableShopRod(data, true)

        if affordable then
            Systems.purchaseNextRod()
            return
        end
    end

    if Config.AutoEquipBestRod then
        Systems.equipBestOwnedRod()
    end
end

