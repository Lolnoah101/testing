-- Isolate Settings to prevent Luau exceeding 200 active local registers.
-- Keep all Settings declarations inside this function instead of in script scope.
function state.InitializeSettings()
local TeleportService = game:GetService("TeleportService")
local settingsTab = window:CreateTab({ name = "Settings", icon = "settings" })
