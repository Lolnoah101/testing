-- Anti AFK diagnostics and a retryable best-effort input loop.
-- Roblox idle kicks are engine-controlled: these calls may be blocked or ignored.
state.AntiAFKLoopToken = 0
state.AntiAFKLastUserInput = os.clock()
state.AntiAFKLastPulseAt = -math.huge
state.AntiAFKIdledCount = 0
state.AntiAFKStatus = "OFF"

state.SetAntiAFKStatus = function(message)
    if state.AntiAFKStatus == message then return end
    state.AntiAFKStatus = message
    if state.AntiAFKStatusText then
        pcall(function() state.AntiAFKStatusText:Set(message) end)
    end
end

state.TryAntiAFKPulse = function(reason)
    if not state.Running or not state.AutoAntiAFK then return end
    -- Avoid two overlapping calls (timer + Idled signal).
    if os.clock() - state.AntiAFKLastPulseAt < 20 then return end
    state.AntiAFKLastPulseAt = os.clock()

    local methods = {}
    local errors = {}
    -- First try a keyboard event. Many clients disallow this API.
    local okKeyboard, keyError = pcall(function()
        local inputManager = game:GetService("VirtualInputManager")
        inputManager:SendKeyEvent(true, Enum.KeyCode.F15, false, game)
        task.wait(0.05)
        inputManager:SendKeyEvent(false, Enum.KeyCode.F15, false, game)
    end)
    if okKeyboard then
        table.insert(methods, "VirtualInputManager")
    else
        table.insert(errors, "Keyboard: " .. tostring(keyError))
    end

    -- Second try VirtualUser. It is legacy and may not work in newer clients.
    local okVirtualUser, vuError = pcall(function()
        local vu = game:GetService("VirtualUser")
        vu:CaptureController()
        vu:ClickButton2(Vector2.new(0, 0),
            Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame or CFrame.new())
    end)
    if okVirtualUser then
        table.insert(methods, "VirtualUser")
    else
        table.insert(errors, "VirtualUser: " .. tostring(vuError))
    end

    if #methods > 0 then
        local message = "Input attempted (" .. table.concat(methods, ", ") .. ")"
            .. "; source: " .. tostring(reason)
            .. ". AFK reset is not guaranteed."
        state.SetAntiAFKStatus(message)
    else
        state.SetAntiAFKStatus("Unavailable: Roblox/client denied simulated input. Check console.")
        -- Only log the error when it changes; don't flood the console every minute.
        local failure = table.concat(errors, " | ")
        if failure ~= state.AntiAFKLastError then
            state.AntiAFKLastError = failure
            warn("[Paraiso Anti AFK] " .. failure)
        end
    end
end

local function disableAntiAFK()
    state.AntiAFKLoopToken += 1  -- terminate any active scheduler on next tick
    for _, connectionName in ipairs({
        "AntiAFKConnection", "AntiAFKInputConnection", "AntiAFKMovementConnection"
    }) do
        local connection = state[connectionName]
        state[connectionName] = nil
        if connection then pcall(function() connection:Disconnect() end) end
    end
    state.SetAntiAFKStatus("OFF")
end

local function enableAntiAFK()
    if state.AntiAFKConnection then return end
    state.AntiAFKLastUserInput = os.clock()
    state.AntiAFKLastPulseAt = -math.huge
    state.AntiAFKIdledCount = 0
    state.AntiAFKLastError = nil
    state.AntiAFKLoopToken += 1
    local myToken = state.AntiAFKLoopToken
    state.SetAntiAFKStatus("ON — monitoring; first attempt after 70 seconds of no input.")

    local UIS = game:GetService("UserInputService")
    state.AntiAFKInputConnection = UIS.InputBegan:Connect(function(_, processed)
        -- Real input typically resets the idle clock. No simulated action needed.
        state.AntiAFKLastUserInput = os.clock()
    end)
    state.AntiAFKMovementConnection = UIS.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or
            input.UserInputType == Enum.UserInputType.Touch then
            state.AntiAFKLastUserInput = os.clock()
        end
    end)

    state.AntiAFKConnection = player.Idled:Connect(function(secondsIdle)
        if not state.Running or not state.AutoAntiAFK then return end
        state.AntiAFKIdledCount += 1
        state.TryAntiAFKPulse("Roblox Idled (" .. math.floor(secondsIdle) .. "s)")
        -- Detect continued Roblox idle reporting, even after earlier attempts.
        if state.AntiAFKIdledCount >= 2 then
            state.SetAntiAFKStatus("Roblox still reports idle despite attempts; client may reject them.")
        end
    end)

    task.spawn(function()
        while state.Running and state.AutoAntiAFK
            and state.AntiAFKLoopToken == myToken do
            task.wait(10)
            if not (state.Running and state.AutoAntiAFK and
                state.AntiAFKLoopToken == myToken) then break end
            if os.clock() - state.AntiAFKLastUserInput >= 70
                and os.clock() - state.AntiAFKLastPulseAt >= 60 then
                state.TryAntiAFKPulse("periodic check")
            end
        end
    end)
end

-- Reconnect is best-effort ONLY. Once fully disconnected, the Roblox client
-- may no longer be able to send a teleport request. Never retry moderation
-- kicks, bans, or other access restrictions.
local function reconnectIfAllowed()
    if not state.Running or not state.AutoReconnect then return end
    local now = os.clock()
    if now - state.LastReconnectAttempt < 30 then return end
    state.LastReconnectAttempt = now
    local ok, err = pcall(function()
        -- The client-side Teleport API is legacy and can be unavailable.
        -- TeleportAsync is server-only and cannot be used in this script.
        TeleportService:Teleport(game.PlaceId, player)
    end)
    if not ok then
        warn("[Paraiso Settings] Reconnect request failed; manual rejoin may be needed:", err)
    end
end

local function isConnectionLossPrompt(prompt)
    local texts = {}
    for _, object in ipairs(prompt:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            table.insert(texts, object.Text)
        end
    end
    local content = string.lower(table.concat(texts, " "))
    -- Do not attempt to undo removal from a server by a moderator or a ban.
    for _, blocked in ipairs({
        "kicked", "banned", "moderated", "restricted", "suspended",
        "error code: 267", "error code: 268"
    }) do
        if string.find(content, blocked, 1, true) then return false end
    end
    return string.find(content, "disconnected", 1, true) ~= nil
        or string.find(content, "lost connection", 1, true) ~= nil
        or string.find(content, "connection lost", 1, true) ~= nil
        or string.find(content, "error code: 277", 1, true) ~= nil
end

local function reconnectOnPromptAdded(prompt)
    if not state.Running or not state.AutoReconnect then return end
    task.delay(0.75, function()
        if not state.Running or not state.AutoReconnect then return end
        local ok, isLoss = pcall(isConnectionLossPrompt, prompt)
        if ok and isLoss then
            reconnectIfAllowed()
        end
    end)
end

local function disableAutoReconnect()
    if state.ReconnectPromptConnection then
        state.ReconnectPromptConnection:Disconnect()
        state.ReconnectPromptConnection = nil
    end
    if state.ReconnectOverlayConnection then
        state.ReconnectOverlayConnection:Disconnect()
        state.ReconnectOverlayConnection = nil
    end
end

local function enableAutoReconnect()
    if state.ReconnectPromptConnection or state.ReconnectOverlayConnection then return end
    task.spawn(function()
        local ok, result = pcall(function()
            local coreGui = game:GetService("CoreGui")
            local promptGui = coreGui:WaitForChild("RobloxPromptGui", 8)
            return promptGui and promptGui:WaitForChild("promptOverlay", 8)
        end)
        if not state.Running or not state.AutoReconnect then return end
        if not ok or not result then
            warn("[Paraiso Settings] Reconnect prompt unavailable in this client")
            return
        end
        local overlay = result
        state.ReconnectPromptConnection = overlay.ChildAdded:Connect(reconnectOnPromptAdded)
        for _, child in ipairs(overlay:GetChildren()) do
            reconnectOnPromptAdded(child)
        end
    end)
end

