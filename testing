                return nil
            end


            local function PostWebhook(Payload)

                local URL =
                    tostring(Settings.WebhookURL or "")


                if not IsDiscordWebhook(URL) then
                    return false,
                        "Enter a valid Discord webhook URL."
                end


                local Body =
                    HttpService:JSONEncode(Payload)

                local Request =
                    GetRequestFunction()


                if Request then

                    local Success,
                        Response =
                        pcall(
                            Request,
                            {
                                Url = URL,
                                Method = "POST",
                                Headers = {
                                    ["Content-Type"] = "application/json",
                                },
                                Body = Body,
                            }
                        )


                    if not Success then
                        return false,
                            "Executor HTTP request failed."
                    end


                    if type(Response) == "table" then

                        local Status =
                            tonumber(
                                Response.StatusCode
                                or Response.Status
                                or Response.status_code
                            )


                        if Status
                            and (
                                Status < 200
                                or Status >= 300
                            )
                        then
                            return false,
                                "Discord returned HTTP "
                                .. tostring(Status)
                        end
                    end


                    return true,
                        "Discord received the embed."
                end


                local Success =
                    pcall(function()
                        HttpService:PostAsync(
                            URL,
                            Body,
                            Enum.HttpContentType.ApplicationJson,
                            false
                        )
                    end)


                return Success,
                    Success
                    and "Discord received the embed."
                    or "Your executor does not expose an HTTP request function."
            end


            local Modules = nil


            local function LoadModules()

                if Modules then
                    return Modules
                end


                local GameFolder =
                    ReplicatedStorageService
                        :FindFirstChild("game")

                local Stores =
                    GameFolder
                    and GameFolder:FindFirstChild("stores")

                local Global =
                    ReplicatedStorageService
                        :FindFirstChild("global")

                -- Account data is in ReplicatedStorage.global.stores,
                -- while the run state is in ReplicatedStorage.game.stores.
                local GlobalStores =
                    Global and Global:FindFirstChild("stores")

                local Utils =
                    Global
                    and Global:FindFirstChild("utils")

                local Constants =
                    Global
                    and Global:FindFirstChild("constants")

                local Assets =
                    ReplicatedStorageService
                        :FindFirstChild("assets")

                local Config =
                    Assets
                    and Assets:FindFirstChild("config")


                -- Account stats can load in the lobby too. A run store is
                -- only required for finished-match rewards inside a map.
                if not GlobalStores
                    or not GlobalStores:FindFirstChild("accountNamespace")
                    or not Utils
                    or not Utils:FindFirstChild("levelProgression")
                then
                    return nil
                end


                local Result = {}


                local Success =
                    pcall(function()
                        Result.AccountNamespace =
                            require(
