            local Result, Seen = {}, {}
            for CharacterId in pairs(EvoConfig) do
                local Info = NamesData.charactersByName[CharacterId]
                local Label = Info and Info.displayName
                if type(Label) == "string" and Label ~= "" and not Seen[Label] then
                    Seen[Label] = true
                    table.insert(Result, Label)
