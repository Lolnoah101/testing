-- Ownership is event-driven in the game. The normal CharacterModule cache
-- may arrive after this script builds the UI; some lobby handoffs only have
-- currently equipped stats populated. Never turn that *partial* live snapshot
-- into a destructive refresh of the user's full character list.
local function collectedCharacters()
    local settings=getSettings()
    local valid=settings and settings.CharacterSettings
    if type(valid)~="table" then return nil,false end
    if type(S.knownOwnedCharacters)~="table" then S.knownOwnedCharacters={} end
    local names={}
    local nativeCount,inventoryCount,equippedCount=0,0,0
    local changed=false
    local function include(name,source)
        if type(name)~="string" or not valid[name] then return end
        names[name]=true
        if S.knownOwnedCharacters[name]~=true then
            S.knownOwnedCharacters[name]=true
            changed=true
        end
        if source=="native" then nativeCount=nativeCount+1
        elseif source=="inventory" then inventoryCount=inventoryCount+1
        elseif source=="equipped" then equippedCount=equippedCount+1 end
    end
    -- Reuse already verified ownership across mode-driven character swaps.
    for name,yes in pairs(S.knownOwnedCharacters) do
        if yes==true and valid[name] then names[name]=true end
    end
    local module=getCharacterModule()
    if module then
        -- returnCharacterCollectedTable is the game-native *character-only* set.
        if type(module.returnCharacterCollectedTable)=="function" then
            local ok, collected=pcall(module.returnCharacterCollectedTable,false)
            if ok and type(collected)=="table" then
                for name,has in pairs(collected) do
                    if has then include(name,"native") end
                end
            end
        end
        -- The combined collection table is a fallback if the specific cache
        -- wasn't ready. Filter through CharacterSettings to exclude other items.
        if type(module.returnCollectedTable)=="function" then
            local ok, collected=pcall(module.returnCollectedTable,false)
            if ok and type(collected)=="table" then
                for name,has in pairs(collected) do
                    if has then include(name,"native") end
                end
            end
        end
    end
    local gui=player:FindFirstChildOfClass("PlayerGui")
    local inventory=gui and gui:FindFirstChild("CharacterInventoryScrollingFrame",true)
    if inventory then
        -- Do not require the inventory window to be visible/open: entries can
        -- remain hidden while switching between lobby menus and Speed Raid.
        for _,slot in ipairs(inventory:GetDescendants()) do
            if slot:IsA("GuiObject") and valid[slot.Name]
                and slot:FindFirstChild("CharacterImage")
                and slot:FindFirstChild("CharacterClick") then
                include(slot.Name,"inventory")
            end
        end
    end
    for _,key in ipairs({"CharacterName","AssistCharacterName1","AssistCharacterName2"}) do
        include(stat(key),"equipped")
    end
    if nativeCount>0 or inventoryCount>0 then S.knownOwnedComplete=true end
    if changed then savePreferences() end
    if not next(names) then return nil,false end
    return names,S.knownOwnedComplete==true,nativeCount,inventoryCount,equippedCount
end

local function ownedLoadoutOptions()
    local options={"Select Character"}
    local owned=collectedCharacters()
    local settings=getSettings()
    local config=settings and settings.CharacterSettings or {}
    local names={}
    for name,has in pairs(owned or {}) do
        if has and config[name] then names[name]=true end
    end
    -- The permanent preset must remain visible even when Roblox has only
    -- replicated the equipped three characters in this place/server.
    for _,slot in ipairs({"main","assist1","assist2"}) do
        local name=S.preferredLoadout and S.preferredLoadout[slot]
        if type(name)=="string" and config[name] then names[name]=true end
    end
    local ordered={}
    for name in pairs(names) do ordered[#ordered+1]=name end
    table.sort(ordered,function(a,b)
        local ar=tonumber(config[a].collectionRankValue) or 0
        local br=tonumber(config[b].collectionRankValue) or 0
        return ar==br and a<b or ar>br
    end)
    for _,name in ipairs(ordered) do options[#options+1]=name end
    return options,S.knownOwnedComplete==true
end
local function speedCharacterOptions()
    local options={"Auto — Next Unused"}
    local owned=collectedCharacters() or {}
    local settings=getSettings()
    local chars=settings and settings.CharacterSettings or {}
    local sorted={}
    for name, v in pairs(owned) do
        if v and chars[name] then sorted[#sorted+1]=name end
    end
    table.sort(sorted,function(a,b)
        local av=tonumber(chars[a].collectionRankValue) or 0
        local bv=tonumber(chars[b].collectionRankValue) or 0
        return av==bv and a<b or av>bv
    end)
    for _,name in ipairs(sorted) do options[#options+1]=name end
