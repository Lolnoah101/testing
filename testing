    if not Farm.autoExecute then return end

    local queue = queueFunction()
    if not queue then
        do end
        return
    end
    if Farm.queuedAutoExecute then return end

    -- Queue only a small network loader, not a script copy. Every successful
    -- teleport makes a fresh request to the configured GitHub raw file.
    local queued = string.format([==[
task.spawn(function()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local jobKey = tostring(game.JobId) .. ":" .. tostring(game.PlaceId)
    if env.HollowMoonAOTQueueJob == jobKey then return end
    env.HollowMoonAOTQueueJob = jobKey

    local function enabled()
        if type(readfile) ~= "function" then return false end
        local ok, flag = pcall(readfile, %q)
        return ok and flag == "1"
    end
    if not enabled() then
        env.HollowMoonAOTQueueJob = nil
        return
    end
    if type(loadstring) ~= "function" then
        do end
        env.HollowMoonAOTQueueJob = nil
        return
    end

    local url = %q
    for attempt = 1, 2 do
        if not enabled() then return end
        -- The unique query helps avoid stale CDN responses without using a
        -- local source cache or imposing a strict version requirement.
