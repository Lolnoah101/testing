local function boatOwnershipSummary()
    local owned = ClientData.Get("OwnedBoats") or {}
    local count, bestTier, bestName = 0, 0, "None"
    for _, id in ipairs(Boats.Order) do
        if ownsBoat(id, owned) then
            count += 1
            local info = Boats[id]
            local tier = tonumber(info and info.Tier) or 0
            if tier > bestTier then
                bestTier = tier
                bestName = info.DisplayName or id
            end
        end
    end
    return count, bestName, bestTier
end

local function doAutoBuyBoat()
    if not running or not autoBuyBoat or not ClientData.IsReady() then return end

    local id, info = nextBoatToBuy()
    if boatPending and (id == nil or boatPending.id ~= id) then
        -- The requested boat appeared in OwnedBoats. Only now move to the next one.
        print("[Tame V18] Boat purchase confirmed: " .. tostring(boatPending.id))
        boatPending = nil
        boatAttempts = 0
        boatPurchaseStatus = "Previous purchase confirmed"
    end
    if not id or not info then
        boatPurchaseStatus = "All boats owned"
        return
    end

    local levelReq = tonumber(info.LevelReq) or 0
    local price = tonumber(info.Price) or math.huge
    local level = getNumber("Level", 1)
    local coins = getNumber("Coins", 0)
    if level < levelReq then
        boatPurchaseStatus = "Waiting for level " .. tostring(levelReq)
        return
    end
    if coins < price then
        boatPurchaseStatus = "Waiting for coins"
        return
    end

    local now = os.clock()
    -- Wait for OwnedBoats to confirm the purchase before trying it again.
    if boatPending and now - boatPending.at < 5 then
        boatPurchaseStatus = "Awaiting purchase confirmation"
        return
    end
    if boatAttempts >= 3 then
        boatPurchaseStatus = "Paused: 3 requests without ownership confirmation; check boat shop access"
        warn("[Tame V18] Boat purchase not confirmed for " .. id .. "; Auto Buy Boat paused.")
        autoBuyBoat = false
        if boatBuyToggle then
            pcall(function() boatBuyToggle:Set(false) end)
        end
        return
    end

    boatAttempts += 1
    boatPending = {id = id, at = now}
    boatPurchaseStatus = "Requesting " .. (info.DisplayName or id)
        .. " (attempt " .. tostring(boatAttempts) .. "/3)"
    local ok, err = pcall(function()
        ShopRemote:FireServer("BuyBoat", id)
    end)
    if not ok then
        boatPurchaseStatus = "Request failed: " .. tostring(err)
        warn("[Tame V18] BuyBoat remote: " .. tostring(err))
    end
end

