                .. Display
                .. "."
            )

            return
        end


        local MaterialId =
            nil


        for Id, Amount in pairs(
            Missing.materials
        ) do

            if tonumber(Amount)
                and Amount > 0
            then

                MaterialId =
                    tostring(Id)

                break
            end
        end


        if MaterialId then

            if MaterialId == "113"
                or MaterialId == "114"
            then

                ApplyRaid(
                    "EvolutionRaidMaterial"
                )


                SetState(
                    "Full Evolve: farming Raid for "
                        .. (
                            MaterialId == "113"
                            and "Ghost"
                            or "Staff of Homa"
                        )
                        .. " for "
                        .. Display
                )

                return
            end


            local Act =
                ChooseHxhAct(
                    MaterialId
                )


            if not Act then

                SetState(
                    "Full Evolve: no material route for "
                    .. MaterialId
                )

                return
            end


            ApplyStory(
                Act,
                "Nightmare",
                "EvolutionMaterial"
            )


            SetState(
                "Full Evolve: farming "
                .. MaterialId
                .. " for "
                .. Display
                .. " using "
                .. Act
                .. " [Nightmare]"
            )


            return
        end


        local MissingMoney =
            tonumber(
                Missing.currencies
                    .money
            ) or 0


        if MissingMoney > 0 then

            ApplyStory(
                "Act 1",
                "Nightmare",
                "EvolutionMoney"
            )


            SetState(
                "Full Evolve: farming Coins for "
                .. Display
                .. " | missing "
                .. tostring(
                    MissingMoney
                )
            )


            return
        end


        local MissingGems =
            tonumber(
                Missing.currencies
                    .gems
            ) or 0


        if MissingGems > 0 then

            ApplyStory(
                "Act 1",
                "Nightmare",
                "EvolutionGems"
            )


            SetState(
                "Full Evolve: farming Gems for "
                .. Display
                .. " | missing "
                .. tostring(
                    MissingGems
                )
            )


            return
        end


        for Currency,
            Amount in pairs(
                Missing.currencies
            )
        do

            if Currency ~= "gems"
                and Currency ~= "money"
                and tonumber(Amount)
                and Amount > 0
            then

                SetState(
                    "Full Evolve: missing unsupported currency "
                    .. tostring(
                        Currency
                    )
                )

                return
            end
        end


        if not IsLobby() then

            ReturnToLobby()


            SetState(
                "Full Evolve: requirements ready for "
                .. Display
                .. " - returning to lobby"
            )


            return
        end


        HoldLobby()


        if not LobbyPackets
            or not LobbyPackets
                .evolveCharacter
        then

            SetState(
                "Full Evolve: lobby evolution packet unavailable"
            )

            return
        end


        local Equipped =
            Data.EquippedCharacterSlots
            and tonumber(
                Data.EquippedCharacterSlots
                    .Slot1
            )


        if Equipped ~= Slot
            and LobbyPackets
                .equipCharacterSlot
        then

            if os.clock()
                - Runtime.LastEquipRequest
                >= 1.25
            then

                Runtime.LastEquipRequest =
                    os.clock()


                pcall(function()

                    LobbyPackets
                        .equipCharacterSlot
                        :fire({
                            slot =
                                Slot,

                            gameSlot =
                                1,

                            requestId =
                                NextRequestId(),
                        })
                end)
            end


            SetState(
                "Full Evolve: equipping "
                .. Display
                .. " from Slot "
                .. tostring(
                    Slot
                )
            )


            return
        end


        if os.clock()
            - Runtime.LastEvolutionRequest
            < 4
        then

            return
        end


        Runtime.LastEvolutionRequest =
            os.clock()


        pcall(function()

            LobbyPackets
                .evolveCharacter
                :fire(
                    Character
                )
        end)


        SetState(
            "Full Evolve: evolving "
            .. Display
        )
    end


