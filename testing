function Systems.getCharacterHumanoid()
    local character = LocalPlayer.Character

    return character,
        character
            and character:FindFirstChildOfClass(
                "Humanoid"
            )
            or nil,
        character
            and character:FindFirstChild(
                "HumanoidRootPart"
            )
            or nil
end

function Systems.restoreStandingPromptState()
    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid
        or humanoid.Health <= 0 then
        return false
    end

    -- This game disables every ProximityPrompt while CharacterSeated
    -- is locked. Only clear that specific owner when Roblox confirms
    -- the player is actually standing.
    if humanoid.SeatPart == nil
        and humanoid.Sit ~= true then

        pcall(function()
            ProximityPromptLock.SetLocked(
                "CharacterSeated",
                false
            )
        end)

        State.LastPromptRepairAt = os.clock()
        return true
    end

    return false
end

function Systems.forceStandAndRestorePrompts()
    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid then
        return false
    end

    if humanoid.SeatPart ~= nil
        or humanoid.Sit == true then

        humanoid.Sit = false
        humanoid.Jump = true

        pcall(function()
            humanoid:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end)

        local deadline = os.clock() + 1.25

        while State.Alive
            and os.clock() < deadline
            and humanoid.SeatPart ~= nil do

            task.wait(0.04)
        end
    end

    return Systems.restoreStandingPromptState()
end

function Systems.isDirectWalkClear(
    root,
    targetPosition
)
    if not root
        or typeof(targetPosition) ~= "Vector3" then
        return false
    end

    local from =
        root.Position
        + Vector3.new(0, 2.5, 0)

    local target =
        Vector3.new(
            targetPosition.X,
            from.Y,
            targetPosition.Z
        )

    local delta = target - from

    if delta.Magnitude <= 1 then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType =
        Enum.RaycastFilterType.Exclude

    local exclude = {}

    if LocalPlayer.Character then
        table.insert(
            exclude,
            LocalPlayer.Character
        )
    end

    local cars =
        workspace:FindFirstChild("Cars")

    if cars then
        table.insert(exclude, cars)
    end

    params.FilterDescendantsInstances =
        exclude
    params.IgnoreWater = true

    local hit =
        workspace:Raycast(
            from,
            delta,
            params
        )

    return hit == nil
end

function Systems.walkToPosition(
    targetPosition,
    timeoutSeconds,
    stopRadius
)
    if typeof(targetPosition) ~= "Vector3" then
        return false
    end

    stopRadius =
        math.max(
            2.5,
            tonumber(stopRadius) or 6
        )

    local character, humanoid, root =
        Systems.getCharacterHumanoid()

    if not character
        or not humanoid
        or not root
        or humanoid.Health <= 0 then
        return false
    end

    Systems.restoreStandingPromptState()

    local deadline =
        os.clock()
        + math.max(
            2,
            tonumber(timeoutSeconds) or 18
        )

    local function distanceToTarget()
        if not root.Parent then
            return math.huge
        end

        return (
            root.Position - targetPosition
        ).Magnitude
    end

    if distanceToTarget() <= stopRadius then
        return true
    end

    local function moveBriefly(
        point,
        radius,
        maxSeconds,
        jump
    )
        if jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(point)

        local started = os.clock()
        local lastPosition = root.Position
        local lastProgressAt = started

        while State.Alive
            and os.clock() < deadline
            and os.clock() - started < maxSeconds do

            if not root.Parent
                or humanoid.Health <= 0 then
                return false
            end

            if (
                root.Position - point
            ).Magnitude <= radius then
                return true
            end

            local moved =
                (
                    root.Position
                    - lastPosition
                ).Magnitude

            if moved >= 0.35 then
                lastPosition = root.Position
                lastProgressAt = os.clock()
            elseif os.clock()
                - lastProgressAt > 0.65 then
                return false
            end

            task.wait(0.035)
        end

        return (
            root.Position - point
        ).Magnitude <= radius
    end

    -- Fast path: don't ask PathfindingService at all when there is a
    -- clear planar route. This makes short NPC/boat approaches immediate.
    if Systems.isDirectWalkClear(
        root,
        targetPosition
    ) then
        local directBudget =
            math.min(
                math.max(
                    0.75,
                    distanceToTarget()
                    / math.max(
                        humanoid.WalkSpeed,
                        8
                    )
                    + 0.60
                ),
                math.max(
                    0.75,
                    deadline - os.clock()
                )
            )

        if moveBriefly(
            targetPosition,
            stopRadius,
            directBudget,
            false
        ) then
            return true
        end
    end

    local replans = 0

    while State.Alive
        and os.clock() < deadline
        and replans < 3 do

        if distanceToTarget()
            <= stopRadius then
            return true
        end

        replans += 1
        State.FastPathReplans += 1

        local path =
            PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 12,
            })

        local ok = pcall(function()
            path:ComputeAsync(
                root.Position,
                targetPosition
            )
        end)

        if not ok
            or path.Status
                ~= Enum.PathStatus.Success then

            -- Don't sit around waiting for a bad path result.
            moveBriefly(
                targetPosition,
                stopRadius,
                math.min(
                    1.1,
                    math.max(
                        0.25,
                        deadline - os.clock()
                    )
                ),
                false
            )

            continue
        end

        local waypoints =
            path:GetWaypoints()

        local index = 1

        while index <= #waypoints
            and os.clock() < deadline do

            if distanceToTarget()
                <= stopRadius then
                return true
            end

            -- Skip waypoints already behind/under us.
            while index <= #waypoints
                and (
                    root.Position
                    - waypoints[index].Position
                ).Magnitude <= 4.5 do

                index += 1
            end

            if index > #waypoints then
                break
            end

            -- Look ahead and take the farthest waypoint with a clear
            -- direct line instead of walking every tiny path node.
            local chosen = index

            for lookAhead =
                math.min(index + 4, #waypoints),
                index + 1,
                -1 do

                if Systems.isDirectWalkClear(
                    root,
                    waypoints[
                        lookAhead
                    ].Position
                ) then
                    chosen = lookAhead
                    break
                end
            end

            local waypoint =
                waypoints[chosen]

            local distance =
                (
                    root.Position
                    - waypoint.Position
                ).Magnitude

            local waypointBudget =
                math.min(
                    2.25,
                    math.max(
                        0.45,
                        distance
                        / math.max(
                            humanoid.WalkSpeed,
                            8
                        )
                        + 0.45
                    )
                )

            local reached =
                moveBriefly(
                    waypoint.Position,
                    4.75,
                    waypointBudget,
                    waypoint.Action
                        == Enum.PathWaypointAction.Jump
                )

            if not reached then
                -- Replan immediately from the new position instead of
                -- waiting out the entire overall timeout.
                break
            end

            index = chosen + 1
        end
    end

    if distanceToTarget()
        <= stopRadius then
        return true
    end

    -- Last short direct attempt; never wait the old 20–30 seconds.
    moveBriefly(
        targetPosition,
        stopRadius,
        math.min(
            0.8,
            math.max(
                0.15,
                deadline - os.clock()
            )
        ),
        false
    )

    return distanceToTarget()
        <= stopRadius
end

