local function RequestBlock(State)

    local Store =
        GetPlayerStore()


    if not Store then
        return
    end


    -- Updated combat uses a guard meter. Never request a new block while
    -- guard-broken or while the server's block cooldown is active.
    if State == true
        and (
            not GENV.__AZ_FARM_EXT.IsRunActive()
            or GENV.__AZ_FARM_EXT.IsLocalClientBusy()
            or LocalPlayer:GetAttribute("GuardBroken") == true
            or not CooldownReady(Store, "block")
        )
    then
        State = false
    end


    if IsBlocking(Store) == State then
        return
    end


    local Now =
        workspace:GetServerTimeNow()


    if (
        Now
        - LastBlockRequest
    ) < 0.025
    then

        return
    end


    LastBlockRequest =
        Now


    pcall(function()

        CharacterPackets
            .performBlock
            :fire(
                State
            )
    end)
end


local function IsEnemyTargetingUs(
    EnemyState
)

    local Target =
        EnemyGet(
            EnemyState,
            "target"
        )


    return Target ~= nil
        and tostring(Target)
            == tostring(
                LocalPlayer.UserId
            )
end


local function EnemyIsAttackingUs(
    EnemyState
)

    return IsEnemyTargetingUs(
        EnemyState
    )
        and EnemyGet(
            EnemyState,
            "attackStartedAt"
        ) ~= nil
end


local function ShouldHoldBlock()

    if LocalPlayer:GetAttribute("GuardBroken") == true then
        return false
    end


    local Guard =
        tonumber(
            LocalPlayer:GetAttribute("BlockGuard")
        )

    if Guard ~= nil and Guard <= 0 then
        return false
    end


    for _, EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
            and EnemyIsAttackingUs(
                EnemyState
            )
        then

            return true
        end
    end


    return false
end


local function GetEnemyConfig(
    EnemyName
)

    if EnemyConstants.enemiesByName then

        return EnemyConstants
            .enemiesByName[
                EnemyName
            ]
    end


    return EnemyConstants[
        EnemyName
    ]
end


local function FindParryAttack()

    local Now =
        workspace:GetServerTimeNow()


    for EnemyId,
        EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) <= 0
        then

            continue
        end


        if not IsEnemyTargetingUs(
            EnemyState
        )
        then

            continue
        end


        local StartedAt =
            EnemyGet(
                EnemyState,
                "attackStartedAt"
            )


        local AttackIndex =
            EnemyGet(
                EnemyState,
                "attackIndex"
            )


        local EnemyName =
            GetEnemyName(
                EnemyState
            )


        if not StartedAt
            or AttackIndex == nil
            or not EnemyName
        then

            continue
        end


        local Config =
            GetEnemyConfig(
                EnemyName
            )


        if not Config
            or not Config.attacks
        then

            continue
        end


        local Attack =
            Config.attacks[
                AttackIndex
            ]
            or Config.attacks[
                AttackIndex + 1
            ]


        if not Attack
            or not Attack.hitTime
        then

            continue
        end


        local AttackSpeed =
            Config.attackSpeed
            or 1


        local TimeUntilHit =
            Attack.hitTime
            - (
                Now
                - StartedAt
            )
            * AttackSpeed


        local Key =
            tostring(
                EnemyId
            )
            .. ":"
            .. tostring(
                StartedAt
            )


        if TimeUntilHit <= PARRY_LEAD
            and TimeUntilHit >= -PARRY_AFTER
            and not LastParriedAttack[Key]
        then

            LastParriedAttack[
                Key
            ] = true


            return true
        end
    end


    return false
end


local function RunPerfectParry()

    if not FindParryAttack() then
        return
    end


    RequestBlock(
        true
    )


    task.delay(
        PARRY_HOLD,

        function()

            if SessionAlive()
                and Settings.AutoBlock
                and Settings.BlockMode
                    == "Perfect Parry"
            then

                RequestBlock(
                    false
                )
            end
        end
    )
end


--//============================================================
--// SHARED BLOCK CONTROLLER — Story / Trials / Raid
--// Only one controller sends performBlock.  No proximity-only parry spam.
--// Server enemy timing, guard meter, cooldown, and attack targeting decide.
--//============================================================
do
    local Ext = GENV.__AZ_FARM_EXT
    local B = {
        Mode = Settings.BlockMode,
        State = "Idle",
        Reason = "Waiting",
        HoldUntil = 0,
        LastSentAt = 0,
        LastSentValue = nil,
        LastAttackKey = nil,
        RecentKeys = {},
        LastThreatAt = 0,
        LastThreatDistance = nil,
        LastTimeToHit = nil,
        GuardPercent = 100,
        Requests = 0,
        ParryAttempts = 0,
        ReactiveAttempts = 0,
    }
    Ext.BlockRuntime = B

    local function SendBlock(Want, Store, Now)
        local Current = IsBlocking(Store)
        if Current == Want then
            B.LastSentValue = Want
            return
        end
        -- A server refusal should not produce block packets every Heartbeat.
        if Now - B.LastSentAt < 0.13 then return end
        if B.LastSentValue == Want and Now - B.LastSentAt < 0.65 then return end
        B.LastSentAt = Now
        B.LastSentValue = Want
        B.Requests = B.Requests + 1
        RequestBlock(Want)
    end

    local function BestIncomingAttack(Now)
        local Root = GetRoot()
        if not Root then return nil end
        local Best = nil
        local Count = 0
        for Id, Enemy in pairs(GetAllEnemies()) do
            if GetEnemyHealth(Enemy) > 0 and IsEnemyTargetingUs(Enemy) then
                local Start = tonumber(EnemyGet(Enemy, "attackStartedAt"))
                local Pos = GetEnemyPosition(Enemy)
                local Dist = Pos and (Pos - Root.Position).Magnitude or math.huge
                if Start and Dist <= 40 and Start <= Now + 0.1 then
                    local Index = tonumber(EnemyGet(Enemy, "attackIndex"))
                    local Name = GetEnemyName(Enemy)
                    local Config = Name and GetEnemyConfig(Name)
                    local Attacks = Config and Config.attacks
                    local Attack = Attacks and Index and
                        (Attacks[Index] or Attacks[Index + 1])
                    local HitTime = Attack and tonumber(Attack.hitTime)
                    local Speed = Config and tonumber(Config.attackSpeed) or 1
                    if Speed <= 0 then Speed = 1 end
                    local Until = HitTime and HitTime / Speed - (Now - Start) or nil
                    local Key = tostring(Id) .. ":" .. tostring(Start) .. ":" .. tostring(Index)
                    -- Only consider attacks within their plausible active window.
                    if not Until or (Until >= -0.22 and Until <= 4) then
                        Count = Count + 1
                        if not Best or
                            ((Until or 0.3) < (Best.TimeToHit or 0.3))
                        then
                            Best = {
                                Key = Key,
                                Distance = Dist,
                                TimeToHit = Until,
                                Name = Name,
                            }
                        end
                    end
                end
            end
        end
        return Best, Count
    end

    Ext.TickAutoBlock = function(SuppressForDodge)
        local Now = workspace:GetServerTimeNow()
        local Store = GetPlayerStore()
        local Mode = Settings.BlockMode or "Perfect Parry"
        B.Mode = Mode
        B.LastTimeToHit = nil
        B.LastThreatDistance = nil

        if not Store or not IsAlive() then
            B.HoldUntil = 0
            B.State = "Idle"
            B.Reason = "Character not ready"
            return
        end

        local Guard = tonumber(LocalPlayer:GetAttribute("BlockGuard"))
        local Max = math.max(1, tonumber(LocalPlayer:GetAttribute("BlockGuardMax")) or 100)
        local Percent = Guard and math.clamp(Guard / Max * 100, 0, 100) or 100
        B.GuardPercent = math.floor(Percent + 0.5)
        local Broken = LocalPlayer:GetAttribute("GuardBroken") == true
        local Cooldown = CooldownReady(Store, "block")

        if not Settings.AutoBlock or SuppressForDodge or not Ext.IsRunActive() then
            B.HoldUntil = 0
            B.State = "Idle"
            B.Reason = not Settings.AutoBlock and "Toggle off"
                or SuppressForDodge and "Dodging" or "Run inactive"
            SendBlock(false, Store, Now)
            return
        end
        if Broken or Percent <= (tonumber(Settings.BlockGuardReserve) or 20) then
            B.HoldUntil = 0
            B.State = "Guard recovery"
            B.Reason = Broken and "Guard broken" or "Guard reserve"
            SendBlock(false, Store, Now)
            return
        end

        local Threat = BestIncomingAttack(Now)
        B.State = Threat and "Tracking" or "Waiting"
        B.Reason = Threat and "Checking incoming attack" or "No targeted attack"
        if Threat then
            B.LastThreatAt = Now
            B.LastThreatDistance = Threat.Distance
            B.LastTimeToHit = Threat.TimeToHit
        end
        local Want = Now < B.HoldUntil
        local Busy = Ext.IsLocalClientBusy()
        local Lead = (tonumber(Settings.ParryLeadMs) or 120) / 1000
        local CanStart = Cooldown and not Busy and Now - B.LastSentAt >= 0.12

        if Threat and CanStart then
            local Time = Threat.TimeToHit
            local ParryWindow = Time and Time >= -0.09 and Time <= Lead
            local UnknownTiming = Time == nil
            local NewAttack = B.RecentKeys[Threat.Key] == nil

            if NewAttack and (Mode == "Perfect Parry" or Mode == "Smart Block") and ParryWindow then
                B.RecentKeys[Threat.Key] = Now
                B.LastAttackKey = Threat.Key
                B.HoldUntil = Now + 0.15
                B.ParryAttempts = B.ParryAttempts + 1
                Want = true
                B.State = "Parry window"
                B.Reason = "Predicted enemy hit"
            elseif NewAttack and (Mode == "Reactive Block" or
                (Mode == "Smart Block" and UnknownTiming)) then
                B.RecentKeys[Threat.Key] = Now
                B.LastAttackKey = Threat.Key
                B.HoldUntil = Now + 0.38
                B.ReactiveAttempts = B.ReactiveAttempts + 1
                Want = true
                B.State = "Reactive"
                B.Reason = UnknownTiming and "Enemy attack (unknown hit time)" or "Enemy attack started"
            elseif Mode == "Hold Block" then
                B.HoldUntil = Now + 0.22
                Want = true
                B.State = "Holding"
                B.Reason = "Enemy targeting player"
            end
        elseif Threat and Mode == "Hold Block" and not Broken then
            -- Keep an existing guard up through the remainder of an attack.
            if IsBlocking(Store) then
                B.HoldUntil = Now + 0.18
                Want = true
            end
        end

        if not Threat and Now >= B.HoldUntil then
            B.State = "Waiting"
            B.Reason = "No targeted attack"
        elseif Threat and B.State ~= "Parry window" and B.State ~= "Reactive" and B.State ~= "Holding" then
            B.State = "Tracking"
            B.Reason = Threat.TimeToHit and "Waiting for hit timing" or "No hit timing available"
        end
        if not Cooldown and not Want then
            B.Reason = "Block cooldown"
        end
        if Now < B.HoldUntil then Want = true end
        if Now >= B.HoldUntil then Want = false end
        SendBlock(Want, Store, Now)

        -- Prevent unbounded memory growth during long Endless/Trials sessions.
        if Now - (B.LastCleanedAt or 0) > 12 then
            B.LastCleanedAt = Now
            for Key, T in pairs(B.RecentKeys) do
                if Now - T > 20 then B.RecentKeys[Key] = nil end
            end
        end
    end

    GENV.__AZ_BLOCK_STATUS = function()
        local R = {
