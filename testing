-- v67: source-grounded navigation and inventory accounting. Movement is deliberately
-- performed only after a streamed target or verified static world coordinate is found.
function Hub:V67TravelTo(point,label,radius)
    local char,root=myCharacter()
    if not char or not root or typeof(point)~="Vector3" then return false end
    radius=radius or 10
    if (root.Position-point).Magnitude<=radius then return true end
    local E=self.V44
    if os.clock() >= (E.V67StreamAt or 0) then
        E.V67StreamAt=os.clock()+2.0
        task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(point,3) end) end)
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char}
    params.RespectCanCollide=true
    local safe=nil
    -- A verified NPC or saved coordinate is the destination, not the landing surface.
    for _,offset in ipairs({Vector3.new(5,0,0),Vector3.new(-5,0,0),
        Vector3.new(0,0,5),Vector3.new(0,0,-5),Vector3.new(0,0,0)}) do
        local origin=point+offset+Vector3.new(0,30,0)
        local hit=workspace:Raycast(origin,Vector3.new(0,-85,0),params)
        if hit and hit.Instance and hit.Instance.CanCollide and hit.Instance.Anchored
            and hit.Material~=Enum.Material.Water and hit.Normal.Y>0.6
            and math.abs(hit.Position.Y-point.Y)<24 then
            safe=hit.Position+Vector3.new(0,3.1,0);break
        end
    end
    if not safe then return false end
    local look=Vector3.new(point.X,safe.Y,point.Z)
    if (look-safe).Magnitude<0.1 then look=safe+root.CFrame.LookVector end
    pcall(function() char:PivotTo(CFrame.lookAt(safe,look)) end)
    return (root.Position-point).Magnitude<=radius
end
