-- v107: GitHub-only Auto Execute. No AOT source cache, preload, or
-- strict build/version marker. The only on-disk Auto Execute state is its
-- enable/disable flag; Rayfield's separate UI cache is unaffected.
local function syncAutoExecute()
    if not ensureAutoFolder() then
        if Farm.autoExecute then
            do end
        end
        return
    end
    local saved, errSave = pcall(writefile, AUTOEXEC_FLAG_FILE, Farm.autoExecute and "1" or "0")
    if not saved then
