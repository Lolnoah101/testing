                        Reward.Materials or ""
                    ):gmatch("(%d+):(%d+)")
                do

                    local Name =
                        "Material " .. Id


                    if Loaded
                        and type(Loaded.MaterialConfig) == "table"
                        and type(Loaded.MaterialConfig[Id]) == "table"
                        and Loaded.MaterialConfig[Id].Name
                    then
                        Name = Loaded.MaterialConfig[Id].Name
                    end


                    table.insert(
                        Lines,
                        Clean(Name)
                        .. ": +"
                        .. NumberText(Amount)
                    )
                end


                if Reward.Unit ~= ""
                    and Reward.Unit ~= "none"
                then
                    table.insert(
                        Lines,
                        "Unit: " .. Clean(Reward.Unit)
                    )
                end


                if #Lines == 0 then
                    table.insert(
                        Lines,
                        "No Special Rewards"
                    )
                end


                return Lines
            end


