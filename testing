function Systems.getAutomationStepText()
    local owner =
        State.CoordinatorOwner
        or "Idle"

    if owner == "Boss" then
        return State.BossLastStatus
            or "Boss event"

    elseif owner == "Quest" then
        return State.QuestLastStatus
            or "Quest automation"

    elseif owner == "Progression" then
        return State.ProgressionStatus
            or State.ProgressionNavigationStatus
            or "Auto progression"

    elseif owner == "AutoSell" then
        return State.AutoSellLastStatus
            or "Auto selling"

    elseif owner == "Fishing" then
        return "OP phase: "
            .. tostring(
                State.Phase
                or "Idle"
            )
    end

    return State.CoordinatorStatus
        or "Idle"
end

