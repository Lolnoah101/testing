Systems.ProgressionIslandOrder = {
    "island_starter",
    "island_jungle",
    "island_desert",
    "island_snow",
    "island_volcano",
    "island_fossil",
}

Systems.ProgressionUnlockQuest = {
    island_jungle = "unlock_island_2",
    island_desert = "unlock_island_3",
    island_snow = "unlock_island_4",
    island_volcano = "unlock_island_5",
    island_fossil = "unlock_island_6",
}

Systems.ProgressionIslandIndex = {}

for index, islandId in ipairs(Systems.ProgressionIslandOrder) do
    Systems.ProgressionIslandIndex[islandId] = index
end

function Systems.setProgressionStatus(stage, message)
    State.ProgressionStage = stage or "Idle"
    State.ProgressionStatus = message or stage or "Idle"
end

function Systems.ensureProgressionFishingEnabled()
    if not Config.ProgressionAutoEnableFishing then
        return
    end

    if Config.Enabled then
        return
    end

    Config.Enabled = true

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0
    State.SkillIndex = 1
    State.QTEActiveUntil = 0

    if Config.Mode == "OP" then
        State.LastPacketAt = os.clock()
        resetOPSession(0.20)
    else
        State.CurrentFishingState = getFishingState()
        State.StateEnteredAt = os.clock()
    end

    log("Progression enabled fishing", "mode=" .. tostring(Config.Mode))
end

function Systems.getProgressionGoalIndex()
    return Systems.ProgressionIslandIndex[Config.ProgressionGoalIslandId]
        or #Systems.ProgressionIslandOrder
end

function Systems.getHighestUnlockedIndex(data)
    local highest = 1

    for index, islandId in ipairs(Systems.ProgressionIslandOrder) do
        if Systems.isIslandAvailable(data, islandId) then
            highest = index
        else
            break
        end
    end

    return highest
end

function Systems.getNextProgressionIsland(data)
    local highest = Systems.getHighestUnlockedIndex(data)
    local goal = Systems.getProgressionGoalIndex()

    if highest >= goal then
        return nil, highest
    end

    return Systems.ProgressionIslandOrder[highest + 1], highest
end

function Systems.progressionManageRods()
    if not Config.ProgressionAutoBuyRods then
        return false
    end

    if State.RodBusy or not Systems.isRodChangeSafe() then
        return false
    end

    local data = getPlayerData()
    local affordable = Systems.getNextPurchasableShopRod(data, true)

    if affordable then
        local bought = Systems.purchaseNextRod()

        if bought then
            State.ProgressionPurchases += 1
            Systems.setProgressionStatus(
                "Rod Upgrade",
                "Bought " .. tostring(affordable.name)
            )
            return true
        end
    end

    Systems.equipBestOwnedRod()
    return false
end

function Systems.progressionFarmIsland(islandId, reason)
    if not islandId then
        return
    end

    State.ProgressionTargetIslandId = islandId
    Config.SelectedIslandId = islandId

    if not Systems.isAtIsland(islandId) then
        if Systems.isTravelSafe() then
            Systems.progressionNavigateToIsland(
                islandId
            )
        else
            Systems.setProgressionStatus(
                "Waiting",
                "Waiting to move to "
                    .. tostring(
                        Systems.IslandIdToName[islandId]
                        or islandId
                    )
            )
        end

        return
    end

    Systems.setProgressionStatus(
        "Farming",
        reason
            or (
                "Ready on "
                .. tostring(
                    Systems.IslandIdToName[islandId]
                    or islandId
                )
            )
    )
end

function Systems.progressionHandleUnlockQuest(
    data,
    nextIslandId,
    questId
)
    local current = Systems.getCurrentQuest(data)

    if current and current.Id ~= questId then
        Systems.setProgressionStatus(
            "Blocked",
            "Finish/cancel active quest first: "
                .. tostring(
                    (QuestConfig.Data[current.Id] or {}).name
                    or current.Id
                )
        )
        return
    end

    if not current then
        local accepted = Systems.acceptQuest(questId)

        if not accepted then
            Systems.setProgressionStatus(
                "Unlock Quest",
                State.QuestLastStatus
            )
            return
        end

        task.wait(0.15)
        data = getPlayerData() or data
        current = Systems.getCurrentQuest(data)
    end

    if not current or current.Id ~= questId then
        return
    end

    State.ProgressionTargetQuestId = questId

    -- Existing quest automation already knows which previous island must
    -- be farmed for Snow / Volcano / Fossil unlock requirements.
    Systems.configureQuestFarming(questId)

    data = getPlayerData() or data

    if Systems.questReadyToComplete(data, questId) then
        local completed = Systems.completeQuest(questId)

        if completed then
            State.ProgressionUnlocks += 1
            Systems.setProgressionStatus(
                "Island Unlocked",
                "Unlocked "
                    .. (Systems.IslandIdToName[nextIslandId] or nextIslandId)
            )
        end

        return
    end

    local profile = Systems.QuestProfiles[questId] or {}
    local farmIsland =
        profile.targetIsland
        or Systems.getHighestUnlockedIsland(data)

    Systems.progressionFarmIsland(
        farmIsland,
        "Unlocking "
            .. (Systems.IslandIdToName[nextIslandId] or nextIslandId)
            .. ": "
            .. Systems.questProgressSummary(data, questId)
    )
end

function Systems.stepAutoProgression()
    if not Config.AutoProgression
        or State.AutoSellBusy
        or State.TravelBusy
        or State.QuestBusy
        or State.ProgressionNavigationBusy then
        return
    end

    local now = os.clock()

    if now - State.LastProgressionCheck
        < math.max(
            0.50,
            tonumber(Config.ProgressionCheckInterval) or 1
        ) then
        return
    end

    State.LastProgressionCheck = now

    local data = getPlayerData()

    if not data then
        Systems.setProgressionStatus(
            "Waiting",
            "Waiting for player data"
        )
        return
    end

    local goalId = Config.ProgressionGoalIslandId
    local goalIndex = Systems.getProgressionGoalIndex()
    local highestIndex = Systems.getHighestUnlockedIndex(data)
    local highestIsland = Systems.ProgressionIslandOrder[highestIndex]

    if highestIndex >= goalIndex then
        State.ProgressionTargetIslandId = goalId
        State.ProgressionTargetQuestId = nil

        if not Systems.isAtIsland(goalId) then
            if Systems.isTravelSafe() then
                Systems.progressionNavigateToIsland(
                    goalId
                )
            end
            return
        end

        Systems.setProgressionStatus(
            "Goal Reached",
            (Systems.IslandIdToName[goalId] or goalId)
                .. " is unlocked"
        )

        Config.AutoProgression = false
        return
    end

    local nextIslandId =
        Systems.ProgressionIslandOrder[highestIndex + 1]

    if not nextIslandId then
        Systems.setProgressionStatus(
            "Complete",
            "All configured islands unlocked"
        )
        Config.AutoProgression = false
        return
    end

    State.ProgressionTargetIslandId = nextIslandId

    local nextConfig = IslandConfig[nextIslandId] or {}
    local requiredLevel =
        tonumber(nextConfig.requiredLevel) or 1
    local level = tonumber(data.Level) or 1

    if level < requiredLevel then
        State.ProgressionTargetQuestId = nil

        Systems.progressionFarmIsland(
            highestIsland,
            string.format(
                "Leveling on %s: Level %d/%d",
                Systems.IslandIdToName[highestIsland] or highestIsland,
                level,
                requiredLevel
            )
        )
        return
    end

    local unlockQuestId =
        Systems.ProgressionUnlockQuest[nextIslandId]

    if not unlockQuestId then
        Systems.setProgressionStatus(
            "Error",
            "No unlock quest mapped for "
                .. tostring(nextIslandId)
        )
        return
    end

    Systems.progressionHandleUnlockQuest(
        data,
        nextIslandId,
        unlockQuestId
    )
end

API.StepAutoProgression = Systems.stepAutoProgression

