local PERSISTENT_TELEPORT_KEY = "TameAnAnimal_AutoExecute"

local function findExecutorAPI(name)
    local direct = Env[name]
    if type(direct) == "function" then return direct end
    local ok, global = pcall(function() return _G[name] end)
    if ok and type(global) == "function" then return global end
    return nil
end
local function executorFileAPIs()
    local writer = (type(writefile) == "function" and writefile)
        or findExecutorAPI("writefile")
    local reader = (type(readfile) == "function" and readfile)
        or findExecutorAPI("readfile")
    return writer, reader
end
local function executorQueueAPI()
    if type(queue_on_teleport) == "function" then return queue_on_teleport end
    if type(queueonteleport) == "function" then return queueonteleport end
    for _, key in ipairs({"queue_on_teleport", "queueonteleport"}) do
        local direct = findExecutorAPI(key)
        if direct then return direct end
    end
    local synObj = Env.syn or _G.syn
    if type(synObj) == "table" and type(synObj.queue_on_teleport) == "function" then
        return synObj.queue_on_teleport
    end
    return nil
end
local function setAutoExecStatus(message)
    print("[Tame V45 AutoExec] " .. tostring(message))
    setWatcherText(autoExecStatus, tostring(message), "Auto Execute")
end
local function setTeleportIntent(enabled)
    pcall(function()
        TeleportServiceForAutoExec:SetTeleportSetting(PERSISTENT_TELEPORT_KEY, enabled)
    end)
end
local function writeMarker(enabled)
    setTeleportIntent(enabled)
    local writer = executorFileAPIs()
    if type(writer) ~= "function" then
        return false, "Executor writefile unavailable"
    end
    local ok, err = pcall(writer, AUTOEXEC_ENABLED_FILE, enabled and "1" or "0")
    return ok, err
end
local function readMarker()
    local _, reader = executorFileAPIs()
    if reader then
        local ok, saved = pcall(reader, AUTOEXEC_ENABLED_FILE)
        if ok and (saved == "1" or saved == "0") then return saved == "1" end
        -- Upgrade from V44 without losing the previously enabled state.
        local oldOk, old = pcall(reader, AUTOEXEC_OLD_ENABLED_FILE)
        if oldOk and old == "1" then return true end
    end
    local ok, saved = pcall(function()
        return TeleportServiceForAutoExec:GetTeleportSetting(PERSISTENT_TELEPORT_KEY)
    end)
    if ok and type(saved) == "boolean" then return saved end
    return true -- requested default: always enabled unless explicitly switched off
end
local function disableLegacyAutoExec()
    local writer = executorFileAPIs()
    if type(writer) ~= "function" then return end
    for _, path in ipairs({
        AUTOEXEC_OLD_ENABLED_FILE,
        "TameAnAnimal_V20_AutoExec.enabled",
        "TameAnAnimal_V26.enabled", "TameAnAnimal_V32.enabled",
        "TameAnAnimal_V33.enabled", "TameAnAnimal_V35.enabled",
