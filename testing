-- TRIALS update: ability casting is separate from AbilityAction (inventory).
-- Use the game's AbilityCast(Vector3?) remote, equipped ability and server-ready timestamp.
-- Keep this independent from Auto Attack and Auto Farm; no extra status watcher.
do
    local abilityDefinitions = readModule(definitions and definitions:FindFirstChild("Abilities"))
    local abilityState = {
        enabled = false,
        connection = nil,
        nextCheck = 0,
        nextRequest = 0,
        lastAbility = nil,
        lastErrorAt = 0,
    }

    local function findAbilityEnemy(origin, ability)
        local props = type(ability.p) == "table" and ability.p or {}
        local kind = ability.kind
        local reach
        if kind == "buff" then
            reach = 45
        elseif kind == "rain" or kind == "mark" then
            -- New Seraph mark/ward casts use the radius field, not range/dist.
            reach = tonumber(props.radius) or 40
        elseif kind == "circle" then
            reach = tonumber(props.radius) or 10
        elseif kind == "beam" then
            reach = tonumber(props.range) or 22
        else
            reach = tonumber(props.range) or tonumber(props.dist) or 15
        end
        reach = math.clamp(reach, 4, 100)
        local best, bestDistance, visited = nil, reach, {}

        local function consider(model)
            if visited[model] then return end
            visited[model] = true
            local er = rootOf(model)
            if not er then return end
            local delta = er.Position - origin
            local distance = delta.Magnitude
            if distance <= bestDistance then
                best = delta
                bestDistance = distance
            end
        end

        -- The Auto Attack cache may not be populated when only Auto Use Ability is on.
        for model in pairs(s.enemies) do
            consider(model)
        end
        local active = workspace:FindFirstChild("ActiveEnemies")
        if active then
            for _, model in ipairs(active:GetChildren()) do
                if model:IsA("Model") then consider(model) end
            end
        end
        return best
    end

    local function tickAbility()
        if not abilityState.enabled or s.reviveHolding then return end
        local now = os.clock()
        if now < abilityState.nextCheck then return end
        abilityState.nextCheck = now + 0.10

        -- Respect the game's active combat state, equipped slot and cooldown.
        if player:GetAttribute("InArena") ~= true then return end
        if player:GetAttribute("Sparring") == true then return end
        local combatState = player:GetAttribute("CombatState")
        if combatState == "Downed" or combatState == "Eliminated" then return end
        local char, humanoid, root = characterReady()
        if not char or humanoid.Sit or humanoid.PlatformStand then return end
        local equippedId = player:GetAttribute("AbilityEquipped")
        if type(equippedId) ~= "string" or equippedId == "" then return end
        if not abilityDefinitions or type(abilityDefinitions.get) ~= "function" then return end
        local ability = abilityDefinitions.get(equippedId)
        if type(ability) ~= "table" then return end

        if equippedId ~= abilityState.lastAbility then
            abilityState.lastAbility = equippedId
            abilityState.nextRequest = 0
        end
        local serverNow = workspace:GetServerTimeNow()
        local readyAt = tonumber(player:GetAttribute("AbilityReadyAt"))
        if readyAt and readyAt > serverNow + 0.05 then return end
        if now < abilityState.nextRequest then return end

        local delta = findAbilityEnemy(root.Position, ability)
        if not delta then return end
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local direction = flat.Magnitude > 0.05 and flat.Unit
            or Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        if direction.Magnitude < 0.05 then return end
        direction = direction.Unit

        local remote = remotes and remotes:FindFirstChild("AbilityCast")
        if not remote or not remote:IsA("RemoteEvent") then return end
        -- Do not force-rotate the character: movement/dodging stay independent.
        -- Server may reject casts made out of range or during other combat states.
        abilityState.nextRequest = now + 0.85
        local ok, err = pcall(function()
            remote:FireServer(direction)
        end)
        if not ok and now - abilityState.lastErrorAt > 8 then
            abilityState.lastErrorAt = now
            warn("[HollowMoonHub Auto Ability] " .. tostring(err))
        end
    end

    local function setAutoAbility(value)
        abilityState.enabled = value == true
        if abilityState.connection then
            abilityState.connection:Disconnect()
            abilityState.connection = nil
        end
        abilityState.nextCheck = 0
        abilityState.nextRequest = 0
        if abilityState.enabled then
            abilityState.connection = RunService.Heartbeat:Connect(function()
                local ok, err = pcall(tickAbility)
                if not ok and os.clock() - abilityState.lastErrorAt > 8 then
                    abilityState.lastErrorAt = os.clock()
                    warn("[HollowMoonHub Auto Ability] " .. tostring(err))
                end
            end)
        end
    end

    -- Hook the existing cleanup; the later Settings unload wrapper calls through it.
    local previousAbilityDestroy = s.Destroy
    function s:Destroy()
        setAutoAbility(false)
        previousAbilityDestroy(self)
    end

    combatLeft:CreateToggle({
        name = "Auto Use Ability", flag = "HollowMoonAutoUseAbility", value = false,
        callback = function(value) setAutoAbility(value) end,
    })
end

