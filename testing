            "OilJob"
        )
    end

    local function GetOilPromptPosition(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
        then
            return nil
        end

        if Prompt.Parent:IsA(
            "Attachment"
        ) then
            return Prompt.Parent.WorldPosition
        end

        local Part =
            GetPromptPart(
                Prompt
            )

        return Part
            and Part.Position
            or nil
    end

    local function GetOilPromptDistance(
        Prompt
    )
        local Position =
            GetOilPromptPosition(
                Prompt
            )

        if not Position then
            return math.huge
        end

        return (
            GetRootPart().Position
            - Position
        ).Magnitude
    end

    local function IsOilPromptInRange(
        Prompt,
        IgnoreEnabled
    )
        if not Prompt
            or not Prompt.Parent
        then
            return false
        end

        if not IgnoreEnabled
            and not Prompt.Enabled
        then
            return false
        end

        local MaxDistance =
            tonumber(
                Prompt.MaxActivationDistance
            )
            or 5

        local SafeDistance =
            math.max(
                1.5,
                MaxDistance - 0.65
            )

        return GetOilPromptDistance(
            Prompt
        ) <= SafeDistance
    end

    local function RequestOilStreaming(
        Position
    )
        if not Position then
            return
        end

        task.spawn(function()
            pcall(function()
                Player:RequestStreamAroundAsync(
                    Position,
                    2
                )
            end)
        end)
    end

    local function GetOilPrompts(
        ObjectText
    )
        local Job =
            GetOilJob()

        local Prompts = {}

        if not Job then
            return Prompts
        end

        local RootPosition =
            GetRootPart().Position

        for _, Object in ipairs(
            Job:GetDescendants()
        ) do
            if Object:IsA(
                "ProximityPrompt"
            )
                and Object.ObjectText
                    == ObjectText
            then
                table.insert(
                    Prompts,
                    Object
                )
            end
        end

        table.sort(
            Prompts,

            function(
                A,
                B
            )
                local APosition =
                    GetOilPromptPosition(
                        A
                    )

                local BPosition =
                    GetOilPromptPosition(
                        B
                    )

                if not APosition then
                    return false
                end

                if not BPosition then
                    return true
                end

                return (
                    RootPosition
                    - APosition
                ).Magnitude
                < (
                    RootPosition
                    - BPosition
                ).Magnitude
            end
        )

        return Prompts
    end

