        local Success,
            TeleportSaved =
            pcall(function()

                return TeleportService
                    :GetTeleportSetting(
                        Key
                    )
            end)


        if Success
            and type(TeleportSaved) == "table"
        then

            Saved =
                TeleportSaved
        end
    end


    if type(Saved) == "table" then

        Settings.EndlessLeaveWave =
            math.clamp(
                math.floor(
                    tonumber(
                        Saved.EndlessLeaveWave
                    ) or 10
                ),
                1,
                99999
            )


        Settings.AutoLeaveEndlessAtWave =
            Saved.AutoLeaveEndlessAtWave
                == true


        Settings.AutoPickupLoot =
            Saved.AutoPickupLoot
                == true
    end


    Settings.PersistDungeonAutomation =
        function()

            local Data = {

                EndlessLeaveWave =
                    Settings.EndlessLeaveWave,

                AutoLeaveEndlessAtWave =
                    Settings.AutoLeaveEndlessAtWave
                        == true,

                AutoPickupLoot =
                    Settings.AutoPickupLoot
                        == true,
            }


            GENV[Key] =
                Data


            pcall(function()

                TeleportService
                    :SetTeleportSetting(
                        Key,
                        Data
                    )
            end)


            pcall(function()

                local Queue =
                    queue_on_teleport
                    or queueonteleport


                if Queue then

                    Queue(
                        "getgenv().__AZ_DUNGEON_AUTOMATION={"
                        .. "EndlessLeaveWave="
                        .. tostring(Data.EndlessLeaveWave)
                        .. ",AutoLeaveEndlessAtWave="
                        .. tostring(Data.AutoLeaveEndlessAtWave)
                        .. ",AutoPickupLoot="
                        .. tostring(Data.AutoPickupLoot)
                        .. "}"
                    )
                end
            end)
        end
end)()


