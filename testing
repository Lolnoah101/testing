local rewardSharedCache = {}
local function getRewardDefinitions(name)
    local clientShared = nativeController and nativeController.Shared
    local loaded = type(clientShared) == "table" and clientShared[name]
    if type(loaded) == "table" then return loaded end

    if type(rewardSharedCache[name]) == "table" then
        return rewardSharedCache[name]
    end
    local module = shared and shared:FindFirstChild(name)
    if module and module:IsA("ModuleScript") then
        local ok, definitions = pcall(require, module)
        if ok and type(definitions) == "table" then
            rewardSharedCache[name] = definitions
            return definitions
        end
    end
    return nil
end

local achievementProgressUtility
local function getAchievementProgressUtility()
    local clientUtils = nativeController and nativeController.Utils
    local fromClient = type(clientUtils) == "table" and clientUtils.Achievement
    if type(fromClient) == "table" and type(fromClient.GetProgress) == "function" then
        return fromClient
    end
    if achievementProgressUtility then return achievementProgressUtility end
    local utils = clientModule and clientModule:FindFirstChild("Utils")
    local progressModule = utils and utils:FindFirstChild("Achievement")
    if progressModule and progressModule:IsA("ModuleScript") then
        local ok, api = pcall(require, progressModule)
        if ok and type(api) == "table" and type(api.GetProgress) == "function" then
            achievementProgressUtility = api
            return api
        end
    end
    return nil
end

local function loadedRewardData()
    if not nativeController or not nativeController.ClientLoaded then return nil end
    local data = nativeController.Data
    return type(data) == "table" and data or nil
end

-- A failed claim must not hammer the remote. Retry after a quiet period
-- in case of temporary latency, loading, or server-side conditions.
local function sendRewardClaim(category, id, ...)
    local now = os.clock()
    local cache = state.RewardLastAttempt[category]
    if not cache or now - state.LastRewardRequestAt < 0.9 then return false end
    local key = tostring(id)
    if now - (cache[key] or -math.huge) < 20 then return false end

    cache[key] = now
    state.LastRewardRequestAt = now
    bridge:FireServer("General", ...)
    return true
end

local function claimAchievements(data)
    if not state.AutoClaimAchievements or type(data.Achievements) ~= "table" then
        return false
    end
    -- Do not compete with the game's built-in Auto Claim Achievements switch.
    if data.Achievements_AutoClaim == true then return false end

    local definitions = getRewardDefinitions("Achievements")
    local progressApi = getAchievementProgressUtility()
    if type(definitions) ~= "table" or not progressApi then return false end

    local ids = {}
    for id, definition in pairs(definitions) do
        if type(id) == "string" and type(definition) == "table" then
            ids[#ids + 1] = id
        end
    end
    table.sort(ids)

    for _, achievementId in ipairs(ids) do
        if not data.Achievements[achievementId] then
            local ok, _, _, progress = pcall(
                progressApi.GetProgress, progressApi, data, definitions[achievementId]
            )
            if ok and type(progress) == "number" and progress >= 1 then
                if sendRewardClaim("Achievement", achievementId,
                    "Achievements", "Claim", achievementId) then
                    return true
                end
            end
        end
    end
    return false
end

local function claimDailyReward(data)
    if not state.AutoClaimDailyRewards then return false end
    local daily = data.DailyRewards
    if type(daily) ~= "table" or type(daily.Claimed) ~= "table" then
        return false
    end

    local today = tonumber(daily.Streak)
    -- DailyRewards client UI only provides claim buttons for Day1-Day7.
    -- A streak sentinel (8) is shown as Day 1 by the UI; skip that
    -- intermediate state rather than sending an invalid day ID.
    if not today or today < 1 or today > 7 or today % 1 ~= 0 then
        return false
    end
    if daily.Claimed["Day" .. today] then return false end
    return sendRewardClaim("Daily", today, "DailyRewards", "Claim", today)
end

local function claimLevelRewards(data)
    if not state.AutoClaimLevelRewards then return false end
    local levelData = data.LevelRewards
    local definitions = getRewardDefinitions("LevelRewards")
    if type(levelData) ~= "table" or type(levelData.Claimed) ~= "table"
        or type(definitions) ~= "table" then
        return false
    end

    local level = tonumber(data.Level)
    if not level then return false end
    local maxUnlocked = math.min(math.floor(level), #definitions, 25)
    for n = 1, maxUnlocked do
        if type(definitions[n]) == "table"
            and not levelData.Claimed["Reward" .. n] then
            if sendRewardClaim("Level", n, "LevelRewards", "Claim", n) then
                return true
            end
        end
    end
    return false
end

-- Round-robin categories; send at most one valid request per pass.
-- Separate toggles remain independent and update using the game's live data.
local rewardHandlers = { claimAchievements, claimDailyReward, claimLevelRewards }
task.spawn(function()
    while state.Running do
        if state.AutoClaimAchievements or state.AutoClaimDailyRewards
            or state.AutoClaimLevelRewards then
            local data = loadedRewardData()
            if data then
                for offset = 0, 2 do
                    local index = ((state.RewardNextCategory + offset - 1) % 3) + 1
                    local ok, sent = pcall(rewardHandlers[index], data)
                    if not ok then
                        warn("[Paraiso Misc] Reward check failed:", sent)
                    elseif sent then
                        state.RewardNextCategory = (index % 3) + 1
                        break
                    end
                end
            end
        end
        task.wait(1.0)
    end
end)

