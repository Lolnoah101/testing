                            .. " x"
                            .. tostring(Missing)
                    )
                end
            end

            table.sort(MissingLines)

            if #MissingLines > 0 then
                table.insert(
                    Lines,
                    "Missing: " .. table.concat(MissingLines, ", ")
                )
            else
                table.insert(Lines, "Missing: none")
            end

            if Analysis.CraftableName then
                table.insert(
                    Lines,
                    "Next: Craft " .. Analysis.CraftableName
                )
            elseif Route then
                if Route.Mode == "Infinite" then
                    table.insert(
                        Lines,
                        "Next farm: Infinite "
