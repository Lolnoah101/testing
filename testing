-- Some combat scripts restore CanCollide between Heartbeats. Enforce noclip
-- before physics on Tween/Teleport while pursuing, then restore it on exit.
-- A full character:GetDescendants() each physics step can be costly. A
-- 0.075-second reconciliation is substantially lighter and still maintains
-- collision correction while moving.
local nextNoclipSweepAt = 0
table.insert(Hub.Connections, RunService.Stepped:Connect(function()
    if not Hub.Running then return end
    local farmFlying=Hub.AutoFarm and Hub.FarmMethod~="Legit"
    local questFlying=Hub.AutoQuest and Hub.QuestFarmMethod~="Legit"
    if not farmFlying and not questFlying then return end
    local now = os.clock()
    if now < nextNoclipSweepAt then return end
    nextNoclipSweepAt = now + 0.075
    local moving = (Hub.AutoFarm and activeNpcRecord(Hub.FarmTarget))
        or (Hub.AutoQuest and (Hub.QuestMoveTo
            or (Hub.QuestCombatActive and activeNpcRecord(Hub.QuestTarget))))
    if not moving then return end
    local char = LocalPlayer.Character
    if char and char.Parent then updateFarmCollision(char) end
end))

local function flatUnit(v)
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude < 0.01 then return Vector3.new(0, 0, -1) end
    return flat.Unit
end
local function targetPredictedPosition(part, dtLead)
    local velocity = part.AssemblyLinearVelocity
    local lead = Vector3.new(velocity.X, 0, velocity.Z) * dtLead
    if lead.Magnitude > 3.5 then lead = lead.Unit * 3.5 end
    return part.Position + lead
end
local function farmGoal(record, dt, settings)
    local targetRoot = record.Root
    local model = record.Model
    local distance = math.clamp(settings and settings.Distance or Hub.FarmDistance, 4, 10)
    local mode = settings and settings.Position or Hub.FarmPosition
    local facing = flatUnit(targetRoot.CFrame.LookVector)
    local pos = targetRoot.Position
    local goalPos
    if mode == "Behind" then
        -- Stay behind the *current* facing (not a smoothed/old direction).
        -- Smoothing the NPC's heading lets fast turns put us in front of it.
        -- Don't add velocity lookahead: it pulls a tight back-follow sideways.
        goalPos = pos - facing * math.max(distance, 1.25)
        return CFrame.lookAt(goalPos, Vector3.new(pos.X,goalPos.Y,pos.Z)),goalPos
    end
    local head = model:FindFirstChild("Head",true)
    local foot = model:FindFirstChild("LeftFoot",true)
        or model:FindFirstChild("RightFoot",true)
        or model:FindFirstChild("Left Leg",true)
        or model:FindFirstChild("Right Leg",true)
    local anchorY
    if mode == "Above" then
        anchorY = head and head:IsA("BasePart")
            and (head.Position.Y + head.Size.Y*.5)
            or (pos.Y + math.max(2,record.Hum.HipHeight + 1.8))
    else
        anchorY = foot and foot:IsA("BasePart")
            and (foot.Position.Y - foot.Size.Y*.5)
            or (pos.Y - math.max(2,record.Hum.HipHeight + 1.4))
    end
    -- Smooth only ANIMATED body-part height. X and Z follow the stable NPC
    -- root directly, so bobbing attacks never drift us off the target's head.
    local track = settings or Hub
    local focusKey = settings and "Focus" or "FarmFocus"
    local upKey = settings and "StableUp" or "FarmStableUp"
    local prev = track[focusKey]
    if not prev or math.abs(prev.Y-anchorY)>12 then
        track[focusKey]=Vector3.new(pos.X,anchorY,pos.Z)
    else
        local heightAlpha=1-math.exp(-27*math.clamp(dt,.001,.06))
        local y=prev.Y + (anchorY-prev.Y)*heightAlpha
        track[focusKey]=Vector3.new(pos.X,y,pos.Z)
    end
    -- Pick a horizontal roll reference, to avoid CFrame.lookAt degeneracy
    -- when looking straight up/down. Keep it stable until targets change.
    if not track[upKey] then track[upKey]=facing end
    if mode == "Above" then
        goalPos=Vector3.new(pos.X,track[focusKey].Y+math.max(.5,distance),pos.Z)
        return CFrame.lookAt(goalPos,goalPos-Vector3.yAxis,track[upKey]),goalPos
    else
        goalPos=Vector3.new(pos.X,track[focusKey].Y-math.max(.5,distance),pos.Z)
        return CFrame.lookAt(goalPos,goalPos+Vector3.yAxis,track[upKey]),goalPos
    end
end
local function smoothDamp(current, goal, velocity, dt, smoothTime, maxSpeed)
    -- Framerate-independent damped motion. Shorter smoothing for Teleport's
    -- CLOSE follow, regular smoothing for Tween; large teleports stay instant.
    smoothTime = smoothTime or 0.14
    maxSpeed = maxSpeed or 180
    local omega = 2 / smoothTime
    local x = omega * dt
    local decay = 1 / (1 + x + 0.48*x*x + 0.235*x*x*x)
    local change = current - goal
    local limit = maxSpeed * smoothTime
    if change.Magnitude > limit then change = change.Unit * limit end
    local limitedGoal = current - change
    local temp = (velocity + change*omega) * dt
    local newVelocity = (velocity - temp*omega) * decay
    local result = limitedGoal + (change + temp) * decay
    if (goal - current):Dot(result - goal) > 0 then
        return goal, Vector3.zero
    end
    return result, newVelocity
end
local function getGroundDestination(root, record, settings)
    local enemyRoot = record.Root
    local enemyForward = flatUnit(enemyRoot.CFrame.LookVector)
    local gap = math.clamp(settings and settings.Distance or Hub.FarmDistance, 4, 10)
    local direction
    if (settings and settings.Position or Hub.FarmPosition) == "Behind" then
        direction = -enemyForward
    else
        -- The walking method cannot hover above/below an NPC; approach
        -- from the player's current direction and keep a combat-friendly gap.
        direction = flatUnit(root.Position - enemyRoot.Position)
    end
    local goal = enemyRoot.Position + direction * gap
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, record.Model}
    local result = workspace:Raycast(goal + Vector3.new(0, 35, 0), Vector3.new(0, -140, 0), rayParams)
    return result and (result.Position + Vector3.new(0, 2, 0)) or goal
end
local function lineBlocked(root, destination, record)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, record.Model}
    local offset = Vector3.new(0, 1.0, 0)
    local p = root.Position + offset
    return workspace:Raycast(p, destination + offset - p, params) ~= nil
end
local function pathToDestination(root, hum, record, destination, now)
    local nav = Hub.FarmNav
    if not nav then
        nav = {NextCompute = 0, Waypoints = nil, Index = 1, LastDestination = nil,
            Pending = false, LastProgress = now, LastPosition = root.Position,
            LastCommand = nil, LastCommandAt = 0}
        Hub.FarmNav = nav
    end
    -- Track progress so an obstruction or an ignored MoveTo can trigger a repath.
    if (root.Position - nav.LastPosition).Magnitude > 0.75 then
        nav.LastPosition, nav.LastProgress = root.Position, now
    end
    local changed = not nav.LastDestination
        or (nav.LastDestination - destination).Magnitude > 7
    local stuck = now - nav.LastProgress > 1.1
    local blocked = lineBlocked(root, destination, record)
    if not blocked then
        nav.Waypoints = nil
        nav.Index = 1
        Hub.FarmMoveStatus = "Legit: direct walk"
    elseif (changed or stuck or not nav.Waypoints) and not nav.Pending
        and now >= nav.NextCompute then
        nav.Pending = true
        nav.NextCompute = now + 0.7
        local token = Hub.FarmNavToken
        local from, to = root.Position, destination
        task.spawn(function()
            local success, waypoints = pcall(function()
                local path = PathfindingService:CreatePath({
                    AgentRadius = 2, AgentHeight = 5, AgentCanJump = true,
                    WaypointSpacing = 4
                })
                path:ComputeAsync(from, to)
                if path.Status ~= Enum.PathStatus.Success then return nil end
                return path:GetWaypoints()
            end)
            if not Hub.Running or not Hub.AutoFarm or Hub.FarmMethod ~= "Legit"
                or Hub.FarmNavToken ~= token or Hub.FarmNav ~= nav
                or Hub.FarmTarget ~= record then return end
            nav.Pending = false
            nav.LastDestination = to
            nav.LastProgress = os.clock()
            if success and waypoints and #waypoints > 0 then
                nav.Waypoints, nav.Index = waypoints, 1
                Hub.FarmMoveStatus = "Legit: pathfinding"
            else
                nav.Waypoints, nav.Index = nil, 1
                Hub.FarmMoveStatus = "Legit: path unavailable"
            end
        end)
    end
    local walkGoal = destination
    if blocked and nav.Waypoints then
        while nav.Index <= #nav.Waypoints
            and (root.Position - nav.Waypoints[nav.Index].Position).Magnitude <= 3.5 do
            nav.Index += 1
        end
        if nav.Index <= #nav.Waypoints then
            local waypoint = nav.Waypoints[nav.Index]
            walkGoal = waypoint.Position
            if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        end
    end
    local gap = (root.Position - walkGoal).Magnitude
    if gap < 0.8 then
        -- Idle only once, rather than restarting MoveTo every 0.14 seconds.
        if nav.LastCommand ~= "Stop" then
            hum:MoveTo(root.Position)
            nav.LastCommand = "Stop"
            nav.LastCommandAt = now
        end
    elseif nav.LastCommand == "Stop" or not nav.LastCommand
        or (nav.LastCommand - walkGoal).Magnitude > 2.2
        or now - nav.LastCommandAt > 1.1 or stuck then
        hum:MoveTo(walkGoal)
        nav.LastCommand = walkGoal
        nav.LastCommandAt = now
    end
end
-- Tween normally follows directly with noclip. If the server or terrain
-- corrects our position repeatedly, a short path detour avoids retrying the
-- same blocked straight line forever. This does NOT change Legit movement.
local function tweenRecoveryGoal(root, target, finalGoal, now)
    local remaining = (root.Position - finalGoal).Magnitude
    local changed = not Hub.TweenLastGoal or (finalGoal - Hub.TweenLastGoal).Magnitude > 5
    if changed then
        -- A moving enemy can invalidate an earlier obstacle-detour path.
        if Hub.TweenRoute then
            Hub.TweenRoute = nil
            Hub.TweenRouteIndex = 1
        end
        Hub.TweenLastGoal = finalGoal
        Hub.TweenLastGoalDistance = remaining
        Hub.TweenLastProgressAt = now
    elseif Hub.TweenLastGoalDistance == nil or remaining < Hub.TweenLastGoalDistance - 0.6 then
        Hub.TweenLastGoalDistance = remaining
        Hub.TweenLastProgressAt = now
    end
    if remaining < 7 then
        Hub.TweenRoute = nil
        Hub.TweenRoutePending = false
        return finalGoal, false
    end
    -- Recover only from an actual stall, not just a wall that's already
    -- traversable by noclip or a moving enemy.
    if not Hub.TweenRoute and not Hub.TweenRoutePending
        and now - Hub.TweenLastProgressAt > 0.95
        and now >= Hub.TweenRouteNextAt then
        Hub.TweenRoutePending = true
        Hub.TweenRouteNextAt = now + 1.6
        Hub.TweenRecoveryCount += 1
        Hub.TweenRouteToken += 1
        local token = Hub.TweenRouteToken
        local from = root.Position
        local to = getGroundDestination(root, target)
        task.spawn(function()
            local ok, points = pcall(function()
                local path = PathfindingService:CreatePath({
                    AgentRadius=2, AgentHeight=5, AgentCanJump=true,
                    WaypointSpacing=5
                })
                path:ComputeAsync(from, to)
                if path.Status ~= Enum.PathStatus.Success then return nil end
                return path:GetWaypoints()
            end)
            if not Hub.Running or Hub.TweenRouteToken ~= token
                or Hub.FarmTarget ~= target or Hub.FarmMethod ~= "Tween" then return end
            Hub.TweenRoutePending = false
            Hub.TweenLastProgressAt = os.clock()
            if ok and points and #points >= 2 then
                Hub.TweenRoute, Hub.TweenRouteIndex = points, 2
            else
                Hub.TweenRoute, Hub.TweenRouteIndex = nil, 1
            end
        end)
    end
    local route = Hub.TweenRoute
    if route then
        while Hub.TweenRouteIndex <= #route do
            local waypoint = route[Hub.TweenRouteIndex]
            if (root.Position - (waypoint.Position + Vector3.new(0, 2.5, 0))).Magnitude > 4.5 then
                return waypoint.Position + Vector3.new(0, 2.5, 0), true
            end
            Hub.TweenRouteIndex += 1
        end
        Hub.TweenRoute = nil
        Hub.TweenLastProgressAt = now
    end
    return finalGoal, false
end

-- Both automation modes may remain enabled after Rayfield restores settings.
-- Only a live quest workflow may preempt the separately configured Auto Farm.
function Hub:QuestOwnsFarmMovement()
    if not self.AutoQuest or not self.QuestSelectedId
        or self.QuestSelectedId == "None"
        or self.QuestFinishedId == self.QuestSelectedId then return false end
    local phase = tostring(self.QuestPhase or "Idle")
    if phase == "Idle" or phase == "Off" or phase == "Paused"
        or phase == "Completed" or phase == "Level milestone"
        or phase == "Prerequisite" or phase == "Special progression" then
        return self.QuestCombatActive == true
            or typeof(self.QuestMoveTo) == "Vector3"
    end
    return true
end

local function farmMovementStep(dt, char, root, hum, now)
    if Hub.V70NenPriority then return end
    if Hub.AutoMapChests and Hub.MapChestScoutBusy then return end
    if Hub.V44 and Hub.V44.ActivityOwner and os.clock()<Hub.V44.ActivityUntil then
        local actor=Hub.V44.ActivityOwner
        if actor=="Meditation" or actor=="Mining" or actor=="Crafting" or actor=="Nen Master" or actor=="Ore Merchant" then return end
    end
    -- Auto Dodge owns movement until the warning zone has been exited.
    -- This is not an attack action and it works even with Auto Farm disabled.
    if (Hub.AutoOpenChest or Hub.AutoInventoryChests or Hub.AutoMapChests) and Hub.ChestSession then
        Hub.FarmMoveStatus="Auto chest priority"
        return
    end
    if Hub.AutoDodge and (Hub.DodgeActive or now < Hub.DodgeHoldUntil) then
        Hub.FarmMoveStatus = "Auto Dodge: evasive movement"
        return
    end
    -- Quest navigation to givers/markers owns movement, but never combat.
    if Hub.AutoQuest and Hub.QuestMoveTo then
        Hub.FarmMoveStatus = "Auto Quest: traveling to objective"
        return
    end
    local questFollow = Hub.AutoQuest and Hub.QuestCombatActive
        and activeNpcRecord(Hub.QuestTarget)
    -- While Auto Quest is waiting for its selected enemy, don't chase a
    -- different mob from the manual farm dropdown.
    local questOwnsMovement = Hub:QuestOwnsFarmMovement()
    if questOwnsMovement then
        -- Transfer ownership once, not on every Heartbeat. Repeatedly
        -- clearing the quest's movement state made the avatar jerk or stop.
        if not Hub.FarmQuestHandoff then
            clearFarmMovement()
            Hub.FarmQuestHandoff = true
        end
        Hub.FarmTarget = nil
        Hub.FarmMoveStatus = "Auto Quest owns movement: " .. tostring(Hub.QuestPhase)
        Hub.TargetState = "Quest task active (farm temporarily paused)"
        return
    end
    Hub.FarmQuestHandoff = false
    if not Hub.AutoFarm then
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals)
            or Hub.FarmNav then clearFarmMovement() end
        Hub.FarmTarget = nil
        return
    end
    -- When the selected NPC moves away and another matching one is close,
    -- reacquire without switching repeatedly between adjacent enemies.
    Hub:RecheckFarmLock(root,now)
    local previous = Hub.FarmTarget
    if previous and not Hub:FarmLockPersistent(previous) then
        Hub.FarmTarget = nil
        Hub.FarmNextSearch = 0
    end
    if not Hub.FarmTarget and now >= Hub.FarmNextSearch then
        selectFarmTarget(root)
        Hub.FarmNextSearch = now + 0.08
    end
    local target = Hub.FarmTarget
    if target ~= previous then resetFarmPursuit() end
    if activeNpcRecord(target) then Hub:MonitorBossReset(target) end
    if not activeNpcRecord(target) then
        -- The same target may be ragdolled/knocked, momentarily anchored,
        -- or recovering. Do NOT travel to a different spawn or acquire a
        -- different mob while its living instance is still present.
        if Hub:FarmLockPersistent(target) then
            Hub.FarmAreaGoal,Hub.FarmAreaName=nil,nil
            Hub.FarmMoveStatus="Holding living target during knockdown / recovery"
            Hub.TargetState="Still locked: "..tostring(target.NPCName or target.Model.Name)
            if Hub.FarmMethod~="Legit" then Hub:HoldFarmFlight(root,root.CFrame) end
            return
        end
        if Hub.AutoFarm and not Hub.AutoQuest then
            local chosen = Hub.BossSelection ~= "None" and Hub.BossSelection
                or Hub.MobSelection
            if chosen=="None" or not chosen then
                for name,selected in pairs(Hub.MobSelections) do
                    if selected then chosen=name;break end
                end
            end
            local pos,source,index,count,range
            -- Do not rely on an already-streamed NPC or a loaded Workspace map.
            if chosen and chosen~="None" then
                if chosen=="Dracolith" and Hub.AutoSummonDracolith then
                    pos,source=Hub:GetBossAreaPoint("Dracolith")
                    if pos then
                        index,count,range=1,1,(root.Position-pos).Magnitude
                        source="Dracolith summon altar"
                    end
                else
                    pos,source,index,count,range=Hub:NextKnownNpcArea(chosen,root.Position,"farm")
                end
            end
            Hub.FarmAreaGoal,Hub.FarmAreaName=pos,chosen
            if pos then
                Hub.FarmMoveStatus=("Seeking %s spawn %d/%d (%d studs)")
                    :format(chosen,index,count,math.floor(range))
                Hub.TargetState="Area navigation: "..tostring(source)
                if type(Hub.RequestAreaStreaming)=="function" then
                    Hub:RequestAreaStreaming(pos,"farm:"..chosen)
                end
            else
                Hub.FarmMoveStatus=tostring(source or "No known spawn")
            end
        end
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals)
            or Hub.FarmNav then
            hum:MoveTo(root.Position)
            clearFarmMovement()
        end
        if Hub.FarmAreaGoal then
            Hub.TargetState = "Heading to mapped mob spawn; awaiting live NPC streaming"
        else
            Hub.FarmMoveStatus = "Waiting for living selected NPC"
            Hub.TargetState = "No living matching NPC (not chasing a kill marker)"
        end
        return
    end
    if Hub.FarmAreaGoal then
        Hub.FarmAreaGoal,Hub.FarmAreaName=nil,nil
        Hub.QuestRouteVersion+=1
    end
    local dtSafe = math.clamp(dt, 0.001, 0.06)
    -- If combat needs a parry/block or a moment of stable attack posture,
    -- suspend only the FARM's movement. Auto Farm itself stays movement-only.
    local focus = Hub.GuardRoot
    local guarding = (now < Hub.GuardUntil or Hub.DefenseMode ~= nil)
        and focus and focus.Parent
    local holding = (guarding or now < Hub.AttackHoldUntil)
        and Hub.FarmMethod == "Legit"
    if holding then
        if not Hub.GuardMovePaused then
            Hub.Stats.MovementHolds += 1
            Hub.GuardMovePaused = true
            Hub.FarmSmoothVelocity = Vector3.zero
            if Hub.FarmMethod == "Legit" then
                -- A single stop command avoids a new MoveTo every frame.
                hum:MoveTo(root.Position)
                if Hub.FarmNav then Hub.FarmNav.LastCommand = nil end
            end
        end
        if Hub.FarmMethod == "Legit" then
            if guarding then faceTarget(root, focus) end
        else
            if guarding then faceTarget(root, focus) end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        Hub.FarmMoveStatus = guarding and "Defensive hold: facing attacker"
            or "Attack stabilization"
        Hub.FarmLastDistance = (root.Position - target.Root.Position).Magnitude
        return
    elseif Hub.GuardMovePaused then
        Hub.GuardMovePaused = false
        Hub.FarmSmoothVelocity = Vector3.zero
        if Hub.FarmNav then Hub.FarmNav.LastCommand = nil end
    end
    if Hub.FarmMethod == "Legit" then
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals) then
            clearFarmMovement()
        end
        local dest = getGroundDestination(root, target)
        pathToDestination(root, hum, target, dest, now)
        Hub.FarmLastGoal = dest
        Hub.FarmLastDistance = (root.Position - target.Root.Position).Magnitude
        return
    end
    if not Hub.FarmSavedAutoRotate or Hub.FarmSavedAutoRotate.Hum ~= hum then
        -- Restore any stale character's original state without discarding
        -- a valid current-target follow state.
        local saved = Hub.FarmSavedAutoRotate
        if saved and saved.Hum and saved.Hum.Parent then
            pcall(function() saved.Hum.AutoRotate = saved.Value end)
        end
        Hub.FarmSavedAutoRotate = {Hum = hum, Value = hum.AutoRotate}
    end
    if hum.AutoRotate then hum.AutoRotate = false end
    if now >= Hub.FarmNextReconcile then
        updateFarmCollision(char)
        Hub.FarmNextReconcile = now + 0.25
    end
    local goal,goalPos=farmGoal(target,dtSafe)
    local bounded=Hub:BoundBossDestination(target,root.Position,goalPos)
    if (bounded-goalPos).Magnitude>.1 then
        goalPos=bounded;goal=CFrame.new(bounded)*goal.Rotation
        Hub.TargetState="Boss arena guard: limiting pursuit beyond encounter"
    end
    local nextCF
    local mode=Hub.FarmPosition
    local delta=(root.Position-goalPos).Magnitude
    -- Once close, all three poses must be position-locked to the NPC.
    -- Tween remains smooth for approaching from far away, but never trails
    -- the enemy in combat. Teleport remains instant when far away.
    if mode=="Behind" and delta<=27 then
        nextCF=goal
        Hub.FarmSmoothVelocity=Vector3.zero
        Hub.FarmMoveStatus="Behind: locked to current enemy facing"
    elseif (mode=="Above" or mode=="Below") and delta<=25 then
        nextCF=goal
        Hub.FarmSmoothVelocity=Vector3.zero
        Hub.FarmMoveStatus=mode..": horizontal hover locked"
    elseif Hub.FarmMethod=="Teleport" then
        nextCF=goal
        Hub.FarmSmoothVelocity=Vector3.zero
        Hub.FarmMoveStatus="Teleport: instant target lock"
    else
        local moveGoal, routed=tweenRecoveryGoal(root,target,goalPos,now)
        local pos
        pos,Hub.FarmSmoothVelocity=smoothDamp(root.Position,moveGoal,
            Hub.FarmSmoothVelocity,dtSafe,0.11,400)
        -- Always face the correct direction while approaching, without a
        -- slow rotational Lerp that puts the avatar partly upright.
        nextCF=CFrame.new(pos)*goal.Rotation
        Hub.FarmMoveStatus=routed and "Tween: obstacle route"
            or "Tween: approaching position lock"
    end
    -- Returning directly above a boss in a still-active red warning creates
    -- a dodge -> snap-back -> dodge loop. Retain the current safe hover until
    -- the visible hazard is gone, but keep the same selected NPC target.
    if Hub:FarmDestinationUnsafe(goalPos) then
        local orbit=Hub:FindSafeFarmOrbit(goalPos,root.Position,target)
        if orbit then
            -- Small Heartbeat transitions, no repeated full-distance snaps.
            local alpha=1-math.exp(-dtSafe*16)
            local nextPosition=root.Position:Lerp(orbit,alpha)
            if not Hub:FarmDestinationUnsafe(nextPosition) then
                Hub.SafeOrbitCount+=1
                Hub.FarmMoveStatus="Warning active: tracking safe boss orbit"
                Hub:ApplyFarmPose(char,root,CFrame.new(nextPosition)*goal.Rotation)
                return
            end
        end
        Hub.FarmMoveStatus="Warning covers approach; holding current hover"
        Hub.FarmSmoothVelocity=Vector3.zero
        Hub:HoldFarmFlight(root,root.CFrame)
        return
    end
    Hub:ApplyFarmPose(char,root,nextCF)
    Hub.FarmLastGoal = goalPos
    Hub.FarmLastDistance = (root.Position - target.Root.Position).Magnitude
end



-- Quest kill-stage pursuit is completely independent of the Auto Farm dropdown.
-- The combat tab decides whether M1, critical, parry, block or dodge runs.
local function questCombatMovementStep(dt, char, root, hum, now)
    if Hub.V44 and Hub.V44.ActivityOwner and os.clock()<Hub.V44.ActivityUntil then
        local actor=Hub.V44.ActivityOwner
        if actor=="Meditation" or actor=="Mining" or actor=="Crafting" or actor=="Nen Master" or actor=="Ore Merchant" then return end
    end
    if not Hub.AutoQuest or not Hub.QuestCombatActive or Hub.QuestMoveTo
        or Hub.DodgeActive or now < Hub.DodgeHoldUntil then
        if Hub.AutoQuest and Hub.QuestMoveTo then Hub:ReleaseFarmFlight() end
        return
    end
    local target=Hub.QuestTarget
    if target and (not target.Model or not target.Model.Parent
        or not target.Hum or modelDeadOrDespawning(target.Model,target.Hum)) then
        -- Immediate stale-lock recovery on Heartbeat. QuestTick acquires the
        -- next matching *living* model; this never changes a living target.
        Hub.QuestTarget=nil
        Hub.QuestFarmState.Target=nil
        Hub.QuestFarmState.Nav=nil
        Hub.QuestFarmState.Velocity=Vector3.zero
        Hub.QuestScanNextAt=0
        Hub.QuestCombatActive=false
        Hub.QuestFarmState.Status="Target defeated; finding next quest enemy"
        Hub.QuestHandoffPose=nil
        Hub.QuestHandoffUntil=0
        Hub:ReleaseFarmFlight()
        return
    end
    if not activeNpcRecord(target) then
        if target and target.Model and target.Hum
            and not modelDeadOrDespawning(target.Model,target.Hum) then
            Hub.QuestFarmState.Status="Waiting for current quest enemy to recover"
            Hub.QuestFarmState.UnavailableSince=Hub.QuestFarmState.UnavailableSince or now
            if Hub.QuestFarmMethod~="Legit" then
                if now-Hub.QuestFarmState.UnavailableSince<1.1 then
                    Hub:HoldFarmFlight(root,root.CFrame)
                else
                    Hub:ReleaseFarmFlight()
                end
            end
        else
            Hub:ReleaseFarmFlight()
        end
        return
    end
    local state=Hub.QuestFarmState
    state.UnavailableSince=nil
    if state.Target~=target then
        state.Target=target;state.Focus=nil;state.StableUp=nil
        state.Velocity=Vector3.zero;state.Nav=nil;state.NextCompute=0
    end
    if Hub.QuestFarmMethod=="Legit" and (Hub.DefenseMode
        or now < Hub.GuardUntil or now < Hub.AttackHoldUntil
        or manualHoldingBlock()) then
        if Hub.GuardRoot and Hub.GuardRoot.Parent then faceTarget(root,Hub.GuardRoot) end
        state.Status="Defensive / attack hold"
        return
    end
    local profile={Position=Hub.QuestFarmPosition,Distance=Hub.QuestFarmDistance,
        Focus=state.Focus,StableUp=state.StableUp}
    local goal,goalPos=farmGoal(target,math.clamp(dt,.001,.06),profile)
    Hub:MonitorBossReset(target)
    local bounded=Hub:BoundBossDestination(target,root.Position,goalPos)
    if (bounded-goalPos).Magnitude>.1 then
        goalPos=bounded;goal=CFrame.new(bounded)*goal.Rotation
        state.Status="Boss arena guard: bounded quest pursuit"
    end
    state.Focus,state.StableUp=profile.Focus,profile.StableUp
    if Hub.QuestFarmMethod=="Legit" then
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals) then
            clearFarmMovement()
        end
        local desired=getGroundDestination(root,target,profile)
        local nav=state.Nav
        if not nav then
            nav={Points=nil,Index=1,Goal=nil,Pending=false,Updated=0,LastCommand=0}
            state.Nav=nav
        end
        local blocked=lineBlocked(root,desired,target)
        if blocked and not nav.Pending and (not nav.Goal
            or (nav.Goal-desired).Magnitude>6 or now-nav.Updated>2.5) then
            nav.Pending=true;nav.Updated=now
            local from,to=root.Position,desired
            task.spawn(function()
                local ok,points=pcall(function()
                    local path=PathfindingService:CreatePath({AgentRadius=2,AgentHeight=5,
                        AgentCanJump=true,WaypointSpacing=4})
                    path:ComputeAsync(from,to)
                    return path.Status==Enum.PathStatus.Success and path:GetWaypoints() or nil
                end)
                if Hub.Running and Hub.AutoQuest and Hub.QuestFarmState.Nav==nav
                    and Hub.QuestTarget==target then
                    nav.Pending=false;nav.Goal=to
                    nav.Points=ok and points or nil;nav.Index=1
                end
            end)
        end
        local walk=desired
        if blocked and nav.Points then
            while nav.Index<=#nav.Points
                and (root.Position-nav.Points[nav.Index].Position).Magnitude<4 do
                nav.Index+=1
            end
            local p=nav.Points[nav.Index]
            if p then
                walk=p.Position
                if p.Action==Enum.PathWaypointAction.Jump then hum.Jump=true end
            end
        end
        if now-nav.LastCommand>.3 then
            hum:MoveTo(walk);nav.LastCommand=now
        end
        state.Status="Quest Legit: approaching "..tostring(target.NPCName)
        Hub.FarmMoveStatus=state.Status
        return
    end
    if not Hub.FarmSavedAutoRotate or Hub.FarmSavedAutoRotate.Hum~=hum then
        local old=Hub.FarmSavedAutoRotate
        if old and old.Hum and old.Hum.Parent then
            pcall(function() old.Hum.AutoRotate=old.Value end)
        end
        Hub.FarmSavedAutoRotate={Hum=hum,Value=hum.AutoRotate}
    end
    hum.AutoRotate=false
    if now>=Hub.FarmNextReconcile then
        updateFarmCollision(char);Hub.FarmNextReconcile=now+.25
    end
    local dtSafe=math.clamp(dt,.001,.06)
    local nextCF
    local delta=(root.Position-goalPos).Magnitude
    if delta<=27 or Hub.QuestFarmMethod=="Teleport" then
        nextCF=goal
        state.Velocity=Vector3.zero
        state.Status="Quest "..tostring(Hub.QuestFarmPosition)..": position locked"
    else
        local nextPosition
        nextPosition,state.Velocity=smoothDamp(root.Position,goalPos,
            state.Velocity,dtSafe,0.11,400)
        nextCF=CFrame.new(nextPosition)*goal.Rotation
        state.Status="Quest Tween: approaching target"
    end
    if Hub:FarmDestinationUnsafe(goalPos) then
        local orbit=Hub:FindSafeFarmOrbit(goalPos,root.Position,target)
        if orbit then
            local alpha=1-math.exp(-dtSafe*16)
            local nextPosition=root.Position:Lerp(orbit,alpha)
            if not Hub:FarmDestinationUnsafe(nextPosition) then
                Hub.SafeOrbitCount+=1
                state.Status="Quest farm: tracking safe boss orbit"
                state.Velocity=Vector3.zero
                Hub:ApplyFarmPose(char,root,CFrame.new(nextPosition)*goal.Rotation)
                Hub.FarmMoveStatus=state.Status
                return
            end
        end
        state.Status="Quest farm: warning covers approach; hovering"
        state.Velocity=Vector3.zero
        Hub:HoldFarmFlight(root,root.CFrame)
        Hub.FarmMoveStatus=state.Status
        return
    end
    Hub:ApplyFarmPose(char,root,nextCF)
    Hub.FarmMoveStatus=state.Status
end

-- Quest board/object travel follows the independent Quest Farm Method without taking over
-- the Auto Farm toggle or modifying its mob/boss choices. Separate position
-- navigation is used for quest givers, boards and objective prompts.
-- Quest navigation never flies straight into an unknown wall/ceiling.
-- Tween/Teleport follow real path waypoints and only fall back to direct
-- travel when no solid world geometry interrupts the route.
-- Quest travel can teleport safely to a nearby, walkable standing point.
-- Avoid blindly setting CFrame to a map marker: markers can be inside
-- walls, underground or anchored to the quest prop rather than its floor.
local function questTeleportNear(destination, source)
    if Hub.V70NenPriority then return false,"Node Master travel priority" end
    local char, root, hum = myCharacter()
    if not char or typeof(destination) ~= "Vector3" then return false, "No character" end
    local now = os.clock()
    if now - Hub.QuestLastTeleportAt < 0.7 then return false, "Teleport settling" end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    params.IgnoreWater = true
    local offsets = {
        Vector3.new(0,0,3.25),Vector3.new(3.25,0,0),
        Vector3.new(0,0,-3.25),Vector3.new(-3.25,0,0),
        Vector3.new(2.7,0,2.7),Vector3.new(-2.7,0,-2.7),
        Vector3.new(-2.7,0,2.7),Vector3.new(2.7,0,-2.7),
    }
    -- Prefer candidates near the target and with ground on the target's
    -- actual floor. Reject the roof above or terrain far beneath an NPC.
    local best, bestCost = nil, math.huge
    for _,offset in ipairs(offsets) do
        local test=destination+offset
        local hit=workspace:Raycast(test+Vector3.new(0,4,0),Vector3.new(0,-12,0),params)
        local hitModel=hit and hit.Instance:FindFirstAncestorOfClass("Model")
        local isCharacter=hitModel and hitModel:FindFirstChildOfClass("Humanoid")~=nil
        if hit and not isCharacter and hit.Normal.Y > .58
            and math.abs(hit.Position.Y-destination.Y)<=5 then
            local p=Vector3.new(test.X,
                hit.Position.Y+math.max(2.4,hum.HipHeight+root.Size.Y*.5+.2),test.Z)
            -- Verify no immediate solid obstacle between stand position and
            -- quest interactable at the same height.
            local toward=destination-(p+Vector3.new(0,0.7,0))
            local obstruction=workspace:Raycast(p+Vector3.new(0,0.7,0),toward,params)
            local open=not obstruction or (obstruction.Position-destination).Magnitude<2.2
            if open then
                local cost=(p-root.Position).Magnitude*.003+(p-destination).Magnitude
                if cost<bestCost then best,bestCost=p,cost end
            end
        end
    end
    if not best then
        -- The map around a distant verified spawn/board may not be streamed.
        -- Move just above its saved coordinates to trigger local streaming;
        -- this is a provisional landing, not proof that geometry/NPC exists.
        local label=tostring(source or "")
        local trusted=label:find("known-spawn",1,true)
            or label:find(":board",1,true)
            or label:find(":boss-area",1,true)
            or label:find(":board-fallback",1,true)
            or label:find(":giver:stream",1,true)
            or label:find(":stream:",1,true)
        if not trusted then return false,"No verified floor beside quest target" end
        if type(Hub.RequestAreaStreaming)=="function" then
            Hub:RequestAreaStreaming(destination,label)
        end
        best=destination+Vector3.new(0,7,0)
        Hub.QuestTeleportStatus="Provisional area landing; awaiting streamed geometry"
    end
    local look=Vector3.new(destination.X,best.Y,destination.Z)
    if (look-best).Magnitude<.1 then look=best+root.CFrame.LookVector end
    char:PivotTo(CFrame.lookAt(best,look))
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    Hub.QuestLastTeleportAt=now
    Hub.QuestTeleportKey=tostring(source or "quest")
    Hub.QuestTeleportStatus="Arrived at quest / spawn region: "..Hub.QuestTeleportKey
    return true,Hub.QuestTeleportStatus
end

local function questTravelStep(dt, char, root, hum, now)
    if Hub.V70NenPriority then return false end
    if Hub.AutoMapChests and Hub.MapChestScoutBusy then return end
    if Hub.V44 and Hub.V44.ActivityOwner and os.clock()<Hub.V44.ActivityUntil then
        local actor=Hub.V44.ActivityOwner
        if actor=="Meditation" or actor=="Mining" or actor=="Crafting" or actor=="Nen Master" or actor=="Ore Merchant" then return end
    end
    local farmAreaMode = Hub.AutoFarm and not Hub:QuestOwnsFarmMovement()
        and typeof(Hub.FarmAreaGoal)=="Vector3"
    if (Hub.AutoOpenChest or Hub.AutoInventoryChests or Hub.AutoMapChests) and Hub.ChestSession then return false end
    if not (Hub.AutoQuest and Hub.QuestMoveTo) and not farmAreaMode then return false end
    if Hub.AutoDodge and (Hub.DodgeActive or now < Hub.DodgeHoldUntil) then return false end
    Hub:ReleaseFarmFlight()
    if Hub.DefenseMode or now < Hub.GuardUntil or manualHoldingBlock() then return false end
    local destination = farmAreaMode and Hub.FarmAreaGoal or Hub.QuestMoveTo
    local navigationSource=farmAreaMode and ("farm:known-spawn:"..tostring(Hub.FarmAreaName))
        or Hub.QuestMoveSource
    if typeof(destination) ~= "Vector3" then return false end
    -- Quest markers are not movement paths. A grounded teleport is preferred
    -- to a long Tween that can hit the underside of a board or a building.
    -- On failure, retain the old waypoint route rather than teleporting
    -- into unknown geometry.
    if (root.Position-destination).Magnitude > math.max(4,Hub.QuestStopRadius or 5) then
        local jumped,reason=questTeleportNear(destination,navigationSource)
        if jumped then
            Hub.QuestTravelStatus=farmAreaMode and "Traveling to selected mob spawn"
                or "Quest teleport to current stage"
            Hub.FarmMoveStatus=farmAreaMode and "Mob spawn: awaiting live NPC"
                or "Auto Quest: arrived at interaction area"
            return true
        elseif reason ~= "Teleport settling" then
            Hub.QuestTeleportStatus=reason
        end
    end
    local filter = RaycastParams.new()
    filter.FilterType = Enum.RaycastFilterType.Exclude
    filter.FilterDescendantsInstances = {char}
    filter.IgnoreWater = true
    local function unobstructed(a,b)
        local d=b-a
        if d.Magnitude < 0.35 then return true end
        local hit=workspace:Raycast(a,d,filter)
        return hit == nil or (hit.Position-b).Magnitude < 2.5
    end
    -- Approach the NPC/marker on its own walkable floor, not under it.
    local toward = Vector3.new(root.Position.X-destination.X,0,root.Position.Z-destination.Z)
    if toward.Magnitude < 0.1 then toward = Vector3.new(1,0,0) end
    -- If a giver is on the other side of a solid wall, try different
    -- approach angles rather than staying on the wrong side forever.
    local approachAngle=(Hub.QuestApproachSector or 0)*(math.pi*.5)
    toward=CFrame.fromAxisAngle(Vector3.yAxis,approachAngle):VectorToWorldSpace(toward.Unit)
    local stand = destination + toward.Unit*math.clamp(Hub.QuestStopRadius or 4.5,2,5.5)
    local probe = workspace:Raycast(stand+Vector3.new(0,2.5,0),Vector3.new(0,-19,0),filter)
    if probe and probe.Normal.Y > 0.5 then
        stand=Vector3.new(stand.X,probe.Position.Y+math.max(2.5, hum.HipHeight+root.Size.Y*.5),stand.Z)
    end
    local actualDist=(destination-root.Position).Magnitude
    local nearDistance=math.clamp(Hub.QuestStopRadius or 5,3,7)
    if actualDist <= nearDistance
        and math.abs(destination.Y-root.Position.Y) < 6.5
        and unobstructed(root.Position,destination) then
        Hub.QuestTravelStatus="Reached objective approach"
        if (farmAreaMode and Hub.FarmMethod or Hub.QuestFarmMethod)=="Legit" and now-Hub.QuestWalkAt>.6 then
            hum:MoveTo(root.Position); Hub.QuestWalkAt=now
        end
        return true
    end
    local deltaToFinal=(root.Position-stand).Magnitude
    local goalChanged=(not Hub.QuestRouteGoal) or
        (Hub.QuestRouteGoal-stand).Magnitude>7
    local stalled=false
    if not Hub.QuestRouteLastPosition then
        Hub.QuestRouteLastPosition=root.Position;Hub.QuestRouteProgressAt=now
    elseif (root.Position-Hub.QuestRouteLastPosition).Magnitude>=2.5 then
        Hub.QuestRouteLastPosition=root.Position;Hub.QuestRouteProgressAt=now
    elseif deltaToFinal>9 and now-Hub.QuestRouteProgressAt>2.0 then
        stalled=true;Hub.QuestRouteProgressAt=now
        Hub.QuestApproachSector=((Hub.QuestApproachSector or 0)+1)%4
    end
    if (goalChanged or stalled or (not Hub.QuestPath and now-Hub.QuestPathAt>3.0))
        and not Hub.QuestPathPending and now-Hub.QuestPathAt>1.1 then
        Hub.QuestRouteVersion+=1
        local version=Hub.QuestRouteVersion
        Hub.QuestRouteGoal=stand;Hub.QuestPathAt=now
        Hub.QuestPathPending=true
        Hub.QuestPath=nil;Hub.QuestPathIndex=1
        local origin=root.Position
        task.spawn(function()
            local ok,points=pcall(function()
                local path=PathfindingService:CreatePath({AgentRadius=2, AgentHeight=5,
                    AgentCanJump=true,WaypointSpacing=4})
                path:ComputeAsync(origin,stand)
                if path.Status==Enum.PathStatus.Success then return path:GetWaypoints() end
            end)
            if Hub.Running and (Hub.AutoQuest or Hub.AutoFarm)
                and version==Hub.QuestRouteVersion then
                Hub.QuestPath=ok and points and #points>0 and points or nil
                Hub.QuestPathIndex=1
                Hub.QuestRouteFailureAt=Hub.QuestPath and 0 or os.clock()
                Hub.QuestPathPending=false
            end
        end)
    end
    local waypoint=nil
    local route=Hub.QuestPath
    if route then
        while Hub.QuestPathIndex<=#route do
            local p=route[Hub.QuestPathIndex]
            if (p.Position-root.Position).Magnitude>3.2 then
                waypoint=p;break
            end
            Hub.QuestPathIndex+=1
        end
    end
    local nextPos=waypoint and waypoint.Position or stand
    local canDirect=unobstructed(root.Position,nextPos)
    if not waypoint and Hub.QuestPathPending and not unobstructed(root.Position,stand) then
        Hub.QuestTravelStatus="Computing path around obstacle"
        return false
    end
    if not canDirect then
        Hub.QuestPathAt=math.min(Hub.QuestPathAt,now-2)
        Hub.QuestTravelStatus="Path blocked: finding safer route"
        return false
    end
    if (farmAreaMode and Hub.FarmMethod or Hub.QuestFarmMethod)=="Legit" then
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals) then
            clearFarmMovement()
        end
        if waypoint and waypoint.Action==Enum.PathWaypointAction.Jump then hum.Jump=true end
        if now-Hub.QuestWalkAt>.3 or not Hub.QuestNavigationGoal
            or (Hub.QuestNavigationGoal-nextPos).Magnitude>2 then
            hum:MoveTo(nextPos)
            Hub.QuestNavigationGoal=nextPos;Hub.QuestWalkAt=now
        end
    else
        if not Hub.FarmSavedAutoRotate or Hub.FarmSavedAutoRotate.Hum~=hum then
            local saved=Hub.FarmSavedAutoRotate
            if saved and saved.Hum and saved.Hum.Parent then
                pcall(function() saved.Hum.AutoRotate=saved.Value end)
            end
            Hub.FarmSavedAutoRotate={Hum=hum,Value=hum.AutoRotate}
        end
        hum.AutoRotate=false
        if now>=Hub.FarmNextReconcile then
            updateFarmCollision(char);Hub.FarmNextReconcile=now+.25
        end
        local vec=nextPos-root.Position
        local distance=vec.Magnitude
        local speed=(farmAreaMode and Hub.FarmMethod or Hub.QuestFarmMethod)=="Teleport" and 450 or 115
        local step=math.min(distance, math.clamp(dt,.001,.06)*speed)
        local newPos=distance>.02 and root.Position+vec.Unit*step or root.Position
        local look=Vector3.new(destination.X,newPos.Y,destination.Z)
        if (look-newPos).Magnitude<.2 then
            look=newPos+root.CFrame.LookVector
        end
        char:PivotTo(CFrame.lookAt(newPos,look))
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
    end
    Hub.QuestTravelStatus=(waypoint and "Following navigable path" or
        "Moving to clear objective approach") .. " | " .. (farmAreaMode and Hub.FarmMethod or Hub.QuestFarmMethod)
    Hub.FarmMoveStatus="Auto Quest: "..Hub.QuestTravelStatus
    return true
end

-- New game: Client.Combat.input.block(true) drives CombatNet.Defend.
-- A fresh press can attempt a parry; the server owns success/cooldowns.
-- Legacy BeginBlock is only called in older versions of the game.
local function beginDefense(kind, char, ctrl, myRoot, theirRoot, now, remaining)
    if Hub.DefenseMode or not canDefend(char, ctrl) then return false end
    if kind=="Parry" and not canParry(char,ctrl,now) then return false end
    faceTarget(myRoot,theirRoot)
    local worked=false
    if CombatV2 and CombatV2.input then
        worked=safeCall(function() CombatV2.input.block(true) end)
        if worked then Hub.DefenseDebug="CombatNet native defense requested" end
    elseif Combat and ctrl and type(ctrl.BeginBlock)=="function" then
        local trace=type(Combat.BeginInputTrace)=="function"
            and Combat.BeginInputTrace(kind=="Parry" and "Block/Parry" or "Block") or nil
        worked=safeCall(function()
            if kind=="Parry" then ctrl:BeginBlock(trace)
            else ctrl:BeginBlock(trace,false,true) end
        end)
    end
    if not worked then
        Hub.DefenseDebug="Defense input unavailable / rejected locally"
        return false
    end
    Hub.DefenseMode=kind
    Hub.DefenseUntil=now+0.12
    Hub.GuardRoot=theirRoot
    Hub.GuardUntil=math.max(Hub.GuardUntil,now+math.max(0.18,remaining+0.14))
    if kind=="Parry" then
        Hub.NextParry=now+(CombatV2 and 1.75 or 0.455)
        -- Keep BlockStart active through the predicted hit while preserving
        -- the client's 0.25s parry window and its normal blocking follow-up.
        Hub.DefenseReleaseAt=now+math.clamp(remaining+0.20,0.25,0.43)
        Hub.Stats.ParryAttempts+=1
        Hub.DefenseDebug="Native parry press sent (server result unverified)"
    else
        Hub.LastAutoBlock=now
        Hub.DefenseReleaseAt=now+math.clamp(remaining+0.25,0.20,0.62)
        Hub.Stats.Blocks+=1
        Hub.DefenseDebug="Native block requested"
    end
    return true
end

local function offenseAllowed(char, now)
    if now < Hub.ManualUntil or now < Hub.DefenseUntil
        or now < Hub.GuardUntil or now < Hub.DefensePriorityUntil
        or now < Hub.OffenseQuietUntil then return false end
    if Hub.DefenseMode or manualHoldingBlock() then return false end
    if UIS:GetFocusedTextBox() or Keybinds.Capturing then return false end
    if char:GetAttribute("Busy") == true or char:GetAttribute("IsGripping") == true then return false end
    if char:HasTag("Blocking") or char:GetAttribute("HoldingBlock") == true then return false end
    if char:HasTag("UsingSkill") then return false end
    return true
end
-- DIRECT REMOTE M1 TEST ------------------------------------------------------
-- Cobalt captured:
-- Hit:FireServer(humanoidState, slideHeld, requestId, predictionStarted,
--   predictionStartedAt, "M1:1", aerialEligible, inputAt,
--   rootCFrame, rootAssemblyLinearVelocity, sprintHeld, regularSwing)
--
-- Do not replay the recorded ID (712), 1794196... timestamps or recorded CFrame.
-- The native client uses a shared request-id counter (u18, upvalue 13 in the
-- supplied decompile), so synchronize it ONLY when its structure can be verified.
local function getHitUpvalue(index)
    local getter = (type(getupvalue) == "function" and getupvalue)
        or (type(debug) == "table" and type(debug.getupvalue) == "function" and debug.getupvalue)
    if getter then
        local ok, first, second = pcall(getter, Combat.Hit, index)
        if ok then return second ~= nil and second or first end
    end
    local getterAll = type(getupvalues) == "function" and getupvalues
    if getterAll then
        local ok, items = pcall(getterAll, Combat.Hit)
        if ok and type(items) == "table" then return items[index] end
    end
    return nil
end
local function nativeHitCounter()
    local ok, module, nextCombo, counter = pcall(function()
        return getHitUpvalue(10), getHitUpvalue(14), getHitUpvalue(13)
    end)
    if ok and module == Combat and type(nextCombo) == "function"
        and type(counter) == "number" and counter >= 0 then
        return math.floor(counter)
    end
    return nil
end
local function nextHitRequestId()
    local chain = Combat.ComboChain
    local maxId = Hub.DirectM1Id
    local native = nativeHitCounter()
    if native then maxId = math.max(maxId, native) end
    if type(chain) == "table" then
        for _, field in ipairs({"AckRequestId", "PendingRequestId", "RequestId"}) do
            local value = chain[field]
            if type(value) == "number" then maxId = math.max(maxId, value) end
        end
    end
    local requestId = math.floor(maxId) + 1
    Hub.DirectM1Id = requestId
    Hub.NativeCounterSynced = false
    if native ~= nil then
        local setter = (type(setupvalue) == "function" and setupvalue)
            or (type(debug) == "table" and type(debug.setupvalue) == "function" and debug.setupvalue)
        if setter then
            local ok = pcall(setter, Combat.Hit, 13, requestId)
            Hub.NativeCounterSynced = ok and nativeHitCounter() == requestId
        end
    end
    return requestId
end

local DIRECT_BLOCKED_TAGS = {
    "Attacking", "Blocking", "UsingSkill", "CanParry", "TrueStunned",
    "HalfStunned", "PostureBroken", "BlockBroken", "Parried", "Knocked",
    "Ragdolled", "Dashing", "TpDashing", "InGrippingScene", "Clashing"
}
local function directM1Ready(char, now)
    if now < Hub.DirectNextAt or now - Hub.LastM1 < 0.35 then
        return false, "Cadence"
    end
    for _, name in ipairs(DIRECT_BLOCKED_TAGS) do
        if char:HasTag(name) then return false, "Tag:" .. name end
    end
    for _, name in ipairs({"Busy", "M1OnCooldown", "ComboOnCooldown", "SpawnProtected"}) do
        if char:GetAttribute(name) == true then return false, "Attribute:" .. name end
    end
    local recoveryUntil = char:GetAttribute("RecoveryUntil")
    if type(recoveryUntil) == "number" and workspace:GetServerTimeNow() < recoveryUntil then
        return false, "RecoveryUntil"
    end
    return true
end
local function nextDirectCombo(char, now)
    local confirmed = tonumber(char:GetAttribute("ComboIndex")) or 0
    confirmed = math.clamp(math.floor(confirmed), 0, 5)
    if char:GetAttribute("ResetForUppercut") == true then return 1 end
    if Hub.DirectComboAt == 0 or now - Hub.DirectComboAt > 1.15 then
        return confirmed > 0 and (confirmed % 5 + 1) or 1
    end
    -- The server-updated ComboIndex can arrive late. Advance locally within
    -- this direct-only chain instead of repeatedly sending "M1:1".
    return Hub.DirectCombo % 5 + 1
end
local function attemptM1(_, char, now)
    if CombatV2 then return false,"Old 12-field remote removed; using CombatNet native input" end
    if not HitRemote then return false,"Legacy Hit remote is missing" end
    local ready, reason = directM1Ready(char, now)
    if not ready then Hub.FarmLastM1Gate = reason; return false, reason end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not root then return false, "No alive humanoid/root" end
    -- V5 accidentally prevented all attacks while Above/Below was hovering.
    -- Send the CURRENT humanoid state instead of suppressing airborne requests.
    -- Server validation still controls damage; this is a direct-remote test.
    local combo = nextDirectCombo(char, now)
    local state = hum:GetState()
    local requestId = nextHitRequestId()
    local inputAt = workspace:GetServerTimeNow()
    local predictionAt = workspace:GetServerTimeNow()
    local variant = "M1:" .. tostring(combo)
    -- For this ground-M1 test, use false (as captured), not a running M1.
    local sprintHeld = false

    -- Match the NORMAL M1 packet seen in Cobalt. Running/aerial/uppercut
    -- packets have different variants and must not be faked as "M1:1".
    local sent = safeCall(function()
        HitRemote:FireServer(
            state,
            false,                 -- slide/uppercut input is not held
            requestId,
            true,                  -- predictionStarted: captured true
            predictionAt,
            variant,
            false,                 -- aerialEligible: false for ground M1
            inputAt,
            root.CFrame,
            root.AssemblyLinearVelocity,
            sprintHeld,
            true                   -- ordinary M1 (not down slam)
        )
    end)
    if not sent then Hub.FarmLastM1Gate = "Remote send error"; return false, "FireServer error" end
    Hub.FarmLastM1Gate = "M1 remote sent (damage unverified)"

    Hub.LastM1, Hub.LastOffense = now, now
    Hub.DirectCombo, Hub.DirectComboAt = combo, now
    -- Local cadence, independent of v3's CanStartM1Now/native queue.
    -- The server still decides whether the attack is accepted.
    Hub.DirectNextAt = now + (combo == 5 and 0.72 or 0.45)
    Hub.M1SinceCrit += 1
    Hub.ConsecutiveM1 += 1
    -- Stop repositioning across an actual strike for a short interval.
    -- This is especially helpful with Behind orbiting and direct Hit packets.
    if Hub.AutoFarm then Hub.AttackHoldUntil = now + 0.17 end
    -- Do not add idle periods after every two M1s: that starved Auto Attack
    -- while enemies played looping attack animations. Incoming threat handling
    -- takes priority only in a narrow, actual impact window.
    if Hub.ConsecutiveM1 >= 3 then Hub.ConsecutiveM1 = 0 end
    Hub.Stats.M1 += 1 -- number of requests SENT, not confirmed hits
    Hub.Stats.DirectM1 += 1
    Hub.LastDirectM1 = {
        RequestId = requestId,
        Combo = variant,
        SentAt = inputAt,
        NativeCounterSynced = Hub.NativeCounterSynced,
        ServerComboWhenSent = char:GetAttribute("ComboIndex"),
        State = tostring(state),
    }
    return true, "Remote sent; damage unverified"
end

-- If the raw Hit packet is consistently accepted by FireServer but makes no
-- measurable difference, use the game's native local combat flow instead.
-- Health change is an imperfect heuristic (armor, immunity and missing hits
-- can all look like no damage), so expose the reason in GetStatus().
local function observeDirectDamage(target, beforeHealth, startingMode)
    if not target or not target.Hum or startingMode ~= "Direct" then return end
    task.delay(0.60, function()
        if not Hub.Running or Hub.M1Mode ~= "Direct" then return end
        local hum = target.Hum
        if not hum or not hum.Parent then return end
        if hum.Health + 0.5 < beforeHealth then
            Hub.NoDamageChecks = 0
        else
            Hub.NoDamageChecks += 1
        end
        if Hub.NoDamageChecks >= 5 then
            Hub.M1Mode = "Native"
            Hub.NativeFallbackReason = "5 direct M1 packets without observed damage"
            Hub.DirectNextAt = 0
            Hub.NoDamageChecks = 0
            Hub.FarmLastM1Gate = "Switched to native combat flow"
        end
    end)
end

local function attemptNativeM1(ctrl, char, now)
    if not equipped(ctrl) then return false,"Combat weapon not equipped" end
    if now<Hub.DirectNextAt or now-Hub.LastM1<0.18 then
        return false,"Native cooldown"
    end
    if CombatV2 then
        if CombatV2Gate and type(CombatV2Gate.waitTime)=="function" then
            local good,delay=pcall(CombatV2Gate.waitTime,char,LocalPlayer,
                "Attack",{"M1","ServerHold"})
            if not good then return false,"CombatNet gate unavailable" end
            if type(delay)=="number" and delay>0.025 then
                return false,string.format("CombatNet recovery %.2fs",delay)
            end
        end
        local good=safeCall(function() CombatV2.input.attack() end)
        if not good then return false,"Updated native M1 errored" end
        Hub.LastM1,Hub.LastOffense=now,now
        Hub.DirectNextAt=now+0.19
        Hub.M1SinceCrit+=1
        Hub.Stats.M1+=1
        Hub.Stats.NativeM1+=1
        Hub.FarmLastM1Gate="CombatNet M1 input requested (damage unverified)"
        return true,"CombatNet M1 requested"
    end
    if not Combat or type(Combat.CanStartM1Now)~="function"
        or type(Combat.Hit)~="function" then
        return false,"No supported legacy native M1"
    end
    local ok,ready=safeCall(function() return Combat.CanStartM1Now() end)
    if not ok or ready~=true then return false,"Native M1 not ready" end
    local success=safeCall(function()
        Combat.Hit(false,false,Combat.BeginInputTrace("AutoM1"))
    end)
    if not success then return false,"Native M1 failed" end
    Hub.LastM1,Hub.LastOffense=now,now
    Hub.DirectNextAt=now+0.44
    Hub.M1SinceCrit+=1
    Hub.Stats.M1+=1
    Hub.Stats.NativeM1+=1
    Hub.FarmLastM1Gate="Legacy native M1 requested (damage unverified)"
    return true,"Legacy native requested"
end

