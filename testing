local function getCandidateModel(instance)
    if typeof(instance) ~= "Instance" then return nil end
    if instance:IsA("Model") then return instance end
    return instance:FindFirstAncestorOfClass("Model")
end

-- A saved D1 dungeon uses a Workspace.Dungeons.D1 model with Run="D1".
-- Do not assume every dungeon's run identifier is D1.
local function currentDungeonId()
    local folder = Workspace:FindFirstChild("Dungeons")
    if not folder then return nil end
    for _, layout in ipairs(folder:GetChildren()) do
        if layout:IsA("Model") then
            local runId = layout:GetAttribute("Run")
            if type(runId) == "string" and runId ~= "" then
                return runId, layout
            end
        end
    end
    return nil
end

local function activePhase()
    -- A terminal HUD takes priority if a late script execution missed Run.
    local hudPhase = getVisibleRunPhase and getVisibleRunPhase() or nil
    if hudPhase == "Cleared" or hudPhase == "Failed" then return hudPhase end
    local phase = dungeonRun and dungeonRun.Phase
    return type(phase) == "string" and phase or nil
end

local function currentRoomKey()
    local phase = activePhase() or "Unknown"
    local number = dungeonRun and tostring(dungeonRun.Room or "?") or "?"
    return phase .. ":" .. number
end

local function validDungeonEnemy(model)
    if not model or not model:IsDescendantOf(Workspace) then return nil end
    if model == Player.Character or Players:GetPlayerFromCharacter(model) then return nil end
    local hasMarker = model:GetAttribute("EnemyId") ~= nil
        or model:GetAttribute("Species") ~= nil
        or model:GetAttribute("IsBoss") == true
    if not hasMarker and not model:FindFirstChildOfClass("Humanoid") then return nil end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local hp = tonumber(model:GetAttribute("Health"))
    if humanoid and humanoid.Health <= 0 then return nil end
    if hp and hp <= 0 then return nil end
    local pos, cf = getInstancePosition(model)
    if not pos then return nil end
    return pos, cf, hp or (humanoid and humanoid.Health) or nil
end

local function scanDungeonEnemies()
    local now = os.clock()
    if now - lastDungeonScan < 0.28 then return dungeonTargetsCache end
    lastDungeonScan = now
    local seen, candidates, output = {}, {}, {}
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    local runId = currentDungeonId()
    if enemiesFolder then
        for _, obj in ipairs(enemiesFolder:GetDescendants()) do
            if obj:IsA("Model") and (obj:GetAttribute("EnemyId") ~= nil
                or obj:GetAttribute("Species") ~= nil
                or obj:GetAttribute("IsBoss") == true) then
                candidates[#candidates + 1] = obj
            end
        end
        for _, obj in ipairs(enemiesFolder:GetChildren()) do
            if obj:IsA("Model") then candidates[#candidates + 1] = obj end
        end
    end
    for _, inst in ipairs(CollectionService:GetTagged("Enemy")) do
        local model = getCandidateModel(inst)
        if model then candidates[#candidates + 1] = model end
    end
    local taggedCount = 0
    for _, model in ipairs(candidates) do
        if not seen[model] then
            seen[model] = true
            local marker = model:GetAttribute("Dungeon")
            local isTagged = marker ~= nil and marker ~= false and marker ~= ""
            if (not isTagged) or (not runId) or tostring(marker) == tostring(runId) then
                local pos, cf, hp = validDungeonEnemy(model)
                if pos then
                    if isTagged then taggedCount += 1 end
                    output[#output + 1] = {
                        model = model, pos = pos, cf = cf, hp = hp,
                        isBoss = model:GetAttribute("IsBoss") == true,
                        isTagged = isTagged,
                    }
                end
            end
        end
    end
    -- Prefer only enemies marked for this dungeon if they exist.
    if taggedCount > 0 then
        local filtered = {}
        for _, item in ipairs(output) do
            if item.isTagged then filtered[#filtered + 1] = item end
        end
        output = filtered
    end
    dungeonTaggedCount = taggedCount
    dungeonTargetsCache = output
    return output
end

local function targetPosition(info)
    -- The exact same desired goal is used by the distance checks and the
    -- Heartbeat mover; the original Below logic measured from mob center.
    if farmMethod ~= "Legit" and farmMover.GoalFor then
        local goal = farmMover.GoalFor(info)
        if goal then return goal end
    end
    local pos = info.pos
    local cf = info.cf or CFrame.new(pos)
    if farmPosition == "Above" then
        return pos + Vector3.new(0, farmDistance, 0)
    elseif farmPosition == "Below" then
        return pos - Vector3.new(0, farmDistance, 0)
    else
        return pos - cf.LookVector * farmDistance
    end
end

-- Farm motion (V23): ONE Heartbeat drives both world and dungeon targets.
-- BELOW: depth is the visible gap between the mob's lowest body point and
-- the top of the sideways player, not just an offset from the enemy root.
-- Root/character collision changes are local, temporary and restored on stop.
do
    local state = {
        target = nil, lastOrder = 0, humanoid = nil, oldAutoRotate = nil,
        root = nil, filteredGoal = nil, filteredHeading = nil,
        topOffset = 3, bottomOffset = -3, avatarUpExtent = 1.7,
        lastAttackHeading = Vector3.new(0, 0, -1),
        snappedToTarget = false, ghostCharacter = nil, ghostOriginal = {},
        lastGhostCheck = 0,
        safeSurfaceCF = nil, floorY = nil, floorChecked = 0,
        floorLocation = nil, referenceMobY = nil,
        hadDriven = false, wasBelow = false, holding = false,
        heldRoot = nil, oldAnchored = false, idlePlatform = nil,
        platformRootOffset = nil,
        spiritFocusId = nil, spiritPosition = nil, spiritLastOrder = 0,
        spiritApproachRoot = nil, spiritApproachOldAnchor = nil,
        spiritApproachDirection = nil, spiritApproachRotation = nil,
        spiritApproachMode = nil,
    }
    local Y = Vector3.new(0, 1, 0)
    local function safeHorizontal(vector, fallback)
        local flat = Vector3.new(vector.X, 0, vector.Z)
        if flat.Magnitude < 0.002 then return fallback or Vector3.new(0, 0, -1) end
        return flat.Unit
    end

    local setBelowGhost
    -- Sample only walkable, collidable terrain, excluding mobs and our platform.
    -- The reference mob height prevents a high roof from becoming the "ground".
    local function findSurface(at, referenceY)
        if not at then return nil end
        local exclusions = {}
        local char = Player.Character
        if char then exclusions[#exclusions + 1] = char end
        for _, name in ipairs({"Enemies", "Spirits"}) do
            local folder = Workspace:FindFirstChild(name)
            if folder then exclusions[#exclusions + 1] = folder end
        end
        if state.idlePlatform then exclusions[#exclusions + 1] = state.idlePlatform end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local base = tonumber(referenceY) or at.Y
        local origin = Vector3.new(at.X, math.max(base + 55, at.Y + 25), at.Z)
        for _ = 1, 10 do
            params.FilterDescendantsInstances = exclusions
            local hit = Workspace:Raycast(origin, Vector3.new(0, -1400, 0), params)
            if not hit then return nil end
            if hit.Normal.Y > 0.65 and hit.Instance.CanCollide
                and hit.Position.Y <= base + 12 then
                return hit.Position.Y
            end
            exclusions[#exclusions + 1] = hit.Instance
        end
        return nil
    end

    local function characterParts()
        local character = Player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then return nil, nil, nil end
        return character, root, hum
    end

    local function standingRootY(surface, root, hum)
        return surface + hum.HipHeight + root.Size.Y * 0.5 + 0.35
    end

    local function uprightAt(pos)
        local heading = safeHorizontal(state.lastAttackHeading, Vector3.new(0, 0, -1))
        return CFrame.lookAt(pos, pos + heading)
    end

    -- Capture a fallback surface before starting the farm. Never store an
    -- underground or midair location as the return point.
    farmMover.CaptureSurface = function()
        local _, root, hum = characterParts()
        if not root or state.holding or state.wasBelow then return end
        local floor = findSurface(root.Position, root.Position.Y)
        if floor and root.Position.Y >= floor and root.Position.Y - floor < 14 then
            state.safeSurfaceCF = uprightAt(Vector3.new(root.Position.X,
                standingRootY(floor, root, hum), root.Position.Z))
        end
    end

    local function clearPlatform()
        if state.idlePlatform then
            state.idlePlatform:Destroy()
            state.idlePlatform = nil
        end
        if state.heldRoot and state.heldRoot.Parent then
            state.heldRoot.Anchored = state.oldAnchored
        end
        state.heldRoot = nil
        state.holding = false
        state.platformRootOffset = nil
    end

    local function returnToGround()
        local character, root, hum = characterParts()
        if not root then return end
        local floor = findSurface(root.Position,
            state.referenceMobY or root.Position.Y)
        local dest
        if floor then
            dest = uprightAt(Vector3.new(root.Position.X,
                standingRootY(floor, root, hum), root.Position.Z))
        else
            dest = state.safeSurfaceCF
        end
        if not dest then
            warn("[Tame V24] Surface could not be verified; keeping character supported")
            return false
        end
        local oldAnchor = root.Anchored
        root.Anchored = true
        root.CFrame = dest
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = oldAnchor
        return true
    end

    -- Spawn a temporary platform at the character's LAST farm position.
    -- Anchoring the root during idle prevents a physics fall even when Below
    -- farming has temporarily disabled the rig's own collisions.
    farmMover.Hold = function()
        if not running or farmMethod == "Legit" or not state.hadDriven then
            return false
        end
        local character, root, hum = characterParts()
        if not root then return false end
        if state.holding and state.heldRoot == root and state.idlePlatform
            and state.idlePlatform.Parent then
            return true
        end
        clearPlatform()
        state.target = nil
        state.spiritFocusId = nil
        state.spiritPosition = nil
        state.lastOrder = 0
        state.filteredGoal = nil
        state.filteredHeading = nil
        state.snappedToTarget = false
        local pos = root.Position
        if state.wasBelow then
            -- Standing upright needs more headroom than the horizontal pose.
            local floor = findSurface(pos, state.referenceMobY)
                or state.floorY
            if floor then
                local standingTop = 4.0
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part ~= root then
                        local rel = root.CFrame:ToObjectSpace(part.CFrame)
                        local halfY = 0.5 * (
                            math.abs(rel.RightVector.Y) * part.Size.X
                            + math.abs(rel.UpVector.Y) * part.Size.Y
                            + math.abs(rel.LookVector.Y) * part.Size.Z)
                        standingTop = math.max(standingTop, rel.Position.Y + halfY)
                    end
                end
                -- Keep even tall hats/hair below the terrain while idle.
                pos = Vector3.new(pos.X,
                    math.min(pos.Y, floor - standingTop - 1.5), pos.Z)
            end
            setBelowGhost(true, character)
        else
            setBelowGhost(false, character)
        end
        state.oldAnchored = root.Anchored
        state.heldRoot = root
        root.Anchored = true
        root.CFrame = uprightAt(pos)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        hum.AutoRotate = false
        local platform = Instance.new("Part")
        platform.Name = "TameAnimal_V24_IdleFarmPlatform"
        platform.Size = Vector3.new(12, 0.7, 12)
        platform.Anchored = true
        platform.CanCollide = true
        platform.CanTouch = false
        platform.CanQuery = false
        platform.Material = Enum.Material.SmoothPlastic
        platform.Color = Color3.fromRGB(65, 145, 200)
        platform.Transparency = 0.35
        local platformTop = pos.Y - hum.HipHeight - root.Size.Y * 0.5
        platform.CFrame = CFrame.new(pos.X, platformTop - platform.Size.Y * 0.5, pos.Z)
        platform.Parent = Workspace
        state.idlePlatform = platform
        -- Maintain the same standing clearance while the platform ascends.
        state.platformRootOffset = root.Position.Y - platform.Position.Y
        state.holding = true
        Aux.belowFarmStatus = state.wasBelow
            and "Below: waiting safely on underground platform"
            or "Waiting on temporary farm platform"
        return true
    end

    -- Determine how far the body protrudes upward when its LookVector
    -- points UP. This captures arms/head/torso, rather than just the HRP.
    -- It is relative to the rig root, so it works for tilted characters too.
    local function avatarClearance(character, root)
        if not character or not root then return 1.7 end
        local highest = 1.25
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part ~= root then
                local relative = root.CFrame:ToObjectSpace(part.CFrame)
                local halfZ = 0.5 * (
                    math.abs(relative.RightVector.Z) * part.Size.X
                    + math.abs(relative.UpVector.Z) * part.Size.Y
                    + math.abs(relative.LookVector.Z) * part.Size.Z
                )
                highest = math.max(highest, -relative.Position.Z + halfZ)
            end
        end
        -- Extra clearance accommodates small animation-induced limb motion.
        return math.clamp(highest + 1.0, 1.6, 16)
    end

    local function restoreCollisions()
        for part, previous in pairs(state.ghostOriginal) do
            if part and part.Parent then
                pcall(function() part.CanCollide = previous end)
            end
        end
        table.clear(state.ghostOriginal)
        state.ghostCharacter = nil
    end

    setBelowGhost = function(enabled, character)
        if not enabled then
            if state.ghostCharacter then restoreCollisions() end
            return
        end
        if state.ghostCharacter ~= character then
            restoreCollisions()
            state.ghostCharacter = character
        end
        if not character or os.clock() - state.lastGhostCheck < 0.35 then return end
        state.lastGhostCheck = os.clock()
        -- Below can intersect the ground on the way underneath a target.
        -- Temporarily disable client-side body collisions to prevent bumps.
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if state.ghostOriginal[part] == nil then
                    state.ghostOriginal[part] = part.CanCollide
                end
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end

    local function releaseHumanoid()
        restoreCollisions()
        if state.humanoid and state.humanoid.Parent
            and state.oldAutoRotate ~= nil then
            pcall(function() state.humanoid.AutoRotate = state.oldAutoRotate end)
        end
        state.humanoid, state.oldAutoRotate, state.root = nil, nil, nil
    end
    -- Character-only approach. No platform is carried along.
    -- Crucially, keep the local root unanchored during movement: the server
    -- can otherwise still see an old position and reject taming as TooFar.
    -- The player's chosen Farm Distance is never modified.
    local function endSpiritApproachAnchor()
        local root = state.spiritApproachRoot
        if root and root.Parent and state.spiritApproachOldAnchor ~= nil then
            root.Anchored = state.spiritApproachOldAnchor
        end
        state.spiritApproachRoot = nil
        state.spiritApproachOldAnchor = nil
        state.spiritApproachDirection = nil
        state.spiritApproachRotation = nil
        state.spiritApproachMode = nil
    end

    -- V47: Match the selected farm position while approaching a spirit.
    -- A fixed horizontal heading supplies the roll for vertical looking;
    -- recomputing lookAt's up vector each Heartbeat caused spinning.
    local function prepareSpiritApproach(root, position)
        if not root or not position then return end
        if state.spiritApproachRoot ~= root then
            endSpiritApproachAnchor()
            state.spiritApproachRoot = root
            state.spiritApproachOldAnchor = root.Anchored
            root.Anchored = false
        end
        if state.spiritApproachMode ~= farmPosition
            or not state.spiritApproachDirection
            or not state.spiritApproachRotation then
            state.spiritApproachMode = farmPosition
            local diff = root.Position - position
            local heading = safeHorizontal(state.lastAttackHeading,
                Vector3.new(0, 0, -1))
            if farmPosition == "Below" then
                state.spiritApproachDirection = -Y
                state.spiritApproachRotation = CFrame.lookAt(
                    Vector3.zero, Y, heading).Rotation
            elseif farmPosition == "Above" then
                state.spiritApproachDirection = Y
                state.spiritApproachRotation = CFrame.lookAt(
                    Vector3.zero, -Y, heading).Rotation
            else
                local outward = safeHorizontal(diff, -heading)
                state.spiritApproachDirection = outward
                state.spiritApproachRotation = CFrame.lookAt(
                    Vector3.zero, -outward, Y).Rotation
            end
        end
    end

    farmMover.ApproachSpirit = function(id, position)
        if id == nil or typeof(position) ~= "Vector3" or not running then return end
        if state.spiritFocusId ~= id then
            -- Idle platform remains available for respawn downtime only.
            -- No platform follows the player during taming or releasing.
            clearPlatform()
            endSpiritApproachAnchor()
            state.target = nil
            state.filteredGoal = nil
            state.filteredHeading = nil
            state.spiritFocusId = id
            state.spiritPosition = position
            local _, root = characterParts()
            if farmMethod ~= "Legit" and root then
                prepareSpiritApproach(root, position)
            end
        else
            state.spiritPosition = position
        end
        state.spiritLastOrder = os.clock()
    end
    farmMover.EndSpiritFocus = function()
        endSpiritApproachAnchor()
        state.spiritFocusId = nil
        state.spiritPosition = nil
        state.spiritLastOrder = 0
    end

    farmMover.Stop = function(returnSurface)
        local shouldReturn = (returnSurface == true)
            and (state.hadDriven or state.holding or state.wasBelow)
        local _, root = characterParts()
        local wasHeld = state.holding
        -- Restore any spirit-approach anchor, then normal idle support.
        endSpiritApproachAnchor()
        clearPlatform()
        if shouldReturn and root then
            local returned = returnToGround()
            if not returned and state.wasBelow then
                -- No verified floor: remain anchored instead of falling into void.
                root.Anchored = true
                warn("[Tame V24] No safe ground found; character held in place")
            end
        end
        state.target = nil
        state.spiritFocusId = nil
        state.spiritPosition = nil
        state.lastOrder = 0
        state.filteredGoal = nil
        state.filteredHeading = nil
        state.snappedToTarget = false
        state.hadDriven = false
        state.wasBelow = false
        state.floorY = nil
        state.referenceMobY = nil
        if shouldReturn then state.safeSurfaceCF = nil end
        Aux.belowFarmStatus = "Inactive"
        releaseHumanoid()
    end
    farmMover.SetTarget = function(info)
        if not info or not info.model or not running then return end
        -- Normal farming has resumed: return to the saved farmDistance.
        if state.spiritFocusId then farmMover.EndSpiritFocus() end
        if state.target ~= info.model then
            clearPlatform() -- respawned enemy: remove support and resume following
            state.target = info.model
            state.filteredGoal = nil
            state.filteredHeading = nil
            state.snappedToTarget = false

            -- Calculate the mob's bounding extent ONCE on acquisition.
            -- Tracking animated LeftFoot/RightFoot each frame made Below bob.
            local okay, bounds, size = pcall(function()
                return info.model:GetBoundingBox()
            end)
            if okay and bounds and size then
                state.topOffset = bounds.Position.Y + size.Y * 0.5 - info.pos.Y
                state.bottomOffset = bounds.Position.Y - size.Y * 0.5 - info.pos.Y
            else
                state.topOffset, state.bottomOffset = 3, -3
            end
            local character = Player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            state.avatarUpExtent = avatarClearance(character, root)
            state.floorChecked = 0 -- recompute terrain for each mob
            state.referenceMobY = info.pos.Y
            if not state.safeSurfaceCF then farmMover.CaptureSurface() end
        end
        state.lastOrder = os.clock()
    end
    farmMover.AttackDirection = function(info, root)
        local relative = info.pos - root.Position
        local flat = Vector3.new(relative.X, 0, relative.Z)
        if flat.Magnitude > 0.02 then
            state.lastAttackHeading = flat.Unit
            return flat.Unit
        end
        -- The attack remote uses a horizontal Vector3 even when we look up.
        local targetFacing = info.cf and info.cf.LookVector or state.lastAttackHeading
        state.lastAttackHeading = safeHorizontal(targetFacing, state.lastAttackHeading)
        return state.lastAttackHeading
    end
    local function aimGoal(pos, cf)
        local direction = safeHorizontal(cf.LookVector,
            state.filteredHeading or state.lastAttackHeading)
        if farmPosition == "Above" then
            local anchor = Vector3.new(pos.X, pos.Y + state.topOffset, pos.Z)
            return anchor + Y * farmDistance, -Y, direction
        elseif farmPosition == "Below" then
            local undersideY = pos.Y + state.bottomOffset
            local playerRootY = undersideY - farmDistance - state.avatarUpExtent
            -- Keep the entire sideways rig BELOW the terrain surface,
            -- even for small mobs / shallow Farm Distance settings.
            local now = os.clock()
            if not state.floorLocation or now - state.floorChecked > 0.6
                or (pos - state.floorLocation).Magnitude > 7 then
                state.floorY = findSurface(pos, pos.Y) or state.floorY
                state.floorChecked = now
                state.floorLocation = pos
            end
            if state.floorY then
                playerRootY = math.min(playerRootY,
                    state.floorY - farmDistance - state.avatarUpExtent - 1.0)
            end
            local anchor = Vector3.new(pos.X, playerRootY, pos.Z)
            return anchor, Y, direction
        end
        local planarFacing = safeHorizontal(cf.LookVector, direction)
        return pos - planarFacing * farmDistance,
            safeHorizontal(planarFacing, direction), Y
    end
    farmMover.GoalFor = function(info)
        if not info or not info.pos or not info.model then return nil end
        if state.target ~= info.model then farmMover.SetTarget(info) end
        local pos = info.pos
        local cf = info.cf or CFrame.new(pos)
        return (aimGoal(pos, cf))
    end

    table.insert(listeners, RunService.Heartbeat:Connect(function(dt)
        if not running then return end
        -- V34: Character-only smooth spirit approach with an UNANCHORED root
        -- so the server can observe position changes for its range checks.
        -- Never point LookVector straight up/down or interpolate target pitch:
        -- one fixed upright rotation prevents the prior spin/flipping.
        if state.spiritFocusId then
            if os.clock() - state.spiritLastOrder > 0.75 then
                farmMover.EndSpiritFocus()
                return
            end
            local character, root, humanoid = characterParts()
            local spiritPos = state.spiritPosition
            if not root or not humanoid or not spiritPos then return end
            dt = math.clamp(dt or 1/60, 1/240, 0.1)
            if state.holding or state.idlePlatform then
                clearPlatform() -- no platform during approach
            end
            if state.humanoid ~= humanoid then
                releaseHumanoid()
                state.humanoid = humanoid
                state.oldAutoRotate = humanoid.AutoRotate
                state.root = root
            end
            humanoid.AutoRotate = false
            -- The spirit approach respects Farm Position and Farm Method,
            -- independently of the saved Mob Farm Distance.
            prepareSpiritApproach(root, spiritPos)
            local away = state.spiritApproachDirection or -Y
            local approachRange = priority.forceClose
                and math.min(APPROACH_RANGE, 1.5) or APPROACH_RANGE
            local destination = spiritPos + away * approachRange
            if farmMethod == "Legit" then
                endSpiritApproachAnchor()
                setBelowGhost(false, character)
                -- Legit is pathfinding/walking, so no underground flying pose.
                local horizontalDiff = root.Position - spiritPos
                local horizontalAway = safeHorizontal(horizontalDiff,
                    Vector3.new(0, 0, -1))
                local walkingDestination = Vector3.new(
                    spiritPos.X + horizontalAway.X * approachRange,
                    root.Position.Y,
                    spiritPos.Z + horizontalAway.Z * approachRange)
                if os.clock() - (state.lastLegitSpiritMove or 0) > 0.24 then
                    state.lastLegitSpiritMove = os.clock()
                    humanoid:MoveTo(walkingDestination)
                end
                return
            end
            setBelowGhost(farmPosition == "Below", character)
            local newPosition
            local rotation
            if farmMethod == "Teleport" then
                -- No Tween interpolation in Teleport mode, including Below.
                newPosition = destination
                rotation = state.spiritApproachRotation
            else
                local alpha = 1 - math.exp(-dt * 10)
                local delta = destination - root.Position
                local movement = delta * alpha
                -- Use the Combat Tween Speed setting during tame approach.
                local maxMove = farmTweenSpeed * dt
                if movement.Magnitude > maxMove then
                    movement = movement.Unit * maxMove
                end
                newPosition = root.Position + movement
                if delta.Magnitude < 0.03 then newPosition = destination end
                rotation = root.CFrame.Rotation:Lerp(
                    state.spiritApproachRotation,
                    1 - math.exp(-dt * 15))
            end
            root.CFrame = CFrame.new(newPosition) * rotation
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            Aux.belowFarmStatus = string.format(
                "Smooth spirit approach: %.1f -> %.0f studs (farm %d)",
                (newPosition - spiritPos).Magnitude, approachRange, farmDistance)
            return
        end
        if not state.target then return end
        if farmMethod == "Legit" then
            farmMover.Stop(true)
            return
        end
        if os.clock() - state.lastOrder > 1.0 then
            farmMover.Hold()
            return
        end
        local character = Player.Character
        local root = getRoot()
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then
            farmMover.Stop()
            return
        end
        if not state.target:IsDescendantOf(Workspace) then
            farmMover.Hold()
            return
        end
        local mobHum = state.target:FindFirstChildOfClass("Humanoid")
        if (mobHum and mobHum.Health <= 0)
            or (tonumber(state.target:GetAttribute("Health")) or 1) <= 0 then
            farmMover.Hold()
            return
        end
        local pos, cf = getInstancePosition(state.target)
        if not pos or not cf then farmMover.Hold() return end
        if state.humanoid ~= humanoid then
            releaseHumanoid()
            state.humanoid = humanoid
            state.oldAutoRotate = humanoid.AutoRotate
            state.root = root
            state.avatarUpExtent = avatarClearance(character, root)
        end
        humanoid.AutoRotate = false
        setBelowGhost(farmPosition == "Below", character)
        local goal, lookDirection, upHint = aimGoal(pos, cf)
        dt = math.clamp(dt or 1/60, 1/240, 0.10)
        local position, endCF
        if farmMethod == "Teleport" then
            -- Teleport never interpolates either target or character position.
            -- Works equally for Above, Behind, and Below, including moving mobs.
            state.filteredGoal = goal
            state.filteredHeading = nil
            position = goal
            endCF = CFrame.lookAt(goal, goal + lookDirection, upHint)
            state.wasBelow = farmPosition == "Below"
            state.snappedToTarget = true
        else
            -- Tween smooths a moving target each Heartbeat; speed slider caps
            -- the distance traveled per second without restarting tweens.
            local targetAlpha = 1 - math.exp(-dt * 14)
            state.filteredGoal = state.filteredGoal
                and state.filteredGoal:Lerp(goal, targetAlpha) or goal
            if farmPosition == "Above" or farmPosition == "Below" then
                state.filteredHeading = state.filteredHeading
                    and safeHorizontal(state.filteredHeading:Lerp(upHint, targetAlpha), upHint)
                    or upHint
                upHint = state.filteredHeading
            end
            endCF = CFrame.lookAt(state.filteredGoal,
                state.filteredGoal + lookDirection, upHint)
            local currentPos = root.Position
            local distance = (state.filteredGoal - currentPos).Magnitude
            if farmPosition == "Below" and not state.wasBelow then
                -- Preserve the original first acquisition beneath the ground.
                position = state.filteredGoal
                state.snappedToTarget = true
                state.wasBelow = true
            else
                local follow = 1 - math.exp(-dt * 11)
                local step = (state.filteredGoal - currentPos) * follow
                local maxStep = farmTweenSpeed * dt
                if step.Magnitude > maxStep then step = step.Unit * maxStep end
                position = currentPos + step
                if distance < 0.055 then position = state.filteredGoal end
            end
        end
        if farmPosition == "Below" and state.floorY then
            position = Vector3.new(position.X,
                math.min(position.Y,
                    state.floorY - state.avatarUpExtent - 1.0), position.Z)
        end
        state.hadDriven = true
        local rotation = farmMethod == "Teleport" and endCF.Rotation
            or root.CFrame.Rotation:Lerp(endCF.Rotation,
                1 - math.exp(-dt * 15))
        root.CFrame = CFrame.new(position) * rotation
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        if farmPosition == "Below" then
            local trueGap = (pos.Y + state.bottomOffset)
                - (root.Position.Y + state.avatarUpExtent)
            Aux.belowFarmStatus = string.format("Below: %.1f / %d stud gap",
                trueGap, farmDistance)
        else
            Aux.belowFarmStatus = "Inactive"
        end
    end))
end

-- Optional navigation reference after a room is reported cleared.
-- RoomEndN is a real Part in D1; reaching it is NOT proven to trigger a room.
local function advanceToNextRoom(root)
    roomAdvanceGoal = "--"
    if not autoDungeonAdvance or not dungeonRun or dungeonRun.Phase ~= "Rooms" then
        return false
    end
    local room = tonumber(dungeonRun.Room)
    local total = tonumber(dungeonRun.Rooms)
    local alive = tonumber(dungeonRun.Alive)
    if not room or not total or room >= total or alive ~= 0 then return false end
    local _, layout = currentDungeonId()
    local part = layout and layout:FindFirstChild("RoomEnd" .. tostring(room))
    if not part or not part:IsA("BasePart") then
        dungeonFarmStatus = "Room cleared; RoomEnd marker not loaded"
        return false
    end
    roomAdvanceGoal = "RoomEnd" .. tostring(room)
    dungeonFarmStatus = "Advancing to " .. roomAdvanceGoal
    navigateTo(part.Position + Vector3.new(0, 2, 0), part.Position,
        farmMethod, farmMethod == "Legit" and 3.5 or 2.5)
    return true
end

local function updateDungeonFarm()
    dungeonFarmIsDrivingAttacks = (autoDungeonFarm and isDungeonPlace())
        or (Aux.autoMobFarm and not isDungeonPlace())
    Aux.dungeonFarmEnabled = autoDungeonFarm and isDungeonPlace()
    if not autoDungeonFarm then return end
    if activeTargetModel and Aux.noteFarmKill then
        Aux.noteFarmKill(activeTargetModel, Aux.dungeonFarmTargetLastPos)
    end
    if Aux.spiritPriorityActive then
        dungeonFarmStatus = "PAUSED: " .. Aux.spiritPriorityStatus
        dungeonTargetName = "Spirit interaction"
        if not priority.focusId and farmMover.Hold then farmMover.Hold() end
        return
    end
    if not isDungeonPlace() then
        dungeonTargetName = "None"
        dungeonEnemyCount = 0
        dungeonFarmStatus = "Waiting for dungeon place"
        return
    end
    local phase = activePhase()
    if phase == "Cleared" or phase == "Failed" then
        if farmMover.Hold then farmMover.Hold() end
        dungeonFarmStatus = "Stopped: " .. phase
        dungeonTargetName = "None"
        dungeonTargetHP = "--"
        dungeonEnemyCount = 0
        activeTargetModel = nil
        Aux.commandDungeonTarget = nil
        roomAdvanceGoal = "--"
        cancelDungeonTween()
        currentMovementGoal = nil
        return
    end
    if phase == "Waiting" then
        if farmMover.Hold then farmMover.Hold() end
        dungeonFarmStatus = "Waiting for run start"
        dungeonTargetName = "None"
        cancelDungeonTween()
        currentMovementGoal = nil
        return
    end

    local root = getRoot()
    if not root then
        dungeonFarmStatus = "Waiting for character"
        return
    end
    local roomKey = currentRoomKey()
    if lastFarmRoomKey ~= roomKey then
        lastFarmRoomKey = roomKey
        activeTargetModel = nil
        dungeonMovementToken += 1
        cancelDungeonTween()
        currentMovementGoal = nil
        nextMovementAction = 0
        nextLegitRepath = 0
        lastDungeonScan = 0
        movementLastProgressAt = os.clock()
        movementLastPosition = root.Position
    end

    local candidates = scanDungeonEnemies()
    dungeonEnemyCount = #candidates
    local selected, bestDist = nil, math.huge
    local lockedTarget = nil
    local bossPhase = phase == "Boss"
    local hasBoss = false
    for _, enemy in ipairs(candidates) do
        if enemy.isBoss then hasBoss = true end
    end
    for _, enemy in ipairs(candidates) do
        if not (bossPhase and hasBoss and not enemy.isBoss) then
            local d = (root.Position - enemy.pos).Magnitude
            if d < bestDist then selected, bestDist = enemy, d end
            if enemy.model == activeTargetModel then lockedTarget = enemy end
        end
    end
    -- Keep a living target unless it moves very far out of reach;
    -- avoids jumping back and forth between two nearby animals.
    if lockedTarget and (root.Position - lockedTarget.pos).Magnitude <= 85 then
        selected = lockedTarget
    end

    if not selected then
        dungeonTargetName = "None"
        dungeonTargetHP = "--"
        activeTargetModel = nil
        Aux.commandDungeonTarget = nil
        -- Room navigation requires the character to be unanchored.
        if autoDungeonAdvance and dungeonRun and tonumber(dungeonRun.Alive) == 0 then
            if farmMover.Stop then farmMover.Stop(true) end
            if advanceToNextRoom(root) then return end
        end
        if farmMover.Hold then farmMover.Hold() end
        cancelDungeonTween()
        currentMovementGoal = nil
        if phase == "Rooms" and dungeonRun and tonumber(dungeonRun.Alive) == 0 then
            dungeonFarmStatus = "Room clear; awaiting next room"
        elseif phase == "Boss" then
            dungeonFarmStatus = "Waiting for boss to spawn/stream"
        else
            dungeonFarmStatus = "Waiting for room enemies to spawn/stream"
        end
        return
    end

    roomAdvanceGoal = "--"
    Aux.commandDungeonTarget = selected.model
    if activeTargetModel ~= selected.model then
        activeTargetModel = selected.model
        dungeonMovementToken += 1
        nextMovementAction = 0
        nextLegitRepath = 0
        movementLastPosition = root.Position
        movementLastProgressAt = os.clock()
        cancelDungeonTween()
        currentMovementGoal = nil
    end
    local model = selected.model
    Aux.dungeonFarmTargetLastPos = selected.pos
    dungeonTargetName = tostring(model:GetAttribute("Species") or model.Name)
    dungeonTargetHP = selected.hp and tostring(math.floor(selected.hp + 0.5)) or "Unknown"
    dungeonBossName = tostring(dungeonRun and dungeonRun.BossName or "--")
    local goal = targetPosition(selected)
    local distanceToGoal = (root.Position - goal).Magnitude
    local now = os.clock()

    if movementLastPosition == nil then
        movementLastPosition = root.Position
        movementLastProgressAt = now
    elseif (root.Position - movementLastPosition).Magnitude > 1.8 then
        movementLastPosition = root.Position
        movementLastProgressAt = now
    elseif distanceToGoal > 7 and now - movementLastProgressAt >= 3.0 then
        -- A simple soft recovery. Do not teleport unexpectedly or change methods.
        movementStallCount += 1
        movementLastProgressAt = now
        currentMovementGoal = nil
        nextMovementAction = 0
        nextLegitRepath = 0
        dungeonMovementToken += 1
        cancelDungeonTween()
    end
    dungeonFarmStatus = bossPhase and "Boss combat" or "Farming room enemies"
    if farmMethod == "Legit" then
        if farmMover.Stop then farmMover.Stop() end
        navigateTo(goal, selected.pos, "Legit", 4)
    else
        cancelDungeonTween() -- single Heartbeat is the sole farm movement writer
        farmMover.SetTarget(selected)
    end

    -- Attack only while targeting a live dungeon enemy and in range.
    if now - lastDungeonAttack >= getWeaponInterval() then
        root = getRoot()
        if root and (root.Position - selected.pos).Magnitude <= 18 then
            local dir = farmMover.AttackDirection(selected, root)
            if dir then
                if now - lastDungeonAttack > (Progression.ComboResetTime or 1.1) then
                    dungeonAttackCombo = 0
                end
                local comboCount = #Progression.ComboMultipliers
                dungeonAttackCombo = comboCount > 0 and (dungeonAttackCombo % comboCount + 1) or 1
                AttackRemote:FireServer(dungeonAttackCombo, dir)
                lastDungeonAttack = now
            end
        end
    end
end

local function updateDungeonJoin()
    Aux.pauseMobFarmForDungeon = false
    if Aux.rankApproachActive then
        dungeonWorkflow = "Auto Join waiting for rank-up interaction"
        return
    end
    if not autoDungeonJoin or isDungeonPlace() or Aux.travelBusy then return end
    local lobbyPortal = dungeonLobby and dungeonLobby.Portal
    if lobbyPortal and matchesDungeon(lobbyPortal) then
        Aux.pauseMobFarmForDungeon = true
        portalPromptStatus = "Lobby open"
        if dungeonLobby.MyParty then
            if dungeonLobby.IsLeader then
                if os.clock() >= nextJoinAction then
                    DungeonActionRemote:FireServer("Start")
                    if hideAutoJoinUI and ClientState.OpenMenuName == "Dungeon" then
                        pcall(function() ClientState.CloseMenus:Fire() end)
                    end
                    nextJoinAction = os.clock() + 6
                    dungeonWorkflow = "Starting existing party"
                end
            else
                dungeonWorkflow = "Waiting for party leader"
            end
        elseif dungeonLobby.CanEnter then
            if os.clock() >= nextJoinAction then
                DungeonActionRemote:FireServer("Solo")
                if hideAutoJoinUI and ClientState.OpenMenuName == "Dungeon" then
                    pcall(function() ClientState.CloseMenus:Fire() end)
                end
                nextJoinAction = os.clock() + 6
                dungeonWorkflow = "Solo join requested; awaiting transfer"
            end
        else
            dungeonWorkflow = "Portal lobby: " .. tostring(dungeonLobby.Reason or "not eligible yet")
        end
        return
    end

    -- V13 only approached the portal. It never activated the E prompt.
    local portal, _, total, matching = bestPortal()
    if not portal then
        dungeonWorkflow = total == 0 and "Waiting for portal event/spawn"
            or "No portal matches selected map and rank"
        return
    end
    Aux.pauseMobFarmForDungeon = true
    local root = getRoot()
    if not root then return end
    local prompt = findDungeonPrompt(portal)
    if not prompt then
        dungeonWorkflow = "Matching portal found, but its DungeonPrompt is not loaded"
        portalPromptStatus = "Prompt missing or disabled"
        return
    end
    local pos = promptPosition(prompt)
    if not pos then
        dungeonWorkflow = "Portal prompt position unavailable"
        portalPromptStatus = "Position unavailable"
        return
    end

    -- Prompt MaxActivationDistance can be MUCH less than DungeonConfig.PortalRange.
    local dist = (root.Position - pos).Magnitude
    local maxRange = math.max(3, tonumber(prompt.MaxActivationDistance) or 10)
    local activationRange = math.max(2.5, maxRange - 1.8)
    if dist > activationRange then
        local away = root.Position - pos
        away = Vector3.new(away.X, 0, away.Z)
        away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
        local goal = pos + away * math.max(1.8, activationRange - 2)
            + Vector3.new(0, 1.5, 0)
        dungeonWorkflow = string.format("Approaching DungeonPrompt (%.1f studs)", dist)
        portalPromptStatus = string.format("Approaching: %.1f/%.1f studs", dist, activationRange)
        navigateTo(goal, pos, farmMethod, 2.5)
        return
    end

    dungeonWorkflow = "Within E-prompt range; requesting portal lobby"
    if not portalPromptBusy and os.clock() >= nextPortalPromptAttempt then
        nextPortalPromptAttempt = os.clock() + 3.5
        task.spawn(activateDungeonPrompt, prompt)
    end
end

getVisibleRunPhase = function()
    -- If this script was executed after the server's initial Run event,
    -- the game's own DungeonHUD may already show a finished run.
    local gui = Player:FindFirstChildOfClass("PlayerGui")
    local hud = gui and gui:FindFirstChild("DungeonHUD")
    local runHud = hud and hud:FindFirstChild("Run")
    if not runHud or not runHud.Visible then return nil end
    local objective = runHud:FindFirstChild("Objective")
    if not objective or not objective:IsA("TextLabel") then return nil end
    local message = string.upper(objective.Text)
    if string.find(message, "CLEARED!", 1, true) then return "Cleared" end
    if string.find(message, "OUT OF TIME", 1, true) then return "Failed" end
    return nil
end

local function hudReturnSeconds()
    local gui = Player:FindFirstChildOfClass("PlayerGui")
    local hud = gui and gui:FindFirstChild("DungeonHUD")
    local runHud = hud and hud:FindFirstChild("Run")
    local timer = runHud and runHud:FindFirstChild("Timer")
    if not timer or not timer:IsA("TextLabel") then return nil end
    local minutes, seconds = timer.Text:match("(%d+):(%d+)")
    if minutes and seconds then
        return tonumber(minutes) * 60 + tonumber(seconds)
    end
    return nil
end

local function updateDungeonExit()
    if not autoDungeonExit then return end
    if Aux.spiritPriorityActive then
        dungeonWorkflow = "Finishing spirit before dungeon exit"
        return
    end
    local phase = dungeonRun and tostring(dungeonRun.Phase or "") or ""
    if phase ~= "Cleared" and phase ~= "Failed" then
        phase = getVisibleRunPhase() or phase
    end
    if not isDungeonPlace() and not getVisibleRunPhase() then return end
    if phase ~= "Cleared" and phase ~= "Failed" then return end

    -- Instant is the default. Optional post-clear mode uses the actual
    -- EndsAt time, not an extra 25 seconds starting when the toggle is enabled.
    local now = os.clock()
    if exitMode == "After Taming" and phase == "Cleared" then
        local endsAt = dungeonRun and tonumber(dungeonRun.EndsAt)
        if endsAt and endsAt > serverNow() + 1.25 then
            exitReadyAt = now + (endsAt - serverNow()) - 1.0
            dungeonWorkflow = "Keeping dungeon open for spirit taming"
            return
        elseif not endsAt then
            -- If the Run event was missed, read the countdown already shown
            -- on-screen instead of restarting a 25-second delay.
            local remaining = hudReturnSeconds()
            if remaining then
                exitReadyAt = now + math.max(0, remaining - 1)
                if remaining > 1.25 then
                    dungeonWorkflow = "Waiting for HUD taming countdown"
                    return
                end
            else
                if not exitReadyAt then
                    exitReadyAt = now + (tonumber(DungeonConfig.TameSeconds) or 25)
                end
                if now < exitReadyAt then
                    dungeonWorkflow = "Waiting for spirit taming window"
                    return
                end
            end
        end
    end

    if now >= nextExitAction then
        DungeonActionRemote:FireServer("Leave")
        nextExitAction = now + 5
        exitRequestCount += 1
        dungeonWorkflow = "Leave requested (" .. phase .. ") #" .. tostring(exitRequestCount)
        print("[Tame V14 Dungeon] Requested Leave:", phase,
            "source:", dungeonRun and "Run event" or "DungeonHUD",
            "attempt:", exitRequestCount)
    end
end

