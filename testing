                            Loaded.LargeInteger.addCanonical
                        ) == "function"
                    then

                        local RewardXP =
                            tonumber(
                                ReadLeaf(Participant.xp)
                            ) or 0

                        local Awarded =
                            ReadLeaf(
                                Participant.xpAwarded
                            ) == true


                        if RewardXP > 0
                            and not Awarded
                            and XP ~= nil
                        then

                            local Success,
                                ProjectedXP =
                                pcall(
                                    Loaded.LargeInteger.addCanonical,
                                    tostring(XP),
                                    tostring(RewardXP)
                                )


                            if Success
                                and ProjectedXP
                            then
                                XP = ProjectedXP
                            end
                        end
                    end


                    if XP ~= nil
                        and Loaded.LevelProgression
                        and type(
                            Loaded.LevelProgression.getProgress
                        ) == "function"
                    then

                        local Success,
                            Progress =
                            pcall(
                                Loaded.LevelProgression.getProgress,
                                XP
                            )


                        if Success
                            and type(Progress) == "table"
                        then
                            Stats.Level =
                                Progress.level or "N/A"
                        end
                    end
                end


                local MatchStats =
                    Account.state.matchStats


                if MatchStats then
                    Stats.Played = tonumber(ReadLeaf(MatchStats.played)) or 0
                    Stats.Wins = tonumber(ReadLeaf(MatchStats.wins)) or 0
