-- Recover from game-side arena/portal teleports. Our flight controller writes
-- a position each Heartbeat; a large discrepancy means Roblox has moved us
-- externally (not an intended Tween step). Rebase spatial memory immediately,
-- just like a successful respawn does, without forcing the player to die.
S.rebaseSpatialState = function(root, now)
    S.lastSpatialRebase=now
    S.stallTarget=nil
    S.stallProbePosition=nil
    S.noTargetSince=nil
    S.lastMonsterReconcileAt=-HUGE
    S.lastScriptPosition=nil
    S.smoothPose=nil
    S.poseHeading=nil
    S.dodgeGoal=nil
    S.dodgeLastClear=nil
    S.dodgeHoldUntil=-HUGE
    S.dodgeResumeUntil=now
    resetTarget()
end
S.detectExternalArenaTeleport = function(root, now)
    if not S.autoFarm or S.farmMethod=="Legit" then return end
    local previous=S.lastScriptPosition
    if previous and (root.Position-previous).Magnitude > 45
        and now-S.lastSpatialRebase > 0.65 then
        S.rebaseSpatialState(root,now)
    end
end

-- No roof/floor-height recovery tick while Auto Farm is active. A live
-- enemy always wins over remembered elevations and obsolete safety poses.

-- One Heartbeat controls the timeline. Combat is checked first so a busy
-- hazard scan, grounded pathfinder, or pose update cannot postpone ready skills.
S.connections[#S.connections+1] = RunService.Heartbeat:Connect(function(dt)
    if not S.alive then return end
    if inLobby() then return end
    if not statsReady() then return end
    local now = os.clock()
    if game.PlaceId == 6990129309 then
        local ok,err=pcall(specialResultTick)
        if not ok then warnOnce(err) end
    end
    if S.autoRetry or S.autoLeaveMatches then
        local results = resultScreenVisible(now)
        resultsWorkflowTick(now, results)
    end
    if not (S.autoFarm or S.autoAttack or S.autoSkills or S.autoDodge) then return end
    local _, humanoid, root = getCharacter()
    if not root then return end
    if S.autoFarm then
        -- Rebase stale state after genuine game teleports, without blocking
        -- the next target or moving back to a previously saved arena floor.
        S.detectExternalArenaTeleport(root, now)
    end
    local showingResults = resultScreenVisible(now)
    local target = nil
    if not showingResults then
        target = findTarget(root)
        if target and not validTarget(target) then
            setTarget(nil)
            target = findTarget(root)
        end
    end

    if S.autoFarm and not showingResults then
        if target then
            S.noTargetSince = nil
            S.reconcileMonsterIndex(now, false)
        else
            S.noTargetSince = S.noTargetSince or now
            if now - S.noTargetSince >= 0.8 then
                S.reconcileMonsterIndex(now, true)
                target = findTarget(root)
                if target then S.noTargetSince = nil end
            end
            -- If the game has not replicated a live monster, avoid moving to
            -- decorative objective markers or inventing an enemy position.
            if not target and S.noTargetSince
                and now - S.noTargetSince >= 12
                and now - S.lastNoTargetDiagnosticAt >= 60 then
                S.lastNoTargetDiagnosticAt = now
                warnOnce("Auto Farm: no live monster rig is currently replicated; refreshing monster index while waiting for the next target")
            end
        end
    end

    if not showingResults then
        local ok, err = pcall(function()
            if S.autoAttack then
                if not S.autoFarm and target then faceFlat(root, target) end
                fireBasic(root, characterData(), now)
            end
            if S.autoSkills and target then
                if not S.autoFarm then faceFlat(root, target) end
                fireSkills(root, target, now)
            end
        end)
        if not ok then warnOnce(err) end
    end

    local dodging = false
    if S.autoDodge and not showingResults then
        local ok, result = pcall(dodgeTick, dt, root, humanoid, target, now)
        if ok then dodging = result == true else warnOnce(result) end
    end
    if S.autoFarm and showingResults then
        if S.oldCharacter then releaseMovement() end
    elseif not dodging and S.autoFarm and target then
        local moveTarget = S.target and validTarget(S.target) and S.target or target
        local ok, err = pcall(farmTick, dt, root, humanoid, moveTarget, now)
        if not ok then warnOnce(err) end
    elseif not dodging and S.autoFarm and S.oldCharacter then
        local ok, err = pcall(holdFarmPose, root, humanoid)
        if not ok then warnOnce(err) end
    end
end)

