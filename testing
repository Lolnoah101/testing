local function starIsAvailable(world)
    if not nativeController then return false end
    if nativeController.RemoteStar and nativeController.RemoteStarMap == world then
        return true
    end
    local star = nativeController.Star
    return nativeController.NearStar == true
        and star ~= nil
        and star.Parent ~= nil
        and star.Parent.Name == world
end

local function getMultiOpenCount(data)
    local count = 3
    if data.Gamepasses and data.Gamepasses["Extra Stars"] then
        count = count + 2
    end
    local sharedAchievements = nativeController and nativeController.Shared
        and nativeController.Shared.Achievements
    if type(data.Achievements) == "table" and type(sharedAchievements) == "table" then
        for achievement, achieved in pairs(data.Achievements) do
            local definition = achieved and sharedAchievements[achievement]
            if definition and type(definition.Perks) == "table" then
                for perk, amount in pairs(definition.Perks) do
                    if perk == "Extra Open" and type(amount) == "number" then
                        count = count + amount
                    end
                end
            end
        end
    end
    return count
end

-- Return a reason only for known limitations; otherwise let the server validate.
local function canOpenStar(world, amount)
    if not nativeController or not nativeController.ClientLoaded then
        return false
    end
    local data = nativeController.Data
    if type(data) ~= "table" then return false end
    if nativeController.Auto_Summon or
        (type(data.AntiAfk) == "table" and data.AntiAfk.Auto_Summon) then
        return false -- don't race the game's native auto-summon
    end
    if player:GetAttribute("Star_Opening") then return false end
    if not starIsAvailable(world) then return false end
    local count = amount == "Open 1" and 1 or getMultiOpenCount(data)
    if type(data.Shadows) == "table" then
        local owned = 0
        for _ in pairs(data.Shadows) do owned = owned + 1 end
        if owned + count > getInventoryCapacity(data) then return false end
    end
    local definition = starDefinitions[world]
    local price = definition and tonumber(definition.Price)
    local coins = tonumber(data.Coins)
    if price and coins and coins < price * count then
        return false
    end
    return true
end

-- Send one request at a time. The game uses Star_Opening to gate summons;
