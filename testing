local function doStaminaRace()
    X.Status = "Stage 1: Following instructor"
    checkGetUpPrompt()
    local start = workspace:GetAttribute("InstructorStart")
    local dir = workspace:GetAttribute("InstructorDir")
    local len = workspace:GetAttribute("InstructorLength")
    local v0 = workspace:GetAttribute("InstructorV0")
    local v1 = workspace:GetAttribute("InstructorV1")
    local time0 = workspace:GetAttribute("InstructorStartTime")
    if typeof(start) ~= "Vector3" or typeof(dir) ~= "Vector3" or dir.Magnitude<.01 or type(len) ~= "number" or len < 1 then
        X.Status = "Waiting for instructor route";return
    end
    if type(v0) ~= "number" or type(v1) ~= "number" or type(time0) ~= "number" then return end
    local t = math.max(0, workspace:GetServerTimeNow() - time0)
    local acceleration = (v1-v0)/len
    local s = acceleration <= 0 and (v0*t) or (v0/acceleration * (math.exp(math.min(acceleration*t, 12)) - 1))
    s = math.clamp(s, 0, len)
    local allowed=tonumber(workspace:GetAttribute("InstructorRange")) or 40
    local follow = start + dir.Unit * math.max(0, s - math.clamp(allowed*.22,3,9))
    local root = rootHum()
    if root then
        local here = Vector3.new(follow.X, root.Position.Y, follow.Z)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {LocalPlayer.Character}
        params.RespectCanCollide=true
        local hit = workspace:Raycast(here + Vector3.new(0,45,0), Vector3.new(0,-120,0), params)
        if hit then here = Vector3.new(here.X, hit.Position.Y+3, here.Z) end
        -- Follow the actual instructor; don't skip to the finish and trigger "too far ahead".
        moveNear(here, 3, 67)
    end
end
