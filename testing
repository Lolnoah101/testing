-- Keep the SAME Rayfield storage format, but perform a single Load AFTER all
-- tabs are built, then save on changed live flags.  No external JSON backup.
local function saveSettingsNowNative()
    local ok, saved = pcall(function() return window:Save() end)
    local pathOK, folder, path = pcall(function() return window:GetPath() end)
    local diskOK, data = false, nil
    if pathOK and type(path) == "string" and type(readfile) == "function" then
        diskOK, data = pcall(readfile, path)
    end
    local verified = ok and saved == true and diskOK
        and type(data) == "string" and #data > 0
    local message = string.format(
        "Save=%s | disk verified=%s | path=%s | readfile=%s | writefile=%s",
        tostring(ok and saved), tostring(verified), tostring(path),
        tostring(type(readfile) == "function"),
        tostring(type(writefile) == "function")
    )
    print("[Paraiso Save] " .. message)
    state.LastSaveStatus = message
    return verified, message
end
