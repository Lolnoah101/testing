            local ok,detail=contactCrate(crate)
            if not ok then
                W.crateFailedCount=W.crateFailedCount+1
                if os.clock()-W.crateWarningAt>5 then
                    W.crateWarningAt=os.clock();log("Crate contact pending: "..tostring(detail))
                end
                return true
            end
            for i=1,8 do
                if not crate.Parent or Farm.unloaded then break end
                if crate:GetAttribute("Occupied")~=nil then break end
                if W.inWorkflow and W.continueWindow and not W.continueWindow() then break end
                task.wait(0.06)
            end
            -- The pickup can take another replication tick. Don't attempt
            -- Equipment/Crate while Occupied is still absent.
            if not crate.Parent or crate:GetAttribute("Occupied")==nil then
                if os.clock()-W.crateWarningAt>5 then
                    W.crateWarningAt=os.clock()
                    log("Crate contact #"..W.crateContactAttempts
                        .." attempted; Occupied still missing. "..tostring(detail))
                end
                return true
            end
            W.crateState="Pickup confirmed: Occupied="..tostring(crate:GetAttribute("Occupied"))
            log("Crate pickup detected; taking it to Skills zone")
        end
        if W.inWorkflow and W.continueWindow and not W.continueWindow() then
            return true
        end
        -- Do not depart for the Skills zone if blades broke during contact.
        -- The next worker pass will finish the same owned crate after recovery.
        if type(Farm.bladeNeedsRecovery)=="function" and Farm.bladeNeedsRecovery() then
            W.crateState="Crate held for blade recovery before Skills turn-in"
            return false
        end
        -- A confirmed Occupied crate is ready to turn in. No second contact
        -- is needed; go to the game-native claim zone and verify the result.
        local skill=crate:GetAttribute("Skill")
        local claimed,detail=visitZone("Skills",function()
            local latest,latestState=getCurrentCrate()
            if not latest or latest:GetAttribute("Occupied")==nil then
                return false,"Crate changed after pickup ("..tostring(latestState)..")"
            end
            if W.crateSuccessfulInstances[latest] then
                return false,"This crate instance was already claimed"
            end
            local bridge=W.actionBridge and W.actionBridge("waves")
            local nativeReason=nil
            if bridge then
                local callOK,accepted,reason,capacity=pcall(function()
                    return bridge:Invoke("crate_native")
                end)
                if callOK and accepted==true and type(capacity)=="number" then
                    W.capacity=capacity
                    W.crateSuccessfulInstances[latest]=true
                    return true,"Skill crate CLAIMED via native action: "..tostring(skill or latest:GetAttribute("Skill"))
                end
                nativeReason=callOK and tostring(reason) or tostring(accepted)
                -- No duplicate request while the native action is awaiting its reply.
                if nativeReason:find("awaiting inventory",1,true) then
                    return false,"Native crate action pending inventory confirmation"
                end
                if nativeReason:find("busy",1,true) then
                    return false,"Native Host busy; will retry"
                end
            end
            local ok,capacity,skills=invoke("Equipment","Crate")
            if ok and type(capacity)=="number" and type(skills)=="table" then
                W.capacity=capacity
                W.crateSuccessfulInstances[latest]=true
                return true,"Skill crate CLAIMED via Equipment/Crate (capacity="..capacity..")"
            end
            return false,"Turn-in rejected: "..tostring(capacity)
                .."; skills="..typeof(skills).."; native="..tostring(nativeReason)
        end)
        if claimed then
            W.crateClaimCount=W.crateClaimCount+1
            log(detail.." | successful claims="..W.crateClaimCount)
            observeCurrentCrate()
        else
            W.crateFailedCount=W.crateFailedCount+1
            if os.clock()-W.crateWarningAt>2.5 then
                W.crateWarningAt=os.clock()
                log("Crate turn-in #"..W.crateFailedCount.." pending: "..tostring(detail))
            end
        end
        return true
    end
    local function canSpend(cost)
        if type(cost)~="number" or cost<0 then return false end
        return type(W.gold)~="number" or W.gold>=cost
    end
    local function marketTask(category)
        if not W.market[category] or os.clock()-(W.lastMarket[category] or 0)<3 then return false end
        local item=marketItem(category)
        if not item or not item.Parent then return false end
        local stock=tonumber(item:GetAttribute("Stock")) or 0
        local price=tonumber(item:GetAttribute("Price"))
        if stock<=0 or not canSpend(price) then return false end
        if W.capacity and W.capacity>=1000 then return false end
        W.lastMarket[category]=os.clock()
        local ok,accepted,granted=invoke("Waves","Item","Buy",category,item:GetAttribute("ID"),1)
        if ok and accepted==true then
            if type(W.gold)=="number" then W.gold=math.max(W.gold-price,0) end
            if type(W.capacity)=="number" then W.capacity=W.capacity+1 end
            log("Bought "..category..": "..(item:IsA("ValueBase") and tostring(item.Value) or item.Name))
        else log("Buy "..category.." rejected / not enough stock or Gold") end
        return true
    end
    -- Base upgrade priority: Refills -> Revive -> Replenish, then alternate
    -- Regen/Max. Advance across these four priority slots after a request so
    -- endlessly affordable Refills never permanently starves the others.
    -- The multi-select dropdown is an allow-list; unselected upgrades are skipped.
    local function baseTask()
        if not W.flags.base or (Farm.utilityBusy and not W.inWorkflow)
            or os.clock()-W.lastBase<0.42 then return false end
        local f=folder();local upgrades=f and f:FindFirstChild("Upgrades")
        local chosen=selections(W.pick.Base)
        if not upgrades or #chosen==0 then return false end
        local function eligible(name)
            if not table.find(chosen,name) then return nil end
            local candidate=upgrades:FindFirstChild(name)
            local cost=candidate and tonumber(candidate:GetAttribute("Cost"))
            if not candidate or not canSpend(cost) then return nil end
            if name=="Replenish" then
                local objective=waveObjective()
                local health=objective and objective:FindFirstChild("Health")
                if health and health:IsA("ValueBase") then
                    local maximum=tonumber(health:GetAttribute("Max_Health"))
                    if maximum and health.Value>=maximum-0.01 then return nil end
                end
            elseif name=="Revive" then
                local someoneDown=false
                for _,player in ipairs(Players:GetPlayers()) do
                    if player:GetAttribute("Dead") then someoneDown=true;break end
                end
                if not someoneDown then return nil end
            end
            return candidate
        end
        local chosenItem,chosenPriority
        local first=math.clamp(W.basePriorityPosition or 1,1,4)
        for offset=0,3 do
            local position=(first+offset-1)%4+1
            if position<4 then
                local primary=({"Refills","Revive","Replenish"})[position]
                local candidate=eligible(primary)
                if candidate then chosenItem=candidate;chosenPriority=position;break end
            else
                local secondary=W.baseLastSecondary=="Regen"
                    and {"Max","Regen"} or {"Regen","Max"}
                for _,name in ipairs(secondary) do
                    local candidate=eligible(name)
                    if candidate then chosenItem=candidate;chosenPriority=4;break end
                end
                if chosenItem then break end
            end
        end
        if not chosenItem then return false end
        local item=chosenItem
        -- Advance even after a failed request so other selected upgrades
        -- still get time during short wave breaks.
        W.basePriorityPosition=chosenPriority%4+1
        if chosenPriority==4 then W.baseLastSecondary=item.Name end
        W.lastBase=os.clock()
        local beforeCost,beforeValue=item:GetAttribute("Cost"),
            item:IsA("ValueBase") and item.Value or nil
        local worked,detail=visitZone("Upgrade",function()
            local ok,response=invoke("Waves","Upgrade",{item.Name})
            if not ok or response==false then
                return false,"Base upgrade rejected: "..item.Name.." / "..tostring(response)
            end
            task.wait(0.12)
            local changed=item:GetAttribute("Cost")~=beforeCost
                or (beforeValue~=nil and item.Value~=beforeValue)
            if changed and type(W.gold)=="number" and type(beforeCost)=="number" then
                W.gold=math.max(0,W.gold-beforeCost)
            end
            return true,changed and ("Base upgraded: "..item.Name)
                or ("Base upgrade requested at Cole: "..item.Name.." (awaiting replication)")
        end)
        log(worked and detail or ("Base upgrade pending: "..tostring(detail)))
        return true
    end
    local function healTask()
        if not W.flags.heal or os.clock()-W.lastHeal<3 then return false end
        local c=LocalPlayer.Character
        local injuries=c and c:FindFirstChild("Injuries")
        if not injuries then return false end
        for _,injury in ipairs(injuries:GetChildren()) do
            if table.find({"Arm","Leg","Head","Eyes","Ribcage"},injury.Name) then
                W.lastHeal=os.clock()
                local ok,updated=invoke("Equipment","Injury",injury.Name)
                log(ok and type(updated)=="table" and "Healed "..injury.Name or "Injury heal not accepted: "..injury.Name)
                return true
            end
        end
        return false
    end
    -- Prefer every selected, affordable-looking equipment upgrade BEFORE HQ
    -- spending. The game does not replicate per-stat equipment prices, so a
    -- rejected level is remembered at its current Gold balance. Try another
    -- selected stat, and switch to HQ only once none can be purchased.
    local function equipmentCandidates()
        local up=W.upgrades
        local selected=selections(W.pick.Equip)
        if not W.flags.equip or type(up)~="table" or #selected==0 then return {} end
        if type(W.gold)=="number" and W.gold<=0 then return {} end
        local all=table.find(selected,"All")~=nil
        local result={}
        for key,level in pairs(up) do
            local matched=all or table.find(selected,key)~=nil
            if not matched then
                for _,choice in ipairs(selected) do
                    if choice:find("Crit",1,true) then
                        local short=choice:match("^[A-Z]+_(Crit_.+)$")
                        if short==key then matched=true;break end
                    end
                end
            end
            if matched and type(level)=="number" and level<15 then
                local rejected=W.equipRejected[key]
                local gold=tonumber(W.gold)
                if not rejected or rejected.level~=level
                  or (gold and (not rejected.gold or gold>rejected.gold+0.01)) then
                    result[#result+1]={Name=key,Level=level}
                end
            end
        end
        table.sort(result,function(a,b)
            if a.Level~=b.Level then return a.Level<b.Level end
            return a.Name<b.Name
        end)
        return result
    end
    local function equipTask()
        if not W.flags.equip or (Farm.utilityBusy and not W.inWorkflow)
           or os.clock()-W.lastEquip<0.36 then return false end
        local list=equipmentCandidates()
        if #list==0 then
            W.equipStatus="No selected equipment upgrades accepted at current Gold"
            return false
        end
        local stat,level=list[1].Name,list[1].Level
        W.lastEquip=os.clock()
        local worked,detail=visitZone("Equipment",function()
            local ok,newLevels,changes=invoke("Equipment","Upgrade",{stat})
            if not ok then
                return false,"Equipment request unavailable: "..tostring(newLevels)
            end
            if type(newLevels)~="table" or type(changes)~="table" then
                -- Server rejects unavailable/costly upgrades without levels.
                -- Do not keep teleporting back to Lulu to retry this level.
                W.equipRejected[stat]={level=level,gold=tonumber(W.gold)}
                return false,"Equipment rejected "..stat.." at "
                    ..tostring(W.gold or "unknown").." Gold; trying next stat"
            end
            local current=newLevels[W.weapon]
            local newLevel=type(current)=="table" and tonumber(current[stat]) or nil
            if not newLevel or newLevel<=level then
                W.equipRejected[stat]={level=level,gold=tonumber(W.gold)}
                return false,"Equipment returned no confirmed level increase for "..stat
                    .."; trying other stats at current Gold"
            end
            W.upgrades=current
            if type(changes.Gold)=="number" then W.gold=changes.Gold end
            W.equipRejected[stat]=nil
            return true,"Equipment upgraded near Lulu: "..stat
        end)
        W.equipStatus=detail
        if not worked and not W.equipRejected[stat] then
            W.equipTransient=W.equipTransient or {}
            local count=(W.equipTransient[stat] or 0)+1
            W.equipTransient[stat]=count
            if count>=3 then
                W.equipRejected[stat]={level=level,gold=tonumber(W.gold)}
                W.equipStatus="Equipment "..stat.." blocked repeatedly; next stat / HQ fallback"
            end
        else
            if W.equipTransient then W.equipTransient[stat]=nil end
        end
        log(worked and detail or ("Equipment pending: "..tostring(detail)))
        return true
    end
    local function blessingTask()
        if not W.flags.blessing or os.clock()-W.lastRoll<4 then return false end
        local rolled=tonumber(W.blessingsRolled)
        if not rolled then return false end
        local f=folder()
        local waveFolder=folder()
        local modifier=tostring(waveFolder and waveFolder:GetAttribute("Modifiers") or "")
        local cost=math.ceil(2000*(1.43^rolled)*(modifier:find("Unworthy",1,true) and 1.125 or 1))
        if not canSpend(cost) or (W.capacity and W.capacity>=1000) then return false end
        W.lastRoll=os.clock()
        local ok,results,other,count=invoke("Waves","Blessing","Spin")
        if ok and type(results)=="table" and #results>0 and type(count)=="number" then
            W.blessingsRolled=count
            if type(W.gold)=="number" then W.gold=math.max(W.gold-cost,0) end
            log("Blessing roll accepted, total rolls: "..count)
        else log("Blessing spin rejected; will recheck cost/stock") end
        return true
    end
    -- v127 mobile raid optimization: Stohess shows a touch-only SKIP button
    -- without the desktop '[E]' keyboard hint. Locate the native raid Skip GUI
    -- directly instead of walking every PlayerGui descendant each 0.3 seconds.
    -- The Actor bridge still checks Can_Skip, Interacted, and the button's
    -- visibility before invoking the game's original Raids.Skip controller.
    local function visibleCinematicSkipPrompt()
        local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not gui then return false end
        local function visibleThroughGui(node)
            local current = node
            while current and current ~= gui do
                if current:IsA("GuiObject") and not current.Visible then return false end
                if current:IsA("ScreenGui") and not current.Enabled then return false end
                current = current.Parent
            end
            return current == gui
        end
        local raidMode = Workspace:GetAttribute("Type") == "Raids"
            or game.PlaceId == 15824912319
        if raidMode then
            local interface = gui:FindFirstChild("Interface")
            local skipUI = interface and interface:FindFirstChild("Skip")
            if skipUI and skipUI:IsA("GuiObject") then
                return visibleThroughGui(skipUI)
            end
            -- Raid Skip is not available yet. Do not confuse a wave-vote or
            -- ordinary skip label with the native raid cinematic button.
            return false
        end
        -- Preserve the pre-v127 Missions/Waves keyboard prompt detection.
        local function compact(raw)
            return tostring(raw or ""):gsub("<[^>]+>", ""):upper():gsub("%s+", "")
        end
        for _, node in ipairs(gui:GetDescendants()) do
            if (node:IsA("TextLabel") or node:IsA("TextButton"))
                and visibleThroughGui(node) then
                local label = compact(node.Text)
                if label:find("SKIP[E]", 1, true)
                    or label:find("SKIP(E)", 1, true)
                    or label:find("[E]SKIP", 1, true)
                    or label:find("PRESSETOSKIP", 1, true) then
                    return true
                end
                if label == "SKIP" and node.Parent and node.Parent:IsA("GuiObject") then
                    for _, sibling in ipairs(node.Parent:GetChildren()) do
                        if sibling ~= node
                            and (sibling:IsA("TextLabel") or sibling:IsA("TextButton"))
                            and visibleThroughGui(sibling) then
                            local key = compact(sibling.Text)
                            if key == "[E]" or key == "(E)" then return true end
                        end
                    end
                end
            end
        end
        return false
    end
    local function cinematicPromptStep(dt)
        W.cinematicWatchElapsed = (W.cinematicWatchElapsed or 0) + dt
        if W.cinematicWatchElapsed < 0.30 then return end
        W.cinematicWatchElapsed = 0
        if Farm.unloaded or not W.miscFlags.cinematic then
            W.cinematicPromptActive = false
            W.cinematicPressBusy = false
            return
        end
        local shown = visibleCinematicSkipPrompt()
        if not shown then
            W.cinematicPromptActive = false
            W.cinematicAttempts = 0
            return
        end
        if not W.cinematicPromptActive then
            W.cinematicPromptActive = true
            W.cinematicAttempts = 0
            W.cinematicLastPressAt = -100
        end
        local now = os.clock()
        if W.cinematicPressBusy or now - (W.cinematicLastPressAt or -100) < 0.85 then return end
        W.cinematicPressBusy = true
        W.cinematicLastPressAt = now
        task.spawn(function()
            local accepted = false
            local detail = "Native raid controller unavailable"
            local ok, err = pcall(function()
                local bridge, reason = resolveSlashBridge()
                if not bridge then
                    detail = tostring(reason or detail)
                    return
                end
                local invoked, yes, response = pcall(function()
                    return bridge:Invoke("cinematic_skip")
                end)
                accepted = invoked and yes == true
                detail = invoked and tostring(response or "") or tostring(yes)
            end)
            if not ok then detail = tostring(err) end
            W.cinematicNativeState = accepted and "Native raid Skip accepted" or detail
            if accepted then
                W.cinematicAttempts = (W.cinematicAttempts or 0) + 1
            else
                -- Missions may still use regular E as an input binding, but
                -- Raids must wait for the real controller to allow a skip.
                -- Never force E during the Female Titan's unskippable QTE.
                local raidMode = Workspace:GetAttribute("Type") == "Raids"
                    or game.PlaceId == 15824912319
                if not raidMode then
                    pcall(Farm.pressSkillHotkey, "E")
                end
            end
            W.cinematicPressBusy = false
        end)
    end
    local function miscTask()
        if game.PlaceId~=lobby and game.PlaceId~=TROST then return end
        if W.miscFlags.cinematic and game.PlaceId==TROST then
