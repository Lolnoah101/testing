-- Only update a text widget when its body changes. If a UI permission prevents
-- updates, report it once and leave the game automation running.
local lastWatcherText = {}
local disabledWatcher = {}
local function setWatcherText(handle, value, label)
    if not handle or disabledWatcher[handle] then return end
    if lastWatcherText[handle] == value then return end
    local ok, err = pcall(function()
        handle:Set(value)
    end)
    if ok then
        lastWatcherText[handle] = value
    else
        disabledWatcher[handle] = true
        warn("[Tame V12] " .. label .. " text update blocked: " .. tostring(err))
    end
end

-- ====================== QUESTS + ANIMALS (V41) ======================
-- All actions below use the same inventory and quest remotes as the game's UI.
-- Automated backpack release is opt-in, rank-filtered and protects special pets.
local function installQuestAndAnimalsFeatures()
    local QuestLines = require(Shared:WaitForChild("QuestLines"))
    local QuestRemote = Remotes:WaitForChild("QuestAction")
    local BountyRemote = Remotes:WaitForChild("BountyAction")
    local InventoryRemote = Remotes:WaitForChild("InventoryAction")

    PlayerTab:CreateSection({name = "Quests"})
    local autoClaimQuest = false
    local mainQuestStatus = "Disabled"
    local sideQuestStatus = "Disabled"
    local mainQuestRequests = 0
    local mainQuestLastSent = -math.huge
    local mainQuestReadySignature = ""
    local pendingBounty = nil
    local sideRequests = 0
    local sideLastSent = -math.huge
    local mainClaimedLastSeen = nil
    local sideClaimedLastSeen = nil
    local mainQuestWatcher = nil -- compact UI: watcher hidden
    local sideQuestWatcher = nil -- compact UI: watcher hidden

    local function readyQuestCount()
        if not ClientData.IsReady() then return 0 end
        local ok, amount = pcall(QuestLines.ReadyCount, ClientData.GetAll() or {})
        return ok and (tonumber(amount) or 0) or 0
    end

    local function getMainProgress()
        if not ClientData.IsReady() then return 0, 0, 0, "" end
        local data = ClientData.GetAll() or {}
        local ready, active, claimed = 0, 0, 0
        local ids = {}
        for _, islandId in ipairs(QuestLines.Islands()) do
            if QuestLines.IsStarted(data, islandId) then
                for _, quest in ipairs(QuestLines.List(islandId)) do
                    local status = QuestLines.Status(data, islandId, quest)
                    if status == "Ready" then
                        ready += 1
                        ids[#ids+1] = tostring(quest.Id)
                    elseif status == "Active" then
                        active += 1
                    elseif status == "Claimed" then
                        claimed += 1
                    end
                end
            end
        end
        table.sort(ids)
        return ready, active, claimed, table.concat(ids, ",")
    end

    -- QuestUI calls these the Side quests; internally they are Bounties.
    -- The current island uses Bounties.List. Other islands can exist in Saved,
    -- but their claims may require going to that island first.
    local function getSideProgress()
        local bounties = ClientData.Get("Bounties")
        if type(bounties) ~= "table" then return 0, 0, 0, {}, "No bounties loaded" end
        local currentIsland = tostring(bounties.Island or "Unknown")
        local list = type(bounties.List) == "table" and bounties.List or {}
        local ready, active, claimed, candidates = 0, 0, 0, {}
        for _, bounty in ipairs(list) do
            if type(bounty) == "table" then
                if bounty.Claimed then
                    claimed += 1
                elseif (tonumber(bounty.Progress) or 0) >=
                    math.max(1, tonumber(bounty.Amount) or 1) then
                    ready += 1
                    if bounty.Id ~= nil then
                        candidates[#candidates+1] = {id = bounty.Id, label = tostring(bounty.Id)}
                    end
                else
                    active += 1
                end
            end
        end
        table.sort(candidates, function(a,b) return a.label < b.label end)
        return ready, active, claimed, candidates, currentIsland
    end

    local function claimCompletedQuests()
        if not running or not autoClaimQuest or not ClientData.IsReady() then return end
        local now = os.clock()
        local mainReady, _, mainClaimed, signature = getMainProgress()
        if signature ~= mainQuestReadySignature or mainClaimed ~= mainClaimedLastSeen then
            mainQuestReadySignature = signature
            mainClaimedLastSeen = mainClaimed
            mainQuestRequests = 0
        end
        if mainReady > 0 then
            -- Fire as soon as QuestLines changes, with a confirmation retry
            -- rather than constantly firing ClaimAll every frame.
            if mainQuestRequests < 3 and now - mainQuestLastSent >= 1.2 then
                mainQuestLastSent = now
                mainQuestRequests += 1
                mainQuestStatus = string.format(
                    "Claiming %d completed main quests (request %d/3)",
                    mainReady, mainQuestRequests)
                local ok, err = pcall(function() QuestRemote:FireServer("ClaimAll") end)
                if not ok then mainQuestStatus = "Main claim request error: " .. tostring(err) end
            elseif mainQuestRequests >= 3 then
                mainQuestStatus = "Main rewards unconfirmed; check quest restrictions"
            end
        else
            mainQuestStatus = "Watching newly acquired and completed main quests"
        end

        local sideReady, _, sideClaimed, candidates, island = getSideProgress()
        if sideClaimed ~= sideClaimedLastSeen then
            sideClaimedLastSeen = sideClaimed
            pendingBounty = nil
        end
        local chosen = candidates[1]
        if sideReady == 0 or not chosen then
            pendingBounty = nil
            sideQuestStatus = "Watching side quests on " .. island
            return
        end
        if not pendingBounty or pendingBounty.id ~= chosen.id then
            pendingBounty = {id = chosen.id, tries = 0, at = -math.huge}
        end
        if pendingBounty.tries >= 3 then
            sideQuestStatus = "Side claim unconfirmed for " .. chosen.label
            return
        end
        if now - pendingBounty.at >= 1.2 then
            pendingBounty.tries += 1
            pendingBounty.at = now
            sideRequests += 1
            sideLastSent = now
            sideQuestStatus = string.format("Claiming %s (%s) attempt %d/3",
                chosen.label, island, pendingBounty.tries)
            local ok, err = pcall(function()
                BountyRemote:FireServer("Claim", chosen.id)
            end)
            if not ok then sideQuestStatus = "Side claim error: " .. tostring(err) end
        end
    end

    PlayerTab:CreateToggle({
        name = "Auto Claim Quest",

        flag = "AutoClaimQuestV38", value = false, forgetState = false,
        callback = function(value)
            autoClaimQuest = value == true
            mainQuestRequests = 0
            mainQuestLastSent = -math.huge
            mainQuestReadySignature = ""
            mainClaimedLastSeen = nil
            pendingBounty = nil
            sideClaimedLastSeen = nil
            mainQuestStatus = autoClaimQuest and "Watching main quests" or "Disabled"
            sideQuestStatus = autoClaimQuest and "Watching side quests" or "Disabled"
            if autoClaimQuest then task.defer(claimCompletedQuests) end
        end,
    })

    PlayerTab:CreateSection({name = "Animals"})
    local autoEquipAnimal = false
    local autoFuseAnimal = false
    local fuseEquippedUpgrade = false
    local autoReleaseBackpack = false
    local keepLastSpecies = true
    local releaseRanks = {}
    -- Exact-name protection across EVERY animal rank, independent of Auto Fuse.
    -- Default protects Crystal Golem even before Rayfield loads a saved value.
    local protectedAnimalNamesText = "Crystal Golem"
    local protectedAnimalNames = {}
    local function normalizeAnimalName(value)
        if type(value) ~= "string" then return "" end
        -- Spaces/case/underscore/dashes are ignored: CrystalGolem == Crystal Golem.
        return string.lower((value:gsub("[%s_%-]", "")))
    end
    local function rebuildProtectedAnimalNames(text)
        protectedAnimalNamesText = type(text) == "string" and text or ""
        table.clear(protectedAnimalNames)
        -- Commas separate names; line breaks and semicolons also work.
        for rawName in (protectedAnimalNamesText:gsub("[\r\n;]", ",")):gmatch("[^,]+") do
            local key = normalizeAnimalName(rawName)
            if key ~= "" then protectedAnimalNames[key] = true end
        end
    end
    rebuildProtectedAnimalNames(protectedAnimalNamesText)
    local function isProtectedAnimal(species)
        if type(species) ~= "string" then return false end
        if protectedAnimalNames[normalizeAnimalName(species)] then return true end
        local config = Animals[species]
        return type(config) == "table"
            and protectedAnimalNames[normalizeAnimalName(config.DisplayName)] == true
    end
    local inventoryStatus = "Automation off"
    local lastEquipSignature = nil
    local lastEquipAt = -math.huge
    local equipAttempts = 0
    local equipStatus = "Waiting for changes"
    local lastInventoryAction = nil
    local maxRank = type(Ranks.Letters) == "table" and #Ranks.Letters or 7
    local ranksList = type(Ranks.Letters) == "table" and Ranks.Letters
        or {"E", "D", "C", "B", "A", "S", "SS"}
    local animalWatcher = nil -- compact UI: watcher hidden

    local function getBackpack()
        local animals = ClientData.Get("Animals")
        return type(animals) == "table" and animals or {}
    end

    local function getEquippedPets()
        local equipped = {}
        local list = ClientData.Get("Equipped")
        if type(list) == "table" then
            -- Inventory keys and equipped IDs may have different primitive types.
            -- Normalize them so a string/number mismatch cannot consume a pet.
            for _, uid in ipairs(list) do equipped[tostring(uid)] = true end
        end
        return equipped
    end

    -- Stable fingerprint: prevents repeating destructive requests without a
    -- confirmed inventory update (including after a failed server request).
    local function getInventoryFingerprint(animals)
        local keys = {}
        for uid in pairs(animals) do keys[#keys + 1] = uid end
        table.sort(keys, function(x,y) return tostring(x) < tostring(y) end)
        local parts = {}
        for _, uid in ipairs(keys) do
            local pet = animals[uid]
            if type(pet) == "table" then
                parts[#parts+1] = table.concat({tostring(uid), tostring(pet.Species),
                    tostring(pet.Rank), tostring(pet.Level),
                    tostring(pet.Locked), tostring(pet.Shiny)}, ":")
            end
        end
        return table.concat(parts, "|")
    end

    -- Compare the best team against current equips. A new pet can be stronger
    -- even when the inventory count does not change (e.g. fusion/level gains).
    -- Immediately call EquipBest for a genuine mismatch; retry only when
    -- unchanged long enough to indicate an unconfirmed request.
    local function bestTeamSnapshot(animals, equipped)
        local candidates = {}
        for uid, pet in pairs(animals) do
            if type(pet) == "table" then
                local ok, power = pcall(Formulas.AnimalPower, pet)
                power = ok and tonumber(power) or nil
                if power then
                    candidates[#candidates+1] = {uid = tostring(uid), power = power}
                end
            end
        end
        table.sort(candidates, function(a, b)
            if a.power ~= b.power then return a.power > b.power end
            return a.uid < b.uid
        end)
        local rank = tonumber(ClientData.Get("TamerRank")) or 1
        local slots = tonumber(Player:GetAttribute("EquipSlots"))
        if not slots then
            local ok, n = pcall(Formulas.EquipSlots, rank)
            slots = ok and tonumber(n) or #equipped
        end
        slots = math.max(0, math.floor(slots or 0))
        local desired, current, bestPower = {}, {}, 0
        for i = 1, math.min(slots, #candidates) do
            desired[#desired+1] = candidates[i].uid
            bestPower += candidates[i].power
        end
        for _, uid in ipairs(equipped) do current[#current+1] = tostring(uid) end
        table.sort(desired)
        table.sort(current)
        local desiredSig = table.concat(desired, ",")
        local currentSig = table.concat(current, ",")
        return desiredSig, currentSig, bestPower, slots, candidates[1]
    end

    local function equipBestAnimal()
        if not running or not autoEquipAnimal or not ClientData.IsReady() then return end
        local animals = getBackpack()
        if next(animals) == nil then return end
        local equipped = ClientData.Get("Equipped") or {}
        local desired, current, power, slots, best = bestTeamSnapshot(animals, equipped)
        if desired == current then
            lastEquipSignature = nil
            equipAttempts = 0
            equipStatus = string.format("Best team equipped (%d/%d slots)", #equipped, slots)
            return
        end
        local signature = desired .. "|" .. current
        if signature ~= lastEquipSignature then
            lastEquipSignature = signature
            equipAttempts = 0
            lastEquipAt = -math.huge
        end
        if equipAttempts >= 3 then
            equipStatus = "Equip Best not confirmed; waiting for a team change"
            return
        end
        if os.clock() - lastEquipAt < 1.25 then return end
        equipAttempts += 1
        lastEquipAt = os.clock()
        equipStatus = string.format("Equipping stronger team (%d/%d)", equipAttempts, 3)
        local ok, err = pcall(function()
            InventoryRemote:FireServer("EquipBest", nil)
        end)
        if not ok then equipStatus = "Equip Best request error: " .. tostring(err) end
    end

    -- Builds fusions in rank order. Full backpack-only triples ALWAYS take
    -- precedence; this levels up spare copies without risking your loadout.
    -- If enabled, an equipped-upgrade fusion needs EXACTLY two unequipped
    -- copies matching ONE equipped pet's species and rank. Never include
    -- multiple equipped pets; never consume locked/shiny pets.
    local function readyFuse(animals, equipped)
        local groups = {}
        for uid, pet in pairs(animals) do
            if type(pet) == "table" and type(pet.Species) == "string"
                and not pet.Locked and not pet.Shiny then
                local rank = tonumber(pet.Rank) or 1
                if rank < maxRank then
                    local key = pet.Species .. ":" .. tostring(rank)
                    local group = groups[key]
                    if not group then
                        group = {species = pet.Species, rank = rank,
                            spares = {}, equipped = {}}
                        groups[key] = group
                    end
                    local entry = {uid = uid, level = tonumber(pet.Level) or 1}
                    if equipped[tostring(uid)] then
                        group.equipped[#group.equipped + 1] = entry
                    else
                        group.spares[#group.spares + 1] = entry
                    end
                end
            end
        end

        local backpackChoices, equippedChoices = {}, {}
        local gems = getNumber("Gems", 0)
        for _, group in pairs(groups) do
            local count = #group.spares
            if count >= 3 or (fuseEquippedUpgrade and autoEquipAnimal
                and count >= 2 and #group.equipped >= 1) then
                local ok, cost = pcall(Formulas.FuseCost,
                    group.rank, group.species)
                cost = ok and tonumber(cost) or nil
                if cost and cost >= 0 and gems >= cost then
                    table.sort(group.spares, function(a, b)
                        if a.level ~= b.level then return a.level < b.level end
                        return tostring(a.uid) < tostring(b.uid)
                    end)
                    table.sort(group.equipped, function(a, b)
                        if a.level ~= b.level then return a.level < b.level end
                        return tostring(a.uid) < tostring(b.uid)
                    end)
                    group.cost = cost
                    if count >= 3 then
                        backpackChoices[#backpackChoices + 1] = group
                    elseif fuseEquippedUpgrade and autoEquipAnimal
                        and count >= 2 and #group.equipped >= 1 then
                        equippedChoices[#equippedChoices + 1] = group
                    end
                end
            end
        end
        local function sortByProgression(a,b)
            if a.rank ~= b.rank then return a.rank < b.rank end
            return a.species < b.species
        end
        table.sort(backpackChoices, sortByProgression)
        table.sort(equippedChoices, sortByProgression)

        local group = backpackChoices[1]
        if group then
            return {group.spares[1].uid, group.spares[2].uid,
                group.spares[3].uid}, group.species, group.rank,
                group.cost, false
        end
        -- Upgrade stage: use only one (unlocked, non-shiny) equipped animal.
        -- This consumes it, replacing it with a higher-rank result if accepted.
        group = equippedChoices[1]
        if group then
            return {group.equipped[1].uid, group.spares[1].uid,
                group.spares[2].uid}, group.species, group.rank,
                group.cost, true
        end
        return nil
    end

    local function releaseCandidates(animals, equipped)
        local fuseReserve = {}
        if autoFuseAnimal then
            local byGroup = {}
            for uid, pet in pairs(animals) do
                local rank = type(pet) == "table" and (tonumber(pet.Rank) or 1) or 1
                if type(pet) == "table" and type(pet.Species) == "string"
                    and not pet.Locked and not pet.Shiny and rank < maxRank
                    and not equipped[tostring(uid)] then
                    local key = pet.Species .. ":" .. tostring(rank)
                    byGroup[key] = byGroup[key] or {}
                    table.insert(byGroup[key], {uid = uid,
                        level = tonumber(pet.Level) or 1})
                end
            end
            for _, list in pairs(byGroup) do
                table.sort(list, function(a, b)
                    if a.level ~= b.level then return a.level > b.level end
                    return tostring(a.uid) < tostring(b.uid)
                end)
                for i = 1, math.min(3, #list) do
                    fuseReserve[tostring(list[i].uid)] = true
                end
            end
        end
        local speciesCounts = {}
        for _, pet in pairs(animals) do
            if type(pet) == "table" and pet.Species then
                speciesCounts[pet.Species] = (speciesCounts[pet.Species] or 0) + 1
            end
        end
        local candidates = {}
        for uid, pet in pairs(animals) do
            local rank = tonumber(type(pet) == "table" and pet.Rank) or 1
            local letter = ranksList[rank]
            local config = type(pet) == "table" and Animals[pet.Species]
            if letter and releaseRanks[letter] and type(pet) == "table"
                and pet.Species and not pet.Locked and not pet.Shiny
                and not equipped[tostring(uid)] and not fuseReserve[tostring(uid)]
                and not isProtectedAnimal(pet.Species)
                and not (config and config.NoRelease) then
                candidates[#candidates+1] = {
                    uid = uid, species = pet.Species, rank = rank,
                    level = tonumber(pet.Level) or 1,
                }
            end
        end
        -- Prefer releasing weaker copies; keep stronger copies when protecting
        -- the last animal of a species.
        table.sort(candidates, function(a,b)
            if a.rank ~= b.rank then return a.rank < b.rank end
            if a.level ~= b.level then return a.level < b.level end
            return tostring(a.uid) < tostring(b.uid)
        end)
        local batch = {}
        for _, candidate in ipairs(candidates) do
            if not keepLastSpecies or (speciesCounts[candidate.species] or 0) > 1 then
                batch[#batch+1] = candidate.uid
                speciesCounts[candidate.species] -= 1
                if #batch >= 20 then break end
            end
        end
        return batch
    end

    local function automateInventory()
        if not running or not ClientData.IsReady() then return end
        local animals = getBackpack()
        local equipped = getEquippedPets()
        if next(animals) == nil then return end
        local stamp = getInventoryFingerprint(animals)
        if lastInventoryAction and lastInventoryAction.stamp == stamp then
            -- The last fuse/release has not been confirmed by backpack changes.
            if os.clock() - lastInventoryAction.at > 5 then
                inventoryStatus = "No inventory confirmation; check game access/server"
            end
            return
        elseif lastInventoryAction then
            local previousAction = lastInventoryAction
            inventoryStatus = "Previous " .. previousAction.kind .. " confirmed"
            lastInventoryAction = nil
            if previousAction.kind == "Equipped Upgrade" then
                -- The animal carrying the old equip slot may have been consumed.
                -- Allow the existing Auto Equip Best watcher to fill the slot.
                lastEquipSignature = nil
                if autoEquipAnimal then task.defer(equipBestAnimal) end
            end
        end
        if autoFuseAnimal then
            local uids, species, rank, cost, usingEquipped = readyFuse(animals, equipped)
            if uids then
                -- Revalidate IDs immediately before this irreversible request.
                local refreshedEquipped = getEquippedPets()
                local equippedCount = 0
                local sameSpeciesRank = true
                for _, uid in ipairs(uids) do
                    local pet = animals[uid]
                    if not pet or pet.Species ~= species
                        or (tonumber(pet.Rank) or 1) ~= rank
                        or pet.Locked or pet.Shiny then
                        sameSpeciesRank = false
                        break
                    end
                    if refreshedEquipped[tostring(uid)] then
                        equippedCount += 1
                    end
                end
                if not sameSpeciesRank or equippedCount > (usingEquipped and 1 or 0)
                    or (usingEquipped and (not fuseEquippedUpgrade or not autoEquipAnimal
                        or equippedCount ~= 1)) then
                    inventoryStatus = "Fusion team changed; rebuilding candidates"
                    return
                end
                local kind = usingEquipped and "Equipped Upgrade" or "Backpack Fuse"
                lastInventoryAction = {stamp = stamp, at = os.clock(), kind = kind}
                inventoryStatus = string.format("%s: %s rank %d → %d",
                    kind, species, rank, rank + 1)
                local ok, err = pcall(function()
                    InventoryRemote:FireServer("Fuse", uids)
                end)
                if not ok then
                    lastInventoryAction = nil
                    inventoryStatus = "Fuse request error: " .. tostring(err)
                end
                return
            end
        end
        if autoReleaseBackpack then
            if next(releaseRanks) == nil then
                inventoryStatus = "Select backpack release ranks first"
                return
            end
            local uids = releaseCandidates(animals, equipped)
            -- Revalidate protection/ownership immediately before an irreversible
            -- release request. In particular, protected species are NEVER
            -- released, even when E/SS or every rank is selected.
            local verified, nowEquipped = {}, getEquippedPets()
            local currentAnimals = getBackpack()
            for _, uid in ipairs(uids) do
                local pet = currentAnimals[uid]
                if type(pet) == "table" and type(pet.Species) == "string"
                    and not isProtectedAnimal(pet.Species)
                    and not nowEquipped[tostring(uid)]
                    and not pet.Locked and not pet.Shiny then
                    verified[#verified+1] = uid
                end
            end
            if #verified > 0 then
                lastInventoryAction = {stamp = stamp, at = os.clock(), kind = "Release"}
                inventoryStatus = "Releasing " .. tostring(#verified) .. " unprotected animals"
                local ok, err = pcall(function()
                    InventoryRemote:FireServer("Release", verified)
                end)
                if not ok then
                    lastInventoryAction = nil
                    inventoryStatus = "Release failed: " .. tostring(err)
                end
                return
            end
        end
        inventoryStatus = "No eligible fuse/release groups"
    end

    PlayerTab:CreateToggle({
        name = "Auto Equip Best Animal",

        flag = "AutoEquipBestAnimalV38", value = false, forgetState = false,
        callback = function(value)
