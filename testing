-- EQUIP BEST WEAPON
-- This uses the same DPS calculation as the game's ShopUI.
-- Equipped weapon is considered owned, and Stick is always available.
local autoEquipBestWeapon = false
local equipPending = nil
local equipAttempts = 0
local equipToggle = nil

local function getBestOwnedWeapon()
    local owned = ClientData.Get("OwnedWeapons") or {}
    local values = ClientData.Get("Stats") or {}
    local strength = tonumber(values.Strength) or 0
    local rank = getNumber("TamerRank", 1)
    local bestId, bestDps = nil, -math.huge

    for _, id in ipairs(Weapons.Order) do
        local info = Weapons[id]
        if info and isOwned(id, owned) then
            local ok, score = pcall(Formulas.WeaponDPS, id, strength, rank)
            if not ok or type(score) ~= "number" then
                -- Fallback to base DPS only if the shared formula is unavailable.
                score = (tonumber(info.Damage) or 0)
                    / math.max(tonumber(info.Interval) or 0.42, 0.01)
            end
            if score > bestDps then
                bestId, bestDps = id, score
            end
        end
    end

    return bestId, bestDps
end

local function doAutoEquipBest()
    if not running or not autoEquipBestWeapon or not ClientData.IsReady() then return end

    local bestId = getBestOwnedWeapon()
    if not bestId then return end

    local current = ClientData.Get("EquippedWeapon") or "Stick"
    if current == bestId then
        equipPending = nil
        equipAttempts = 0
        return
    end

    local now = os.clock()
    if equipPending and equipPending.id ~= bestId then
        equipPending = nil
        equipAttempts = 0
    end
    if equipPending and now - equipPending.at < 3 then
        -- Waiting for an EquippedWeapon update; don't resend every frame.
        return
    end
    if equipAttempts >= 3 then
        if equipToggle then equipToggle:Set(false) else autoEquipBestWeapon = false end
        warn("[Tame V44] Equip Best paused: equip was not confirmed after 3 requests.")
        return
    end

    equipAttempts += 1
    equipPending = {id = bestId, at = now}
    ShopRemote:FireServer("EquipWeapon", bestId)
end

