function Systems.getStarterBoatMerchantPosition()
    local world = workspace:FindFirstChild("World")
    local islands =
        world and world:FindFirstChild("Islands")

    if islands then
        local merchant =
            islands:FindFirstChild(
                "npc_car_merchant_starter",
                true
            )

        if merchant then
            if merchant:IsA("Model") then
                local part =
                    merchant.PrimaryPart
                    or merchant:FindFirstChild(
                        "HumanoidRootPart",
                        true
                    )
                    or merchant:FindFirstChild(
                        "Head",
                        true
                    )

                if part
                    and part:IsA("BasePart") then
                    return part.Position
                end
            elseif merchant:IsA("BasePart") then
                return merchant.Position
            end
        end
    end

    return Systems.StarterBoatMerchantFallback
end

function Systems.getOwnedBoat()
    local cars =
        workspace:FindFirstChild("Cars")

    if not cars then
        return nil
    end

    local boat =
        cars:FindFirstChild(
            tostring(LocalPlayer.UserId)
        )

    if not boat
        or not boat:IsA("Model") then
        return nil
    end

    local seat =
        boat:FindFirstChild("DSeat")

    local main =
        boat:FindFirstChild("Main")

    if not seat
        or not seat:IsA("VehicleSeat")
        or not main
        or not main:IsA("BasePart") then
        return nil
    end

    local attachment =
        seat:FindFirstChild("Attachment")

    local prompt =
        attachment
        and attachment:FindFirstChild(
            "ProximityPrompt"
        )
        or nil

    if prompt
        and prompt:IsA("ProximityPrompt")
        and prompt.Enabled ~= true then
        prompt.Enabled = true
    end

    return boat, seat, main, prompt
end

function Systems.spawnFreeProgressionBoat()
    local boat, seat, main, prompt =
        Systems.getOwnedBoat()

    if boat then
        return boat, seat, main, prompt
    end

    local merchantPosition =
        Systems.getStarterBoatMerchantPosition()

    local _, humanoid, root =
        Systems.getCharacterHumanoid()

    if not humanoid
        or not root
        or humanoid.Health <= 0 then
        State.ProgressionNavigationStatus =
            "Character unavailable"
        return nil
    end

    Systems.forceStandAndRestorePrompts()

    State.ProgressionNavigationStatus =
        "Teleporting to Boat Merchant"

    local merchantTarget =
        merchantPosition
        + Vector3.new(0, 3, 5)

    local moved = pcall(function()
        root.CFrame =
            CFrame.lookAt(
                merchantTarget,
                merchantPosition
            )

        root.AssemblyLinearVelocity =
            Vector3.zero
        root.AssemblyAngularVelocity =
            Vector3.zero
    end)

    if not moved then
        State.ProgressionNavigationStatus =
            "Boat Merchant teleport failed"
        return nil
    end

    task.wait(0.30)

    local refreshedRoot =
        select(
            3,
            Systems.getCharacterHumanoid()
        )

    if not refreshedRoot
        or (
            refreshedRoot.Position
            - merchantPosition
        ).Magnitude > 12 then

        State.ProgressionNavigationStatus =
            "Boat Merchant teleport was corrected"
        return nil
    end

    Systems.restoreStandingPromptState()

    State.ProgressionNavigationStatus =
        "Spawning free boat"

    if os.clock()
        - State.ProgressionBoatLastSpawnAt
        >= 0.75 then

        State.ProgressionBoatLastSpawnAt =
            os.clock()

        pcall(function()
            SpawnCarPacket:Fire(
                "truck/island_starter"
            )
        end)
    end

    local deadline = os.clock() + 8

    repeat
        boat, seat, main, prompt =
            Systems.getOwnedBoat()

        if boat then
            State.ProgressionNavigationStatus =
                "Free boat spawned"
            return boat, seat, main, prompt
        end

        task.wait(0.08)
    until os.clock() >= deadline

    State.ProgressionNavigationStatus =
        "Free boat did not spawn"
    return nil
end

function Systems.enterProgressionBoat(
    boat,
    seat,
    prompt
)
    local _, humanoid, root =
        Systems.getCharacterHumanoid()

    if not humanoid
        or not root
        or not boat
        or not boat.Parent
        or not seat
        or not seat.Parent then
        return false
    end

    if seat.Occupant == humanoid then
        return true
    end

    Systems.forceStandAndRestorePrompts()

    -- Exact runtime path requested:
    -- workspace.Cars[UserId].DSeat.Attachment.ProximityPrompt
    local attachment =
        seat:FindFirstChild("Attachment")

    prompt =
        attachment
        and attachment:FindFirstChild(
            "ProximityPrompt"
        )
        or prompt

    if not prompt
        or not prompt:IsA("ProximityPrompt") then

        State.ProgressionNavigationStatus =
            "Exact DSeat.Attachment.ProximityPrompt missing"
        return false
    end

    prompt.Enabled = true

    local promptPosition =
        attachment.WorldPosition

    local side =
        seat.CFrame.RightVector

    local targetPosition =
        promptPosition
        + side * 3
        + Vector3.new(0, 2.25, 0)

    State.ProgressionNavigationStatus =
        "Teleporting to boat prompt"

    local moved = pcall(function()
        root.CFrame =
            CFrame.lookAt(
                targetPosition,
                promptPosition
            )

        root.AssemblyLinearVelocity =
            Vector3.zero
        root.AssemblyAngularVelocity =
            Vector3.zero
    end)

    if not moved then
        State.ProgressionNavigationStatus =
            "Boat prompt teleport failed"
        return false
    end

    task.wait(0.20)

    _, humanoid, root =
        Systems.getCharacterHumanoid()

    if not humanoid or not root then
        return false
    end

    local maxDistance =
        math.max(
            6,
            tonumber(
                prompt.MaxActivationDistance
            ) or 10
        )

    if (
        root.Position - promptPosition
    ).Magnitude > maxDistance + 1 then

        State.ProgressionNavigationStatus =
            "Boat prompt teleport was corrected"
        Systems.forceStandAndRestorePrompts()
        return false
    end

    Systems.restoreStandingPromptState()
    prompt.Enabled = true

    State.ProgressionNavigationStatus =
        "Activating exact boat prompt"

    -- First use the configured keyboard input while standing in range.
    local keyCode =
        prompt.KeyboardKeyCode

    if keyCode == Enum.KeyCode.Unknown then
        keyCode = Enum.KeyCode.E
    end

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            true,
            keyCode,
            false,
            game
        )

        task.wait(
            math.max(
                tonumber(prompt.HoldDuration)
                    or 0,
                0.05
            )
            + 0.08
        )

        VirtualInputManager:SendKeyEvent(
            false,
            keyCode,
            false,
            game
        )
    end)

    local deadline = os.clock() + 2.25

    while State.Alive
        and os.clock() < deadline do

        if seat.Occupant == humanoid then
            State.ProgressionNavigationStatus =
                "Entered free boat"
            return true
        end

        task.wait(0.04)
    end

    -- One normal ProximityPrompt input fallback.
    pcall(function()
        prompt:InputHoldBegin()

        task.wait(
            math.max(
                tonumber(prompt.HoldDuration)
                    or 0,
                0
            )
            + 0.08
        )

        prompt:InputHoldEnd()
    end)

    local fallbackDeadline =
        os.clock() + 1.75

    while State.Alive
        and os.clock()
            < fallbackDeadline do

        if seat.Occupant == humanoid then
            State.ProgressionNavigationStatus =
                "Entered free boat"
            return true
        end

        task.wait(0.04)
    end

    Systems.forceStandAndRestorePrompts()

    State.ProgressionNavigationStatus =
        "Exact boat prompt did not seat player"
    return false
end

function Systems.tryTweenBoatToIsland(
    islandId,
    boat,
    seat,
    main
)
    local destination =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if not destination
        or not boat
        or not boat.Parent
        or not main
        or not main.Parent then
        return false
    end

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid
        or seat.Occupant ~= humanoid then

        State.ProgressionNavigationStatus =
            "Must be seated before boat tween"
        return false
    end

    State.BoatTweenAttempts += 1

    local target =
        destination
        * CFrame.new(0, 5, 0)

    local startFrame =
        boat:GetPivot()

    local distance =
        (
            startFrame.Position
            - target.Position
        ).Magnitude

    local speed =
        math.clamp(
            tonumber(
                Config.TravelTweenSpeed
            ) or 50,
            10,
            70
        )

    local duration =
        math.max(
            0.15,
            distance / speed
        )

    State.ProgressionNavigationStatus =
        "Tweening boat to "
        .. tostring(
            Systems.IslandIdToName[islandId]
            or islandId
        )
        .. " at "
        .. tostring(speed)
        .. " studs/s"

    Systems.releaseBoatControls()

    -- Tween a CFrameValue and apply each intermediate frame to the
    -- entire boat model. This keeps the boat motion smooth instead of
    -- instantly PivotTo-ing the destination.
    local driver =
        Instance.new("CFrameValue")

    driver.Value = startFrame

    local connection =
        driver:GetPropertyChangedSignal(
            "Value"
        ):Connect(function()
            if boat.Parent
                and main.Parent then

                boat:PivotTo(
                    driver.Value
                )

                main.AssemblyLinearVelocity =
                    Vector3.zero
                main.AssemblyAngularVelocity =
                    Vector3.zero
            end
        end)

    local tween =
        TweenService:Create(
            driver,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                Value = target,
            }
        )

    local finished = false

    local completedConnection =
        tween.Completed:Connect(
            function(playbackState)
                finished =
                    playbackState
                    == Enum.PlaybackState.Completed
            end
        )

    tween:Play()

    local deadline =
        os.clock()
        + duration
        + 1.50

    while State.Alive
        and os.clock() < deadline
        and not finished do

        if not boat.Parent
            or not main.Parent
            or seat.Occupant ~= humanoid then
            break
        end

        task.wait(0.05)
    end

    if tween.PlaybackState
        == Enum.PlaybackState.Playing then
        tween:Cancel()
    end

    if connection then
        connection:Disconnect()
    end

    if completedConnection then
        completedConnection:Disconnect()
    end

    driver:Destroy()

    if not finished then
        State.BoatTweenRejected += 1

        if not boat.Parent
            or not main.Parent then

            State.ProgressionNavigationStatus =
                "Boat disappeared during tween"
        elseif seat.Occupant ~= humanoid then
            State.ProgressionNavigationStatus =
                "Boat seat was lost during tween"
        else
            State.ProgressionNavigationStatus =
                "Boat tween did not complete"
        end

        return false
    end

    -- Let replication settle before deciding whether the move stuck.
    task.wait(0.85)

    if not boat.Parent
        or not main.Parent then

        State.BoatTweenRejected += 1
        State.ProgressionNavigationStatus =
            "Boat disappeared after tween"
        return false
    end

    local finalDistance =
        (
            main.Position
            - target.Position
        ).Magnitude

    if finalDistance > 55 then
        State.BoatTweenRejected += 1
        State.ProgressionNavigationStatus =
            "Boat tween was corrected"
        return false
    end

    if seat.Occupant ~= humanoid then
        State.BoatTweenRejected += 1
        State.ProgressionNavigationStatus =
            "Boat tween completed but seat was lost"
        return false
    end

    State.BoatTweenAccepted += 1
    State.ProgressionNavigationStatus =
        "Boat tween accepted"

    return true
end

function Systems.driveBoatTowardIsland(
    islandId,
    boat,
    seat,
    main
)
    local destination =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if not destination then
        return false
    end

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid then
        return false
    end

    local target = destination.Position
    local timeout =
        math.max(
            30,
            tonumber(
                Config.ProgressionBoatTimeout
            ) or 120
        )

    local arrivalRadius =
        math.max(
            90,
            tonumber(
                Config.ProgressionBoatArrivalRadius
            ) or 135
        )

    local deadline = os.clock() + timeout
    local stalledSince = 0
    local previousPosition = main.Position

    State.ProgressionBoatTargetIslandId =
        islandId

    while State.Alive
        and State.ProgressionNavigationBusy
        and os.clock() < deadline do

        if not boat.Parent
            or not seat.Parent
            or not main.Parent then
            break
        end

        if seat.Occupant ~= humanoid then
            State.ProgressionNavigationStatus =
                "Boat seat lost"
            break
        end

        local flatDelta = Vector3.new(
            target.X - main.Position.X,
            0,
            target.Z - main.Position.Z
        )

        local distance =
            flatDelta.Magnitude

        local currentIsland =
            getCurrentIslandId()

        if distance <= arrivalRadius then
            Systems.releaseBoatControls()
            break
        end

        if flatDelta.Magnitude < 0.001 then
            Systems.releaseBoatControls()
            break
        end

        local localDirection =
            main.CFrame:
                VectorToObjectSpace(
                    flatDelta.Unit
                )

        local angle =
            math.atan2(
                localDirection.X,
                -localDirection.Z
            )

        local absAngle =
            math.abs(angle)

        local steerRight =
            angle > 0.10

        local steerLeft =
            angle < -0.10

        -- The game's boat rotates even with zero throttle, so point the
        -- boat first when the destination is far off-axis.
        local driveForward =
            absAngle < 0.70

        Systems.setBoatKey(
            "D",
            steerRight
        )
        Systems.setBoatKey(
            "A",
            steerLeft
        )
        Systems.setBoatKey(
            "W",
            driveForward
        )

        -- Also keep VehicleSeat state aligned with the same normal
        -- steering intent. The game's own Car LocalScript consumes it.
        pcall(function()
            seat.ThrottleFloat =
                driveForward and 1 or 0
            seat.SteerFloat =
                steerRight and 1
                or steerLeft and -1
                or 0
        end)

        State.ProgressionNavigationStatus =
            "Boating to "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )
            .. " ("
            .. tostring(
                math.floor(distance)
            )
            .. " studs)"

        task.wait(0.05)

        local moved =
            (
                Vector3.new(
                    main.Position.X,
                    0,
                    main.Position.Z
                )
                - Vector3.new(
                    previousPosition.X,
                    0,
                    previousPosition.Z
                )
            ).Magnitude

        if driveForward and moved < 0.05 then
            if stalledSince == 0 then
                stalledSince = os.clock()
            end
        else
            stalledSince = 0
        end

        previousPosition = main.Position

        -- If the boat has reached the target island and is pressed
        -- against the shore, stop trying to push farther inland.
        if currentIsland == islandId
            and stalledSince > 0
            and os.clock() - stalledSince > 2 then
            Systems.releaseBoatControls()
            break
        end
    end

    Systems.releaseBoatControls()

    local finalIsland =
        getCurrentIslandId()

    local finalDistance =
        Vector3.new(
            target.X - main.Position.X,
            0,
            target.Z - main.Position.Z
        ).Magnitude

    return finalIsland == islandId
        or finalDistance
            <= arrivalRadius + 75
end

function Systems.leaveBoatAndReachIsland(
    islandId
)
    local character, humanoid =
        Systems.getCharacterHumanoid()

    if not character
        or not humanoid then
        return false
    end

    Systems.releaseBoatControls()

    humanoid.Sit = false
    humanoid.Jump = true

    pcall(function()
        humanoid:ChangeState(
            Enum.HumanoidStateType.GettingUp
        )
    end)

    local unseatDeadline =
        os.clock() + 1.25

    while humanoid.SeatPart ~= nil
        and os.clock() < unseatDeadline do

        task.wait(0.04)
    end

    Systems.restoreStandingPromptState()

    task.wait(0.15)

    local destination =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if destination then
        State.ProgressionNavigationStatus =
            "Pathfinding onto "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )

        Systems.walkToPosition(
            destination.Position,
            6,
            12
        )
    end

    task.wait(0.25)

    return Systems.isAtIsland(islandId)
end

function Systems.progressionNavigateToIsland(
    islandId
)
    State.ProgressionNavigationStatus =
        "Using closest Boat Merchant spawner at 35 studs/s"

    return Systems.travelToIsland(
        islandId
    )
end

