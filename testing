-- Save/load manager has its own scope to prevent the Luau 200-local limit.
-- Unlike several earlier versions, no Save is allowed to overwrite the file
-- while the initial 6-tab interface is still registering its controls.
function state.InitializePersistence()
    local HttpService = game:GetService("HttpService")
    local previousFingerprint = nil
    local lastFailedFingerprint = nil

    local function fingerprint()
        local fields = {}
        local flagCount = 0
        local ok, err = pcall(function()
            -- Rayfield Gen2's documented live Flags iteration syntax.
            for flag, value in window.Flags do
                if type(flag) == "string" then
                    local encodedOK, encoded = pcall(function()
                        return HttpService:JSONEncode(value)
                    end)
                    fields[#fields + 1] = flag .. "="
                        .. (encodedOK and encoded or tostring(value))
                    flagCount += 1
                end
            end
        end)
        if not ok then return nil, 0, tostring(err) end
        table.sort(fields)
        return table.concat(fields, "\n"), flagCount
    end

    -- Exactly one restore, after all 6 tabs and flags exist.
    local loadOk, loadResult = pcall(function() return window:Load() end)
    local initialFingerprint, initialCount, fingerprintErr = fingerprint()
    previousFingerprint = initialFingerprint
    print(string.format(
        "[Paraiso Save] initial Load=%s | flags=%d | file=ParaisoSavingStableV2.rfld | fingerprint=%s",
        tostring(loadOk and loadResult), initialCount,
        fingerprintErr or "ok"
    ))
    if not initialFingerprint then
        warn("[Paraiso Save] Cannot enumerate Rayfield flags:", fingerprintErr)
        return
    end

    -- Save only after a REAL user/UI flag change; avoid writing defaults
    -- during startup.  :Save() is Rayfield's native, tested persistence API.
    task.spawn(function()
        while state.Running do
            task.wait(0.75)
            local current = fingerprint()
            if current and current ~= previousFingerprint then
                -- Debounce rapid dropdown edits and toggles.
                task.wait(0.55)
                current = fingerprint()
                if current and current ~= previousFingerprint then
                    local saved, detail = saveSettingsNowNative()
                    if saved then
                        previousFingerprint = current
                        lastFailedFingerprint = nil
                    elseif lastFailedFingerprint ~= current then
                        lastFailedFingerprint = current
                        warn("[Paraiso Save] Save unsuccessful:", detail)
                    end
                end
            end
        end
    end)

    state.GetSaveDebug = function()
        local _, count, err = fingerprint()
        local pathOK, _, configPath = pcall(function() return window:GetPath() end)
        return string.format("flags=%d | path=%s | status=%s",
            count, tostring(pathOK and configPath or "unknown"),
            tostring(err or "ok"))
    end
end
state.InitializePersistence()

