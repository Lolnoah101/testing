    -- Only the official "Skip" voting phase with zero living Titans is
    -- considered a confirmed between-wave break. This avoids wandering down
    -- to the base when a Titan is temporarily out of range or spawning.
    local function breakWindow()
        if not wavesActive() then return false,"Not in active Trost Waves" end
        local f=folder()
        local objective=waveObjective()
        if not f or not objective or f:GetAttribute("Finalised")~=nil then
            return false,"Waves objective not ready"
        end
        local phase=tostring(objective:GetAttribute("Phase") or "")
        if phase~="Skip" or objective:GetAttribute("Show")~=true then
            return false,"Waiting for post-wave Skip phase ("..phase..")"
        end
        if LocalPlayer:GetAttribute("Dead") then return false,"Player is down" end
        local alive=#getLivingTitans()
        if alive>0 then return false,"Waiting for final "..alive.." Titans" end
        local wave=tostring(f:GetAttribute("Wave") or Workspace:GetAttribute("Wave") or "?")
        return true,"Wave "..wave.." intermission",phase.."/"..wave
    end
    W.continueWindow=function()
        local active=breakWindow()
        return active
    end
    -- During an active combat wave, buy a new HQ Refills stock only when the
    -- blade rig has no spare pairs left. Intermission spending stays equipment-
    -- first; the ordinary station-refill watcher resumes after purchasing.
    local function emergencyRefillItem()
        if not wavesActive() or not Farm.utilityAutoRefill
            or not W.flags.base or not table.find(selections(W.pick.Base),"Refills") then
            return nil
        end
        local f=folder()
        if not f or f:GetAttribute("Finalised")~=nil then return nil end
        local upgrades=f:FindFirstChild("Upgrades")
        local item=upgrades and upgrades:FindFirstChild("Refills")
        if not item or not item:IsA("ValueBase") or tonumber(item.Value)~=0 then
            return nil
        end
        local blades=inspectBlades()
        -- Zero spares calls for preemptive resupply, even if the pair in hand
        -- is still usable. This must not wait for a Titan or the next break.
        if not blades or blades.sparePairs>0 then return nil end
        return item
    end
    W.needsEmergencyRefills=function()
        -- Called from the utility watcher: never yields or fires remotes.
        return emergencyRefillItem()~=nil
    end
    local function emergencyRefillTask()
        local item=emergencyRefillItem()
        if not item or Farm.utilityBusy or W.inWorkflow then return false end
        local now=os.clock()
        if now-W.emergencyLastAttempt<2.8 then return true end
        if type(W.gold)~="number" then snapshot() end
        local cost=tonumber(item:GetAttribute("Cost"))
        if type(W.gold)~="number" or not cost or W.gold<cost then
            W.emergencyStatus="Need HQ Refills, but not enough confirmed Gold for "
                ..tostring(cost or "unknown").." cost"
            if now-W.emergencyBudgetWarningAt>8 then
                W.emergencyBudgetWarningAt=now
                log(W.emergencyStatus)
            end
            return true
        end
        local root=rootPart()
        if not root then return true end
        W.emergencyLastAttempt=now
        local originalCFrame,originalVelocity=root.CFrame,root.AssemblyLinearVelocity
        W.inWorkflow=true
        W.workflowMode="emergency"
        Farm.utilityBusy=true -- stop aura, travel, and other utility workers
        W.emergencyStatus="Emergency HQ Refills: pausing combat"
        local ok,success,detail=pcall(function()
            local deadline=os.clock()+2
            while Farm.attacking and os.clock()<deadline do task.wait(0.04) end
            if Farm.attacking or Farm.unloaded or not root.Parent then
                return false,"Waiting for active slash to finish"
            end
            cancelTween()
            resetTweenGoalFilter()
            releaseSwingFreeze()
            if Farm.momentumForce then removeMomentumDrive() end
            if Farm.hoverForce then removeHoverSupport() end
            setAttackHeld(false)
            RunService.Heartbeat:Wait()
            if not emergencyRefillItem() then
                return false,"Supply restored or blade shortage ended before purchase"
            end
            local prior=item.Value
            local price=tonumber(item:GetAttribute("Cost")) or cost
            if type(W.gold)=="number" and W.gold<price then
                return false,"Not enough Gold for emergency Refills"
            end
            return visitZone("Upgrade",function()
                local accepted,response=invoke("Waves","Upgrade",{"Refills"})
                if not accepted or response==false then
                    return false,"Emergency Refills request rejected: "..tostring(response)
                end
                task.wait(0.16)
                local latest,earlier=tonumber(item.Value),tonumber(prior)
                local filled=latest~=nil and earlier~=nil and latest>earlier
                if filled then
                    W.emergencyPurchases=W.emergencyPurchases+1
                    if type(W.gold)=="number" then W.gold=math.max(0,W.gold-price) end
                    Farm.utilityLastRefill=-100 -- immediately resume the native station trip
                end
                return filled,"HQ Refills "..(filled and "restocked" or
                    "requested; waiting for server stock update")
            end)
        end)
        if root.Parent and not Farm.unloaded and rootPart()==root
            and (root.Position-originalCFrame.Position).Magnitude>0.4 then
            root.CFrame=originalCFrame
            root.AssemblyLinearVelocity=Farm.running and originalVelocity or Vector3.zero
            root.AssemblyAngularVelocity=Vector3.zero
        end
        Farm.utilityBusy=false
        W.inWorkflow=false
        W.workflowMode=nil
        if not ok then
            W.emergencyStatus="Emergency workflow error: "..tostring(success)
        else
            W.emergencyStatus=success and "Emergency HQ Refills purchased; resuming farm"
                or tostring(detail)
        end
        log(W.emergencyStatus)
        return true
    end
    -- v99: Leave diagnostics. Do not assume the server accepted a request
    -- just because FireServer returned normally. Compare replicated wave state
    -- against the visible HUD, but only read the HUD every 1.5 seconds on mobile.
    W.leaveHudValue=nil
    W.leaveHudSource=nil
    W.leaveHudScannedAt=-100
