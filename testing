--//============================================================
--// CREATE QUEUE USING SERVER-APPROVED ROOM
--//============================================================

local function CreateLobbyQueue(
    Mode,
    RoomNumber
)

    if not LobbyReady
        or not LobbyPackets
        or not RoomNumber
    then

        return false
    end


    if IsLobbyQueued() then
        return false
    end


    local Payload


    if Mode == "Story" then

        Payload =
            BuildStoryPayload(
                RoomNumber
            )

    elseif Mode == "Infinite" then

        Payload =
            BuildEndlessPayload(
                RoomNumber
            )

    elseif Mode == "Raid" then

        local RaidMap =
            FindLobbyMap(
                "Raid",
                Settings.SelectedRaidMap
                    or "Spirit's Bathtub"
            )
            or FindLobbyMap(
                "Raid",
                Settings.SelectedRaidMap == "Shadow Gate"
                    and "ShadowGate"
                    or "BathTub"
            )
            or FindLobbyMap(
                "Raid",
                "Spirit's Bathtub"
            )


        if RaidMap then

            Payload = {
                gamemode = "Raid",
                map = RaidMap.Id,
                chapter = 0,
                difficulty = 4,
                maxPlayers = 1,
                friendsOnly = false,
                roomNumber = RoomNumber,
            }
        end
    end


    if not Payload then
        return false
    end


    -- Flush the newest UI state before the server can begin a place teleport.
    pcall(function()
        local Saver =
            GENV.__AZ_FORCE_CONFIG_SAVE

        if type(Saver) == "function" then
            Saver(
                "before queue",
                true
            )
        else
            Window:Save()
        end
    end)


    local Success,
        ErrorMessage =
        pcall(function()

            LobbyPackets
                .createQuque
                :fire(
                    Payload
                )
        end)


    if not Success then

        warn(
            "[Anime Zero] Create Queue Failed:",
            ErrorMessage
        )


        return false
    end


    LastLobbyCreate =
        os.clock()


    LobbyCreateAttempts =
        LobbyCreateAttempts + 1


    print(
        "[Anime Zero] Create Queue |",
        Mode,
        "| Room:",
        RoomNumber,
        "| Map:",
        Payload.map,
        "| Act:",
        Payload.chapter,
        "| Difficulty:",
        Payload.difficulty
    )


    return true
end


