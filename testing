local FishOptions = {}
local FishNameToId = {}

pcall(function()
    for _, fish in ipairs(Catalog.Fish.GetAll()) do
        local id = tostring(fish.id or "")
        local name = tostring(fish.name or id)
        if id ~= "" and name ~= "" then
            table.insert(FishOptions, name)
            FishNameToId[string.lower(name)] = id
            FishNameToId[string.lower(id)] = id
        end
    end

    table.sort(FishOptions, function(a, b)
        return string.lower(a) < string.lower(b)
    end)
end)

local function getPlayerData()
    local ok, data = pcall(function()
        return PlayerDataV2Controller:Fetch()
    end)

    if ok then
        return data
    end

    return nil
end

local function getFishInventory(data)
    local inventory = data and data.Inventory
    local fishes = inventory and inventory.Fishes
    return type(fishes) == "table" and fishes or {}
end

local function getFishCountAndCapacity(data)
    local count = 0
    for _ in pairs(getFishInventory(data)) do
        count += 1
    end

    local capacity = 50
    pcall(function()
        capacity = math.max(1, tonumber(EntitlementConfig.FishCapacity(data)) or 50)
    end)

    State.AutoSellFishCount = count
    State.AutoSellCapacity = capacity

    return count, capacity
end

local function getFishUid(index, fish)
    if type(fish) ~= "table" then
        return nil
    end

    local uid = fish.uid or fish.uuid
    if uid == nil and typeof(index) == "string" then
        uid = index
    end

    if uid == nil then
        return nil
    end

    return tostring(uid)
end

local function fishBelongsToIsland(fishId, islandId)
    if not fishId or not islandId then
        return false
    end

    local ok, pool = pcall(function()
        return Catalog.Island.GetFishPool(islandId)
    end)

    if not ok or type(pool) ~= "table" then
        return false
    end

    for _, entry in ipairs(pool) do
        local fish = entry and entry.fish
        if fish and fish.id == fishId then
            return true
        end
    end

    return false
end

local function isQuestProtectedFish(data, fish)
    if not Config.AutoSellKeepQuestFish or type(fish) ~= "table" then
        return false
    end

    local current = data and data.Quest and data.Quest.Current
    local questId = current and current.Id
    if type(questId) ~= "string" or questId == "" then
        return false
    end

    local fishId = fish.fishId
    if type(fishId) ~= "string" then
        return false
    end

    local catalogFish = Catalog.Fish.GetById(fishId)
    local rarity = catalogFish and catalogFish.rarity
    local weight = tonumber(fish.weight) or 0

    if questId == "unlock_island_4" then
        return rarity == "Legendary" and fishBelongsToIsland(fishId, "island_desert")
    end

    if questId == "unlock_island_5" then
        return fishId == "frozen_crown_dragonfish"
            or fishId == "frosttusk_seal"
            or fishId == "frostmaw_monster"
    end

    if questId == "unlock_island_6" then
        local minimum = QuestConfig.UnlockIsland6MinWeightKg
            and QuestConfig.UnlockIsland6MinWeightKg[fishId]
        return minimum ~= nil and weight >= minimum
    end

    if questId == "white_tiger" then
        return rarity == "Legendary"
            and weight >= (tonumber(QuestConfig.WhiteTigerMinWeightKg) or 1000)
            and fishBelongsToIsland(fishId, "island_desert")
    end

    if questId == "phoenix" then
        return rarity == "Legendary" and fishBelongsToIsland(fishId, "island_snow")
    end

    if questId == "azure_dragon" then
        return rarity == "Legendary" and fishBelongsToIsland(fishId, "island_volcano")
    end

    if questId == "heaven_piercer_turtle_rod" then
        return rarity == "Legendary" and fishBelongsToIsland(fishId, "island_fossil")
    end

    if questId == "dread_fish_rod" then
        return rarity == "Mythical" and fishBelongsToIsland(fishId, "island_fossil")
    end

    return false
end

local function selectedKeepFish(fishId)
    if type(fishId) ~= "string" then
        return false
    end

    return Config.AutoSellKeepFish[fishId] == true
end

local function getFishSellValue(fish)
    if type(fish) ~= "table" then
        return 0
    end

    local stamped = tonumber(fish.value or fish.sellValue)
    if stamped and stamped > 0 then
        return stamped
    end

    local value = 0
    pcall(function()
        value = tonumber(Catalog.Fish.GetValue(fish.fishId, tonumber(fish.weight) or 0)) or 0
    end)
    return value
end

local function shouldKeepFish(data, fish)
    if type(fish) ~= "table" then
        return true
    end

    -- Never override the player's own lock.
    if fish.locked == true then
        return true
    end

    if Config.AutoSellKeepHuge and fish.isHuge == true then
        return true
    end

    if selectedKeepFish(fish.fishId) then
        return true
    end

    if isQuestProtectedFish(data, fish) then
        return true
    end

    local weight = tonumber(fish.weight) or 0
    local threshold = math.max(0, tonumber(Config.AutoSellWeightThreshold) or 0)

    if Config.AutoSellWeightRule == "Keep At/Above" and threshold > 0 and weight >= threshold then
        return true
    end

    if Config.AutoSellWeightRule == "Keep At/Below" and threshold > 0 and weight <= threshold then
        return true
    end

    local keepValue = math.max(0, tonumber(Config.AutoSellKeepValueAtOrAbove) or 0)
    if keepValue > 0 and getFishSellValue(fish) >= keepValue then
        return true
    end

    local catalogFish = Catalog.Fish.GetById(fish.fishId)
    local rarity = catalogFish and catalogFish.rarity

    -- A rarity not selected for selling is automatically kept.
    if not rarity or Config.AutoSellRarities[rarity] ~= true then
        return true
    end

    return false
end

local function setKeepFishSelection(selected)
    table.clear(Config.AutoSellKeepFish)

    if type(selected) == "string" then
        selected = { selected }
    end

    if type(selected) ~= "table" then
        return
    end

    for key, value in pairs(selected) do
        local name = nil

        if type(value) == "string" then
            name = value
        elseif value == true and type(key) == "string" then
            name = key
        end

        if name then
            local id = FishNameToId[string.lower(name)]
            if id then
                Config.AutoSellKeepFish[id] = true
            end
        end
    end
end

local SELL_RARITY_OPTIONS = {
    "Common",
    "Uncommon",
    "Rare",
    "Epic",
    "Legendary",
    "Mythical",
    "Divine",
}

local function setSellRaritySelection(selected)
    for _, rarity in ipairs(SELL_RARITY_OPTIONS) do
        Config.AutoSellRarities[rarity] = false
    end

    if type(selected) == "string" then
        selected = { selected }
    end

    if type(selected) ~= "table" then
        return
    end

    for key, value in pairs(selected) do
        local rarity = nil

        if type(value) == "string" then
            rarity = value
        elseif value == true and type(key) == "string" then
            rarity = key
        end

        if rarity and Config.AutoSellRarities[rarity] ~= nil then
            Config.AutoSellRarities[rarity] = true
        end
    end
end

local STARTER_FISH_SELLER_CFRAME =
    CFrame.new(-31.806228637695, 19.615188598633, 406.953277587891)

local function getCharacterRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character.PrimaryPart
end

local function tweenCharacterTo(targetCFrame, speed)
    local root =
        getCharacterRoot()

    if not root
        or not targetCFrame then

        return false,
            "Character root unavailable"
    end

    if State.ActiveMovementTween then
        pcall(function()
            State.ActiveMovementTween:
                Cancel()
        end)

        State.ActiveMovementTween =
            nil
    end

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )
        or nil

    local distance =
        (
            root.Position
            - targetCFrame.Position
        ).Magnitude

    -- Keep movement at or below the requested 35 studs/sec cap.
    local studsPerSecond =
        math.clamp(
            tonumber(speed) or 35,
            8,
            35
        )

    Config.TravelTweenSpeed = 35
    Config.BossRegionTweenSpeed = 35

    if distance <= 1.5 then
        return true
    end

    local previousAutoRotate =
        humanoid
        and humanoid.AutoRotate
        or nil

    if humanoid then
        humanoid.AutoRotate = false
    end

    -- Clear old momentum once before the Tween.
    -- Do NOT force velocity to zero every frame; that was causing the
    -- small backwards replication tug / jitter seen in v18.5.
    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    local duration =
        math.max(
            0.15,
            distance / studsPerSecond
        )

    local tween =
        TweenService:Create(
            root,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame = targetCFrame,
            }
        )

    State.ActiveMovementTween =
        tween

    local ok, playbackState =
        pcall(function()
            tween:Play()
            return tween.Completed:Wait()
        end)

    if State.ActiveMovementTween
        == tween then

        State.ActiveMovementTween =
            nil
    end

    if humanoid
        and humanoid.Parent
        and previousAutoRotate ~= nil then

        humanoid.AutoRotate =
            previousAutoRotate
    end

    if not ok then
        return false,
            playbackState
    end

    if playbackState
        == Enum.PlaybackState.Cancelled then

        if State.BossPreemptRequested then
            return false,
                "Preempted by boss event"
        end

        return false,
            "Tween cancelled"
    end

    if playbackState
        ~= Enum.PlaybackState.Completed then

        return false,
            tostring(playbackState)
    end

    -- Give replication a short moment to settle without fighting it.
    task.wait(0.12)

    local refreshedRoot =
        getCharacterRoot()

    if not refreshedRoot then
        return false,
            "Character root lost after tween"
    end

    local finalDistance =
        (
            refreshedRoot.Position
            - targetCFrame.Position
        ).Magnitude

    -- If the game corrected the final location, report it instead of
    -- snapping the player forward again.
    if finalDistance > 16 then
        return false,
            "Position corrected after tween"
    end

    -- Clear any leftover drift once, after movement has fully completed.
    refreshedRoot.AssemblyLinearVelocity =
        Vector3.zero

    refreshedRoot.AssemblyAngularVelocity =
        Vector3.zero

    return true
end

local function getNearestLoadedFishSellerPart()
    local root = getCharacterRoot()
    local bestPart = nil
    local bestDistance = math.huge

    for _, instance in ipairs(workspace:GetDescendants()) do
        local lowerName = string.lower(instance.Name)

        if string.find(lowerName, "fish_seller", 1, true) then
            local part = nil

            if instance:IsA("Model") then
                part = instance.PrimaryPart
                    or instance:FindFirstChild("HumanoidRootPart", true)
            elseif instance:IsA("BasePart") then
                part = instance
            end

            if part and part:IsA("BasePart") then
                local distance = 0

                if root then
                    distance = (root.Position - part.Position).Magnitude
                end

                if not bestPart or distance < bestDistance then
                    bestPart = part
                    bestDistance = distance
                end
            end
        end
    end

    return bestPart
end

local function teleportToFishSeller()
    local root = getCharacterRoot()
    if not root then
        return nil, false
    end

    local returnCFrame = root.CFrame
    local sellerPart = getNearestLoadedFishSellerPart()
    local targetCFrame

    if sellerPart then
        targetCFrame = sellerPart.CFrame * CFrame.new(0, 0, -4)
    else
        targetCFrame =
            STARTER_FISH_SELLER_CFRAME
            * CFrame.new(0, 0, -4)
    end

    -- Auto Sell intentionally uses an instant teleport rather than the
    -- normal island tween. It only happens while fishing is idle.
    root.CFrame = targetCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.15)
    return returnCFrame, sellerPart ~= nil
end

local function resetFishingAfterSell()
    mouseUp()

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0

    -- The sell path only starts while fishing is already idle.
    -- Do not send another FishCancel or pretend the rod changed; both
    -- can leave the client loadout/backpack locked during a teleport.
    State.LastRodWatchCheck = 0
    State.RodMissingSince = 0
    State.RodRecoveryHoldUntil =
        os.clock() + 0.50

    State.LastPacketAt = os.clock()
    resetOPSession(0.10)

    State.AutoLookForceCheck = true
    State.AutoLookLastWatchAt = 0
end

local function returnFromFishSeller(returnCFrame)
    if not returnCFrame then
        return
    end

    local root = getCharacterRoot()
    if not root then
        return
    end

    root.CFrame = returnCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    task.wait(0.15)

    if Config.Enabled then
        resetFishingAfterSell()
    end
end

local function waitForInventorySale(beforeCount, expectedSold, timeoutSeconds)
    local targetCount =
        math.max(
            0,
            beforeCount - math.max(0, tonumber(expectedSold) or 0)
        )

    local deadline =
        os.clock() + math.max(0.5, timeoutSeconds or 3)

    while State.Alive and os.clock() < deadline do
        local data = getPlayerData()

        if data then
            local count = getFishCountAndCapacity(data)

            if expectedSold and expectedSold > 0 then
                if count <= targetCount then
                    return true
                end
            elseif count < beforeCount then
                return true
            end
        end

        task.wait(0.05)
    end

    return false
end

local function isFishingIdleForSell()
    if not Config.Enabled then
        return true
    end

    return State.Phase == "Idle"
end

local function toggleFishLock(uid)
    if not SellController or not uid then
        return false
    end

    local ok, status = pcall(function()
        return SellController:ToggleLock(uid)
    end)

    if not ok then
        return false
    end

    return status == nil or status == SellStatus.Ok
end

local function restoreTemporaryLocks()
    if not SellController then
        table.clear(State.AutoSellTempLocks)
        return
    end

    local data = getPlayerData()
    local existing = {}

    for index, fish in pairs(getFishInventory(data)) do
        local uid = getFishUid(index, fish)
        if uid then
            existing[uid] = fish
        end
    end

    for uid in pairs(State.AutoSellTempLocks) do
        local fish = existing[uid]
        if fish and fish.locked == true then
            pcall(function()
                SellController:ToggleLock(uid)
            end)
        end
    end

    table.clear(State.AutoSellTempLocks)
end

local function performFilteredSell(force)
    if State.AutoSellBusy then
        return false
    end

    if not SellController then
        State.AutoSellLastStatus = "SellController unavailable"
        State.AutoSellBlocked = true
        return false
    end

    local data = getPlayerData()
    if not data then
        State.AutoSellLastStatus = "Player data unavailable"
        return false
    end

    local count, capacity = getFishCountAndCapacity(data)

    if not force and count < capacity then
        State.AutoSellBlocked = false
        return false
    end

    if not isFishingIdleForSell() then
        State.AutoSellLastStatus = "Waiting for fishing to idle"
        return false
    end

    State.AutoSellBusy = true
    State.AutoSellBlocked = false
    State.AutoSellLastStatus = "Preparing filters"
    table.clear(State.AutoSellTempLocks)

    local sellable = 0

    for index, fish in pairs(getFishInventory(data)) do
        if shouldKeepFish(data, fish) then
            if fish.locked ~= true then
                local uid = getFishUid(index, fish)
                if uid and toggleFishLock(uid) then
                    State.AutoSellTempLocks[uid] = true
                end
            end
        else
            sellable += 1
        end
    end

    if sellable <= 0 then
        restoreTemporaryLocks()
        State.AutoSellBusy = false
        State.AutoSellLastStatus = "No fish matched sell filters"
        return false
    end

    -- Give the replicated lock state a moment to settle before SellAll.
    task.wait(0.12)

    State.AutoSellLastStatus = "Teleporting to Fish Seller"
    local returnCFrame = teleportToFishSeller()

    local status, coins, sold
    local ok, err = pcall(function()
        -- Always use the normal merchant-ranged sell path.
        status, coins, sold = SellController:SellAll()
    end)

    -- Do not snap back immediately. Wait for the replicated fish
    -- inventory to actually reflect the sale first.
    if ok and status == SellStatus.Ok then
        waitForInventorySale(
            count,
            tonumber(sold) or 0,
            3.0
        )
    else
        task.wait(0.15)
    end

    restoreTemporaryLocks()
    returnFromFishSeller(returnCFrame)

    State.AutoSellBusy = false

    if not ok then
        State.AutoSellLastStatus = "Sell error: " .. tostring(err)
        State.AutoSellBlocked = count >= capacity
        return false
    end

    coins = tonumber(coins) or 0
    sold = tonumber(sold) or 0
    State.AutoSellLastSold = sold
    State.AutoSellLastCoins = coins

    if status == SellStatus.Ok then
        State.AutoSellTotalSold += sold
        State.AutoSellTotalCoins += coins
        State.AutoSellLastStatus = string.format("Sold %d fish for %.0f Coins", sold, coins)
        State.AutoSellBlocked = false
        log("Auto Sell:", State.AutoSellLastStatus)
        return true
    end

    if status == SellStatus.OutOfRange then
        State.AutoSellLastStatus = "Fish Seller range check failed"
    elseif status == SellStatus.Empty then
        State.AutoSellLastStatus = "No unlocked matching fish to sell"
    elseif status == SellStatus.Busy then
        State.AutoSellLastStatus = "Sell server busy"
    else
        State.AutoSellLastStatus = "Sell failed (status " .. tostring(status) .. ")"
    end

    State.AutoSellBlocked = count >= capacity
    return false
end

-- Systems namespace declared near API initialization.

function Systems.stepAutoSell()
    if not Config.AutoSellEnabled or State.AutoSellBusy then
        return
    end

    local now = os.clock()
    if now - State.LastAutoSellCheck < Config.AutoSellCheckInterval then
        return
    end
    State.LastAutoSellCheck = now

    local data = getPlayerData()
    if not data then
        return
    end

    local count, capacity = getFishCountAndCapacity(data)

    if count < capacity then
        State.AutoSellBlocked = false
        return
    end

    if not isFishingIdleForSell() then
        return
    end

    task.spawn(function()
        performFilteredSell(false)
    end)
end

function Systems.shouldPauseFishingForAutoSell()
    if not Config.AutoSellEnabled then
        return false
    end

    if State.AutoSellBusy then
        return true
    end

    if State.AutoSellCapacity <= 0
        or State.AutoSellFishCount
            < State.AutoSellCapacity then

        return false
    end

    -- Finish the current OP catch first. Once the packet engine returns
    -- to Idle, pause before the next cast so Auto Sell can take ownership.
    return State.Phase == "Idle"
end

