--//============================================================
--// STORY END ACTION SETTINGS PERSISTENCE
--//
--// Keeps the end-action choices/count across a Roblox teleport
--// when TeleportSettings are available. getgenv is also used as
--// a same-session fallback. Kept in a nested scope so it does not
--// add pressure to the main Luau register budget.
--//============================================================

;(function()

    local TeleportService =
        game:GetService(
            "TeleportService"
        )


    local Key =
        "__AZ_STORY_END_ACTIONS"


    local Saved =
        GENV[Key]


    if type(Saved) ~= "table" then

        local Success,
            TeleportSaved =
            pcall(function()

                return TeleportService
                    :GetTeleportSetting(
                        Key
                    )
            end)


        if Success
            and type(TeleportSaved) == "table"
        then

            Saved =
                TeleportSaved
        end
    end


    if type(Saved) == "table" then

        Settings.AutoRetry =
            Saved.AutoRetry == true


        Settings.AutoLeave =
            Saved.AutoLeave == true


        Settings.AutoNext =
            Saved.AutoNext == true


        Settings.AutoLeaveAfterMatches =
            Saved.AutoLeaveAfterMatches == true


        Settings.LeaveAfterMatches =
            math.clamp(
                math.floor(
                    tonumber(
                        Saved.LeaveAfterMatches
                    ) or 5
                ),
                1,
                999
            )


        Settings.CompletedMatches =
            math.max(
                0,
                math.floor(
                    tonumber(
                        Saved.CompletedMatches
                    ) or 0
                )
            )
    end


    Settings.PersistEndActionSettings =
        function()

            local Data = {

                AutoRetry =
                    Settings.AutoRetry == true,

                AutoLeave =
                    Settings.AutoLeave == true,

                AutoNext =
                    Settings.AutoNext == true,

                AutoLeaveAfterMatches =
                    Settings.AutoLeaveAfterMatches == true,

                LeaveAfterMatches =
                    Settings.LeaveAfterMatches,

                CompletedMatches =
                    Settings.CompletedMatches,
            }


            GENV[Key] =
                Data


            pcall(function()

                TeleportService
                    :SetTeleportSetting(
                        Key,
                        Data
                    )
            end)


            -- Some executor environments do not preserve Roblox
            -- TeleportSettings reliably. Queue only the small settings
            -- table as a fallback; the main script can still auto-run
            -- normally in the destination place.
            pcall(function()

                local Queue =
                    queue_on_teleport
                    or queueonteleport


                if Queue then

                    Queue(
                        "getgenv().__AZ_STORY_END_ACTIONS={"
                        .. "AutoRetry="
                        .. tostring(Data.AutoRetry)
                        .. ",AutoLeave="
                        .. tostring(Data.AutoLeave)
                        .. ",AutoNext="
                        .. tostring(Data.AutoNext)
                        .. ",AutoLeaveAfterMatches="
                        .. tostring(Data.AutoLeaveAfterMatches)
                        .. ",LeaveAfterMatches="
                        .. tostring(Data.LeaveAfterMatches)
                        .. ",CompletedMatches="
                        .. tostring(Data.CompletedMatches)
                        .. "}"
                    )
                end
            end)
        end
end)()


--//============================================================
--// DUNGEON AUTOMATION SETTINGS PERSISTENCE
--//
--// Endless leave-wave is configured in the lobby but executes in
--// the dungeon place, so carry it across Roblox teleports. Loot
--// pickup is stored here too so executor auto-run/rejoin keeps it.
--// Nested scope avoids adding main-chunk locals.
--//============================================================

;(function()

    local TeleportService =
        game:GetService(
            "TeleportService"
        )


    local Key =
        "__AZ_DUNGEON_AUTOMATION"


    local Saved =
        GENV[Key]


