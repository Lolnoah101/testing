function Hub.QuestFns.applyQuestSelection(value, chosenCategory)
    if questUpdating then return end
    local picked = type(value)=="table" and (value[1] or next(value)) or value
    if type(picked)~="string" then picked="None" end
    local meta = QuestLookup[picked]
    if not meta then
        if picked~="None" then return end
        if Hub.QuestSelectedCategory ~= chosenCategory and Hub.QuestSelectedId ~= "None" then
            return
        end
        QuestSelected=nil
        Hub.QuestSelection,Hub.QuestSelectedId,Hub.QuestSelectedCategory="None","None","None"
        Hub.QuestSelectedData=nil
        Hub.QuestFns.resetQuestRuntimeForSelection()
        Hub.QuestFns.updateQuestDetails("Select a quest from one of the categories above")
        if QuestWatchSet then QuestWatchSet("Select a quest") end
        return
    end
    QuestSelected=picked
    Hub.QuestSelection,Hub.QuestSelectedId,Hub.QuestSelectedCategory=picked,meta.id,chosenCategory
    Hub.QuestSelectedData=meta
    Hub.QuestFns.resetQuestRuntimeForSelection()
    Hub.QuestFns.updateQuestDetails(Hub.QuestFns.questLabelFor(meta))
    if QuestWatchSet then QuestWatchSet(meta.name.."\nChecking status...") end
    questUpdating = true
    for category,dd in pairs(QuestDropdownByCategory) do
        if category ~= chosenCategory and dd then
            pcall(function() dd:Set("None") end)
        end
    end
    questUpdating = false
end
