    local function EvolutionMissing(
        Data,
        Character
    )

        local Definition =
            EvolutionConfig
            and EvolutionConfig[
                Character
            ]


        if not Definition then
            return nil
        end


        local Materials = {}

        local CurrencyMissing = {}


        if type(
            Definition.ultimate
        ) == "string"
        then

            for Entry in string.gmatch(
                Definition.ultimate,
                "[^|]+"
            ) do

                local Id,
                    Amount =
                    string.match(
                        Entry,
                        "^%s*([^,]+)%s*,%s*(%d+)%s*$"
                    )


                local Need =
                    tonumber(
                        Amount
                    )


                if Id and Need then

                    local Have =
                        tonumber(
                            Data
                            and Data.material
                            and Data.material[
                                tostring(Id)
                            ]
                        ) or 0


                    if Have < Need then

                        Materials[
                            tostring(Id)
                        ] =
                            Need - Have
                    end
                end
            end
        end


        for _, Requirement in ipairs(
            type(
                Definition.currencies
            ) == "table"
                and Definition.currencies
                or {}
        ) do

            local Currency =
                tostring(
                    Requirement.currency
                    or ""
                )

            local Need =
                tonumber(
                    Requirement.amount
                ) or 0


            local Have =
                CurrencyAmount(
                    Data,
                    Currency
                )


            if Currency ~= ""
                and Have < Need
            then

                CurrencyMissing[
                    Currency
                ] =
                    Need - Have
            end
        end


        return {
            materials =
                Materials,

            currencies =
                CurrencyMissing,
        }
    end


