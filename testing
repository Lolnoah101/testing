        local Completed =
            Data.achievements.completed or {}
        local Claimed =
            Data.achievements.claimed or {}

        for AchievementId, IsComplete in pairs(
            Completed
        ) do
            if IsComplete == true
                and Claimed[AchievementId] ~= true
            then
                return true
            end
        end

        return false
    end

    if Packets.achievementActionResult then
