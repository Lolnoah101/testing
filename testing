--//============================================================

local function GetSkillProcessingTime(
    CharacterName,
    SkillNumber
)

    local Config =
        CharacterConstants
            .charactersByName[
                CharacterName
            ]


    if not Config
        or not Config.skills
        or not Config.skills[
            SkillNumber
        ]
    then

        return nil
    end


    return Config
        .skills[
            SkillNumber
        ]
        .processingTime
end


local function TrySkill(
    SkillNumber
)

    if not IsAlive()
        or not GetNearbyEnemy()
    then

        return false
    end


    local Store =
        GetPlayerStore()


    if not Store
        or IsBlocking(Store)
        or HasActiveStun(Store)
    then

        return false
    end


    local Now =
        workspace:GetServerTimeNow()


    if PendingSkillRequestId then

        if Now >= PendingSkillExpiresAt then

            PendingSkillRequestId =
                nil

        else

            return false
        end
    end


    if Now < SkillBusyUntil
        or Now < SkillRetryAfter
    then

        return false
    end


    if not SkillCooldownReady(
        Store,
        SkillNumber
    )
    then

        return false
    end


    if SkillNumber == 4 then

        local Success,
            Progress =
            pcall(function()

                return Store
                    .state
                    .ultProgress
                    :get()
            end)


        if not Success
            or not Progress
            or Progress < 100
        then

            return false
        end
    end


    local SuccessCharacter,
        CharacterName =
        pcall(function()

            return Store
                .state
                .character
                :get()
        end)


    if not SuccessCharacter
        or not CharacterName
    then

        return false
    end


    local Character =
        GetCharacter()


    if not Character then
        return false
    end


    SkillSequence =
        SkillSequence + 1


    local RequestId =
        SkillSequence


    local Expires =
        Now + 5


    local Request = {

        id =
            RequestId,

        char =
            CharacterName,

        character =
            Character,

        skill =
            SkillNumber,

        expiresAt =
            Expires,

        predicted =
            SkillNumber < 4,
    }


    PendingSkillRequestId =
        RequestId


    PendingSkillExpiresAt =
        Expires


    if SkillNumber < 4 then

        local Processing =
            GetSkillProcessingTime(
                CharacterName,
                SkillNumber
            )


        if Processing then

            SkillBusyUntil =
                Now
                + Processing
        end
    end


    local Success =
        pcall(function()

            CharacterPackets
                .performSkill
                :fire(
                    Request
                )
        end)


    if not Success then

        PendingSkillRequestId =
            nil


        SkillRetryAfter =
            Now
            + SKILL_REJECT_BACKOFF


        return false
    end


    return true
end


pcall(function()

    CharacterPackets
        .skillPerformed
        :on(function(Data)

            if not Data
                or Data.player
                    ~= LocalPlayer
            then

                return
            end


            PendingSkillRequestId =
                nil


            if Data.accepted == false then

                SkillBusyUntil =
                    0


                SkillRetryAfter =
                    workspace:GetServerTimeNow()
                    + SKILL_REJECT_BACKOFF


                return
            end


            SkillRetryAfter =
                0


            if Data.processingTill then

                SkillBusyUntil =
                    Data.processingTill

            else

                SkillBusyUntil =
                    workspace:GetServerTimeNow()
            end
        end)
end)


local SkillOrder = {
    "Skill 1",
    "Skill 2",
    "Skill 3",
}


RunAutoSkills =
    function()

        if not GetNearbyEnemy() then
            return
        end


        if Settings.AutoUltimate then

            if TrySkill(4) then
                return
            end
        end


        if not Settings.AutoSkills then
            return
        end


        for _ = 1, #SkillOrder do

            if SkillCursor > #SkillOrder then
                SkillCursor = 1
            end


            local SkillName =
                SkillOrder[
                    SkillCursor
                ]


            SkillCursor =
                SkillCursor + 1


            if Settings.SelectedSkills[
                SkillName
            ]
            then

                local Number =
                    tonumber(
                        SkillName:match(
                            "%d+"
                        )
                    )


                if Number
                    and TrySkill(
                        Number
                    )
                then

                    return
                end
            end
        end
    end


