-- AUTO COMMAND V22 (regular pet command, not the paid AutoCommand setting).
-- The game's CombatController sends SetTarget(model) when the player manually
-- selects an enemy, using ClientState.SetTarget. We automate that *normal*
-- command here instead of attempting to grant or spoof gamepass ownership.
local COMMAND_CHECK_INTERVAL = 0.35
local COMMAND_MAX_RANGE = 85

local function commandEnemyInfo(model, root)
    if typeof(model) ~= "Instance" or not model:IsA("Model") then return nil end
    if not model:IsDescendantOf(Workspace) then return nil end
    if model == Player.Character or Players:GetPlayerFromCharacter(model) then return nil end
    if model:GetAttribute("EnemyId") == nil and model:GetAttribute("Species") == nil
        and model:GetAttribute("IsBoss") ~= true then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local hp = tonumber(model:GetAttribute("Health"))
    if hum and hum.Health <= 0 then return nil end
    if hp ~= nil and hp <= 0 then return nil end
    local part = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart", true)
    if not part or not part:IsA("BasePart") then return nil end
    local dist = (root.Position - part.Position).Magnitude
    if dist > COMMAND_MAX_RANGE then return nil end
    -- Main-island targets should not be stray dungeon enemies, and vice versa.
    local dungeonTag = model:GetAttribute("Dungeon")
    local tagged = dungeonTag ~= nil and dungeonTag ~= false and dungeonTag ~= ""
    if game.PlaceId == 131528475614757 and not tagged then return nil end
    if game.PlaceId ~= 131528475614757 and tagged then return nil end
    return dist
end

local function chooseCommandTarget(root)
    -- Pet commands keep running during tame/release. This changes only the
    -- normal pet-target selection, not the player's spirit approach.
    -- Keep the pet target aligned with the already-selected farm enemy.
    local preferred = game.PlaceId == 131528475614757
        and Aux.commandDungeonTarget or (Aux.autoMobFarm and Aux.mobFarmTargetModel)
    if preferred and commandEnemyInfo(preferred, root) then return preferred end

    -- With no active farm target, command pets toward the nearest loaded enemy.
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then return nil end
    local nearest, bestDistance = nil, math.huge
    for _, candidate in ipairs(folder:GetDescendants()) do
        if candidate:IsA("Model") then
            local distance = commandEnemyInfo(candidate, root)
            if distance and distance < bestDistance then
                nearest, bestDistance = candidate, distance
            end
        end
    end
    return nearest
end

