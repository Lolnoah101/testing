function Hub:V69GoTo(point,label,radius,actor)
    local char,root=myCharacter()
    if not char or not root or typeof(point)~="Vector3" then
        return false,"Waiting for target location"
    end
    radius=radius or 10
    local reference=point
    if typeof(actor)=="Instance" and actor.Parent then
        local rootPart
        if actor:IsA("Model") then
            rootPart=actor:FindFirstChild("HumanoidRootPart",true)
                or actor.PrimaryPart or actor:FindFirstChild("Head",true)
        elseif actor:IsA("BasePart") then rootPart=actor end
        if rootPart and rootPart:IsA("BasePart") then
            reference=rootPart.Position
        end
    end
    local flat=(Vector3.new(root.Position.X,0,root.Position.Z)
        -Vector3.new(reference.X,0,reference.Z)).Magnitude
    local yDiff=math.abs(root.Position.Y-reference.Y)
    -- A character on the roof can be within the old 10-stud 3D radius;
    -- require roughly the same floor before accepting arrival.
    if flat<=radius and yDiff<=5.3 then return true,"At "..label end
    local E=self.V44
    local now=os.clock()
    if now>=(E.V69StreamAt or 0) then
        E.V69StreamAt=now+0.8
        task.spawn(function()
            pcall(function() LocalPlayer:RequestStreamAroundAsync(reference,2) end)
        end)
    end
    if now<(E.V69TeleportAt or 0) then return false,"Approaching "..label end
    E.V69TeleportAt=now+0.14
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances=actor and {char,actor} or {char}
    params.RespectCanCollide=true
    local offsets={Vector3.new(5,0,0),Vector3.new(-5,0,0),
        Vector3.new(0,0,5),Vector3.new(0,0,-5),
        Vector3.new(4,0,4),Vector3.new(-4,0,-4),
        Vector3.new(4,0,-4),Vector3.new(-4,0,4),
        Vector3.new(7,0,0),Vector3.new(0,0,7)}
    local landing,best=nil,math.huge
    for _,offset in ipairs(offsets) do
        -- Starting near the NPC's feet/head prevents an overhead roof from
        -- ever being selected as ground; reject far lower platforms too.
        local rayStart=reference+offset+Vector3.new(0,1.6,0)
        local hit=workspace:Raycast(rayStart,Vector3.new(0,-18,0),params)
        if hit and hit.Instance and hit.Instance.CanCollide
          and hit.Material~=Enum.Material.Water and hit.Normal.Y>=0.58
          and math.abs(hit.Position.Y-reference.Y)<=8.5 then
            local candidate=hit.Position+Vector3.new(0,3.1,0)
            if math.abs(candidate.Y-reference.Y)<=5.3 then
                local score=(candidate-reference).Magnitude
                if score<best then best=score;landing=candidate end
            end
        end
    end
    if not landing then
        return false,"Ground near "..label.." not streamed (roof ignored)"
    end
    local look=Vector3.new(reference.X,landing.Y,reference.Z)
    if (look-landing).Magnitude<0.1 then look=landing+root.CFrame.LookVector end
    local moved=pcall(function() char:PivotTo(CFrame.lookAt(landing,look)) end)
    if not moved then return false,"Teleport failed near "..label end
    local afterFlat=(Vector3.new(root.Position.X,0,root.Position.Z)
        -Vector3.new(reference.X,0,reference.Z)).Magnitude
    return afterFlat<=radius and math.abs(root.Position.Y-reference.Y)<=5.3,
        "Approaching "..label.." at NPC level"
end
