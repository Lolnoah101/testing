        local function CopySavable(
            Value,
            Depth
        )

            Depth = Depth or 0

            if Depth > 8 then
                return nil
            end


            local ValueType =
                typeof(Value)


            if ValueType == "boolean"
                or ValueType == "number"
                or ValueType == "string"
            then
                return Value
            end


            if ValueType ~= "table" then
                return nil
            end


            local Result = {}


            for Key, Child in pairs(Value) do

                local KeyType =
                    typeof(Key)


                if KeyType == "string"
                    or KeyType == "number"
                then

                    local SavedChild =
                        CopySavable(
                            Child,
                            Depth + 1
                        )


                    if SavedChild ~= nil then
                        Result[Key] =
                            SavedChild
                    end
                end
            end


            return Result
        end


        local function CaptureFlags()

            local Snapshot = {}


            local Success =
                pcall(function()

                    for Flag, Value in pairs(
                        Window.Flags
                    ) do

                        local Saved =
                            CopySavable(
                                Value,
                                0
                            )


                        if Saved ~= nil then
                            Snapshot[
                                tostring(Flag)
                            ] =
                                Saved
                        end
                    end
                end)


            if not Success then
                return nil
            end


            return Snapshot
        end


        local function WriteDisk(
            Snapshot
        )

            if type(writefile) ~= "function" then
                return false
            end


            if makefolder then
                pcall(
                    makefolder,
                    "AnimeZero"
                )
            end


            local Success =
                pcall(function()

                    writefile(
                        DiskFile,
                        HttpService:JSONEncode(
