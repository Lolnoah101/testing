    record.IdentityRefreshAt = os.clock() + 2
    queueLiveNpcLabel(record)
    Hub.Observed[model] = record
    local function bindAnimator(animator)
        if record.Animator == animator then return end
        record.Animator = animator
        local function captureEmergence(track)
            local name=tostring(track and track.Animation and track.Animation.Name or ""):lower()
            -- The billboard identity can arrive AFTER the spawn animation;
            -- remember positive emergence evidence independently of its name.
            if name:find("spawn",1,true) or name:find("emerg",1,true)
                or name:find("rise",1,true) or name:find("ground",1,true)
                or name:find("crawlout",1,true) then
                record.EmergingUntil=math.max(record.EmergingUntil or 0,os.clock()+3.8)
            end
        end
        table.insert(record.Signals, animator.AnimationPlayed:Connect(function(track)
            captureEmergence(track)
            local name = track and track.Animation and track.Animation.Name
            if name == "Death" or name == "DeathLoop" or name == "Dying"
                or name == "DeathAnim" or name == "KnockoutDeath" then
                -- An animation name alone is not server-confirmed death.
                -- Keep the lock if the humanoid still has health.
                if modelDeadOrDespawning(model,hum) then
