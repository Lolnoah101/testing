--========================================================
-- FROSTY COLOR MATCHING
--========================================================

local function FrostyColorDifference(
    A,
    B
)
    if typeof(A) ~= "Color3"
        or typeof(B) ~= "Color3"
    then
        return math.huge
    end

    return
        math.abs(A.R - B.R)
        + math.abs(A.G - B.G)
        + math.abs(A.B - B.B)
end

local function FrostyColorsMatch(
    A,
    B
)
    return FrostyColorDifference(
        A,
        B
    ) <= 0.01
end

local function GetMatchingFrostPrompt(
    WantedColor
)
    if typeof(WantedColor)
        ~= "Color3"
    then
        return nil
    end

    local FrostyJob =
        GetFrostyJob()

    local Versions =
        FrostyJob
        and FrostyJob:FindFirstChild("Versions")

    if not Versions then
        return nil
    end

    local BestPrompt = nil
    local BestDifference = math.huge

    for _, Object in ipairs(
        Versions:GetDescendants()
    ) do
        if Object:IsA("ProximityPrompt")
            and Object.ObjectText == "Grab"
        then
            local Part =
                GetPromptPart(
                    Object
                )

            if Part then
                local Difference =
                    FrostyColorDifference(
                        Part.Color,
                        WantedColor
                    )

                if Difference < BestDifference then
                    BestDifference = Difference
                    BestPrompt = Object
                end
            end
        end
    end

    -- These colors are authored as exact Color3 values, but
    -- keep a tiny tolerance for serialization differences.
    if BestPrompt
        and BestDifference <= 0.03
    then
        return BestPrompt
    end

    return nil
end

--========================================================
-- FROSTY PROMPT POSITION / RANGE
--========================================================

local function GetFrostyPromptPosition(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local Parent =
        Prompt.Parent

    if Parent:IsA("Attachment") then
        return Parent.WorldPosition
    end

    local Part =
        GetPromptPart(
            Prompt
        )

    if Part then
        return Part.Position
    end

    return nil
end

local function GetFrostyPromptDistance(
    Prompt
)
    local Position =
        GetFrostyPromptPosition(
            Prompt
        )

    if not Position then
        return math.huge
    end

    return (
        GetRootPart().Position
        - Position
    ).Magnitude
end

local function IsFrostyPromptInRange(
    Prompt,
    IgnoreEnabled
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if not IgnoreEnabled
        and not Prompt.Enabled
    then
        return false
    end

    local Position =
        GetFrostyPromptPosition(
            Prompt
        )

    if not Position then
        return false
    end

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 6

    -- Stay comfortably inside the real prompt range.
    local SafeDistance =
        math.max(
            1.5,
            MaxDistance - 0.75
        )

    return (
        GetRootPart().Position
        - Position
    ).Magnitude <= SafeDistance
end

--========================================================
-- FROSTY GROUND / APPROACH
--========================================================

local function RequestFrostyStreaming(
    Position
)
    if not Position then
        return
    end

    task.spawn(function()
        pcall(function()
            Player:RequestStreamAroundAsync(
                Position,
                1.25
            )
        end)
    end)
end

local function GetFrostyGroundPoint(
    Position
)
    if not Position then
        return nil
    end

    local Excludes = {
        GetCharacter()
    }

    local FrostyJob =
        GetFrostyJob()

    if FrostyJob then
        table.insert(
            Excludes,
            FrostyJob
        )
    end

    local NPC =
        GetFrostyNPC()

    if NPC then
        table.insert(
            Excludes,
            NPC
        )
    end

    local Params =
        RaycastParams.new()

    Params.FilterType =
        Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances =
        Excludes

    Params.IgnoreWater = false

    local Origin =
        Position
        + Vector3.new(
            0,
            8,
            0
        )

    for _ = 1, 8 do
        local Result =
            Workspace:Raycast(
                Origin,
                Vector3.new(
                    0,
                    -40,
                    0
                ),
                Params
            )

        if not Result then
            break
        end

        if Result.Instance
            and Result.Instance.CanCollide
        then
            return Result.Position
        end

        if Result.Instance then
            table.insert(
                Excludes,
                Result.Instance
            )

            Params.FilterDescendantsInstances =
                Excludes

            Origin =
                Result.Position
                - Vector3.new(
                    0,
                    0.05,
                    0
                )
        else
            break
        end
    end

    return Position
end

local function GetFrostyApproachCFrame(
    Prompt
)
    local PromptPosition =
        GetFrostyPromptPosition(
            Prompt
        )

    if not PromptPosition then
        return nil
    end

    RequestFrostyStreaming(
        PromptPosition
    )

    local RootPart =
        GetRootPart()

    local RootHeight =
        GetRootHeight()

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 6

    local Radius =
        math.clamp(
            MaxDistance - 1.25,
            3,
            5
        )

    local FlatAway =
        Vector3.new(
            RootPart.Position.X
                - PromptPosition.X,
            0,
            RootPart.Position.Z
                - PromptPosition.Z
        )

    if FlatAway.Magnitude < 0.05 then
        FlatAway =
            Vector3.new(
                0,
                0,
                1
            )
    else
        FlatAway =
            FlatAway.Unit
    end

    local Angles = {
        0,
        30,
        -30,
        60,
        -60,
        90,
        -90,
        135,
        -135,
        180,
    }

    local Fallback = nil

    for _, Degrees in ipairs(
        Angles
    ) do
        local Direction =
            CFrame.Angles(
                0,
                math.rad(Degrees),
                0
            ):VectorToWorldSpace(
                FlatAway
            )

        local Approximate =
            PromptPosition
            + (Direction * Radius)

        local Ground =
            GetFrostyGroundPoint(
                Approximate
            )

        if Ground then
            local Candidate =
                Ground
                + Vector3.new(
                    0,
                    RootHeight,
                    0
                )

            if not Fallback then
                Fallback =
                    CFrame.new(
                        Candidate
                    )
            end

            local TestPath =
                ComputePath(
                    RootPart.Position,
                    Candidate
                )

            if TestPath then
                return CFrame.new(
                    Candidate
                )
            end
        end
    end

    return Fallback
end

local function MoveToFrostyPrompt(
    Prompt,
    Label
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if IsFrostyPromptInRange(
        Prompt,
        true
    ) then
        return true
    end

    local Target =
        GetFrostyApproachCFrame(
            Prompt
        )

    if not Target then
        warn(
            "[Frosty] Missing approach target for:",
            Label or "prompt"
        )

        return false
    end

    print(
        "[Frosty] Going to:",
        Label or "prompt"
    )

    local Reached =
        MoveToJobTarget(
            Target,

            function()
                return Settings.AutoFrosty
            end
        )

    if not Reached
        and Settings.AutoFrosty
    then
        -- If we are far from Frosty, stage at the job's Area
        -- marker and retry the short interaction approach.
        local Area =
            GetFrostyAreaPart()

        if Area
            and Area.Parent
        then
            local Ground =
                GetFrostyGroundPoint(
                    Area.Position
                )

            if Ground then
                print(
                    "[Frosty] Retrying from job area"
                )

                MoveToJobTarget(
                    CFrame.new(
                        Ground
                        + Vector3.new(
                            0,
                            GetRootHeight(),
                            0
                        )
                    ),

                    function()
                        return Settings.AutoFrosty
                    end
                )

                task.wait(0.15)

                Target =
                    GetFrostyApproachCFrame(
                        Prompt
                    )

                if Target then
                    Reached =
                        MoveToJobTarget(
                            Target,

                            function()
                                return Settings.AutoFrosty
                            end
                        )
                end
            end
        end
    end

    if IsFrostyPromptInRange(
        Prompt,
        true
    ) then
        return true
    end

    return Reached
        and GetFrostyPromptDistance(
            Prompt
        ) <= (
            (tonumber(
                Prompt.MaxActivationDistance
            ) or 6)
            + 0.5
        )
end

--========================================================
-- FROSTY TRIGGER / WAIT
--========================================================

local function TriggerFrostyPromptUntil(
    Prompt,
    Completed,
    Timeout
)
    Timeout = Timeout or 5

    local Started = os.clock()
    local LastTrigger = 0

    while Settings.AutoFrosty
        and os.clock() - Started < Timeout
    do
        if Completed
            and Completed()
        then
            return true
        end

        if not Prompt
            or not Prompt.Parent
        then
            return Completed
                and Completed()
                or false
        end

        if Prompt.Enabled
            and IsFrostyPromptInRange(
                Prompt,
                false
            )
            and os.clock() - LastTrigger
                >= Settings.FrostyRetryDelay
        then
            TriggerPrompt(
                Prompt
            )

            LastTrigger =
                os.clock()
        end

        task.wait(0.05)
    end

    return Completed
        and Completed()
        or false
end

local function WaitForFrostyPromptEnabled(
    Prompt,
    Timeout
)
    Timeout =
        Timeout
        or Settings.FrostyPromptWaitTimeout

    local Started = os.clock()

    while Settings.AutoFrosty
        and os.clock() - Started < Timeout
    do
        if Prompt
            and Prompt.Parent
            and Prompt.Enabled
        then
            return true
        end

        task.wait(0.05)
    end

    return false
end

--========================================================
-- FROSTY ACTIVE STATE
--========================================================

local function IsFrostyJobActive()
    local StartPrompt =
        GetFrostyStartPrompt()

    if StartPrompt
        and StartPrompt.Parent
    then
        FrostyKnownActive =
            StartPrompt.ObjectText
            == "End Frosty Job"

        return FrostyKnownActive
    end

    if GetFrostyNPC()
        or Player:FindFirstChild("CurrentFrost")
    then
        FrostyKnownActive = true
        return true
    end

    return FrostyKnownActive
end

--========================================================
-- START FROSTY JOB
--========================================================

local function StartFrostyJobState()
    if IsFrostyJobActive() then
        return true
    end

    local Prompt =
        GetFrostyStartPrompt()

    if not Prompt
        or not Prompt.Parent
    then
        local Area =
            GetFrostyAreaPart()

        if Area then
            RequestFrostyStreaming(
                Area.Position
            )
        end

        return false
    end

    if not MoveToFrostyPrompt(
        Prompt,
        "job start"
    ) then
        return false
    end

    print(
        "[Frosty] Starting job"
    )

    local Started =
        TriggerFrostyPromptUntil(
            Prompt,

            function()
                if FrostyKnownActive then
                    return true
                end

                local Current =
                    GetFrostyStartPrompt()

                return Current
                    and Current.Parent
                    and Current.ObjectText
                        == "End Frosty Job"
            end,

            6
        )

    if Started then
        FrostyKnownActive = true
        task.wait(0.35)
    end

    return Started
end

--========================================================
-- DISPOSE WRONG / STALE FROST
--========================================================

local function DisposeCurrentFrost()
    local Current =
        Player:FindFirstChild("CurrentFrost")

    if not Current then
        return true
    end

    local Prompt =
        GetFrostyDisposePrompt()

    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if not MoveToFrostyPrompt(
        Prompt,
        "dispose"
    ) then
        return false
    end

    print(
        "[Frosty] Disposing held frost"
    )

    return TriggerFrostyPromptUntil(
        Prompt,

        function()
            return Player:FindFirstChild(
                "CurrentFrost"
            ) == nil
        end,

        5
    )
end

--========================================================
-- GRAB MATCHING FROST
--========================================================

local function GrabMatchingFrost(
    WantedColor
)
    if typeof(WantedColor)
        ~= "Color3"
    then
        return false
    end

    local Prompt =
        GetMatchingFrostPrompt(
            WantedColor
        )

    if not Prompt
        or not Prompt.Parent
    then
        warn(
            "[Frosty] Matching frost machine not found"
        )

        return false
    end

    WaitForFrostyPromptEnabled(
        Prompt,
        2.5
    )

    if not MoveToFrostyPrompt(
        Prompt,
        "matching frost"
    ) then
        return false
    end

    print(
        "[Frosty] Grabbing matching frost"
    )

    local Grabbed =
        TriggerFrostyPromptUntil(
            Prompt,

            function()
                local _, CurrentValue =
                    GetFrostyCurrentValue()

                return CurrentValue ~= nil
            end,

            5
        )

    if not Grabbed then
        return false
    end

    local _, CurrentValue =
        GetFrostyCurrentValue()

    if FrostyColorsMatch(
        CurrentValue,
        WantedColor
    ) then
        print(
            "[Frosty] Matching frost grabbed"
        )

        return true
    end

    warn(
        "[Frosty] Held frost does not match customer - disposing"
    )

    DisposeCurrentFrost()

    return false
end

--========================================================
-- DELIVER FROST TO CUSTOMER
--========================================================

local function DeliverFrostToCustomer()
    local NPC =
        GetFrostyNPC()

    if not NPC then
        return false
    end

    local Prompt =
        GetFrostyNPCPrompt()

    if not Prompt then
        local Started = os.clock()

        while Settings.AutoFrosty
            and os.clock() - Started
                < Settings.FrostyCustomerWaitTimeout
        do
            Prompt =
                GetFrostyNPCPrompt()

            if Prompt then
                break
            end

            if not GetFrostyNPC() then
                return true
            end

            task.wait(0.1)
        end
    end

    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    WaitForFrostyPromptEnabled(
        Prompt,
        2.5
    )

    if not MoveToFrostyPrompt(
        Prompt,
        "customer"
    ) then
        return false
    end

    print(
        "[Frosty] Delivering frost"
    )

    local Delivered =
        TriggerFrostyPromptUntil(
            Prompt,

            function()
                -- A successful order removes the assigned NPC and/or
                -- clears CurrentFrost.  Accept either transition and
                -- let the next loop reconstruct the live state.
                if GetFrostyNPC() == nil then
                    return true
                end

                return Player:FindFirstChild(
                    "CurrentFrost"
                ) == nil
            end,

            6
        )

    if Delivered then
        print(
            "[Frosty] Order delivered"
        )

        task.wait(0.25)
    end

    return Delivered
end

--========================================================
-- AUTO FROSTY LOOP
--========================================================

local function StartAutoFrosty()
    if FrostyThread then
        return
    end

    FrostyThread =
        task.spawn(function()

            print(
                "[Frosty] Started"
            )

            local Success, Error =
                xpcall(
                    function()
                        while Settings.AutoFrosty do
                            if not IsFrostyJobActive() then
                                StartFrostyJobState()

                            else
                                local NPC =
                                    GetFrostyNPC()

                                local Current,
                                    CurrentValue =
                                    GetFrostyCurrentValue()

                                if not NPC then
                                    -- Usually this is just the short delay
                                    -- between customers.  If a stale frost is
                                    -- still being held, clear it after a moment.
                                    if Current then
                                        task.wait(0.35)

                                        if Settings.AutoFrosty
                                            and not GetFrostyNPC()
                                            and Player:FindFirstChild(
                                                "CurrentFrost"
                                            )
                                        then
                                            DisposeCurrentFrost()
                                        end
                                    else
                                        task.wait(
                                            Settings.FrostyStateDelay
                                        )
                                    end

                                else
                                    local WantedColor =
                                        GetFrostyCustomerColor()

                                    if not WantedColor then
                                        task.wait(
                                            Settings.FrostyStateDelay
                                        )

                                    elseif Current then
                                        if FrostyColorsMatch(
                                            CurrentValue,
                                            WantedColor
                                        ) then
                                            DeliverFrostToCustomer()
                                        else
                                            print(
                                                "[Frosty] Wrong frost held - disposing"
                                            )

                                            DisposeCurrentFrost()
                                        end

                                    else
                                        GrabMatchingFrost(
                                            WantedColor
                                        )
                                    end
                                end
                            end

                            task.wait(
                                Settings.FrostyStateDelay
                            )
                        end
                    end,

                    debug.traceback
                )

            FrostyThread = nil

            if not Success then
                warn(
                    "[Frosty] Worker error:\n"
                    .. tostring(Error)
                )

                if Settings.AutoFrosty then
                    task.wait(0.5)
                    StartAutoFrosty()
                    return
                end
            end

            print(
                "[Frosty] Stopped"
            )
        end)
end

local function MoveToFrostyEndPromptForExit(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if IsFrostyPromptInRange(
        Prompt,
        true
    ) then
        return true
    end

    local Target =
        GetFrostyApproachCFrame(
            Prompt
        )

    if Target then
        local Reached =
            MoveToJobTarget(
                Target,

                function()
                    return FrostyExitBusy
                end
            )

        if IsFrostyPromptInRange(
            Prompt,
            true
        ) then
            return true
        end

        if Reached then
            return GetFrostyPromptDistance(
                Prompt
            ) <= (
                (tonumber(
                    Prompt.MaxActivationDistance
                ) or 6)
                + 0.5
            )
        end
    end

    return false
end

local function EndFrostyJobGracefully()
    if FrostyExitBusy then
        return
    end

    FrostyExitBusy = true

    task.spawn(function()
        print(
            "[Frosty] Toggle off - ending in-game job"
        )

        StopJobMovement()
        task.wait(0.15)

        if not IsFrostyJobActive() then
            print(
                "[Frosty] In-game job already ended"
            )

            FrostyExitBusy = false
            return
        end

        local Area =
            GetFrostyAreaPart()

        if Area
            and Area.Parent
        then
            RequestFrostyStreaming(
                Area.Position
            )

            if not GetFrostyStartPrompt() then
                local Ground =
                    GetFrostyGroundPoint(
                        Area.Position
                    )

                if Ground then
                    print(
                        "[Frosty] Returning to job terminal"
                    )

                    MoveToJobTarget(
                        CFrame.new(
                            Ground
                            + Vector3.new(
                                0,
                                GetRootHeight(),
                                0
                            )
                        ),

                        function()
                            return FrostyExitBusy
                        end
                    )
                end
            end
        end

        local Started = os.clock()
        local Prompt = GetFrostyStartPrompt()

        while FrostyExitBusy
            and (not Prompt or not Prompt.Parent)
            and os.clock() - Started < 4
        do
            if Area then
                RequestFrostyStreaming(
                    Area.Position
                )
            end

            task.wait(0.1)
            Prompt = GetFrostyStartPrompt()
        end

        if not Prompt
            or not Prompt.Parent
        then
            warn(
                "[Frosty] Could not find end-job prompt"
            )

            FrostyExitBusy = false
            return
        end

        if Prompt.ObjectText
            ~= "End Frosty Job"
        then
            FrostyKnownActive = false

            print(
                "[Frosty] In-game job already ended"
            )

            FrostyExitBusy = false
            return
        end

        if not MoveToFrostyEndPromptForExit(
            Prompt
        ) then
            warn(
                "[Frosty] Could not reach end-job prompt"
            )

            FrostyExitBusy = false
            return
        end

        print(
            "[Frosty] Ending job"
        )

        local LastTrigger = 0
        local EndStarted = os.clock()

        while FrostyExitBusy
            and Prompt.Parent
            and Prompt.ObjectText
                == "End Frosty Job"
            and os.clock() - EndStarted < 7
        do
            if os.clock() - LastTrigger >= 0.75
                and IsFrostyPromptInRange(
                    Prompt,
                    true
                )
            then
                TriggerPrompt(
                    Prompt
                )

                LastTrigger = os.clock()
            end

            task.wait(0.05)
        end

        local Ended =
            not Prompt.Parent
            or Prompt.ObjectText
                ~= "End Frosty Job"
            or not FrostyKnownActive

        if Ended then
            FrostyKnownActive = false

            print(
                "[Frosty] In-game job ended"
            )
        else
            warn(
                "[Frosty] End-job prompt did not reset"
            )
        end

        FrostyExitBusy = false
    end)
end

local function StopAutoFrosty()
    Settings.AutoFrosty = false

    -- Stop farming and then press the real End Frosty Job
    -- interaction so the game fully closes the job state.
    StopJobMovement()
    EndFrostyJobGracefully()
end

