local function screenCenter()
    local camera = workspace.CurrentCamera
    if camera then
        local size = camera.ViewportSize
        return math.floor(size.X * 0.5), math.floor(size.Y * 0.5)
    end
    return 500, 400
end

local function mouseDown()
    if State.MouseHeld then
        return
    end

    local x, y = screenCenter()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    end)
    State.MouseHeld = true
end

local function mouseUp()
    if not State.MouseHeld then
        return
    end

    local x, y = screenCenter()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    State.MouseHeld = false
end

local function primaryClick()
    local x, y = screenCenter()

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.018)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)

    State.MouseHeld = false
    State.LastPrimaryClick = os.clock()
end

local function keyTap(keyCode, holdTime)
    holdTime = holdTime or 0.025

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(holdTime)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

