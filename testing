    -- V39 Train/Gameplay phase controller.
    -- Time only advances during a confirmed active weight session (training)
    -- or while actually inside an arena (gameplay). Queue waiting does not use
    -- the gameplay allowance; rebirth interruptions do not use training time.
    local grind = lobbyState.grind
    grind.save = function(force)
        if type(writefile) ~= "function" then return end
        local now = os.clock()
        if not force and now - grind.lastSave < 2.0 then return end
        grind.lastSave = now
        local ok, encoded = pcall(function()
            return game:GetService("HttpService"):JSONEncode({
                enabled = grind.enabled,
                phase = grind.phase,
                elapsed = math.max(0, grind.elapsed),
                minutes = grind.minutes,
                savedAt = os.time(),
            })
        end)
        if ok then pcall(writefile, grind.file, encoded) end
    end
    grind.restore = function()
        if type(readfile) ~= "function" then return false end
        local ok, decoded = pcall(function()
            local data = game:GetService("HttpService"):JSONDecode(readfile(grind.file))
            return data
        end)
        if not ok or type(decoded) ~= "table" or decoded.enabled ~= true then
            return false
        end
        -- Ignore abandoned cycle snapshots after a long offline period.
        local savedAt = tonumber(decoded.savedAt)
        if not savedAt or math.abs(os.time() - savedAt) > 12 * 3600 then
            return false
        end
        if decoded.phase ~= "training" and decoded.phase ~= "gameplay" then
            return false
        end
        grind.phase = decoded.phase
        grind.elapsed = math.clamp(tonumber(decoded.elapsed) or 0, 0, 86400)
        grind.minutes = math.clamp(tonumber(decoded.minutes) or grind.minutes, 1, 1440)
        return true
    end
    grind.setPhase = function(phase, now)
        if grind.phase == phase then return end
        grind.phase = phase
        grind.elapsed = 0
        grind.lastClock = now
        grind.lastQueueLeave = -100
        grind.lastTrainStop = -100
        lobbyState.queueIssued = false
        lobbyState.queueTries = 0
        lobbyState.queueRejected = false
        lobbyState.joinReadyAt = nil
        lobbyState.lastQueue = -100
        if phase == "gameplay" then
            lobbyState.queueStatus = "Grind cycle: gameplay phase"
        else
            lobbyState.queueStatus = "Grind cycle: training phase"
            -- Never carry a queue into the new training interval.
            if isQueued() then
                fireRemote("QueueLeave")
                grind.lastQueueLeave = now
            end
        end
        grind.save(true)
        pcall(function()
            window:Toast({title = phase == "training"
                and "Grind: Training" or "Grind: Gameplay"})
        end)
    end
    grind.tick = function(now)
        local delta = math.clamp(now - grind.lastClock, 0, 5)
        grind.lastClock = now
        if not grind.enabled then return end
        if grind.phase == "training" then
            local active = player:GetAttribute("Training")
            local actuallyTraining = inLobby() and type(active) == "string" and active ~= ""
            if actuallyTraining and lobbyState.rebirthPhase == "idle" then
                grind.elapsed = grind.elapsed + delta
            end
            if grind.elapsed >= grind.minutes * 60
                and lobbyState.rebirthPhase == "idle" then
                grind.setPhase("gameplay", now)
            end
        else
            -- While matchmade, count actual arena time only, never queue delays.
            if not inLobby() then
                grind.elapsed = grind.elapsed + delta
            end
            if grind.elapsed >= grind.minutes * 60 and inLobby() then
                -- Finish the current arena round/session before returning to weights.
                grind.setPhase("training", now)
            end
        end
        grind.save(false)
    end
    -- The normal matchmaking controller does not require training to stop
    -- before QueueJoin. Observe server results rather than guessing acceptance
    -- from whether FireServer returned without throwing.
    local function recordQueueStatus(packet)
        if not lobbyState.alive or type(packet) ~= "table" then return end
        local raw = packet.status or packet.state
        if type(raw) ~= "string" or raw == "" then return end
        local status = raw:lower()
        lobbyState.queueServerStatus = status
        if not lobbyState.play then return end
        if status == "rejected" or status == "failed" or status == "error" then
            lobbyState.queueRejected = true
            lobbyState.queueIssued = false
            local reason = packet.reason or packet.message
            if type(reason) ~= "string" then reason = status end
            lobbyState.queueStatus = "Server declined queue: " .. reason:sub(1, 110)
        elseif queueEnded[status] then
            -- A normal queue cancellation is not a permanent rejection.
            lobbyState.queueIssued = false
        else
            lobbyState.queueRejected = false
            lobbyState.queueIssued = true
        end
    end
    if clientState and type(clientState.onMatchEvent) == "function" then
        local ok, con = pcall(clientState.onMatchEvent, "queueStatus", recordQueueStatus)
        if ok and con and type(con.Disconnect) == "function" then
            lobbyState.queueEventConn = con
        end
    else
        local event = remotes and remotes:FindFirstChild("MatchEvent")
        if event and event:IsA("RemoteEvent") then
            lobbyState.queueEventConn = event.OnClientEvent:Connect(function(kind, packet)
                if type(kind) == "table" then
                    if (kind.t or kind.kind or kind.type) == "queueStatus" then
                        recordQueueStatus(kind.payload or kind.data or kind)
                    end
                elseif kind == "queueStatus" then
                    recordQueueStatus(packet)
                end
            end)
        end
    end
