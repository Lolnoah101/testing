function Hub:V61SkillCooldown(skill,nowServer)
    local E=self.V44
    local known=E.AbilityCooldowns and E.AbilityCooldowns[skill] or nil
    local remaining=math.max(0,(known or 0)-nowServer)
    local btn=self:V61SkillButton(skill)
    if btn then
        local cd=btn:FindFirstChild("CD")
        local label=btn:FindFirstChild("CDTime")
        if cd and cd:IsA("GuiObject") and cd.Visible then
            local parsed=label and tonumber(label.Text)
            remaining=math.max(remaining,parsed or 0.5)
        end
    end
    return remaining
end
function Hub:V44AbilitiesTick(now)
    local E=self.V44
    if not E.AutoAbilities or now<(E.AbilityAt or 0) then return end
    E.AbilityAt=now+0.25
    self:V61ConnectSkillCooldowns()
    E.AbilityFailures=E.AbilityFailures or {}
    E.AbilityCooldowns=E.AbilityCooldowns or {}
    if self.Runtime.Jobs["v61_ability"] then return end
    local char,root=myCharacter()
    if not char then E.AbilityStatus="Waiting for character";return end
    if char:HasTag("TrueStunned") or char:HasTag("Knocked") then
        E.AbilityStatus="Waiting for control of character";return
    end
    local target=self.QuestCombatActive and self.QuestTarget or self.FarmTarget
    local enemy=target and (target.Root or (target.Model and target.Model:FindFirstChild("HumanoidRootPart")))
    if not enemy or not enemy.Parent or (root.Position-enemy.Position).Magnitude>25 then
        E.AbilityStatus="Waiting for locked mob/boss";return
    end
    local keys={}
    for key,enabled in pairs(E.AbilityKeys or {}) do
        if enabled and ({Z=true,X=true,C=true,V=true,B=true})[key] then table.insert(keys,key) end
    end
    table.sort(keys)
    if #keys==0 then E.AbilityStatus="Select ability keys";return end
    local selectedKey,selectedSkill,selectedSource=nil,nil,nil
    local cooling,empty=0,0
    local serverNow=workspace:GetServerTimeNow()
    local nearest=math.huge
    for j=1,#keys do
        local i=((E.AbilityCursor or 0)+j-1)%#keys+1
        local key=keys[i]
        local name,source=self:V60EquippedSkill(key)
        if name then
            local remain=self:V61SkillCooldown(name,serverNow)
            local retryAt=E.AbilityFailures[name] or 0
            remain=math.max(remain,retryAt-now)
            if remain<=0 then
                selectedKey,selectedSkill,selectedSource=key,name,source
                E.AbilityCursor=i
                break
            end
            cooling+=1;nearest=math.min(nearest,remain)
        else empty+=1 end
    end
    if not selectedSkill then
        E.AbilityStatus=cooling>0 and string.format("Abilities cooling: %d; next %.1fs",cooling,nearest)
            or "Selected ability slots empty or locked"
        E.AbilityAt=now+math.min(1,math.max(0.2,nearest==math.huge and 1 or nearest))
        return
    end
    local skill=selectedSkill
    if not char:FindFirstChildOfClass("Tool") then
        E.AbilityStatus="Equip a weapon or Nen tool before using "..skill
        E.AbilityAt=now+1.0;return
    end
    -- Let the current M1 finish: new M1s would continuously re-lock the
    -- skill controller and prevent Z/X skills from ever being admitted.
    E.AbilityWaitSince=E.AbilityWaitSince or {}
    local waitingSince=E.AbilityWaitSince[skill] or now
    E.AbilityWaitSince[skill]=waitingSince
    -- Pause fresh M1s until a real skill opening occurs, rather than allowing
    -- Auto Attack to re-enter Attacking every frame and starve the skill forever.
    self.OffenseQuietUntil=math.max(self.OffenseQuietUntil or 0,now+0.65)
    if char:HasTag("Attacking") or char:HasTag("Recovery")
        or char:HasTag("UsingSkill") or char:HasTag("Blocking")
        or now<(self.DefenseUntil or 0) or self.DodgeActive then
        E.AbilityStatus="Preparing "..skill.." | awaiting combat recovery"
        E.AbilityAt=now+0.15
        if now-waitingSince>2.5 then E.AbilityWaitSince[skill]=now end
        return
    end
    E.AbilityWaitSince[skill]=nil
    local service=self:V44Service("SkillsService")
    E.AbilityStatus="Ability ready: "..skill.." ("..selectedKey..")"
    E.AbilityAt=now+0.85
    self:StartJob("v61_ability",nil,function(alive)
        if not alive() or not E.AutoAbilities then return end
        -- The actual skill_buttons module exports cast_touch(skill), which
        -- drives the same native cast_skill function as pressing the skill UI.
        local pg=LocalPlayer:FindFirstChild("PlayerScripts")
        local client=pg and pg:FindFirstChild("Client")
        local controllers=client and client:FindFirstChild("Controllers")
        local skillsController=controllers and controllers:FindFirstChild("SkillsController")
        local module=skillsController and skillsController:FindFirstChild("skill_buttons")
        local button=self:V61SkillButton(skill)
        if module and button and button:GetAttribute("Locked")~=true then
            local loaded,native=pcall(require,module)
            if loaded and type(native)=="table" and type(native.cast_touch)=="function" then
                local invoked,reason=pcall(native.cast_touch,skill)
                if invoked then
                    E.AbilityFailures[skill]=os.clock()+1.5
                    E.AbilityStatus="Native skill requested: "..selectedKey.." / "..skill
                    return
                else E.AbilityStatus="Native skill error: "..tostring(reason):sub(1,75) end
            end
        end
        if not service then
            local sent,reason=self:V66NativeAbilityKey(selectedKey)
            E.AbilityFailures[skill]=os.clock()+(sent and 1.8 or 3)
            E.AbilityStatus=sent and ("Skill key sent: "..selectedKey.." / "..skill)
                or ("Ability key unavailable: "..tostring(reason))
            return
        end
        local aim=enemy.Position
        local ok,reply=pcall(function() return service:UseSkill(skill,aim,false) end)
        if not ok then
            E.AbilityFailures[skill]=os.clock()+2.5
            E.AbilityStatus="Nen request error: "..skill
            return
        end
        local acknowledged,result=self:AwaitReply(reply,alive,3.5)
        if not alive() then return end
        if acknowledged and (result==true or (type(result)=="table" and result.Success==true)) then
            E.AbilityStatus="Nen cast acknowledged: "..skill
            if (E.AbilityCooldowns[skill] or 0)<=workspace:GetServerTimeNow() then
                E.AbilityFailures[skill]=os.clock()+1.4
            end
        else
            local reason=tostring(result)
            E.AbilityFailures[skill]=os.clock()+(reason:lower():find("cooldown",1,true) and 4 or 2.5)
            E.AbilityStatus="Nen request rejected: "..skill.." ("..reason:sub(1,70)..")"
        end
    end)
end
function Hub:V44StatChoice()
    local E=self.V44
    if not E.AutoStatBuild then return self.StatChoice end
    local direct={Strength="Strength",Nen="Nen",Weapons="Weapons",
        Tank="Durability",Stamina="Stamina"}
    if direct[E.StatBuild] then
        E.StatBuildStatus="Only "..direct[E.StatBuild]
        return direct[E.StatBuild]
    end
    -- Balanced/Hybrid are intentionally distributed builds.
    local weights=E.StatBuild=="Hybrid" and {3,2,3,2,1} or {1,1,1,1,1}
    local names={"Strength","Durability","Nen","Weapons","Stamina"}
    local best,pressure
    for i,name in ipairs(names) do
        local attr=self.StatKeys and self.StatKeys[name]
        if attr and weights[i]>0 then
            local stat=tonumber(LocalPlayer:GetAttribute(attr)) or 0
            if stat<160 then
                local score=stat/weights[i]
                if not pressure or score<pressure then best=name;pressure=score end
            end
        end
    end
    E.StatBuildStatus=best and (E.StatBuild.." distribution → "..best) or "All stats capped"
    return best
end
function Hub:V44WeaponScore(info)
    local score=0
    local function visit(stats,depth)
        if type(stats)~="table" or depth>2 then return end
        for key,value in pairs(stats) do
            if type(value)=="number" then
                local k=tostring(key):lower()
                if k:find("damage",1,true) or k:find("attack",1,true) then
                    score+=value*3
                elseif k:find("speed",1,true) or k:find("critical",1,true) then
                    score+=value
                elseif k:find("range",1,true) or k:find("reach",1,true) then
                    score+=value*.25
                end
            elseif type(value)=="table" then
                visit(value,depth+1)
            end
        end
    end
    visit(info,0)
    local rarities={Common=1,Uncommon=2,Rare=3,Legendary=4,Extraordinary=5,Mythical=6}
    return score+(rarities[info.Rarity] or 1)*.001
end
