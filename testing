--//============================================================
--// RUBBLE
--//============================================================

local function GetRubbleForArea(
    AreaNumber
)

    if not AreaNumber
        or AreaNumber < 1
    then

        return nil
    end


    local Map =
        GetCurrentMapConfig()


    if not Map
        or not Map.areas
    then

        return nil
    end


    local AreaConfig =
        Map.areas[
            AreaNumber
        ]


    if not AreaConfig
        or not AreaConfig.border
    then

        return nil
    end


    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    local WorldMap =
        World
        and World
            :FindFirstChild(
                "Map"
            )


    if not WorldMap then
        return nil
    end


    local Border =
        WorldMap
            :FindFirstChild(
                AreaConfig.border
            )


    if not Border then
        return nil
    end


    local Rubble =
        Border
            :FindFirstChild(
                "Rubble"
            )


    local Blocker =
        Border
            :FindFirstChild(
                "Blocker"
            )


    local RubbleBar =
        Blocker
        and Blocker
            :FindFirstChild(
                "RubbleBar"
            )


    local MaxHealth =
        Border:GetAttribute(
            "RubbleMaxHealth"
        )


    local Health = nil


    if MaxHealth ~= nil then

        Health =
            Border:GetAttribute(
                "RubbleHealth"
            )


        if Health == nil then
            Health = MaxHealth
        end
    end


    return {

        Area =
            AreaNumber,

        Border =
            Border,

        Rubble =
            Rubble,

        Blocker =
            Blocker,

        RubbleBar =
            RubbleBar,

        Health =
            Health,

        MaxHealth =
            MaxHealth,
    }
end


