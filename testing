-- V41 Anti AFK: monitor the actual game idle controller and send
-- periodic best-effort virtual user activity. Roblox can restrict virtual
-- input to certain client environments; failures are surfaced in the UI.
-- The game's IdleController listens to UserInputService input and Idled.
local antiAFKStats = {
    Requests = 0,
    AcceptedCalls = 0,
    LastTrigger = "Never",
    LastError = "None",
    LastRequestAt = 0,
    LastPlayerInputAt = os.clock(),
}
local UserInputService = game:GetService("UserInputService")
local idleTestBusy = false

local function renderAFKStatus()
    if not idleRuntime.Active or not running then return end
    local active = idleRuntime.AntiAFK
    setAFKStatus(string.format(
        "%s | Calls attempted: %d | Calls without errors: %d\nLast trigger: %s | Last error: %s\nRoblox may ignore synthetic input even if a call succeeds.",
        active and "ON" or "OFF", antiAFKStats.Requests,
        antiAFKStats.AcceptedCalls, antiAFKStats.LastTrigger,
        tostring(antiAFKStats.LastError)))
end

local function sendIdleKeepAlive(reason, forced)
    if not running or not idleRuntime.Active or
        (not forced and not idleRuntime.AntiAFK) or idleTestBusy then
        return
    end
    idleTestBusy = true
    antiAFKStats.Requests += 1
    antiAFKStats.LastTrigger = tostring(reason or "Unknown")
    antiAFKStats.LastRequestAt = os.clock()
    local ok, err = pcall(function()
        local camera = Workspace.CurrentCamera
        local cf = camera and camera.CFrame or CFrame.new()
        -- The original user-provided VirtualUser method, keeping Down/Up
        -- paired even when the first call fails.
        VirtualUser:CaptureController()
        VirtualUser:Button2Down(Vector2.new(0, 0), cf)
        task.wait(0.06)
        VirtualUser:Button2Up(Vector2.new(0, 0), cf)
    end)
    if ok then
        antiAFKStats.AcceptedCalls += 1
        antiAFKStats.LastError = "None"
    else
        antiAFKStats.LastError = tostring(err)
    end
    idleTestBusy = false
    renderAFKStatus()
end

-- Distinguish actual user input from the keep-alive test. Never treat
-- a successful VirtualUser call as proof Roblox reset its idle counter.
hookRuntimeConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if not processed then antiAFKStats.LastPlayerInputAt = os.clock() end
end))
hookRuntimeConnection(UserInputService.InputChanged:Connect(function(input, processed)
    if not processed and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        antiAFKStats.LastPlayerInputAt = os.clock()
    end
end))
hookRuntimeConnection(Player.Idled:Connect(function(idleSeconds)
    sendIdleKeepAlive("Player.Idled " .. tostring(math.floor(tonumber(idleSeconds) or 0)) .. "s")
end))

