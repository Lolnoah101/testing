--//============================================================
--// ENEMY VISUAL DATA
--//============================================================

local function GetEnemyVisualData(
    EnemyId,
    EnemyState
)

    local Model =
        GetEnemyModel(
            EnemyId
        )


    local RootPart = nil

    local Head = nil


    if Model then

        RootPart =
            Model
                :FindFirstChild(
                    "HumanoidRootPart"
                )


        Head =
            Model
                :FindFirstChild(
                    "Head"
                )
    end


    local RootCF


    if RootPart then

        RootCF =
            RootPart.CFrame

    else

        local Position =
            GetEnemyPosition(
                EnemyState
            )


        if not Position then
            return nil
        end


        RootCF =
            CFrame.new(
                Position
            )
    end


    local RootPosition =
        RootCF.Position


    local HeadPosition


    if Head
        and Head:IsA(
            "BasePart"
        )
    then

        HeadPosition =
            Head.Position

    else

        HeadPosition =
            RootPosition
            + Vector3.new(
                0,
                3,
                0
            )
    end


    local FeetPosition = nil


    if Model then

        local LowestY =
            math.huge


        for _, Name in ipairs({
            "LeftFoot",
            "RightFoot",
            "Left Foot",
            "Right Foot",
            "Left Leg",
            "Right Leg",
        }) do

            local Part =
                Model
                    :FindFirstChild(
                        Name
                    )


            if Part
                and Part:IsA(
                    "BasePart"
                )
            then

                local Bottom =
                    Part.Position.Y
                    - Part.Size.Y / 2


                if Bottom < LowestY then

                    LowestY =
                        Bottom


                    FeetPosition =
                        Vector3.new(
                            Part.Position.X,
                            Bottom,
                            Part.Position.Z
                        )
                end
            end
        end
    end


    if not FeetPosition then

        FeetPosition =
            RootPosition
            - Vector3.new(
                0,
                3,
                0
            )
    end


    return {

        Model =
            Model,

        RootPart =
            RootPart,

        RootCF =
            RootCF,

        RootPosition =
            RootPosition,

        HeadPosition =
            HeadPosition,

        FeetPosition =
            FeetPosition,
    }
end


--//============================================================
--// TARGET
--//============================================================

local function GetFreshFarmTarget()

    local Root =
        GetRoot()


    if not Root then

        CurrentTargetId = nil

        CurrentTargetState = nil

        return nil, nil
    end


    local Enemies =
        GetAllEnemies()


    if CurrentTargetId ~= nil then

        local FreshState =
            Enemies[
                CurrentTargetId
            ]


        if FreshState
            and GetEnemyHealth(
                FreshState
            ) > 0
        then

            CurrentTargetState =
                FreshState


            return CurrentTargetId,
                FreshState
        end


        CurrentTargetId = nil

        CurrentTargetState = nil
    end


    local BestId = nil

    local BestState = nil

    local BestDistance =
        MAX_TARGET_DISTANCE


    for EnemyId,
        EnemyState
        in pairs(
            Enemies
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
        then

            local Visual =
                GetEnemyVisualData(
                    EnemyId,
                    EnemyState
                )


            local Position =
                Visual
                and Visual.RootPosition
                or GetEnemyPosition(
                    EnemyState
                )


            if Position then

                local Distance =
                    (
                        Root.Position
                        - Position
                    ).Magnitude


                if Distance < BestDistance then

                    BestDistance =
                        Distance


                    BestId =
                        EnemyId


                    BestState =
                        EnemyState
                end
            end
        end
    end


    CurrentTargetId =
        BestId


    CurrentTargetState =
        BestState


    return BestId,
        BestState
end


--//============================================================
--// NEARBY ENEMY
--//============================================================

local function GetNearbyEnemy()

    local Root =
        GetRoot()


    if not Root then
        return nil, nil
    end


    if CurrentTargetId
        and CurrentTargetState
        and GetEnemyHealth(
            CurrentTargetState
        ) > 0
    then

        local Visual =
            GetEnemyVisualData(
                CurrentTargetId,
                CurrentTargetState
            )


        if Visual then

            local Distance =
                (
                    Root.Position
                    - Visual.RootPosition
                ).Magnitude


            if Distance <= COMBAT_RANGE then

                return CurrentTargetId,
                    CurrentTargetState
            end
        end
    end


    local BestId = nil

    local BestState = nil

    local BestDistance =
        COMBAT_RANGE


    for EnemyId,
        EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
        then

            local Visual =
                GetEnemyVisualData(
                    EnemyId,
                    EnemyState
                )


            if Visual then

                local Distance =
                    (
                        Root.Position
                        - Visual.RootPosition
                    ).Magnitude


                if Distance <= BestDistance then

                    BestDistance =
                        Distance


                    BestId =
                        EnemyId


                    BestState =
                        EnemyState
                end
            end
        end
    end


    return BestId,
        BestState
end


--//============================================================
--// FARM POSITION
--//============================================================

local function GetEnemyFarmCFrame(
    EnemyId,
    EnemyState
)

    local Visual =
        GetEnemyVisualData(
            EnemyId,
            EnemyState
        )


    if not Visual then
        return nil
    end


    local Distance =
        Settings.FarmDistance


    local Forward =
        Visual.RootCF.LookVector


    Forward =
        Vector3.new(
            Forward.X,
            0,
            Forward.Z
        )


    if Forward.Magnitude < 0.01 then

        Forward =
            Vector3.new(
                0,
                0,
                -1
            )

    else

        Forward =
            Forward.Unit
    end


    if Settings.FarmPosition == "Above"
        or Settings.FarmPosition == "Below"
    then

        -- Cache one head/feet offset per enemy. Using the animated Head/Feet
        -- positions directly made Above/Below inherit animation bobbing. The
        -- enemy root is much more stable, so only the first relative offset is
        -- kept and all later movement follows the root.
        GENV.__AZ_FARM_EXT.VerticalFarmOffsets =
            GENV.__AZ_FARM_EXT.VerticalFarmOffsets
            or {}


        local OffsetKey =
            tostring(EnemyId)


        local Offsets =
            GENV.__AZ_FARM_EXT.VerticalFarmOffsets[OffsetKey]


        if not Offsets then

            Offsets = {
                Head = math.clamp(
                    Visual.HeadPosition.Y
                    - Visual.RootPosition.Y,
                    1.5,
                    12
                ),

                Feet = math.clamp(
                    Visual.RootPosition.Y
                    - Visual.FeetPosition.Y,
                    1.5,
                    12
                ),
            }


            GENV.__AZ_FARM_EXT.VerticalFarmOffsets[OffsetKey] =
                Offsets
        end


        if Settings.FarmPosition == "Above" then

            local Aim =
                Visual.RootPosition
                + Vector3.new(
                    0,
                    Offsets.Head,
                    0
                )


            local Position =
                Aim
                + Vector3.new(
                    0,
                    Distance,
                    0
                )


            return CFrame.fromMatrix(
                Position,
                Vector3.xAxis,
                -Vector3.zAxis,
                Vector3.yAxis
            )
        end


        local Aim =
            Visual.RootPosition
            - Vector3.new(
                0,
                Offsets.Feet,
                0
            )


        local Position =
            Aim
            - Vector3.new(
                0,
                Distance,
                0
            )


        return CFrame.fromMatrix(
            Position,
            Vector3.xAxis,
            Vector3.zAxis,
            -Vector3.yAxis
        )
    end


    local Position =
        Visual.RootPosition
        - Forward
        * Distance


    return CFrame.lookAt(
        Position,
        Visual.RootPosition,
        Vector3.yAxis
    )
end


