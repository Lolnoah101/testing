    if not trip or trip.Phase~="Return" then return false end
    local char,root,hum=myCharacter()
    if not char or not root or char~=trip.Character then
        self:V70FinishNenVisit("Character changed; resumed saved toggles")
        return true
    end
    local goal=trip.ReturnCFrame
    if typeof(goal)~="CFrame" then self:V70FinishNenVisit(trip.Result);return true end
    if (root.Position-goal.Position).Magnitude<=5 then
        self:V70FinishNenVisit(trip.Result)
        return true
    end
    if now-(trip.ReturnAt or now)>8 then
        self:V70FinishNenVisit("Return timed out; original automation resumed")
        return true
    end
    if now>=(trip.ReturnTryAt or 0) then
        trip.ReturnTryAt=now+0.4
        if not trip.ReturnStreaming then
            trip.ReturnStreaming=true
            task.spawn(function()
                pcall(function() LocalPlayer:RequestStreamAroundAsync(goal.Position,2) end)
            end)
        end
        -- This is a previously occupied character CFrame, not a guessed NPC position.
        pcall(function() char:PivotTo(goal) end)
    end
    self.V44.NenStatus=tostring(trip.Result or "Node Master finished").." | returning to farm/fishing/mining"
    return true
end
function Hub:InstallV70NenFastWatcher()
    -- One lightweight Heartbeat watcher only for the priority transition.
    -- All detailed Nen operations still use the game services through the
    -- serialized visit job; do not spam remotes on every frame.
    local nextCheck=0
    table.insert(self.Connections,RunService.Heartbeat:Connect(function()
        if not self.Running or not self.V44 then return end
        local E=self.V44
        if not self.V70NenPriority and
            (not E.AutoNenUnlock or E.NenUnlockRoute~="Finding Node Masters") then return end
        local now=os.clock()
        if now<nextCheck then return end
        nextCheck=now+(self.V70NenPriority and 0.06 or 0.10)
        local ok,err=pcall(function() self:V44NenUnlockTick(now) end)
        if not ok then
            E.NenStatus="Nen priority error: "..tostring(err):sub(1,95)
            E.LastError=E.NenStatus
        end
    end))
end
-- v71: The captured native Node Master client reads PlayerData.AuraNodes,
-- where 1..7 each have unlocked and damaged booleans. Do not infer state
-- from a dialogue, UI notification or a service request alone.
function Hub:V71ReadNenState()
    local ok,nodes,talked=pcall(function()
        local controller=Knit.GetController("DataController")
        if not controller or type(controller.get)~="function" then return nil,nil end
        local slot=LocalPlayer:GetAttribute("SelectedSlot") or 1
        return controller.get(slot,"PlayerData","AuraNodes"),
            controller.get(slot,"PlayerData","NodeMastersTalkedTo")
    end)
    if ok and type(nodes)=="table" then return nodes,type(talked)=="table" and talked or nil end
    return nil,nil
end
function Hub:V71AuraNode(number)
    local nodes,talked=self:V71ReadNenState()
    return nodes and (nodes[number] or nodes[tostring(number)]),talked
