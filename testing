local function doAutoStat()
    if not running or not autoStat or not ClientData.IsReady() then return end
    local now = os.clock()
    if now < nextStatAction then return end

    local points = getNumber("StatPoints", 0)
    if points < 1 then
        statPending = nil
        statFailures = 0
        return
    end
    local chosen = Progression.Stats[selectedStat]
    if not chosen then return end

    local values = ClientData.Get("Stats") or {}
    local allocated = tonumber(values[selectedStat]) or 0
    local cap = tonumber(chosen.Cap)
    local amount = cap and math.min(points, cap - allocated) or points
    amount = math.floor(math.max(0, amount))
    if amount < 1 then return end

    if statPending then
        if points < statPending.points then
            statPending = nil
            statFailures = 0
        elseif now - statPending.at < 4 then
            return
        else
            -- No data confirmation after a request. Avoid spamming silently.
            statPending = nil
            statFailures += 1
            if statFailures >= 3 then
                if autoStatToggle then autoStatToggle:Set(false) else autoStat = false end
                warn("[Tame V44] Auto Stat paused: no allocation confirmation")
                return
            end
        end
    end

    statPending = {
        at = now, points = points, stat = selectedStat, value = allocated,
    }
    nextStatAction = now + 0.25
    AllocateStatRemote:FireServer(selectedStat, amount)
end

