-- Main -> exam hub -> exam. Queue on actual teleport start, so disabling cancels pending intent.
function Hub:QueueExamRunner()
    if not self.Running or not self.AutoHunterExam or self.HunterExamQueued then return end
    local queue=(type(queue_on_teleport)=="function" and queue_on_teleport)
        or (type(queueonteleport)=="function" and queueonteleport)
        or (syn and type(syn.queue_on_teleport)=="function" and syn.queue_on_teleport)
    if not queue then self.HunterExamStatus="Teleporting; execute v44 after arrival (queue unavailable)";return end
    local source=Env.HollowMoonExamRunnerCode
    local payload="local e=(getgenv and getgenv()) or _G;e.HollowMoonExamRunnerCode="..string.format("%q",source).."\n"..source
    local ok,err=pcall(queue,payload)
    self.HunterExamQueued=ok
    if not ok then self.HunterExamStatus="Teleport queue failed: "..tostring(err) end
end
function Hub:InstallHunterExamAutomation()
    table.insert(self.Connections,LocalPlayer.OnTeleport:Connect(function(state)
        if state==Enum.TeleportState.Started and self.HunterExamAttempt>0 then self:QueueExamRunner() end
    end))
    table.insert(self.Connections,game:GetService("TeleportService").TeleportInitFailed:Connect(function(player)
        if player==LocalPlayer then
            self.HunterExamBusy=false;self.HunterExamQueued=false;self.HunterExamJoinAt=os.clock()+12
            self.HunterExamStatus="Teleport failed; waiting to retry"
        end
    end))
    task.spawn(function()
        while self.Running do
            task.wait(1)
            if not self.AutoHunterExam or self.HunterExamBusy then continue end
            if LocalPlayer:GetAttribute("IsHunter")==true then self.HunterExamStatus="Hunter license already earned";continue end
            local valid,schedule=pcall(function() return require(ReplicatedStorage.Shared.Data.HunterExamSchedule) end)
            if not valid then self.HunterExamStatus="Waiting for exam schedule";continue end
            local minimum=tonumber(schedule.MinLevel) or 10
            if (tonumber(LocalPlayer:GetAttribute("Level")) or 0)<minimum then self.HunterExamStatus="Requires level "..minimum;continue end
            local serverNow=workspace:GetServerTimeNow()
            local open,startTime=schedule.Window(serverNow)
            if not open then
                local remaining=math.max(0,startTime+(schedule.OpenSeconds or 3600)+(schedule.ClosedSeconds or 3600)-serverNow)
                self.HunterExamStatus=string.format("Exam opens in %02d:%02d",math.floor(remaining/60),math.floor(remaining%60));continue
            end
            if os.clock()<self.HunterExamJoinAt then continue end
            local ok,service=pcall(Knit.GetService,"HunterExamCallService")
            if not ok or not service then self.HunterExamStatus="Waiting for exam join service";continue end
            self.HunterExamBusy=true;self.HunterExamAttempt+=1;self.HunterExamStatus="Joining Hunter Exam hub"
            self.HunterExamJoinAt=os.clock()+35
            self:StartJob("hunterExam","AutoHunterExam",function(alive)
                if not alive() then return end
                local sent,reply=pcall(function() return service:Join() end)
                local accepted,value=false,nil
                if sent then accepted,value=self:AwaitReply(reply,alive,10) end
                if not alive() then return end
                if accepted and value==true then self.HunterExamStatus="Joining exam hub; waiting for teleport";self.HunterExamJoinAt=os.clock()+90
                else self.HunterExamStatus="Exam join unconfirmed; retrying soon";self.HunterExamJoinAt=os.clock()+20 end
            end,function() if self.Running then self.HunterExamBusy=false end end)
        end
    end)
end
