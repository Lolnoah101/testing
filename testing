function Systems.getSelectedRodToolInBackpack(
    rodId
)
    if type(rodId) ~= "string"
        or rodId == "" then

        return nil
    end

    local backpack =
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )

    if not backpack then
        return nil
    end

    local exact =
        backpack:FindFirstChild(
            rodId
        )

    if exact
        and exact:IsA("Tool")
        and Catalog.Rod.GetById(
            exact.Name
        ) then

        return exact
    end

    return nil
end

function Systems.isHeldRodEquipSafe()
    if State.TravelBusy
        or State.AutoSellBusy
        or State.BossBusy
        or State.BossOwnedMovement
        or State.ProgressionNavigationBusy
        or State.RodBusy
        or State.RodRecoveryBusy
        or State.SkillTransferBusy
        or State.OPShutdownBusy then

        return false,
            "Waiting for automation to become idle"
    end

    if not HeldToolController then
        return false,
            "HeldToolController unavailable"
    end

    if type(
        HeldToolController.IsReady
    ) == "function" then

        local ok, ready =
            pcall(function()
                return HeldToolController:
                    IsReady()
            end)

        if ok
            and ready ~= true then

            return false,
                "Backpack not ready"
        end
    end

    if type(
        HeldToolController.IsInputEnabled
    ) == "function" then

        local ok, enabled =
            pcall(function()
                return HeldToolController:
                    IsInputEnabled()
            end)

        if ok
            and enabled ~= true then

            return false,
                "Rod slot locked by fishing"
        end
    end

    if FishingController then
        if type(
            FishingController.IsLoadoutPreLocked
        ) == "function" then

            local ok, locked =
                pcall(function()
                    return FishingController:
                        IsLoadoutPreLocked()
                end)

            if ok and locked then
                return false,
                    "Fishing loadout pre-locked"
            end
        end

        if type(
            FishingController.IsLoadoutLocked
        ) == "function" then

            local ok, locked =
                pcall(function()
                    return FishingController:
                        IsLoadoutLocked()
                end)

            if ok and locked then
                return false,
                    "Fishing loadout locked"
            end
        end
    end

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not humanoid
        or humanoid.Health <= 0 then

        return false,
            "Character unavailable"
    end

    return true
end

function Systems.stepAutoEquipRod()
    if not Config.AutoEquipRod then
        State.AutoEquipRodStatus =
            "Off"

        return true
    end

    local now =
        os.clock()

    local selectedRodId =
        Systems.getSelectedRodForHeldEquip()

    if not selectedRodId then
        State.AutoEquipRodStatus =
            "Waiting for selected rod"

        return false
    end

    local heldRodId =
        getHeldRodId()

    if heldRodId == selectedRodId then
        State.AutoEquipRodStatus =
            "Held: "
            .. tostring(
                Systems.RodIdToName[
                    selectedRodId
                ]
                or selectedRodId
            )

        return true
    end

    local safe, reason =
        Systems.isHeldRodEquipSafe()

    if not safe then
        State.AutoEquipRodStatus =
            tostring(
                reason
                or "Waiting"
            )

        return false
    end

    if now
        < State.AutoEquipRodPendingUntil then

        State.AutoEquipRodStatus =
            "Waiting for rod Tool sync"

        return false
    end

    if now
        - State.AutoEquipRodLastAt
        < math.max(
            0.18,
            tonumber(
                Config.AutoEquipRodInterval
            ) or 0.20
        ) then

        return false
    end

    State.AutoEquipRodLastAt =
        now

    -- If another rod is physically held, use the game's own toggle path to
    -- put it away first. The next watcher pass equips the selected rod.
    if heldRodId
        and heldRodId ~= selectedRodId then

        State.AutoEquipRodAttempts += 1
        State.AutoEquipRodStatus =
            "Switching held rod"

        local currentSlot = nil

        if type(
            HeldToolController.GetCurrentSlot
        ) == "function" then

            pcall(function()
                currentSlot =
                    HeldToolController:
                        GetCurrentSlot()
            end)
        end

        local ok = false

        if currentSlot
            == BackpackSlot.Rod
            and type(
                HeldToolController.Select
            ) == "function" then

            ok =
                pcall(function()
                    HeldToolController:
                        Select(
                            BackpackSlot.Rod
                        )
                end)
        else
            local character =
                LocalPlayer.Character

            local humanoid =
                character
                and character:
                    FindFirstChildOfClass(
                        "Humanoid"
                    )

            if humanoid then
                ok =
                    pcall(function()
                        humanoid:
                            UnequipTools()
                    end)
            end
        end

        State.AutoEquipRodPendingUntil =
            now + 0.18

        return false
    end

    local backpackTool =
        Systems.getSelectedRodToolInBackpack(
            selectedRodId
        )

    if not backpackTool then
        State.AutoEquipRodStatus =
            "Waiting for "
            .. tostring(
                Systems.RodIdToName[
                    selectedRodId
                ]
                or selectedRodId
            )
            .. " Tool in Backpack"

        State.AutoEquipRodPendingUntil =
            now + 0.10

        return false
    end

    State.AutoEquipRodAttempts += 1

    local currentSlot = nil

    if type(
        HeldToolController.GetCurrentSlot
    ) == "function" then

        pcall(function()
            currentSlot =
                HeldToolController:
                    GetCurrentSlot()
        end)
    end

    local requested = false

    -- Normal game path: Select(Rod) sends SetHeldSlot and predicts
    -- Humanoid:EquipTool. Only call this when Rod is NOT already selected,
    -- because the game's Select() toggles the same slot back to None.
    if currentSlot
        ~= BackpackSlot.Rod
        and type(
            HeldToolController.Select
        ) == "function" then

        local ok, result =
            pcall(function()
                return HeldToolController:
                    Select(
                        BackpackSlot.Rod
                    )
            end)

        requested =
            ok and result == true

    else
        -- Repair case: slot state already says Rod but the physical Tool is
        -- missing. Keep server slot state at Rod and use the controller's
        -- own prediction helper to put the selected Tool back in Character.
        if HeldToolController.SetHeldSlot
            and type(
                HeldToolController.SetHeldSlot.Fire
            ) == "function" then

            pcall(function()
                HeldToolController.SetHeldSlot:
                    Fire(
                        BackpackSlot.Rod
                    )
            end)
        end

        if type(
            HeldToolController.PredictEquipByName
        ) == "function" then

            local ok, result =
                pcall(function()
                    return HeldToolController:
                        PredictEquipByName(
                            selectedRodId
                        )
                end)

            requested =
                ok and result == true
        else
            local character =
                LocalPlayer.Character

            local humanoid =
                character
                and character:
                    FindFirstChildOfClass(
                        "Humanoid"
                    )

            if humanoid then
                requested =
                    pcall(function()
                        humanoid:
                            EquipTool(
                                backpackTool
                            )
                    end)
            end
        end
    end

    State.AutoEquipRodPendingUntil =
        now + 0.18

    if not requested then
        State.AutoEquipRodStatus =
            "Equip request waiting/rejected"

        return false
    end

    State.AutoEquipRodStatus =
        "Equipping "
        .. tostring(
            Systems.RodIdToName[
                selectedRodId
            ]
            or selectedRodId
        )

    task.delay(0.12, function()
        if not State.Alive
            or not Config.AutoEquipRod then

            return
        end

        if getHeldRodId()
            == selectedRodId then

            State.AutoEquipRodSuccesses += 1
            State.AutoEquipRodStatus =
                "Held: "
                .. tostring(
                    Systems.RodIdToName[
                        selectedRodId
                    ]
                    or selectedRodId
                )

            State.LastRodWatchCheck = 0
        end
    end)

    return false
end

