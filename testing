            local function Send(Participant, IsTest)

                local Payload = {
                    username = "Anime Zero Match Tracker",
                    allowed_mentions = {
                        parse = {},
                    },
                    embeds = {
                        BuildEmbed(
                            Participant,
                            IsTest == true
                        ),
                    },
                }


                return PostWebhook(Payload)
            end


            GENV.__AZ_WEBHOOK_SEND_TEST =
                function()

