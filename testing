local function GetSkillProcessingTime(
    CharacterName,
    SkillNumber
)

    local Config =
        CharacterConstants
            .charactersByName[
                CharacterName
            ]


    if not Config
        or not Config.skills
        or not Config.skills[
            SkillNumber
        ]
    then

        return nil
    end


    return Config
        .skills[
            SkillNumber
        ]
        .processingTime
end


local function TrySkill(
    SkillNumber
)

    if not IsAlive()
        or not GENV.__AZ_FARM_EXT.IsRunActive()
        or not GetNearbyEnemy()
    then

        return false
    end


    local Store =
        GetPlayerStore()


    if not Store
        or IsBlocking(Store)
        or HasActiveStun(Store, true)
        or GENV.__AZ_FARM_EXT.IsLocalClientBusy()
    then

        return false
    end


    local Now =
        workspace:GetServerTimeNow()


    if PendingSkillRequestId then

        if Now >= PendingSkillExpiresAt then

            PendingSkillRequestId =
                nil

        else

            return false
        end
    end


    if Now < SkillBusyUntil
        or Now < SkillRetryAfter
    then

        return false
    end


    local CooldownReadyNow,
        EffectiveSkill,
        CharacterName =
        SkillCooldownReady(
            Store,
            SkillNumber
        )


    if not CooldownReadyNow
        or not EffectiveSkill
        or not CharacterName
    then

        return false
    end


    if EffectiveSkill == 4 then

        local Success,
            Progress =
            pcall(function()

                return Store
                    .state
                    .ultProgress
                    :get()
            end)


        if not Success
            or not Progress
            or Progress < 100
            or LocalPlayer:GetAttribute("UltimateLocked") == true
        then

            return false
        end
    end


    local Character =
        GetCharacter()


    if not Character then
        return false
    end


    SkillSequence =
        (SkillSequence % 4294967295) + 1


    local RequestId =
        SkillSequence


    local Expires =
        Now + 5


    local Request = {

        id =
            RequestId,

        char =
            CharacterName,

        character =
            Character,

        skill =
            EffectiveSkill,

        expiresAt =
            Expires,
    }


    PendingSkillRequestId =
        RequestId


    PendingSkillExpiresAt =
        Expires


    if EffectiveSkill < 4 then

        local Processing =
            GetSkillProcessingTime(
                CharacterName,
                EffectiveSkill
            )


        if Processing then

            SkillBusyUntil =
                Now
                + Processing
        end
    end


    local Success,
        ErrorMessage =
        pcall(function()

            CharacterPackets
                .performSkill
                :fire(
                    Request
                )
        end)


    if not Success then

        PendingSkillRequestId =
            nil


        SkillBusyUntil =
            0


        SkillRetryAfter =
            Now
            + SKILL_REJECT_BACKOFF


        GENV.__AZ_FARM_EXT.LastSkillError =
            tostring(
                ErrorMessage
            )


        return false
    end


    return true
end

pcall(function()

    CharacterPackets
        .skillPerformed
        :on(function(Data)

            if not Data
                or Data.player
                    ~= LocalPlayer
            then

                return
            end


            PendingSkillRequestId =
                nil


            if Data.accepted == false then

                SkillBusyUntil =
                    0


                SkillRetryAfter =
                    workspace:GetServerTimeNow()
                    + SKILL_REJECT_BACKOFF


                return
            end


            SkillRetryAfter =
                0


            if Data.processingTill then

                SkillBusyUntil =
                    Data.processingTill

            else

                SkillBusyUntil =
                    workspace:GetServerTimeNow()
            end
        end)
end)


local SkillOrder = {
    "Skill 1",
    "Skill 2",
    "Skill 3",
}


RunAutoSkills =
    function()

        if not GetNearbyEnemy() then
            return
        end


        if Settings.AutoUltimate
            and GENV.__AZ_SUPPRESS_ULTIMATE ~= true
        then

            if TrySkill(4) then
                return
            end
        end


        if not Settings.AutoSkills then
            return
        end


        for _ = 1, #SkillOrder do

            if SkillCursor > #SkillOrder then
                SkillCursor = 1
            end


            local SkillName =
                SkillOrder[
                    SkillCursor
                ]


            SkillCursor =
                SkillCursor + 1


            if Settings.SelectedSkills[
                SkillName
            ]
            then

                local Number =
                    tonumber(
                        SkillName:match(
                            "%d+"
                        )
                    )


                if Number
                    and TrySkill(
                        Number
                    )
                then

                    return
                end
            end
        end
    end


--//============================================================
--// BLOCK
--//============================================================

local function RequestBlock(State)

    local Store =
        GetPlayerStore()


    if not Store then
        return
    end


    -- Updated combat uses a guard meter. Never request a new block while
    -- guard-broken or while the server's block cooldown is active.
    if State == true
        and (
            not GENV.__AZ_FARM_EXT.IsRunActive()
            or GENV.__AZ_FARM_EXT.IsLocalClientBusy()
            or LocalPlayer:GetAttribute("GuardBroken") == true
            or not CooldownReady(Store, "block")
        )
    then
        State = false
    end


    if IsBlocking(Store) == State then
        return
    end


    local Now =
        workspace:GetServerTimeNow()


    if (
        Now
        - LastBlockRequest
    ) < 0.025
    then

        return
    end


    LastBlockRequest =
        Now


    pcall(function()

        CharacterPackets
            .performBlock
            :fire(
                State
            )
    end)
end


local function IsEnemyTargetingUs(
    EnemyState
)

    local Target =
        EnemyGet(
            EnemyState,
            "target"
        )


    return Target ~= nil
        and tostring(Target)
            == tostring(
                LocalPlayer.UserId
            )
end


local function EnemyIsAttackingUs(
    EnemyState
)

    return IsEnemyTargetingUs(
        EnemyState
    )
        and EnemyGet(
            EnemyState,
            "attackStartedAt"
        ) ~= nil
end


local function ShouldHoldBlock()

    if LocalPlayer:GetAttribute("GuardBroken") == true then
        return false
    end


    local Guard =
        tonumber(
            LocalPlayer:GetAttribute("BlockGuard")
        )

    if Guard ~= nil and Guard <= 0 then
        return false
    end


    for _, EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
            and EnemyIsAttackingUs(
                EnemyState
            )
        then

            return true
        end
    end


    return false
end


local function GetEnemyConfig(
    EnemyName
)

    if EnemyConstants.enemiesByName then

        return EnemyConstants
            .enemiesByName[
                EnemyName
            ]
    end


    return EnemyConstants[
        EnemyName
    ]
end


local function FindParryAttack()

    local Now =
        workspace:GetServerTimeNow()


    for EnemyId,
        EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) <= 0
        then

            continue
        end


        if not IsEnemyTargetingUs(
            EnemyState
        )
        then

            continue
        end


        local StartedAt =
            EnemyGet(
                EnemyState,
                "attackStartedAt"
            )


        local AttackIndex =
            EnemyGet(
                EnemyState,
                "attackIndex"
            )


        local EnemyName =
            GetEnemyName(
                EnemyState
            )


        if not StartedAt
            or AttackIndex == nil
            or not EnemyName
        then

            continue
        end


        local Config =
            GetEnemyConfig(
                EnemyName
            )


        if not Config
            or not Config.attacks
        then

            continue
        end


        local Attack =
            Config.attacks[
                AttackIndex
            ]
            or Config.attacks[
                AttackIndex + 1
            ]


        if not Attack
            or not Attack.hitTime
        then

            continue
        end


        local AttackSpeed =
            Config.attackSpeed
            or 1


        local TimeUntilHit =
            Attack.hitTime
            - (
                Now
                - StartedAt
            )
            * AttackSpeed


        local Key =
            tostring(
                EnemyId
            )
            .. ":"
            .. tostring(
                StartedAt
            )


        if TimeUntilHit <= PARRY_LEAD
            and TimeUntilHit >= -PARRY_AFTER
            and not LastParriedAttack[Key]
        then

            LastParriedAttack[
                Key
            ] = true


            return true
        end
    end


    return false
end


local function RunPerfectParry()

    if not FindParryAttack() then
        return
    end


    RequestBlock(
        true
    )


    task.delay(
        PARRY_HOLD,

        function()

            if SessionAlive()
                and Settings.AutoBlock
                and Settings.BlockMode
                    == "Perfect Parry"
            then

                RequestBlock(
                    false
                )
            end
        end
    )
end


