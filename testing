GENV.__AZ_FARM_EXT.HeartbeatConnection = nil


GENV.__AZ_FARM_EXT.FarmStageLastError = {}


GENV.__AZ_FARM_EXT.RunFarmStage = function(
    Name,
    Callback
)

    local Success,
        ErrorMessage =
        xpcall(
            Callback,
            function(ErrorValue)

                if debug
                    and type(debug.traceback) == "function"
                then
                    return debug.traceback(
                        tostring(ErrorValue),
                        2
                    )
                end


                return tostring(ErrorValue)
            end
        )


    if Success then
        return true
    end


    local Now =
        os.clock()


    if not GENV.__AZ_FARM_EXT.FarmStageLastError[Name]
        or (
            Now
            - GENV.__AZ_FARM_EXT.FarmStageLastError[Name]
        ) >= 2
    then

        GENV.__AZ_FARM_EXT.FarmStageLastError[Name] =
            Now


        warn(
            "[Anime Zero][Farm] "
            .. Name
            .. " error:",
            ErrorMessage
        )
    end


    return false
end


GENV.__AZ_FARM_EXT.NextFarmDebugAt = 0


GENV.__AZ_FARM_EXT.DebugFarmState = function()

    if not Settings.AutoFarm then
        return
    end


    local Now =
        os.clock()


    if Now < (GENV.__AZ_FARM_EXT.NextFarmDebugAt or 0) then
        return
    end


    GENV.__AZ_FARM_EXT.NextFarmDebugAt =
        Now + 1


    local VisualCount = 0
    local StoreCount = 0


    local Folder =
        workspace:FindFirstChild("enemies")


    if Folder then
        VisualCount =
            #Folder:GetChildren()
    end


    pcall(function()

        local Stored =
            EnemyStore.state:getAll()


        if type(Stored) == "table" then
            for _ in pairs(Stored) do
                StoreCount = StoreCount + 1
            end
        end
    end)


    local Root =
        GetRoot()


    local Distance =
        nil


    if Root and DesiredFarmCFrame then
        Distance =
            math.floor(
                (
                    Root.Position
                    - DesiredFarmCFrame.Position
                ).Magnitude
                * 10
            ) / 10
    end


    print(
        "[Anime Zero][FarmDebug] mode=",
        tostring(CurrentFarmMode),
        "visual=",
        VisualCount,
        "store=",
        StoreCount,
        "target=",
        tostring(CurrentTargetId),
        "desired=",
        DesiredFarmCFrame ~= nil,
        "distance=",
        tostring(Distance),
        "alive=",
        IsAlive(),
        "session=",
        SessionAlive()
    )
end


GENV.__AZ_FARM_EXT.BindFarmHeartbeat = function()

    local Existing =
        GENV.__AZ_FARM_EXT.HeartbeatConnection


    if typeof(Existing) == "RBXScriptConnection"
        and Existing.Connected
    then
        GENV.__AZ_FARM_ENGINE_ACTIVE = true
        return true
    end


    local Connection =
        RunService.Heartbeat
            :Connect(
                function(
                    DeltaTime
                )

                    if not SessionAlive() then

                        GENV.__AZ_FARM_FULL_ENGINE_ACTIVE = false
                        GENV.__AZ_FARM_ENGINE_ACTIVE =
                            GENV.__AZ_FARM_RESCUE_ACTIVE == true


                        pcall(function()
                            GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(
                                false
                            )
                        end)


                        local Current =
                            GENV.__AZ_FARM_EXT.HeartbeatConnection


                        if typeof(Current) == "RBXScriptConnection"
                            and Current.Connected
                        then
                            Current:Disconnect()
                        end


                        return
                    end


                    GENV.__AZ_FARM_ENGINE_ACTIVE = true


                    -- The dedicated rescue runtime owns all Raid modes.
                    -- Do not let the legacy movement/target logic fight it.
                    if GENV.__AZ_IS_RAID_MODE()
                        and GENV.__AZ_FARM_RESCUE_ACTIVE == true
                    then
                        pcall(function()
                            GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false)
                        end)

                        return
                    end


                    GENV.__AZ_FARM_EXT.RunFarmStage(
                        "UpdateAutoFarm",
                        UpdateAutoFarm
                    )


                    GENV.__AZ_FARM_EXT.RunFarmStage(
                        "FarmDebug",
                        GENV.__AZ_FARM_EXT.DebugFarmState
                    )


                    if type(
                        GENV.__AZ_FARM_EXT.RunStillnessRecovery
                    ) == "function"
                    then

                        GENV.__AZ_FARM_EXT.RunFarmStage(
                            "StillnessRecovery",
                            GENV.__AZ_FARM_EXT.RunStillnessRecovery
                        )
                    end


                    GENV.__AZ_FARM_EXT.RunFarmStage(
                        "Movement",
                        function()
                            ApplyFarmMovement(
                                DeltaTime
                            )
                        end
                    )


                    GENV.__AZ_FARM_EXT.RunFarmStage(
                        "Combat",
                        RunCombatHeartbeat
                    )
                end
            )


    GENV.__AZ_FARM_EXT.HeartbeatConnection =
        Connection


    shared.__AZ_FARM_HEARTBEAT =
        Connection


    table.insert(
        Runtime.Connections,
        Connection
    )


    GENV.__AZ_FARM_FULL_ENGINE_ACTIVE = true
    GENV.__AZ_FARM_ENGINE_ACTIVE = true


    print(
        "[Anime Zero] Farm heartbeat ACTIVE."
    )


    return true
end


GENV.__AZ_FARM_EXT.BindFarmHeartbeat()


-- Heartbeat watchdog: if an executor/teleport transition disconnects the
-- connection while this is still the current session, recreate it.
task.spawn(function()

    while SessionAlive() do

        local Connection =
            GENV.__AZ_FARM_EXT.HeartbeatConnection


        if typeof(Connection) ~= "RBXScriptConnection"
            or not Connection.Connected
        then

            GENV.__AZ_FARM_ENGINE_ACTIVE = false


            warn(
                "[Anime Zero] Farm heartbeat missing; rebinding..."
            )


            GENV.__AZ_FARM_EXT.BindFarmHeartbeat()
        end


        task.wait(1)
    end


    GENV.__AZ_FARM_FULL_ENGINE_ACTIVE = false
    GENV.__AZ_FARM_ENGINE_ACTIVE =
        GENV.__AZ_FARM_RESCUE_ACTIVE == true
end)()


