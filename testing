        if AvailableTokens == nil then
            return nil
        end

        for _, Branch in ipairs(SkillPriority) do
            local BranchConfig = CharacterConfig.branches[Branch]
            local CurrentTier = tonumber(Skills[Branch]) or 1

            if BranchConfig
                and type(BranchConfig.tiers) == "table"
                and CurrentTier < #BranchConfig.tiers
            then
                local NextTier = CurrentTier + 1
                local TierData = BranchConfig.tiers[NextTier]
                local Cost = TierData and tonumber(TierData.cost) or 0

                return {
