local function TryM1()

    if not Settings.AutoM1
        or not IsAlive()
        or not GENV.__AZ_FARM_EXT.IsRunActive()
    then

        return false
    end


    local Clock =
        os.clock()


    if Clock < NextM1RequestAt then
        return false
    end


    local Store =
        GetPlayerStore()


    if not Store then
        return false
    end


    if IsBlocking(Store)
        or HasActiveStun(Store, false)
        or GENV.__AZ_FARM_EXT.IsLocalClientBusy()
    then

        return false
    end


    if PendingSkillRequestId
        or workspace:GetServerTimeNow()
            < SkillBusyUntil
    then

        return false
    end


    if not M1CooldownReady(
        Store
    )
    then

        return false
    end


    NextM1RequestAt =
        Clock
        + M1_REQUEST_GUARD


    return pcall(function()

        CharacterPackets
            .performM1
            :fire()
    end)
end


