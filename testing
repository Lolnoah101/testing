    if inPreferencesRestore then return false, "Restore in progress" end
    local values = capturePreferenceValues()
    local count = 0
    for _flag, _value in pairs(values) do count = count + 1 end
    if count < (Farm.isMenuPlace and 3 or 8) then
        return false, "Only " .. tostring(count) .. " settings were readable; refusing to overwrite the shared backup"
    end
    local okRayfield, rayfieldError = pcall(function() window:Save() end)
    if not canUsePreferenceFiles() then
        return false, "Executor has no readfile/writefile; Rayfield Save invoked but disk persistence cannot be verified"
    end
    local okEncode, json = pcall(function()
        return HttpService:JSONEncode({ version=47, values=values })
    end)
    if not okEncode then return false, "JSON encoding failed: " .. tostring(json) end
    local okWrite, writeError = pcall(writefile, SETTINGS_BACKUP_PATH, json)
    if not okWrite then return false, "Backup write failed: " .. tostring(writeError) end
    local okRead, echoed = pcall(readfile, SETTINGS_BACKUP_PATH)
    if not okRead or echoed ~= json then
        return false, "Backup write/read verification failed: " .. tostring(echoed)
    end
