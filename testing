local function matchesDungeon(portal)
    if type(portal) ~= "table" then return false end
    local rank = tonumber(portal.Rank)
    if not selectedDungeonRankSet.Any
        and not selectedDungeonRankSet[numberToRank[rank]] then
        return false
    end
    if not selectedDungeonMapSet.Any then
        local island = normalizeIsland(portal.Island or portal.IslandName)
        if not selectedDungeonMapSet[keyToMap[island]] then return false end
    end
    local closesAt = tonumber(portal.ClosesAt)
    if closesAt and closesAt > 0 and closesAt <= serverNow() then
        return false
    end
    return true
end

local function getInstancePosition(value)
    if typeof(value) ~= "Instance" or not value:IsDescendantOf(Workspace) then
        return nil, nil
    end
    if value:IsA("BasePart") then
        return value.Position, value.CFrame
    end
    if value:IsA("Attachment") then
        return value.WorldPosition, value.WorldCFrame
    end
    if value:IsA("Model") then
        local part = value.PrimaryPart or value:FindFirstChild("HumanoidRootPart", true)
            or value:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.Position, part.CFrame end
    end
    return nil, nil
end

