                    return nil, nil, nil, "Waiting for run modules"
                end

                local Participant = GetParticipant(State)
                if not Participant then
                    return nil, nil, nil, "Waiting for player result data"
                end

                local Status = tostring(ReadLeaf(Participant.status) or "active")
                if Status == "active" then
                    return nil, nil, nil, "Watching active match"
                end

                local FinishedAt = ReadLeaf(State.finishedAt)
                    or ReadLeaf(Participant.finishedAt)
                    or ReadLeaf(State.resultEndsAt)

                if FinishedAt == nil then
                    return nil, nil, nil, "Waiting for final result"
                end

                local RunStartedAt = tonumber(ReadLeaf(State.startedAt))
                if not RunStartedAt or RunStartedAt <= 0 then
                    RunStartedAt = tonumber(ReadLeaf(Participant.joinedAt))
                end
                if not RunStartedAt or RunStartedAt <= 0 then
                    RunStartedAt = tonumber(FinishedAt) or 0
                end

                local Key = tostring(game.PlaceId)
                    .. ":" .. tostring(RunStartedAt)
                    .. ":" .. tostring(Status)

                return State, Participant, Key, Status
            end

