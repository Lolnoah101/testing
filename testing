-- ========================= TRIALS / TOWER / RAIDS =========================
-- Verified UI requests:
--  Trial Join  -> Bridge("Gamemodes", "Trial", "Join") only when Trial.Open == true
--  Tower Join  -> Bridge("Gamemodes", "Tower", "Join", queueName)
--  Tower Create-> Bridge("Gamemodes", "Tower", "Create", nil)
--  Raid Join   -> Bridge("Gamemodes", "Raid", "Join")
-- These requests still require server authorization (keys, location, timer,
-- queue state, etc.). None overrides server restrictions.
-- Important: the game exposes ONE Trial matchmaking route; the difficulty
-- grades Easy/Medium/Hard are Trial ACHIEVEMENT tiers, not join arguments.

window:CreateSection({ name = "ACTIVITIES" })
local modesTab = window:CreateTab({ name = "Game Modes", icon = "trophy" })
local gameModes = ReplicatedStorage:FindFirstChild("Gamemodes")

local function readModeValue(container, childName)
    local item = container and container:FindFirstChild(childName)
    if item and item:IsA("ValueBase") then
        return item.Value
    end
    return nil
end

-- Read the active wave only; never use a historical highest-wave statistic.
local function readActiveWave(mode)
    local modeFolder = gameModes and gameModes:FindFirstChild(mode)
    local containers = {modeFolder}
    local server = Workspace:FindFirstChild("Server")
    local active = server and server:FindFirstChild(mode)
    if active then containers[#containers+1] = active end
    if mode == "Tower" then
        local roomName = player:GetAttribute("TowerRoom")
        local rooms = active and active:FindFirstChild("ActiveRooms")
        local room = rooms and roomName and rooms:FindFirstChild(tostring(roomName))
        if room then table.insert(containers, 1, room) end
    elseif mode == "Raid" then
        local roomName = player:GetAttribute("RaidRoom")
        local rooms = active and active:FindFirstChild("ActiveRooms")
        local room = rooms and roomName and rooms:FindFirstChild(tostring(roomName))
        if room then table.insert(containers, 1, room) end
    end
    for _, obj in ipairs(containers) do
        if obj then
            local wave = tonumber(readModeValue(obj, "Wave"))
                or tonumber(obj:GetAttribute("Wave"))
            if wave and wave > 0 then return math.floor(wave) end
        end
    end
    local attribute = player:GetAttribute(mode .. "Wave")
    return (type(attribute) == "number" and attribute > 0) and math.floor(attribute) or nil
end

local function canEnterNewMode()
    local mode = player:GetAttribute("Mode")
    if mode ~= nil and mode ~= "" and mode ~= "World" and mode ~= "Normal" and mode ~= "None" then
        return false
    end
    return not state.ModeReturnRestoring and os.clock() >= state.ModeReturnCooldownUntil
end

local function sendModeRequest(...)
    local args = table.pack(...)
    local ok, err = pcall(function()
        bridge:FireServer(table.unpack(args, 1, args.n))
    end)
    if not ok then warn("[Paraiso Modes] Request failed:", err) end
    return ok
end

-- Isolate return logic so the large main chunk avoids Luau's 200-local limit.
function state.InitializeModeReturn()
    local function isInGameMode()
        local mode = player:GetAttribute("Mode")
        return mode == "Trial" or mode == "Tower" or mode == "Raid"
    end
    local function isInWorld()
        local mode = player:GetAttribute("Mode")
        return mode == nil or mode == "" or mode == "World" or mode == "Normal" or mode == "None"
    end
    -- Automatically remembers the original spot BEFORE creating/joining a game
    -- mode. A single snapshot survives the entire queue -> run -> results cycle.
    -- If farming Below, remember the pre-void surface spot instead of a point
    -- underground. No toggle or new saved flag is needed.
    local function rememberModeReturnSpot(modeName)
        if not isInWorld() or state.ModeReturnRestoring then return end
        local existing = state.ModeReturnSpot
        if existing then
            -- Do not replace the original location with a lobby/queue location.
            if existing.entered or os.clock() - existing.at < 18 then return end
        end
        local root = getParts()
        local cf = root and root.CFrame
        if state.WasBelowFarming and state.BelowReturnCFrame then
            cf = state.BelowReturnCFrame
        end
        if not cf then return end
        state.ModeReturnSpot = {
            cf = cf,
            world = getWorld() or state.CurrentWorld,
            at = os.clock(),
            entered = false,
            requestedMode = modeName,
        }
        print("[Paraiso Modes] Return position saved for " .. modeName)
    end

    -- Called by the existing Mode-change watcher as soon as the player leaves.
    -- The server can reposition the character *after* clearing Mode, so delay the
    -- restoration until character + world + result UI have settled.
    local function beginModeReturn()
        local saved = state.ModeReturnSpot
        if not saved or not saved.entered or state.ModeReturnRestoring then return end
        state.ModeReturnRestoring = true
        state.ModeReturnCooldownUntil = os.clock() + 20
        local completedMode = saved.completedMode or saved.requestedMode
        if completedMode == "Tower" then
            -- Tower costs a key. Avoid re-spending keys just after an auto-leave.
            -- Toggling auto-create off/on allows another run.
            state.ModeReturnBlocked.Tower = true
            state.ModeReturnBlockedAt.Tower = os.clock()
        elseif completedMode == "Trial" or completedMode == "Raid" then
            -- Wait for this event to close before auto-joining the next opening.
            state.ModeReturnBlocked[completedMode] = true
            state.ModeReturnBlockedAt[completedMode] = os.clock()
            state.ModeReturnOpenSeenClosed[completedMode] = false
        end
        stopMoving()
        task.spawn(function()
            task.wait(2.0)
            local deadline = os.clock() + 35
            local lastPortalRequest = -math.huge
            local lastReason = ""
            local restored = false
            while state.Running and state.ModeReturnSpot == saved and os.clock() < deadline do
                if not isInWorld() then
                    lastReason = "Waiting for mode to end"
                    task.wait(0.5)
                else
                    local gui = player:FindFirstChild("PlayerGui")
                    local resultGui = gui and gui:FindFirstChild("GameResultGui")
                    local result = resultGui and resultGui:FindFirstChild("Game Result")
                    if result and result:IsA("GuiObject") and result.Visible then
                        lastReason = "Waiting for results screen"
                        task.wait(0.4)
                    else
                        local currentWorld = getWorld()
                        if saved.world and currentWorld and saved.world ~= currentWorld then
                            -- The server may return you to a different world.
                            -- Request normal portal travel back before restoring.
                            if os.clock() - lastPortalRequest >= 6 then
                                lastPortalRequest = os.clock()
                                sendModeRequest("General", "Portal", "Teleport", saved.world)
                            end
                            lastReason = "Waiting to return to " .. tostring(saved.world)
                            task.wait(0.6)
                        else
                            local root, humanoid = getParts()
                            if root and humanoid and player.Character then
                                -- A small lift prevents clipping into the ground.
                                local destination = saved.cf + Vector3.new(0, 2.5, 0)
                                cancelTween()
                                humanoid:MoveTo(root.Position)
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                player.Character:PivotTo(destination)
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                humanoid:MoveTo(root.Position)
                                task.wait(1.25)
                                local verify = getParts()
                                if verify and isInWorld() and
                                    (verify.Position - destination.Position).Magnitude < 14 then
                                    restored = true
                                    break
                                end
                                lastReason = "Waiting for stable character position"
                            else
                                lastReason = "Waiting for character respawn"
                            end
                            task.wait(0.5)
                        end
                    end
                end
            end
            if not state.Running or state.ModeReturnSpot ~= saved then return end
            if restored then
                print("[Paraiso Modes] Returned to original location after " .. tostring(completedMode))
            else
                warn("[Paraiso Modes] Could not restore the saved spot: " .. lastReason)
            end
            state.ModeReturnSpot = nil
            -- The event's own rejoin gate handles repeat joins. Keep only a
            -- brief movement-settling cooldown rather than blocking the next
            -- new opening for 12 more seconds.
            state.ModeReturnCooldownUntil = os.clock() + 3
            state.ModeReturnRestoring = false
        end)
    end

    -- Trial/Raid timers may stay open for a moment after leaving. Do not
    -- instantly queue another run. Auto-join re-arms on the next open cycle.
    local function updateModeRejoinGates()
        -- Reset when the current opening closes. The property-change watcher
        -- also catches openings that close/reopen between scheduler ticks.
        local trial = gameModes and gameModes:FindFirstChild("Trial")
        local raid = gameModes and gameModes:FindFirstChild("Raid")
        for modeName, folder in pairs({ Trial = trial, Raid = raid }) do
            if folder and state.ModeReturnBlocked[modeName] then
                local open = readModeValue(folder, "Open")
                local age = os.clock() - (state.ModeReturnBlockedAt[modeName] or os.clock())
                if open == false then
                    state.ModeReturnBlocked[modeName] = false
                    state.ModeReturnOpenSeenClosed[modeName] = true
                elseif age >= 600 then
                    -- Fail-safe only; avoid permanent blockage when a brief
                    -- Open=false change was missed by the local client.
                    state.ModeReturnBlocked[modeName] = false
                    warn("[Paraiso Modes] Expired stale " .. modeName .. " rejoin block")
                end
            end
        end
    end

    -- Observe the actual Open value transitions rather than relying on a
    -- once-per-second poll, which can miss short false states.
    local function watchOpening(modeName)
        local folder = gameModes and gameModes:FindFirstChild(modeName)
        local openValue = folder and folder:FindFirstChild("Open")
        if openValue and openValue:IsA("ValueBase") then
            local connection = openValue.Changed:Connect(function(value)
                if value == false then
                    state.ModeReturnBlocked[modeName] = false
                    state.ModeReturnOpenSeenClosed[modeName] = true
                end
            end)
            state.ModeReturnGateConnections = state.ModeReturnGateConnections or {}
            table.insert(state.ModeReturnGateConnections, connection)
        end
    end
    watchOpening("Trial")
    watchOpening("Raid")

    state.RememberModeReturnSpot = rememberModeReturnSpot
    state.BeginModeReturn = beginModeReturn
    state.UpdateModeRejoinGates = updateModeRejoinGates
    state.IsInWorld = isInWorld
    state.IsInGameMode = isInGameMode

end -- state.InitializeModeReturn
state.InitializeModeReturn()

local function tryJoinTimeTrial(now)
    -- Game's own GamemodeNotify does exactly this: when Trial.Open == true,
    -- it sends Join directly. No Enter / Remote_Enter / lobby teleport.
    if not canEnterNewMode() then return end
    local trialFolder = gameModes and gameModes:FindFirstChild("Trial")
    if readModeValue(trialFolder, "Open") ~= true then return end
    if now - state.TrialLastJoin < 18 or state.ModeReturnBlocked.Trial then return end
    state.RememberModeReturnSpot("Trial")
    if sendModeRequest("Gamemodes", "Trial", "Join") then
        state.TrialLastJoin = now
    end
end

local function ownTowerRoom()
    local tower = gameModes and gameModes:FindFirstChild("Tower")
    local rooms = tower and tower:FindFirstChild("Rooms")
    if not rooms then return nil end
    for _, room in ipairs(rooms:GetChildren()) do
        if room:GetAttribute("Status") == "Queue"
            and tonumber(room:GetAttribute("OwnerUserId")) == player.UserId then
            return room
        end
    end
    return nil
end

local function towerKeysAvailable()
    local data = nativeController and nativeController.Data
    local inventory = data and data.Inventory
    -- Tower client config: 1 TowerKey to create; joining is free.
    if type(inventory) ~= "table" then return false end
    local owned = tonumber(inventory.TowerKey) or 0
    local required = 1
    local config = shared and shared:FindFirstChild("Tower")
    if config and config:IsA("ModuleScript") then
        local ok, definitions = pcall(require, config)
        if ok and type(definitions) == "table" then
            required = tonumber(definitions.Entry_Key_Amount) or required
        end
    end
    return owned >= required
end

local function tryJoinOrCreateTower(now)
    -- Never join another player's Tower queue.
    if player:GetAttribute("TowerRoom") ~= nil then return end
    if player:GetAttribute("Mode") == "Tower" then return end
    if not canEnterNewMode() or state.ModeReturnBlocked.Tower then return end

    local room = ownTowerRoom()
    if room then
        -- The server may auto-assign the owner on creation. If it does not,
        -- join the room whose replicated OwnerUserId matches LocalPlayer.
        if now - state.TowerLastRequest >= 3 then
            state.RememberModeReturnSpot("Tower")
            if sendModeRequest("Gamemodes", "Tower", "Join", room.Name) then
                state.TowerLastRequest = now
            end
        end
        return
    end

    -- Give a newly-created room time to replicate before another Create.
    if now < state.TowerCreatePendingUntil then return end
    if now - state.TowerLastRequest < 20 then return end
    if not towerKeysAvailable() then return end

    state.RememberModeReturnSpot("Tower")
    if sendModeRequest("Gamemodes", "Tower", "Create", nil) then
        state.TowerLastRequest = now
        state.TowerCreatePendingUntil = now + 12
    end
end

local raidDefinitions
local raidModule = shared and shared:FindFirstChild("Raid")
if raidModule and raidModule:IsA("ModuleScript") then
    local ok, data = pcall(require, raidModule)
    if ok and type(data) == "table" then raidDefinitions = data end
end
local raidNames, raidDisplayIds = {}, {}
if raidDefinitions and type(raidDefinitions.Raids) == "table" then
    local ordered = {}
    for id, info in pairs(raidDefinitions.Raids) do
        if type(id) == "string" and type(info) == "table" then
            table.insert(ordered, { id = id, index = info.Index or math.huge, display = info.Display or id })
        end
    end
    table.sort(ordered, function(a, b)
        if a.index ~= b.index then return a.index < b.index end
        return a.id < b.id
    end)
    for _, item in ipairs(ordered) do
        table.insert(raidNames, item.display)
        raidDisplayIds[item.display] = item.id
    end
end
if #raidNames == 0 then
    raidNames = { "Solo City Raid", "Ninja Village Raid" }
    raidDisplayIds["Solo City Raid"] = "Solo City"
    raidDisplayIds["Ninja Village Raid"] = "Ninja Village"
end

local function raidHasKeyForAction(raidName, action)
    local info = raidDefinitions and raidDefinitions.Raids and raidDefinitions.Raids[raidName]
    if not info or not info.Entry_Item then return true end
    local creatorOnly = raidDefinitions.Settings and raidDefinitions.Settings.Creator_Pays_Only
    if action == "Join" and creatorOnly then return true end
    local inventory = nativeController and nativeController.Data and nativeController.Data.Inventory
    return type(inventory) == "table"
        and (tonumber(inventory[info.Entry_Item]) or 0) >= (tonumber(info.Entry_Amount) or 1)
end

local function availableRaidRoom(raidRoot, raidId)
    local rooms = raidRoot and raidRoot:FindFirstChild("Rooms")
    if not rooms then return nil end
    local best
    for _, room in ipairs(rooms:GetChildren()) do
        if room:GetAttribute("Status") == "Queue" and room:GetAttribute("Raid") == raidId then
            if not best or (tonumber(room:GetAttribute("Created")) or math.huge)
                < (tonumber(best:GetAttribute("Created")) or math.huge) then
                best = room
            end
        end
    end
    return best
end

local function ownRaidRoom(raidRoot, raidId)
    local rooms = raidRoot and raidRoot:FindFirstChild("Rooms")
    if not rooms then return nil end
    for _, room in ipairs(rooms:GetChildren()) do
        if room:GetAttribute("Status") == "Queue"
            and room:GetAttribute("Raid") == raidId
            and tonumber(room:GetAttribute("OwnerUserId")) == player.UserId then
            return room
        end
    end
    return nil
end

-- Note: FireServer reports only that the client sent a request. Room creation
-- is confirmed solely by a replicated owner-owned queue, not by pcall().
local function ninjaRaidFeedback(status, message)
    if state.NinjaLastStatus == status then return end
    state.NinjaLastStatus = status
    if status == "waiting" or status == "joined" or status == "creating" then
        -- No popup flood while simply waiting for the scheduled raid.
        return
    end
    pcall(function()
        window:Notify({ title = "Ninja Village Raid", content = message, duration = 5 })
    end)
    warn("[Paraiso Ninja Raid] " .. message)
end

local function tryJoinRaid(now)
    if player:GetAttribute("Mode") == "Raid" then return end
    if not canEnterNewMode() or state.ModeReturnBlocked.Raid then return end
    local raid = gameModes and gameModes:FindFirstChild("Raid")
    if not raid then
        if state.AutoJoinNinjaRaid then ninjaRaidFeedback("missing", "Raid state has not loaded yet") end
        return
    end
    -- The game's own Raid_Info script gates creation by both Open and Active.
    local active = readModeValue(raid, "Active")
    local open = readModeValue(raid, "Open") == true
    if not open then
        if state.AutoJoinNinjaRaid then ninjaRaidFeedback("waiting", "Waiting for the Ninja Village raid to open") end
        return
    end

    if active == "Solo City" and state.AutoJoinSoloRaid then
        if player:GetAttribute("RaidRoom") then return end
        if now - state.SoloLastRequestAt < 10 then return end
        local room = availableRaidRoom(raid, active)
        -- Solo City is free. Prefer a named queue; the portal's Join action
        -- also sends a no-room argument, as in the original client script.
        local ok
        state.RememberModeReturnSpot("Raid")
        if room then
            ok = sendModeRequest("Gamemodes", "Raid", "Join", room.Name)
        else
            ok = sendModeRequest("Gamemodes", "Raid", "Join")
        end
        if ok then state.SoloLastRequestAt = now end
        return
    end

    if active ~= "Ninja Village" or not state.AutoJoinNinjaRaid then
        if state.AutoJoinNinjaRaid then
            ninjaRaidFeedback("waiting", "Ninja Village is not the active raid")
        end
        return
    end

    local own = ownRaidRoom(raid, "Ninja Village")
    if own then
        -- Creating may already place the creator in the queue. Joining twice
        -- would be unnecessary and can be rejected by the server.
        if tostring(player:GetAttribute("RaidRoom")) == own.Name then
            ninjaRaidFeedback("joined", "Joined your Ninja Village raid room")
            return
        end
        if now - state.NinjaLastJoinAt >= 4 then
            state.RememberModeReturnSpot("Raid")
            if sendModeRequest("Gamemodes", "Raid", "Join", own.Name) then
                state.NinjaLastJoinAt = now
                ninjaRaidFeedback("joined", "Join requested for your Ninja Village room")
            end
        end
        return
    end

    -- Never join another player's room when own-room mode is selected.
    -- Check key availability before spending one on the server.
    if player:GetAttribute("RaidRoom") ~= nil then return end
    if now < state.NinjaCreatePendingUntil then return end
    if not raidHasKeyForAction("Ninja Village", "Create") then
        ninjaRaidFeedback("key", "Cannot create: 1 Raid Key required (or inventory not loaded)")
        return
    end
    if now - state.NinjaLastCreateAt < 18 then return end

    state.RememberModeReturnSpot("Raid")
    if sendModeRequest("Gamemodes", "Raid", "Create", "Ninja Village") then
        state.NinjaLastCreateAt = now
        state.NinjaCreatePendingUntil = now + 9
        ninjaRaidFeedback("creating", "Create requested; waiting for room replication")
        -- The request being sent does NOT mean that the server created a room.
        task.delay(9, function()
            if not state.Running or not state.AutoJoinNinjaRaid then return end
            if not ownRaidRoom(raid, "Ninja Village")
                and player:GetAttribute("RaidRoom") == nil
                and readModeValue(raid, "Open") == true
                and readModeValue(raid, "Active") == "Ninja Village" then
                ninjaRaidFeedback("unconfirmed",
                    "Create sent but no room appeared. Check key, raid timer and server restrictions.")
            end
        end)
    end
end

-- Live Game Mode watchers are read-only Rayfield Gen2 Text cards.
-- They do not introduce saved flags and will not modify auto-join/farm settings.
function state.CreateModeWatcher(kind)
    state.ModeWatcherCards = state.ModeWatcherCards or {}
    state.ModeWatcherCards[kind] = modesTab:CreateText({
        name = kind == "Trial" and "Time Trial Status" or "Solo City Raid Status",
        text = "Checking server status...",
        icon = "clock",
    })
end

function state.StartModeWatchers()
    task.spawn(function()
        -- This is the exact shared Raid module used by the game's own
        -- portal UI for its next-opening countdown.
        local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
        local raidModule = sharedFolder and sharedFolder:FindFirstChild("Raid")
        local raidShared = nil
        if raidModule and raidModule:IsA("ModuleScript") then
            local ok, result = pcall(require, raidModule)
            if ok and type(result) == "table" then raidShared = result end
        end

        local function clock(seconds)
            seconds = math.max(0, math.ceil(seconds))
            local hours = math.floor(seconds / 3600)
            local minutes = math.floor((seconds % 3600) / 60)
            local rest = seconds % 60
            return string.format("%02d:%02d:%02d", hours, minutes, rest)
        end

        local function getNumber(folder, name)
            if not folder then return nil end
            local number = readModeValue(folder, name)
            if number == nil then number = folder:GetAttribute(name) end
            return type(number) == "number" and number or nil
        end

        local function trialCountdown(folder)
            if not folder then return nil end
            local now = Workspace:GetServerTimeNow()
            -- Only interpret named opening timestamps as next opening times.
            -- Trial.Timer is the in-run HUD timer, NOT a verified next-open clock.
            for _, name in ipairs({
                "NextOpenAt", "NextOpeningAt", "NextStartAt",
                "NextOpenTime", "NextOpeningTime", "OpensAt",
            }) do
                local value = getNumber(folder, name)
                if value and value > now - 1 and value < now + 14 * 86400 then
                    return math.max(0, value - now)
                end
            end
            for _, name in ipairs({
                "TimeUntilOpen", "SecondsUntilOpen", "NextOpenIn", "CountdownToOpen",
            }) do
                local value = getNumber(folder, name)
                if value and value >= 0 then return value end
            end
            return nil
        end

        -- Portal UI discovery (game capture predates the current OPENS AT text).
        -- Search live TextLabels, including RichText/ContentText, without
        -- blocking the one-second status watcher on a large Workspace scan.
        local portalTrialLabel = nil
        local portalText = nil
        local lastPortalDiagnostic = "Not scanned yet"
        local scheduleFoundAt = -math.huge

        local function cleanedText(raw)
            if type(raw) ~= "string" then return "" end
            return (raw:gsub("<[^>]*>", " ")
                :gsub("&nbsp;", " ")
                :gsub("[%c]", " ")
                :gsub("%s+", " "))
        end

        local function scheduleText(raw)
            local plain = cleanedText(raw)
            local upper = plain:upper()
            -- Accept OPENS AT 16:22, OPENS AT:16:22, and OPENS IN: 00:16:22.
            if upper:match("OPEN[S]?%s+AT%s*:?%s*%d+:%d%d")
                or upper:match("OPEN[S]?%s+IN%s*:?%s*%d+:%d%d") then
                return plain
            end
            return nil
        end

        local function labelText(obj)
            if not obj or not obj.Parent then return nil end
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local ok, content = pcall(function() return obj.ContentText end)
                local formatted = ok and scheduleText(content) or nil
                if formatted then return formatted end
                return scheduleText(obj.Text)
            end
            if obj:IsA("StringValue") then
                return scheduleText(obj.Value)
            end
            return nil
        end

        local function isCandidateObject(obj)
            return obj:IsA("TextLabel") or obj:IsA("TextButton")
                or obj:IsA("TextBox") or obj:IsA("StringValue")
        end

        local function candidateScore(obj)
            local path = obj:GetFullName():lower()
            local score = 0
            if path:find("trial", 1, true) then score = score + 50 end
            if path:find("easy", 1, true) then score = score + 8 end
            if path:find("portal", 1, true) then score = score + 5 end
            if path:find("raid", 1, true) then score = score - 70 end
            if path:find("tower", 1, true) then score = score - 70 end
            if obj:IsA("GuiObject") and obj.Visible then score = score + 3 end
            return score
        end

        local function recordPortalResult(label, text)
            portalTrialLabel = label
            portalText = text
            scheduleFoundAt = os.clock()
            lastPortalDiagnostic = "Found " .. label:GetFullName()
            state.TrialPortalDiagnostic = lastPortalDiagnostic
            print("[Paraiso Trial Watch] " .. lastPortalDiagnostic .. " = " .. text)
        end

        -- Asynchronous scan: minimize stutter and keep status cards updating.
        task.spawn(function()
            local lastResult = nil
            while state.Running do
                if portalTrialLabel and portalTrialLabel.Parent then
                    local current = labelText(portalTrialLabel)
                    if current then
                        portalText = current
                        scheduleFoundAt = os.clock()
                        task.wait(2)
                        continue
                    end
                end

                portalTrialLabel = nil
                portalText = nil
                local candidates, checked, best, bestText, bestScore = {}, 0, nil, nil, -math.huge
                local seen = {}
                local roots = {}
                local function addRoot(candidate)
                    if candidate then roots[#roots + 1] = candidate end
                end
                addRoot(player:FindFirstChild("PlayerGui"))
                addRoot(Workspace:FindFirstChild("Client"))
                addRoot(Workspace:FindFirstChild("Server"))
                addRoot(Workspace)
                for _, root in ipairs(roots) do
                    if root then
                        -- Skip duplicate scanning of descendants of a prior root.
                        local nodes = root:GetDescendants()
                        for i, obj in ipairs(nodes) do
                            if not seen[obj] then
                                seen[obj] = true
                                if isCandidateObject(obj) then
                                    checked = checked + 1
                                    local content = labelText(obj)
                                    if content then
                                        local score = candidateScore(obj)
                                        if score > bestScore then
                                            best, bestText, bestScore = obj, content, score
                                        end
                                    elseif #candidates < 5 and (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
                                        local raw = cleanedText(obj.Text)
                                        if raw:upper():find("OPEN", 1, true) and #raw < 100 then
                                            candidates[#candidates + 1] = obj:GetFullName() .. " = " .. raw
                                        end
                                    end
                                end
                            end
                            if i % 600 == 0 then task.wait() end
                            if not state.Running then return end
                        end
                    end
                end
                if best and bestScore >= 0 then
                    recordPortalResult(best, bestText)
                else
                    local diagnostic = "No Trial portal countdown found in " .. tostring(checked) .. " text objects"
                    state.TrialPortalDiagnostic = diagnostic
                    if diagnostic ~= lastResult then
                        warn("[Paraiso Trial Watch] " .. diagnostic)
                        for _, item in ipairs(candidates) do
                            print("[Paraiso Trial Watch] Other opening text: " .. item)
                        end
                        lastResult = diagnostic
                    end
                end
                task.wait(9)
            end
        end)

        local function readTrialPortalSchedule()
            if portalTrialLabel and portalTrialLabel.Parent then
                local current = labelText(portalTrialLabel)
                if current then return current end
            end
            if portalText and os.clock() - scheduleFoundAt < 10 then
                return portalText
            end
            return nil
        end

        local lastTrialText, lastRaidText = nil, nil
        -- Trial.Timer is the same replicated value read by the native Trial
        -- HUD and open-event notification. During a closed period, only call
        -- it an "opens in" countdown after observing that it ticks downward.
        local lastTrialOpen, lastClosedTrialTimer = nil, nil
        local closedTrialTimerCountingDown = false
        while state.Running do
            local trial = gameModes and gameModes:FindFirstChild("Trial")
            local trialOpen = readModeValue(trial, "Open")
            local liveTrialTimer = getNumber(trial, "Timer")
            if trialOpen ~= lastTrialOpen then
                lastClosedTrialTimer = nil
                closedTrialTimerCountingDown = false
                lastTrialOpen = trialOpen
            end

            local trialText
            if trialOpen == true then
                trialText = "OPEN  |  You can join now"
                if liveTrialTimer and liveTrialTimer > 0 then
                    trialText = trialText .. "  |  Time left " .. clock(liveTrialTimer)
                end
            elseif trialOpen == false then
                local seconds = trialCountdown(trial)
                if liveTrialTimer and liveTrialTimer >= 0 and liveTrialTimer < 86400 then
                    if lastClosedTrialTimer and liveTrialTimer < lastClosedTrialTimer then
                        closedTrialTimerCountingDown = true
                    end
                    lastClosedTrialTimer = liveTrialTimer
                end
                if seconds == nil and closedTrialTimerCountingDown
                    and liveTrialTimer and liveTrialTimer > 0 then
                    seconds = liveTrialTimer
                end
                -- Use the portal's displayed schedule if the replicated
                -- timer has no confirmed meaning while the Trial is closed.
                local portalSchedule = readTrialPortalSchedule()
                if seconds ~= nil then
                    trialText = "CLOSED  |  Opens in " .. clock(seconds)
                elseif portalSchedule then
                    local trimmed = portalSchedule:gsub("%s+", " ")
                    trialText = "CLOSED  |  " .. trimmed
                elseif liveTrialTimer and liveTrialTimer > 0 then
                    trialText = "CLOSED  |  Trial timer " .. clock(liveTrialTimer)
                else
                    trialText = "CLOSED  |  Searching portal time (see console diagnostics)"
                end
            else
                trialText = "UNKNOWN  |  Waiting for Trial.Open"
            end
            if trialText ~= lastTrialText then
                lastTrialText = trialText
                local card = state.ModeWatcherCards and state.ModeWatcherCards.Trial
                if card then pcall(function() card:Set(trialText) end) end
            end

            local raid = gameModes and gameModes:FindFirstChild("Raid")
            local raidOpen = readModeValue(raid, "Open")
            local activeRaid = readModeValue(raid, "Active")
            local raidText
            if raidOpen == true and activeRaid == "Solo City" then
                local remaining = getNumber(raid, "Timer")
                raidText = "OPEN  |  Solo City Raid accepting players"
                if remaining and remaining > 0 then
                    raidText = raidText .. "  |  Timer " .. clock(remaining)
                end
            else
                local seconds
                if raidShared and type(raidShared.Get_Time_Until_Open) == "function" then
                    local ok, time = pcall(raidShared.Get_Time_Until_Open,
                        raidShared, Workspace:GetServerTimeNow(), "Solo City")
                    if ok and type(time) == "number" and time >= 0 then
                        seconds = time
                    end
                end
                if seconds then
                    raidText = "CLOSED  |  Solo City opens in " .. clock(seconds)
                elseif raid then
                    raidText = "CLOSED  |  Next opening time unavailable"
                else
                    raidText = "UNKNOWN  |  Waiting for Raid data"
                end
            end
            if raidText ~= lastRaidText then
                lastRaidText = raidText
                local card = state.ModeWatcherCards and state.ModeWatcherCards.SoloRaid
                if card then pcall(function() card:Set(raidText) end) end
            end
            task.wait(1)
        end
    end)
end

