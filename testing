function Hub:CapturedStageHint(id, stage, requestedKind)
    if not QuestMarkersModule then return nil end
    local ok,defs=pcall(QuestMarkersModule.Get,id,stage)
    if not ok or type(defs)~="table" then return nil end
    local kinds={}
    if requestedKind then
        table.insert(kinds,requestedKind)
    else
        for _,d in ipairs(defs) do
            if d.Folder then table.insert(kinds,"Folder:"..d.Folder)
            elseif d.QuestGiver then table.insert(kinds,"Giver") end
        end
    end
    for _,kind in ipairs(kinds) do
        if kind=="Giver" and self.CapturedQuestGivers[id] then
            return {Id=id,Stage=stage,Kind="Giver",Label="Saved quest giver anchor",
                Position=self.CapturedQuestGivers[id],At=os.clock(),Captured=true}
        end
        local folder=kind:match("^Folder:(.+)$")
        local points=folder and self.CapturedQuestProps[id]
            and self.CapturedQuestProps[id][folder]
        if points and #points>0 then
            local routeKey=id.."|"..tostring(stage).."|"..kind
            local route=self.CapturedStageRoute[routeKey]
            local _,root=myCharacter()
            if not route then
                local sorted={}
                for _,item in ipairs(points) do table.insert(sorted,item) end
                table.sort(sorted,function(a,b)
                    if not root then return a.Name < b.Name end
                    return (a.Position-root.Position).Magnitude
                        < (b.Position-root.Position).Magnitude
                end)
                route={List=sorted,Index=1,ArrivedAt=0}
                self.CapturedStageRoute[routeKey]=route
            end
            local point=route.List[route.Index]
            if root and (point.Position-root.Position).Magnitude<22 then
                if route.ArrivedAt==0 then route.ArrivedAt=os.clock() end
                if os.clock()-route.ArrivedAt>6.5 and #route.List>1 then
                    route.Index=route.Index%#route.List+1
                    route.ArrivedAt=0
                    point=route.List[route.Index]
                end
            else
                route.ArrivedAt=0
            end
            return {Id=id,Stage=stage,Kind=kind,Label="Saved "..folder
                .." #"..point.Name,Position=point.Position,
                At=os.clock(),Captured=true}
        end
    end
    return nil
end
function Hub.QuestFns.knownQuestMarker(id, stage, kind)
    local best
    local now = os.clock()
    for _, entry in pairs(Hub.QuestKnownPositions) do
        if entry.Id == id and entry.Stage == stage
            and (not kind or entry.Kind == kind)
            and now - entry.At < 1800 then
            if not best or entry.At > best.At then best = entry end
        end
    end
    return best or Hub:CapturedStageHint(id,stage,kind)
end
-- Boss navigation uses the map's static *area* points, never a ghost NPC.
-- Require the live MapBossPoints module first; the fallback coordinates are
-- copied from the user's provided place capture and may need refreshing after
-- a game update. Each point is a destination, not proof the boss is spawned.
function Hub:GetBossAreaPoint(targetName)
    if self.BossMapPoints == nil then
        local catalog = {}
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local data = shared and shared:FindFirstChild("Data")
        local module = data and data:FindFirstChild("MapBossPoints")
        local ok, list = false, nil
        if module and module:IsA("ModuleScript") then
            ok, list = pcall(require, module)
        end
        if ok and type(list)=="table" then
            for _, point in pairs(list) do
                if type(point)=="table" and type(point.Label)=="string"
                    and typeof(point.Position)=="Vector3" then
                    catalog[point.Label:lower():gsub("[^%w]","")] = {
                        Position=point.Position, Source="ReplicatedStorage.Shared.Data.MapBossPoints",
                        Label=point.Label
                    }
                end
            end
        end
        if next(catalog)==nil then
            local known = {
                ["Frost Fang"]=Vector3.new(-5695,441,-1198),
                ["Dracolith"]=Vector3.new(-27,401,-2885),
                ["Fox Bear"]=Vector3.new(-3024,208,-583),
                ["Master of the Swamp"]=Vector3.new(-4918,-20,-1715),
                ["Sandy Storm"]=Vector3.new(-3965,320,2093),
                ["Beach King"]=Vector3.new(-3474,419,2134),
                ["Crimson Flame"]=Vector3.new(-2825,217,319),
                ["Stone Eye"]=Vector3.new(-2565,-754,-6768),
                ["Mole Rat"]=Vector3.new(-3352,-789,-7238),
            }
            for name, position in pairs(known) do
                catalog[name:lower():gsub("[^%w]","")] = {
                    Position=position,Source="Captured MapBossPoints fallback",Label=name
                }
            end
        end
        self.BossMapPoints = catalog
    end
    local key=tostring(targetName or ""):lower():gsub("[^%w]","")
    -- "Dracolith (Summon Altar)" and "Frost Fang (Raid Boss)" aren't exact keys.
    if key=="blackblick" then key="blick" end
    local direct=self.BossMapPoints[key]
    if direct then return direct.Position, direct.Source, direct.Label end
    -- E.g. "The Crimson Flame [Boss]" if a quest definition uses a title.
    for name, entry in pairs(self.BossMapPoints) do
        if key:find(name,1,true) or name:find(key,1,true) then
            return entry.Position, entry.Source, entry.Label
        end
    end
    return nil,"No known boss area in MapBossPoints",nil
end

function Hub:GetBossRespawn(name)
    local folder=workspace:FindFirstChild("BossRespawnTimers")
    if not folder then return "Respawn timer not streamed" end
    local key=tostring(name or ""):lower():gsub("[^%w]","")
    for _, marker in ipairs(folder:GetChildren()) do
        if marker:IsA("BasePart") then
            local label=tostring(marker:GetAttribute("BossName") or marker.Name)
                :lower():gsub("[^%w]","")
            if label==key or (key~="" and label:find(key,1,true)) then
                local respawn=marker:GetAttribute("RespawnAt")
                if type(respawn)=="number" then
                    local remaining=respawn-workspace:GetServerTimeNow()
                    if remaining>0 then
                        return string.format("Respawns in %ds (server timer)",math.ceil(remaining))
                    end
                    return "Timer elapsed; spawn not confirmed"
                end
                return "Boss timer exists; RespawnAt unavailable"
            end
        end
    end
    return "No timer marker currently streamed for "..tostring(name)
end

-- Quest-only live NPC discovery. Saved spawn coordinates tell us WHERE to look,
-- never WHETHER a mob exists. Nearby replicas must win over area navigation.
-- This has its own cadence to avoid overwhelming Heartbeat or the game world.
function Hub.QuestFns.refreshQuestEnemies(myRoot, targetName)
    if not myRoot or not myRoot.Parent then return end
    local now=os.clock()
    if now < Hub.QuestScanNextAt then return end
    Hub.QuestScanNextAt = now + 0.24
    local registered=0

    -- Overlap detection can miss entire rigs when their parts have CanQuery=false
    -- and the old MaxParts=400 was consumed by terrain/buildings. Scan *all*
    -- returned parts, not only the first 400, and then refresh live folders.
    local questParams=OverlapParams.new()
    questParams.FilterType=Enum.RaycastFilterType.Exclude
    local char=LocalPlayer.Character
    if char then questParams.FilterDescendantsInstances={char} end
    questParams.MaxParts=0
    local ok,parts=pcall(function()
        return workspace:GetPartBoundsInRadius(myRoot.Position,90,questParams)
    end)
    Hub.QuestScanNearbyParts=ok and #parts or 0
    if ok and parts then
        local checked={}
        for _,part in ipairs(parts) do
            local node=part:FindFirstAncestorOfClass("Model")
            local hops=0
            while node and hops < 5 and not node:FindFirstChildOfClass("Humanoid") do
                node=node.Parent and node.Parent:FindFirstAncestorOfClass("Model")
                hops+=1
            end
            if node and not checked[node] then
                checked[node]=true
                if not Hub.Observed[node] then
                    registerEnemy(node)
                    if Hub.Observed[node] then registered+=1 end
                end
            end
        end
    end
    Hub.QuestScanRegistered=registered

    -- NPCs in streamed folders may have all CanQuery=false parts. Reinspect
    -- those folders asynchronously, including roaming and alternative roots.
    if not Hub.QuestFullScanBusy and now-Hub.QuestFullScanAt >= 1.8 then
        Hub.QuestFullScanAt=now
        Hub.QuestFullScanBusy=true
        task.spawn(function()
            local okScan,err=pcall(function()
                local world=workspace:FindFirstChild("World")
                local live=world and world:FindFirstChild("Live")
                if live then scan(live) end
                for _,folderName in ipairs({"RoamingNpcs","Humanoids","NPCs",
                    "Enemies","Mobs","LiveNPCs"}) do
                    local folder=workspace:FindFirstChild(folderName)
                    if folder then scan(folder) end
                end
            end)
            Hub.QuestFullScanBusy=false
            if not okScan then Hub.QuestScanSummary="Folder scan error: "..tostring(err) end
        end)
    end
end

function Hub.QuestFns.chooseQuestEnemy(targetName, myRoot)
    local best, distance = nil, math.huge
    local matchedNames, liveMatches, nearSeen = 0,0,0
    local nearestLabels={}
    for _,record in pairs(Hub.Observed) do
        if record.Model and record.Model.Parent and record.Root and record.Root.Parent
            and record.Hum and record.Hum.Health>0 then
            local dst=(record.Root.Position-myRoot.Position).Magnitude
            if dst <= 115 then
                nearSeen+=1
                if #nearestLabels < 6 then
                    local display=record.NPCName or (record.Hum and record.Hum.DisplayName)
                        or record.Model.Name
                    table.insert(nearestLabels,tostring(display))
                end
            end
            -- Check identity BEFORE liveness, to expose strict liveness
            -- rejections. Do not choose another enemy merely for being close.
            if selectionMatches(record,targetName) then
                matchedNames+=1
                if activeNpcRecord(record) then
                    liveMatches+=1
                    if dst < distance then best,distance=record,dst end
                end
            end
        end
    end
    Hub.QuestScanNameMatches=matchedNames
    Hub.QuestScanLiveMatches=liveMatches
    Hub.QuestScanCandidateNames=#nearestLabels>0 and table.concat(nearestLabels,", ") or "None"
    Hub.QuestScanSummary=string.format("Target %s: %d identity matches, %d live; %d nearby records; %d nearby parts; %d newly registered",
        tostring(targetName),matchedNames,liveMatches,nearSeen,
        Hub.QuestScanNearbyParts,Hub.QuestScanRegistered)
    return best
end
-- Map markers are *destinations*, not proof of an actionable prompt.
-- Some of the active quest props spawn a separate QuestInteract-tagged prompt.
local QuestCollection=game:GetService("CollectionService")
function Hub.QuestFns.questPrompt(obj,id,where)
    if not obj then return nil end
    local function good(prompt)
        if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
        local owner=prompt:GetAttribute("Quest") or prompt:GetAttribute("QuestId")
            or prompt:GetAttribute("MarkerQuest")
        if owner and owner~=id then return false end
        return true
    end
    if good(obj) then return obj end
    for _,prompt in ipairs(obj:GetDescendants()) do
        if good(prompt) then return prompt end
    end
    local questFolder=workspace:FindFirstChild("ExplorativeQuests")
    questFolder=questFolder and questFolder:FindFirstChild(id)
    local function inspect(container)
        if not container then return nil end
        local best,dist=nil,math.huge
        for _,item in ipairs(container:GetDescendants()) do
            if good(item) then
                local p=Hub.QuestFns.objPosition(item.Parent)
                if p and where then
                    local d=(p-where).Magnitude
                    if d<dist and d<14 then best,dist=item,d end
                end
            end
        end
        return best
    end
    local found=inspect(questFolder)
    if found then return found end
    local best,dist=nil,math.huge
    for _,item in ipairs(QuestCollection:GetTagged("QuestInteract")) do
        if good(item) then
            local p=Hub.QuestFns.objPosition(item.Parent)
            if p and where then
                local d=(p-where).Magnitude
                if d<dist and d<11 then best,dist=item,d end
            end
        end
    end
    return best
end
function Hub.QuestFns.questStableProgressKey(stage, progress, raw)
    local pieces={tostring(stage),tostring(progress)}
    if type(raw)=="string" then table.insert(pieces,raw)
    elseif type(raw)=="table" then
        for k,v in pairs(raw) do
            if v then table.insert(pieces,tostring(k)..":"..tostring(v)) end
        end
        table.sort(pieces)
    end
    return table.concat(pieces,"|")
end

function Hub.QuestFns.questMarkerTargets(id,stage,state)
    local list={}
    if not QuestMarkersModule then return list end
    local cacheKey = tostring(id).."|"..tostring(stage).."|"
        ..questStableProgressKey(stage,tonumber(state and state.stage_progress) or 0,
            type(state)=="table" and state.done_spots or nil)
    local now = os.clock()
    local prior = Hub.QuestMarkerScanCache
    if prior and prior.Key == cacheKey and now - prior.At < 0.6 then
        local valid = true
        for _, point in ipairs(prior.List) do
            if not point.Object or not point.Object:IsDescendantOf(workspace) then
                valid = false; break
            end
        end
        if valid then return prior.List end
    end
    local markerOK,markers=pcall(QuestMarkersModule.Get,id,stage)
    if not markerOK or type(markers)~="table" then return list end
    local world=workspace:FindFirstChild("World")
    local questFolder=workspace:FindFirstChild("ExplorativeQuests")
    questFolder=questFolder and questFolder:FindFirstChild(id)
    local done={}
    local raw=type(state)=="table" and state.done_spots
    if type(raw)=="string" then
        for name in raw:gmatch("[^,]+") do done[name]=true end
    elseif type(raw)=="table" then
        for k,v in pairs(raw) do
            if type(k)=="number" and type(v)=="string" then done[v]=true
            elseif type(k)=="string" and v then done[k]=true end
        end
    end
    local function consider(inst,label,kind)
        local position=Hub.QuestFns.objPosition(inst)
        if not position or (inst:IsA("BasePart") and done[inst.Name]) then return end
        local prompt=Hub.QuestFns.questPrompt(inst,id,position)
        if prompt then
            local realPosition=Hub.QuestFns.objPosition(prompt.Parent)
            if realPosition then position=realPosition end
        end
        local kindName = kind or "Location"
        local displayName = label or inst.Name
        -- Save as a streaming HINT only; a cached point is never treated as a
        -- valid live prompt or a living target after its Instance disappears.
        Hub.QuestKnownPositions[id.."|"..tostring(stage).."|"..kindName.."|"..tostring(inst.Name)] = {
            Id=id,Stage=stage,Kind=kindName,Label=displayName,
            Position=position,At=os.clock()
        }
        table.insert(list,{Object=inst,Position=position,Label=displayName,
            Kind=kindName,Prompt=prompt})
    end
    for _,marker in ipairs(markers) do
        if marker.QuestGiver then
            local anchors=questFolder and questFolder:FindFirstChild("NpcAnchor")
            if anchors then
                for _,item in ipairs(anchors:GetChildren()) do
                    if item:IsA("BasePart") then consider(item,marker.Label,"Giver") end
                end
            elseif world then
                local fakeRoot={Position=Vector3.zero}
                local giver=Hub.QuestFns.findGiver(id,fakeRoot)
                if giver then consider(giver.Part,marker.Label,"Giver") end
            end
        elseif marker.Folder and questFolder then
            local folder=questFolder:FindFirstChild(marker.Folder)
            if folder then
                for _,item in ipairs(folder:GetChildren()) do
                    if item:IsA("BasePart") or item:IsA("Model") then
                        consider(item,marker.Label,"Folder:"..marker.Folder)
                    end
                end
            end
        elseif marker.Path and world then
            local item=world
            for _,part in ipairs(marker.Path) do item=item and item:FindFirstChild(part) end
            if item then consider(item,marker.Label,"Path") end
        elseif marker.Tag then
            for _,item in ipairs(QuestCollection:GetTagged(marker.Tag)) do
                if (item:GetAttribute("MarkerOwnerUserId")==nil
                    or item:GetAttribute("MarkerOwnerUserId")==LocalPlayer.UserId)
                    and (item:GetAttribute("MarkerQuest")==nil
                    or item:GetAttribute("MarkerQuest")==id) then
                    consider(item,marker.Label,"Tag:"..marker.Tag)
                end
            end
        elseif marker.MapIcon then
            -- Map icon handles in the native controller are not replicated
            -- as ordinary coordinates: don't fabricate a position.
        end
    end
    Hub.QuestMarkerScanCache = {Key=cacheKey, At=os.clock(), List=list}
    return list
end
-- For dialogue stages, the active stage often names the NPC directly,
-- even when the marker module has not streamed a location yet.
function Hub.QuestFns.questDialogueActor(id,objective,myRoot)
    local wording=tostring(objective or "")
    local name=wording:match("[Tt]alk to%s+([%w%s%-']+)")
        or wording:match("[Rr]eturn to%s+([%w%s%-']+)")
        or wording:match("[Rr]eport back to%s+([%w%s%-']+)")
        or wording:match("[Vv]isit%s+([%w%s%-']+)")
    if not name then return nil end
    name=name:gsub("[%.%!].*$",""):gsub("%s+and%s+.*$","")
        :gsub("%s+in%s+.*$",""):gsub("%s+at%s+.*$","")
        :gsub("%s+for%s+.*$",""):gsub("%s+$","")
    if #name<3 or #name>40 then return nil end
    local key=id.."|"..name
    local now=os.clock()
    if Hub.QuestActorSearchKey==key and now-Hub.QuestActorSearchAt<1.5 then
        return Hub.QuestActorSearchResult
    end
    Hub.QuestActorSearchAt=now;Hub.QuestActorSearchKey=key
    local wanted=name:lower()
    local best,bestDist=nil,math.huge
    local world=workspace:FindFirstChild("World")
    local sources={}
    for _,candidate in ipairs({"Quests","NPCs"}) do
        local found=world and world:FindFirstChild(candidate)
        if found then table.insert(sources,found) end
    end
    local explorative=workspace:FindFirstChild("ExplorativeQuests")
    if explorative then table.insert(sources,explorative) end
    for _,folder in ipairs(sources) do
        if folder then
            for _,obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("Model") and obj.Name:lower():find(wanted,1,true) then
                    local pos=Hub.QuestFns.objPosition(obj)
                    local dist=pos and (pos-myRoot.Position).Magnitude or math.huge
                    if dist<bestDist then
                        best={Object=obj,Position=pos,Label=obj.Name,Kind="NPC",Prompt=nil}
                        bestDist=dist
                    end
                end
            end
        end
    end
    Hub.QuestActorSearchResult=best
    return best
end

function Hub.QuestFns.selectQuestMarker(id,stage,state,myRoot,kind)
    local points=Hub.QuestFns.questMarkerTargets(id,stage,state)
    local candidates={}
    for _,point in ipairs(points) do
        if not kind or point.Kind==kind then table.insert(candidates,point) end
    end
    Hub.QuestDebugVisibleMarkers = #candidates
    Hub.QuestDebugLastMarker = #candidates==0 and "No visible stage markers"
        or (tostring(candidates[1].Label).." ["..tostring(candidates[1].Kind).."]")
    table.sort(candidates,function(a,b)
        -- First choose actionable markers, then their actual distance.
        if (a.Prompt~=nil)~=(b.Prompt~=nil) then
            return a.Prompt~=nil
        end
        return (a.Position-myRoot.Position).Magnitude
            < (b.Position-myRoot.Position).Magnitude
    end)
    if candidates[1] then
        local spot = candidates[1]
        Hub.QuestDebugLastMarker = tostring(spot.Label).." ["..tostring(spot.Kind).."]"
            .. (spot.Prompt and " | prompt present" or " | no prompt")
    end
    return candidates[1]
end
function Hub.QuestFns.questCarryingPlank()
    local char=LocalPlayer.Character
    if not char then return false end
    for _,name in ipairs({"CarryingPlank","HoldingPlank","CarryingLog","HoldingLog"}) do
        if char:GetAttribute(name)==true or LocalPlayer:GetAttribute(name)==true then return true end
    end
    for _,obj in ipairs(char:GetDescendants()) do
        if (obj.Name=="Log" or obj.Name=="Plank" or obj.Name=="QuestPlank")
            and (obj:IsA("BasePart") or obj:IsA("Model")) then
            return true
        end
    end
    return false
end
function Hub.QuestFns.questWithinReach(position, root, radius, object)
    if not root or typeof(position)~="Vector3" then return false end
    local d=position-root.Position
    if d.Magnitude>radius or math.abs(d.Y)>6.5 then return false end
    if d.Magnitude<.35 then return true end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LocalPlayer.Character,object}
    params.IgnoreWater=true
    local hit=workspace:Raycast(root.Position,d,params)
    return hit==nil or (hit.Position-position).Magnitude<2.3
end
function Hub.QuestFns.questTryPrompt(spot,id,stage,now)
    if not spot then return false end
    local prompt=spot.Prompt or Hub.QuestFns.questPrompt(spot.Object,id,spot.Position)
    if not prompt or not prompt.Enabled then
        local why = not prompt and "No active ProximityPrompt" or "Prompt disabled"
        Hub.QuestDebugLastPrompt = why.." | "..tostring(spot.Label)
        Hub.QuestFns.questDebugEvent("PROMPT", Hub.QuestDebugLastPrompt)
        return false
    end
    local pos=Hub.QuestFns.objPosition(prompt.Parent) or spot.Position
    local _,root=myCharacter()
    local range=math.max(3, prompt.MaxActivationDistance-0.6)
    if not root or not Hub.QuestFns.questWithinReach(pos,root,range,prompt.Parent) then
        Hub.QuestDebugLastPrompt = "Out of range/line-of-sight: "..prompt.Name
        Hub.QuestFns.setQuestMovement(pos,id..":"..stage..":prompt",math.min(range,5))
        Hub.QuestFns.questStatus("Travel","Approaching interaction: "..tostring(spot.Label))
        return false
    end
    local key=id..":"..stage..":"..prompt:GetFullName()
    if key~=Hub.QuestPromptKey then
        Hub.QuestPromptKey,Hub.QuestPromptTries=key,0
    end
    if Hub.QuestPromptTries>=3 then
        Hub.QuestDebugLastPrompt="Attempts exhausted: "..spot.Label
        Hub.QuestFns.questDebugEvent("PROMPT", Hub.QuestDebugLastPrompt)
        Hub.QuestFns.questStatus("Needs interaction","Prompt did not advance progress after 3 attempts: "..spot.Label)
        return false
    end
    if now<Hub.QuestNextInteract then return false end
    Hub.QuestPromptTries+=1
    Hub.QuestNextInteract=now+math.max(3.0,prompt.HoldDuration+2.0)
    Hub.QuestDebugLastPrompt = "Trying "..prompt.Name.." "..Hub.QuestPromptTries.."/3"
    Hub.QuestFns.questDebugEvent("PROMPT",Hub.QuestDebugLastPrompt.." | "..tostring(spot.Label))
    local success,reason=pcall(function()
        if type(fireproximityprompt)=="function" then
            fireproximityprompt(prompt)
        else
            -- Use the native prompt's local hold behavior if the executor
            -- doesn't expose fireproximityprompt. This may still require
            -- user input or server-side validation.
            prompt:InputHoldBegin()
            task.delay(math.max(0.15,prompt.HoldDuration+0.1),function()
                if prompt and prompt.Parent then pcall(function() prompt:InputHoldEnd() end) end
            end)
        end
    end)
    if success then
        if prompt:GetAttribute("ServerProgress")==true then
            local token=Hub.QuestRunToken
            task.spawn(function()
                local ok,service=pcall(function()
                    return Knit.GetService("ExplorativeQuestService")
                end)
                if ok and service and type(service.SetPourHeld)=="function" then
                    pcall(function() service:SetPourHeld(true) end)
                    task.wait(math.clamp(prompt.HoldDuration+0.6,0.65,10))
                    pcall(function() service:SetPourHeld(false) end)
                end
            end)
        end
        Hub.QuestDeliveryLastAttempt=now
        Hub.QuestDebugLastPrompt = "Input sent; awaiting server progress: "..prompt.Name
        Hub.QuestFns.questStatus("Interacting","Attempt "..Hub.QuestPromptTries.."/3: "..spot.Label
            .." (waiting for server progress)")
    else
        Hub.QuestDebugLastPrompt = "Interaction error: "..tostring(reason)
        Hub.QuestFns.questDebugEvent("PROMPT ERROR",Hub.QuestDebugLastPrompt)
        Hub.QuestFns.questStatus("Interaction error",tostring(reason))
    end
    return success
end
function Hub.QuestFns.questDirectRemote(method)
    -- Exact Knit remote structure from the supplied game capture.
    local package=ReplicatedStorage:FindFirstChild("Packages")
    local knitFolder=package and package:FindFirstChild("knit")
    local services=knitFolder and knitFolder:FindFirstChild("Services")
    if not services and package then
        local index=package:FindFirstChild("_Index")
        if index then
            for _,version in ipairs(index:GetChildren()) do
                if version.Name:find("sleitnick_knit",1,true) then
                    local k=version:FindFirstChild("knit")
                    services=k and k:FindFirstChild("Services")
                    if services then break end
                end
            end
        end
    end
    local service=services and services:FindFirstChild("QuestsService")
    local rf=service and service:FindFirstChild("RF")
    local remote=rf and rf:FindFirstChild(method)
    return remote and remote:IsA("RemoteFunction") and remote or nil
end
function Hub.QuestFns.questRemoteRequest(method,id,onOK)
    local now=os.clock()
    if Hub.QuestRequestBusy or now < Hub.QuestNextRequest then return false end
    Hub.QuestRequestBusy=true
    -- Busy state already serializes actual remote calls. Do not impose an
    -- extra multi-second wait after successful completion or collection.
    Hub.QuestNextRequest=now+0.8
    Hub.QuestDebugLastRemote = method.."("..tostring(id)..") pending"
    Hub.QuestFns.questDebugEvent("REMOTE SEND",Hub.QuestDebugLastRemote)
    local token=Hub.QuestRunToken
    local requestId=(Hub.QuestRequestSequence or 0)+1
    Hub.QuestRequestSequence=requestId
    local function process(ok,result)
        if not Hub.Running or token~=Hub.QuestRunToken
            or requestId~=Hub.QuestRequestSequence then return end
        Hub.QuestRequestBusy=false
        Hub.QuestDebugLastRemote = method.."("..tostring(id)..") "
            ..(not ok and "ERROR: "..tostring(result)
                or (result==false and "REJECTED" or "returned: "..tostring(result)))
        if method=="get_quest" then
            Hub.QuestAcceptLastResponse = tostring(result)
            Hub.QuestAcceptLastId = id
            if ok and result~=nil and result~=false then
                Hub.QuestAcceptOutcome="Response received; awaiting ActiveQuests"
                Hub.QuestAcceptFailures=0
                Hub.QuestAcceptHoldUntil=os.clock()+2.6
            else
                Hub.QuestAcceptFailures += 1
                Hub.QuestAcceptHoldUntil=os.clock()+math.min(2.8+Hub.QuestAcceptFailures*1.8,8)
                Hub.QuestAcceptOutcome = not ok and ("Remote exception: "..tostring(result))
                    or (result==false and "Explicitly rejected" or "nil response: acceptance not confirmed")
                if Hub.QuestAcceptFailures>=3 then
                    Hub.QuestAcceptPaused=true
                    Hub.QuestAcceptOutcome=Hub.QuestAcceptOutcome
                        .." | 3 failures: paused; use Retry Quest Acceptance"
                end
            end
        end
        Hub.QuestFns.questDebugEvent("REMOTE RESULT",Hub.QuestDebugLastRemote)
        if not ok then
            Hub.QuestNextRequest=os.clock()+5
            Hub.QuestFns.questStatus("Remote error",method.." failed: "..tostring(result))
        elseif result==false or (method=="get_quest" and result==nil) then
            Hub.QuestNextRequest=os.clock()+5
            Hub.QuestFns.questStatus("Acceptance not confirmed",method.."("..id..") returned "..tostring(result)
                .."; check giver distance, prerequisites, completed quests, and other active quests")
        else
            Hub.QuestNextRequest=os.clock()+0.35
            if onOK then onOK(result) end
        end
    end
    task.spawn(function()
        local remote=Hub.QuestFns.questDirectRemote(method)
        if remote then
            Hub.QuestRemoteBackend="Direct RF: "..method
            Hub.QuestFns.questDebugEvent("REMOTE BACKEND",Hub.QuestRemoteBackend)
            local ok,value=pcall(function()
                if method=="get_quest" then
                    -- Fast path: direct server request, without streaming a
                    -- quest board or moving the avatar. This is the same RF
                    -- exposed by the game's Knit QuestsService.
                    local acceptOK,accepted=pcall(function()
                        return remote:InvokeServer(id,"yes")
                    end)
                    -- Some board contracts need the native board viewing
                    -- session. Retry WITH the board RF only on explicit false,
                    -- not on nil (which might have changed server state).
                    if acceptOK and accepted==false
                        and Hub.QuestSelectedData and Hub.QuestSelectedData.board then
                        local boardView=Hub.QuestFns.questDirectRemote("set_board_viewing")
                        if boardView then
                            local opened=pcall(function() boardView:InvokeServer(true) end)
                            if opened then
                                Hub.QuestFns.questDebugEvent("BOARD SESSION","RF-only retry for "..id)
                                acceptOK,accepted=pcall(function()
                                    return remote:InvokeServer(id,"yes")
                                end)
                                pcall(function() boardView:InvokeServer(false) end)
                            end
                        end
                    end
                    if not acceptOK then error(accepted) end
                    return accepted
                end
                return remote:InvokeServer(id)
            end)
            process(ok,value)
            return
        end
        -- Preserve native Knit proxy as a compatibility fallback, since
        -- the client capture does not guarantee remote folders are loaded.
        local service=Hub.QuestFns.questService()
        if not service or type(service[method])~="function" then
            Hub.QuestRemoteBackend="No available quest remote"
            process(false,"QuestsService."..method.." unavailable")
            return
        end
        Hub.QuestRemoteBackend="Knit proxy: "..method
        Hub.QuestFns.questDebugEvent("REMOTE BACKEND",Hub.QuestRemoteBackend)
        local ok,promise=pcall(function()
            if method=="get_quest" then return service:get_quest(id,"yes") end
            return service[method](service,id)
        end)
        if not ok then process(false,promise);return end
        if promise and type(promise.andThen)=="function" then
            local promiseOK=pcall(function()
                promise:andThen(function(v) process(true,v) end)
                    :catch(function(err) process(false,err) end)
            end)
            if not promiseOK then process(false,"Failed to attach quest promise") end
        else
            process(true,promise)
        end
    end)
    -- An unresolved remote call should not hold the workflow forever.
    task.delay(9,function()
        if Hub.Running and token==Hub.QuestRunToken
            and requestId==Hub.QuestRequestSequence and Hub.QuestRequestBusy then
            Hub.QuestRequestBusy=false
            Hub.QuestNextRequest=os.clock()+5
            Hub.QuestDebugLastRemote=method.."("..tostring(id)..") timeout"
            Hub.QuestFns.questDebugEvent("REMOTE TIMEOUT",Hub.QuestDebugLastRemote)
            Hub.QuestFns.questStatus("Remote timeout",method.." didn't return; checking replicated quest state")
        end
    end)
    return true
end

-- v52 Storyline Board gate. Dialog NPCs call StorylineBoardService:unlock(id)
-- at the end of their intro and :claim(id) after all board quests.
-- Only a changed SB_<id> attribute confirms success.
function Hub:V52BoardGate(info,root)
    local contact=info and self.V52BoardContacts[info.board or ""]
    if not contact or not root then return false end
    local key="SB_"..contact.Id
    local state=LocalPlayer:GetAttribute(key)
    if state~="Intro" and state~=nil and state~="Complete" then return false end
    -- Claim board completion rewards independently from an individual quest.
    local action=(state=="Complete") and "claim" or "unlock"
    local job=self.V52BoardJobs[contact.Id]
    if not job then job={Next=0,Pending=false,Attempts=0};self.V52BoardJobs[contact.Id]=job end
    local world=workspace:FindFirstChild("World")
    local folder=world and world:FindFirstChild("BetterDialogNpcs")
    local npc=folder and folder:FindFirstChild(contact.Npc)
    local npcRoot=npc and (npc:FindFirstChild("HumanoidRootPart") or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart"))
    local target=npcRoot and npcRoot.Position or contact.Position
    self.QuestCombatActive=false;self.QuestTarget=nil
    -- Never start get_quest while this board still needs an NPC introduction.
    self.QuestFns.requestQuestStreaming(target,"story board NPC "..contact.Npc)
    if (target-root.Position).Magnitude>9 then
        local teleported,reason=questTeleportNear(target,"story-npc:"..contact.Id)
        if not teleported and reason~="Teleport settling" then
            self.QuestFns.setQuestMovement(target,"story-npc:"..contact.Id,5)
        end
        self.QuestFns.questStatus("Unlock story board", "Visiting "..contact.Npc.." for "..contact.Id.." | "..tostring(reason))
        return true
    end
    self.QuestFns.clearQuestMovement()
    if not npcRoot or not npcRoot.Parent then
        self.QuestFns.questStatus("Loading board NPC", "At "..contact.Npc.."'s saved location; waiting for NPC to stream")
        return true
    end
    if job.Pending then
        self.QuestFns.questStatus("Confirm board "..action,contact.Npc.." | waiting for "..key.." to change")
        return true
    end
    if os.clock()<job.Next then
        self.QuestFns.questStatus("Board "..action.." cooldown",contact.Npc.." | waiting for replicated state")
        return true
    end
    local service=self:V44Service("StorylineBoardService")
    if not service or type(service[action])~="function" then
        self.QuestFns.questStatus("Board service missing", "Can't "..action.." "..contact.Id.."; native StorylineBoardService unavailable")
        job.Next=os.clock()+5
        return true
    end
    job.Pending=true;job.Next=os.clock()+8;job.Attempts+=1
    self.QuestFns.questStatus("Board "..action, "Interacting with "..contact.Npc.."; verifying "..key)
    local token=self.QuestRunToken
    task.spawn(function()
        local ok,reply=pcall(function() return service[action](service,contact.Id) end)
        if ok and reply and type(reply.andThen)=="function" then
            -- Promise callback is only an acknowledgement; state is authoritative.
            pcall(function() reply:andThen(function() end):catch(function() end) end)
        end
        local deadline=os.clock()+6
        while self.Running and self.AutoQuest and self.QuestRunToken==token
            and os.clock()<deadline and LocalPlayer:GetAttribute(key)==state do
            task.wait(.12)
        end
        job.Pending=false
        if not self.Running or self.QuestRunToken~=token then return end
        local current=LocalPlayer:GetAttribute(key)
        if current~=state and current~=nil then
            job.Next=0;job.Attempts=0;self.QuestNextRequest=0
            self.QuestFns.questStatus("Board ready", contact.Npc.." | "..key.." = "..tostring(current))
        else
            job.Next=os.clock()+math.min(28,8+job.Attempts*4)
            self.QuestFns.questStatus("Board unconfirmed",contact.Npc.." | "..action.." sent, but "..key.." unchanged")
        end
    end)
    return true
end

function Hub.QuestFns.questTick()
    if not Hub.AutoQuest or Hub.V70NenPriority then return end
    local info = Hub.QuestSelectedData
    if not info or not info.id or info.id == "None" then
        Hub.QuestTarget, Hub.QuestCombatActive = nil, false
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestFns.questStatus("Select quest", "Choose a real quest above before enabling Auto Quest")
        return
    end
    local id = info.id
    if Hub.QuestLastId ~= id then
        Hub.QuestLastId = id
        -- Prevent an old quest's locked NPC/progress from carrying into
        -- the next selection, even when its stage number is the same.
        Hub.QuestTarget=nil
        Hub.QuestCombatActive=false
        Hub.QuestFarmState.Target=nil
        Hub.QuestLastKillStage=nil
        Hub.QuestLastKillProgress=nil
        Hub.QuestScanNextAt=0
        Hub.QuestScanSummary="New quest selection"
        Hub.QuestAcceptFailures,Hub.QuestAcceptHoldUntil=0,0
        Hub.QuestAcceptPaused,Hub.QuestAcceptOutcome=false,"No attempt"
        Hub.QuestAllActiveIds="Not checked"
        Hub.QuestStageObjective="Awaiting activation of "..id
        Hub.QuestProgress="Not active"
        Hub.QuestFinishedId = nil
        Hub.QuestNextRequest = 0
        Hub.QuestAcceptSentAt = 0
        Hub.QuestBoardSettlingUntil = 0
        Hub.QuestLastStage = nil
        Hub.QuestDeliveryPhase="Pickup"
        Hub.QuestDeliverySince=0
        Hub.QuestDeliveryPendingAt=0
        Hub.QuestDeliveryProgress=nil
    end
    if Hub.QuestFinishedId == id then
        -- Even after a quest is finished, the storyline NPC may have the
        -- board-completion reward ready. Claim via native service and verify.
        if info.board then
            local _,finishedRoot=myCharacter()
            if finishedRoot and Hub:V52BoardGate(info,finishedRoot) then return end
        end
        Hub.QuestCombatActive, Hub.QuestTarget = false, nil
        Hub.QuestFns.clearQuestMovement()
        -- Repeat is only possible after an explicit toggle and a server
        -- confirmation that this quest can be repeated.
        if info.category == "Leveling" and Hub.QuestRepeatLeveling
            and not info.oneTime and Hub.QuestClaimSentAt > 0
            and os.clock() - Hub.QuestClaimSentAt >= 0.35 then
            Hub.QuestFinishedId = nil
            Hub.QuestCollectAttempt = 0
            Hub.QuestNextRequest = 0
        else
            Hub.QuestFns.questStatus("Complete", "Quest finished; choose another or enable leveling repeats")
            return
        end
    end
    local char, myRoot = myCharacter()
    if not char or not myRoot then
        Hub.QuestCombatActive, Hub.QuestTarget = false, nil
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestFns.questStatus("Waiting", "Waiting for alive character")
        return
    end
    local def = Hub.QuestFns.questDefinition(id)
    if not def then Hub.QuestFns.questStatus("Error", "Quest definition not found: "..id); return end
    local active = Hub.QuestFns.questProgressState(id)
    if active then
        Hub.QuestLastActiveId,Hub.QuestLastActiveAt=id,os.clock()
        Hub.QuestRepeatRequestedAt=0
        Hub.QuestAcceptPaused=false
        Hub.QuestAcceptFailures=0
        Hub.QuestAcceptHoldUntil=0
        Hub.QuestAcceptOutcome="Confirmed in ActiveQuests"
        Hub.QuestAllActiveIds=Hub:QuestActiveIdSummary()
    end
    local completed = Hub.QuestFns.questPreviouslyCompleted(id)
    local currentLevel = tonumber(LocalPlayer:GetAttribute("Level"))
        or tonumber(Hub.QuestFns.questPlayerData("Level"))
    Hub.QuestLiveLevel = currentLevel
    Hub.QuestResolvedBoard = info.board or "Unknown"
    if not active and info.requiresNen then
        local unlocked = Hub.QuestFns.questPlayerData("NenUnlocked")
        if unlocked == nil then unlocked = LocalPlayer:GetAttribute("NenUnlocked") end
        if unlocked == false then
            Hub.QuestPrerequisite = "Nen must be unlocked"
            Hub.QuestTarget, Hub.QuestCombatActive = nil,false
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Prerequisite", "Unlock Nen first; then Activate Nen can continue")
            return
        end
    end
    if not active and info.level and currentLevel and currentLevel < info.level then
        Hub.QuestTarget, Hub.QuestCombatActive = nil, false
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestFns.questStatus("Level gate", ("%s requires Lv %d; current Lv %d. Waiting to unlock.")
            :format(id,info.level,currentLevel))
        return
    end
    if not active and completed then
        local repeatableLeveling = info.category == "Leveling"
            and not info.oneTime and Hub.QuestRepeatLeveling
        if def.CAN_ONLY_BE_DONE_ONCE or (Hub.QuestSkipCompleted and info.uiCategory=="Explorative" and not repeatableLeveling) then
            Hub.QuestTarget, Hub.QuestCombatActive = nil, false
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFinishedId = id
            Hub.QuestFns.questStatus("Already completed", "Skipping finished quest: "..id)
            return
        end
    end
    if not active and info.board and Hub:V52BoardGate(info,myRoot) then return end
    if not active then
        Hub.QuestCombatActive, Hub.QuestTarget = false, nil
        Hub.QuestStageObjective = "Not active: "..id
        Hub.QuestProgress = "Not active"
        Hub.QuestAllActiveIds = Hub:QuestActiveIdSummary()
        -- A collected quest may disappear from ActiveQuests immediately.
        -- Handle that *before* the generic 12-second replica-loss guard.
        if Hub.QuestCollectAttempt == 3 and Hub.QuestClaimSentAt > 0
            and not Hub.QuestRequestBusy then
            Hub.QuestFinishedId=id
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Complete", "Quest reward claim confirmed by removal from ActiveQuests")
            return
        end
        -- An unconfirmed disappearance is still treated cautiously.
        if Hub.QuestLastActiveId == id and os.clock()-Hub.QuestLastActiveAt<12
            and Hub.QuestCollectAttempt~=3
            and not (completed and Hub.QuestRepeatLeveling
                and info.category=="Leveling" and not info.oneTime
                and not def.CAN_ONLY_BE_DONE_ONCE
                and Hub.QuestClaimSentAt>0) then
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Sync active quest", "Active quest briefly disappeared; checking server state")
            return
        end
        if completed and Hub.QuestRepeatLeveling and info.category == "Leveling"
            and not info.oneTime and not def.CAN_ONLY_BE_DONE_ONCE then
            Hub.QuestFns.clearQuestMovement()
            if Hub.QuestRepeatRequestedId == id
                and os.clock() - Hub.QuestRepeatRequestedAt < 2.25 then
                Hub.QuestFns.questStatus("Repeat pending", "Waiting for repeat_quest replication; nil return is not confirmed success")
                return
            end
            Hub.QuestFns.questStatus("Repeat leveling", "Requesting deliberate repeat of "..id)
            if Hub.QuestFns.questRemoteRequest("repeat_quest", id, function(result)
                Hub.QuestFns.questStatus("Repeat requested", "Awaiting replicated active quest (result="..tostring(result)..")")
            end) then
                Hub.QuestRepeatRequestedId,Hub.QuestRepeatRequestedAt=id,os.clock()
            end
            return
        end
        if completed and def.CAN_ONLY_BE_DONE_ONCE then
            Hub.QuestFinishedId = id
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Complete", "This is a one-time quest already completed")
            return
        end
        -- Do not flood a rejected quest remote. This is crucial for one-time
        -- side quests such as HouseRepairs; nil is not successful acceptance.
        if Hub.QuestAcceptPaused then
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Acceptance paused",id.." not active after 3 failures. "
                ..Hub.QuestAcceptOutcome.." | active quests: "..Hub.QuestAllActiveIds)
            return
        end
        if os.clock() < (Hub.QuestAcceptHoldUntil or 0) then
            Hub.QuestFns.questStatus("Awaiting acceptance",id.." has not replicated. "
                ..Hub.QuestAcceptOutcome.." | next check in "
                ..math.ceil(Hub.QuestAcceptHoldUntil-os.clock()).."s")
            return
        end
        -- v76: accept using verified native QuestsService remotes from the
        -- current position. The old branch traveled to board/giver anchors
        -- before even trying the RF and caused seconds of wasted movement.
        -- NPC visits still occur for quest STAGES with real prompts, and
        -- StorylineBoardService intro gates remain handled above.
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestResolvedBoard = (info.board and ("Direct RF | "..info.board))
            or "Direct RF | explorative"
        local now=os.clock()
        if Hub.QuestRequestBusy then
            Hub.QuestFns.questStatus("Quest RF busy", "Waiting for prior request to finish: "..id)
            return
        end
        if now-(Hub.QuestAcceptSentAt or 0)<2.6 then
            Hub.QuestFns.questStatus("Confirming direct acceptance",
                "Awaiting replicated ActiveQuests: "..id)
            return
        end
        if now<Hub.QuestNextRequest then
            Hub.QuestFns.questStatus("Quest RF cooldown",
                "Waiting for backend: "..id)
            return
        end
        Hub.QuestFns.questStatus("Direct acceptance", "QuestsService.get_quest("..id..") — no board travel")
        if Hub.QuestFns.questRemoteRequest("get_quest",id,function(result)
            Hub.QuestFns.questStatus("Verifying acceptance",
                "Direct RF replied ("..typeof(result).."); checking ActiveQuests: "..id)
        end) then
            Hub.QuestAcceptSentAt=now
            Hub.QuestBoardNavigation="Skipped: direct RF acceptance"
        end
        return
    end
    Hub.QuestAcceptSentAt=0
    local stages = def.STAGES or {}
    local stage = tonumber(active.stage) or 1
    local current = stages[stage]
    local need = tonumber(current and current.needs) or 1
    local progress = tonumber(active.stage_progress) or 0
    Hub.QuestProgress = ("%s | stage %d/%d | %d/%d"):format(id, stage, #stages, progress, need)
    local progressKey=Hub.QuestFns.questStableProgressKey(stage,progress,active.done_spots)
    if Hub.QuestLastStage ~= stage or Hub.QuestPromptBaseline ~= progressKey then
        local stageChanged=Hub.QuestLastStage~=stage
        Hub.QuestDebugLastProgress = string.format("%s | stage %d/%d | %d/%d | %s",
            id,stage,#stages,progress,need,tostring(current and current.label or "Unknown"))
        Hub.QuestFns.questDebugEvent("PROGRESS",Hub.QuestDebugLastProgress)
        Hub.QuestLastStage = stage
        Hub.QuestPromptBaseline = progressKey
        Hub.QuestNextInteract = 0
        Hub.QuestPromptKey, Hub.QuestPromptTries = "", 0
        if Hub.QuestDeliveryProgress~=progress or stageChanged then
            Hub.QuestDeliveryPhase="Pickup"
            Hub.QuestDeliverySince=0
            Hub.QuestDeliveryPendingAt=0
            Hub.QuestDeliveryProgress=progress
        end
    end
    local objective = current and current.label or "Unknown objective"
    Hub.QuestStageObjective = objective
    if objective:lower():find("reach level",1,true) then
        local required = tonumber(objective:match("[Ll]evel%s+(%d+)"))
        if required and (not currentLevel or currentLevel < required) then
            Hub.QuestTarget, Hub.QuestCombatActive = nil,false
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Level milestone", ("%s | Lv %s/%d | quest remains active")
                :format(id,tostring(currentLevel or "?"),required))
            return
        end
        -- The server advances this stage; don't claim it locally or retry acceptance.
        if required and stage <= #stages then
            Hub.QuestTarget, Hub.QuestCombatActive = nil,false
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Milestone reached", "Waiting for server quest stage to advance")
            return
        end
    end
    local finished = stage > #stages or (stage == #stages and progress >= need)
    if finished then
        if Hub.QuestHandoffId~=id then
            Hub.QuestHandoffId=id
            Hub.QuestHandoffPose=myRoot.CFrame
            -- One-time hover on claim transition; do not renew every tick.
            Hub.QuestHandoffUntil=os.clock()+0.35
        end
        Hub.QuestCombatActive, Hub.QuestTarget = false, nil
        -- The game exposes finish_last_stage + collect as QuestsService RFs.
        -- Do both directly before even considering a physical NPC visit;
        -- walking to a board is not part of this remote workflow.
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestBoardNavigation="Skipped: direct RF reward collection"
        -- The native controller calls finish_last_stage before collecting.
        -- Never assume a request confirms completion until replicated state
        -- changes, and recover after timeouts/rejections.
        local now = os.clock()
        if Hub.QuestCollectAttempt == 0 and now >= Hub.QuestNextRequest then
            Hub.QuestFns.questStatus("Finish", "Confirming last stage with server")
            if Hub.QuestFns.questRemoteRequest("finish_last_stage", id, function()
                Hub.QuestCollectAttempt = 2
                Hub.QuestFns.questStatus("Collect", "Ready to request quest reward")
            end) then Hub.QuestCollectAttempt = 1 end
        elseif Hub.QuestCollectAttempt == 1 and now > Hub.QuestNextRequest
            and not Hub.QuestRequestBusy then
            Hub.QuestCollectAttempt = 0
        elseif Hub.QuestCollectAttempt == 2 and now >= Hub.QuestNextRequest then
            Hub.QuestFns.questStatus("Collect", "Requesting reward for " .. id)
            if Hub.QuestFns.questRemoteRequest("collect", id, function()
                Hub.QuestClaimSentAt = os.clock()
                Hub.QuestFns.questStatus("Verifying", "Reward claim sent; checking replicated quest state")
            end) then
                Hub.QuestCollectAttempt = 3
                Hub.QuestClaimSentAt = now
            end
        elseif Hub.QuestCollectAttempt == 3 and now - Hub.QuestClaimSentAt > 0.7
            and not Hub.QuestRequestBusy then
            if Hub.QuestFns.questProgressState(id) == nil or Hub.QuestFns.questPreviouslyCompleted(id) then
                Hub.QuestFinishedId = id
                Hub.QuestFns.questStatus("Complete", "Quest completion confirmed in player data")
            else
                Hub.QuestCollectAttempt = 2
                Hub.QuestFns.questStatus("Collect", "Still active; retrying reward claim")
            end
        end
        return
    end
    Hub.QuestCollectAttempt = 0
    Hub.QuestHandoffUntil=0
    Hub.QuestHandoffPose=nil
    Hub.QuestHandoffId=nil
    local targetName = type(def.KILL_TARGET)=="string" and def.KILL_TARGET or nil
    if id == "ForestRescue" and stage == 1 then targetName = "Phantom Raider" end
    if targetName and targetName~="" and progress < need then
        -- Server-confirmed kill credit can arrive before the corpse disappears
        -- or before its humanoid reaches Health=0 on the client. Exclude the
        -- last fought model briefly and move to the next actually living NPC.
        if Hub.QuestLastKillStage == stage
            and Hub.QuestLastKillProgress ~= nil
            and progress > Hub.QuestLastKillProgress then
            local old = Hub.QuestTarget or Hub.FarmTarget
            if old and old.Model then
                -- Server's increase in kill credit is stronger than a delayed
                -- client corpse Health/Dead attribute. Never keep orbiting it.
                Hub.QuestCreditExclusions[old.Model] = os.clock() + 2.5
                Hub.QuestTarget = nil
                Hub.QuestFarmState.Target=nil
                Hub.QuestFarmState.Nav=nil
                Hub.QuestFarmState.Velocity=Vector3.zero
                Hub.QuestFarmState.UnavailableSince=nil
                Hub.QuestScanNextAt=0
                Hub:ReleaseFarmFlight()
                Hub.RetargetsAfterDeath += 1
                Hub.QuestFns.questDebugEvent("CREDIT", "Kill credit confirmed; acquiring next living target")
            end
        end
        Hub.QuestLastKillStage = stage
        Hub.QuestLastKillProgress = progress
        Hub.QuestCombatActive = true
        -- Don't reset a boss-area travel route every 0.25 seconds.
        -- Keep it until a live target is found or the selected quest changes.
        -- Stay with the chosen living mob, including when it is knocked
        -- across the arena. Never switch solely because another one is nearer.
        local questHeld=Hub.QuestTarget and Hub.QuestTarget.Model
            and Hub.QuestTarget.Hum and Hub.QuestTarget.Root
            and not modelDeadOrDespawning(Hub.QuestTarget.Model,Hub.QuestTarget.Hum)
            and spawnIsLive(Hub.QuestTarget)
            and selectionMatches(Hub.QuestTarget,targetName)
        if not questHeld then
            -- First discover real NPC rigs in the player's current location.
            -- Quest travel to pre-recorded spawns is ONLY a fallback when
            -- there is no live matching NPC around or in replicated folders.
            Hub.QuestFns.refreshQuestEnemies(myRoot,targetName)
            local picked=Hub.QuestFns.chooseQuestEnemy(targetName, myRoot)
            Hub.QuestTarget=picked
            local diagnostic=picked and ("Live target: "..tostring(picked.Model.Name))
                or ("No live "..tostring(targetName).." | "..Hub.QuestScanSummary)
            if diagnostic~=Hub.QuestDebugLastTarget then
                Hub.QuestDebugLastTarget=diagnostic
                Hub.QuestFns.questDebugEvent("TARGET",diagnostic)
            end
            Hub.FarmTarget=nil
            Hub.FarmNextSearch=0
        end
        if Hub.QuestTarget then
            Hub.QuestCombatActive=true
            if Hub.QuestTarget.Root and Hub.QuestTarget.Root.Anchored
                and (Hub.QuestTarget.EmergingUntil or 0)>os.clock() then
                Hub.QuestFarmState.Status="Waiting for "..targetName.." to emerge"
                Hub.QuestFns.questStatus("Spawn animation",Hub.QuestFarmState.Status)
            end
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestBossPoint,Hub.QuestBossDistance=nil,nil
            Hub.QuestBossRespawn="Spawned living NPC detected"
            Hub.QuestFns.questStatus("Combat", Hub.QuestProgress .. " | moving to " .. targetName
                .. (Hub.AutoAttack and " | Auto Attack enabled"
                    or " | enable Auto Attack in Combat tab to deal damage"))
        else
            -- No living matching NPC is currently targeted. Don't leave the
            -- previous enemy's physics stabilizer holding the character up.
            Hub.QuestCombatActive=false
            Hub.QuestFarmState.Status="Searching for a living "..tostring(targetName)
            Hub.QuestFarmState.Target=nil
            Hub.QuestFarmState.Nav=nil
            Hub.QuestFarmState.Velocity=Vector3.zero
            Hub.QuestHandoffPose=nil
            Hub.QuestHandoffUntil=0
            Hub:ReleaseFarmFlight()
            Hub.FarmTarget = nil
            -- Bosses often stream out while the player is beside the board.
            -- Travel to their KNOWN AREA even with no live NPC instance; once
            -- there, use ONLY actual spawned/live humanoids to fight.
            local area,pointSource = Hub:GetBossAreaPoint(targetName)
            local isBoss = info.category == "Boss" or def.BOSS == true
                or (area ~= nil and objective:lower():find("boss",1,true) ~= nil)
            if isBoss and area then
                Hub.QuestBossPoint,Hub.QuestBossPointSource=area,pointSource
                Hub.QuestBossDistance=(myRoot.Position-area).Magnitude
                Hub.QuestBossRespawn=Hub:GetBossRespawn(targetName)
                local now=os.clock()
                if now>=Hub.QuestBossNextScan then
                    Hub.QuestBossNextScan=now+2.0
                    local bossFolder=workspace:FindFirstChild(targetName)
                    if bossFolder then scan(bossFolder) end
                    local worldLive=workspace:FindFirstChild("World")
                    worldLive=worldLive and worldLive:FindFirstChild("Live")
                    if worldLive then
                        local npcFolder=worldLive:FindFirstChild("NPC")
                        if npcFolder then scan(npcFolder) else scan(worldLive) end
                    end
                    local candidates=0
                    for _,r in pairs(Hub.Observed) do
                        if selectionMatches(r,targetName) then candidates+=1 end
                    end
                    Hub.QuestBossCandidates=candidates
                end
                Hub.QuestFns.requestQuestStreaming(area, "boss area: "..targetName)
                if Hub.QuestBossDistance>45 then
                    Hub.QuestFns.setQuestMovement(area,id..":"..stage..":boss-area:"..targetName,10)
                    local band=math.floor(Hub.QuestBossDistance/50)*50
                    Hub.QuestFns.questStatus("Travel to boss",targetName.." | ~"..band
                        .." studs to mapped area; searching for a living spawn")
                else
                    Hub.QuestFns.clearQuestMovement()
                    Hub.QuestFns.questStatus("Wait for boss", "At "..targetName.." area; boss not live/streamed. "
                        ..Hub.QuestBossRespawn.." | visible candidates: "
                        ..tostring(Hub.QuestBossCandidates))
                end
            else
                -- The supplied place has ReplicatedStorage.NpcSpawnPoints,
                -- including normal mob spawns. This lets us reach the area
                -- even before that area or its mobs are locally streamed.
                local spawn,source,index,count,dist =
                    Hub:NextKnownNpcArea(targetName,myRoot.Position,"quest")
                Hub.QuestBossPoint,Hub.QuestBossDistance=nil,nil
                Hub.QuestBossPointSource="Not a boss objective"
                if spawn then
                    Hub.QuestAreaStatus=string.format("%s spawn %d/%d | %d studs | %s",
                        targetName,index,count,math.floor(dist),source)
                    Hub.QuestFns.requestQuestStreaming(spawn,"mob spawn: "..targetName)
                    if dist>18 then
                        Hub.QuestFns.setQuestMovement(spawn,id..":"..stage..":known-spawn:"..targetName,7)
                        Hub.QuestFns.questStatus("Travel to mob",Hub.QuestAreaStatus)
                    else
                        Hub.QuestFns.clearQuestMovement()
                        Hub.QuestFns.questStatus("Scan mob spawn",Hub.QuestAreaStatus
                            .. (count>1 and " | checking next spawn in ~3s"
                                or " | only one verified spawn; awaiting respawn/stream")
                            .. " | " .. tostring(Hub.QuestScanSummary))
                    end
                else
                    Hub.QuestFns.clearQuestMovement()
                    Hub.QuestAreaStatus=tostring(source)
                    Hub.QuestFns.questStatus("Spawn unavailable",tostring(source)
                        .."; this place capture has no verified point for this mob")
                end
            end
        end
        return
    end
    Hub.QuestCombatActive = false
    Hub.QuestTarget = nil
    -- Special progression stages require their own validated mechanisms, not
    -- generic prompt spam (Nen unlocking, crafting, inventory, story rooms).
    local lowerObjective = objective:lower()
    local specialStage = (id=="StarterWeapon" and (stage==2 or stage==3 or stage==4 or stage==5))
        or (id=="ActivateNen" and (stage==1 or stage==3 or stage==5))
        or (id=="StarterQuest" and stage==2)
        or (id=="RoadToOneStarHunter" and stage==1)
        or (id=="LineageAwakening" and stage>=2)
    if specialStage then
        Hub.QuestFns.clearQuestMovement()
        Hub.QuestFns.questStatus("Special progression", ("Stage %d/%d: %s | perform game-specific action; waiting for server progress")
            :format(stage,#stages,objective))
        return
    end
    -- Stage-specific objective handling: never choose the nearest marker if
    -- a delivery requires visiting TWO distinct points in order.
    local now=os.clock()
    local spot
    if id=="HouseRepairs" and stage==1 then
        local carrying=Hub.QuestFns.questCarryingPlank()
        if Hub.QuestDeliveryProgress~=progress then
            Hub.QuestDeliveryPhase="Pickup"
            Hub.QuestDeliveryProgress=progress
            Hub.QuestDeliveryPendingAt=0
        end
        if carrying then
            Hub.QuestDeliveryPhase="Deliver"
        -- Do not time out the pickup while traveling across the map.
        -- Only retry after reaching the giver and failing to obtain credit.
        end
        local wantsDelivery=Hub.QuestDeliveryPhase=="Deliver"
        spot=Hub.QuestFns.selectQuestMarker(id,stage,active,myRoot,
            wantsDelivery and "Giver" or "Folder:PlankPile")
        if not spot then
            local kind = wantsDelivery and "Giver" or "Folder:PlankPile"
            local saved = Hub.QuestFns.knownQuestMarker(id, stage, kind)
            if saved then
                Hub.QuestFns.requestQuestStreaming(saved.Position,kind)
                if (saved.Position-myRoot.Position).Magnitude>70 then
                    local landed,why=questTeleportNear(saved.Position,id..":"..stage..":stream:"..kind)
                    if not landed and why~="Teleport settling" then
                        Hub.QuestFns.setQuestMovement(saved.Position,id..":"..stage..":stream:"..kind,5)
                    end
                else
                    Hub.QuestFns.setQuestMovement(saved.Position,id..":"..stage..":stream:"..kind,5)
                end
                Hub.QuestFns.questStatus("Waiting for streaming", "Heading toward last verified "..kind..
                    " position; interaction will resume only when the prop streams in")
            else
                Hub.QuestFns.clearQuestMovement()
                Hub.QuestFns.questStatus("Quest prop not loaded", "No currently streamed "..kind..
                    " and no previously observed position; cannot locate it from this client")
            end
            return
        end
        local within=Hub.QuestFns.questWithinReach(spot.Position,myRoot,5.2,spot.Object)
        if not within then
            Hub.QuestFns.setQuestMovement(spot.Position,id..":"..stage..":"..Hub.QuestDeliveryPhase,4.1)
            Hub.QuestFns.questStatus("Delivery",string.format("%d/%d planks | %s",progress,need,
                wantsDelivery and "Taking plank to Foreman Grant" or "Going to plank pile"))
            return
        end
        Hub.QuestFns.clearQuestMovement()
        if wantsDelivery then
            -- Delivery might be a touch trigger, not a prompt. Wait for
            -- replicated stage_progress to change before returning to pile.
            if spot.Prompt then Hub.QuestFns.questTryPrompt(spot,id,stage,now) end
            if Hub.QuestDeliverySince==0 then Hub.QuestDeliverySince=now end
            if now-Hub.QuestDeliverySince>8 then
                if not carrying and Hub.QuestDeliveryPendingAt>0 then
                    Hub.QuestDeliveryPhase="Pickup"
                    Hub.QuestDeliveryPendingAt=0
                    Hub.QuestDeliverySince=0
                    Hub.QuestFns.questStatus("Delivery unverified","No server credit; retrying plank pickup")
                else
                    Hub.QuestFns.questStatus("Delivery not confirmed","At Foreman Grant, but server hasn't credited plank "
                        ..tostring(progress+1).."; inspect carrying state/prompt")
                end
            else
                Hub.QuestFns.questStatus("Delivering",("Plank %d/%d | waiting for server credit")
                    :format(progress+1,need))
            end
        else
            if carrying then
                Hub.QuestDeliveryPhase="Deliver"
                Hub.QuestDeliverySince=0
                return
            end
            local did=Hub.QuestFns.questTryPrompt(spot,id,stage,now)
            if did then
                Hub.QuestDeliveryPhase="Deliver"
                Hub.QuestDeliveryPendingAt=now
                Hub.QuestDeliverySince=0
            elseif not spot.Prompt then
                Hub.QuestFns.questStatus("Pickup unavailable","Reached plank pile but no active pickup prompt is visible")
            end
        end
        return
    end
    spot=Hub.QuestFns.selectQuestMarker(id,stage,active,myRoot)
    local actor=Hub.QuestFns.questDialogueActor(id,objective,myRoot)
    if actor and (not spot or spot.Kind=="Giver" or not spot.Prompt) then
        spot=actor
    end
    if not spot then
        local saved = Hub.QuestFns.knownQuestMarker(id,stage)
        -- Never use the quest board as the default destination for an unknown
        -- pickup/delivery stage. Only fall back to a known giver for an actual
        -- dialogue/return objective.
        local text = objective:lower()
        local isDialogue = text:find("talk to",1,true)
            or text:find("return to",1,true)
            or text:find("report back",1,true)
            or text:find("speak to",1,true)
        local known = (saved and saved.Position)
            or (isDialogue and Hub.QuestKnownGivers[id] or nil)
        if known then
            Hub.QuestFns.requestQuestStreaming(known,objective)
            if info.uiCategory=="Explorative" and (known-myRoot.Position).Magnitude>65 then
                local landed,reason=questTeleportNear(known,id..":"..stage..":stream:"..objective)
                if not landed and reason~="Teleport settling" then
                    Hub.QuestFns.setQuestMovement(known,id..":"..stage..":stream:"..objective,5)
                end
            else
                Hub.QuestFns.setQuestMovement(known,id..":"..stage..":stream:"..objective,5)
            end
            Hub.QuestFns.questStatus("Waiting for streaming", ("Stage %d/%d: %s | moving toward last verified location; waiting for actual NPC/prop")
                :format(stage,#stages,objective))
        else
            Hub.QuestFns.clearQuestMovement()
            Hub.QuestFns.questStatus("Objective not loaded",("Stage %d/%d: %s | no visible quest NPC/marker or known coordinates")
                :format(stage,#stages,objective))
        end
        return
    end
    local distance=(spot.Position-myRoot.Position).Magnitude
    if not Hub.QuestFns.questWithinReach(spot.Position,myRoot,5.5,spot.Object) then
        if info.uiCategory=="Explorative" and distance>70 then
            Hub.QuestFns.requestQuestStreaming(spot.Position,"stage: "..objective)
            local landed,why=questTeleportNear(spot.Position,id..":"..stage..":stream:objective")
            if landed then
                Hub.QuestFns.questStatus("Teleport to objective",
                    ("Stage %d/%d: %s | arriving at %s"):format(stage,#stages,objective,spot.Label))
                return
            elseif why=="Teleport settling" then
                return
            end
        end
        Hub.QuestFns.setQuestMovement(spot.Position,id..":"..stage..":"..spot.Label,4.4)
        Hub.QuestFns.questStatus("Travel",("Stage %d/%d: %s | approaching %s")
            :format(stage,#stages,objective,spot.Label))
        return
    end
    Hub.QuestFns.clearQuestMovement()
    if not spot.Prompt and spot.Object then
        spot.Prompt=Hub.QuestFns.questPrompt(spot.Object,id,spot.Position)
    end
    if not Hub.QuestFns.questTryPrompt(spot,id,stage,now) then
        if not spot.Prompt then
            Hub.QuestFns.questStatus("Interaction needed",("Stage %d/%d: %s | arrived at %s, but no actionable prompt is exposed")
                :format(stage,#stages,objective,spot.Label))
        end
    end

end
