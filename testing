-- Returns true only for a visible results screen with its expected buttons.
-- Result visibility is used for completion count; no guess based on Titan count.
local function isGuiVisibleThroughParents(object, container)
    local current = object
    while current and current ~= container do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("CanvasGroup") and current.GroupTransparency >= 0.95 then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return current == container
end

local function isResultsVisible()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false, false end
    for _, node in ipairs(playerGui:GetDescendants()) do
        if node.Name == "Rewards" and node:IsA("GuiObject") then
            local buttons = node:FindFirstChild("Buttons", true)
            local leave = buttons and buttons:FindFirstChild("Leave_2")
            local retry = buttons and buttons:FindFirstChild("Retry")
            if leave and isGuiVisibleThroughParents(leave, playerGui) then
                return true, retry ~= nil and isGuiVisibleThroughParents(retry, playerGui)
            end
        end
    end
    return false, false
end

-- Use the same return-to-Town-Central action as the game's own Rewards/Leave button.
-- The Outskirts client calls Host:Send("Functions", "Teleport"), which sends
-- POST:FireServer("Functions", "Teleport"). Never disconnect the player here.
-- Native Results/Leave request. A sent request is not a confirmed teleport.
local function stopAndLeaveGame(reason)
    if Farm.unloaded or not Farm.autoLeave then return false end
    if game.PlaceId == LOBBY_PLACE_ID then
        Farm.autoLeave = false
        Farm.session.autoLeave = false
        Farm.returningToLobby = false
        saveSession()
        return true
    end
    local now = os.clock()
    if Farm.returningToLobby then return true end
    -- Backoff even if server silently ignores the exit. Never flood a remote.
    local interval = math.min(90, math.max(15, (Farm.leaveAttempts or 0) * 15))
    if now - (Farm.leaveLastAttemptAt or -100) < interval then
        Farm.leaveStatus = "Exit unconfirmed; next attempt after cooldown"
        return true
    end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local post = remotes and remotes:FindFirstChild("POST")
    if not post or not post:IsA("RemoteEvent") then
        Farm.leaveStatus = "Waiting for official lobby teleport remote"
        return true
    end
    Farm.leaveLastAttemptAt = now
    Farm.leaveAttempts = (Farm.leaveAttempts or 0) + 1
    Farm.returningToLobby = true
    Farm.returningToLobbyAt = now
    local ok = pcall(function() post:FireServer("Functions", "Teleport") end)
    if not ok then
        Farm.returningToLobby = false
        Farm.leaveStatus = "Lobby teleport request failed; will retry"
        return true
    end
    -- Leave remains ON until the destination place is actually reached.
    Farm.leaveStatus = "Lobby teleport requested (attempt " .. Farm.leaveAttempts .. "); awaiting transfer"
    return true
end

local function checkAutoLeave()
    if not Farm.autoLeave then return false end
    if Farm.autoLeaveMode == "After X Matches" then
        if completedSinceLeaveEnabled() >= Farm.autoLeaveValue then
            return stopAndLeaveGame(tostring(Farm.autoLeaveValue) .. " matches completed")
        end
    elseif sessionElapsedMinutes() >= Farm.autoLeaveValue then
        return stopAndLeaveGame(tostring(Farm.autoLeaveValue) .. " minutes elapsed")
    end
    return false
end

-- One request in flight at a time; an accepted Retry/Add only enters the
-- retry vote. If the results remain open after a bounded wait, recheck it.
-- We do not force a character reset or start duplicate game controllers.
local function tryAutoRetry()
    if Farm.returningToLobby or not Farm.autoRetry or Farm.unloaded then return end
    local now = os.clock()
    if Farm.retryThisReward then
        if now - (Farm.retryAcceptedAt or now) < 30 then
            Farm.retryStatus = "Retry vote accepted; waiting for next match"
            return
        end
        Farm.retryThisReward = false
        Farm.session.retryLatched = false
        Farm.session.retryAcceptedEpoch = 0
        Farm.retryStatus = "Retry accepted, but results did not close; checking again"
        saveSession()
    end
    if Farm.retryPending then
        if now - (Farm.retryInFlightSince or now) <= 15 then return end
        -- The previous InvokeServer did not respond. Invalidate its late result.
        Farm.retryRequestSerial = Farm.retryRequestSerial + 1
        Farm.retryPending = false
        Farm.retryStatus = "Retry request timed out; will back off"
    end
    local attempts = Farm.retryAttempts or 0
    local gap = attempts == 0 and 1 or math.min(90, 7 * (2 ^ math.min(attempts - 1, 4)))
    if now - (Farm.retryLastAttempt or -100) < gap then return end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local get = remotes and remotes:FindFirstChild("GET")
    if not get or not get:IsA("RemoteFunction") then
        Farm.retryStatus = "Waiting for retry remote"
        return
    end
    Farm.retryLastAttempt = now
    Farm.retryAttempts = attempts + 1
    Farm.retryPending = true
    Farm.retryInFlightSince = now
    Farm.retryRequestSerial = Farm.retryRequestSerial + 1
    local serial = Farm.retryRequestSerial
    Farm.retryStatus = "Requesting retry (attempt " .. Farm.retryAttempts .. ")"
    task.spawn(function()
        local ok, response = pcall(function()
            return get:InvokeServer("Functions", "Retry", "Add")
        end)
        if Farm.unloaded or serial ~= Farm.retryRequestSerial then return end
        Farm.retryPending = false
        if not Farm.autoRetry then return end
        if ok and response == true then
            Farm.retryThisReward = true
            Farm.retryAcceptedAt = os.clock()
            Farm.session.retryLatched = true
            Farm.session.retryAcceptedEpoch = os.time()
            Farm.retryStatus = "Retry vote accepted; checking for match transition"
            saveSession()
        else
            Farm.retryStatus = ok and ("Retry not accepted: " .. tostring(response))
                or "Retry request failed; awaiting cooldown"
        end
    end)
end

