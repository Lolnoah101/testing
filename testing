local function handleResultScreen()
    local visible, canRetry = isResultsVisible()
    local job = tostring(game.JobId)
    if visible then
        Farm.resultsMissingSince = nil
        Farm.timerSawResults = true
        Farm.timerResultsClosedAt = nil
    else
        Farm.resultsMissingSince = Farm.resultsMissingSince or os.clock()
        -- Do not relatch new results after a one-frame UI flicker or while
        -- moving through the separate raid chest animation.
        if Farm.session.rewardLatched and Farm.session.lastRewardJob == job
            and os.clock() - Farm.resultsMissingSince >= 2.0
            and #getLivingTitans() > 0 then
            Farm.session.rewardLatched = false
            Farm.session.retryLatched = false
            Farm.session.retryAcceptedEpoch = 0
            Farm.retryThisReward = false
            Farm.retryPending = false
            Farm.retryRequestSerial = Farm.retryRequestSerial + 1
            Farm.retryAttempts = 0
            Farm.retryAcceptedAt = nil
            Farm.retryStatus = "New round detected"
            if type(Farm.resetRaidChestForNewMatch) == "function" then
                pcall(Farm.resetRaidChestForNewMatch)
            end
            saveSession()
        end
        if Farm.timerSawResults then
            Farm.timerResultsClosedAt = Farm.timerResultsClosedAt or os.clock()
            if os.clock() - Farm.timerResultsClosedAt >= 1.5
                and #getLivingTitans() > 0 then
                Farm.timerSawResults = false
                Farm.timerResultsClosedAt = nil
                Farm.matchStartedLocal = os.clock()
                Farm.matchClockManual = false
                Farm.matchActiveSince = nil
                Farm.matchClockLastProbeAt = 0
                Farm.matchLastElapsed = 0
                Farm.matchServerSecondsLast = nil
                Farm.matchServerAnchorValue = nil
                Farm.matchServerAnchorAt = nil
                Farm.matchServerLastAdvanceAt = nil
                Farm.matchServerActive = false
                Farm.lastTitanReserved = nil
                releaseLastTitanWaitFreeze()
            end
        end
        Farm.rewardVisibleLast = false
        return
    end
    if not Farm.session.rewardLatched or Farm.session.lastRewardJob ~= job then
        Farm.session.matches = Farm.session.matches + 1
        Farm.session.rewardLatched = true
        Farm.session.lastRewardJob = job
        Farm.session.retryLatched = false
        Farm.session.retryAcceptedEpoch = 0
        Farm.retryThisReward = false
        Farm.retryPending = false
        Farm.retryRequestSerial = Farm.retryRequestSerial + 1
        Farm.retryAttempts = 0
        Farm.retryAcceptedAt = nil
        Farm.retryLastAttempt = -100
        Farm.retryStatus = "Results detected; collecting rewards"
        saveSession()
        if game.PlaceId ~= 14012874501 and type(Farm.onMatchComplete) == "function" then
            Farm.onMatchComplete(job .. ":" .. tostring(Farm.session.matches))
        end
    end
    Farm.rewardVisibleLast = true
    -- Reward collection and Discord have independent bounded windows.
    if Farm.Webhook and (
        (Farm.Webhook.collecting and os.clock() - (Farm.Webhook.collectingSince or 0) < 8)
        or (Farm.Webhook.sending and os.clock() - (Farm.Webhook.sendingSince or 0) < 9)) then
        return
    end
    -- Raid chest processing is allowed to defer retry only for a bounded time.
    if type(Farm.tryRaidChest) == "function" and Farm.tryRaidChest(true) then return end
    if checkAutoLeave() then return end
    if canRetry then
        tryAutoRetry()
    elseif Farm.autoRetry then
        Farm.retryStatus = "Results shown, but retry button is unavailable"
    end
end

-- Public client request path. Mirrors the lobby Host:Invoke implementation,
-- which calls GET:InvokeServer. Fallback is only used with an explicit choice:
-- Hardest requires live player upgrade information and must not be guessed.
local function fallbackDirectLobbyJoin(settings)
    if settings.difficulty == "Hardest" then
        return false, "Hardest requires the live lobby Actor's upgrade data"
    end
    if not table.find(difficultyOptionsForMode(), settings.difficulty) then
        return false, "Difficulty does not belong to this mode"
    end
    if not table.find(MAPS_FOR_MODE[settings.mode] or {}, settings.map)
        or not table.find((LOBBY_OBJECTIVES[settings.mode] or {})[settings.map] or {}, settings.objective) then
        return false, "Invalid map or objective"
    end
    local assets=ReplicatedStorage:FindFirstChild("Assets")
    local remotes=assets and assets:FindFirstChild("Remotes")
    local remote=remotes and remotes:FindFirstChild("GET")
    if not remote or not remote:IsA("RemoteFunction") then
        return false,"Lobby GET remote unavailable"
    end
    local minimum=(settings.mode=="Raids" and settings.objective=="Colossal Titan") and 3 or nil
    local payload={Name=settings.map,Type=settings.mode,Objective=settings.objective,
        Difficulty=settings.difficulty,Minimum=minimum}
    local ok,party=pcall(function() return remote:InvokeServer("S_Missions","Create",payload) end)
    if not ok or typeof(party)~="Instance" then
        return false,"Create returned "..(ok and typeof(party) or "error")
            .." | "..tostring(party).." | difficulty="..tostring(settings.difficulty)
            .." | modifiers not yet applied; check existing party, eligibility and lobby state"
    end
    local leader=party:FindFirstChild("Leader")
    if leader and leader.Value~=LocalPlayer.Name then
        return false,"Party is not owned by the local player"
    end
    local selected=modifierNamesForDifficulty(settings.modifier,settings.mode,settings.objective,settings.difficulty)
    local function enabled(name)
        local value=party:GetAttribute("Modifiers")
        return type(value)=="string" and value:find(name,1,true)~=nil
    end
    local function waitEnabled(name,seconds)
        local deadline=os.clock()+seconds
        repeat
            if not party.Parent then return false end
            if enabled(name) then return true end
            task.wait(0.06)
        until os.clock()>=deadline
        return enabled(name)
    end
    local lastRequestAt=-math.huge
    local function failModifier(message)
        if party.Parent and (not leader or leader.Value==LocalPlayer.Name) then
            task.wait(0.4)
            pcall(function() remote:InvokeServer("S_Missions","Leave") end)
        end
        return false,message.." | Partial party left; try Auto Join again."
    end
    for index,modifier in ipairs(selected) do
        local lastResponse="none"
        for attempt=1,3 do
            if enabled(modifier) then break end
            local remaining=0.45-(os.clock()-lastRequestAt)
            if remaining>0 then task.wait(remaining) end
            if enabled(modifier) then break end
            local okModify,result=pcall(function()
                return remote:InvokeServer("S_Missions","Modify",modifier)
            end)
            lastRequestAt=os.clock()
            lastResponse=okModify and tostring(result) or "error: "..tostring(result)
            if waitEnabled(modifier,attempt==1 and 4 or 7) then break end
            if attempt<3 then task.wait(attempt==1 and 2.5 or 4) end
        end
        if not enabled(modifier) then
            return failModifier(string.format(
                "Modifier %d/%d still OFF: %s after 3 spaced attempts | final Modify response=%s | party has [%s]",
                index,#selected,modifier,tostring(lastResponse),
                tostring(party:GetAttribute("Modifiers") or "")))
        end
        do end
    end
    for _,modifier in ipairs(selected) do
        if not enabled(modifier) then
            return failModifier("Missing before Start: "..modifier
                .." | party has ["..tostring(party:GetAttribute("Modifiers") or "").."]")
        end
    end
    local started,response=pcall(function()
        return remote:InvokeServer("S_Missions","Start")
    end)
    if not started or response==false then return false,"Start request error: "..tostring(response) end
    return true,"Started via GET: "..settings.mode.." / "..settings.map.." / "..settings.difficulty
        .." | VERIFIED modifiers "..#selected.."/"..#selected..": "..table.concat(selected, ", ")
end

-- This game permits more than eight manually chosen modifiers.
-- The automatic sequence verifies each party attribute before Start.
local function preflightModifierSelection()
    local chosen=modifierNamesForDifficulty(Farm.lobbyModifier,
        Farm.lobbyMode,Farm.lobbyObjective,Farm.lobbyDifficulty)
    if Farm.lobbyMode~="Waves"
        and (Farm.lobbyDifficulty=="Freedom" or Farm.lobbyDifficulty=="Hardest") then
        for _,name in ipairs(FREEDOM_REQUIRED) do
            if modifierAllowed(name,Farm.lobbyMode,Farm.lobbyObjective,"Freedom")
                and not table.find(chosen,name) then
                chosen[#chosen+1]=name
            end
        end
    end
    return true, string.format("Applying and verifying %d selected modifiers (fast, state-verified requests)",#chosen)
end

local function requestLobbyJoin()
    if Farm.lobbyJoining or Farm.unloaded or not Farm.lobbyAutoJoin then return false end
    if game.PlaceId ~= LOBBY_PLACE_ID then
        Farm.lobbyCurrentStatus = "Waiting for Town Central lobby"
        return false
    end
    local preflightOK,preflightMessage=preflightModifierSelection()
    if not preflightOK then
        Farm.lobbyCurrentStatus=preflightMessage
        do end
        return false
    end
    do end
    Farm.lobbyJoining = true
    Farm.lobbyJoinStartedAt = os.clock()
    Farm.lobbyJoinAttemptCount = (Farm.lobbyJoinAttemptCount or 0) + 1
    Farm.lobbyJoinRunId = (Farm.lobbyJoinRunId or 0) + 1
    local joinId = Farm.lobbyJoinRunId
    -- A failed creation always gets a scheduled, rate-limited retry.
    task.spawn(function()
        local settings={mode=Farm.lobbyMode,map=Farm.lobbyMap,
            objective=Farm.lobbyObjective,modifier=Farm.lobbyModifier,
            difficulty=Farm.lobbyDifficulty}
        local bridge,reason=getLobbyBridge()
        if not Farm.lobbyAutoJoin or Farm.unloaded or joinId ~= Farm.lobbyJoinRunId then
            if joinId == Farm.lobbyJoinRunId then Farm.lobbyJoining=false end
            return
        end
        Farm.lobbyCurrentStatus="Creating "..settings.mode.." / "..settings.map
        local success,detail
        if bridge then
            local ok,result,message=pcall(function() return bridge:Invoke("join",settings) end)
            success=ok and result==true
            detail=ok and message or tostring(result)
            -- Actor-local progression data can be unavailable before loading.
            -- An explicit valid difficulty can use the same GET request directly.
            if not success and settings.difficulty~="Hardest"
                and (tostring(detail):find("Actor Host",1,true)
                or tostring(detail):find("slot data",1,true)
                or tostring(detail):find("upgrade data",1,true)) then
                success,detail=fallbackDirectLobbyJoin(settings)
            end
        else
            success,detail=fallbackDirectLobbyJoin(settings)
            if not success then detail=tostring(reason).." / "..tostring(detail) end
        end
        if Farm.unloaded or joinId ~= Farm.lobbyJoinRunId then return end
        Farm.lobbyJoining=false
        Farm.lobbyJoinStartedAt=nil
        Farm.lobbyCurrentStatus=tostring(detail)
        if success then
            -- A successful Start response is not proof that the teleport happened.
            Farm.lobbyJoinAwaitingAt=os.clock()
            Farm.lobbyCurrentStatus="Match start accepted; waiting for teleport"
        elseif Farm.lobbyAutoJoin and game.PlaceId==LOBBY_PLACE_ID then
            local gap=math.min(180, 8*(2^math.min((Farm.lobbyJoinAttemptCount or 1)-1,5)))
            Farm.lobbyJoinAttempted=false
            Farm.lobbyJoinDue=os.clock()+gap
            Farm.lobbyCurrentStatus="Join failed: "..tostring(detail).." | retry in "..gap.."s"
        end
    end)
    return true
end

local function scheduleLobbyJoin()
    Farm.lobbyJoinDue = nil
    Farm.lobbyJoinAwaitingAt = nil
    Farm.lobbyJoinAttemptCount = 0
    if not Farm.lobbyJoining then Farm.lobbyJoinAttempted = false end
    Farm.lobbyJoinWarned = false
    if Farm.lobbyAutoJoin and game.PlaceId == LOBBY_PLACE_ID then
        Farm.lobbyJoinDue = os.clock() + Farm.lobbyDelay
        Farm.lobbyCurrentStatus = "Join in " .. tostring(Farm.lobbyDelay) .. "s"
    elseif game.PlaceId ~= LOBBY_PLACE_ID then
        Farm.lobbyCurrentStatus = "Waiting for lobby place " .. tostring(LOBBY_PLACE_ID)
    end
end

local function sessionHeartbeat(dt)
    Farm.sessionMonitorElapsed = Farm.sessionMonitorElapsed + dt
    if Farm.sessionMonitorElapsed < 0.5 then return end
    Farm.sessionMonitorElapsed = 0
    if Farm.unloaded then return end
    local now=os.clock()
    -- A missing/failed server teleport must not permanently disable results monitoring.
    if Farm.returningToLobby and now - (Farm.returningToLobbyAt or now) >= 25 then
        Farm.returningToLobby = false
        Farm.leaveStatus = "Lobby transfer not confirmed; will retry exit after cooldown"
    end
    if not Farm.returningToLobby then
        handleResultScreen()
        -- Raid chest popups may be separate from the normal Rewards panel.
        -- Use the same throttled session Heartbeat; do not poll every frame.
        if type(Farm.tryRaidChest) == "function" and not Farm.rewardVisibleLast then
            Farm.tryRaidChest(false)
        end
        checkAutoLeave()
    end
    if Farm.lobbyAutoJoin then
        if game.PlaceId == LOBBY_PLACE_ID then
            if Farm.lobbyJoining and Farm.lobbyJoinStartedAt
                and now - Farm.lobbyJoinStartedAt >= 80 then
                -- Discard a stalled controller response. Spaced retry is safer
                -- than leaving Auto Join permanently latched for hours.
                Farm.lobbyJoinRunId = Farm.lobbyJoinRunId + 1
                Farm.lobbyJoining = false
                Farm.lobbyJoinStartedAt = nil
                Farm.lobbyJoinAttempted = false
                Farm.lobbyJoinDue = now + 45
                Farm.lobbyCurrentStatus = "Join controller timed out; retry in 45s"
            end
            if Farm.lobbyJoinAwaitingAt and now - Farm.lobbyJoinAwaitingAt >= 60 then
                Farm.lobbyJoinAwaitingAt=nil
                Farm.lobbyJoinAttempted=false
                Farm.lobbyJoinDue=now+40
                Farm.lobbyCurrentStatus="No teleport after Start; rechecking party in 40s"
            end
            if Farm.lobbyJoinDue == nil and not Farm.lobbyJoinAttempted
                and not Farm.lobbyJoining and not Farm.lobbyJoinAwaitingAt then
                scheduleLobbyJoin()
            end
            if Farm.lobbyJoinDue and now >= Farm.lobbyJoinDue and not Farm.lobbyJoining then
                Farm.lobbyJoinDue = nil
                Farm.lobbyJoinAttempted = true
                requestLobbyJoin()
            end
        else
            Farm.lobbyCurrentStatus = "Awaiting lobby place"
        end
    else
        Farm.lobbyCurrentStatus = "Auto Join Off"
    end
    if Farm.RaidChest and Farm.RaidChest.statusText then
        pcall(function() Farm.RaidChest.statusText:Set(Farm.RaidChest.lastStatus) end)
    end
    if Farm.sessionText then
        local goal = Farm.autoLeaveMode == "After X Matches"
            and string.format("%d/%d matches", completedSinceLeaveEnabled(), Farm.autoLeaveValue)
            or string.format("%.1f/%d minutes", sessionElapsedMinutes(), Farm.autoLeaveValue)
        pcall(function()
            Farm.sessionText:Set(string.format("Total %d | Leave: %s | Retry: %s%s",
                Farm.session.matches,
                Farm.autoLeave and (Farm.leaveStatus or goal) or "Off",
                Farm.autoRetry and (Farm.retryStatus or "On") or "Off",
                Farm.retryAttempts > 0 and (" | Attempts: " .. Farm.retryAttempts) or ""))
        end)
    end
    if Farm.lobbyText then
        pcall(function()
            Farm.lobbyText:Set(string.format("%s / %s / %s / %s / %s | %s",
                Farm.lobbyMode, Farm.lobbyMap, Farm.lobbyObjective,
                modifierSummary(Farm.lobbyModifier), Farm.lobbyDifficulty, Farm.lobbyCurrentStatus))
        end)
    end
end

function Farm:Unload()
    if self.unloaded then return end
    if type(self.settingsCommit) == "function" then pcall(self.settingsCommit, "unload") end
    self.opMethod = false
    self.opRunId = self.opRunId + 1
    self.antiAfk = false
    self.autoReconnect = false
    self.autoExecute = false
    if self.idleConnection then self.idleConnection:Disconnect(); self.idleConnection=nil end
    if self.reconnectConnection then self.reconnectConnection:Disconnect(); self.reconnectConnection=nil end
    if self.reconnectPromptConnection then self.reconnectPromptConnection:Disconnect(); self.reconnectPromptConnection=nil end
    if self.cinematicConnection then
        self.cinematicConnection:Disconnect()
        self.cinematicConnection=nil
    end
    if self.Equipment then
        local e=self.Equipment
        e.autoEquip=false;e.autoUpgrade=false;e.autoSkills=false;e.autoPerk=false;e.autoArtifact=false
        if e.watcher then e.watcher:Disconnect();e.watcher=nil end
    end
    if self.RaidChest then
        self.RaidChest.autoOpen = false
    end
    if self.MenuFamily then
        self.MenuFamily.enabled=false
        if self.MenuFamily.connection then self.MenuFamily.connection:Disconnect();self.MenuFamily.connection=nil end
    end
    if self.Waves then
        if self.Waves.connection then
            self.Waves.connection:Disconnect()
            self.Waves.connection=nil
        end
        if self.Waves.teleportFailureConnection then
            self.Waves.teleportFailureConnection:Disconnect()
            self.Waves.teleportFailureConnection=nil
        end
    end
    self:Stop()
    self:StopAura()
    self.lobbyAutoJoin = false
    if self.sessionMonitor then
        self.sessionMonitor:Disconnect()
        self.sessionMonitor = nil
    end
    saveSession()
    self.utilityAutoReload = false
    self.utilityAutoRefill = false
    self.bladeRecoveryActive = false
    self.lastTitanEnabled = false
    self.lastTitanReserved = nil
    if self.timerStatusConnection then
        self.timerStatusConnection:Disconnect()
        self.timerStatusConnection = nil
    end
    self.utilityToken = self.utilityToken + 1
    if self.utilityConnection then
        self.utilityConnection:Disconnect()
        self.utilityConnection = nil
    end
    self.unloaded = true
    if self.slashBridge and self.slashBridge.Parent then
        pcall(function() self.slashBridge:Destroy() end)
    end
    self.slashBridge = nil
    self.slashActor = nil
    if self.window then
        pcall(function() self.window:Unload() end)
    end
    if ENV.HollowMoonAOTOutskirts == self then
        ENV.HollowMoonAOTOutskirts = nil
    end
end

