            pcall(Chunk)


        if not RunSuccess then
            return nil,
                "runtime error: "
                .. tostring(LibraryOrError)
        end


        if type(LibraryOrError) ~= "table"
            or type(LibraryOrError.CreateWindow) ~= "function"
        then
            return nil,
                "invalid return: "
                .. typeof(LibraryOrError)
        end


        if SaveCache
            and writefile
        then

            EnsureCacheFolder()

            pcall(function()
                writefile(
                    CachePath,
                    Source
                )
            end)
        end


        GENV.__AZ_RAYFIELD_GEN2 =
            LibraryOrError


        print(
            "[Anime Zero] Rayfield Gen2 loaded:",
            Label
        )


        return LibraryOrError,
            nil
    end


    local function TryCache()

        if not readfile then
            return nil,
                "readfile unavailable"
        end


        if isfile then

            local ExistsSuccess,
                Exists =
                pcall(function()
                    return isfile(
                        CachePath
                    )
                end)


            if ExistsSuccess
                and not Exists
            then
                return nil,
                    "cache missing"
            end
        end


        local ReadSuccess,
            CachedSource =
            pcall(function()
                return readfile(
                    CachePath
                )
            end)


        if not ReadSuccess then
            return nil,
                "cache read failed: "
                .. tostring(CachedSource)
        end


        local Library,
            CacheError =
            ValidateAndRun(
                CachedSource,
                "local cache",
                false
            )


        if Library then
            return Library,
                nil
        end


        return nil,
            "cache invalid: "
            .. tostring(CacheError)
    end


    local function TryExecutorRequest(
        Url
    )

        local RequestFunction =
            rawget(
                GENV,
                "request"
            )
            or rawget(
                GENV,
                "http_request"
            )


        local SynTable =
            rawget(
                GENV,
                "syn"
            )


        if not RequestFunction
            and type(SynTable) == "table"
        then
            RequestFunction =
                SynTable.request
        end


        local HttpTable =
            rawget(
                GENV,
                "http"
            )


        if not RequestFunction
            and type(HttpTable) == "table"
        then
            RequestFunction =
                HttpTable.request
        end


        if type(RequestFunction) ~= "function" then
            return nil,
                "executor request unavailable"
        end


        local RequestSuccess,
            Response =
            pcall(
                RequestFunction,
                {
                    Url = Url,
                    Method = "GET",
                    Headers = {
                        ["Cache-Control"] = "no-cache",
                    },
                }
            )


        if not RequestSuccess then
            return nil,
                "executor request error: "
                .. tostring(Response)
        end


        if type(Response) == "string"
            and #Response > 0
        then
            return Response,
                nil
        end


        if type(Response) == "table" then

            local Body =
                Response.Body
                or Response.body

            local Status =
                Response.StatusCode
                or Response.Status
                or Response.status_code


            if type(Body) == "string"
                and #Body > 0
                and (
                    Status == nil
                    or tonumber(Status) == nil
                    or (
                        tonumber(Status) >= 200
                        and tonumber(Status) < 400
                    )
                )
            then
                return Body,
                    nil
            end


            return nil,
                "executor HTTP status/body invalid: "
                .. tostring(Status)
        end


        return nil,
            "executor request returned "
            .. typeof(Response)
    end


    local CachedLibrary,
        CacheError =
        TryCache()


    if CachedLibrary then
        return CachedLibrary
    end


    LastError =
        tostring(CacheError)


    for Attempt = 1, 3 do

        for _, Url in ipairs(Sources) do

            local SourceOrError = nil
            local FetchLabel = nil


            local HttpSuccess,
                HttpResult =
                pcall(function()
                    return game:HttpGet(
                        Url
                    )
                end)


            if HttpSuccess
                and type(HttpResult) == "string"
                and #HttpResult > 0
            then

                SourceOrError =
                    HttpResult

                FetchLabel =
                    "game:HttpGet"

            else

                local RequestSource,
                    RequestError =
                    TryExecutorRequest(
                        Url
                    )


                if RequestSource then

                    SourceOrError =
                        RequestSource

                    FetchLabel =
                        "executor request"

                else

                    LastError =
                        "game:HttpGet="
                        .. tostring(HttpResult)
                        .. " | request="
                        .. tostring(RequestError)
                end
            end


            if SourceOrError then

                local Library,
                    RunError =
                    ValidateAndRun(
                        SourceOrError,
                        Url
                        .. " via "
                        .. tostring(FetchLabel)
                        .. " attempt "
                        .. tostring(Attempt),
                        true
                    )


                if Library then
                    return Library
                end


                LastError =
                    tostring(RunError)
            end


            task.wait(0.25)
        end


        -- Another script/previous place may have finished writing the cache
        -- while this run was retrying.  Re-check it before the next network pass.
        local RetryCachedLibrary,
            RetryCacheError =
            TryCache()


        if RetryCachedLibrary then
            return RetryCachedLibrary
        end


        if RetryCacheError then
            LastError =
                LastError
                .. " | cache="
                .. tostring(RetryCacheError)
        end


        task.wait(0.50)
    end


    error(
        "[Anime Zero] Unable to load Rayfield Gen2. "
        .. "No valid local cache and all HTTP methods failed. "
        .. tostring(LastError),
        0
    )
end)()


