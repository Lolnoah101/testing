local function getCurrentIslandId()
    if not IslandRegionController
        or not IslandRegionController.GetCurrentIslandId then
        return ""
    end

    local ok, islandId = pcall(function()
        return IslandRegionController:GetCurrentIslandId()
    end)

    if ok and type(islandId) == "string" then
        return islandId
    end

    return ""
end

function Systems.isAtIsland(islandId)
    if getCurrentIslandId() == islandId then
        return true
    end

    local root = getCharacterRoot()
    local target = Systems.IslandTeleportCFrames[islandId]

    if not root or not target then
        return false
    end

    return (root.Position - target.Position).Magnitude
        <= math.max(
            40,
            tonumber(Config.TravelArrivalRadius) or 140
        )
end

function Systems.isIslandAvailable(data, islandId)
    local meta = IslandConfig[islandId]

    if not meta then
        return false
    end

    if meta.defaultUnlocked == true then
        return true
    end

    return type(data) == "table"
        and type(data.UnlockedIslands) == "table"
        and data.UnlockedIslands[islandId] == true
end

function Systems.getHighestUnlockedIsland(data)
    local best = nil

    for _, island in ipairs(Systems.IslandDefinitions) do
        if Systems.isIslandAvailable(data, island.id) then
            if not best or island.order > best.order then
                best = island
            end
        end
    end

    return best and best.id or nil
end

function Systems.isTravelSafe()
    if State.TravelBusy
        or State.AutoSellBusy
        or State.RodBusy
        or State.QuestBusy then
        return false
    end

    if not Config.Enabled then
        return true
    end

    if Config.Mode == "OP" then
        return State.Phase == "Idle"
    end

    local currentState = getFishingState()
    return currentState == nil or currentState == FState.Idling
end

function Systems.waitForTravelSafe(timeoutSeconds)
    local deadline = os.clock() + (timeoutSeconds or 8)

    while State.Alive and os.clock() < deadline do
        if Systems.isTravelSafe() then
            return true
        end

        task.wait(0.10)
    end

    return Systems.isTravelSafe()
end

function Systems.travelToIsland(islandId)
    if State.TravelBusy then
        return false
    end

    if type(islandId) ~= "string"
        or not IslandConfig[islandId] then
        State.TravelLastStatus = "Invalid island"
        return false
    end

    local data = getPlayerData()

    if not Systems.isIslandAvailable(data, islandId) then
        State.TravelLastStatus =
            "Locked: "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )
        return false
    end

    local destination =
        Systems.IslandTeleportCFrames[islandId]

    if not destination then
        State.TravelLastStatus =
            "No travel point for island"
        return false
    end

    if Systems.isAtIsland(islandId) then
        State.TravelLastIsland = islandId
        State.TravelLastStatus =
            "Already on "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )
        return true
    end

    State.TravelLastStatus =
        "Waiting for fishing to become idle"

    if not Systems.waitForTravelSafe(10) then
        State.TravelLastStatus =
            "Tween cancelled: fishing stayed busy"
        return false
    end

    local root = getCharacterRoot()

    if not root then
        State.TravelLastStatus =
            "Character unavailable"
        return false
    end

    State.TravelBusy = true
    State.TravelAttempts += 1

    mouseUp()

    -- waitForTravelSafe already guarantees an idle fishing state.
    -- Avoid an unnecessary FishCancel here; it can leave the client
    -- loadout lock out of sync after movement.
    State.RodRecoveryHoldUntil =
        os.clock() + 0.50

    if Config.Mode == "OP" then
        resetOPSession(0.20)
    else
        State.LegitResumeAt = os.clock() + 0.30
    end

    local targetCFrame =
        destination * CFrame.new(0, 3, 0)

    local speed =
        math.clamp(
            tonumber(Config.TravelTweenSpeed) or 70,
            10,
            70
        )

    State.TravelLastStatus =
        "Tweening to "
        .. tostring(
            Systems.IslandIdToName[islandId]
            or islandId
        )
        .. " at "
        .. tostring(speed)
        .. " studs/s"

    local moved, moveError =
        tweenCharacterTo(
            targetCFrame,
            speed
        )

    if not moved then
        State.TravelBusy = false
        State.TravelLastStatus =
            "Tween failed: "
            .. tostring(moveError or "cancelled")
        return false
    end

    -- Allow the island-region state to settle after Tween completion.
    task.wait(0.35)

    if not Systems.isAtIsland(islandId) then
        State.TravelBusy = false
        State.TravelLastStatus =
            "Tween finished but position was corrected"
        return false
    end

    local refreshedRoot = getCharacterRoot()

    if refreshedRoot then
        refreshedRoot.AssemblyLinearVelocity =
            Vector3.zero
        refreshedRoot.AssemblyAngularVelocity =
            Vector3.zero
    end

    -- Rebuild fishing state at the new island.
    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0
    State.LastRodWatchCheck = 0
    State.RodRecoveryHoldUntil =
        os.clock() + 0.50

    if Config.Mode == "OP" then
        resetOPSession(0.15)
    else
        State.LegitResumeAt = os.clock() + 0.18
        State.CurrentFishingState =
            getFishingState()
        State.StateEnteredAt = os.clock()
    end

    State.TravelSuccesses += 1
    State.TravelLastIsland = islandId
    State.TravelLastStatus =
        "Arrived: "
        .. tostring(
            Systems.IslandIdToName[islandId]
            or islandId
        )

    State.TravelBusy = false
    return true
end

function Systems.travelToHighestUnlockedIsland()
    local data = getPlayerData()
    local islandId = Systems.getHighestUnlockedIsland(data)

    if not islandId then
        State.TravelLastStatus = "No unlocked island found"
        return false
    end

    Config.SelectedIslandId = islandId
    return Systems.travelToIsland(islandId)
end

function Systems.stepTravelAutomation()
    if Config.AutoProgression then
        return
    end

    -- Quest farming owns the destination while quest configuration is active.
    if Config.AutoQuestManager
        and Config.AutoQuestConfigure
        and State.QuestTargetIslandId then
        return
    end

    if not Config.AutoTravelSelectedIsland
        or State.TravelBusy
        or State.AutoSellBusy then
        return
    end

    local now = os.clock()

    if now - State.LastTravelAutomationCheck
        < math.max(
            0.50,
            tonumber(Config.TravelAutomationCheckInterval) or 1.5
        ) then
        return
    end

    State.LastTravelAutomationCheck = now

    local target = Config.SelectedIslandId

    if not target or target == "" then
        return
    end

    if Systems.isAtIsland(target) then
        return
    end

    if not Systems.isTravelSafe() then
        return
    end

    Systems.travelToIsland(target)
end

API.TravelToIsland = Systems.travelToIsland
API.TravelToHighestUnlockedIsland = Systems.travelToHighestUnlockedIsland

