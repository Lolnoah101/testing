        for Key, Selected in pairs(
            Value
        ) do

            if typeof(Key) == "number"
                and typeof(Selected) == "string"
            then

                local Id =
                    Mapping[Selected]

                if Id then
                    Result[Id] = true
                end


            elseif typeof(Key) == "string"
                and Selected == true
            then

                local Id =
                    Mapping[Key]

                if Id then
                    Result[Id] = true
                end
            end
        end


        return Result
