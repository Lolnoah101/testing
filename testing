                and not PendingSkillTree
                and os.clock() >= NextSkillTreeAt
                and SkillTreePackets
                and SkillTreePackets.purchaseCharacterSkill
            then
                local Purchase = GetNextSkillTreePurchase()

                -- Strict priority: if the next ATK/CRIT/DEF/SPD node
                -- exists but is not affordable yet, simply wait for tokens.
                if Purchase
                    and Purchase.tokens >= Purchase.cost
                then
                    local Id = NextRequestId(RequestIds, "Skill")

                    PendingSkillTree = {
                        requestId = Id,
                        character = Purchase.character,
                        branch = Purchase.branch,
                        tier = Purchase.tier,
                        sentAt = os.clock(),
                    }

                    local Fired = pcall(function()
