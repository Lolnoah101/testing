        local overlay = gui and gui:FindFirstChild("promptOverlay", true)
        if overlay then attachPromptWatcher(overlay) end
        hookRuntimeConnection(coreGui.DescendantAdded:Connect(function(node)
            if node.Name == "promptOverlay" then
                pcall(function() attachPromptWatcher(node) end)
            end
        end))
    end)
end

-- Mobile/client resume: re-check any visible prompt immediately after a gap.
task.spawn(function()
    local previous = os.clock()
    while running and idleRuntime.Active do
        task.wait(2)
        local now = os.clock()
        local elapsed = now - previous
        previous = now
        if idleRuntime.AutoReconnect and not idleRuntime.Busy then
            if idleRuntime.PromptOverlay then
                for _, child in ipairs(idleRuntime.PromptOverlay:GetChildren()) do
                    inspectPrompt(child)
                end
            end
            pcall(function()
                local message = GuiService:GetErrorMessage()
                if isConnectionReason(message) then startReconnect(message, false) end
            end)
            if elapsed >= 12 then
                setReconnectStatus("Resume detected | Rescanned connection prompts")
            end
        end
    end
end)

