--// ============================================================
--// RAYFIELD GEN2 LOADER
--// ============================================================

local function IsRayfieldLibrary(Value)
    return type(Value) == "table"
        and type(
            Value.CreateWindow
        ) == "function"
end


local function LoadRayfield()
    local Environment =
        type(getgenv) == "function"
        and getgenv()
        or _G

    local CachedLibrary =
        Environment
            .__HOLLOWMOON_RAYFIELD_GEN2

    if IsRayfieldLibrary(
        CachedLibrary
    ) then
        return CachedLibrary
    end

    local URLs = {
        "https://sirius.menu/gen2",
        "https://sirius.menu/gen2-preview",
    }

    local LastError =
        "Unknown Rayfield loader error"

    for _, URL in ipairs(
        URLs
    ) do
        for Attempt = 1, 6 do
            local Success,
                Source =
                pcall(function()
                    return game:HttpGet(
                        URL,
                        false
                    )
                end)

            if Success
                and type(Source) == "string"
                and Source ~= ""
            then
                local Chunk,
                    CompileError =
                    loadstring(
                        Source
                    )

                if Chunk then
                    local RunSuccess,
                        Library =
                        pcall(
                            Chunk
                        )

                    if RunSuccess
                        and IsRayfieldLibrary(
                            Library
                        )
                    then
                        Environment
                            .__HOLLOWMOON_RAYFIELD_GEN2 =
                                Library

                        return Library
                    end

                    LastError =
                        RunSuccess
                        and "Rayfield did not return CreateWindow"
                        or tostring(
                            Library
                        )
                else
                    LastError =
                        tostring(
                            CompileError
                        )
                end
            else
                LastError =
                    Success
                    and (
                        "Empty response from "
                        .. URL
                    )
                    or tostring(
                        Source
                    )
            end

            if Attempt < 6 then
                task.wait(
                    math.min(
                        Attempt * 0.5,
                        2
                    )
                )
            end
        end
    end

    error(
        "[HollowMoonHub] Rayfield failed: "
            .. tostring(
                LastError
            ),
        0
    )
end


local Rayfield =
    LoadRayfield()


