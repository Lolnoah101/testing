end
-- A boss can de-aggro/return to full health if the player drags combat
-- too far from the encounter area. The server's exact leash is unknown.
-- Use map points only when they agree with the currently observed boss.
function Hub:BossArenaCenter(record)
    if not record or not record.Model or not record.Root or not record.Root.Parent
        or not (BossSet[record.NPCName] or BossSet[record.Model.Name]
            or AllLibraryBosses[record.NPCName]
            or AllLibraryBosses[record.Model.Name]) then
        return nil
    end
    local center=self.BossArenaCenters[record.Model]
    if center then return center end
    center=record.Root.Position
    local saved=self:GetBossAreaPoint(record.NPCName)
    if typeof(saved)=="Vector3" and (center-saved).Magnitude<105 then
        center=saved
    end
    self.BossArenaCenters[record.Model]=center
    return center
end
function Hub:BoundBossDestination(record, from, desired)
    if typeof(desired)~="Vector3" or typeof(from)~="Vector3" then return desired end
    local center=self:BossArenaCenter(record)
    if not center then return desired end
    local delta=Vector3.new(desired.X-center.X,0,desired.Z-center.Z)
    if delta.Magnitude<=42 then return desired end
    local projected=Vector3.new(center.X,desired.Y,center.Z)+delta.Unit*42
    -- Never clamp a necessary escape *into* a warning. A damaging zone takes
    -- priority over the heuristic leash-radius estimate.
    if insideAnyTelegraph(projected) then return desired end
    if (projected-from).Magnitude>90 then return desired end
    return projected
end
function Hub:MonitorBossReset(record)
    local center=self:BossArenaCenter(record)
    if not center or not record.Hum or record.Hum.Health<=0 then return end
    local hp,maxHp=record.Hum.Health,record.Hum.MaxHealth
    if maxHp<=0 then return end
    local previous=self.BossLastHealth[record.Model]
    local label=tostring(record.NPCName or record.Model.Name)
    local past=self.BossHistory[label]
    local replaced=past and past.Model~=record.Model
        and os.clock()-past.At<18 and past.Health>0
        and past.Health<past.MaxHealth*0.78 and hp>=maxHp*0.93
    local healed=previous and previous<maxHp*0.79
        and hp>previous+maxHp*0.32 and hp>=maxHp*0.88
    if replaced or healed then
        self.BossResetSuspected+=1
        self.BossLastReset=label.." (HP restored/new instance; possible leash reset)"
        self.DodgeDestination=nil;self.DodgeHoldUntil=0
    end
    self.BossLastHealth[record.Model]=hp
    self.BossHistory[label]={Model=record.Model,Health=hp,MaxHealth=maxHp,
        At=os.clock()}
end

-- Video-specific defense: Crimson Flame's Fire Tornado moves with the boss.
-- A stationary warning or a one-time dodge point is insufficient. This uses
-- replicated animation/root motion only; the server's damage volume is unknown.
function Hub:FindRushAttack(playerRoot)
    local best, bestDistance = nil, math.huge
    for _, entry in pairs(self.Tracks) do
        local rec = entry.Record
        local move = tostring(entry.Meta and entry.Meta.Move or ""):lower()
        local npc = tostring(rec and rec.NPCName or ""):lower()
        local candidate=entry.Meta and entry.Meta.Rush
            or move:find("tornado",1,true) or move:find("lunging",1,true)
        if trackIsActive(entry) and candidate
            and os.clock()-(entry.Started or os.clock()) < 4.6
            and rec and rec.Root and rec.Root.Parent and rec.Hum
            and rec.Hum.Health > 0 then
            local p = rec.Root.Position
            -- Some NPC skills are moved with CFrame instead of physics
            -- velocity. Observe root displacement at modest intervals.
            local t = os.clock()
            local dt = t - (entry.RushSampleAt or t)
            if entry.RushLastPosition and dt >= 0.045 and dt < 0.5 then
                local v = (p-entry.RushLastPosition)/dt
                local flat = Vector3.new(v.X,0,v.Z)
                if flat.Magnitude < 160 then
                    entry.RushVelocity = entry.RushVelocity
                        and entry.RushVelocity:Lerp(flat,0.42) or flat
                    if self.LearnAttacks and flat.Magnitude > 7 then
                        local profile = entry.Learned or
                            self:AttackProfile(rec,entry.Track,true)
                        if profile then
                            profile.RushSpeed = profile.RushSpeed and
                                (profile.RushSpeed*0.85+flat.Magnitude*0.15)
                                or flat.Magnitude
                            profile.RushSamples = (profile.RushSamples or 0)+1
                        end
                    end
                end
                entry.RushSampleAt,entry.RushLastPosition=t,p
            elseif not entry.RushLastPosition or dt >= 0.5 then
                entry.RushSampleAt,entry.RushLastPosition=t,p
            end
            local d = Vector3.new(p.X - playerRoot.Position.X, 0,
                p.Z - playerRoot.Position.Z).Magnitude
            local focus=(self.AutoQuest and self.QuestCombatActive and self.QuestTarget)
                or (self.AutoFarm and self.FarmTarget)
            if d < 34 and d < bestDistance
                and (not focus or rec==focus or d<12) then
                best, bestDistance = entry, d
            end
        end
    end
    return best
end

-- Report estimated exposure to a traveling attack. A low/unknown root speed
-- must not be treated as safe: the windup can be stationary before the rush.
function Hub:RushExposure(entry, pos)
    if not entry or not entry.Record or not entry.Record.Root
        or not entry.Record.Root.Parent then return false, math.huge end
    local attacker = entry.Record.Root
    local center = attacker.Position
    local planar = Vector3.new(pos.X-center.X, 0, pos.Z-center.Z)
    local distance = planar.Magnitude
    local velocity = attacker.AssemblyLinearVelocity
    local speedVector = Vector3.new(velocity.X, 0, velocity.Z)
    local observed = entry.RushVelocity
    if observed and observed.Magnitude > speedVector.Magnitude + 4 then
        speedVector = observed
    end
    local face = Vector3.new(attacker.CFrame.LookVector.X, 0,
        attacker.CFrame.LookVector.Z)
    local toward = speedVector.Magnitude > 4 and speedVector.Unit
        or (face.Magnitude > 0.05 and face.Unit
            or (distance > 0.05 and planar.Unit or Vector3.zAxis))
    local profile = self.LearnAttacks and
        (entry.Learned or self:AttackProfile(entry.Record, entry.Track, false))
    local learnedSpeed = profile and (profile.RushSamples or 0) >= 3
        and (profile.RushSpeed or 0) or 0
    local lead = math.clamp(math.max(speedVector.Magnitude,
        learnedSpeed*0.6) * 0.38, 9, 28)
    local predicted = center + toward * lead
    local toFuture = Vector3.new(pos.X-predicted.X, 0, pos.Z-predicted.Z)
    local futureDistance = toFuture.Magnitude
    local facingPlayer = distance > 0.05 and toward:Dot(planar.Unit) > 0.35
    local moving = speedVector.Magnitude > 6
    -- A stationary windup directly under the avatar is still dangerous, but
    -- a boss 20+ studs away shouldn't trigger an endless chain of dodges just
    -- because a looping animation is tagged Rush. Actual warning geometry
    -- is checked separately, and always takes precedence.
    local exposed = distance < 12
        or (moving and (futureDistance < 19
            or (facingPlayer and distance < 33)))
    -- Distance is an avoidance estimate, not a claim about exact hitboxes.
    return exposed, math.min(distance, futureDistance)
end

function Hub:RushEscape(playerRoot, entry)
    if not entry or not entry.Record or not entry.Record.Root then return nil end
    local attacker = entry.Record.Root
    local from, center = playerRoot.Position, attacker.Position
    local velocity = attacker.AssemblyLinearVelocity
    local direction = Vector3.new(velocity.X, 0, velocity.Z)
    local observed = entry.RushVelocity
    if observed and observed.Magnitude > direction.Magnitude + 4 then
        direction = observed
    end
    if direction.Magnitude <= 4 then
        direction = Vector3.new(from.X-center.X, 0, from.Z-center.Z)
    end
    if direction.Magnitude <= 0.05 then
        direction = Vector3.new(attacker.CFrame.LookVector.X, 0,
            attacker.CFrame.LookVector.Z)
    end
    if direction.Magnitude <= 0.05 then direction = Vector3.zAxis end
    direction = direction.Unit
    local lateral = Vector3.new(-direction.Z, 0, direction.X)
    local away = Vector3.new(from.X-center.X, 0, from.Z-center.Z)
    away = away.Magnitude > 0.05 and away.Unit or -direction
    local candidates = {
        from + lateral*12 + away*3,
        from - lateral*12 + away*3,
        from + lateral*17,
        from - lateral*17,
        center + lateral*20 - direction*5,
        center - lateral*20 - direction*5,
    }
    local best, bestScore = nil, -math.huge
    for _, point in ipairs(candidates) do
        point = Vector3.new(point.X, from.Y, point.Z)
        point = self:BoundBossDestination(entry.Record,from,point)
        if not insideAnyTelegraph(point) then
            local _, clearance = self:RushExposure(entry, point)
            -- Prefer maximal space from both current and projected attacker
            -- positions; avoid changing sides based on tiny measurement noise.
            local range=(point-from).Magnitude
            -- A few extra studs of clearance are not worth fleeing the boss.
            local score = clearance - range*0.55
            if range>23 then score-=15 end
            if score > bestScore then best, bestScore=point,score end
        end
    end
    return best
end

local function evadeDestination(root, danger, threat)
    local from = root.Position
    local focus = (Hub.AutoQuest and Hub.QuestCombatActive and Hub.QuestTarget)
        or (Hub.AutoFarm and Hub.FarmTarget)
    if focus and not activeNpcRecord(focus) then focus=nil end
    local enemyRoot = (threat and threat.OtherRoot)
        or (focus and focus.Root)
    local anchor = focus or (threat and threat.Record)
    local center = danger and danger.Position or
        (enemyRoot and enemyRoot.Position) or (from - root.CFrame.LookVector * 8)
    local radial = Vector3.new(from.X - center.X, 0, from.Z - center.Z)
    local away = radial.Magnitude > 0.1 and radial.Unit
        or Vector3.new(root.CFrame.RightVector.X,0,root.CFrame.RightVector.Z).Unit
    local candidates = {}
    local function candidate(p, priority)
        if p then
            local goal=Hub:BoundBossDestination(anchor,from,
                Vector3.new(p.X,from.Y,p.Z))
            table.insert(candidates,{P=goal,Priority=priority or 0})
        end
    end
    if danger then
        if danger.Type == "Circle" then
            local radius = danger.Radius + DODGE_PADDING + 1.0
            candidate(center + away * math.max(radius, radial.Magnitude + 6), -2)
        else
            local localPos = danger.CFrame:PointToObjectSpace(from)
            local sx = localPos.X >= 0 and 1 or -1
            local sz = localPos.Z >= 0 and 1 or -1
            local cf = danger.CFrame
            -- For long skinny line attacks, the short-axis escape is much
            -- faster than trying to outrun the projectile lengthwise.
            local margin = DODGE_PADDING + 2
            if danger.HalfX < danger.HalfZ then
                candidate(cf:PointToWorldSpace(Vector3.new(
                    sx * (danger.HalfX + margin), localPos.Y, localPos.Z)), -3)
                candidate(cf:PointToWorldSpace(Vector3.new(
                    -sx * (danger.HalfX + margin), localPos.Y, localPos.Z)), 4)
                candidate(cf:PointToWorldSpace(Vector3.new(
                    localPos.X, localPos.Y, sz * (danger.HalfZ + margin))), 7)
            else
                candidate(cf:PointToWorldSpace(Vector3.new(
                    localPos.X, localPos.Y, sz * (danger.HalfZ + margin))), -3)
                candidate(cf:PointToWorldSpace(Vector3.new(
                    localPos.X, localPos.Y, -sz * (danger.HalfZ + margin))), 4)
                candidate(cf:PointToWorldSpace(Vector3.new(
                    sx * (danger.HalfX + margin), localPos.Y, localPos.Z)), 7)
            end
        end
    end
    if enemyRoot and enemyRoot.Parent then
        local move = tostring(threat and threat.Meta and threat.Meta.Move or ""):lower()
        if move:find("bolt orbit", 1, true) then
            -- 16-stud half-width + safety padding from the verified orbit hitbox.
            local outward = Vector3.new(from.X - enemyRoot.Position.X, 0,
                from.Z - enemyRoot.Position.Z)
            local dir = outward.Magnitude > 0.1 and outward.Unit or away
            candidate(enemyRoot.Position + dir * 23, -8)
        end
        local enemyForward = Vector3.new(enemyRoot.CFrame.LookVector.X, 0,
            enemyRoot.CFrame.LookVector.Z)
        if enemyForward.Magnitude > 0.05 then
            local forward = enemyForward.Unit
            local side = Vector3.new(-forward.Z, 0, forward.X)
            -- Behind the boss is preferred for directed frontal attacks;
            -- a lateral sidestep is often faster if already near the boss.
            candidate(enemyRoot.Position - forward * 13, -1)
            candidate(from + side * 14, 0)
            candidate(from - side * 14, 0)
            candidate(from - forward * 15, 2)
        end
    end
    -- Don't sample huge 95-stud jumps during boss fights: they can break
    -- aggression. Keep the emergency fallback when no escape fits.
    for _, radius in ipairs({7, 11, 16, 24, 30}) do
        for i = 0, 15 do
            local angle = i / 16 * math.pi * 2
            candidate(from + Vector3.new(math.cos(angle),0,math.sin(angle))*radius, 8)
        end
    end
    local best, bestScore = nil, math.huge
    for _, c in ipairs(candidates) do
        local aoeUnsafe = not danger and enemyRoot and threat and threat.Meta
            and threat.Meta.AOE and (Vector3.new(c.P.X-enemyRoot.Position.X,0,
                c.P.Z-enemyRoot.Position.Z)).Magnitude < 24
        if not aoeUnsafe and not Hub:V75NearbyWarning(c.P,2.5) then
            local dist = (c.P - from).Magnitude
            local score = dist + c.Priority
            if focus and focus.Root and focus.Root.Parent then
                local boss = focus.Root.Position
                local newGap = Vector3.new(c.P.X-boss.X,0,c.P.Z-boss.Z).Magnitude
                local oldGap = Vector3.new(from.X-boss.X,0,from.Z-boss.Z).Magnitude
                -- Prefer escaping sideways within combat range to abandoning
                -- a boss entirely. Safety still wins: only clear candidates
                -- are scored, and no hard leash is imposed on emergency moves.
                score += math.max(0,newGap-24)*2.4
                score += math.max(0,newGap-oldGap-3)*1.2
            end
            if danger and danger.Type == "Box" then
                -- A path must not cut through the line again after dodging.
                local midpoint = from:Lerp(c.P, 0.65)
                local inMiddle = telegraphOverlap(danger.Part, midpoint)
                if inMiddle then score += 18 end
            end
            if score < bestScore then best, bestScore = c.P, score end
        end
    end
    return best
end
local function stepAutoDodge(dt, char, root, hum, now, threat)
    Hub.DodgeActive = false
    if not Hub.AutoDodge then
        Hub.DodgeDestination, Hub.DodgeHoldUntil = nil, 0
        Hub.DodgeTrackedEntry, Hub.DodgeTrackedPart, Hub.DodgeRushEntry = nil, nil, nil
        Hub.DodgeUsingFlight = false
        Hub.DodgeHoverRotation = nil
        Hub.DodgeThreatMaxUntil = 0
        Hub.DodgeStatus = "Off"
        return false
    end
    if Hub.DodgeLifeChar ~= char then
        Hub.DodgeLifeChar=char
        Hub.DodgeLastHP=hum.Health
        Hub.DodgeLastDamageAt=0
        Hub.DodgeEmergencyNext=0
    end
    if type(Hub.DodgeLastHP)=="number" and hum.Health<Hub.DodgeLastHP-0.4 then
        Hub.DodgeLastDamageAt=now
    end
    Hub.DodgeLastHP=hum.Health
    local danger = telegraphCountAndDanger(root)
    local entry = threat and threat.Entry
    local rush = Hub:FindRushAttack(root)
    local rushRisk = rush and Hub:RushExposure(rush, root.Position) or false
    local sustained = rush or dodgeThreatCandidate(root, now, Hub.DodgeTrackedEntry)
    local learnedDanger = Hub.LearnAttacks and threat and threat.Pattern
        and (threat.Pattern.DamageSamples or 0)>=2
    local bossStrike = threat and threat.Record
        and (BossSet[threat.Record.NPCName] or AllLibraryBosses[threat.Record.NPCName])
        and threat.Horizontal <= 16 and threat.Vertical <= 17
        and threat.Meta.Kind == "Special"
    local special = not danger and threat and threat.Meta
        and (threat.Meta.AOE or threat.Meta.Ranged or threat.Meta.Multi
            or threat.Meta.Rush or learnedDanger or bossStrike)
        and threat.Remaining >= -0.14
        and threat.Remaining <= (threat.Meta.Rush and 0.74
            or learnedDanger and 0.60 or 0.54)
        and threat.Horizontal <= (threat.Meta.Rush and 36
            or threat.Meta.AOE and 27 or 29)
        and threat.Vertical <= 20
        and (directionalRisk(root, threat)
            or (threat.Meta.Rush and threat.Horizontal < 25)
            or bossStrike)
    -- When a previously hidden warning reappears, dodge again immediately;
    -- the 0.43-second old hard throttle could cause a hit on the next pulse.
    local reenter = Hub.DodgeDestination
        and Hub:V75NearbyWarning(Hub.DodgeDestination, 1.5)
    local hazardAppeared = danger and danger.Part ~= Hub.DodgeTrackedPart
    local rushUnsafeGoal = rush and Hub.DodgeDestination
        and Hub:RushExposure(rush, Hub.DodgeDestination) or false
    -- Previously "not DodgeDestination" bypassed the cooldown every frame,
    -- resulting in repeated retreat as soon as a destination was reached.
    -- Only a genuinely new warning can override the normal dodge cadence.
    local newWarning = (hazardAppeared or reenter)
        and now >= Hub.DodgeLastWarningAt + 0.10
    local recentDamage = now-Hub.DodgeLastDamageAt < 0.24
    local panic = recentDamage and hum.MaxHealth>0 and hum.Health>0
        and hum.Health/hum.MaxHealth<0.42
        and now>=(Hub.DodgeEmergencyNext or 0)
    local shouldStart = (danger or special or rushRisk or panic)
        and (now >= Hub.DodgeNextAllowed or newWarning or panic)
        and (not rush or not Hub.DodgeDestination or rushRisk
            or rushUnsafeGoal or danger or special)
    if shouldStart then
        Hub.DodgeSafetySince = 0
        -- The red ground warning represents the closest available shape
        -- evidence. Do not override its safe side with an animation-only
        -- rush estimate when both signals appear simultaneously.
        local dest = (danger and evadeDestination(root, danger, threat))
            or (rushRisk and rush and Hub:RushEscape(root, rush))
            or evadeDestination(root, nil, threat)
        if panic then
            Hub.DodgeEmergencyNext=now+3.0
            local focus = (threat and threat.OtherRoot)
                or (rush and rush.Record and rush.Record.Root)
                or (Hub.QuestCombatActive and Hub.QuestTarget and Hub.QuestTarget.Root)
                or (Hub.FarmTarget and Hub.FarmTarget.Root)
            if focus and focus.Parent then
                local away=Vector3.new(root.Position.X-focus.Position.X,0,
                    root.Position.Z-focus.Position.Z)
                if away.Magnitude>0.15 then
                    local proposal=root.Position+away.Unit*25
                    local bounded=Hub:BoundBossDestination(
                        (threat and threat.Record)
                        or (Hub.QuestCombatActive and Hub.QuestTarget)
                        or Hub.FarmTarget,root.Position,proposal)
                    if not Hub:V75NearbyWarning(bounded,2.5) then dest=bounded end
                end
            end
            Hub.DodgeEmergencyEscapes+=1
        elseif danger and not insideAnyTelegraph(root.Position) then
            Hub.DodgeEarlyWarnings+=1
        end
        -- Commit to one escape side briefly: don't reverse into the same
        -- warning because candidate scores fluctuate from frame to frame.
        if dest and Hub.DodgeDestination and now<(Hub.DodgeCommitUntil or 0) then
            local previous=Vector3.new(Hub.DodgeDestination.X-root.Position.X,0,
                Hub.DodgeDestination.Z-root.Position.Z)
            local incoming=Vector3.new(dest.X-root.Position.X,0,dest.Z-root.Position.Z)
            if previous.Magnitude>.25 and incoming.Magnitude>.25
                and previous.Unit:Dot(incoming.Unit)<-0.15
                and not Hub:V75NearbyWarning(Hub.DodgeDestination,1.5) then
                dest=Hub.DodgeDestination
            end
        end
        if dest and (dest - root.Position).Magnitude >= 1.8 then
            Hub.DodgeCommitUntil=now+0.34
            if newWarning then Hub.DodgeLastWarningAt = now end
            Hub.DodgeDestination = dest
            local range = (dest - root.Position).Magnitude
            local dodgeMethod = (Hub.AutoQuest and Hub.QuestCombatActive)
                and Hub.QuestFarmMethod or Hub.FarmMethod
            local speed = dodgeMethod == "Teleport" and 9999 or
                (dodgeMethod == "Legit" and math.max(16, hum.WalkSpeed) or 225)
            Hub.DodgeUntil = now + math.clamp(range / speed + 0.23, 0.20, 2.8)
            Hub.DodgeHoldUntil = math.max(Hub.DodgeHoldUntil, now + (panic and 0.42 or 0.24))
            Hub.DodgeNextAllowed = now + (panic and 0.20 or 0.13)
            Hub.DodgeTrackedPart = danger and danger.Part or Hub.DodgeTrackedPart
            Hub.DodgeTrackedEntry = sustained or entry or Hub.DodgeTrackedEntry
            if rush then
                Hub.DodgeRushEntry = rush
                Hub.DodgeRushLastAt = now
            end
            -- Watchdog is a fallback; the actual track-stopped signal ends
            -- sustained protection sooner. Longer windups get more runway.
            local trackLength = 0
            if Hub.DodgeTrackedEntry and Hub.DodgeTrackedEntry.Track then
                pcall(function() trackLength = Hub.DodgeTrackedEntry.Track.Length end)
            end
            Hub.DodgeThreatMaxUntil = now + math.clamp(trackLength + 0.35, 0.6, 4.5)
            Hub.DodgeSource = (panic and "Low HP: emergency retreat")
                or (danger and ("Early warning: " .. tostring(danger.Part.Name)))
                or (rush and (tostring(rush.Record.NPCName)
                    .. ": " .. tostring(rush.Meta and rush.Meta.Move or "Rush") .. " (moving)"))
                or (threat and threat.Meta.Move)
                or (sustained and sustained.Meta.Move) or "Special attack"
            if Hub.DefenseMode and not manualHoldingBlock() then releaseDefense() end
            Hub.Stats.DodgeAttempts += 1
            if danger then Hub.Stats.TelegraphDodges += 1
            else Hub.Stats.SpecialDodges += 1 end
            Hub.DefenseDebug = "Evading: " .. Hub.DodgeSource
        end
    end
    -- Hold until continuous animation / repeated hitboxes end, including the
    -- interval after warnings disappear. Never hold forever on a looped track.
    local tracked = Hub.DodgeTrackedEntry
    local activeSequence = tracked and now < Hub.DodgeThreatMaxUntil
        and trackIsActive(tracked)
        and (sustainedAnimation(tracked) or (tracked.Meta and tracked.Meta.Ranged))
    -- Animation still playing is not evidence of an active damage zone.
    -- A remote warning Part can remain parented long after it stops overlapping.
    local activeWarning = danger ~= nil
    local actuallyAtRisk = activeWarning or rushRisk or special
    if rush and Hub.DodgeRushEntry == rush then
        Hub.DodgeRushLastAt = now
    end
    if actuallyAtRisk then
        Hub.DodgeHoldUntil = math.max(Hub.DodgeHoldUntil, now+0.18)
        Hub.DodgeSafetySince=0
    else
        if Hub.DodgeSafetySince==0 then Hub.DodgeSafetySince=now end
        -- Let farming reacquire the boss promptly instead of waiting through
        -- a looped animation, or extending an already safe dodge indefinitely.
        Hub.DodgeHoldUntil = math.min(Hub.DodgeHoldUntil, now+0.16)
        Hub.DodgeUntil = math.min(Hub.DodgeUntil, now+0.20)
    end
    -- An attack can keep moving its warning after we reached safety. React
    -- again only when the player or the destination is genuinely exposed.
    if danger and Hub.DodgeDestination
        and now >= math.max(Hub.DodgeNextAllowed,Hub.DodgeCommitUntil or 0)
        and Hub:V75NearbyWarning(Hub.DodgeDestination,1.5) then
        local alt = evadeDestination(root, danger, threat)
        if alt and (alt - root.Position).Magnitude > 2
            and (alt-Hub.DodgeDestination).Magnitude > 3 then
            Hub.DodgeDestination = alt
            Hub.DodgeCommitUntil=now+0.34
            Hub.DodgeUntil = now + math.clamp((alt-root.Position).Magnitude/225+0.2,0.25,2)
            Hub.DodgeNextAllowed=now+0.13
            Hub.DodgeRetargetCount+=1
        end
    end
    -- The tornado pursues: after each short sidestep, measure the boss again
    -- and choose another lateral escape only if its moving zone catches up.
    if rush and rushRisk and now >= math.max(Hub.DodgeNextAllowed,Hub.DodgeCommitUntil or 0) and not danger
        and (Hub:RushExposure(rush, root.Position)
            or (Hub.DodgeDestination
                and Hub:RushExposure(rush, Hub.DodgeDestination))) then
        local alt = Hub:RushEscape(root, rush)
        if alt and (alt-root.Position).Magnitude > 4
            and (not Hub.DodgeDestination
                or (alt-Hub.DodgeDestination).Magnitude > 5) then
            Hub.DodgeDestination=alt
            Hub.DodgeCommitUntil=now+0.34
            Hub.DodgeUntil=now+math.clamp((alt-root.Position).Magnitude/225+0.32,0.38,1.9)
            Hub.DodgeNextAllowed=now+0.13
        end
    end
    local goal = Hub.DodgeDestination
    if goal and (threat or rush) then
        goal=Hub:BoundBossDestination((rush and rush.Record)
            or (threat and threat.Record),root.Position,goal)
        Hub.DodgeDestination=goal
    end
    if goal and now <= Hub.DodgeUntil and (goal - root.Position).Magnitude > 1.2 then
        Hub.DodgeActive = true
        Hub.DodgeStatus = "Evading: " .. Hub.DodgeSource
        local dodgeMethod = (Hub.AutoQuest and Hub.QuestCombatActive)
            and Hub.QuestFarmMethod or Hub.FarmMethod
        if dodgeMethod == "Legit" then
            Hub.DodgeUsingFlight = false
            Hub:ReleaseFarmFlight()
            hum:MoveTo(goal)
        else
            Hub.DodgeUsingFlight = true
            local delta = goal - root.Position
            local step = dodgeMethod == "Teleport" and delta.Magnitude
                or math.min(delta.Magnitude, math.max(dt, 0.001)*225)
            local pos = root.Position + delta.Unit*step
            -- Keep a stable pose throughout the dodge, even if a hit reaction
            -- briefly rotates the avatar upright. Farming resumes targeting
            -- orientation as soon as defense gives back movement ownership.
            Hub.DodgeHoverRotation = Hub.DodgeHoverRotation
                or (Hub.FarmFlightPose and Hub.FarmFlightPose.Rotation)
                or root.CFrame.Rotation
            local pose = CFrame.new(pos) * Hub.DodgeHoverRotation
            char:PivotTo(pose)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            Hub:HoldFarmFlight(root, pose)
        end
        Hub.GuardUntil = math.max(Hub.GuardUntil, now + 0.07)
        return true
    end
    Hub.DodgeDestination = nil
    if danger then
        -- If the first jump was too short, don't stop in the hazard.
        Hub.DodgeNextAllowed = 0
        Hub.DodgeHoldUntil = math.max(Hub.DodgeHoldUntil, now + 0.25)
    end
    local safetyElapsed = Hub.DodgeSafetySince ~= 0 and (now - Hub.DodgeSafetySince) or 0
    if now < Hub.DodgeHoldUntil or (actuallyAtRisk and activeSequence)
        or (tracked and actuallyAtRisk and safetyElapsed < 0.16) then
        Hub.DodgeStatus = actuallyAtRisk and
            ("Evading nearby attack: " .. Hub.DodgeSource)
            or "Returning to fight"
        local dodgeMethod = (Hub.AutoQuest and Hub.QuestCombatActive)
            and Hub.QuestFarmMethod or Hub.FarmMethod
        if dodgeMethod ~= "Legit" and Hub.DodgeUsingFlight then
            local holdPose = Hub.DodgeHoverRotation
                and (CFrame.new(root.Position) * Hub.DodgeHoverRotation)
                or root.CFrame
            Hub:HoldFarmFlight(root, holdPose)
        end
        return true
    end
    Hub.DodgeTrackedEntry, Hub.DodgeTrackedPart, Hub.DodgeRushEntry = nil, nil, nil
    if Hub.DodgeUsingFlight and not Hub.AutoFarm and not Hub.QuestCombatActive then
        Hub:ReleaseFarmFlight()
    end
    Hub.DodgeUsingFlight = false
    Hub.DodgeHoverRotation = nil
    Hub.DodgeStatus = "Ready"
    return false
end

local function markThreatHandled(threat, now)
    local entry = threat.Entry
    entry.Handled = true
    entry.Attempts += 1
    if entry.Meta.Multi and entry.Attempts < 4 then
        entry.NextImpactAt = now + (entry.MarkerGap or 0.38)
    else
        entry.NextImpactAt = nil
    end
end

-- Respect players' own inputs; automation never blocks or overwrites them.
table.insert(Hub.Connections, UIS.InputBegan:Connect(function(input, processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if matches("Block", input) then
        Hub.ManualBlock = true
        Hub.ManualUntil = os.clock() + 0.30
        -- If the script was blocking, transfer the hold to the user's input.
        Hub.DefenseMode, Hub.DefenseReleaseAt = nil, 0
        return
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or matches("Attack", input) or matches("Critical", input)
        or matches("Uppercut", input) or matches("Feint", input) then
        Hub.ManualUntil = os.clock() + 0.45
        -- Never let automatic defense eat a real M1/Critical input.
        if Hub.DefenseMode then releaseDefense() end
    end
end))
table.insert(Hub.Connections, UIS.InputEnded:Connect(function(input)
    if matches("Block", input) then
        Hub.ManualBlock = false
        Hub.ManualUntil = os.clock() + 0.12
    end
end))

-- One Heartbeat scheduler. Incoming attacks are considered BEFORE movement
-- or offense, so a farm step cannot spin us away before the parry decision.
table.insert(Hub.Connections, RunService.Heartbeat:Connect(function(dt)
    if not Hub.Running then return end
    local now = os.clock()
    if Hub.DefenseMode and now >= Hub.DefenseReleaseAt then releaseDefense() end
    if not (Hub.AutoParry or Hub.AutoBlock) then
        Hub.GuardUntil, Hub.GuardRoot = 0, nil
    end
    if not (Hub.AutoAttack or Hub.AutoCritical or Hub.AutoParry
        or Hub.AutoBlock or Hub.AutoDodge or Hub.LearnAttacks or Hub.AutoFarm
        or Hub.AutoQuest or Hub.QuestCombatActive or Hub.AutoOpenChest or Hub.AutoInventoryChests) then
        if Hub.FarmSavedAutoRotate or next(Hub.FarmCollisionOriginals) then clearFarmMovement() end
        return
    end
    local char, root, hum = myCharacter()
    if not char then return end
    if Hub:InventoryBusy() then
        if Hub.DefenseMode then releaseDefense() end
        Hub:ReleaseFarmFlight()
        Hub.OffenseGate="Inventory action";Hub.FarmMoveStatus="Waiting for chest placement"
        return
    end
    if Hub.V70NenPriority then
        Hub.OffenseGate="Node Master has priority"
        Hub.FarmMoveStatus="Paused for Node Master; activity preserved"
        Hub:ReleaseFarmFlight()
        return
    end
    if Hub.V69Trip then
        Hub.OffenseGate="Maintenance trip: "..tostring(Hub.V69Trip.Owner)
        Hub.FarmMoveStatus="Paused for "..tostring(Hub.V69Trip.Owner)
        return
    end
    if (Hub.AutoOpenChest or Hub.AutoInventoryChests or Hub.AutoMapChests) and Hub.ChestSession then
        if Hub.DefenseMode then releaseDefense() end
        Hub.OffenseGate="Collecting chest rewards"
        Hub.FarmMoveStatus="Misc: chest collection owns movement"
        return
    end
    local focused = Hub.FarmTarget
    if focused and modelDeadOrDespawning(focused.Model, focused.Hum) then
        Hub.RetiredModels[focused.Model] = true
        Hub.RetargetsAfterDeath += 1
        Hub.FarmTarget = nil
        Hub.FarmNextSearch = 0
        resetFarmPursuit()
    end
    local ctrl = controller()
    local nativeEquipped = equipped(ctrl)
    if now<(Hub.V69CombatReadyUntil or 0)
        or char:GetAttribute("SpawnProtected")==true then
        Hub.V69RespawnState=char:GetAttribute("SpawnProtected")==true
            and "Spawn protection active; moving out of protection"
            or "Respawn: reinitializing combat; travel allowed"
    elseif not nativeEquipped and (Hub.AutoAttack or Hub.AutoCritical) then
        Hub.V69RespawnState="No equipped combat weapon; waiting for load/equip"
    else
        Hub.V69RespawnState="Combat bindings ready"
    end
    if Hub.AutoFarm or Hub.AutoQuest or Hub.AutoAttack or Hub.AutoCritical
        or Hub.QuestCombatActive or Hub.AutoParry or Hub.AutoBlock
        or Hub.AutoDodge or Hub.LearnAttacks then
        discoverNearbyEnemies(root, now)
    end
    if not nativeEquipped and Hub.DefenseMode then releaseDefense() end

    local threat
    if (nativeEquipped and (Hub.AutoParry or Hub.AutoBlock)) or Hub.AutoDodge
        or Hub.LearnAttacks then
        -- Catch animations already playing when a toggle is turned on or
        -- when a weapon's Animator is attached after NPC registration.
        if now >= Hub.NextTrackScan then
            Hub.NextTrackScan = now + 0.12
            for _, record in pairs(Hub.Observed) do
                if record.Hum and record.Root and record.Root.Parent
                    and (record.Root.Position - root.Position).Magnitude <= 36 then
                    local animator = record.Hum:FindFirstChildOfClass("Animator")
                    if animator then
                        if record.Animator ~= animator then
                            -- Register late-loaded Animator via existing binder
                            -- on the next AnimationPlayed event; scan now too.
                            record.Animator = animator
                            table.insert(record.Signals, animator.AnimationPlayed:Connect(function(track)
                                observeTrack(record, track)
                            end))
                        end
                        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                            observeTrack(record, track)
                        end
                    end
                end
            end
        end
        threat = predictedThreat(root)
    end
    Hub.CurrentThreat = threat and threat.Record.Model.Name or "None"
    Hub.ThreatRemaining = threat and threat.Remaining or nil
    Hub.ThreatDistance = threat and math.sqrt(threat.Horizontal ^ 2 + threat.Vertical ^ 2) or nil
    Hub.CurrentThreatMove = threat and threat.Meta.Move or "None"
    Hub.CurrentThreatKind = threat and threat.Meta.Kind or "None"
    Hub.CurrentThreatWeapon = threat and (NpcWeapon[threat.Record.NPCName] or "Unknown") or "Unknown"
    -- CombatNet Gate.Rules.Block includes Attacking and Recovery. A parry
    -- cannot interrupt an already-started swing, so reserve defense BEFORE
    -- starting another M1/Critical when a nearby attack is approaching.
    -- Only a currently playing, unhandled, close threat may reserve offense;
    -- far-away ranged animations should never freeze farming indefinitely.
    if now >= Hub.DefensePriorityUntil then
        Hub.DefensePriorityStatus="No immediate threat"
    end
    if threat and (Hub.AutoParry or Hub.AutoBlock)
        and (Hub.AutoBlock or now >= Hub.NextParry - 0.18)
        and threat.Remaining <= 0.62 and threat.Remaining >= -0.10
        and threat.Horizontal <= ((threat.Meta.Rush or threat.Meta.AOE) and 23 or 15)
        and threat.Vertical <= (threat.Meta.AOE and 20 or 14) then
        local remaining=math.max(0,threat.Remaining)
        Hub.GuardRoot=threat.OtherRoot
        local untilAt=now+math.clamp(remaining+0.15,0.16,0.70)
        if Hub.GuardUntil <= now then Hub.Stats.DefenseReservations+=1 end
        Hub.GuardUntil=math.max(Hub.GuardUntil,untilAt)
        Hub.DefensePriorityUntil=math.max(Hub.DefensePriorityUntil,untilAt)
        Hub.DefensePriorityStatus=string.format("Reserve defense %.2fs: %s",remaining,tostring(threat.Meta.Move))
        Hub.DefenseDebug="Incoming "..tostring(threat.Meta.Kind)..": "..tostring(threat.Meta.Move)
    end

    -- v75: hold new M1/Critical before an imminent rushing or area attack;
    -- a parry is often impossible once M1 recovery starts.
    if Hub.AutoDodge and threat and threat.Meta
        and (threat.Meta.Rush or threat.Meta.AOE or threat.Meta.Multi)
        and threat.Remaining>=-0.10 and threat.Remaining<=0.72
        and threat.Horizontal<=33 and threat.Vertical<=20 then
        Hub.OffenseQuietUntil=math.max(Hub.OffenseQuietUntil,
            now+math.min(0.35,math.max(0.12,threat.Remaining+0.07)))
    end

    -- Optional native emergency cancellation: the new client exposes a real
    -- M1 Feint input, but only before its Hit marker and subject to its own
    -- cooldown. It can free the Block gate sooner than waiting for an entire
    -- swing, allowing Auto Parry/Block to react during a dangerous windup.
    -- It is NOT a guaranteed cancel and never bypasses server action rules.
    if CombatV2 and CombatV2.input and type(CombatV2.input.feint)=="function"
        and CombatV2State and type(CombatV2State.has)=="function"
        and (Hub.AutoParry or Hub.AutoBlock) and not Hub.DefenseMode
        and threat and threat.Remaining >= 0.02 and threat.Remaining <= 0.45
        and threat.Horizontal <= 14 and threat.Vertical <= 13
        and now >= Hub.DefensiveFeintNext
        and now-Hub.LastM1 >= 0.06 and now-Hub.LastM1 <= 0.55 then
        local hasState,attacking=pcall(CombatV2State.has,char,"Attacking")
        local cooldownOK=true
        if CombatV2Gate and type(CombatV2Gate.cooldownLeft)=="function" then
            local ok,remaining=pcall(CombatV2Gate.cooldownLeft,LocalPlayer,"Feint")
            cooldownOK=ok and type(remaining)=="number" and remaining<=0.01
        end
        if hasState and attacking and cooldownOK then
            -- Feint has a native four-second cooldown; retry a short time
            -- later only if a new unhandled threat is observed.
            Hub.DefensiveFeintNext=now+0.85
            local worked=safeCall(function() CombatV2.input.feint() end)
            if worked then
                Hub.DefensiveFeintAttempts+=1
                Hub.DefenseDebug="Emergency native M1 feint attempted before defense"
            end
        end
    end

    -- A real server-supplied warning outline overrides both farm movement and
    -- combat. Auto Farm remains movement-only; Auto Dodge is independent.
    -- Do not delete the flight stabilizer during a non-Legit dodge; the
    -- dodge controller owns position until the moving attack has ended.
    local dodgeOK, dodgeMoved = safeCall(function()
        return stepAutoDodge(dt, char, root, hum, now, threat)
    end)
    if not dodgeOK then Hub.DodgeStatus = "Dodge error: " .. tostring(Hub.Stats.LastError) end
    if (dodgeMoved or Hub.DodgeActive) and not Hub.DodgeUsingFlight then
        Hub:ReleaseFarmFlight()
    end
    -- Auto Quest travel has priority over the separate movement-only farm.
    -- Auto Farm remains movement-only; quest combat explicitly opts into M1.
    -- Farm releases ownership first; the quest route applies the final pose.
    local moveOK = safeCall(function() farmMovementStep(dt, char, root, hum, now) end)
    if not moveOK then Hub.FarmMoveStatus = "Movement error: " .. tostring(Hub.Stats.LastError) end
    local questCombatOK = safeCall(function()
        questCombatMovementStep(dt,char,root,hum,now)
    end)
    if not questCombatOK then Hub.QuestFarmState.Status = "Quest combat movement error: "..tostring(Hub.Stats.LastError) end
    local questNavOK = safeCall(function() questTravelStep(dt, char, root, hum, now) end)
    if not questNavOK then Hub.QuestStatus = "Travel error: " .. tostring(Hub.Stats.LastError) end
    if Hub.QuestHandoffUntil>now and not dodgeMoved then
        safeCall(function() Hub:QuestHandoffHover(char,root,hum,now) end)
    end
    -- A killed/despawned target must not leave BodyVelocity/BodyGyro behind.
    -- Real living targets (including brief knockdowns) retain movement control.
    local questRig=Hub.QuestTarget
    local questLiveOwner=Hub.AutoQuest and Hub.QuestCombatActive
        and questRig and questRig.Model and questRig.Hum
        and not modelDeadOrDespawning(questRig.Model,questRig.Hum)
    local farmLiveOwner=Hub.AutoFarm and Hub.FarmTarget
        and Hub:FarmLockPersistent(Hub.FarmTarget)
        and not Hub.FarmQuestHandoff
    local stillHandoff=Hub.AutoQuest and Hub.QuestHandoffUntil>now
        and not Hub.QuestMoveTo
    local dodgeOwner=Hub.DodgeActive or Hub.DodgeUsingFlight
        or now<Hub.DodgeHoldUntil
    if not (questLiveOwner or farmLiveOwner or stillHandoff or dodgeOwner) then
        if Hub.FarmFlightRoot then Hub:ReleaseFarmFlight() end
        if Hub.QuestHandoffPose then Hub.QuestHandoffPose=nil end
        if not Hub.AutoFarm and not Hub.QuestCombatActive
            and Hub.FarmSavedAutoRotate then
            clearFarmMovement()
        end
    end

    -- Continue facing the active attacker while defending, even if an orbital
    -- farm pose or other local controller attempts to rotate the root.
    if not dodgeMoved and nativeEquipped and Hub.GuardRoot and Hub.GuardRoot.Parent
        and (Hub.DefenseMode or now < Hub.GuardUntil) and not manualHoldingBlock()
        and not (Hub.AutoFarm and Hub.FarmMethod~="Legit")
        and not (Hub.QuestCombatActive and Hub.QuestFarmMethod~="Legit") then
        faceTarget(root, Hub.GuardRoot)
    end
    if threat and nativeEquipped and not dodgeMoved and now >= Hub.ManualUntil
        and not manualHoldingBlock() then
        local parryReady = Hub.AutoParry and canParry(char, ctrl, now)
        -- Marker-trained timing corrects the impact point; use a slightly
        -- tighter input window after several repeated observations.
        local confident = Hub.LearnAttacks and threat.Pattern
            and (threat.Pattern.MarkerSamples or 0)>=3
        -- The game's parry input is a 0.25s window; allow for the time needed
        -- to transmit BlockStart. Earlier reliable markers permit a tighter
        -- window. This does not bypass an attack's recovery/cooldown gate.
        local lead = confident
            and math.clamp(0.19 + pingSeconds()*0.65,0.19,0.27)
            or math.clamp(0.22 + pingSeconds()*0.65,0.22,0.30)
        -- AoE/projectiles often use different hit timing and can be
        -- un-parryable. If Auto Block is on, prioritize an earlier block
        -- attempt for those moves instead of wasting a predicted parry.
        local parried = false
        local broadSpecial = threat.Meta.Kind == "Special"
            and (threat.Meta.Ranged or threat.Meta.AOE)
        if broadSpecial and Hub.AutoBlock and not Hub.DefenseMode
            and threat.Remaining <= 0.38 and threat.Remaining >= -0.10
            and now - Hub.LastAutoBlock >= 0.15 then
            if beginDefense("Block", char, ctrl, root, threat.OtherRoot,
                now, math.max(0, threat.Remaining)) then
                Hub.DefenseReleaseAt = math.max(Hub.DefenseReleaseAt,
                    now + math.clamp(threat.Remaining + 0.42, 0.35, 0.84))
                Hub.DefenseDebug = "Special move: early block attempt (unverified)"
                markThreatHandled(threat, now)
            end
        end
        -- For melee, use a native timed Press, never continuous Press spam.
        if parryReady and not Hub.DefenseMode
            and threat.Remaining <= lead and threat.Remaining >= -0.085 then
            parried = beginDefense("Parry", char, ctrl, root, threat.OtherRoot,
                now, math.max(0, threat.Remaining))
            if parried then markThreatHandled(threat, now) end
        end
        if Hub.AutoBlock and not Hub.DefenseMode and not parried
            and (not Hub.AutoParry or not parryReady or threat.Remaining <= 0.11)
            and threat.Remaining <= 0.32 and threat.Remaining >= -0.085
            and now - Hub.LastAutoBlock >= 0.15 then
            if beginDefense("Block", char, ctrl, root, threat.OtherRoot,
                now, math.max(0, threat.Remaining)) then
                markThreatHandled(threat, now)
            end
        end
    end

    -- Let movement out of safe zones and enemy reacquisition continue even
    -- when attacks are temporarily blocked by spawn protection.
    if now<(Hub.V69CombatReadyUntil or 0)
        or char:GetAttribute("SpawnProtected")==true then
        Hub.OffenseGate=Hub.V69RespawnState or "Respawn combat recovery"
        Hub.FarmLastM1Gate=Hub.OffenseGate
        return
    end
    -- Offense pauses only for imminent defense and native action locks.
    -- Explain why quest/farm movement can look active while no attacks occur.
    if not (Hub.AutoAttack or Hub.AutoCritical) then
        if Hub.AutoFarm or Hub.QuestCombatActive then
            Hub.OffenseGate="Combat Auto Attack is OFF"
            Hub.FarmLastM1Gate=Hub.OffenseGate
        end
        return
    end
    if dodgeMoved or Hub.DodgeActive or now < Hub.DodgeHoldUntil then
        Hub.OffenseGate = "Dodging or avoiding AoE"
        Hub.FarmLastM1Gate = Hub.OffenseGate
        return
    end
    if not offenseAllowed(char, now) then
        Hub.OffenseGate = Hub.DefenseMode and ("Defense: " .. Hub.DefenseMode)
            or (now < Hub.DefensePriorityUntil and Hub.DefensePriorityStatus)
            or (now < Hub.GuardUntil and "Incoming attack")
            or (now < Hub.DefenseUntil and "Defense recovery")
            or (now < Hub.ManualUntil and "Manual input")
            or "Character/input state"
        if threat then Hub.Stats.OffenseDeferred += 1 end
        Hub.FarmLastM1Gate = Hub.OffenseGate
        return
    end
    Hub.OffenseGate = CombatV2 and "CombatNet ready" or "Ready"
    if Hub.M1Mode=="Unavailable" then
        Hub.OffenseGate="Combat backend unavailable after update"
        Hub.FarmLastM1Gate=Hub.OffenseGate
        return
    end
    -- The M1 scheduler doesn't send more often than its .17s gate; cap
    -- expensive distance/body checks when nothing is available to attack.
    if now - Hub.LastOffense < 0.17 then return end
    if now < Hub.NextOffenseScan then return end
    Hub.NextOffenseScan = now + 0.10
    local combatTarget = npcCombatTarget(root)
    if not combatTarget then
        Hub.OffenseGate = Hub.NearestAggro ~= "None"
            and "Aggro detected but target out of attack range"
            or "No NPC within attack range"
        Hub.FarmLastM1Gate = Hub.OffenseGate
        return
    end
    local wantM1 = Hub.AutoAttack
    -- Critical attacks commit to a longer windup than ordinary M1s. Avoid
    -- starting one as a known nearby hit approaches, even if the shorter M1
    -- reservation has not begun yet.
    if nativeEquipped and Hub.AutoCritical and (not wantM1 or Hub.M1SinceCrit >= 2)
        and not (threat and (Hub.AutoParry or Hub.AutoBlock)
            and threat.Remaining >= 0 and threat.Remaining <= 0.90
            and threat.Horizontal <= 18 and threat.Vertical <= 14) then
        if attemptCrit(ctrl, char, now) then return end
    end
    if wantM1 then
        -- The raw packet uses our CURRENT CFrame as attack facing. When
        -- standing still without Auto Farm we must aim at the nearby NPC.
        -- Do not overwrite Above/Below farm's intentional orientation.
        if not (Hub.AutoFarm or Hub.QuestCombatActive) and combatTarget and combatTarget.Root
            and combatTarget.Root.Parent and not manualHoldingBlock() then
            faceTarget(root, combatTarget.Root)
        end
        if CombatV2 or Hub.M1Mode == "Native" then
            local ok, why = attemptNativeM1(ctrl, char, now)
            if not ok then Hub.FarmLastM1Gate = why end
        else
            local initialHealth = combatTarget and combatTarget.Hum.Health
            local ok = attemptM1(ctrl, char, now)
            if ok and combatTarget and initialHealth
                and targetBodyDistance(root.Position, combatTarget) <= ATTACK_RANGE then
                observeDirectDamage(combatTarget, initialHealth, "Direct")
            end
        end
    end
end))

