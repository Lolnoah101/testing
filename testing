local function slashStatus(message)
    message = tostring(message)
    Farm.slashStatus = message
    if Farm.slashStatusLastPrint ~= message then
        Farm.slashStatusLastPrint = message
        do end
    end
end

local function getClientActor()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Actor")
end

local function getActorRunner()
    if type(run_on_actor) == "function" then return run_on_actor end
    if type(ENV.run_on_actor) == "function" then return ENV.run_on_actor end
    return nil
end

local function resolveSlashBridge()
    local actor = getClientActor()
    if not actor then return nil, "Character.Actor not found" end
    if Farm.slashActor ~= actor then
        Farm.slashActor = actor
        Farm.slashBridge = nil
        Farm.slashBridgeRequestedAt = -100
        Farm.attackHeld = false
    end
    local existing = actor:FindFirstChild(BRIDGE_NAME)
    if existing and existing:IsA("BindableFunction") then
        Farm.slashBridge = existing
        return existing
    end
    local runner = getActorRunner()
    if not runner then
        return nil, "run_on_actor unavailable; internal slash cannot be accessed"
    end
    if os.clock() - Farm.slashBridgeRequestedAt < 2 then
        return nil, "Actor bridge initializing"
    end
    Farm.slashBridgeRequestedAt = os.clock()
    local ok, errorMessage = pcall(runner, actor, ACTOR_SOURCE)
    if not ok then
        return nil, "Actor execution rejected: " .. tostring(errorMessage)
    end
    -- Actor execution may start asynchronously.
    for _ = 1, 8 do
        local ready = actor:FindFirstChild(BRIDGE_NAME)
        if ready and ready:IsA("BindableFunction") then
            Farm.slashBridge = ready
            return ready
        end
        task.wait(0.04)
    end
    return nil, "Actor bridge not installed (runner may be unsupported)"
end

local function bridgeRequest(command)
    local bridge, reason = resolveSlashBridge()
    if not bridge then
        slashStatus(reason)
        return false
    end
    local ok, accepted, detail = pcall(function()
        return bridge:Invoke(command)
    end)
    if not ok then
        slashStatus("Actor bridge invocation failed: " .. tostring(accepted))
        return false
    end
    if not accepted then
        slashStatus(detail or "Combat Host rejected the command")
        return false
    end
    Farm.slashStatus = tostring(detail or "Client slash ready")
    return true
end

local function setAttackHeld(held)
    if held == Farm.attackHeld then return true end
    local success = bridgeRequest(held and "start" or "release")
    if success then Farm.attackHeld = held end
    return success
end

