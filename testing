        -- Official FateBlessings config IDs from this dungeon place.
        -- The categories are a user preference; the server still decides
        -- which three cards are offered and validates the selected ID.
        local FateBlessingCategories = {
            Damage = {
                Sharp = true, ChainShatter = true,
                GlassCannon = true, TwinBreaker = true,
            },
            Health = {
                BigHeart = true, ShardSnack = true,
                SpareHeart = true, MirrorLeech = true,
            },
            Defense = { MirrorArmor = true },
            Utility = { Swift = true },
        }
        -- All IDs in the patched FateBlessings config. Some have Raid-only
        -- effects; those are ONLY chosen if the official server offers them.
        local ValidFateBlessingIds = {
            Sharp = true, ChainShatter = true, GlassCannon = true,
            TwinBreaker = true, BigHeart = true, ShardSnack = true,
            SpareHeart = true, MirrorLeech = true,
            MirrorArmor = true, Swift = true,
        }

        local function PickFateBlessing(Offer, Priority)
            local Candidates = {}
            local Preferred = {}
            local Category = FateBlessingCategories[Priority]
            local Seen = {}

            -- Same comma-separated ID format used by the official picker.
            for Id in string.gmatch(Offer, "[^,]+") do
                local Name = string.match(Id, "^%s*(.-)%s*$")
                if ValidFateBlessingIds[Name] and not Seen[Name] then
                    Seen[Name] = true
                    table.insert(Candidates, Name)
                    if Category and Category[Name] then
                        table.insert(Preferred, Name)
                    end
                end
            end

            if #Preferred > 0 then
                return Preferred[math.random(1, #Preferred)], "Preferred " .. Priority
            end
            if #Candidates > 0 then
                return Candidates[math.random(1, #Candidates)],
                    Priority == "Random" and "Random" or "Random fallback"
            end
            return nil, "No recognized offered blessings"
        end

        --//========================================================
        --// MOLTEN HIGH RISE: ONE PHASE-AWARE MOVEMENT OWNER
        --// Uses FloorN.Respawn as a safe landing marker; FloorN.Barrier
        --// exists but is invisible/non-collidable and is only a gate marker.
        --// Lever prompts and ramps/stairs handle other stages.
        --// Never mutates Flood* attributes or pretends a local stage is
        --// server-confirmed. It waits for the actual state to advance.
        --//========================================================
        local TidalHeight = { [0] = 0.75, [1] = 123.5, [2] = 170.5,
            [3] = 217.5, [4] = 264.5, [5] = 311.5, [6] = 358.5,
            [7] = 405.5, [8] = 452.5, [9] = 499.5,
            [10] = 585.5, [11] = 632.5, [12] = 678.5 }

        local function TidalPoint(Part)
            if Part and Part:IsA("BasePart") then return Part.Position end
            return nil
        end

        local function TidalMap()
            local World = workspace:FindFirstChild("World")
            return World, World and World:FindFirstChild("Map"),
                World and World:FindFirstChild("Markers")
        end

        local function TidalFloorMarker(Floor)
            local _, _, Markers = TidalMap()
            if not Markers then return nil end
            if Floor >= 12 then return Markers:FindFirstChild("BossSpawn") end
            local Group = Markers:FindFirstChild("Floor" .. tostring(Floor))
            -- Respawn marks a landing. Barrier exists as a non-solid gate
            -- target; using it as a standing floor caused underground paths.
            return Group and (Group:FindFirstChild("Respawn")
                or Group:FindFirstChild("Barrier"))
        end

        -- The game's latest Floor 10 has two elevations: enemy spawn pads
        -- near Y=546.5 and the gate/respawn landing near Y=585.5. Never
        -- assume all enemies are level with the floor's Respawn marker.
        local TidalSpawnHeightCache = {markers = nil, heights = {}}
        local function TidalCombatHeight(Floor)
            local _, _, Markers = TidalMap()
            if not Markers then
                return Floor == 10 and 546.5 or TidalHeight[Floor]
            end
            if TidalSpawnHeightCache.markers ~= Markers then
                TidalSpawnHeightCache.markers = Markers
                TidalSpawnHeightCache.heights = {}
            end
            local Cached = TidalSpawnHeightCache.heights[Floor]
            if Cached then return Cached end
            local Group = Markers:FindFirstChild("Floor" .. tostring(Floor))
            local Spawns = Group and Group:FindFirstChild("EnemySpawns")
            local Sample = Spawns and Spawns:FindFirstChildWhichIsA("BasePart")
            local Y = Sample and Sample.Position.Y
                or (Floor == 10 and 546.5 or TidalHeight[Floor])
            TidalSpawnHeightCache.heights[Floor] = Y
            return Y
        end

        local function TidalEnemyOnFloorY(Y, Floor)
            if type(Y) ~= "number" then return false end
            local CombatY = TidalCombatHeight(Floor)
            local GateY = TidalHeight[Floor]
            -- The parking garage spans multiple stacked decks (up to about
            -- Y=74.5). Treat all living garage enemies as initial-wave combat,
            -- rather than using the ground-level marker's narrow +/-28 band.
            if Floor == 0 then
                return Y >= -8 and Y <= 83
            end
            return (CombatY ~= nil and math.abs(Y - CombatY) <= 28)
                or (GateY ~= nil and math.abs(Y - GateY) <= 16)
        end

        -- Used by the shared combat engine when its mode is floodescape.
        -- The filter is the current floor's spawn band, NOT the player's
        -- current Y: Floor 10 has enemies 39 studs below the gate landing.
        GENV.__AZ_TIDAL_IS_ACTIVE_FLOOR_ENEMY = function(Y)
            local Floor = workspace:GetAttribute("FloodRoof") == true and 12
                or math.clamp(math.floor(tonumber(workspace:GetAttribute("FloodFloor")) or 0), 0, 12)
            -- Some servers publish Floor=1 while the avatar is still in
            -- the parking-garage opening wave. Prioritize that wave first.
            local Runtime = GENV.__AZ_TIDAL_RUNTIME
            if Runtime and Runtime.parkingCombatActive == true then
                Floor = 0
            end
            return TidalEnemyOnFloorY(Y, Floor)
        end

        local function TidalGroundGoal(Point, Root, ExactRadius, Floor)
            if typeof(Point) ~= "Vector3" or not Root then return nil end
            local _, Map = TidalMap()
            if not Map then return nil end
            local Parameters = RaycastParams.new()
            Parameters.FilterType = Enum.RaycastFilterType.Include
            Parameters.FilterDescendantsInstances = {Map}
            Parameters.IgnoreWater = true
            Parameters.RespectCanCollide = true
            local Directions = ExactRadius and {
                Vector3.zero, Vector3.new(3,0,0), Vector3.new(-3,0,0),
                Vector3.new(0,0,3), Vector3.new(0,0,-3),
            } or {
                Vector3.zero, Vector3.new(5,0,0), Vector3.new(-5,0,0),
                Vector3.new(0,0,5), Vector3.new(0,0,-5),
                Vector3.new(8,0,0), Vector3.new(0,0,8),
                Vector3.new(-8,0,0), Vector3.new(0,0,-8),
                Vector3.new(12,0,0), Vector3.new(-12,0,0),
                Vector3.new(0,0,12), Vector3.new(0,0,-12),
            }
            -- A combat destination may be on the separate spawn deck below
            -- a floor's gate. Validate the surface against that deck instead
            -- of demanding it be within 8 studs of the gate's marker height.
            local ExpectedY = Floor and TidalHeight[Floor] or nil
            local CombatY = Floor and TidalCombatHeight(Floor) or nil
            -- Parking-level combat may be on a raised garage deck. Accept
            -- the actual collidable floor near the enemy, not just Y=0.75.
            if Floor == 0 and Point.Y >= -8 and Point.Y <= 83 then
                ExpectedY = Point.Y
            end
            if CombatY and ExpectedY and math.abs(CombatY - ExpectedY) > 12
                and math.abs(Point.Y - CombatY) <= 20 then
                ExpectedY = CombatY
            end
            local Human = Root.Parent and Root.Parent:FindFirstChildOfClass("Humanoid")
            local Height = math.clamp((Human and Human.HipHeight or 2)
                + Root.Size.Y / 2, 2.5, 7)
            local Best, BestScore = nil, math.huge
            for _, Offset in ipairs(Directions) do
                local Test = Point + Offset
                local Hit = workspace:Raycast(Test + Vector3.new(0, 17, 0),
                    Vector3.new(0, -40, 0), Parameters)
                if Hit and Hit.Normal.Y >= 0.62
                    and math.abs(Hit.Position.Y - Point.Y) <= (Floor and 8 or 15)
                    and (not Floor or (ExpectedY
                        and math.abs(Hit.Position.Y - ExpectedY) <= 8))
                then
                    local Pos = Hit.Position + Vector3.new(0, Height, 0)
                    local Score = Offset.Magnitude + math.abs(Pos.Y - Point.Y) * 0.07
                    if Score < BestScore then
                        Best, BestScore = CFrame.new(Pos) * Root.CFrame.Rotation, Score
                    end
                end
            end
            return Best
        end

        -- A close-by lever or marker is NOT proof that Roblox considers us
        -- on the current walkable floor. Confirm the visible surface beneath
        -- the HumanoidRootPart, and its height relative to FloorN.Respawn.
        local function TidalOnFloor(Root, Floor, HeightOverride)
            local Level = HeightOverride or TidalHeight[Floor]
            local _, Map = TidalMap()
            if not Root or not Level or not Map then
                return false, "Map/floor not loaded"
            end
            if math.abs(Root.Position.Y - Level) > 9 then
                return false, "Wrong height (" .. math.floor(Root.Position.Y) .. ")"
            end
            local RayParams = RaycastParams.new()
            RayParams.FilterType = Enum.RaycastFilterType.Include
            RayParams.FilterDescendantsInstances = {Map}
            RayParams.RespectCanCollide = true
            RayParams.IgnoreWater = true
            local Hit = workspace:Raycast(Root.Position + Vector3.new(0, 1.5, 0),
                Vector3.new(0, -12, 0), RayParams)
            if not Hit or Hit.Normal.Y < 0.55 then
                return false, "No solid floor under character"
            end
            if math.abs(Hit.Position.Y - Level) > 8
                or Root.Position.Y < Hit.Position.Y + 1.5
                or Root.Position.Y > Hit.Position.Y + 9
            then
                return false, "Not standing on floor surface"
            end
            return true, "Verified standing on floor"
        end

        -- Check the ground supporting the avatar, including ramps and the
        -- lower combat deck. Unlike FloorN.Respawn, this is actual geometry.
        -- Never treat an invisible marker, water/lava effect, or floor below
        -- the avatar by many studs as valid support.
        local function TidalSupportedGround(Root)
            local _, Map = TidalMap()
            if not Root or not Map then return nil end
            local Params = RaycastParams.new()
            Params.FilterType = Enum.RaycastFilterType.Include
            Params.FilterDescendantsInstances = {Map}
            Params.RespectCanCollide = true
            Params.IgnoreWater = true
            local Hit = workspace:Raycast(
                Root.Position + Vector3.new(0, 1.5, 0),
                Vector3.new(0, -14.5, 0), Params)
            if not Hit or not Hit.Instance or not Hit.Instance.CanCollide
                or Hit.Normal.Y < 0.55 then
                return nil
            end
            local Clearance = Root.Position.Y - Hit.Position.Y
            if Clearance < 1.1 or Clearance > 8.5 then return nil end
            return Hit
        end

        -- Test for a real solid underside above us. A marker position is NOT
        -- evidence of a walkable surface. This catches a character lodged
        -- just below a ceiling even when it is less than 11 studs from its
        -- last supported position or no last-safe record exists yet.
        local function TidalOverheadFloor(Root, Floor)
            local _, Map = TidalMap()
            if not Root or not Map then return nil end
            local Params = RaycastParams.new()
            Params.FilterType = Enum.RaycastFilterType.Include
            Params.FilterDescendantsInstances = {Map}
            Params.RespectCanCollide = true
            Params.IgnoreWater = true
            local Hit = workspace:Raycast(Root.Position + Vector3.new(0, 0.5, 0),
                Vector3.new(0, 29, 0), Params)
            if not Hit or not Hit.Instance or not Hit.Instance.CanCollide
                or Hit.Normal.Y > -0.55 then return nil end
            local GateY = TidalHeight[Floor]
            local CombatY = TidalCombatHeight(Floor)
            local PreviousY = TidalHeight[math.max(Floor - 1, 0)]
            if (GateY and math.abs(Hit.Position.Y - GateY) <= 11)
                or (CombatY and math.abs(Hit.Position.Y - CombatY) <= 11)
                or (PreviousY and math.abs(Hit.Position.Y - PreviousY) <= 11)
            then
                return Hit
            end
            return nil
        end

        -- A verified safe return point from the *current* stage. Use the real
        -- collidable map surface near the game's Respawn/EnemySpawns markers,
        -- never the non-collidable marker's CFrame. If a previous checkpoint
        -- vanished, this still lets a player escape from below the world.
        local function TidalRecoveryDestination(T, Root, Floor, PreferCurrent)
            local Saved = T.lastSafeCFrame
            -- If we are stuck against a ceiling belonging to the current
            -- floor, return to its actual platform instead of bouncing down
            -- to a previous floor and repeating the climb.
            if not PreferCurrent and Saved then
                local Old = TidalGroundGoal(Saved.Position, Root, true,
                    T.lastSafeFloor == Floor and Floor or nil)
                if Old then return Old, "last physically supported deck" end
            end
            local _, _, Markers = TidalMap()
            local Group = Markers and Markers:FindFirstChild("Floor" .. tostring(Floor))
            local Spawns = Group and Group:FindFirstChild("EnemySpawns")
            local EnemyPart = Spawns and Spawns:FindFirstChildWhichIsA("BasePart", true)
            if tostring(T.phase or ""):lower() == "fight" and EnemyPart then
                local Combat = TidalGroundGoal(EnemyPart.Position, Root, false, Floor)
                if Combat then return Combat, "current floor combat deck" end
            end
            local Marker = TidalFloorMarker(Floor)
            if Marker then
                local Landing = TidalGroundGoal(Marker.Position, Root, false, Floor)
                if Landing then return Landing, "verified current floor landing" end
            end
            if EnemyPart then
                local Combat = TidalGroundGoal(EnemyPart.Position, Root, false, Floor)
                if Combat then return Combat, "verified alternate combat deck" end
            end
            if PreferCurrent and Saved then
                local Old = TidalGroundGoal(Saved.Position, Root, true,
                    T.lastSafeFloor == Floor and Floor or nil)
                if Old then return Old, "last physically supported deck" end
            end
            return nil, "no verified floor surface found"
        end

        -- Recovery is an atomic character relocation ABOVE verified ground.
        -- Never try to Tween/Walk upward through a collidable ceiling: that is
        -- exactly how a character gets stuck underneath the roof/platform.
        -- The ordinary selected movement method resumes after grounding.
        local function TidalFallRecovery(T, Root, Floor)
            local Now = os.clock()
            local Support = TidalSupportedGround(Root)
            T.groundSupported = Support ~= nil
            T.groundPart = Support and Support.Instance:GetFullName() or nil
            if Support then
                T.lastSafeCFrame = Root.CFrame
                T.lastSafeFloor = Floor
                T.lastSafeAt = Now
                T.unsupportedSince = nil
                T.groundRecoveryState = "Supported on solid map geometry"
                T.recoveryTrigger = "none"
                return false
            end
            T.unsupportedSince = T.unsupportedSince or Now
            local LastSafe = T.lastSafeCFrame
            local Ceiling = TidalOverheadFloor(Root, Floor)
            T.overheadFloorPart = Ceiling and Ceiling.Instance:GetFullName() or nil
            local FallenFromSafe = LastSafe ~= nil
                and Root.Position.Y < LastSafe.Position.Y - 4
            -- Floor 10 deliberately has a lower enemy deck. A Tween or
            -- combat mover descending toward that deck is NOT an under-map
            -- fall until it actually passes below the combat surface.
            local CombatY = TidalCombatHeight(Floor)
            local GateY = TidalHeight[Floor]
            local CombatTransfer = CombatY and GateY
                and math.abs(CombatY - GateY) > 12
                and T.goal and math.abs(T.goal.Y - CombatY) < 12
                and Root.Position.Y >= CombatY - 1.5
                and Root.Position.Y <= GateY + 12
            if CombatTransfer then FallenFromSafe = false end
            local PreviousY = TidalHeight[math.max(Floor - 1, 0)]
            local DeepBelowLevel = Floor >= 1 and PreviousY ~= nil
                and Root.Position.Y < PreviousY - 12
            local UnderExpectedFloor = Ceiling ~= nil
                and Root.Position.Y < Ceiling.Position.Y - 1
            -- Some floors clip the root INSIDE the collision shell, so an
            -- upward ray cannot see the underside. When motion has stalled
            -- near the expected level without ground support, treat it as a
            -- failed landing instead of repeatedly fighting the collision.
            local NearFloor = (GateY and math.abs(Root.Position.Y - GateY) < 9)
                or (CombatY and math.abs(Root.Position.Y - CombatY) < 9)
            local StalledInFloor = NearFloor
                and Now - T.unsupportedSince > 1.2
                and Root.AssemblyLinearVelocity.Magnitude < 2.5
            -- An intentional move from Floor 10's gate to its lower
            -- combat/lever deck passes beneath the upper platform. Do NOT
            -- rescue the player back up while they are still traveling
            -- toward a verified lower-deck destination.
            local Trigger = (UnderExpectedFloor and not CombatTransfer)
                    and "solid floor directly overhead"
                or (StalledInFloor and not CombatTransfer)
                    and "stalled inside or against floor"
                or DeepBelowLevel and "far beneath prior level"
                or FallenFromSafe and "fell below last supported deck"
                or nil
            T.recoveryTrigger = Trigger or "unsupported; no trapped-floor evidence"
            if not Trigger
                or Now - T.unsupportedSince < 0.45
                or Now - (T.lastGroundRecoveryAt or 0) < 1.8
            then
                return false
            end
            local Safe, Source = TidalRecoveryDestination(T, Root, Floor,
                UnderExpectedFloor or StalledInFloor or DeepBelowLevel)
            if not Safe then
                T.groundRecoveryState = "Recovery paused: " .. Source
                T.goal = nil
                T.stage = T.groundRecoveryState
                return true -- Never keep following a bad below-map destination.
            end
            if GENV.__AZ_LEGIT_NAV then
                GENV.__AZ_LEGIT_NAV.Reset("Tidal below-map emergency re-entry")
            end
            T.tweenTravelActive = false
            local Ext = GENV.__AZ_FARM_EXT
            if Ext then Ext.SetTweenNoclipEnabled(false, true) end
            local Character = Root.Parent
            -- Extra clearance prevents the avatar's body from overlapping
            -- the floor on re-entry. CFrame/PivotTo is an instantaneous move,
            -- not a physical attempt to pass through the solid ceiling.
            local Destination = Safe + Vector3.new(0, 2.5, 0)
            if Character and Character:IsA("Model") then
                Character:PivotTo(Destination)
            else
                Root.CFrame = Destination
            end
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
            if Ext then Ext.SetTweenNoclipEnabled(false, true) end
            T.lastGroundRecoveryAt = Now
            T.recoveryCount = (T.recoveryCount or 0) + 1
            T.groundRecoveryState = "Moved above " .. Source .. "; confirming support"
            T.recoveryGraceUntil = Now + 0.8
            T.stage = "Underground recovery / " .. Source
            T.goal = Destination.Position
            return true
        end

        local TidalLeverCache = {Map = nil, Prompts = {}}
        local function TidalLever(Floor, RequireEnabled)
            local _, Map = TidalMap()
            if not Map then return nil, nil end
            local ExpectedY = TidalHeight[Floor]
            if not ExpectedY then return nil, nil end
            if TidalLeverCache.Map ~= Map then
                TidalLeverCache.Map = Map
                TidalLeverCache.Prompts = {}
                for _, Object in ipairs(Map:GetDescendants()) do
                    if Object:IsA("ProximityPrompt")
                        and Object.Name == "FloodLeverPrompt" then
                        table.insert(TidalLeverCache.Prompts, Object)
                    end
                end
            end
            -- Levers normally sit ~4 studs above the same floor's Respawn.
            -- On Floor 10 the *lever* is instead at Y~550, next to the
            -- combat deck (Y~546.5), while Respawn/gate is Y~585.5.
            -- Check BOTH valid deck elevations, not only the gate landing.
            local CombatY = TidalCombatHeight(Floor)
            local Best, BestPart, BestDiff = nil, nil, 18
            for _, Object in ipairs(TidalLeverCache.Prompts) do
                if Object.Parent and (RequireEnabled ~= true or Object.Enabled) then
                    local Parent = Object.Parent
                    local Part = Parent:IsA("BasePart") and Parent
                        or Parent:FindFirstChildWhichIsA("BasePart", true)
                    if Part then
                        local AtGate = math.abs(Part.Position.Y - ExpectedY - 4.5)
                        local AtCombat = CombatY and math.abs(Part.Position.Y - CombatY - 4.5)
                            or math.huge
                        local Delta = math.min(AtGate, AtCombat)
                        if Delta < BestDiff then
                            Best, BestPart, BestDiff = Object, Part, Delta
                        end
                    end
                end
            end
            return Best, BestPart
        end

        local function TidalClimbAnchor(Root, Floor, TargetFloor, Method)
            local _, Map = TidalMap()
            if not Map then return nil, "Map loading" end
            if TargetFloor == 1 and Root.Position.Y < 115 then
                local Parking = Map:FindFirstChild("PARKING_LOT")
                if Parking then
                    local A = Parking:FindFirstChild("PRK_LOT_RAMP_A")
                    local B = Parking:FindFirstChild("PRK_LOT_RAMP_B")
                    if Root.Position.Y < 35 and TidalPoint(A) then
                        return A.Position, "Parking ramp A"
                    elseif Root.Position.Y < 94 and TidalPoint(B) then
                        return B.Position, "Parking ramp B"
                    end
                end
            end
            -- Alternate the winding staircase at the halfway elevation
            -- between the current and next stage. Exact stair parts are
            -- discovered at runtime, not inferred from FloorNav (Y=-4).
            if Method ~= "Teleport" then
                local NextY = TidalHeight[TargetFloor]
                local Low = TidalHeight[math.max(TargetFloor - 1, 0)] or 0
                if NextY and Root.Position.Y < NextY - 15 then
                    local Best, BestScore
                    for _, Part in ipairs(Map:GetChildren()) do
                        if Part.Name == "STAIR_COLL" and Part:IsA("BasePart")
                            and Part.Position.Y > Low + 8
                            and Part.Position.Y < NextY - 6
                            and Root.Position.Y < Part.Position.Y + 1
                        then
                            local Vertical = math.abs(Part.Position.Y - (Low + NextY) / 2)
                            local Distance = (Vector3.new(Part.Position.X, 0, Part.Position.Z)
                                - Vector3.new(Root.Position.X, 0, Root.Position.Z)).Magnitude
                            local Score = Vertical + Distance * 0.025
                            if not BestScore or Score < BestScore then
                                Best, BestScore = Part, Score
                            end
                        end
                    end
                    if Best then return Best.Position, "Stair transition" end
                end
            end
            local Next = TidalFloorMarker(TargetFloor)
            if Next and Next:IsA("BasePart") then
                return Next.Position, TargetFloor >= 12
                    and "Rooftop entrance" or "Next floor landing"
            end
            return nil, "Next floor marker loading"
        end

        local function TidalMove(T, Root, Goal, DeltaTime, Label, Radius)
            if not Goal then
                T.tweenTravelActive = false
                T.stage = "No verified ground: " .. tostring(Label)
                T.goal = nil
                return false
            end
            local Method = Settings.FarmMethod
            if T.method ~= Method then
                T.method, T.lastMoveAt, T.lastGoal = Method, 0, nil
                if GENV.__AZ_LEGIT_NAV then
                    GENV.__AZ_LEGIT_NAV.Reset("Tidal movement method changed")
                end
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
            end
            T.goal = Goal.Position
            T.stage = tostring(Label) .. " (" .. tostring(Method) .. ")"
            local Distance = (Root.Position - Goal.Position).Magnitude
            local HorizontalDistance = (Vector3.new(Root.Position.X, 0, Root.Position.Z)
                - Vector3.new(Goal.Position.X, 0, Goal.Position.Z)).Magnitude
            local VerticalDistance = math.abs(Root.Position.Y - Goal.Position.Y)
            if HorizontalDistance <= (Radius or 5) and VerticalDistance <= 2.5 then
                T.tweenTravelActive = false
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
                if Method == "Legit" then
                    GENV.__AZ_LEGIT_NAV.Go(Goal, Radius or 5, "Tidal " .. Label)
                end
                if Method == "Tween" and GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
                return true
            end
            if Method == "Legit" then
                GENV.__AZ_LEGIT_NAV.Go(Goal, Radius or 5, "Tidal " .. Label)
            elseif Method == "Tween" then
                T.tweenTravelActive = true
                GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(true)
                local Speed = math.clamp(tonumber(Settings.TweenSpeed) or 95, 20, 250)
                local Fraction = math.clamp(Speed * math.clamp(DeltaTime or 0.016, 0, 0.1)
                    / math.max(Distance, 0.001), 0, 1)
                local Position = Root.Position:Lerp(Goal.Position, Fraction)
                Root.CFrame = CFrame.new(Position) * Goal.Rotation
                Root.AssemblyLinearVelocity = Vector3.zero
            else
                -- Only retrigger for a different destination or after the
                -- player leaves the destination; no per-frame CFrame spam.
                local Now = os.clock()
                if Now - (T.lastMoveAt or 0) >= 0.5 then
                    Root.CFrame = Goal
                    Root.AssemblyLinearVelocity = Vector3.zero
                    Root.AssemblyAngularVelocity = Vector3.zero
                    T.lastMoveAt = Now
                end
            end
            return false
        end

        local function TidalTryLever(T, Root, Prompt, Part)
            if not Prompt or not Part then return end
            local Now = os.clock()
            local MaxDist = math.max(tonumber(Prompt.MaxActivationDistance) or 10, 2)
            if (Root.Position - Part.Position).Magnitude > MaxDist + 1
                or Now - (T.lastLeverAt or 0) < 2.5
                or T.leverBusy
            then return end
            T.lastLeverAt = Now
            T.leverBusy = true
            T.stage = "Pulling lever (await server)"
            task.spawn(function()
                if type(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, Prompt)
                else
                    pcall(function()
                        Prompt:InputHoldBegin()
                        task.wait(math.max(tonumber(Prompt.HoldDuration) or 1, 0) + 0.15)
                        Prompt:InputHoldEnd()
                    end)
                end
                T.leverBusy = false
            end)
        end

        local function TidalReachRegisteredFloor(T, Root, Floor, DeltaTime)
            local OnFloor, Why = TidalOnFloor(Root, Floor)
            T.registeredFloor = OnFloor and Floor or nil
            T.floorReason = Why
            if OnFloor then
                return true
            end
            local FloorMarker = TidalFloorMarker(Floor)
            if not FloorMarker then
                T.stage = "Waiting for real floor " .. tostring(Floor) .. " landing marker"
                return false
            end
            local FloorGoal = TidalGroundGoal(FloorMarker.Position, Root, false, Floor)
            if not FloorGoal then
                T.stage = "Floor " .. tostring(Floor)
                    .. ": no confirmed landing surface; not using marker as ground"
                T.goal = nil
                return false
            end
            -- A floor marker is not physical ground. Landing selection is
            -- based on a collidable, upward-facing map raycast near that marker.
            -- Never fall back to a naked CFrame on a marker or gate barrier.
            -- Normal ascents may start down by the parking ramps. Use them for
            -- Legit/Tween, but never allow an objective before ground verifies.
            if Settings.FarmMethod ~= "Teleport"
                and Root.Position.Y < (TidalHeight[Floor] or 0) - 12 then
                local Point, Label = TidalClimbAnchor(Root, Floor - 1, Floor,
                    Settings.FarmMethod)
                if Point then
                    local Candidate = TidalGroundGoal(Point, Root)
                    if Candidate then
                        TidalMove(T, Root, Candidate, DeltaTime,
                            "Reach floor " .. Floor .. " / " .. Label, 3)
                        return false
                    end
                end
            end
            TidalMove(T, Root, FloorGoal, DeltaTime,
                "Stand on floor " .. tostring(Floor) .. " / " .. Why, 2.5)
            -- Don't report floor registration on a successful movement command;
            -- wait until the next heartbeat's physical floor raycast confirms it.
            return false
        end

        -- Reproject every Flood combat destination onto the active level's
        -- real geometry. Never use an enemy's Below offset under the map.
        GENV.__AZ_TIDAL_SAFE_COMBAT_GOAL = function(Pos, Root)
            local Level = workspace:GetAttribute("FloodRoof") == true and 12
                or math.clamp(math.floor(tonumber(workspace:GetAttribute("FloodFloor")) or 0), 0, 12)
            local Runtime = GENV.__AZ_TIDAL_RUNTIME
            if Runtime and Runtime.parkingCombatActive == true then
                Level = 0
            end
            return TidalGroundGoal(Pos, Root, false, Level)
        end

