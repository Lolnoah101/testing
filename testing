        end


        Rescue.IsInsideRaidArea = function(Root, Area)
            if not Root
                or not Area
                or not Area:IsA("BasePart")
            then
                return false
            end

            local LocalPosition =
                Area.CFrame:PointToObjectSpace(
                    Root.Position
                )

            local Half =
                Area.Size * 0.5

            return math.abs(LocalPosition.X) <= Half.X
                and math.abs(LocalPosition.Y) <= Half.Y
                and math.abs(LocalPosition.Z) <= Half.Z
        end


        --//========================================================
        --// EVIL REFLECTION / FATE RAID: REAL ARENA FLOOR
        --// The World.Areas volume is a tall trigger, not an actual floor.
        --// In the 2026-10-18 dungeon snapshot its center is around Y=303.53,
        --// while the broad circular platform is near Y=278-281. Never
        --// preserve a falling player's Y or use the trigger's center Y.
        --//========================================================
        Rescue.GetFateArenaGoal = function(Root, Area)
            if not Root or not Area or not Area:IsA("BasePart") then
                Rescue.FateGroundReason = "Missing character or arena trigger"
                return nil
            end

            local World = workspace:FindFirstChild("World")
            local Map = World and World:FindFirstChild("Map")
            if not Map then
                Rescue.FateGroundReason = "World.Map has not loaded"
                return nil
            end

            local Now = os.clock()
            local Cache = Rescue.FateGroundCache
            if Cache and Cache.Map == Map and Cache.Area == Area
                and Now < Cache.ValidUntil
            then
                Rescue.FateGroundReason = Cache.Reason
                Rescue.FateFloorPart = Cache.FloorPart
                return Cache.Goal
            end

            -- Restrict ground-probing to large solid surfaces in THIS map.
            -- This excludes tiny floating effects, props and the trigger part.
            local Surfaces = {}
            for _, Part in ipairs(Map:GetDescendants()) do
                if Part:IsA("BasePart")
                    and Part.CanCollide and Part.CanQuery
                    and Part.Size.X >= 35 and Part.Size.Z >= 35
                then
                    table.insert(Surfaces, Part)
                end
            end

            if #Surfaces == 0 then
                Rescue.FateGroundReason = "No solid arena-size floor parts"
                Rescue.FateGroundCache = {
                    Map = Map, Area = Area, Goal = nil,
                    FloorPart = nil, Reason = Rescue.FateGroundReason,
                    ValidUntil = Now + 1.5,
                }
                return nil
            end

            local Params = RaycastParams.new()
            Params.FilterType = Enum.RaycastFilterType.Include
            Params.FilterDescendantsInstances = Surfaces
            Params.RespectCanCollide = true
            Params.IgnoreWater = true

            local Offsets = {
                Vector3.new(0, 0, 0),
                Vector3.new(9, 0, 0),
                Vector3.new(-9, 0, 0),
                Vector3.new(0, 0, 9),
                Vector3.new(0, 0, -9),
                Vector3.new(16, 0, 0),
                Vector3.new(-16, 0, 0),
                Vector3.new(0, 0, 16),
                Vector3.new(0, 0, -16),
            }

            local Goal, FloorPart
            for _, Offset in ipairs(Offsets) do
                local Origin = Area.CFrame:PointToWorldSpace(
                    Vector3.new(Offset.X, Area.Size.Y * 0.5 + 22, Offset.Z)
                )
                local Hit = workspace:Raycast(
                    Origin,
                    Vector3.new(0, -(Area.Size.Y + 62), 0),
                    Params
                )

                if Hit then
                    local SurfacePoint = Hit.Position
                    local StandingPoint = SurfacePoint + Vector3.new(0, 3.2, 0)
                    local LocalPoint = Area.CFrame:PointToObjectSpace(StandingPoint)
                    local Half = Area.Size * 0.5
                    if math.abs(LocalPoint.X) <= Half.X - 4
                        and math.abs(LocalPoint.Z) <= Half.Z - 4
                        and math.abs(LocalPoint.Y) <= Half.Y + 1
                        and Hit.Normal.Y >= 0.55
                    then
                        Goal = CFrame.new(StandingPoint) * Root.CFrame.Rotation
                        FloorPart = Hit.Instance
                        break
                    end
                end
            end

            local Reason = Goal and "Verified solid arena floor"
                or "Arena floor raycast found no safe surface"
            Rescue.FateGroundReason = Reason
            Rescue.FateFloorPart = FloorPart
            Rescue.FateGroundCache = {
                Map = Map, Area = Area, Goal = Goal,
                FloorPart = FloorPart, Reason = Reason,
                ValidUntil = Now + (Goal and 2 or 1.5),
            }
            return Goal
        end

        --//========================================================
        --// FATE RAID PLATFORM ENTRY: TELEPORT / TWEEN / LEGIT
        --// Only fateraid uses this controller. The waves themselves are
        --// triggered by the game's normal platform presence detection.
        --// Legit uses the existing Humanoid/pathfinding mover; the other
        --// methods use the selected farm movement preference.
        --//========================================================
        Rescue.MoveFateEntry = function(Root, Goal, DeltaTime, Label, Radius)
            if not Root or typeof(Goal) ~= "CFrame" then return false end
            local Distance = (Root.Position - Goal.Position).Magnitude
            Radius = tonumber(Radius) or 3

            if Settings.FarmMethod == "Legit" then
                local Nav = GENV.__AZ_LEGIT_NAV
                if type(Nav) ~= "table" then return false end
                return Nav.Go(Goal, Radius, "Fate " .. tostring(Label or "Platform"))
            end

            if Distance <= Radius then
                if Settings.FarmMethod == "Tween" then
                    local Ext = GENV.__AZ_FARM_EXT
                    if Ext and type(Ext.SetTweenNoclipEnabled) == "function" then
                        Ext.SetTweenNoclipEnabled(false)
                    end
                end
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
                return true
            end

            if Settings.FarmMethod == "Tween" then
                local Ext = GENV.__AZ_FARM_EXT
                if Ext and type(Ext.SetTweenNoclipEnabled) == "function" then
                    Ext.SetTweenNoclipEnabled(true)
                end
                -- Center/next-wave calls sometimes run on a throttled
                -- route check rather than each movement heartbeat.
                local Now = os.clock()
                local Elapsed = Now - (Rescue.FateLastMoveAt or (Now - 0.016))
                Rescue.FateLastMoveAt = Now
                local dt = math.clamp(tonumber(DeltaTime) or Elapsed, 0.001, 0.075)
                local Speed = math.max(1, tonumber(Settings.TweenSpeed) or 95)
                local Alpha = math.min(1, Speed * dt / math.max(Distance, 0.001))
                Root.CFrame = Root.CFrame:Lerp(Goal, Alpha)
            else
                -- Teleport is intentionally immediate, directly onto the
                -- raycast-confirmed floor, never the elevated trigger center.
                Root.CFrame = Goal
            end
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
            return (Root.Position - Goal.Position).Magnitude <= Radius
        end

        Rescue.HandleFateEntry = function(Root, Area, DeltaTime)
            if workspace:GetAttribute("Mode") ~= "fateraid"
                or not Root or not Area
            then
                return false
            end
            local World = workspace:FindFirstChild("World")
            local Floor = Rescue.GetFateArenaGoal(Root, Area)
            if not Floor then
                Rescue.RaidState = "Fate: waiting for verified platform floor"
                return true
            end

            local F = Rescue.FateEntry
            if not F or F.World ~= World or F.Character ~= Root.Parent then
                F = {
                    World = World, Character = Root.Parent,
                    Step = 1, Complete = false,
                    ArrivedAt = nil, Method = Settings.FarmMethod,
                    State = "Starting", Goal = nil,
                }
                Rescue.FateEntry = F
            end
            if F.Method ~= Settings.FarmMethod then
                F.Method = Settings.FarmMethod
                -- Keep progress when changing movement method mid-route.
                F.State = "Switched to " .. tostring(F.Method)
            end

            local Here = Root.Position
            local Center = Floor.Position
            local Horizontal = (Vector3.new(Here.X, 0, Here.Z)
                - Vector3.new(Center.X, 0, Center.Z)).Magnitude
            local OnPlatform = Rescue.IsInsideRaidArea(Root, Area)
                and math.abs(Here.Y - Center.Y) <= 8
                and Horizontal <= 86
            local Wave = tonumber(ReadRunValue2("wave")) or 0
            local Remaining = tonumber(ReadRunValue2("remaining")) or 0
            local WaveStarted = ReadRunValue2("waveStartedAt") ~= nil
                or (Wave > 0 and Remaining > 0)

            if OnPlatform and WaveStarted then
                F.Complete = true
                F.State = "Waves active; combat owns movement"
                Rescue.RaidState = F.State
                return false
            end
            if F.Complete then
                -- Do not steal movement from combat merely because it moves
                -- towards an enemy near the arena's edge. Only recover when
                -- the player actually drops beneath the raised platform.
                if Here.Y >= Center.Y - 10
                    or ReadRunValue2("finishedAt") ~= nil
                then
                    return false
                end
                F.Complete = false
                F.Step = 4
                F.State = "Recovering fallen character"
                F.ArrivedAt = nil
            end

            -- Legit and Tween use the map's three-height stair/corridor
            -- route. Markers are used as height/position references only;
            -- pathfinding still verifies walkability for Legit.
            -- Avoid relying on a hardcoded instance hierarchy beyond the
            -- game-provided World.Navigation marker folder.
            local Navigation = World and World:FindFirstChild("Navigation")
            local function NavPoint(Name, Fallback)
                local Marker = Navigation and Navigation:FindFirstChild(Name)
                if Marker and Marker:IsA("BasePart") then
                    return Marker.Position + Vector3.new(0, 2.8, 0)
                end
                return Fallback
            end
            local function MidPoint(A, B, Fallback)
                local PA = Navigation and Navigation:FindFirstChild(A)
                local PB = Navigation and Navigation:FindFirstChild(B)
                if PA and PB and PA:IsA("BasePart") and PB:IsA("BasePart") then
                    return (PA.Position + PB.Position) * 0.5 + Vector3.new(0, 2.8, 0)
                end
                return Fallback
            end
            local Checkpoints = {
                { Name = "Lower stair landing",
                  Position = NavPoint("nav247", Vector3.new(72, 252.8, -384)) },
                { Name = "Raised corridor",
                  Position = MidPoint("nav205", "nav206", Vector3.new(62, 267.8, -341)) },
                { Name = "Platform stair approach",
                  Position = MidPoint("nav173", "nav174", Vector3.new(62, 267.8, -293)) },
                { Name = "Activation platform", Position = Center },
            }

            if Settings.FarmMethod == "Teleport" then
                F.Step = 4
            else
                -- If the route starts mid-way (respawn, method swap, or
                -- a manual move), skip checkpoints already clearly behind us.
                if F.Step == 1 and Here.Z > -378 and Here.Y >= 246 then
                    F.Step = 2
                end
                if F.Step == 2 and Here.Z > -335 and Here.Y >= 261 then
                    F.Step = 3
                end
                if F.Step == 3 and Here.Z > -287 and Here.Y >= 262 then
                    F.Step = 4
                end
            end

            local Step = math.clamp(F.Step, 1, #Checkpoints)
            local Current = Checkpoints[Step]
            F.Goal = Current.Position
            local Goal = CFrame.new(Current.Position) * Root.CFrame.Rotation
            local Radius = Step == 4 and 3.5 or 6.0
            local Arrived = Rescue.MoveFateEntry(
                Root, Goal, DeltaTime, Current.Name, Radius
            )

            if Arrived then
                if Step < #Checkpoints then
                    F.Step = Step + 1
                    F.State = "Reached " .. Current.Name
                else
                    F.ArrivedAt = F.ArrivedAt or os.clock()
                    F.State = "On platform; waiting for automatic wave start"
                end
            else
                F.State = "Going to " .. Current.Name
                    .. " (" .. tostring(Settings.FarmMethod) .. ")"
            end
            Rescue.RaidState = F.State
            return true
        end

