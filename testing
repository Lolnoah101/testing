    local function spareInventory(data)
        local groups, entries, total = {}, {}, 0
        local ownedArmor = type(data.OwnedArmor) == "table" and data.OwnedArmor or {}
        for _, id in pairs(ownedArmor) do
            if type(id) == "string" then
                groups[id] = (groups[id] or 0) + 1
            end
