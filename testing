local function GetSkillProcessingTime(
    CharacterName,
    SkillNumber
)

    local Config =
        CharacterConstants
            .charactersByName[
                CharacterName
            ]


    if not Config
        or not Config.skills
        or not Config.skills[
            SkillNumber
        ]
    then

        return nil
    end


    return Config
        .skills[
            SkillNumber
        ]
        .processingTime
end


local function TrySkill(
    SkillNumber
)

    if not IsAlive()
        or not GENV.__AZ_FARM_EXT.IsRunActive()
        or not GetNearbyEnemy()
    then

        return false
    end


    local Store =
        GetPlayerStore()


    if not Store
        or IsBlocking(Store)
        or HasActiveStun(Store, true)
        or GENV.__AZ_FARM_EXT.IsLocalClientBusy()
    then

        return false
    end


    local Now =
        workspace:GetServerTimeNow()


    if Settings.SkillMethod == "Use Skill Keys" then
        local CooldownOK, Effective, CharName = SkillCooldownReady(Store, SkillNumber)
        local CharacterInfo = CharName and CharacterConstants.charactersByName[CharName]
        if not CooldownOK or not Effective or not CharacterInfo
            or not CharacterInfo.skills or not CharacterInfo.skills[Effective] then
            return false
        end
        if Effective == 4 then
            local Good, Progress = pcall(function()
                return Store.state.ultProgress:get()
            end)
            if not Good or (tonumber(Progress) or 0) < 100
                or LocalPlayer:GetAttribute("UltimateLocked") == true then
                return false
            end
        end
        -- G is the normal Ultimate binding; native controller handles a
        -- temporary bonus Ultimate on G when that window is available.
        return GENV.__AZ_SEND_SKILL_KEY(SkillNumber)
    end

    if PendingSkillRequestId then

        if Now >= PendingSkillExpiresAt then

            PendingSkillRequestId =
                nil

        else

            return false
        end
    end


    if Now < SkillBusyUntil
        or Now < SkillRetryAfter
    then

        return false
    end


    local CooldownReadyNow,
        EffectiveSkill,
        CharacterName =
        SkillCooldownReady(
            Store,
            SkillNumber
        )


    if not CooldownReadyNow
        or not EffectiveSkill
        or not CharacterName
    then

        return false
    end

    -- Do not request slots missing from this character's current moveset.
    local CharacterInfo = CharacterConstants.charactersByName[CharacterName]
    if not CharacterInfo or not CharacterInfo.skills
        or not CharacterInfo.skills[EffectiveSkill]
    then
        return false
    end

    if EffectiveSkill == 4 then

        local Success,
            Progress =
            pcall(function()

                return Store
                    .state
                    .ultProgress
                    :get()
            end)


        if not Success
            or not Progress
            or Progress < 100
            or LocalPlayer:GetAttribute("UltimateLocked") == true
        then

            return false
        end
    end


    local Character =
        GetCharacter()


    if not Character then
        return false
    end


    SkillSequence =
        (SkillSequence % 4294967295) + 1


    local RequestId =
        SkillSequence


    local Expires =
        Now + 1


    local Request = {

        id =
            RequestId,

        char =
            CharacterName,

        character =
            Character,

        skill =
            EffectiveSkill,

        expiresAt =
            Expires,
    }


    PendingSkillRequestId =
        RequestId
    GENV.__AZ_FARM_EXT.LastSkillSentAt = Now
    GENV.__AZ_FARM_EXT.LastSkillSentSlot = EffectiveSkill
    GENV.__AZ_FARM_EXT.LastSkillSentRequestId = RequestId

    PendingSkillExpiresAt =
        Expires


    if EffectiveSkill < 4 then

        local Processing =
            GetSkillProcessingTime(
                CharacterName,
                EffectiveSkill
            )


        if Processing then

            SkillBusyUntil =
                Now
                + Processing
        end
    end


    local Success,
        ErrorMessage =
        pcall(function()

            CharacterPackets
                .performSkill
                :fire(
                    Request
                )
        end)


    if not Success then

        PendingSkillRequestId =
            nil


        SkillBusyUntil =
            0


        SkillRetryAfter =
            Now
            + SKILL_REJECT_BACKOFF


        GENV.__AZ_FARM_EXT.LastSkillError =
            tostring(
                ErrorMessage
            )


        return false
    end

    if SkillNumber == 4 then
        GENV.__AZ_FARM_EXT.LastUltimateRequestSlot = EffectiveSkill
        GENV.__AZ_FARM_EXT.LastUltimateRequestAt = Now
    end

    return true
end

pcall(function()

    CharacterPackets
        .skillPerformed
        :on(function(Data)

            if not Data
                or Data.player
                    ~= LocalPlayer
            then

                return
            end


            PendingSkillRequestId =
                nil

            GENV.__AZ_FARM_EXT.LastSkillResponseAt = workspace:GetServerTimeNow()
            GENV.__AZ_FARM_EXT.LastSkillResponseAccepted = Data.accepted
            GENV.__AZ_FARM_EXT.LastSkillResponseReason = tostring(Data.reason or Data.error or "not provided")

            if Data.accepted == false then

                SkillBusyUntil =
                    0


                SkillRetryAfter =
                    workspace:GetServerTimeNow()
                    + SKILL_REJECT_BACKOFF


                return
            end


            SkillRetryAfter =
                0


            if Data.processingTill then

                SkillBusyUntil =
                    Data.processingTill

            else

                SkillBusyUntil =
                    workspace:GetServerTimeNow()
            end
        end)
end)




