function Systems.setUIValue(flag, value, persistChange)
    local controls =
        Systems.UIControls

    local control =
        controls
        and controls[flag]

    if not control
        or type(control.Set) ~= "function" then
        return false
    end

    local current =
        control.value

    if type(current) == "table"
        and #current == 1 then
        current = current[1]
    end

    if current == value then
        return true
    end

    local ok = pcall(function()
        -- Rayfield Gen2's second Set argument is skipCallback.
        -- When persistChange is true, let Rayfield run the callback and
        -- autosave so internally changed toggles stay correct next launch.
        control:Set(
            value,
            persistChange ~= true
        )
    end)

    return ok
end

