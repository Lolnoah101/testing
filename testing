end
local function refreshWeeklySpeedUsed()
    local w=weekUTC()
    if S.speedWeek ~= w then
        S.speedWeek=w
        S.speedUsed={}
        savePreferences()
    end
end
local function hasUsedSpeedCharacter(name)
    if S.speedUsed[name] then return true end
    local gui=player:FindFirstChildOfClass("PlayerGui")
    local slot=gui and gui:FindFirstChild("SpeedRaidCharacterInventoryScrollingFrame", true)
    slot=slot and slot:FindFirstChild(name)
    local picture=slot and slot:FindFirstChild("CharacterImage")
    return picture and picture:IsA("ImageLabel") and picture.ImageTransparency >= .8 or false
end
local function selectSpeedCharacter()
    local owned,complete=collectedCharacters()
    -- Never mark all characters used for the week when ONLY the currently
    -- equipped slots have loaded; wait for the native full collection.
    if not owned or not complete then return nil,"Characters not loaded" end
    local settings=getSettings()
    local cfg=settings and settings.CharacterSettings or {}
    refreshWeeklySpeedUsed()
    if S.speedCharacterChoice ~= "Auto — Next Unused" then
        local name=S.speedCharacterChoice
        if not owned[name] or not cfg[name] then return nil,"Selected character is not owned" end
        if hasUsedSpeedCharacter(name) then return nil,"Selected character already used this week" end
        return name
    end
    local ranked={}
    for name in pairs(owned) do
        if cfg[name] and not hasUsedSpeedCharacter(name) then
            ranked[#ranked+1]=name
        end
    end
    table.sort(ranked,function(a,b)
        local av=tonumber(cfg[a].collectionRankValue) or 0
        local bv=tonumber(cfg[b].collectionRankValue) or 0
        return av==bv and a<b or av>bv
    end)
    if #ranked==0 then return nil,"All owned Speed Raid characters have been used this week" end
    return ranked[1]
end
local function speedReady()
    local previous=stat("ShadowRaidTimer")
    if type(previous)~="number" then return false end
    local settings=getSettings()
    local duration=settings and settings.GameSettings and settings.GameSettings.ShadowRaidTimer or 1800
    -- Server time data, when available, is more reliable than local UTC.
    local now=os.time()
    local gui=player:FindFirstChildOfClass("PlayerGui")
    local modules=gui and gui:FindFirstChild("Modules")
    local inst=modules and modules:FindFirstChild("ClientDataModule")
    if inst then
        local ok,m=pcall(require,inst)
        if ok and type(m)=="table" and type(m.returnData)=="function" then
            local success,value=pcall(m.returnData,"ostime")
            if success and type(value)=="number" and value>0 then now=value end
        end
    end
    return now-previous >= duration
end

local rotationCache, rotationExpires = nil, 0
local function raidRotation()
    if os.clock()<rotationExpires then return rotationCache end
    rotationExpires=os.clock()+45
    local response=invokeRoom("GetRotationRaidsInfo")
    if type(response)~="table" then rotationCache={};return rotationCache end
    rotationCache={}
    for _,row in pairs(response) do
        if type(row)=="table" and type(row.mapName)=="string"
            and (tonumber(row.expiration) or 0)>0 then
            rotationCache[row.mapName]=true
        end
    end
    return rotationCache
end
local function raidMapAvailable(id, info)
    if type(info)~="table" or info.isRaid~=true or info.isShadowRaid==true
        or type(info.difficulties)~="table" then return false end
    local now=Workspace:GetServerTimeNow()
    if info.endTime and tonumber(info.endTime) and tonumber(info.endTime)<=now then
        return raidRotation()[id]==true
    end
    if info.excludeFromList then return raidRotation()[id]==true end
    return true
end
local function raidMapOptions()
    local opts={"Hardest"}
    local mappings={}
    local settings=getSettings()
    local maps=settings and settings.MapInfo or {}
    local entries={}
    for id,info in pairs(maps) do
        if type(info)=="table" and info.isRaid and not info.isShadowRaid then
            entries[#entries+1]={id=id,info=info,lvl=mapLevel(info)}
        end
    end
    table.sort(entries,function(a,b)
        local aa=tonumber(a.info.order) or 0
        local bb=tonumber(b.info.order) or 0
        return aa==bb and a.id<b.id or aa<bb
    end)
    for _,v in ipairs(entries) do
        local label=tostring(v.info.displayName or v.id).." (Lv "..tostring(v.lvl)..")"
        if mappings[label] then label=label.." — "..v.id end
        mappings[label]=v.id
        opts[#opts+1]=label
    end
    return opts,mappings
end
-- The config's `order` is a *menu position*, not raid strength.  For
-- example, Titan Raid is order 2 (Lv50), while Divine Guardian Raid is
-- order -1000 (Lv100).  "Hardest" must compare the difficulty that the
-- player can actually enter, not the UI display order.
S.bestUnlockedRaidRequirement = function(info, level)
    if type(info) ~= "table" or type(info.difficulties) ~= "table" then return nil end
    local bestReq, bestDifficultyOrder = nil, -math.huge
    for name, difficulty in pairs(info.difficulties) do
        if type(difficulty) == "table" then
            local req = tonumber(difficulty.levelReq)
            local difficultyOrder = tonumber(difficulty.order) or 0
            if req and req <= level
                and (S.raidDifficultyChoice == "Hardest" or S.raidDifficultyChoice == name)
                and (not bestReq or req > bestReq
                    or (req == bestReq and difficultyOrder > bestDifficultyOrder)) then
                bestReq, bestDifficultyOrder = req, difficultyOrder
            end
        end
    end
    return bestReq, bestDifficultyOrder
end
local function chooseRaid(level)
    local settings=getSettings()
    local maps=settings and settings.MapInfo or {}
    if S.raidMapChoice~="Hardest" then
        local entry=maps[S.raidMapChoice]
        if raidMapAvailable(S.raidMapChoice,entry)
            and S.bestUnlockedRaidRequirement(entry,level) then
            return S.raidMapChoice
        end
        return nil
    end
    local best,bestLevel,bestDifficultyOrder,bestMapOrder=nil,-math.huge,-math.huge,-math.huge
    for id,info in pairs(maps) do
        if raidMapAvailable(id,info) then
            local req, difficultyOrder = S.bestUnlockedRaidRequirement(info,level)
            local mapOrder = tonumber(info.order) or 0
            if req and (req>bestLevel
                or (req==bestLevel and difficultyOrder>bestDifficultyOrder)
                or (req==bestLevel and difficultyOrder==bestDifficultyOrder
                    and mapOrder>bestMapOrder)) then
                best,bestLevel,bestDifficultyOrder,bestMapOrder=
                    id,req,difficultyOrder,mapOrder
            end
        end
    end
    return best
end
local function raidDifficulties(id)
    local opts={"Hardest"}
    local settings=getSettings()
    local info=settings and settings.MapInfo and settings.MapInfo[id]
    local arr={}
    if info and type(info.difficulties)=="table" then
        for name,cfg in pairs(info.difficulties) do
            arr[#arr+1]={name=name,order=tonumber(cfg.order) or 0}
        end
    end
    table.sort(arr,function(a,b) return a.order<b.order end)
    for _,row in ipairs(arr) do opts[#opts+1]=row.name end
    return opts
end
local function chooseRaidDifficulty(id,level)
    local settings=getSettings()
    local info=settings and settings.MapInfo and settings.MapInfo[id]
    if not (info and type(info.difficulties)=="table") then return nil end
    if S.raidDifficultyChoice~="Hardest" then
        local d=info.difficulties[S.raidDifficultyChoice]
        if d and level >= (tonumber(d.levelReq) or math.huge) then
            return S.raidDifficultyChoice
        end
        return nil
    end
    local best,bestLv,bestOrder=nil,-math.huge,-math.huge
    for name,d in pairs(info.difficulties) do
        local lv=tonumber(d.levelReq) or math.huge
        local order=tonumber(d.order) or 0
        if lv<=level and (lv>bestLv or (lv==bestLv and order>bestOrder)) then
            best,bestLv,bestOrder=name,lv,order
        end
    end
    return best
end

local specialFailureUntil={}
local function modeRequest(action,argument,mode)
    if not S.alive or not statsReady() then return false end
    if os.clock() < (specialFailureUntil[mode] or 0) then return false end
    -- Certain native teleport calls return nil even on success.
    -- An explicit Fail is a rejection; nil is treated as pending, never
    -- repeatedly called inside the teleport window.
    if not mainFunction then return false end
    local initialWorkerGeneration=S.specialWorkerGeneration
    local ok,res=pcall(function()
        if argument==nil then return mainFunction:InvokeServer(action) end
        return mainFunction:InvokeServer(action,argument)
    end)
    -- A hung invocation may finish after its 35-second watchdog cancelled
    -- that scheduler worker. Never let the stale completion overwrite intent.
    if initialWorkerGeneration ~= S.specialWorkerGeneration then return false end
    if not ok or type(res)=="table" and res.status=="Fail" then
        local reason=tostring(ok and res and res.message or res)
        if mode=="BossRush" and S.bossRushTicketRejection(reason) then
            S.bossTicketUnavailableSnapshot=S.bossRushEntrySnapshot()
            S.bossTicketUnavailableUntil=os.clock()+300
            specialFailureUntil.BossRush=os.clock()+300
            -- This is a normal eligibility failure, not an Auto Start error.
            warnOnce("Boss Rush skipped (no ticket/free entry); trying the next enabled mode")
        else
            warnOnce(mode..": "..reason)
            specialFailureUntil[mode]=os.clock()+45
        end
        return false, reason
    end
    -- Boss Rush is unusual: unlike some teleport remotes, its native UI
    -- explicitly indexes response.status. A nil response is not confirmed
    -- entry and must not reserve the scheduler for 45 seconds.
    if mode=="BossRush" and type(res)~="table" then
        specialFailureUntil.BossRush=os.clock()+45
        warnOnce("Boss Rush did not return an entry response")
        return false, "No Boss Rush entry response"
    end
    S.modeIntent=mode
    S.modeFromPlace=game.PlaceId
    S.modeFromJobId=game.JobId
    S.modeRequestAt=os.time()
    savePreferences()
    return true
end
-- Keep a complete, last-known-good character setup.  Speed Raid changes the
-- active character on entry, which can cause the game to clear an assist slot.
-- We never overwrite a healthy backup with partially-loaded / empty stats.
local function isEquippedName(name)
    return type(name)=="string" and name~="" and name~="None" and name~="nil"
end
local function preferredLoadoutValid()
    local p=S.preferredLoadout
    return type(p)=="table" and isEquippedName(p.main)
        and isEquippedName(p.assist1) and isEquippedName(p.assist2)
        and p.main~=p.assist1 and p.main~=p.assist2 and p.assist1~=p.assist2
end
local function preferredLoadoutMatches()
    local p=S.preferredLoadout
    return preferredLoadoutValid()
        and stat("CharacterName")==p.main
        and stat("AssistCharacterName1")==p.assist1
        and stat("AssistCharacterName2")==p.assist2
end
local function rememberEquippedLoadout()
    if not regularLobby() or not statsReady() or S.speedRestorePending then return end
    -- When a preferred preset exists, it is authoritative. NEVER capture a
    -- temporary or incorrectly restored main/assist as the new saved backup.
    if S.autoEquipLoadout and preferredLoadoutValid() then
        local p=S.preferredLoadout
        local old=S.savedLoadout or {}
        if old.main~=p.main or old.assist1~=p.assist1 or old.assist2~=p.assist2 then
            S.savedLoadout={main=p.main,assist1=p.assist1,assist2=p.assist2}
            savePreferences()
        end
        return
    end
    if S.speedPendingCharacter~="" or S.modeIntent=="SpeedRaid" then return end
    local main, a1, a2 = stat("CharacterName"), stat("AssistCharacterName1"), stat("AssistCharacterName2")
    if not (isEquippedName(main) and isEquippedName(a1) and isEquippedName(a2)) then return end
    -- An assist cannot be the active main character or the other assist.
    if main==a1 or main==a2 or a1==a2 then return end
    local old=S.savedLoadout or {}
    if old.main~=main or old.assist1~=a1 or old.assist2~=a2 then
        S.savedLoadout={main=main,assist1=a1,assist2=a2}
        savePreferences()
    end
end
local function saveOriginalSpeedCharacter()
    if S.autoEquipLoadout and preferredLoadoutValid() then
        local p=S.preferredLoadout
        S.savedLoadout={main=p.main,assist1=p.assist1,assist2=p.assist2}
    else
        rememberEquippedLoadout() -- best-effort fallback if no explicit preset
    end
    if S.speedRestorePending and isEquippedName(S.speedOriginalCharacter) then return end
    S.speedRestoreLobbyEpoch = 0 -- begin timeout only after we reach the lobby
    local main=(S.autoEquipLoadout and preferredLoadoutValid())
        and S.preferredLoadout.main or stat("CharacterName")
    if isEquippedName(main) then
        S.speedOriginalCharacter=main
        S.speedRestorePending=true
        S.loadoutRestoreAttempts=0
        savePreferences()
    end
end

-- Server returns may precede replicated stat changes. Never clear pending just
-- because InvokeServer succeeded; confirm each slot via the actual stats.
local function equipSavedSlot(name, slot)
    if not mainFunction or not isEquippedName(name) then return false end
    local ok,res=pcall(function()
        if slot==0 then return mainFunction:InvokeServer("EquipCharacter",name) end
        return mainFunction:InvokeServer("EquipCharacterAssist",name,slot)
    end)
    if not ok or type(res)=="table" and res.status=="Fail" then
        warnOnce("Loadout restore: "..tostring(ok and res and res.message or res))
        return false
    end
    return true -- request made; next tick must verify the replicated slot
end
local function restoreSpeedCharacter()
    if not S.speedRestorePending or not regularLobby() or not statsReady() then return end
    -- A queued Speed Raid is still in the source lobby until teleport starts.
    -- NEVER equip the saved main during that window; the temporary selection
    -- must be allowed to complete. Returning from battle has a different JobId
    -- or the persisted modeWasInBattle flag, so restoration can then begin.
    if S.modeIntent=="SpeedRaid" and not S.modeWasInBattle
        and S.modeFromJobId==game.JobId
        and os.time()-(tonumber(S.modeRequestAt) or 0)<45 then return end
    -- Some characters do not replicate equip/assist stats after a Speed Raid.
    -- Those nil stats previously caused an unconditional return every 2s,
    -- permanently blocking every other mode. Bound this state across reloads.
    if (tonumber(S.speedRestoreLobbyEpoch) or 0) <= 0 then
        S.speedRestoreLobbyEpoch=os.time()
        savePreferences()
    end
    if os.time() - S.speedRestoreLobbyEpoch >= 28 then
        S.speedRestorePending=false
        S.speedRestoreLobbyEpoch=0
        S.speedOriginalCharacter=""
        S.speedPendingCharacter=""
        S.loadoutRestoreAttempts=0
        savePreferences()
        warnOnce("Speed Raid loadout could not be fully restored; scheduler resumed. Check assists before Boss Rush.")
        return
    end
    if os.clock()-S.lastLoadoutRepairAt<1.0 then return end
    local saved=(S.autoEquipLoadout and preferredLoadoutValid())
        and S.preferredLoadout or (type(S.savedLoadout)=="table" and S.savedLoadout or {})
    local wantedMain=(S.autoEquipLoadout and preferredLoadoutValid())
        and saved.main or (isEquippedName(S.speedOriginalCharacter) and S.speedOriginalCharacter or saved.main)
    local currentMain=stat("CharacterName")
    if currentMain==nil then return end -- player data not fully replicated yet
    local missingSlot, wantedName=nil,nil
    if isEquippedName(wantedMain) and currentMain~=wantedMain then
        missingSlot,wantedName=0,wantedMain
    else
        local currentA1,currentA2=stat("AssistCharacterName1"),stat("AssistCharacterName2")
        if currentA1==nil or currentA2==nil then return end
        if isEquippedName(saved.assist1) and currentA1~=saved.assist1 then
            missingSlot,wantedName=1,saved.assist1
        elseif isEquippedName(saved.assist2) and currentA2~=saved.assist2 then
            missingSlot,wantedName=2,saved.assist2
        end
    end
    if missingSlot==nil then
        S.speedRestorePending=false
        S.speedRestoreLobbyEpoch=0
        S.speedOriginalCharacter=""
        S.speedPendingCharacter=""
        S.loadoutRestoreAttempts=0
        savePreferences()
        return
    end
    S.lastLoadoutRepairAt=os.clock()
    S.loadoutRestoreAttempts=(S.loadoutRestoreAttempts or 0)+1
    equipSavedSlot(wantedName,missingSlot)
    if S.loadoutRestoreAttempts>=12 then
        -- Fail open for the rest of the scheduler so a bad/removed character
        -- cannot stall every other mode indefinitely.
        warnOnce("Could not fully restore Speed Raid loadout; check owned characters/assist slots")
        S.speedRestorePending=false
        S.speedRestoreLobbyEpoch=0
        S.speedOriginalCharacter=""
        S.speedPendingCharacter="" -- stale pending character must not block Auto Equip
        S.loadoutRestoreAttempts=0
        savePreferences()
    end
end
-- When a Speed Raid has cleared an assist and Boss Rush is selected, restore
-- the recorded slot before trying to enter. No guessing if no valid backup.
local function repairMissingBossRushAssists()
    if not regularLobby() or not statsReady() then return false end
    local saved=(S.autoEquipLoadout and preferredLoadoutValid())
        and S.preferredLoadout or (type(S.savedLoadout)=="table" and S.savedLoadout or {})
    local a1,a2=stat("AssistCharacterName1"),stat("AssistCharacterName2")
    if a1==nil or a2==nil then return false end
    local missingSlot,wantedName=nil,nil
    if not isEquippedName(a1) and isEquippedName(saved.assist1) then
        missingSlot,wantedName=1,saved.assist1
    elseif not isEquippedName(a2) and isEquippedName(saved.assist2) then
        missingSlot,wantedName=2,saved.assist2
    end
    if not missingSlot then return false end
    if os.clock() < S.bossRepairPauseUntil then return false end
    if os.clock()-S.lastLoadoutRepairAt<1.2 then return true end
    S.lastLoadoutRepairAt=os.clock()
    S.bossRepairAttempts=(S.bossRepairAttempts or 0)+1
    equipSavedSlot(wantedName,missingSlot)
    if S.bossRepairAttempts>=8 then
        S.bossRepairAttempts=0
        S.bossRepairPauseUntil=os.clock()+60
        warnOnce("Boss Rush: saved assist restore failed repeatedly; pausing 60 seconds")
        return false -- let lower-priority modes run instead of blocking
    end
    return true -- allow replicated stats to update before any teleport
end
-- Permanent preset reconciler. This runs in the *regular lobby only*.
-- It never changes a Speed Raid's chosen temporary character in battle and
-- never replaces the user's preferred dropdown selections with live stats.
local function autoEquipPreferredLoadoutTick()
    if not S.autoEquipLoadout or not regularLobby() or not statsReady() then return end
    if not preferredLoadoutValid() then
        warnOnce("Auto Equip Loadout: choose three DIFFERENT owned characters first")
        return
    end
    -- Do not fight the Speed Raid character-selection/teleport transition.
    if S.speedRestorePending or S.speedPendingCharacter~=""
        or S.modeIntent=="SpeedRaid" or S.lobbyBusy or S.createdOwnRoom then return end
    local p=S.preferredLoadout
    local now=os.clock()
    if preferredLoadoutMatches() then
        S.loadoutEquipAttempts=0
        S.loadoutRetryAfter=0
        S.loadoutPriorityHoldUntil=0
        return
    end
    if now < (S.loadoutRetryAfter or 0)
        or now-S.lastLoadoutRepairAt < 1.2 then return end
    local owned=collectedCharacters()
    if not owned then return end
    if not (owned[p.main] and owned[p.assist1] and owned[p.assist2]) then
        S.loadoutRetryAfter=now+45
        warnOnce("Auto Equip Loadout: a selected character is no longer in the owned collection")
        return
    end
    local currentMain=stat("CharacterName")
    local a1=stat("AssistCharacterName1")
    local a2=stat("AssistCharacterName2")
    if currentMain==nil or a1==nil or a2==nil then return end
    local slot,name
    -- Main first; the game's equip actions can affect existing assist slots.
    if currentMain~=p.main then slot,name=0,p.main
    elseif a1~=p.assist1 then slot,name=1,p.assist1
    elseif a2~=p.assist2 then slot,name=2,p.assist2
    else return end
    S.lastLoadoutRepairAt=now
    local requested=equipSavedSlot(name,slot)
    S.loadoutEquipAttempts=(S.loadoutEquipAttempts or 0)+1
    if not requested then warnOnce("Auto Equip Loadout: equip request failed for "..name) end
    if S.loadoutEquipAttempts>=12 then
        -- Don't freeze mode priority forever over a server-rejected equip.
        S.loadoutRetryAfter=now+45
        S.loadoutEquipAttempts=0
        warnOnce("Auto Equip Loadout: retrying later; verify the saved characters are available")
    end
end

local function stopSpeedAutomation(reason)
    S.autoSpeedRaid=false
    S.speedPendingCharacter=""
    -- The old code could leave this true after Speed Raid was exhausted.
    -- That prevented Auto Start Dimensions from resuming in the lobby.
    S.specialSelected = specialEnabled()
    savePreferences()
    if S.speedRaidToggle then pcall(function() S.speedRaidToggle:Set(false,true) end) end
    warnOnce("Speed Raid stopped: "..tostring(reason))
end
local function requestSpeedRaid()
    if not speedReady() then return false end
    local character,why=selectSpeedCharacter()
    if not character then
        if why and why~="Characters not loaded" then stopSpeedAutomation(why) end
        return false
    end
    saveOriginalSpeedCharacter()
    S.speedPendingCharacter=character
    savePreferences()
    local ok,reason=modeRequest("TeleportToShadowRaid",character,"SpeedRaid")
    if ok then
        -- Only mark this character used after the battle place actually loads.
        -- A failed/dropped teleport must not exhaust a valid character.
        return true
    end
    if type(reason)=="string" then
        local msg=string.lower(reason)
        if msg:find("already",1,true) or msg:find("used",1,true)
            or msg:find("once a week",1,true) then
            S.speedUsed[character]=true
            specialFailureUntil.SpeedRaid=os.clock()+1 -- try next unused character
            if S.speedCharacterChoice~="Auto — Next Unused" then
                stopSpeedAutomation("Chosen character has been used this week")
            end
        end
    end
    S.speedPendingCharacter=""
    S.speedRestorePending=false
    S.speedRestoreLobbyEpoch=0
    S.speedOriginalCharacter=""
    savePreferences()
    return false
end
local function requestDailyRaid()
    if (playerLevel() or 0)<30 or stat("DailyRaidAttempt")~=false then return false end
    if S.dailyLastRequestedDate==todayUTC() then return false end
    local ok=modeRequest("TeleportToRaidChallenge",nil,"DailyRaid")
    if ok then
        S.dailyLastRequestedDate=todayUTC()
        savePreferences()
    end
    return ok
end
-- Native replicated entry stats may be NumberValues, BoolValues, or
-- unavailable briefly during loading. Never assume false means unknown.
S.bossRushEntryValue = function(value)
    if type(value)=="boolean" then return value and 1 or 0 end
    if type(value)=="string" then
        local lowered=string.lower(value)
        if lowered=="true" then return 1 end
        if lowered=="false" then return 0 end
    end
    return tonumber(value)
end
S.bossRushEntrySnapshot = function()
    return tostring(stat("BossRushEntryPass")).."|"..tostring(stat("BossRushFreeEntry"))
end
S.bossRushTicketRejection = function(message)
    local reason=string.lower(tostring(message or ""))
    return reason:find("requires boss rush ticket",1,true)~=nil
        or reason:find("boss rush ticket",1,true)~=nil
        or (reason:find("boss rush",1,true)~=nil
            and reason:find("free entry",1,true)~=nil)
end
local function bossRushAvailable()
    -- A server rejection is authoritative. Skip Boss Rush for five minutes
    -- unless the ticket/free-entry stats change, then resume immediately.
    local snapshot=S.bossRushEntrySnapshot()
    if snapshot~=(S.bossTicketUnavailableSnapshot or "") then
        S.bossTicketUnavailableUntil=0
        S.bossTicketUnavailableSnapshot=""
        -- A real ticket gain or free-entry reset lifts the prior rejection.
        if type(specialFailureUntil)=="table" then
            specialFailureUntil.BossRush=0
        end
    end
    local tickets=S.bossRushEntryValue(stat("BossRushEntryPass"))
    local free=S.bossRushEntryValue(stat("BossRushFreeEntry"))
    if (tickets and tickets>0) or (free and free>0) then
        S.bossTicketUnavailableUntil=0
        return true
    end
    if tickets~=nil and free~=nil then return false end
    if os.clock()<(S.bossTicketUnavailableUntil or 0) then return false end
    -- One or both values are genuinely unavailable. Allow an infrequent
    -- server-authored attempt; record any explicit ticket rejection below.
    return true
end
-- Boss Rush requires two equipped assist characters as well as entry access.
-- Return nil when replicated data is unavailable: the server remains authoritative.
local function bossRushAssistsReady()
    local first = stat("AssistCharacterName1")
    local second = stat("AssistCharacterName2")
    if first == nil or second == nil then return nil end
    local function equipped(value)
        return type(value) == "string" and value ~= "" and value ~= "None" and value ~= "nil"
    end
    return equipped(first) and equipped(second)
end
local function extremeDifficulty()
    local cfg=getSettings()
    local d=cfg and cfg.ExtremeDimensionSettings and cfg.ExtremeDimensionSettings.difficulties
    if type(d)~="table" then return nil end
    if S.extremeDifficulty~="Hardest" then return d[S.extremeDifficulty] and S.extremeDifficulty or nil end
    for _,name in ipairs({"Extreme","Nightmare","Normal","Easy"}) do
        if d[name] then return name end
    end
end
local function scheduleRaidInLobby()
    -- Do not create rooms before the hourly raid has actually opened.
    if not S.raidWindowOpen() then return false end
    local level=playerLevel() or 0
    local id=chooseRaid(level)
    if not id then return false end
    local diff=chooseRaidDifficulty(id,level)
    if not diff then return false end
    local settings=getSettings()
    local info=settings and settings.MapInfo[id]
    local minPlayers=tonumber(info and info.minimumPlayersToStart) or 1
    if minPlayers>1 and not S.raidFriendsOnly then
        -- Server-managed Group Finder queue, not an undersized private party.
        return false -- Multi-player queues are handled by queueRaid in the arbiter
    end
    local result=invokeRoom("CreateRoom",{
        MapName=id,Difficulty=diff,FriendsOnly=S.raidFriendsOnly,Hardcore=false
    })
    if not result or result.status~="Success" then return false end
    S.modeIntent="Raid"
    S.modeFromPlace=game.PlaceId
    S.modeFromJobId=game.JobId
    S.modeRequestAt=os.time()
    S.createdOwnRoom=true
    savePreferences()
    if minPlayers>1 then
        -- A Friends Only party cannot be auto-started without enough players.
        -- Leave the room open; do not repeatedly create rooms or spam TeleportPlayers.
        warnOnce("Raid room created: waiting for "..tostring(minPlayers).." players")
        return true
    end
    task.wait(math.clamp(tonumber(S.startDelay) or 3,1,10))
    if not (S.alive and S.autoJoinRaid and game.PlaceId==RAID_LOBBY
        and S.raidWindowOpen()) then return false end
    local start=invokeRoom("TeleportPlayers")
    if start and start.status=="Success" then
        S.roomStartRequested=true
        return true
    end
    -- Do not create a second room while this party is still owned.
    warnOnce("Raid party created but start failed: check minimum players")
    return true
end

-- QueuePlayer uses three positional arguments; modeRequest handles a single
-- value only. Keep this exactly in sync with RoomModule's captured call.
local function queueRaid(id,difficulty)
    if not S.raidWindowOpen() or not mainFunction then return false end
    local ok,response=pcall(function()
        return mainFunction:InvokeServer("QueuePlayer",id,difficulty,false)
    end)
    if not ok or type(response)~="table" or response.status=="Fail" then
        warnOnce("Raid matchmaking failed: "..tostring(ok and response and response.message or response))
        S.raidUnavailableUntil=os.time()+60
        savePreferences()
        return false
    end
    S.modeIntent="RaidQueue"
    S.modeFromPlace=game.PlaceId
    S.modeFromJobId=game.JobId
    S.modeRequestAt=os.time()
    S.lobbyBusy=true -- queue is active until place transition / manual cancellation
    savePreferences()
    return true
end

-- Special requests are made at most once per session window; the server and
-- the normal Roblox teleport handler control when the destination loads.
local lastSpecialCheck=0
local function specialLobbyTick()
    if not (S.alive and inLobby() and statsReady()) then return end
    local now=os.clock()
    -- If a Roblox InvokeServer inside the previous asynchronous worker never
    -- returns, don't leave all modes frozen behind specialBusy forever.
    if S.specialBusy then
        if now - (S.specialBusySince or now) < 35 then return end
        S.specialBusy=false
        S.specialWorkerGeneration=(S.specialWorkerGeneration or 0)+1
        warnOnce("Mode scheduler recovered from a stuck request")
    end
    if now-lastSpecialCheck<1 then return end
    lastSpecialCheck=now
    local epoch=os.time()
    -- v39: Self-heal the exact same room flags that switching Auto Start
    -- OFF/ON used to clear manually. ONLY rooms created by our regular
    -- Dimensions worker are affected, never public/multiplayer raid queues.
    if S.sessionStopped then
        -- Recover any old persisted stop flag without touching user toggles.
        S.sessionStopped=false
        S.matchesCompleted=0
        savePreferences()
    end
    if regularLobby() and S.createdOwnRoom
        and (S.createdOwnRoomAt or 0)>0 then
        local age=now-S.createdOwnRoomAt
        local failed=(S.roomStartFailedAt or 0)>0
        local failureAge=failed and now-S.roomStartFailedAt or 0
        -- Explicit server reject: allow brief server cleanup before leaving.
        -- Accepted or unconfirmed start: give teleport time to occur.
        local stale=(failed and failureAge>5)
            or (S.roomStartRequested and age>50)
            or (not S.roomStartRequested and age>30)
        if stale then
            if remote then pcall(function()
                remote:FireServer("RemovePlayerFromParty")
            end) end
            S.createdOwnRoom=false
            S.createdOwnRoomAt=0
            S.roomStartRequested=false
            S.roomStartRequestedAt=0
            S.roomStartFailedAt=0
            S.roomStartFailureReason=""
            S.lobbyBusy=false
            S.lobbyGeneration=S.lobbyGeneration+1
            S.roomUnavailableUntil=now+4
            warnOnce("Auto Start recovered an abandoned room and will try the next eligible mode")
        end
    end
    -- A stale busy flag without a room or live worker should never prevent
    -- scheduling forever. Normal parties remain protected by createdOwnRoom.
    if regularLobby() and S.lobbyBusy and not S.createdOwnRoom
        and now-(S.lastLobbyWorkerKickAt or 0)>40 then
        S.lobbyBusy=false
        S.lobbyGeneration=S.lobbyGeneration+1
        warnOnce("Auto Start recovered a stuck room worker")
    end
    -- Returning from a battle must clear the previous mode even when the
    -- destination is the SAME lobby PlaceId that originally queued it.
    local cameBackToNewServer = S.modeIntent~=""
        and type(S.modeFromJobId)=="string" and S.modeFromJobId~=""
        and type(game.JobId)=="string" and game.JobId~=""
        and S.modeFromJobId~=game.JobId
    if S.modeWasInBattle or cameBackToNewServer then
        -- A completed special-mode round must never inherit an old regular
        -- room lock. This doesn't change toggle settings or match limits.
        S.lobbyBusy=false
        S.createdOwnRoom=false
        S.createdOwnRoomAt=0
        S.roomStartRequested=false
        S.roomStartRequestedAt=0
        S.roomStartFailedAt=0
        S.roomStartFailureReason=""
        S.lobbyGeneration=S.lobbyGeneration+1
        S.modeWasInBattle=false
        if S.autoEquipLoadout and preferredLoadoutValid() then
            S.loadoutPriorityHoldUntil=os.clock()+18
        end
        S.modeIntent="";S.modeRequestAt=0;S.modeFromPlace=game.PlaceId
        S.modeFromJobId=game.JobId
        savePreferences()
    elseif S.modeIntent~="" and game.PlaceId~=(tonumber(S.modeFromPlace) or 0) then
        S.modeIntent="";S.modeRequestAt=0;S.modeFromPlace=game.PlaceId
        S.modeFromJobId=game.JobId
        savePreferences()
    end
    if S.modeIntent~="" and epoch-(tonumber(S.modeRequestAt) or 0)<45 then return end
    if S.modeIntent~="" and epoch-(tonumber(S.modeRequestAt) or 0)>=45 then
        -- Await another eligibility check instead of hammering the same remote.
        S.modeIntent="";savePreferences()
    end
    -- Don't suppress regular Dimensions when Speed Raid is now exhausted or
    -- when all special modes are disabled. The mode priority list includes it.
    local hasSpecial=specialEnabled()
    S.specialSelected=hasSpecial
    if not hasSpecial and not (S.autoStart and not S.sessionStopped) then return end
    -- Pause auto-entry briefly after a genuine network reconnect only.
    -- Normal lobby-to-battle transitions do NOT set this grace period.
    if os.time() < (S.reconnectResumeEpoch or 0) then return end
    -- Avoid competing with a room that was already created by Auto Start.
    if S.lobbyBusy or S.createdOwnRoom or (S.speedRestorePending and regularLobby()) then return end
    -- After Speed Raid or first boot, allow the selected permanent loadout a
    -- short, bounded window to equip before the next mode priority request.
    if S.autoEquipLoadout and preferredLoadoutValid()
        and not preferredLoadoutMatches()
        and now < (S.loadoutPriorityHoldUntil or 0) then return end
    S.specialBusy=true
    S.specialBusySince=os.clock()
    S.specialWorkerGeneration=(S.specialWorkerGeneration or 0)+1
    local workerGeneration=S.specialWorkerGeneration
    task.spawn(function()
        -- Carry the Dimensions hand-off across pcall and release the mode
        -- worker lock BEFORE launching CreateRoom. This replaces a fragile
        -- 0.2-second one-shot callback that could silently do nothing.
        local launchDimensions=false
        local worked, failure = pcall(function()
        local launched=false
        if game.PlaceId==RAID_LOBBY then
            if S.autoJoinRaid and S.raidWindowOpen() then
                local level=playerLevel() or 0
                local id=chooseRaid(level)
                local diff=id and chooseRaidDifficulty(id,level)
                if id and diff then
                    local cfg=getSettings()
                    local info=cfg and cfg.MapInfo and cfg.MapInfo[id]
                    if info and (tonumber(info.minimumPlayersToStart) or 1)>1
                        and not S.raidFriendsOnly and info.canBeQueued then
                        launched=queueRaid(id,diff)
                    else
                        launched=scheduleRaidInLobby()
                    end
                end
            end
            if not launched and (S.autoSpeedRaid or S.autoDailyRaid or S.autoBossRush
                or S.autoExtreme or S.autoTimeChallenge or S.autoStart) then
                S.raidUnavailableUntil=os.time()+120
                savePreferences()
                -- Return to regular lobby only when there's other work to do.
                launched=modeRequest("TeleportToLobbyWithSave",nil,"ReturnLobby")
            end
        elseif regularLobby() then
            -- Mode priority: 1 is highest. Ties use the original order.
            -- Every check is non-blocking. A locked/closed/exhausted mode
            -- yields immediately to the next enabled mode in this tick.
            local ordered={"BossRush","DailyRaid","SpeedRaid","Raid",
                "ExtremeDimension","TimeChallenge","Dimensions"}
            local defaultOrder={}
            for i, name in ipairs(ordered) do defaultOrder[name]=i end
            table.sort(ordered,function(a,b)
                local ar=math.clamp(tonumber(S.modePriority[a]) or defaultOrder[a],1,7)
                local br=math.clamp(tonumber(S.modePriority[b]) or defaultOrder[b],1,7)
                if ar==br then return defaultOrder[a]<defaultOrder[b] end
                return ar<br
            end)
            local queueHeldForAssistRepair=false
            for _, mode in ipairs(ordered) do
                if launched then break end
                local holdForRepair=false
                local modeOK,modeError=pcall(function()
                if mode=="BossRush" and S.autoBossRush then
                    -- The server requires Assist 1 and Assist 2 to be equipped.
                    -- Don't request a doomed entry or block lower-priority modes.
                    if (playerLevel() or 0)>=15 and bossRushAvailable() then
                        local assistState = bossRushAssistsReady()
                        if assistState == false then
                            if repairMissingBossRushAssists() then
                                -- Give saved assists a short chance to restore,
                                -- then yield to lower-priority farming. A failed
                                -- equip cannot starve Auto Start indefinitely.
                                if (S.bossAssistHoldStartedAt or 0)==0 then
                                    S.bossAssistHoldStartedAt=os.clock()
                                end
                                holdForRepair=(os.clock()-S.bossAssistHoldStartedAt)<5
                                return
                            end
                            if not S.bossAssistWaitingNotified then
                                warnOnce("Boss Rush waiting: equip Assist 1 and Assist 2 (no saved loadout)")
                                S.bossAssistWaitingNotified = true
                            end
                        else
                            S.bossAssistWaitingNotified = false
                            S.bossAssistHoldStartedAt=0
                            -- Unknown (nil) stats: let the server validate once.
                            launched=modeRequest("TeleportToBossRush",nil,"BossRush")
                        end
                    end
                elseif mode=="DailyRaid" and S.autoDailyRaid then
                    launched=requestDailyRaid()
                elseif mode=="SpeedRaid" and S.autoSpeedRaid then
                    launched=requestSpeedRaid()
                elseif mode=="Raid" and S.autoJoinRaid
                    and S.raidWindowOpen()
                    and epoch >= (tonumber(S.raidUnavailableUntil) or 0) then
                    if chooseRaid(playerLevel() or 0) then
                        launched=modeRequest("TeleportToRaidLobby",nil,"EnterRaidLobby")
                    end
                elseif mode=="ExtremeDimension" and S.autoExtreme then
                    local cfg=getSettings()
                    local req=cfg and cfg.ExtremeDimensionSettings
                        and cfg.ExtremeDimensionSettings.levelReq or math.huge
                    local diff=extremeDifficulty()
                    if diff and (playerLevel() or 0)>=req then
                        launched=modeRequest("TeleportToExtremeDimension",diff,"ExtremeDimension")
                    end
                elseif mode=="TimeChallenge" and S.autoTimeChallenge
                    and (playerLevel() or 0)>=5 then
                    launched=modeRequest("TeleportToTimeChallenge",nil,"TimeChallenge")
                elseif mode=="Dimensions" and S.autoStart and not S.sessionStopped then
                    -- Request a direct handoff AFTER specialBusy is released
                    -- below. Never depend on a one-shot timer racing the lock.
                    S.specialSelected=false
                    launchDimensions=true
                    launched="Dimensions"
                end
                end)
                if not modeOK then
                    -- A problem in one selected mode should not stop the next
                    -- eligible mode from being considered in this tick.
                    warnOnce("Skipped "..tostring(mode).." after mode error: "..tostring(modeError))
                end
                if holdForRepair then
                    queueHeldForAssistRepair=true
                    break
                end
            end
            -- Always reach normal Auto Start when all higher-priority
            -- enabled modes are unavailable. This also survives an isolated
            -- mode-check exception or unexpected option in the priority list.
            if not launched and not queueHeldForAssistRepair
                and S.autoStart and not S.sessionStopped then
                S.specialSelected=false
                launchDimensions=true
                launched="Dimensions"
            end
        end
        if launched then S.specialSelected=(launched~="Dimensions") end
        end)
        if S.specialWorkerGeneration == workerGeneration then
            S.specialBusy=false
            S.specialBusySince=0
        end
        if not worked then
            warnOnce("Mode scheduler error: " .. tostring(failure))
        end
        if worked and launchDimensions
            and S.specialWorkerGeneration==workerGeneration
            and S.alive and regularLobby() and S.autoStart
            and not S.sessionStopped and not S.specialBusy then
            autoStartWorker()
        end
    end)
end

-- Screen-based result completion handling for modes that do not use the
-- ordinary ResultUI (e.g. a RaidResultUI in some raids).
local function specialResultTick()
    if game.PlaceId~=6990129309 then return end
    local gui=player:FindFirstChildOfClass("PlayerGui")
    local result=gui and (gui:FindFirstChild("ResultUI",true) or gui:FindFirstChild("RaidResultUI",true))
    local raidResult=gui and gui:FindFirstChild("RaidResultUI",true)
    local shown=(result and result:IsA("GuiObject") and result.Visible)
        or (raidResult and raidResult:IsA("GuiObject") and raidResult.Visible)
    if not shown then S.specialResultHandled=false;return end
    if S.specialResultHandled then return end
    local mode=tostring(Workspace:GetAttribute("GameMode") or "")
    local intent=S.modeIntent
    local shouldLeave=(mode=="ShadowRaid" and S.speedAutoLeave)
        or (intent=="SpeedRaid" and S.speedAutoLeave)
        or intent=="DailyRaid" or (intent=="BossRush" and S.bossAutoLeave)
        or intent=="Raid" or intent=="RaidQueue"
    local retryButton=gui and gui:FindFirstChild("RetryDungeonButton",true)
    local shouldRetry=(intent=="BossRush" and S.bossAutoRetry and not S.bossAutoLeave
        and retryButton and retryButton.Visible==true)
    if not (shouldLeave or shouldRetry) then return end
    S.specialResultHandled=true
    task.delay(0.4,function()
        if not S.alive or game.PlaceId~=6990129309 then return end
        local r=gui and gui:FindFirstChild("ResultUI",true)
        local rr=gui and gui:FindFirstChild("RaidResultUI",true)
        if not ((r and r.Visible) or (rr and rr.Visible)) then return end
        if remote then remote:FireServer(shouldLeave and "LeaveDungeon" or "RetryDungeon") end
    end)
end

