    local E=self.V44
    if not E.AutoProgression or now<E.ProgressAt then return end
    E.ProgressAt=now+3
    if E.AutoMine or E.AutoMeditate or E.AutoCraft or (E.AutoNenUnlock and LocalPlayer:GetAttribute("NenUnlocked")~=true)
        or (E.AutoLineage and not self:V44DoneQuest("LineageAwakening")) then
        E.ProgressStatus="Paused for selected unlock/activity";return
    end
    if self.QuestCombatActive and self.QuestTarget then E.ProgressStatus="Quest combat in progress";return end
    local level=tonumber(LocalPlayer:GetAttribute("Level")) or 1
    local lookup=self:V44QuestOptions()
    if E.ProgressFocus~="Leveling" then
        for _,id in ipairs({"StarterQuest","StarterWeapon","WaysOfNen","ActivateNen","LineageAwakening","RoadToOneStarHunter","PathToAscension"}) do
            if (id~="LineageAwakening" or level>=30) and not self:V44DoneQuest(id) then
                local found=false
                for _,item in pairs(lookup) do if type(item)=="table" and item.id==id and level >= (tonumber(item.level) or level) then found=true;break end end
                if found and self:V44SelectQuest(id) then E.ProgressStatus="Story: "..id;return end
            end
        end
    end
    local best,bestValue
    for _,item in pairs(lookup) do
        if type(item)=="table" and item.board and not item.oneTime then
            local needed=tonumber(item.boardMin or item.level) or 999
            if needed<=level then
                local isBoss=item.category=="Boss" or (item.target and table.find(BossNames,item.target)~=nil)
                if E.ProgressFocus=="Bosses" or not isBoss then
                    local score=needed*100+(isBoss and (E.ProgressFocus=="Bosses" and 50 or -120) or 30)
                    if not bestValue or score>bestValue then best=item;bestValue=score end
                end
            end
        end
    end
    if best and self:V44SelectQuest(best.id) then E.ProgressStatus="Level "..level..": "..best.name
    elseif best and self.QuestSelectedId==best.id then self.AutoQuest=true;E.ProgressStatus="Leveling: "..best.name
    else E.ProgressStatus="No eligible quest in saved catalog" end
end
