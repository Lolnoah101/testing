local function modifierAllowed(name, mode, objective, difficulty)
    if not MODIFIER_DETAILS[name] then return false end
    local source = mode == "Waves" and WAVES_MODIFIERS or STANDARD_MODIFIERS
    if not table.find(source, name) then return false end
    return not ((objective == "Stall" and STALL_BLOCKED[name])
        or (objective == "Female Titan" and FEMALE_BLOCKED[name])
        or (difficulty == "Freedom" and FREEDOM_BLOCKED[name]))
end
local function modifierLabel(name, mode)
    local info=MODIFIER_DETAILS[name]
    if not info then return name end
    local bonus=info.boost
    if mode == "Raids" and bonus>0 and name~="Boring" and name~="Simple" then
        bonus=bonus/2
    end
    local first=string.format("%s%g%% %s", bonus>=0 and "+" or "", bonus, info.type)
    return name .. " (" .. first .. "; " .. info.effect .. ")"
end
local function modifierNameFromLabel(value, mode)
    if type(value)~="string" then return nil end
    if MODIFIER_DETAILS[value] then return value end -- migrate old single-select values
    local source=mode=="Waves" and WAVES_MODIFIERS or STANDARD_MODIFIERS
    for _,name in ipairs(source) do
        if value==modifierLabel(name,mode) then return name end
    end
    return nil
end
local function modifierSummary(values)
    if type(values)~="table" or #values==0 then return "None" end
    return table.concat(values, ", ")
end
-- Retain newly selected modifiers over conflicting old selections.
-- In Freedom, required modifiers cannot be toggled off.
local function normalizeModifierSelection(raw, previous, mode, objective, difficulty)
    local names, seen = {}, {}
    if type(raw)=="string" then raw={raw} end
    if type(raw)~="table" then raw={} end
    for _,v in ipairs(raw) do
        local name=modifierNameFromLabel(v,mode)
        if name and modifierAllowed(name,mode,objective,difficulty) and not seen[name] then
            seen[name]=true
            names[#names+1]=name
        end
    end
    local was={}
    for _,v in ipairs(type(previous)=="table" and previous or {}) do was[v]=true end
    -- Put additions last so they take precedence over previously selected opposites.
    table.sort(names,function(a,b)
        if was[a]~=was[b] then return was[a] end
        return (table.find(mode=="Waves" and WAVES_MODIFIERS or STANDARD_MODIFIERS,a) or 99)
            < (table.find(mode=="Waves" and WAVES_MODIFIERS or STANDARD_MODIFIERS,b) or 99)
    end)
    local result={}
    for _,name in ipairs(names) do
        for i=#result,1,-1 do
            local old=result[i]
            if (MODIFIER_CONFLICTS[name] and MODIFIER_CONFLICTS[name][old])
                or (MODIFIER_CONFLICTS[old] and MODIFIER_CONFLICTS[old][name]) then
                table.remove(result,i)
            end
        end
        result[#result+1]=name
    end
    if difficulty=="Freedom" and mode~="Waves" then
        for _,name in ipairs(FREEDOM_REQUIRED) do
            if modifierAllowed(name,mode,objective,difficulty) and not table.find(result,name) then
                result[#result+1]=name
            end
        end
