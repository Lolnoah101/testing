    local function RunAchievementGrinder()

        if Advanced.AutoAchievementGrinder
            ~= true
        then

            return
        end


        CaptureRunSnapshot()


        local Data =
            GetData()


        if not Data then
            return
        end


        local Definition =
            NextAchievement(
                Data
            )


        if not Definition then

            -- Claim selected completed rewards before ending.
            if Advanced
                .AutoClaimAchievementRewards
                == true
                and IsLobby()
            then

                for _, Id in ipairs(
                    AchievementConfig
                    and AchievementConfig.order
                    or {}
                ) do

                    local Item =
                        AchievementConfig
                            .achievements[
                                Id
                            ]


                    if Item
                        and Advanced.AchievementTargets[
                            Item.Title
                        ] == true
                        and IsAchievementComplete(
                            Data,
                            Id
                        )
                        and not IsAchievementClaimed(
                            Data,
                            Id
                        )
                    then

                        ClaimAchievement(
                            Data,
                            Item
                        )


                        SetState(
                            "Achievement Grinder: claiming "
                            .. Item.Title
                        )


                        return
                    end
                end
            end


            StopAchievementGrinder(
                "All selected supported achievements are complete."
            )


            return
        end


        local Objective =
            Definition.Objective
            or {}


        local Kind =
            tostring(
                Objective.Kind
                or ""
            )


        local Goal =
            tonumber(
                Objective.Goal
            ) or 0


        local Progress =
            AchievementProgress(
                Data,
                Definition.Id
            )


        if Kind
            == "DungeonCompleted"
        then

            local Difficulty =
                Objective.Difficulty
                or "Easy"


            ApplyStory(
                "Act 1",
                Difficulty,
                Definition.Id
            )


        elseif Kind
            == "BossDefeated"
        then

            ApplyStory(
                "Act 1",
                "Easy",
                Definition.Id
            )


        elseif Kind
            == "MaterialCollected"
        then

            ApplyStory(
                "Act 1",
                "Nightmare",
                Definition.Id
            )


        elseif Kind
            == "InfiniteWaveReached"
        then

            ApplyInfinite(
                Goal,
                "Easy",
                Definition.Id
            )


        elseif Kind
            == "CurrencyEarned"
        then

            ApplyStory(
                "Act 1",
                "Nightmare",
                Definition.Id
            )


        elseif Kind
            == "DistinctCharactersEvolved"
        then

            if DelegateEvolutionAchievement(
                Data
            )
            then

                SetState(
                    "Achievement Grinder: delegating "
                    .. Definition.Title
                    .. " to Full Auto Evolve"
                )

            else

                SetState(
                    "Achievement Grinder: "
                    .. Definition.Title
                    .. " needs another unevolved owned character"
                )
            end


            return


        elseif Kind
            == "AccessoryCrafted"
            or Kind
                == "DistinctAccessoriesCrafted"
            or Kind
                == "AllLaunchAccessoriesCrafted"
        then

            if DelegateCraftAchievement() then

                SetState(
                    "Achievement Grinder: delegating "
                    .. Definition.Title
                    .. " to Accessory Farm & Craft"
                )
            end


            return


        elseif Kind
            == "CharacterRolled"
        then

            if not IsLobby() then

                ReturnToLobby()


                SetState(
                    "Achievement Grinder: returning to lobby for summons"
                )


                return
            end


            HoldLobby()


            if os.clock()
                - Runtime.LastAchievementSpin
                >= 1.35
            then

                Runtime.LastAchievementSpin =
                    os.clock()


                local Spin =
                    GENV.__AZ_SEND_WEAPON_SPIN_ONCE


                if type(Spin)
                    == "function"
                then

                    pcall(
                        Spin
                    )
                end
            end


        else

            SetState(
                "Achievement Grinder: unsupported objective "
                .. Kind
                .. " for "
                .. Definition.Title
            )


            return
        end


        SetState(
            "Achievement Grinder: "
            .. Definition.Title
            .. " "
            .. tostring(
                Progress
            )
            .. "/"
            .. tostring(
                Goal
            )
        )
    end


