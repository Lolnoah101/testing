local function GetLootFolder()
    return workspace:FindFirstChild("LootDrops")
end


local function GetLootDropFromPrompt(Prompt)
    local LootFolder =
        GetLootFolder()

    if not LootFolder
        or not Prompt
        or not Prompt:IsA("ProximityPrompt")
        or not Prompt:IsDescendantOf(LootFolder)
    then
        return nil
    end

    local Current =
        Prompt.Parent

    while Current
        and Current ~= LootFolder
        and Current ~= workspace
    do
        if Current.Parent == LootFolder then
            return Current
        end

        Current = Current.Parent
    end

    return Prompt.Parent
end


local function GetLootRarity(LootDrop)
    if not LootDrop then
        return nil
    end

    -- Prefer explicit attributes if the game exposes them.
    for _, AttributeName in ipairs({
        "Rarity",
        "Tier",
        "Quality",
    }) do
        local Value =
            LootDrop:GetAttribute(
                AttributeName
            )

        if typeof(Value) == "string"
            and Value ~= ""
        then
            return Value
        end
    end

    -- From your current capture the rarity appears as a direct child
    -- of workspace.LootDrops.LootDrop (for example: "Rare").
    for _, Child in ipairs(
        LootDrop:GetChildren()
    ) do
        if KnownLootRaritySet[
            Child.Name
        ] then
            return Child.Name
        end
    end

    return nil
end


local function GetLootName(
    LootDrop,
    Prompt
)
    if Prompt then
        local ObjectText =
            tostring(
                Prompt.ObjectText
                or ""
            )

        if ObjectText ~= "" then
            return ObjectText
        end
    end

    if LootDrop then
        local AttributeName =
            LootDrop:GetAttribute(
                "ItemName"
            )

        if typeof(AttributeName) == "string"
            and AttributeName ~= ""
        then
            return AttributeName
        end
    end

    return LootDrop
        and LootDrop.Name
        or "Loot"
end


local function LootMatchesSelection(
    LootDrop
)
    local Selected =
        Settings.LootRarity
        or "Any"

    if Selected == "Any" then
        return true
    end

    local Rarity =
        GetLootRarity(
            LootDrop
        )

    return Rarity == Selected
end


local function IsLootPrompt(Object)
    local LootFolder =
        GetLootFolder()

    return LootFolder
        and Object
        and Object:IsA("ProximityPrompt")
        and Object.Name == "LootDropPrompt"
        and Object:IsDescendantOf(
            LootFolder
        )
end


local function PickUpLootPrompt(Prompt)
    if not HubRunning
        or not Settings.AutoPickUpLoot
        or not IsLootPrompt(Prompt)
        or not Prompt.Enabled
    then
        return false
    end

    local LootDrop =
        GetLootDropFromPrompt(
            Prompt
        )

    if not LootDrop then
        return false
    end

    if not LootMatchesSelection(
        LootDrop
    ) then
        return false
    end

    local LastAttempt =
        LootPromptLastAttempt[Prompt]
        or 0

    if os.clock() - LastAttempt
        < PROMPT_RETRY_DELAY
    then
        return false
    end

    LootPromptLastAttempt[Prompt] =
        os.clock()

    local Success, ErrorMessage =
        pcall(function()
            if type(
                fireproximityprompt
            ) ~= "function"
            then
                error(
                    "fireproximityprompt is unavailable"
                )
            end

            fireproximityprompt(
                Prompt
            )
        end)

    if not Success then
        warn(
            "[Combat Hub] Auto Loot: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    -- Keep retrying this same prompt while it still exists.
    -- That means if you were too far away at first, walking near it
    -- later will cause the prompt to be fired again automatically.
    return true
end


local function ScanExistingLoot()
    local LootFolder =
        GetLootFolder()

    if not LootFolder then
        return
    end

    for _, Object in ipairs(
        LootFolder:GetDescendants()
    ) do
        if IsLootPrompt(Object) then
            PickUpLootPrompt(
                Object
            )
        end
    end
end


local function StartAutoPickUpLoot()
    AutoLootLoopID += 1

    local LoopID =
        AutoLootLoopID

    table.clear(
        LootPromptLastAttempt
    )

    -- Immediate pass for loot that already exists.
    ScanExistingLoot()

    -- Keep rescanning while enabled.
    --
    -- This is important because the game can create LootDropPrompt first,
    -- then add the item/rarity children a moment later. The old event-only
    -- version saw the prompt too early and never retried it.
    task.spawn(function()
        while HubRunning
            and Settings.AutoPickUpLoot
            and LoopID == AutoLootLoopID
        do
            ScanExistingLoot()

            for Prompt in pairs(
                LootPromptLastAttempt
            ) do
                if not Prompt
                    or not Prompt.Parent
                then
                    LootPromptLastAttempt[Prompt] =
                        nil
                end
            end

            task.wait(
                LOOT_SCAN_INTERVAL
            )
        end
    end)
end


local function StopAutoPickUpLoot()
    Settings.AutoPickUpLoot =
        false

    AutoLootLoopID += 1

    table.clear(
        LootPromptLastAttempt
    )
end


LootAddedConnection =
    workspace.DescendantAdded:Connect(
        function(Object)
            if not HubRunning
                or not Settings.AutoPickUpLoot
            then
                return
            end

            local LootFolder =
                GetLootFolder()

            if not LootFolder
                or not Object:IsDescendantOf(
                    LootFolder
                )
            then
                return
            end

            -- New loot often arrives in several replication steps.
            -- Wait briefly, then scan the whole folder instead of only
            -- reacting when the prompt object itself is the added child.
            task.delay(
                0.08,
                function()
                    if HubRunning
                        and Settings.AutoPickUpLoot
                    then
                        ScanExistingLoot()
                    end
                end
            )
        end
    )


local function AntiAFK()
    if not HubRunning
        or not Settings.AntiAFK
    then
        return
    end

    pcall(function()
        local Camera = workspace.CurrentCamera
        local CameraCFrame =
            Camera
            and Camera.CFrame
            or CFrame.new()

        VirtualUser:CaptureController()
        VirtualUser:Button2Down(
            Vector2.new(0, 0),
            CameraCFrame
        )
        task.wait(0.05)
        VirtualUser:Button2Up(
            Vector2.new(0, 0),
            CameraCFrame
        )
    end)
end

AntiAFKConnection =
