            end
            task.wait(0.3)
        end
    end)

    local UserId =
        tostring(
            LocalPlayer.UserId
        )


    local WasActive =
        false

    local CountedThisMatch =
        false

    local LastActionSent =
        nil

    local LastActionAt =
        0

    local LimitLeavePending =
        false


    local function Persist()

        if type(
            Settings.PersistEndActionSettings
        ) == "function"
        then

            Settings
                .PersistEndActionSettings()
        end
    end


    local function SetLeaveAfterOff()

        Settings.AutoLeaveAfterMatches =
            false

        Settings.CompletedMatches =
            0


        local Controls =
            Settings.EndActionControls


        if Controls
            and Controls.LeaveAfter
        then

            pcall(function()

                Controls.LeaveAfter:Set(
                    false,
                    true
                )
            end)
        end


        Persist()
    end


    local function GetOwnResultVote()

        local VoteState =
            RunStore.state
                .resultVotes
                :get(UserId)


        if not VoteState then
            return nil
        end


        local Success,
            Vote =
            pcall(function()
                return VoteState:get()
            end)


        if Success then
            return tonumber(Vote)
        end


        return nil
    end


    task.spawn(function()

        while SessionAlive() do

            -- These controls are for Story result screens, not Infinite.
            if workspace:GetAttribute(
                "Mode"
            ) == "infinite"
            then

                task.wait(0.20)
                continue
            end


            local Participant =
                RunStore.state
                    .participants
                    :get(UserId)


            if not Participant then

                WasActive = false
                CountedThisMatch = false
                LastActionSent = nil
                LimitLeavePending = false

                task.wait(0.20)
                continue
            end


            local Status =
                Participant.status:get()


            if Status == "active" then

                WasActive = true
                CountedThisMatch = false
                LastActionSent = nil
                LastActionAt = 0
                LimitLeavePending = false

                task.wait(0.15)
                continue
            end


            if WasActive
                and not CountedThisMatch
            then

                CountedThisMatch =
                    true

                Settings.CompletedMatches =
                    math.max(
                        0,
                        tonumber(
                            Settings.CompletedMatches
                        ) or 0
                    ) + 1


                Persist()


                print(
                    "[Anime Zero] Match count:",
                    Settings.CompletedMatches,
                    "/",
                    Settings.LeaveAfterMatches
                )
            end


            local TravelStatus =
                Participant.travelStatus:get()


            if TravelStatus ~= "idle" then

                if LimitLeavePending then

                    LimitLeavePending =
                        false

                    SetLeaveAfterOff()
                end


                task.wait(0.15)
                continue
            end


            local Action =
                nil

            local LimitTriggered =
                false


            -- Trials now has a native "Next Floor" result action.
            -- Do not use the retired leave-to-lobby handoff.

            if Settings.AutoLeave then

                Action = 3


            elseif Settings.AutoLeaveAfterMatches
                and Settings.CompletedMatches
                    >= math.max(
                        1,
                        Settings.LeaveAfterMatches
                    )
            then

                Action = 3
                LimitTriggered = true


            elseif Settings.AutoNext
                and RunStore.state
                    .canNext:get() == true
            then

                Action = 2


            elseif Settings.AutoRetry then

                -- The rescue runtime owns Retry because it understands the
                -- updated result -> waiting -> active lifecycle. Keeping the old
                -- loop from also firing endAction(1) prevents duplicate Retry
                -- votes during the wave-0 / Get Ready transition. If rescue did
                -- not initialize, this remains a guarded fallback.
                local RescueRuntime =
                    GENV.__AZ_FARM_RESCUE_RUNTIME

                local RescueOwnsRetry =
                    type(RescueRuntime) == "table"
                    and RescueRuntime.Active == true
                    and RescueRuntime.Ready == true

                if not RescueOwnsRetry then
                    local HasFinishedMarker = false

                    pcall(function()
                        HasFinishedMarker =
                            Participant.finishedAt:get() ~= nil
                            or RunStore.state.finishedAt:get() ~= nil
                            or RunStore.state.resultEndsAt:get() ~= nil
                    end)

                    if HasFinishedMarker then
                        Action = 1
                    end
                end
            end



            if Action then

                local Now =
                    os.clock()


                -- Retry/Next are result votes. Once our vote is visible in
                -- resultVotes, the server accepted it and no resend is needed.
                -- Leave is a direct travel action, so keep retrying until
                -- travelStatus changes away from idle.
                local Accepted =
                    Action ~= 3
                    and GetOwnResultVote()
                        == Action


                if Accepted then

                    LastActionSent =
                        Action

                elseif LastActionSent ~= Action
                    or (
                        Now - LastActionAt
                    ) >= 1.25
                then

                    pcall(function()
                        local Saver =
                            GENV.__AZ_FORCE_CONFIG_SAVE

                        if type(Saver) == "function" then
                            Saver(
                                "before run action",
                                true
                            )
                        else
                            Window:Save()
                        end
                    end)


                    local Allowed = true
                    if type(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION) == "function" then
                        local GuardOK, Ready = pcall(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION)
                        Allowed = not GuardOK or Ready ~= false
                    end

                    local Fired = false
                    if Allowed then
                        Fired = pcall(function()
                            RunPackets.endAction:fire(Action)
                        end)
                    end


                    if Fired then

                        LastActionSent =
                            Action

                        LastActionAt =
                            Now


                        if LimitTriggered then
                            LimitLeavePending =
                                true
                        end


                        print(
                            "[Anime Zero] End Action:",
                            Action == 1
                                and "Retry"
                                or (
                                    Action == 2
                                    and "Next"
                                    or "Leave"
                                )
                        )
                    end
                end
            end


            task.wait(0.15)
        end
    end)
end)()


--//============================================================
--// AUTO PICKUP LOOT + ENDLESS WAVE LEAVE
--//
--// Loot:
--//   game/stores/dropStore exposes each replicated drop id/kind/position.
--//   The normal client attracts a drop from <= 12 studs and finally sends
--//   rewardPackets.recoverDrop(dropId). Auto Pickup now exposes the
--//   nearest settled drop as a temporary farm target so Teleport/Tween
--//   moves into the normal <= 12 stud pickup range before recovering it.
--//
--// Endless:
--//   InfiniteStore.Store.state.Wave is the authoritative live wave.
--//   The game's Leave Run button sends runPackets.endAction(3).
--//
--// Nested scope keeps these locals out of the main 200-register budget.
--//============================================================

;(function()

    local DropStoreObject =
        StoresFolder
        and StoresFolder
            :FindFirstChild(
                "dropStore"
            )


    local RewardPacketsObject =
        PacketsFolder
        and PacketsFolder
            :FindFirstChild(
                "rewardPackets"
            )


    local InfiniteStoreObject =
        StoresFolder
        and StoresFolder
            :FindFirstChild(
                "InfiniteStore"
            )


    local RunPacketsObject =
        PacketsFolder
        and PacketsFolder
            :FindFirstChild(
                "runPackets"
            )


    local DropStoreModule
    local RewardPackets
    local InfiniteStoreModule
    local RunPackets


    if DropStoreObject then
        pcall(function()
            DropStoreModule =
                require(DropStoreObject)
        end)
    end


    if RewardPacketsObject then
        pcall(function()
            RewardPackets =
                require(RewardPacketsObject)
        end)
    end


    if InfiniteStoreObject then
        pcall(function()
            InfiniteStoreModule =
                require(InfiniteStoreObject)
        end)
    end


    if RunPacketsObject then
        pcall(function()
            RunPackets =
                require(RunPacketsObject)
        end)
    end


    -- Stable loot acquisition: select ONE drop, approach it smoothly to the
    -- real pickup range, then wait for server/store removal before switching.
    -- Unconfirmed/stale drops are temporarily skipped to prevent oscillation.
    local SeenDrops = {}
    local LastDropAttempt = {}
    local DropAttempts = {}
    local DropIgnoreUntil = {}
    local LockedDropId = nil
    local LockedDropSince = 0

    local DROP_PICKUP_RANGE = 12
    local DROP_SETTLE_TIME = 1.20
    local DROP_RETRY_TIME = 1.00
    local DROP_MAX_ATTEMPTS = 2
    local DROP_REVISIT_DELAY = 12
    local DROP_TRAVEL_TIMEOUT = 8

    local LastInfiniteLeaveAt = 0

    local function ReadDropPosition(DropState)
        if not DropState or not DropState.position then
            return nil
        end
        local Success, Position = pcall(function()
            return DropState.position:get()
        end)
        if Success and typeof(Position) == "Vector3" then
            return Position
        end
        return nil
    end

    local function RunAutoPickupLoot()
        local Ext = GENV.__AZ_FARM_EXT
        Ext.LootTargetCFrame = nil
        Ext.LootTargetId = nil
        Ext.LootDistance = nil

        if not Settings.AutoPickupLoot then
            LockedDropId = nil
            LockedDropSince = 0
            table.clear(SeenDrops)
            table.clear(LastDropAttempt)
            table.clear(DropAttempts)
            table.clear(DropIgnoreUntil)
            Ext.LootStatus = "Disabled"
            Ext.LootTargetToken = nil
            Ext.LootLastTeleportToken = nil
            return
        end

        if not DropStoreModule
            or not DropStoreModule.store
            or not RewardPackets
            or not RewardPackets.recoverDrop
        then
            Ext.LootStatus = "Drop store/recover packet unavailable"
            return
        end

        local Character = LocalPlayer.Character
        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")
        if not Root then
            Ext.LootStatus = "Waiting for character"
            return
        end

        local Success, Drops = pcall(function()
            return DropStoreModule.store.state:getAll()
        end)
        if not Success or type(Drops) ~= "table" then
            Ext.LootStatus = "Drop store unavailable"
            return
        end

        local Now = os.clock()

        -- Start settle clocks even while another drop is locked, so the
        -- scanner can advance immediately after that drop disappears.
        for Id in pairs(Drops) do
            SeenDrops[Id] = SeenDrops[Id] or Now
        end

        -- A missing ID is our confirmation that a drop was recovered/removed.
        for Id in pairs(SeenDrops) do
            if Drops[Id] == nil then
                SeenDrops[Id] = nil
                LastDropAttempt[Id] = nil
                DropAttempts[Id] = nil
                DropIgnoreUntil[Id] = nil
                if LockedDropId == Id then
                    LockedDropId = nil
                    LockedDropSince = 0
                end
            end
        end

        local function SkipLocked(Reason)
            if LockedDropId ~= nil then
                DropIgnoreUntil[LockedDropId] = Now + DROP_REVISIT_DELAY
                DropAttempts[LockedDropId] = nil
                LastDropAttempt[LockedDropId] = nil
            end
            LockedDropId = nil
            LockedDropSince = 0
            Ext.LootStatus = Reason
        end

        local LockedPosition = LockedDropId ~= nil
            and Drops[LockedDropId]
            and ReadDropPosition(Drops[LockedDropId])
            or nil

        if LockedDropId ~= nil then
            if not LockedPosition then
                SkipLocked("Locked drop became unavailable")
            elseif (DropIgnoreUntil[LockedDropId] or 0) > Now then
                LockedDropId = nil
                LockedDropSince = 0
            elseif Now - LockedDropSince > DROP_TRAVEL_TIMEOUT
                and (Root.Position - LockedPosition).Magnitude > DROP_PICKUP_RANGE
            then
                SkipLocked("Drop unreachable; cooldown")
            elseif (DropAttempts[LockedDropId] or 0) >= DROP_MAX_ATTEMPTS
                and Now - (LastDropAttempt[LockedDropId] or Now) >= DROP_RETRY_TIME
            then
                SkipLocked("Drop not confirmed; cooldown")
            end
        end

        if LockedDropId == nil then
            local BestDistance = math.huge
            for Id, State in pairs(Drops) do
                SeenDrops[Id] = SeenDrops[Id] or Now
                if Now - SeenDrops[Id] >= DROP_SETTLE_TIME
                    and (DropIgnoreUntil[Id] or 0) <= Now
                then
                    local Position = ReadDropPosition(State)
                    if Position then
                        local Distance = (Root.Position - Position).Magnitude
                        if Distance < BestDistance then
                            LockedDropId = Id
                            LockedPosition = Position
                            BestDistance = Distance
                        end
                    end
                end
            end
            if LockedDropId ~= nil then
                LockedDropSince = Now
            end
        end

        if LockedDropId == nil or not LockedPosition then
            Ext.LootStatus = "No eligible drops (or cooldown)"
            return
        end

        local Distance = (Root.Position - LockedPosition).Magnitude
        Ext.LootTargetId = LockedDropId
        Ext.LootTargetToken = tostring(LockedDropId) .. ":" .. tostring(LockedDropSince)
        Ext.LootDistance = Distance

        if Distance <= DROP_PICKUP_RANGE then
            -- The drop is within the game's 12-stud pickup radius. Do not
            -- keep teleporting to its center while confirmation is pending.
            local Attempts = DropAttempts[LockedDropId] or 0
            local LastAttempt = LastDropAttempt[LockedDropId] or -math.huge
            if Attempts < DROP_MAX_ATTEMPTS
                and Now - LastAttempt >= DROP_RETRY_TIME
            then
                DropAttempts[LockedDropId] = Attempts + 1
                LastDropAttempt[LockedDropId] = Now
                local Fired = pcall(function()
                    RewardPackets.recoverDrop:fire(LockedDropId)
                end)
                Ext.LootStatus = (Fired and "Confirming " or "Recover failed ")
                    .. tostring(LockedDropId)
            else
                Ext.LootStatus = "Waiting for pickup confirmation "
                    .. tostring(LockedDropId)
            end
            return
        end

        -- Only the locked ID becomes a movement target. Do not retarget to
        -- a closer coin every frame as animated drops/stores update.
        Ext.LootTargetCFrame = CFrame.new(
            LockedPosition + Vector3.new(0, 2.5, 0)
        )
        Ext.LootStatus = "Approaching " .. tostring(LockedDropId)
    end

    GENV.__AZ_FARM_EXT.GetLootTargetCFrame = function()
        if Settings.AutoPickupLoot then
            return GENV.__AZ_FARM_EXT.LootTargetCFrame
        end
        return nil
    end

    GENV.__AZ_LOOT_STATUS = function()
        local Ext = GENV.__AZ_FARM_EXT
        local Snapshot = {
            targetId = Ext.LootTargetId,
            distance = Ext.LootDistance,
            status = Ext.LootStatus,
            movementGoal = Ext.LootTargetCFrame ~= nil,
            attempts = LockedDropId and (DropAttempts[LockedDropId] or 0) or 0,
        }
        for Key, Value in pairs(Snapshot) do
            print("[Anime Zero][Loot]", Key, "=", tostring(Value))
        end
        return Snapshot
    end


    local function GetInfiniteWave()

        if not InfiniteStoreModule
            or not InfiniteStoreModule.Store
            or not InfiniteStoreModule.Store.state
            or not InfiniteStoreModule.Store.state.Wave
        then
            return nil
        end


        local Success,
            Wave =
            pcall(function()

                return InfiniteStoreModule
                    .Store
                    .state
                    .Wave
                    :get()
            end)


        if Success then
            return tonumber(Wave)
        end


        return nil
    end


    local function RunInfiniteWaveLeave()

        if not Settings.AutoLeaveEndlessAtWave
            or not RunPackets
            or not RunPackets.endAction
            or workspace:GetAttribute(
                "Mode"
            ) ~= "infinite"
        then
            return
        end


        local Wave =
            GetInfiniteWave()


        local TargetWave =
            math.max(
                1,
                tonumber(
                    Settings.EndlessLeaveWave
                ) or 10
            )


        if not Wave
            or Wave < TargetWave
        then
            return
        end


        local Participant =
            RunStore.state
                .participants
                :get(
                    tostring(
                        LocalPlayer.UserId
                    )
                )


        if Participant then

            local TravelStatus =
                Participant.travelStatus:get()


            if TravelStatus ~= "idle" then
                return
            end
        end


        local Now =
            os.clock()


        -- Keep retrying the direct leave action until the run store says
        -- travel has started. This avoids losing a request sent during a
        -- short server transition window.
        if Now
            - LastInfiniteLeaveAt
            < 1.50
        then
            return
        end


        pcall(function()
            local Saver =
                GENV.__AZ_FORCE_CONFIG_SAVE

            if type(Saver) == "function" then
                Saver(
                    "before endless leave",
                    true
                )
            else
                Window:Save()
            end
        end)


        local Fired =
            pcall(function()

                RunPackets
                    .endAction
                    :fire(3)
            end)


        if Fired then

            LastInfiniteLeaveAt =
                Now


            print(
                "[Anime Zero] Auto Leave Endless | Wave:",
                Wave,
                "| Target:",
                TargetWave
            )
        end
    end


    task.spawn(function()

        while SessionAlive() do

            RunAutoPickupLoot()
            RunInfiniteWaveLeave()

            task.wait(0.15)
        end
    end)
end)()


