function Hub:AwaitReply(reply, alive, timeout)
    if not alive() then return false,"Cancelled" end
    if type(reply)~="table" or type(reply.andThen)~="function" then return true,reply end
    local done,accepted,payload=false,false,nil
    local ok,err=pcall(function()
        reply:andThen(function(value)
            if done then return end
            done=true;accepted=true;payload=value
        end):catch(function(reason)
            if done then return end
            done=true;payload=reason
        end)
    end)
    if not ok then return false,tostring(err) end
    local deadline=os.clock()+(timeout or 7)
    while not done and alive() and os.clock()<deadline do task.wait(.06) end
    if not alive() then done=true;return false,"Cancelled" end
    if not done then done=true;return false,"Response timed out" end
    return accepted,payload
end
function Hub:WaitConfirmed(check, alive, timeout)
    local deadline=os.clock()+(timeout or 3)
    repeat
        if not alive() then return false end
        local ok,result=pcall(check)
        if ok and result then return true end
        task.wait(.10)
    until os.clock()>=deadline
    return false
end
