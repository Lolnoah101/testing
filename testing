local function updateFarmCollision(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if Hub.FarmCollisionOriginals[part] == nil then
                Hub.FarmCollisionOriginals[part] = part.CanCollide
            end
