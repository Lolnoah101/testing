function Systems.stepRewards()
    if not Config.AutoDailyReward
        and not Config.AutoGroupReward then
        return
    end

    local now = os.clock()

    if now - State.LastRewardCheck
        < math.max(
            2,
            tonumber(Config.RewardCheckInterval) or 10
        ) then
        return
    end

    State.LastRewardCheck = now

    local data = getPlayerData()

    if Config.AutoDailyReward
        and data
        and type(data.DailyReward) == "table"
        and DailyRewardController
        and DailyRewardController.Claim then

        local state =
            DailyRewardUtil.compute_state(
                data.DailyReward,
                DailyRewardUtil.get_now()
            )

        if state and state.ClaimableDay then
            local ok, claimed = pcall(function()
                return DailyRewardController.Claim:Fire()
            end)

            if ok and claimed == true then
                State.DailyClaims += 1
                State.RewardStatus =
                    "Claimed Daily Reward Day "
                    .. tostring(state.ClaimableDay)
            end
        end
    end

    if Config.AutoGroupReward
        and GroupRewardController
        and GroupRewardController.GetState
        and GroupRewardController.Claim then

        local ok, state = pcall(function()
            return GroupRewardController.GetState:Fire()
        end)

        if ok
            and type(state) == "table"
            and state.enabled == true
            and state.joined == true
            and state.claimed ~= true then

            local ok2, result = pcall(function()
                return GroupRewardController.Claim:Fire()
            end)

            if ok2
                and type(result) == "table"
                and result.ok == true then

                State.GroupClaims += 1
                State.RewardStatus = "Claimed Group Reward"
            end
        end
    end
end

