local function predictedThreat(myRoot)
    local best, bestRemaining = nil, math.huge
    local now = os.clock()
    for track, entry in pairs(Hub.Tracks) do
        local currentPosition = track.TimePosition
        if entry.LastPosition and track.Looped
            and currentPosition + 0.10 < entry.LastPosition then
            entry.Handled, entry.Attempts, entry.NextImpactAt = false, 0, nil
            entry.Expires = now + 5
        end
        entry.LastPosition = currentPosition
        if not track.IsPlaying or now > entry.Expires then
            cleanupTrack(track)
        else
            local record, meta = entry.Record, entry.Meta
            local enemyRoot = record.Root
            if enemyRoot and enemyRoot.Parent and record.Model.Parent and record.Hum.Health > 0 then
                local delta = myRoot.Position - enemyRoot.Position
                local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
                local vertical = math.abs(delta.Y)
                local engaged = (Hub.AutoFarm and Hub.FarmTarget == record)
                    or (Hub.QuestCombatActive and Hub.QuestTarget == record)
                -- Ranged boss moves can matter well beyond melee distance.
                -- A tracked dash/rush may cross the whole local arena.
                local far = meta.Rush and 64 or (meta.Ranged and 52
                    or (meta.AOE and 34 or 14))
                local upper = (engaged and 16 or 11) + (meta.AOE and 8 or 0)
                -- Keep the learned/defensive target aligned with the mob
                -- we're farming. Still defend against a different NPC if it
                -- is actually right next to us.
                local focus=(Hub.AutoQuest and Hub.QuestCombatActive and Hub.QuestTarget)
                    or (Hub.AutoFarm and Hub.FarmTarget)
                if horizontal <= far and vertical <= upper
                    and (not focus or record==focus or horizontal<=11) then
                    local length = track.Length
                    local id = animId(track.Animation)
                    local profile = Hub.LearnAttacks and
                        (entry.Learned or Hub:AttackProfile(record,track,false)) or nil
                    local learnedFraction=profile and (
                        ((profile.MarkerSamples or 0)>=1 and profile.MeanFraction)
                        or ((profile.DamageSamples or 0)>=3 and profile.DamageFraction))
                    local fraction = learnedFraction or (id and knownFractions[id]) or
                        (meta.Kind == "Special" and 0.62 or 0.50)
                    local speed = math.max(math.abs(track.Speed), 0.1)
                    local impact = length > 0 and (length * fraction) or
                        (meta.Kind == "Special" and 0.48 or 0.29)
                    local remaining = length > 0 and (impact - currentPosition)/speed
                        or impact - (now - entry.Started)
                    -- Don't assume every skill has its hit marker on first contact.
                    -- Repeated markers or multi-hit names can schedule followups.
                    if entry.NextImpactAt and entry.NextImpactAt > now - 0.12 then
                        remaining = entry.NextImpactAt - now
                    end
                    if profile and profile.Multi then meta.Multi=true end
                    if profile and (profile.GapSamples or 0)>1 and not entry.MarkerGap then
                        entry.MarkerGap=profile.MarkerGap
                    end
                    local due = not entry.Handled
                    if entry.Handled and meta.Multi and entry.Attempts < 4
                        and entry.NextImpactAt and now + 0.35 >= entry.NextImpactAt then
                        due = true
                    end
                    if due and remaining >= -0.12 and remaining <= 0.90
                        and remaining < bestRemaining then
                        bestRemaining = remaining
                        best = {Entry=entry, OtherRoot=enemyRoot, Record=record,
                            Remaining=remaining, Horizontal=horizontal,
                            Vertical=vertical, Meta=meta, Pattern=profile}
                    end
                end
            end
        end
    end
    return best
end

