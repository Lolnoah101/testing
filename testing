--//============================================================
--// PERSISTENT NOCLIP / TWEEN NOCLIP
--//
--// Tween uses temporary noclip by default. Stay Noclip makes it continuous
--// across farming, rubble attacks, AREA waits, Trials and Raid. The setting
--// controls collisions only, never character position. ForceRestore is used
--// for script unload and re-execution so no collision state is left behind.
--//============================================================

GENV.__AZ_FARM_EXT.TweenNoclipOriginal =
    setmetatable(
        {},
        { __mode = "k" }
    )


GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled = function(
    Enabled, ForceRestore
)

    -- Tidal once forcibly restored collision at the end of EVERY move,
    -- while waiting for waves, on floor/lever checks, and during combat.
    -- That made Stay Noclip ineffective and wedged the avatar on barriers.
    -- Restore the USER'S persistent selection in this mode. The dedicated
    -- Tidal controller still raycasts collidable MAP geometry to select safe
    -- landing positions and recover from actual beneath-map falls.
    local TidalStayNoclip = Settings.StayNoclip == true
        and type(GENV.__AZ_IS_FLOOD_ESCAPE) == "function"
        and GENV.__AZ_IS_FLOOD_ESCAPE()
        and SessionAlive()

    if TidalStayNoclip then
        -- Internal Tidal movement calls ForceRestore for temporary Tween
        -- cleanup, but must not override the user's persistent preference.
        -- Session teardown still restores collisions via SessionAlive().
        Enabled = true
        ForceRestore = false
    elseif ForceRestore == true then
        Enabled = false
    elseif Settings.FarmMethod == "Legit" then
        -- Other modes retain their original grounded Legit behavior.
        Enabled = false
    elseif Settings.StayNoclip == true then
        Enabled = true
    end

    local OriginalParts =
        GENV.__AZ_FARM_EXT.TweenNoclipOriginal


    if Enabled then

        local Character =
            GetCharacter()


        if not Character then
            return
        end


        for _, Part in ipairs(
            Character:GetDescendants()
        ) do

            if Part:IsA(
                "BasePart"
            )
            then

                if OriginalParts[
                    Part
                ] == nil
                then

                    OriginalParts[
                        Part
                    ] =
                        Part.CanCollide
                end


                if Part.CanCollide then
                    Part.CanCollide = false
                end
            end
        end


        return
    end


    for Part, Original in pairs(
        OriginalParts
    ) do

        if Part
            and Part.Parent
        then

            pcall(function()
                Part.CanCollide =
                    Original
            end)
        end


        OriginalParts[Part] =
            nil
    end
end


-- Persistent control is independent of Story/Trials/Raid farm state.
-- Stepped fires before physics so collisions remain disabled even while idle.
GENV.__AZ_FARM_EXT.StayNoclipConnection = RunService.Stepped:Connect(function()
    if not SessionAlive() then return end
    if GENV.__AZ_IS_FLOOD_ESCAPE() then
        local T = GENV.__AZ_TIDAL_RUNTIME
        local InTransit = Settings.AutoTidalFarm == true
            and T and T.tweenTravelActive == true
