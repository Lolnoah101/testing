    local function requestFunction()
        if type(request) == "function" then return request end
        if type(http_request) == "function" then return http_request end
        if type(ENV.request) == "function" then return ENV.request end
        if type(ENV.http_request) == "function" then return ENV.http_request end
        if type(syn) == "table" and type(syn.request) == "function" then return syn.request end
        if type(http) == "table" and type(http.request) == "function" then return http.request end
        return nil
    end
    local function postEmbed(embed)
        if not isValidWebhook(hook.url) then return false, "Invalid or missing Discord webhook URL" end
        local send = requestFunction()
        if not send then return false, "HTTP request API unavailable in this executor" end
        local body = HttpService:JSONEncode({
            username = "HollowMoonHub • Match Tracker",
            allowed_mentions = {parse={}},
            embeds = {embed},
        })
        local ok, response = pcall(send, {
            Url=hook.url,Method="POST",Headers={["Content-Type"]="application/json"},
            Body=body,Timeout=8,
        })
        if not ok then return false, "HTTP request failed" end
        local status = type(response)=="table"
            and tonumber(response.StatusCode or response.Status or response.status_code)
            or nil
        if status == 200 or status == 204 then return true, "Delivered" end
        if status == 429 then return false, "Discord rate limit (429)" end
        return false, "Discord HTTP " .. tostring(status or "no status")
    end
    local function sendWithRetry(embed, key)
        if hook.sending then return end
        hook.sending, hook.sendingSince, hook.pendingKey = true, os.clock(), key
        task.spawn(function()
            local sent, reason = false, "Not attempted"
            for attempt=1,3 do
                if Farm.unloaded or (key and not hook.enabled) then break end
                if not isValidWebhook(hook.url) then reason="Webhook not configured"; break end
                sent, reason = postEmbed(embed)
                if sent then break end
                if attempt < 3 then task.wait(attempt * 1.2) end
            end
            if sent then
                if key and Farm.session then
                    hook.sentThisRun[key] = true
                    Farm.session.webhookLastSentKey = key
                    saveSession()
                end
                do end
                setStatus(key and "Last match delivered" or "Test delivered")
            else
                do end
                setStatus("Not sent: " .. tostring(reason))
            end
            hook.sending, hook.pendingKey = false, nil
        end)
    end

    Farm.onMatchComplete = function(key)
        if not hook.enabled or hook.url == "" or Farm.unloaded then return end
        if hook.sending or hook.collecting or hook.sentThisRun[key]
            or (Farm.session and Farm.session.webhookLastSentKey == key) then return end
        hook.collecting = true
        hook.collectingSince = os.clock()
        hook.pendingKey = key
        -- Guard the whole collector: a UI structure change must never cancel
        -- the actual Discord send or leave collecting=true indefinitely.
        task.spawn(function()
          local collectorOK = pcall(function()
            local nativeResult, nativeDone = nil, false
            task.spawn(function()
                local assets = ReplicatedStorage:FindFirstChild("Assets")
                local remotes = assets and assets:FindFirstChild("Remotes")
                local get = remotes and remotes:FindFirstChild("GET")
                if get and get:IsA("RemoteFunction") then
                    local ok, data = pcall(function()
                        return get:InvokeServer("S_Rewards", "Get")
                    end)
                    if ok then
                        local parsed, result = pcall(decodeNativeObtained, data)
                        if parsed then nativeResult = result end
                    end
                end
                nativeDone = true
            end)
            local bestOrdinary, bestDrops, bestSpecial, bestStats = {}, {}, {}, {}
            local bestScore, lastChange, rootsFound = -1, os.clock(), 0
            local started = os.clock()
            while os.clock() - started < 7.0 do
                if Farm.unloaded or not hook.enabled then
                    hook.collecting, hook.pendingKey = false, nil
                    return
                end
                local okScan, ordinary, drops, special, stats, roots = pcall(collectRewardLines)
                if not okScan then
                    -- Keep the native results fallback; report without rewards
                    -- if the game's GUI contains an unexpected instance type.
                    ordinary, drops, special, stats, roots = {}, {}, {}, {}, 0
                    setStatus("Results UI changed; using native reward data")
                end
                rootsFound = math.max(rootsFound, roots or 0)
                local score = #ordinary * 5 + #drops * 3 + #special * 3 + #stats
                if score > bestScore then
                    bestScore = score
                    bestOrdinary, bestDrops = ordinary, drops
                    bestSpecial, bestStats = special, stats
                    lastChange = os.clock()
                end
                if #bestOrdinary > 0 and os.clock() - lastChange >= 1.2
                    and os.clock() - started >= 1.6 then break end
                task.wait(0.25)
            end
            if Farm.unloaded or not hook.enabled then
                hook.collecting, hook.pendingKey = false, nil
                return
            end
            if nativeResult then
                -- The server's match Obtained table is authoritative for
                -- earned rewards; the visible UI can still supply extra stats.
                if #nativeResult.rewards > 0 then bestOrdinary = nativeResult.rewards end
                if #nativeResult.drops > 0 then bestDrops = nativeResult.drops end
                if #nativeResult.special > 0 then bestSpecial = nativeResult.special end
                if #bestStats == 0 and #nativeResult.stats > 0 then
                    bestStats = nativeResult.stats
                end
            end
            do end
            if #bestOrdinary == 0 then
                do end
            end
            if #bestDrops == 0 then
                do end
            end
            if #bestOrdinary == 0 then
                pcall(writeMissingRewardDiagnostic, key, #bestOrdinary, #bestDrops)
            end
            local embed = buildEmbed(false, bestOrdinary, bestDrops, bestSpecial, bestStats)
            hook.collecting = false
            sendWithRetry(embed, key)
          end)
          if not collectorOK then
              -- Even on an unexpected parser/formatter error, deliver the
              -- completion report. No rewards are invented or silently lost.
              hook.collecting = false
              local ok, fallback = pcall(buildEmbed, false, {}, {}, {}, {})
              if ok then
                  setStatus("Reward scan failed; sending match summary")
                  sendWithRetry(fallback, key)
              else
                  hook.pendingKey = nil
                  setStatus("Match report formatting failed")
              end
          end
        end)
    end

