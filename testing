-- Bounded, de-duplicated event log. It never logs on every Heartbeat.
-- Console printing is opt-in; the panel and copy command always work.
function Hub.QuestFns.questDebugEvent(kind, detail)
    if not Hub.Running then return end
    local message = tostring(detail or "")
    if #message > 280 then message = message:sub(1,277).."..." end
    local key = tostring(kind).."|"..message
    local now = os.clock()
    Hub.QuestDebugLatest = tostring(kind).." | "..message
    if not Hub.QuestDebugEnabled then return end
    if Hub.QuestDebugLastKey == key and now - Hub.QuestDebugLastAt < 6 then return end
    Hub.QuestDebugLastKey, Hub.QuestDebugLastAt = key, now
    local row = {Time = string.format("+%.1fs",now-Hub.QuestDebugSince),
        Kind = tostring(kind), Detail = message}
    local events = Hub.QuestDebugEvents
    table.insert(events, row)
    if #events > 80 then table.remove(events, 1) end
    if Hub.QuestDebugConsole then
        print("[HollowMoon Quest] "..row.Time.." "..row.Kind.." | "..row.Detail)
    end
end
function Hub.QuestFns.questStatus(phase, message)
    if Hub.QuestPhase == phase and Hub.QuestStatus == message then return end
    Hub.QuestPhase, Hub.QuestStatus = phase, message
    Hub.QuestFns.questDebugEvent("PHASE: "..tostring(phase), message)
    if QuestAutomationDisplay then
        pcall(function() QuestAutomationDisplay:Set(phase .. " | " .. message) end)
    end
end
