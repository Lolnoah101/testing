--========================================================

local TaxiAPI = {}

do
    local Taxi = {
        Thread = nil,
        MoveGeneration = 0,
        PickupTarget = nil,
        DestinationTarget = nil,
        Accepted = false,
        WaitingForFinish = false,
        LastConfirmAt = 0,
        LastStatus = "",
        LastStatusAt = 0,
    }

    local Phone =
        Remotes:WaitForChild(
            "Phone"
        )

    local function TaxiStatus(
        Message,
        Delay
    )
        Delay = Delay or 0

        if Taxi.LastStatus == Message
            and os.clock() - Taxi.LastStatusAt < Delay
        then
            return
        end

        Taxi.LastStatus = Message
        Taxi.LastStatusAt = os.clock()

        print(
            "[Taxi] " .. tostring(Message)
        )
    end

    local function GetTaxiCar()
        local Vehicles =
            Workspace:FindFirstChild(
                "Vehicles"
            )

        if not Vehicles then
            return nil
        end

        local Car =
            Vehicles:FindFirstChild(
                Player.Name
                .. "'s Car"
            )

        if not Car
            or not Car:IsA("Model")
            or Car:GetAttribute("Exploded") == true
        then
            return nil
        end

        return Car
    end

    local function GetTaxiDriveSeat(
        Car
    )
        if not Car
            or not Car.Parent
        then
            return nil
        end

        local Named =
            Car:FindFirstChild(
                "DriveSeat",
                true
            )

        if Named
            and Named:IsA("VehicleSeat")
        then
            return Named
        end

        for _, Object in ipairs(
            Car:GetDescendants()
        ) do
            if Object:IsA("VehicleSeat") then
                return Object
            end
        end

        return nil
    end

    local function GetTaxiNPC()
        local Storage =
            Workspace:FindFirstChild(
                "Storage"
            )

        return Storage
            and Storage:FindFirstChild(
                "NPC " .. Player.Name
            )
            or nil
    end

    local function IsTaxiPassengerSeated()
        local NPC =
            GetTaxiNPC()

        if not NPC then
            return false
        end

        local Humanoid =
            NPC:FindFirstChildOfClass(
                "Humanoid"
            )

        return Humanoid
            and Humanoid.Sit == true
            or false
    end

    local function GetTaxiTargetPosition(
        Target
    )
        if not Target
            or not Target.Parent
        then
            return nil
        end

        if Target:IsA("BasePart") then
            local Selection =
                Target:FindFirstChild(
                    "Selection"
                )

            if Selection
                and Selection:IsA("BasePart")
            then
                return Selection.Position
            end

            return Target.Position
        end

        if Target:IsA("Attachment") then
            return Target.WorldPosition
        end

        if Target:IsA("Model") then
            local Selection =
                Target:FindFirstChild(
                    "Selection",
                    true
                )

            if Selection
                and Selection:IsA("BasePart")
            then
                return Selection.Position
            end

            if Target.PrimaryPart then
                return Target.PrimaryPart.Position
            end

            local Success, Pivot =
                pcall(function()
                    return Target:GetPivot()
                end)

            if Success then
                return Pivot.Position
            end
        end

        return nil
    end

    local function RequestTaxiStreaming(
        Position
    )
        if not Position then
            return
        end

        task.spawn(function()
            pcall(function()
                Player:RequestStreamAroundAsync(
                    Position,
                    2
                )
            end)
        end)
    end

    local function StopTaxiVehicleMotion()
        Taxi.MoveGeneration += 1

        local Car =
            GetTaxiCar()

        local Seat =
            GetTaxiDriveSeat(
                Car
            )

        if Seat then
            Seat.AssemblyLinearVelocity =
                Vector3.zero

            Seat.AssemblyAngularVelocity =
                Vector3.zero
        end
    end

    local function EnsureTaxiDriver()
        local Car =
            GetTaxiCar()

        if not Car then
            TaxiStatus(
                "No usable car found",
                2
            )

            return false
        end

        local Seat =
            GetTaxiDriveSeat(
                Car
            )

        if not Seat then
            TaxiStatus(
                "DriveSeat not found",
                2
            )

            return false
        end

        local Humanoid =
            GetHumanoid()

        if Seat.Occupant == Humanoid then
            return true
        end

        if Seat.Occupant
            and Seat.Occupant ~= Humanoid
        then
            TaxiStatus(
                "Driver seat is occupied",
                2
            )

            return false
        end

        local Prompt =
            Seat:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

        local RootPart =
            GetRootPart()

        local MaxDistance =
            Prompt
            and tonumber(
                Prompt.MaxActivationDistance
            )
            or 8

        if (
            RootPart.Position
            - Seat.Position
        ).Magnitude
            > math.max(
                3,
                MaxDistance - 1
            )
        then
            TaxiStatus(
                "Going to driver seat"
            )

            local Reached =
                MoveToJobTarget(
                    GetTargetCFrame(
                        Seat
                    ),

                    function()
                        return Settings.AutoTaxi
                    end
                )

            if not Reached
                or not Settings.AutoTaxi
            then
                return false
            end
        end

        if Prompt
            and Prompt.Parent
            and Prompt.Enabled
        then
            TriggerPrompt(
                Prompt
            )
        end

        local Started =
            os.clock()

        while Settings.AutoTaxi
            and os.clock() - Started < 2.5
        do
            if Seat.Occupant == Humanoid then
                return true
            end

            task.wait(0.1)
        end

        pcall(function()
            Seat:Sit(
                Humanoid
            )
        end)

        Started =
            os.clock()

        while Settings.AutoTaxi
            and os.clock() - Started < 2
        do
            if Seat.Occupant == Humanoid then
                return true
            end

            task.wait(0.1)
        end

        TaxiStatus(
            "Could not enter driver seat",
            2
        )

        return false
    end

    local function GetTaxiCarGroundOffset(
        Car
    )
        if not Car then
            return 2.5
        end

        local Success,
            BoxCFrame,
            BoxSize =
            pcall(function()
                local CFrameValue,
                    SizeValue =
                    Car:GetBoundingBox()

                return CFrameValue,
                    SizeValue
            end)

        if not Success
            or not BoxCFrame
            or not BoxSize
        then
            return 2.5
        end

        local BottomY =
            BoxCFrame.Position.Y
            - (BoxSize.Y / 2)

        local PivotY =
            Car:GetPivot().Position.Y

        return math.clamp(
            PivotY - BottomY,
            1.25,
            6
        )
    end

    local function ComputeTaxiPath(
        StartPosition,
        TargetPosition
    )
        local Offsets = {
            Vector3.zero,
            Vector3.new(6, 0, 0),
            Vector3.new(-6, 0, 0),
            Vector3.new(0, 0, 6),
            Vector3.new(0, 0, -6),
            Vector3.new(10, 0, 0),
            Vector3.new(-10, 0, 0),
            Vector3.new(0, 0, 10),
            Vector3.new(0, 0, -10),
        }

        for _, Offset in ipairs(
            Offsets
        ) do
            local Path =
                PathfindingService:CreatePath({
                    AgentRadius = 4,
                    AgentHeight = 4,
                    AgentCanJump = false,
                    AgentCanClimb = false,
                    WaypointSpacing = 8,
                })

            local Candidate =
                TargetPosition
                + Offset

            local Success =
                pcall(function()
                    Path:ComputeAsync(
                        StartPosition,
                        Candidate
                    )
                end)

            if Success
                and Path.Status
                    == Enum.PathStatus.Success
            then
                local Waypoints =
                    Path:GetWaypoints()

                if #Waypoints >= 2 then
                    local Points = {}

                    for _, Waypoint in ipairs(
                        Waypoints
                    ) do
                        table.insert(
                            Points,
                            Waypoint.Position
                        )
                    end

                    -- Taxi pickup/destination parts sit directly on
                    -- the road.  If navmesh ended a few studs beside
                    -- the marker, finish with a short local segment so
                    -- the car actually enters the target zone.
                    if (
                        Points[#Points]
                        - TargetPosition
                    ).Magnitude > 2
                    then
                        table.insert(
                            Points,
                            TargetPosition
                        )
                    end

                    return Points
                end
            end
        end

        return nil
    end

    local function FollowTaxiVehiclePath(
        Car,
        Points
    )
        if not Car
            or not Car.Parent
            or not Points
            or #Points == 0
        then
            return false
        end

        local Generation =
            Taxi.MoveGeneration

        local GroundOffset =
            GetTaxiCarGroundOffset(
                Car
            )

        local Speed =
            math.max(
                10,
                tonumber(
                    Settings.TweenSpeed
                ) or 80
            )

        for Index,
            Point in ipairs(
                Points
            )
        do
            if not Settings.AutoTaxi
                or Generation
                    ~= Taxi.MoveGeneration
                or not Car.Parent
            then
                return false
            end

            local TargetPosition =
                Vector3.new(
                    Point.X,
                    Point.Y + GroundOffset,
                    Point.Z
                )

            local Started =
                os.clock()

            while Settings.AutoTaxi
                and Generation
                    == Taxi.MoveGeneration
                and Car.Parent
            do
                local CurrentPivot =
                    Car:GetPivot()

                local CurrentPosition =
                    CurrentPivot.Position

                local Difference =
                    TargetPosition
                    - CurrentPosition

                local Distance =
                    Difference.Magnitude

                if Distance <= 2.5 then
                    break
                end

                if os.clock() - Started > 12 then
                    return false
                end

                local DeltaTime =
                    RunService.Heartbeat:Wait()

                local Step =
                    math.min(
                        Distance,
                        Speed * DeltaTime
                    )

                local Direction =
                    Difference.Unit

                local NewPosition =
                    CurrentPosition
                    + Direction * Step

                local FlatDirection =
                    Vector3.new(
                        Direction.X,
                        0,
                        Direction.Z
                    )

                local NewCFrame

                if FlatDirection.Magnitude > 0.01 then
                    NewCFrame =
                        CFrame.lookAt(
                            NewPosition,
                            NewPosition
                            + FlatDirection.Unit
                        )
                else
                    NewCFrame =
                        CFrame.new(
                            NewPosition
                        )
                end

                pcall(function()
                    Car:PivotTo(
                        NewCFrame
                    )
                end)

                local Seat =
                    GetTaxiDriveSeat(
                        Car
                    )

                if Seat then
                    Seat.AssemblyLinearVelocity =
                        Vector3.zero

                    Seat.AssemblyAngularVelocity =
                        Vector3.zero
                end
            end
        end

        local Seat =
            GetTaxiDriveSeat(
                Car
            )

        if Seat then
            Seat.AssemblyLinearVelocity =
                Vector3.zero

            Seat.AssemblyAngularVelocity =
                Vector3.zero
        end

        return true
    end

    local function MoveTaxiCarTo(
        Target,
        Label
    )
        local TargetPosition =
            GetTaxiTargetPosition(
                Target
            )

        if not TargetPosition then
            TaxiStatus(
                "Missing target for: "
                .. tostring(Label),
                2
            )

            return false
        end

        RequestTaxiStreaming(
            TargetPosition
        )

        if not EnsureTaxiDriver() then
            return false
        end

        local Car =
            GetTaxiCar()

        if not Car then
            return false
        end

        local StartPosition =
            Car:GetPivot().Position

        if (
            StartPosition
            - TargetPosition
        ).Magnitude <= 9
        then
            return true
        end

        TaxiStatus(
            "Going to: "
            .. tostring(Label)
        )

        local Points =
            ComputeTaxiPath(
                StartPosition,
                TargetPosition
            )

        if not Points then
            TaxiStatus(
                "Couldn't find a vehicle route to: "
                .. tostring(Label),
                2
            )

            return false
        end

        return FollowTaxiVehiclePath(
            Car,
            Points
        )
    end

    local function WaitForTaxiNPC(
        Timeout
    )
        local Started =
            os.clock()

        while Settings.AutoTaxi
            and os.clock() - Started
                < Timeout
        do
            local NPC =
                GetTaxiNPC()

            if NPC then
                return NPC
            end

            task.wait(
                Settings.TaxiStateDelay
            )
        end

        return nil
    end

    local function HandleTaxiTrip()
        local PickupTarget =
            Taxi.PickupTarget

        local DestinationTarget =
            Taxi.DestinationTarget

        if not PickupTarget
            or not PickupTarget.Parent
            or not DestinationTarget
            or not DestinationTarget.Parent
        then
            return false
        end

        local NPC =
            WaitForTaxiNPC(
                Settings.TaxiPassengerWaitTimeout
            )

        if not NPC then
            TaxiStatus(
                "Waiting for taxi passenger",
                2
            )

            return false
        end

        if not IsTaxiPassengerSeated() then
            if not MoveTaxiCarTo(
                PickupTarget,
                "customer pickup"
            ) then
                return false
            end

            TaxiStatus(
                "Waiting for customer to enter"
            )

            local Started =
                os.clock()

            while Settings.AutoTaxi
                and Taxi.PickupTarget
                    == PickupTarget
                and os.clock() - Started
                    < Settings.TaxiPassengerWaitTimeout
            do
                if IsTaxiPassengerSeated() then
                    break
                end

                task.wait(
                    Settings.TaxiStateDelay
                )
            end

            if not IsTaxiPassengerSeated() then
                TaxiStatus(
                    "Customer did not enter - retrying pickup",
                    2
                )

                return false
            end
        end

        TaxiStatus(
            "Customer seated"
        )

        if not MoveTaxiCarTo(
            DestinationTarget,
            "destination"
        ) then
            return false
        end

        Taxi.WaitingForFinish =
            true

        TaxiStatus(
            "At destination - waiting for completion"
        )

        local Started =
            os.clock()

        while Settings.AutoTaxi
            and Taxi.DestinationTarget
                == DestinationTarget
            and os.clock() - Started
                < Settings.TaxiDestinationWaitTimeout
        do
            task.wait(
                Settings.TaxiStateDelay
            )
        end

        if Taxi.DestinationTarget
            == DestinationTarget
        then
            Taxi.WaitingForFinish =
                false

            TaxiStatus(
                "Trip not finished yet - retrying destination",
                2
            )

            return false
        end

        return true
    end

    Phone.OnClientEvent:Connect(function(
        Action,
        Arg1,
        Arg2
    )
        if not Settings.AutoTaxi then
            return
        end

        if Action == "NewTaxi" then
            if Taxi.PickupTarget
                or Taxi.DestinationTarget
                or GetTaxiNPC()
            then
                return
            end

            if os.clock()
                    - Taxi.LastConfirmAt
                    < 1.5
            then
                return
            end

            Taxi.LastConfirmAt =
                os.clock()

            local Customer =
                type(Arg1) == "table"
                and tostring(
                    Arg1[1]
                    or "customer"
                )
                or "customer"

            TaxiStatus(
                "New customer: "
                .. Customer
                .. " - accepting"
            )

            Taxi.Accepted =
                true

            Phone:FireServer(
                "ConfirmedTaxi",
                "Bruh"
            )

            return
        end

        if Action == "DestinationTaxi" then
            Taxi.PickupTarget =
                Arg1

            Taxi.DestinationTarget =
                Arg2

            Taxi.Accepted =
                true

            Taxi.WaitingForFinish =
                false

            TaxiStatus(
                "Trip assigned"
            )

            local PickupPosition =
                GetTaxiTargetPosition(
                    Arg1
                )

            local DestinationPosition =
                GetTaxiTargetPosition(
                    Arg2
                )

            RequestTaxiStreaming(
                PickupPosition
            )

            RequestTaxiStreaming(
                DestinationPosition
            )

            return
        end

        if Action == "FinishedTaxi" then
            Taxi.PickupTarget =
                nil

            Taxi.DestinationTarget =
                nil

            Taxi.Accepted =
                false

            Taxi.WaitingForFinish =
                false

            TaxiStatus(
                "Trip completed - waiting for next customer"
            )
        end
    end)

    TaxiAPI.HasUsableCar =
        function()
            return GetTaxiCar()
                ~= nil
        end

    TaxiAPI.Start =
        function()
            if Taxi.Thread then
                return
            end

            Taxi.Thread =
                task.spawn(function()
                    local Success,
                        Error =
                        xpcall(
                            function()
                                TaxiStatus(
                                    "Started - waiting for customer"
                                )

                                while Settings.AutoTaxi do
                                    if not GetTaxiCar() then
                                        TaxiStatus(
                                            "Car is missing - waiting",
                                            2
                                        )

                                        task.wait(
                                            1
                                        )

                                    elseif Taxi.PickupTarget
                                        and Taxi.DestinationTarget
                                    then
                                        local Worked =
                                            HandleTaxiTrip()

                                        if not Worked then
                                            task.wait(
                                                Settings.TaxiRetryDelay
                                            )
                                        end

                                    else
                                        task.wait(
                                            Settings.TaxiStateDelay
                                        )
                                    end
                                end
                            end,

                            debug.traceback
                        )

                    Taxi.Thread =
                        nil

                    StopTaxiVehicleMotion()

                    if not Success then
                        warn(
                            "[Taxi] Worker error:\n"
                            .. tostring(
                                Error
                            )
                        )

                        if Settings.AutoTaxi then
                            task.wait(0.5)
                            TaxiAPI.Start()
                            return
                        end
                    end

                    print(
                        "[Taxi] Stopped"
                    )
                end)
        end

    TaxiAPI.Stop =
        function()
            local WasActive =
                Settings.AutoTaxi
                or Taxi.Accepted
                or Taxi.PickupTarget ~= nil
                or Taxi.DestinationTarget ~= nil
                or GetTaxiNPC() ~= nil

            Settings.AutoTaxi =
                false

            StopJobMovement()
            StopTaxiVehicleMotion()

            if WasActive then
                pcall(function()
                    Phone:FireServer(
                        "QuitTaxi",
                        "Bruh"
                    )
                end)
            end

            Taxi.PickupTarget =
                nil

            Taxi.DestinationTarget =
                nil

            Taxi.Accepted =
                false

            Taxi.WaitingForFinish =
                false
        end
end


