function Hub.QuestFns.findGiver(id, myRoot)
    -- Stream-aware: read only a few known quest folders. Never treat an
    -- unloaded Instance cached from an old visit as interactable.
    local now = os.clock()
    local cached = Hub.QuestGiverScanCache[id]
    if cached and now-cached.At<1.5 then
        if cached.Found and cached.Found.Part and cached.Found.Part.Parent then
            return cached.Found
        end
        if not cached.Found then return nil end
    end
    local world=workspace:FindFirstChild("World")
    local all={}
    local savedAnchor=Hub.CapturedQuestGivers[id]
    local function offer(inst,pos,isBoard,reason)
        if typeof(pos)~="Vector3" then return end
        -- A side quest must not pick an unrelated NPC with a similar display
        -- name elsewhere on the map instead of its verified saved anchor.
        if savedAnchor and not isBoard and (pos-savedAnchor).Magnitude>75 then return end
        table.insert(all,{Part=inst,Position=pos,Board=isBoard,Source=reason})
    end
    local boards=world and world:FindFirstChild("Quest Boards")
    if boards then
        for _,board in ipairs(boards:GetChildren()) do
            local panel=board:FindFirstChild("Board")
            if panel then
                for _,entry in ipairs(panel:GetDescendants()) do
                    if entry:GetAttribute("Quest")==id or entry:GetAttribute("QuestId")==id then
                        offer(board,Hub.QuestFns.objPosition(board) or Hub.QuestFns.objPosition(panel),true,"Quest board")
                        break
                    end
                end
            end
        end
    end
    local expectedNpc=nil
    local ok,config=pcall(function()
        return require(ReplicatedStorage.Shared.Data.ExplorativeQuestConfig)
    end)
    if ok and type(config)=="table" and type(config.Quests)=="table" then
        local item=config.Quests[id]
        expectedNpc=type(item)=="table" and item.NpcDisplayName or nil
    end
    local folders={world and world:FindFirstChild("Quests"),
        world and world:FindFirstChild("NPCs"),
        workspace:FindFirstChild("ExplorativeQuests")}
    for _,folder in pairs(folders) do
        if folder then
            for _,npc in ipairs(folder:GetChildren()) do
                local questId=npc:GetAttribute("Quest") or npc:GetAttribute("QuestName")
                    or npc:GetAttribute("QuestId") or npc.Name
                local npcName=tostring(npc:GetAttribute("DisplayName") or npc.Name):lower()
                local matchesQuest=questId==id
                local matchesNpc=type(expectedNpc)=="string" and #expectedNpc>2
                    and (npcName:find(expectedNpc:lower(),1,true)~=nil)
                if matchesQuest or matchesNpc then
                    offer(npc,Hub.QuestFns.objPosition(npc),false,matchesNpc and "NPC name" or "Quest attribute")
                end
            end
        end
    end
    local anchorFolder=workspace:FindFirstChild("ExplorativeQuests")
    anchorFolder=anchorFolder and anchorFolder:FindFirstChild(id)
    local anchors=anchorFolder and anchorFolder:FindFirstChild("NpcAnchor")
    if anchors then
        for _,part in ipairs(anchors:GetChildren()) do
            if part:IsA("BasePart") then offer(part,part.Position,false,"Quest NPC anchor") end
        end
    end
    table.sort(all,function(a,b)
        local priority={ ["Quest NPC anchor"]=1,["Quest attribute"]=2,
            ["NPC name"]=3,["Quest board"]=4 }
        local ap=priority[a.Source] or 5
        local bp=priority[b.Source] or 5
        if ap~=bp then return ap<bp end
        return (a.Position-myRoot.Position).Magnitude < (b.Position-myRoot.Position).Magnitude
    end)
    local found=all[1]
    Hub.QuestGiverScanCache[id]={At=now,Found=found}
    if found then
        Hub.QuestKnownGivers[id]=found.Position
        Hub.QuestGiverStatus=tostring(found.Source).." | "..tostring(found.Part.Name)
            .." | "..math.floor((found.Position-myRoot.Position).Magnitude).." studs"
    else
        local saved=Hub.CapturedQuestGivers[id]
        if typeof(saved)=="Vector3" then
            Hub.QuestKnownGivers[id]=saved
            Hub.QuestGiverStatus="Giver not streamed; captured NpcAnchor available"
        else
            Hub.QuestGiverStatus=(expectedNpc and ("Not streamed: "..expectedNpc)
                or "No quest giver/board streamed")
        end
    end
    return found
end
