    local function RunAchievementGrinder()

        if Advanced.AutoAchievementGrinder
            ~= true
        then

            return
        end


        -- The simplified Achievement toggle covers every objective the
        -- current automation knows how to farm. No selection dropdown.
        if AchievementConfig and type(AchievementConfig.order) == "table" then
            Advanced.AchievementTargets = Advanced.AchievementTargets or {}
            for _, Id in ipairs(AchievementConfig.order) do
                local Definition = AchievementConfig.achievements[Id]
                if Definition and type(Definition.Title) == "string" then
                    -- Select all titles for reward claiming. NextAchievement
                    -- independently skips kinds the grinder cannot automate.
                    Advanced.AchievementTargets[Definition.Title] = true
                end
            end
        end

        CaptureRunSnapshot()


        local Data =
            GetData()


        if not Data then
            return
        end


        local Definition =
            NextAchievement(
                Data
            )


        if not Definition then

            -- Claim selected completed rewards before ending.
            if Advanced
                .AutoClaimAchievementRewards
                == true
                and IsLobby()
            then

                for _, Id in ipairs(
                    AchievementConfig
                    and AchievementConfig.order
                    or {}
                ) do

                    local Item =
                        AchievementConfig
                            .achievements[
                                Id
                            ]


                    if Item
                        and Advanced.AchievementTargets[
                            Item.Title
                        ] == true
                        and IsAchievementComplete(
                            Data,
                            Id
                        )
                        and not IsAchievementClaimed(
                            Data,
                            Id
                        )
                    then

                        ClaimAchievement(
                            Data,
                            Item
                        )


                        SetState(
                            "Achievement Grinder: claiming "
                            .. Item.Title
                        )


                        return
                    end
                end
            end


            StopAchievementGrinder(
                "All selected supported achievements are complete."
            )


            return
        end


        local Objective =
            Definition.Objective
            or {}


        local Kind =
            tostring(
                Objective.Kind
                or ""
            )


        local Goal =
            tonumber(
                Objective.Goal
            ) or 0


        local Progress =
            AchievementProgress(
                Data,
                Definition.Id
            )


        if Kind
            == "DungeonCompleted"
        then

            local Difficulty =
                Objective.Difficulty
                or "Easy"


            ApplyStory(
                "Act 1",
                Difficulty,
                Definition.Id
            )


        elseif Kind
            == "BossDefeated"
        then

            ApplyStory(
                "Act 1",
                "Easy",
                Definition.Id
            )


        elseif Kind
            == "MaterialCollected"
        then

            ApplyStory(
                "Act 1",
                "Nightmare",
                Definition.Id
            )


        elseif Kind
            == "InfiniteWaveReached"
        then

            ApplyInfinite(
                Goal,
                "Easy",
                Definition.Id
            )


        elseif Kind
            == "CurrencyEarned"
        then

            ApplyStory(
                "Act 1",
                "Nightmare",
                Definition.Id
            )


        elseif Kind
            == "DistinctCharactersEvolved"
        then

            if DelegateEvolutionAchievement(
                Data
            )
            then

                SetState(
                    "Achievement Grinder: delegating "
                    .. Definition.Title
                    .. " to Full Auto Evolve"
                )

            else

                SetState(
                    "Achievement Grinder: "
                    .. Definition.Title
                    .. " needs another unevolved owned character"
                )
            end


            return


        elseif Kind
            == "AccessoryCrafted"
            or Kind
                == "DistinctAccessoriesCrafted"
            or Kind
                == "AllLaunchAccessoriesCrafted"
        then

            if DelegateCraftAchievement() then

                SetState(
                    "Achievement Grinder: delegating "
                    .. Definition.Title
