local function HasActiveStun(
    Store,
    IgnoreM1
)

    if not Store then
        return false
    end


    local Now =
        workspace:GetServerTimeNow()


    local Success,
        Stuns =
        pcall(function()

            return Store
                .state
                .stuns
                :getAll()
        end)


    if not Success
        or not Stuns
    then

        return false
    end


    for StunName, Stun
        in pairs(
            Stuns
        )
    do

        -- Updated skill input ignores the short M1 stun, while M1 itself
        -- still treats every active stun as blocking.
        if not (IgnoreM1 and StunName == "m1") then

            local SuccessTill,
                Till =
                pcall(function()

                    return Stun
                        .till
                        :get()
                end)


            if SuccessTill
                and Till
                and Now < Till
            then

                return true
            end
        end
    end


    return false
end


