function Hub:V44WeaponTick(now)
    local E=self.V44
    if not E.AutoBestWeapon or now<(E.WeaponAt or 0) then return end
    E.WeaponAt=now+0.28
    local char,root,hum=myCharacter()
    if not char then E.WeaponStatus="Waiting for respawn";E.WeaponCached=nil;return end
    -- A tool has to stay temporarily equipped for mining/fishing to work.
    if E.ActivityOwner=="Fishing" or E.ActivityOwner=="Mining"
        or E.ActivityOwner=="Crafting" or self.ChestSession then
        E.WeaponStatus="Paused for "..tostring(E.ActivityOwner or "chest collection")
        return
    end
    local H=self.Progression
    local best=E.WeaponCached
    if not best or now>=(E.WeaponScanAt or 0) or not best.Item or not best.Item.Parent then
        local data=self:V44Data()
        local inventory=data and data:FindFirstChild("Inventory")
        local list=H and H.itemList and H.itemList()
        if not inventory or not list then E.WeaponStatus="Waiting for weapon inventory";return end
        best=nil
        for _,item in ipairs(inventory:GetChildren()) do
            local info=H.itemInfo(item:GetAttribute("item_id"),list)
            if type(info)=="table" and info.Type=="Weapon" then
                local label=(tostring(info.ItemName or "").." "..tostring(info.WeaponType or "")
                    .." "..tostring(item:GetAttribute("item_id") or "")):lower()
                if not label:find("fist",1,true) and not label:find("unarmed",1,true)
                    and not label:find("bare hands",1,true)
                    and (not H.levelGate or H.levelGate(info,item)~=false) then
                    local score=self:V44WeaponScore(info)
                    if not best or score>best.Score then
                        best={UUID=tostring(item.Name),Name=tostring(info.ItemName or item.Name),
                            Score=score,Item=item}
                    end
                end
            end
        end
        E.WeaponCached=best
        E.WeaponScanAt=now+4.5
    end
    if not best then E.WeaponStatus="No eligible non-fist weapon owned";return end
    local function isDesired(tool)
        return tool and tool:IsA("Tool") and
            (tostring(tool:GetAttribute("UUID"))==best.UUID
            or tostring(tool:GetAttribute("ItemUUID"))==best.UUID
            or tool.Name==best.Name)
    end
    local active=char:FindFirstChildOfClass("Tool")
    if isDesired(active) then E.WeaponStatus="Equipped: "..best.Name;return end
    -- Locally available tool can be re-equipped immediately after manual unequip.
    local bag=LocalPlayer:FindFirstChildOfClass("Backpack")
    local ready=nil
    if bag then
        for _,tool in ipairs(bag:GetChildren()) do
            if isDesired(tool) then ready=tool;break end
        end
    end
    if ready and (not char:HasTag("TrueStunned")) then
        local ok=pcall(function() hum:EquipTool(ready) end)
        E.WeaponStatus=ok and ("Re-equipping "..best.Name) or "EquipTool failed"
        E.WeaponAt=now+0.3
        return
    end
    if self:InventoryBusy() then E.WeaponStatus="Waiting for inventory worker";return end
    if self.Runtime and self.Runtime.Jobs and self.Runtime.Jobs.v59_best_weapon then return end
    if now<(E.WeaponRemoteAt or 0) then return end
    E.WeaponRemoteAt=now+1.1
    local service=self:V44Service("InventoryService")
    if not service then E.WeaponStatus="InventoryService unavailable";return end
    E.WeaponStatus="Restoring "..best.Name
    self:StartJob("v59_best_weapon",nil,function(alive)
        if not alive() or not E.AutoBestWeapon then return end
        local sent,reply=pcall(function() return service:put_in_hotbar_backpack(best.UUID) end)
        if sent then self:AwaitReply(reply,alive,3) end
        if not alive() or not E.AutoBestWeapon then return end
        local accepted,req=pcall(function() return service:equip(best.UUID) end)
        if accepted then self:AwaitReply(req,alive,3) end
        if not alive() then return end
        local confirmed=self:WaitConfirmed(function()
            local c=LocalPlayer.Character
            return c and isDesired(c:FindFirstChildOfClass("Tool"))
        end,alive,1.5)
        E.WeaponStatus=confirmed and ("Equipped: "..best.Name) or ("Retrying equip: "..best.Name)
        E.WeaponAt=os.clock()+(confirmed and .4 or 1.2)
    end)
end
function Hub:V44MissionTick(now)
    local E=self.V44
    if not E.AutoMissions or now<E.MissionAt then return end
    E.MissionAt=now+10
    local isHunter=LocalPlayer:GetAttribute("IsHunter")==true
