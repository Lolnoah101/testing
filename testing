            local Constants = Global and Global:FindFirstChild("constants")
            local Module = Config and Config:FindFirstChild("evolutionConfig")
            local CharactersModule = Constants and Constants:FindFirstChild("characters")
            if not Module or not CharactersModule then return end
            local Success, EvoConfig = pcall(require, Module)
            local NamesOk, NamesData = pcall(require, CharactersModule)
            if not Success or not NamesOk or type(EvoConfig) ~= "table"
                or type(NamesData) ~= "table"
