local function getExecutorFileFunction(name)
    local env =
        (getgenv and getgenv())
        or _G

    local value =
        env and rawget(env, name)

    if type(value) == "function" then
        return value
    end

    value =
        rawget(_G, name)

    if type(value) == "function" then
        return value
    end

    return nil
end

local function sanitizeForJson(value, depth)
    depth = depth or 0

    if depth > 8 then
        return nil
    end

    local kind =
        typeof(value)

    if kind == "boolean"
        or kind == "number"
        or kind == "string" then

        return value
    end

    if kind ~= "table" then
        return nil
    end

    local out = {}

    for key, child in pairs(value) do
        if type(key) == "string"
            or type(key) == "number" then

            local clean =
                sanitizeForJson(
                    child,
                    depth + 1
                )

            if clean ~= nil then
                out[key] = clean
            end
        end
    end

    return out
end

function Systems.loadLocalAutoSave()
    local isfileFn =
        getExecutorFileFunction("isfile")

    local readfileFn =
        getExecutorFileFunction("readfile")

    local writefileFn =
        getExecutorFileFunction("writefile")

    State.AutoSaveSupported =
        type(writefileFn) == "function"

    if not isfileFn
        or not readfileFn then

        State.AutoSaveStatus =
            State.AutoSaveSupported
            and "Write supported; load unavailable"
            or "File autosave unsupported"

        return false
    end

    local okExists, exists =
        pcall(
            isfileFn,
            Systems.LocalSaveFile
        )

    if not okExists
        or not exists then

        State.AutoSaveStatus =
            "No local save yet"

        return false
    end

    local okRead, raw =
        pcall(
            readfileFn,
            Systems.LocalSaveFile
        )

    if not okRead
        or type(raw) ~= "string" then

        State.AutoSaveStatus =
            "Could not read local save"

        return false
    end

    local okDecode, decoded =
        pcall(
            HttpService.JSONDecode,
            HttpService,
            raw
        )

    if not okDecode
        or type(decoded) ~= "table" then

        State.AutoSaveStatus =
            "Local save JSON invalid"

        return false
    end

    Systems.restoreBoatMerchantPositions(
        decoded.MerchantPositions
    )

    Systems.restoreBoatMerchantSpawnerPositions(
        decoded.MerchantSpawnerPositions
    )

    local saved =
        decoded.Config

    if type(saved) == "table" then
        for key, value in pairs(saved) do
            if Config[key] ~= nil
                and key ~= "Enabled"
                and key ~= "Mode" then

                Config[key] = value
            end
        end
    end

    -- OP-only build: old saves can never restore Legit mode.
    Config.Mode = "OP"

    -- Full Auto never silently starts from a file.
    Config.Enabled = false
    State.FullAutoUserIntent = false
    State.FullAutoManualDisabled = false

    State.AutoSaveStatus =
        "Loaded local settings"

    return true
end

function Systems.saveLocalAutoSave()
    if not Config.AutoSaveLocal then
        State.AutoSaveStatus =
            "Auto Save disabled"

        return false
    end

    local writefileFn =
        getExecutorFileFunction("writefile")

    if not writefileFn then
        State.AutoSaveSupported =
            false

        State.AutoSaveStatus =
            "File autosave unsupported"

        return false
    end

    State.AutoSaveSupported =
        true

    local cleanConfig =
        sanitizeForJson(
            Config
        ) or {}

    -- Never persist an active fishing session.
    cleanConfig.Enabled = nil

    local data = {
        Version = "20.4",
        SavedAt = os.time(),
        Config = cleanConfig,
        MerchantPositions =
            Systems.serializeBoatMerchantPositions(),

        MerchantSpawnerPositions =
            Systems.serializeBoatMerchantSpawnerPositions(),

        Session = {
            Caught = State.Caught,
            Escaped = State.Escaped,
            HugeCaught = State.HugeCaught,
            NewCaught = State.NewCaught,
            CoordinatorOwner =
                State.CoordinatorOwner,
            ProgressionStage =
                State.ProgressionStage,
        },
    }

    local okEncode, encoded =
        pcall(
            HttpService.JSONEncode,
            HttpService,
            data
        )

    if not okEncode then
        State.AutoSaveStatus =
            "Could not encode local save"

        return false
    end

    local okWrite =
        pcall(
            writefileFn,
            Systems.LocalSaveFile,
            encoded
        )

    if okWrite then
        State.AutoSaveLastAt =
            os.clock()

        State.AutoSaveStatus =
            "Saved local settings"

        return true
    end

    State.AutoSaveStatus =
        "Could not write local save"

    return false
end

