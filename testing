    end
    W.isActive=wavesActive
    local function getRemote(kind)
        local assets=ReplicatedStorage:FindFirstChild("Assets")
        local remotes=assets and assets:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild(kind)
    end
    local function invoke(...)
        if not wavesActive() then return false,"Waves are not active" end
        if W.busy or Farm.unloaded then return false,"Another wave request is running" end
        local remote=getRemote("GET")
        if not remote or not remote:IsA("RemoteFunction") then return false,"Waves GET is unavailable" end
        W.busy=true
        -- Prefer the Actor Host's own Invoked synchronization, matching the
        -- original Waves client. Direct GET is a compatibility fallback only.
        local bridge=W.actionBridge and W.actionBridge("waves")
        if bridge then
            local args={...}
            local ok,accepted,a,b,c=pcall(function() return bridge:Invoke("action",args) end)
            W.busy=false
            if not ok then return false,tostring(accepted) end
            if not accepted then return false,tostring(a) end
            return true,a,b,c
        end
        local ok,a,b,c=pcall(function(...) return remote:InvokeServer(...) end,...)
        W.busy=false
        if not ok then return false,tostring(a) end
        return true,a,b,c
    end
    local function selections(value)
        local result,seen={},{}
        local function add(item)
            if type(item)=="string" and item~="" and not seen[item] then
                seen[item]=true;result[#result+1]=item
            end
        end
        if type(value)=="string" then
            add(value)
        elseif type(value)=="table" then
            for _,v in ipairs(value) do add(v) end
            -- Accept Rayfield variants which return a keyed set.
            for k,v in pairs(value) do
                if type(k)=="string" and v==true then add(k) end
            end
        end
        return result
    end
    local function labelList(value)
        return table.concat(selections(value),", ")
    end
    local function rootPart()
        local c=LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    -- The native Waves Areas module checks overlapping parts against
    -- Workspace.Waves.Zones. Upgrade and Equipment are NPC interaction zones;
    -- Skills is the skill-crate CLAIM zone (not necessarily the crate Box).
    local function findZonePart(name)
        local f=folder()
        local zones=f and f:FindFirstChild("Zones")
        local zone=zones and zones:FindFirstChild(name)
        if not zone then return nil,"Waves.Zones."..name.." not found" end
        if zone:IsA("BasePart") then return zone end
        if zone:IsA("Model") and zone.PrimaryPart then return zone.PrimaryPart end
        local part=zone:FindFirstChildWhichIsA("BasePart",true)
        if not part then return nil,"Zone "..name.." has no BasePart" end
        return part
    end
    -- The game's Areas system uses zone overlap, not distance to the zone's
    -- center. Avoid snapping the character if it already overlaps ANY zone part.
    -- Check the actual character geometry first, with a narrow bounding-box
    -- fallback for replicated zones whose query flags exclude overlap results.
    local function characterOverlapsZonePart(part,root)
        if not part or not part.Parent or not root then return false end
        local character=LocalPlayer.Character
        if character then
            local params=OverlapParams.new()
            params.FilterType=Enum.RaycastFilterType.Include
            params.FilterDescendantsInstances={character}
            params.MaxParts=12
            local ok,hits=pcall(function()
                return Workspace:GetPartBoundsInBox(part.CFrame,part.Size,params)
            end)
            if ok and #hits>0 then return true end
        end
        local p=part.CFrame:PointToObjectSpace(root.Position)
        local h=part.Size*0.5
        return math.abs(p.X)<=h.X+1.0 and math.abs(p.Z)<=h.Z+1.0
            and math.abs(p.Y)<=h.Y+3.2
    end
    local function isInsideZone(name,root)
        root=root or rootPart()
        if not root then return false end
        local f=folder()
        local zones=f and f:FindFirstChild("Zones")
        local zone=zones and zones:FindFirstChild(name)
        if not zone then return false end
        if zone:IsA("BasePart") then return characterOverlapsZonePart(zone,root) end
        for _,part in ipairs(zone:GetDescendants()) do
            if part:IsA("BasePart") and characterOverlapsZonePart(part,root) then
                return true
            end
        end
        return false
    end
    -- The intermission workflow owns the position until all upgrades finish.
    -- Emergency purchases can also travel during combat, so only enforce the
    -- Skip-phase window when the actual owner is an intermission workflow.
    local function visitPart(part,label,linger,zoneName)
        local root=rootPart()
        if not root or not part or not part:IsA("BasePart") or not part.Parent then
            return false,"Missing character or "..tostring(label)
        end
        if W.inWorkflow and W.workflowMode=="intermission"
            and W.continueWindow and not W.continueWindow() then
            return false,"Next combat wave has started"
        end
        if zoneName and isInsideZone(zoneName,root) then
            W.lastZoneMove="Already in "..zoneName.." zone; no teleport"
            return true,W.lastZoneMove
        end
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        local offset=math.clamp(part.Size.Y*0.5+1.4,1.6,5)
        root.CFrame=CFrame.new(part.Position+Vector3.new(0,offset,0))*root.CFrame.Rotation
        W.lastZoneMove="Moved to "..tostring(label)
        task.wait(linger or 0.18)
        if not root.Parent or rootPart()~=root or Farm.unloaded then
            return false,"Character changed during "..label
        end
        if zoneName and isInsideZone(zoneName,root) then
            return true,"Reached "..label
        end
        local distance=(root.Position-part.Position).Magnitude
        if distance>math.max(10,part.Size.Magnitude*0.5+5) then
            return false,string.format("Could not stay inside %s (%.1f studs away)",label,distance)
        end
        return true,"Reached "..label
    end
    local function visitZone(zoneName,perform)
        if Farm.unloaded or W.busy or (Farm.utilityBusy and not W.inWorkflow) then
