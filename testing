local QuestDefinitionFolder = ReplicatedStorage:WaitForChild("Common"):WaitForChild("QuestsHandlers")
function Hub.QuestFns.questIndexDefinition(id)
    if QuestModuleCache[id] then return QuestModuleCache[id] end
    local child = QuestDefinitionFolder:FindFirstChild(id)
    if not child or not child:IsA("ModuleScript") then return nil end
    local ok, result = pcall(require, child)
    if ok and type(result) == "table" then QuestModuleCache[id]=result; return result end
    return nil
end
function Hub.QuestFns.questHumanName(meta)
    local ok, mod = pcall(function() return require(ReplicatedStorage.Shared.QuestTitle) end)
    if ok and mod and type(mod.format) == "function" then
        local okay, name = pcall(mod.format, meta.id)
        if okay and type(name) == "string" and name ~= "" then return name end
    end
    return meta.title
end
-- Extracted from the supplied main-world save. A player may not have every
-- board streamed at once, so live scene discovery alone is not enough.
-- LevelMax is the BOARD'S advertised level band, not proof that each quest
-- becomes unavailable above that level.
function Hub.QuestFns.getQuestBoardData()
    local map, boards = {}, {}
    local captured = {
        {"Whale Island Town Quest Board",1,10,{"KillForestBrawler","KillCaveBrawler"}},
        {"Crimson Camp Quest Board",10,15,{"KillPhantomRaider","KillCrimsonFlame"}},
        {"Farm Quest Board",15,25,{"KillAngryFarmer","KillFarmKeeper","KillChiefFarmer","KillFoxBear"}},
        {"Blick Castle Quest board",25,40,{"KillPortInvader","KillPortMarksman","KillBlackBlick"}},
        {"Mines Quest Board",25,60,{"KillGreenGoblin","KillZombie","KillBigZombie","KillStoneSoldier","KillStoneEye","KillMoleRat"}},
        {"Whale Island Beach Quest Board",40,55,{"KillBeachBrawler","KillBeachWarrior","KillSandyStorm","KillBeachKing"}},
        {"Deep Forest Quest Board",60,65,{"KillFoxBearHunter","KillLostHunter"}},
        {"Swamp Quest board",65,75,{"KillSwampViper","KillPurpleViper","KillMasterOfTheSwamp"}},
        {"Volcanic Area Quest Board",75,100,{"KillCrimsonSwordsman","KillFlameWorshipper","KillVolcanoWarrior","KillFireSpirits","KillDrakolith"}},
    }
    for _, entry in ipairs(captured) do
        local name,min,max,ids=entry[1],entry[2],entry[3],entry[4]
        boards[name]={min=min,max=max,source="Captured place",loaded=false}
        for order,id in ipairs(ids) do
            map[id]={name=name,min=min,max=max,order=order,
                source="Captured place"}
        end
    end
    local w=workspace:FindFirstChild("World")
    local container=w and w:FindFirstChild("Quest Boards")
    local liveCount=0
    if container then
        for _, board in ipairs(container:GetChildren()) do
            -- The entries are MeshParts named 1, 2... under Board (MeshPart).
            local panel=board:FindFirstChild("Board")
            local min=tonumber(board:GetAttribute("LevelRequirement"))
                or (panel and tonumber(panel:GetAttribute("LevelRequirement")))
            local max=tonumber(board:GetAttribute("LevelMax"))
                or (panel and tonumber(panel:GetAttribute("LevelMax")))
            local old=boards[board.Name]
            min=min or (old and old.min)
            max=max or (old and old.max)
            boards[board.Name]={min=min,max=max,source="Live board",loaded=true}
            liveCount+=1
            if panel then
                -- Do not erase captured entries if this board is only partly streamed.
                for _, entry in ipairs(panel:GetDescendants()) do
                    local id=entry:GetAttribute("Quest") or entry:GetAttribute("QuestId")
                    if type(id)=="string" and id~="" then
                        local ownMin=tonumber(entry:GetAttribute("LevelRequirement"))
                            or tonumber(entry:GetAttribute("RequiredLevel"))
                        map[id]={name=board.Name,min=ownMin or min,
                            max=max,order=tonumber(entry.Name) or math.huge,
                            source="Live board"}
                    end
                end
            end
        end
    end
    Hub.QuestBoardCatalog=boards
    Hub.QuestBoardsLive=liveCount
    return map,boards
end
function Hub.QuestFns.questCategory(meta, board)
    if ProgressionIds[meta.id] then return "Progression" end
    if MissionIds[meta.id] then return "Missions" end
    if board then return "Leveling" end
    if meta.kind == "Boss" then return "Boss" end
    if meta.kind == "Combat" then return "Leveling" end
    return "Side"
end
