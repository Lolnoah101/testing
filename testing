--// ============================================================
--// AUTO SWING
--//
--// The game's TrainOnceRE argument changes between swings.
--// This avoids guessing that changing value and instead triggers
--// the normal swing input so the game's own LocalScript can produce
--// the correct current argument each time.
--// ============================================================

local function SwingOnce()
    if not HubRunning
        or not Settings.AutoSwing
    then
        return false
    end

    -- Send the synthetic swing OUTSIDE the visible viewport.
    -- This keeps Auto Swing from clicking buttons / UI under your
    -- real mouse or touch position while still producing a normal
    -- MouseButton1 input for the game's swing LocalScript.
    local Camera =
        Workspace.CurrentCamera

    local ViewportSize =
        Camera
        and Camera.ViewportSize
        or Vector2.new(
            800,
            600
        )

    local OffscreenX =
        math.floor(
            ViewportSize.X + 100
        )

    local OffscreenY =
        math.floor(
            ViewportSize.Y + 100
        )

    local InputSuccess =
        pcall(function()
            VirtualInputManager
                :SendMouseButtonEvent(
                    OffscreenX,
                    OffscreenY,
                    0,
                    true,
                    game,
                    0
                )

            task.wait(0.025)

            VirtualInputManager
                :SendMouseButtonEvent(
                    OffscreenX,
                    OffscreenY,
                    0,
                    false,
                    game,
                    0
                )
        end)

    if InputSuccess then
        return true
    end

    -- Fallback also uses an offscreen point so it does not target
    -- your visible interface.
    local FallbackSuccess =
        pcall(function()
            local CameraCFrame =
                Camera
                and Camera.CFrame
                or CFrame.new()

            VirtualUser:CaptureController()

            VirtualUser:Button1Down(
                Vector2.new(
                    OffscreenX,
                    OffscreenY
                ),
                CameraCFrame
            )

            task.wait(0.025)

            VirtualUser:Button1Up(
                Vector2.new(
                    OffscreenX,
                    OffscreenY
                ),
                CameraCFrame
            )
        end)

    return FallbackSuccess
end


task.spawn(function()
    while HubRunning do
        if Settings.AutoSwing then
            local Success,
                ErrorMessage =
                pcall(
                    SwingOnce
                )

            if not Success then
                warn(
                    "[HollowMoonHub] Auto Swing: "
                        .. tostring(
                            ErrorMessage
                        )
                )
            end

            task.wait(0.08)
        else
            task.wait(0.15)
        end
    end
end)


