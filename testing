        TeleportServiceForAutoExec:SetTeleportSetting(PERSISTENT_TELEPORT_KEY, enabled)
    end)
end
local function writeMarker(enabled)
    setTeleportIntent(enabled)
    local writer = executorFileAPIs()
    if type(writer) ~= "function" then
        return false, "Executor writefile unavailable"
    end
    local ok, err = pcall(writer, AUTOEXEC_ENABLED_FILE, enabled and "1" or "0")
    return ok, err
end
local function readMarker()
    local _, reader = executorFileAPIs()
    if reader then
        local ok, saved = pcall(reader, AUTOEXEC_ENABLED_FILE)
        if ok and (saved == "1" or saved == "0") then return saved == "1" end
        -- Upgrade from V44 without losing the previously enabled state.
        local oldOk, old = pcall(reader, AUTOEXEC_OLD_ENABLED_FILE)
        if oldOk and old == "1" then return true end
    end
    local ok, saved = pcall(function()
        return TeleportServiceForAutoExec:GetTeleportSetting(PERSISTENT_TELEPORT_KEY)
    end)
    if ok and type(saved) == "boolean" then return saved end
    return true -- requested default: always enabled unless explicitly switched off
end
local function disableLegacyAutoExec()
    local writer = executorFileAPIs()
    if type(writer) ~= "function" then return end
    for _, path in ipairs({
        AUTOEXEC_OLD_ENABLED_FILE,
        "TameAnAnimal_V20_AutoExec.enabled",
        "TameAnAnimal_V26.enabled", "TameAnAnimal_V32.enabled",
        "TameAnAnimal_V33.enabled", "TameAnAnimal_V35.enabled",
        "TameAnAnimal_V38.enabled", "TameAnAnimal_V39.enabled",
        "TameAnAnimal_V40.enabled", "TameAnAnimal_V41.enabled",
        "TameAnAnimal_V42.enabled", "TameAnAnimal_V43.enabled",
    }) do
        pcall(writer, path, "0")
    end
end

