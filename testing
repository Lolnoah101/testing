function Hub:TestDirectM1()
    if CombatV2 then
        return false,"Direct legacy Hit packet is obsolete; use TestM1 for new combat"
    end
    local char=myCharacter()
    if not char then return false,"Character not alive/loaded" end
    return attemptM1(nil,char,os.clock())
end
function Hub:TestM1()
    local char=myCharacter()
    if not char then return false,"Character not alive/loaded" end
    if CombatV2 then return attemptNativeM1(controller(),char,os.clock()) end
    if self.M1Mode=="Native" then return attemptNativeM1(controller(),char,os.clock()) end
    return attemptM1(nil,char,os.clock())
end

local function attemptCrit(ctrl,char,now)
    if now<Hub.NextCrit or now-Hub.LastOffense<0.13 then return false end
    if not equipped(ctrl) then return false end
    if CombatV2 then
        if CombatV2Gate and type(CombatV2Gate.waitTime)=="function" then
            local good,delay=pcall(CombatV2Gate.waitTime,char,LocalPlayer,
                "Attack",{"Critical","M1","ServerHold"})
            if not good or (type(delay)=="number" and delay>0.025) then return false end
        end
        local worked=safeCall(function() CombatV2.input.critical() end)
        if worked then
            Hub.LastCrit,Hub.LastOffense=now,now
            Hub.NextCrit=now+0.7
            Hub.M1SinceCrit=0
            Hub.ConsecutiveM1=0
            Hub.Stats.Critical+=1
            if Hub.AutoFarm then Hub.AttackHoldUntil=now+0.2 end
        end
        return worked
    end
    if not Combat or not ctrl or type(Combat.CanStartCritNow)~="function"
        or type(ctrl.BeginCritCharge)~="function" then return false end
    local ok,ready=safeCall(function() return Combat.CanStartCritNow() end)
    if not ok or ready~=true then return false end
    local worked=safeCall(function() ctrl:BeginCritCharge() end)
    if worked then
        Hub.LastCrit,Hub.LastOffense=now,now
        Hub.NextCrit=now+0.55
        Hub.M1SinceCrit=0
        Hub.ConsecutiveM1=0
        Hub.Stats.Critical+=1
    end
    return worked
end

