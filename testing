    Farm.Waves=W
    local TROST=14012874501
    local lobby=14916516914
    local categories={"Perks","Artifacts","Memories","Shifting"}
    local upgradeNames={"Max","Regen","Replenish","Refills","Revive"}
    local equipmentNames={"All","ODM_Damage","ODM_Crit_Damage","ODM_Crit_Chance","Blade_Durability","ODM_Speed","ODM_Control","ODM_Range","ODM_Gas","TS_Damage","TS_Crit_Damage","TS_Crit_Chance","Blast_Radius","TS_Speed","TS_Control","TS_Range","TS_Gas"}
    local prefix="[HollowMoonHub Waves] "
    local function log(msg)
        W.lastAction=tostring(msg)
        do end
    end
    local function folder()
        return game.PlaceId==TROST and Workspace:FindFirstChild("Waves") or nil
    end
    -- Waves toggles remain saved, but NO Waves action runs in Missions, Raids,
    -- or Town Central. Check both the place and live Waves objective.
    local function wavesActive()
        if Farm.unloaded or game.PlaceId~=TROST then return false end
        local f=folder()
        if not f then return false end
        local objectives=f:FindFirstChild("Objectives")
        if objectives and objectives:FindFirstChild("Waves") then return true end
        for _,obj in ipairs(game:GetService("CollectionService"):GetTagged("Objective")) do
            if obj.Name=="Waves" and obj:IsDescendantOf(Workspace) then return true end
        end
