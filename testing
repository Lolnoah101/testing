--//============================================================
--// CREATE QUEUE USING SERVER-APPROVED ROOM
--//============================================================

local function CreateLobbyQueue(
    Mode,
    RoomNumber
)

    if not LobbyReady
        or not LobbyPackets
        or not RoomNumber
    then

        return false
    end


    if IsLobbyQueued() then
        return false
    end


    local Payload


    if Mode == "Story" then

        Payload =
            BuildStoryPayload(
                RoomNumber
            )

    elseif Mode == "Infinite" then

        Payload =
            BuildEndlessPayload(
                RoomNumber
            )

    elseif Mode == "Trials" then
        local TrialMap = FindLobbyMap("Trials", "Trials")
        if TrialMap then
            local HighestFloor, FloorError = GENV.__AZ_GET_TOP_TRIALS_FLOOR()
            if not HighestFloor then
                -- Never silently join Floor 1 just because saved data loaded
                -- before the account namespace. The next queue tick retries.
                if not GENV.__AZ_TRIALS_FLOOR_WARN_AT
                    or os.clock() - GENV.__AZ_TRIALS_FLOOR_WARN_AT > 8 then
                    GENV.__AZ_TRIALS_FLOOR_WARN_AT = os.clock()
                    warn("[Anime Zero][Trials] Waiting for highest unlocked floor:", FloorError)
                end
                return false
            end
            Settings.SelectedTrialsRoom = HighestFloor
            Payload = {
                gamemode = "Trials",
                map = TrialMap.Id,
                chapter = 0,
                floor = HighestFloor,
                difficulty = 1,
                maxPlayers = 1,
                friendsOnly = false,
                roomNumber = RoomNumber,
            }
        end

    elseif Mode == "Escape" then
        local FloodMap = FindLobbyMap("Escape", "Flood")
            or FindLobbyMap("Escape", "Tidal High Rise")
            or FindLobbyMap("Escape", "Molten High Rise")
        if FloodMap and FloodMap.Id == "Flood" then
            Payload = {
                gamemode = "Escape",
                map = FloodMap.Id,
                chapter = 0,
                floor = 0,
                difficulty = DifficultyIds[Settings.SelectedMoltenDifficulty] or 4,
                maxPlayers = 1,
                friendsOnly = false,
                roomNumber = RoomNumber,
            }
        else
            warn("[Anime Zero][Tidal] Escape / Flood map not yet available")
        end

    elseif Mode == "Raid" then

        local RaidMap =
            FindLobbyMap(
                "Raid",
                Settings.SelectedRaidMap
                    or "Spirit's Bathtub"
            )
            or (Settings.SelectedRaidMap ~= "Evil Reflection"
                and FindLobbyMap(
                    "Raid",
                    Settings.SelectedRaidMap == "Shadow Gate"
                        and "ShadowGate"
                        or "BathTub"
                ))
            or (Settings.SelectedRaidMap ~= "Evil Reflection"
                and FindLobbyMap("Raid", "Spirit's Bathtub"))


        if RaidMap then

            Payload = {
                gamemode = "Raid",
                map = RaidMap.Id,
                chapter = 0,
                floor = 0,
                difficulty = 4,
                maxPlayers = 1,
                friendsOnly = false,
                roomNumber = RoomNumber,
            }
        end
    end


    if not Payload then
        return false
    end


    -- Flush the newest UI state before the server can begin a place teleport.
    pcall(function()
        local Saver =
            GENV.__AZ_FORCE_CONFIG_SAVE

        if type(Saver) == "function" then
            Saver(
                "before queue",
                true
            )
        else
            Window:Save()
        end
    end)


    local Success,
        ErrorMessage =
        pcall(function()

            LobbyPackets
                .createQuque
                :fire(
                    Payload
                )
        end)


    if not Success then

        warn(
            "[Anime Zero] Create Queue Failed:",
            ErrorMessage
        )


        return false
    end


    LastLobbyCreate =
        os.clock()


    LobbyCreateAttempts =
        LobbyCreateAttempts + 1


    print(
        "[Anime Zero] Create Queue |",
        Mode,
        "| Room:",
        RoomNumber,
        "| Map:",
        Payload.map,
        "| Act:",
        Payload.chapter,
        "| Difficulty:",
        Payload.difficulty
    )


    return true
end


