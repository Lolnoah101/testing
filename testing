GENV.__AZ_FARM_EXT.ResolveEffectiveSkill = function(
    Store,
    RequestedSkill
)

    local CharacterName =
        GENV.__AZ_FARM_EXT.GetCurrentCharacterName(Store)


    if not CharacterName then
        return nil, nil
    end


    local EffectiveSkill =
        RequestedSkill


    local Config =
        CharacterConstants
            .charactersByName[
                CharacterName
            ]


    local SkillConfig =
        Config
        and Config.skills
        and Config.skills[
            RequestedSkill
        ]


    -- Bonus skills are selected only while their OWN base slot is active.
    -- This matches the native client and prevents stale bonus attributes from
    -- turning an unrelated skill into the wrong ability.
    if SkillConfig
        and SkillConfig.bonus
        and workspace:GetServerTimeNow()
            < (tonumber(LocalPlayer:GetAttribute("BonusUntil")) or 0)
        and (LocalPlayer:GetAttribute("BonusSlot") or RequestedSkill)
            == RequestedSkill
        and Config.skills[SkillConfig.bonus]
    then
        EffectiveSkill =
            SkillConfig.bonus
    end


    return CharacterName,
        EffectiveSkill
end


local function SkillCooldownReady(
    Store,
    SkillNumber
)

    if not Store then
        return false
    end


    local CharacterName,
        EffectiveSkill =
        GENV.__AZ_FARM_EXT.ResolveEffectiveSkill(
            Store,
            SkillNumber
        )


    if not CharacterName
        or not EffectiveSkill
    then
        return false
    end


    local Key =
        CharacterName
        .. ".skill"
        .. tostring(
            EffectiveSkill
        )


    if type(
        PlayerNamespace.skillCooldownKey
    ) == "function"
    then

        local Success,
            Result =
            pcall(
                PlayerNamespace.skillCooldownKey,
                CharacterName,
                EffectiveSkill
            )


        if Success
            and type(Result) == "string"
        then
            Key = Result
        end
    end


    return CooldownReady(
        Store,
        Key
    ),
        EffectiveSkill,
        CharacterName
end

