-- V19: One bounded, Heartbeat-driven scheduler replaces independent task.wait
-- loops. Heartbeat checks job deadlines, NOT every expensive game operation.
-- Event watchers wake the relevant jobs when data/enemies/raids change.
-- Jobs never overlap, and remote-specific cooldowns remain in their workers.
local RunService = game:GetService("RunService")
local Scheduler = {
    jobs = {}, byName = {}, signals = {},
    launches = 0, wakeups = 0, errors = 0,
    maxLaunchesPerFrame = 5,
}
function Scheduler.add(name, seconds, action)
    assert(not Scheduler.byName[name], "Duplicate scheduler job: " .. name)
    local job = {
        name = name, period = seconds, action = action,
        nextAt = os.clock() + 0.03, busy = false, pending = false,
    }
    Scheduler.byName[name] = job
    table.insert(Scheduler.jobs, job)
    return job
end
function Scheduler.poke(name)
    local job = Scheduler.byName[name]
    if not job or not alive then return end
    if job.busy then
        job.pending = true
    else
        job.nextAt = math.min(job.nextAt, os.clock() + 0.025)
    end
    Scheduler.wakeups += 1
end
function Scheduler.pokeMany(names)
    for _, name in ipairs(names) do Scheduler.poke(name) end
end
function Scheduler.pokeAll()
    for _, job in ipairs(Scheduler.jobs) do Scheduler.poke(job.name) end
end
function Scheduler.track(signal)
    if signal then table.insert(Scheduler.signals, signal) end
    return signal
end
local schedulerCursor = 1
local schedulerConnection = RunService.Heartbeat:Connect(function()
    if not alive or not Scheduler.initialized then return end
    local jobs = Scheduler.jobs
    local count = #jobs
    if count == 0 then return end
    local now = os.clock()
    local launched = 0
    -- Rotating scan gives every job a fair chance despite frame limits.
    for offset = 0, count - 1 do
        if launched >= Scheduler.maxLaunchesPerFrame then break end
        local index = ((schedulerCursor + offset - 1) % count) + 1
        local job = jobs[index]
        if not job.busy and now >= job.nextAt then
            job.busy = true
            job.nextAt = now + job.period
            launched += 1
            Scheduler.launches += 1
            task.spawn(function()
                local ok, err = pcall(job.action)
                if not ok then
                    Scheduler.errors += 1
                    if os.clock() - (job.lastWarnAt or -math.huge) >= 5 then
                        job.lastWarnAt = os.clock()
                        warn("[Arise v19 Scheduler] " .. job.name .. ": " .. tostring(err))
                    end
                end
                job.busy = false
                if job.pending then
                    job.pending = false
                    job.nextAt = math.min(job.nextAt, os.clock() + 0.025)
                end
            end)
        end
    end
    schedulerCursor = (schedulerCursor % count) + 1
end)

