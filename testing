    function Airdrop.Status(
        Message,
        Delay
    )
        Delay = Delay or 0

        if Airdrop.LastStatus == Message
            and os.clock() - Airdrop.LastStatusAt < Delay
        then
            return
        end

        Airdrop.LastStatus =
            Message

        Airdrop.LastStatusAt =
            os.clock()

        print(
            "[Airdrop] "
            .. tostring(Message)
        )
    end

    function Airdrop.NormalizeLocation(
        Text
    )
        local Value =
            string.upper(
                tostring(Text or "")
            )

        Value =
            Value:gsub(
                "^%s+",
                ""
            )

        Value =
            Value:gsub(
                "%s+$",
                ""
            )

        Value =
            Value:gsub(
                "%s+",
                " "
            )

        local Compact =
            Value:gsub(
                "%s",
                ""
            )

        if Compact == "THEICE" then
            return "THEICE"
        end

        if Compact == "PARKINGSTATION" then
            return "PARKINGSTATION"
        end

        if Compact == "OILRIG" then
            return "OILRIG"
        end

        return Compact
    end

    function Airdrop.ParseAnnouncement(
        Message
    )
        local Upper =
            string.upper(
                tostring(Message or "")
            )

        local Location =
            Upper:match(
                "AN AIRDROP HAS SPAWNED! AT (.-)!"
            )

        if not Location then
            return nil
        end

        local Key =
            Airdrop.NormalizeLocation(
                Location
            )

        local Info =
            Airdrop.SpawnLocations[
                Key
            ]

        if not Info then
            return nil
        end

        return
            Key,
            Info.Label,
            Info.Position
    end

    function Airdrop.RequestStreaming(
        Position
    )
        if not Position
            or os.clock()
                - Airdrop.LastStreamRequest
                < 1.8
        then
            return
        end

        Airdrop.LastStreamRequest =
            os.clock()

        task.spawn(function()
            pcall(function()
                Player:RequestStreamAroundAsync(
                    Position,
                    2
                )
            end)
        end)
    end

    function Airdrop.GetInstancePosition(
        Object
    )
        if not Object
            or not Object.Parent
        then
            return nil
        end

        local Current =
            Object

        for _ = 1, 7 do
            if not Current then
                break
            end

            if Current:IsA(
                "Attachment"
            ) then
                return Current.WorldPosition
            end

            if Current:IsA(
                "BasePart"
            ) then
                return Current.Position
            end

            if Current:IsA(
                "Model"
            ) then
                if Current.PrimaryPart then
                    return Current.PrimaryPart.Position
                end

                local Success,
                    Pivot =
                    pcall(function()
                        return Current:GetPivot()
                    end)

                if Success then
                    return Pivot.Position
                end
            end

            Current =
                Current.Parent
        end

        return nil
    end

    function Airdrop.IsNearCurrentDrop(
        Object,
        Radius
    )
        if not Airdrop.CurrentPosition then
            return false
        end

        local Position =
            Airdrop.GetInstancePosition(
                Object
            )

        if not Position then
            return false
        end

        return (
            Position
            - Airdrop.CurrentPosition
        ).Magnitude
            <= (Radius or 70)
    end

    function Airdrop.HasAirdropName(
        Object
    )
        if not Object then
            return false
        end

        local Text =
            string.lower(
                tostring(
                    Object.Name
                    or ""
                )
            )

        if Object:IsA(
            "ProximityPrompt"
        ) then
            Text =
                Text
                .. " "
                .. string.lower(
                    tostring(
                        Object.ObjectText
                        or ""
                    )
                )
                .. " "
                .. string.lower(
                    tostring(
                        Object.ActionText
                        or ""
                    )
                )
        end

        local Current =
            Object.Parent

        for _ = 1, 5 do
            if not Current then
                break
            end

            Text =
                Text
                .. " "
                .. string.lower(
                    tostring(
                        Current.Name
                        or ""
                    )
                )

            Current =
                Current.Parent
        end

        return
            string.find(
                Text,
                "airdrop",
                1,
                true
            ) ~= nil

            or string.find(
                Text,
                "supply",
                1,
                true
            ) ~= nil

            or string.find(
                Text,
                "loot",
                1,
                true
            ) ~= nil

            or string.find(
                Text,
                "crate",
                1,
                true
            ) ~= nil

            or string.find(
                Text,
                "drop",
                1,
                true
            ) ~= nil
    end

    function Airdrop.IsStaticWorldPrompt(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
        then
            return true
        end

        local AirdropSpawns =
            Workspace:FindFirstChild(
                "AirdropSpawns"
            )

        if AirdropSpawns
            and Prompt:IsDescendantOf(
                AirdropSpawns
            )
        then
            return true
        end

        local Map =
            Workspace:FindFirstChild(
                "Map"
            )

        if Map
            and Prompt:IsDescendantOf(
                Map
            )
            and not Airdrop.HasAirdropName(
                Prompt
            )
        then
            return true
        end

        local OilJob =
            Workspace:FindFirstChild(
                "OilJob"
            )

        if OilJob
            and Prompt:IsDescendantOf(
                OilJob
            )
        then
            return true
        end

        local Yacht =
            Workspace:FindFirstChild(
                "Yacht"
            )

        if Yacht
            and Prompt:IsDescendantOf(
                Yacht
            )
        then
            return true
        end

        return false
    end

    function Airdrop.IsPromptCandidate(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt:IsA(
                "ProximityPrompt"
            )
            or not Prompt.Enabled
            or not Airdrop.IsNearCurrentDrop(
                Prompt,
                80
            )
            or Airdrop.IsStaticWorldPrompt(
                Prompt
            )
        then
            return false
        end

        if Airdrop.AddedPrompts[
            Prompt
        ] then
            return true
        end

        return Airdrop.HasAirdropName(
            Prompt
        )
    end

    function Airdrop.TrackAddedObject(
        Object
    )
        if not Airdrop.CurrentPosition
            or not Object
        then
            return
        end

        task.defer(function()
            if not Object
                or not Object.Parent
                or not Airdrop.CurrentPosition
                or not Airdrop.IsNearCurrentDrop(
                    Object,
                    90
                )
            then
                return
            end

            if Object:IsA(
                "ProximityPrompt"
            ) then
                if not Airdrop.IsStaticWorldPrompt(
                    Object
                ) then
                    Airdrop.AddedPrompts[
                        Object
                    ] = true

                    Airdrop.Status(
                        "New nearby interaction: "
                        .. tostring(
                            Object.ObjectText ~= ""
                            and Object.ObjectText
                            or Object.Name
                        ),
                        0.3
                    )
                end

                return
            end

            if (
                Object:IsA("Model")
                or Object:IsA("BasePart")
            )
                and Airdrop.HasAirdropName(
                    Object
                )
            then
                Airdrop.AddedObjects[
                    Object
                ] = true
            end
        end)
    end

    function Airdrop.SetCurrentDrop(
        Key,
        Label,
        Position
    )
        Airdrop.CurrentKey =
            Key

        Airdrop.CurrentLabel =
            Label

        Airdrop.CurrentPosition =
            Position

        Airdrop.AnnouncedAt =
            os.clock()

        Airdrop.AddedPrompts =
            setmetatable({}, {
                __mode = "k",
            })

        Airdrop.AddedObjects =
            setmetatable({}, {
                __mode = "k",
            })

        Airdrop.Status(
            "Spawn announced at "
            .. tostring(Label)
        )

        Airdrop.RequestStreaming(
            Position
        )
    end

    Airdrop.NotifyRemote =
        Remotes:FindFirstChild(
            "Notify"
        )

    if Airdrop.NotifyRemote
        and Airdrop.NotifyRemote:IsA(
            "RemoteEvent"
        )
    then
        Airdrop.NotifyConnection =
            Airdrop.NotifyRemote.OnClientEvent:Connect(
                function(
                    Message
                )
                    local Key,
                        Label,
                        Position =
                        Airdrop.ParseAnnouncement(
                            Message
                        )

                    if Key then
                        Airdrop.SetCurrentDrop(
                            Key,
                            Label,
                            Position
                        )
                    end
                end
            )
    end

    Airdrop.AddedConnection =
        Workspace.DescendantAdded:Connect(
            Airdrop.TrackAddedObject
        )

    function Airdrop.GetGroundPoint(
        Position
    )
        local Parameters =
            RaycastParams.new()

        Parameters.FilterType =
            Enum.RaycastFilterType.Exclude

        Parameters.FilterDescendantsInstances = {
            GetCharacter(),
        }

        local Result =
            Workspace:Raycast(
                Position
                    + Vector3.new(
                        0,
                        35,
                        0
                    ),

                Vector3.new(
                    0,
                    -100,
                    0
                ),

                Parameters
            )

        return Result
            and Result.Position
            or nil
    end

    function Airdrop.MoveToVector(
        Position,
        Label
    )
        if not Settings.AutoAirdrop
            or not Position
        then
            return false
        end

        Airdrop.RequestStreaming(
            Position
        )

        local Ground =
            Airdrop.GetGroundPoint(
                Position
            )

        local TargetPosition =
            (
                Ground
                or Position
            )
            + Vector3.new(
                0,
                GetRootHeight(),
                0
            )

        Airdrop.Status(
            Label,
            0.7
        )

        return MoveToJobTarget(
            CFrame.new(
                TargetPosition
            ),

            function()
                return Settings.AutoAirdrop
            end
        )
    end

    function Airdrop.FollowSegment(
        Points,
        Label
    )
        if not Settings.AutoAirdrop then
            return false
        end

        Airdrop.Status(
            Label,
            0.7
        )

        local Route = {
            GetRootPart().Position,
        }

        for _, Point in ipairs(
            Points
        ) do
            table.insert(
                Route,
                Point
            )
        end

        local Generation =
            MovementGeneration

        return FollowSmoothPath(
            Route,

            function()
                return Settings.AutoAirdrop
            end,

            function()
                return false
            end,

            Generation
        )
    end

    function Airdrop.MoveToOilRigDrop()
        local Route =
            Airdrop.OilRigRoute

        if GetRootPart().Position.Y >= 78
            and (
                GetRootPart().Position
                - Airdrop.CurrentPosition
            ).Magnitude <= 80
        then
            return Airdrop.MoveToVector(
                Airdrop.CurrentPosition,
                "Approaching Oil Rig airdrop"
            )
        end

        if not Airdrop.MoveToVector(
            Route.PierApproach,
            "Going to Oil Rig pier"
        )
        then
            return false
        end

        if not Airdrop.MoveToVector(
            Route.PierEdge,
            "Going to end of Oil Rig pier"
        )
        then
            return false
        end

        if not Airdrop.FollowSegment(
            {
                Route.RigLowerEntry,
            },
            "Crossing Oil Rig access gap"
        )
        then
            return false
        end

        Airdrop.RequestStreaming(
            Airdrop.CurrentPosition
        )

        if not Airdrop.MoveToVector(
            Route.Stair1Low,
            "Going to Oil Rig lower stairs"
        )
        then
            return false
        end

        if not Airdrop.FollowSegment(
            {
                Route.Stair1High,
                Route.Stair2Low,
                Route.Stair2High,
            },
            "Climbing Oil Rig lower stairs"
        )
        then
            return false
        end

        if not Airdrop.MoveToVector(
            Route.Stair4Low,
            "Going to Oil Rig main stairs"
        )
        then
            return false
        end

        if not Airdrop.FollowSegment(
            {
                Route.Stair4High,
            },
            "Climbing to Oil Rig main deck"
        )
        then
            return false
        end

        if not Airdrop.MoveToVector(
            Route.Stair5Low,
            "Going to Oil Rig upper stairs"
        )
        then
            return false
        end

        if not Airdrop.FollowSegment(
            {
                Route.Stair5High,
            },
            "Climbing to Oil Rig upper deck"
        )
        then
            return false
        end

        return Airdrop.MoveToVector(
            Airdrop.CurrentPosition,
            "Approaching Oil Rig airdrop"
        )
    end

    function Airdrop.MoveToCurrentDrop()
        if not Airdrop.CurrentPosition then
            return false
        end

        if Airdrop.CurrentKey
            == "OILRIG"
        then
            return Airdrop.MoveToOilRigDrop()
        end

        return Airdrop.MoveToVector(
            Airdrop.CurrentPosition,
            "Going to airdrop at "
            .. tostring(
                Airdrop.CurrentLabel
                or "unknown area"
            )
        )
    end

    function Airdrop.GetCandidatePrompts()
        if not Airdrop.CurrentPosition then
            return {}
        end

        local Prompts = {}
        local Seen = {}

        for Prompt in pairs(
            Airdrop.AddedPrompts
        ) do
            if Airdrop.IsPromptCandidate(
                Prompt
            ) then
                Seen[Prompt] = true

                table.insert(
                    Prompts,
                    Prompt
                )
            end
        end

        if os.clock()
            - Airdrop.LastWorldScan
            >= 0.8
        then
            Airdrop.LastWorldScan =
                os.clock()

            for _, Object in ipairs(
                Workspace:GetDescendants()
            ) do
                if Object:IsA(
                    "ProximityPrompt"
                )
                    and not Seen[
                        Object
                    ]
                    and Airdrop.IsPromptCandidate(
                        Object
                    )
                then
                    table.insert(
                        Prompts,
                        Object
                    )

                    Seen[Object] =
                        true
                end
            end
        end

        local RootPart =
            GetRootPart()

        table.sort(
            Prompts,

            function(A, B)
                local APosition =
                    Airdrop.GetInstancePosition(
                        A
                    )

                local BPosition =
                    Airdrop.GetInstancePosition(
                        B
                    )

                if not APosition then
                    return false
                end

                if not BPosition then
                    return true
                end

                return (
                    RootPart.Position
                    - APosition
                ).Magnitude
                    < (
                        RootPart.Position
                        - BPosition
                    ).Magnitude
            end
        )

        return Prompts
    end

    function Airdrop.IsPromptInRange(
        Prompt
    )
        local Position =
            Airdrop.GetInstancePosition(
                Prompt
            )

        if not Position then
            return false
        end

        local MaxDistance =
            tonumber(
                Prompt.MaxActivationDistance
            ) or 10

        return (
            GetRootPart().Position
            - Position
        ).Magnitude
            <= math.max(
                1,
                MaxDistance - 0.6
            )
    end

    function Airdrop.MoveToPrompt(
        Prompt
    )
        if Airdrop.IsPromptInRange(
            Prompt
        ) then
            return true
        end

        local Position =
            Airdrop.GetInstancePosition(
                Prompt
            )

        if not Position then
            return false
        end

        local MaxDistance =
            tonumber(
                Prompt.MaxActivationDistance
            ) or 10

        local Radius =
            math.clamp(
                MaxDistance - 1.4,
                3.5,
                7
            )

        local RootPart =
            GetRootPart()

        local Away =
            Vector3.new(
                RootPart.Position.X
                    - Position.X,
                0,
                RootPart.Position.Z
                    - Position.Z
            )

        if Away.Magnitude < 0.05 then
            Away =
                Vector3.new(
                    0,
                    0,
                    1
                )
        else
            Away =
                Away.Unit
        end

        local Ground =
            Airdrop.GetGroundPoint(
                Position
                + Away * Radius
            )

        local Target =
            (
                Ground
                or Position
            )
            + Vector3.new(
                0,
                GetRootHeight(),
                0
            )

        Airdrop.Status(
            "Going to airdrop interaction: "
            .. tostring(
                Prompt.ObjectText ~= ""
                and Prompt.ObjectText
                or Prompt.Name
            )
        )

        local Reached =
            MoveToJobTarget(
                CFrame.new(
                    Target
                ),

                function()
                    return Settings.AutoAirdrop
                end
            )

        return Reached
            and Airdrop.IsPromptInRange(
                Prompt
            )
    end

    function Airdrop.InteractWithPrompt(
        Prompt
    )
        if not Airdrop.IsPromptCandidate(
            Prompt
        ) then
            return false
        end

        if not Airdrop.MoveToPrompt(
            Prompt
        ) then
            return false
        end

        Airdrop.Status(
            "Using airdrop interaction: "
            .. tostring(
                Prompt.ObjectText ~= ""
                and Prompt.ObjectText
                or Prompt.Name
            )
        )

        local BeforeEnabled =
            Prompt.Enabled

        local BeforeObjectText =
            tostring(
                Prompt.ObjectText
                or ""
            )

        local BeforeActionText =
            tostring(
                Prompt.ActionText
                or ""
            )

        local Triggered =
            TriggerPrompt(
                Prompt
            )

        if not Triggered then
            return false
        end

        local Started =
            os.clock()

        while Settings.AutoAirdrop
            and os.clock() - Started < 2.5
        do
            if not Prompt.Parent
                or not Prompt.Enabled
                or Prompt.Enabled
                    ~= BeforeEnabled
                or tostring(
                    Prompt.ObjectText
                    or ""
                )
                    ~= BeforeObjectText
                or tostring(
                    Prompt.ActionText
                    or ""
                )
                    ~= BeforeActionText
            then
                return true
            end

            task.wait(0.08)
        end

        task.wait(
            Settings.AirdropRetryDelay
        )

        return true
    end

    function Airdrop.LogNearbyObjects()
        if os.clock()
            - Airdrop.LastCandidateLog
            < 4
            or not Airdrop.CurrentPosition
        then
            return
        end

        Airdrop.LastCandidateLog =
            os.clock()

        local Logged = 0

        for Object in pairs(
            Airdrop.AddedObjects
        ) do
            if Object
                and Object.Parent
                and Airdrop.IsNearCurrentDrop(
                    Object,
                    90
                )
            then
                local Success,
                    FullName =
                    pcall(function()
                        return Object:GetFullName()
                    end)

                print(
                    "[Airdrop] Nearby spawned object:",
                    Success
                        and FullName
                        or tostring(Object.Name)
                )

                Logged += 1

                if Logged >= 8 then
                    break
                end
            end
        end

        if Logged == 0 then
            Airdrop.Status(
                "At "
                .. tostring(
                    Airdrop.CurrentLabel
                    or "airdrop area"
                )
                .. " - waiting for the live drop interaction",
                4
            )
        end
    end

    function Airdrop.FindLoadedActiveDrop()
        if Airdrop.CurrentPosition then
            return true
        end

        for _, Object in ipairs(
            Workspace:GetDescendants()
        ) do
            if Object:IsA(
                "ProximityPrompt"
            )
                and Object.Enabled
                and Airdrop.HasAirdropName(
                    Object
                )
            then
                local Position =
                    Airdrop.GetInstancePosition(
                        Object
                    )

                if Position then
                    local ClosestKey =
                        nil

                    local ClosestInfo =
                        nil

                    local ClosestDistance =
                        math.huge

                    for Key, Info in pairs(
                        Airdrop.SpawnLocations
                    ) do
                        local Distance =
                            (
                                Position
                                - Info.Position
                            ).Magnitude

                        if Distance
                            < ClosestDistance
                        then
                            ClosestDistance =
                                Distance

                            ClosestKey =
                                Key

                            ClosestInfo =
                                Info
                        end
                    end

                    if ClosestInfo
                        and ClosestDistance <= 90
                    then
                        Airdrop.SetCurrentDrop(
                            ClosestKey,
                            ClosestInfo.Label,
                            ClosestInfo.Position
                        )

                        Airdrop.AddedPrompts[
                            Object
                        ] = true

                        Airdrop.Status(
                            "Found a currently loaded airdrop at "
                            .. ClosestInfo.Label
                        )

                        return true
                    end
                end
            end
        end

        return false
    end

    AirdropAPI.Start =
        function()
            if Airdrop.Thread then
                return
            end

            Settings.AutoAirdrop =
                true

            Airdrop.Thread =
                task.spawn(function()
                    local Success,
                        Error =
                        xpcall(
                            function()
                                Airdrop.Status(
                                    "Started - waiting for an airdrop"
                                )

                                while Settings.AutoAirdrop do
                                    if not Airdrop.CurrentPosition then
                                        if not Airdrop.FindLoadedActiveDrop() then
                                            Airdrop.Status(
                                                "Waiting for airdrop announcement",
                                                4
                                            )

                                            task.wait(
                                                Settings.AirdropRescanDelay
                                            )

                                            continue
                                        end
                                    end

                                    Airdrop.RequestStreaming(
                                        Airdrop.CurrentPosition
                                    )

                                    local Distance =
                                        (
                                            GetRootPart().Position
                                            - Airdrop.CurrentPosition
                                        ).Magnitude

                                    if Distance > 35 then
                                        local Reached =
                                            Airdrop.MoveToCurrentDrop()

                                        if not Reached then
                                            Airdrop.Status(
                                                "Could not reach "
                                                .. tostring(
                                                    Airdrop.CurrentLabel
                                                    or "airdrop area"
                                                )
                                                .. " - retrying",
                                                2
                                            )

                                            task.wait(1)
                                        end
                                    else
                                        local Prompts =
                                            Airdrop.GetCandidatePrompts()

                                        if #Prompts > 0 then
                                            Airdrop.InteractWithPrompt(
                                                Prompts[1]
                                            )

                                            task.wait(
                                                Settings.AirdropStateDelay
                                            )
                                        else
                                            Airdrop.LogNearbyObjects()

                                            task.wait(
                                                Settings.AirdropRescanDelay
                                            )
                                        end
                                    end
                                end
                            end,

                            debug.traceback
                        )

                    Airdrop.Thread =
                        nil

                    if not Success then
                        warn(
                            "[Airdrop] Worker error:\n"
                            .. tostring(Error)
                        )

                        if Settings.AutoAirdrop then
                            task.wait(0.5)
                            AirdropAPI.Start()
                            return
                        end
                    end

                    print(
                        "[Airdrop] Stopped"
                    )
                end)
        end

    AirdropAPI.Stop =
        function()
            Settings.AutoAirdrop =
                false

            StopJobMovement()
        end
end


