        if pressed then
            -- Record actual assembly speed at slash start, not Tween speed.
            local rootAtSlash = getPlayerRoot()
            Farm.lastSlashPhysicalSpeed = rootAtSlash
                and rootAtSlash.AssemblyLinearVelocity.Magnitude or 0
            -- Only successful slash starts consume the attack interval.
            Farm.lastAttack = os.clock()
            Farm.slashAccepted = Farm.slashAccepted + 1
            Farm.auraConsecutiveRejections = 0
            task.wait(ATTACK_HOLD)
            local released = setAttackHeld(false)
            if withAura and Farm.auraEnabled and released then
                task.wait(REMOTE_AFTER_RELEASE)
                local root = getPlayerRoot()
                if root then
                    Farm.lastHitPhysicalSpeed = root.AssemblyLinearVelocity.Magnitude
                    registerAuraHits(root)
                end
            end
        else
            Farm.slashRejected = Farm.slashRejected + 1
            if withAura and Farm.auraMode ~= "Reliable" then
                Farm.auraConsecutiveRejections = Farm.auraConsecutiveRejections + 1
                if Farm.auraConsecutiveRejections >= 3 then
                    Farm.auraBackoffUntil = os.clock() + 3
                    Farm.auraConsecutiveRejections = 0
                end
            end
            if not Farm.attackWarned then
                Farm.attackWarned = true
                do end
            end
        end
        end)
        if Farm.attackSerial==attackSerial then
            Farm.attacking=false
            Farm.attackStartedAt=0
        end
        if not completed and not Farm.unloaded then
            do end
        end
    end)
end

-- First-use skill initialization must happen through the game's original
-- InputBegan connection. Its ModuleScript requires run with the game client
-- identity; the Actor bridge alone may fail on cold modules. No extra UI.
Farm.pressSkillHotkey = function(keyName)
    if type(keyName)~="string" or not Enum.KeyCode[keyName] then
        return false,"Invalid bound key: "..tostring(keyName)
    end
    local key=Enum.KeyCode[keyName]
    local serviceOK,vim=pcall(function() return game:GetService("VirtualInputManager") end)
    if serviceOK and vim then
        local down,why=pcall(function() vim:SendKeyEvent(true,key,false,game) end)
        if down then
            task.wait(0.08)
            local up,upWhy=pcall(function() vim:SendKeyEvent(false,key,false,game) end)
            if up then return true,"Game input key "..keyName end
            return false,"Key release failed: "..tostring(upWhy)
        end
    end
    -- Executor fallback for keyboards when the VirtualInputManager service
    -- is unavailable; some environments expose keypress/keyrelease instead.
    if type(keypress)=="function" and type(keyrelease)=="function" then
        local vk=key.Value
        if vk>=97 and vk<=122 then vk=vk-32 end
        local named={LeftShift=160,RightShift=161,LeftControl=162,RightControl=163,
            LeftAlt=164,RightAlt=165,Space=32,Return=13,Tab=9}
        vk=named[keyName] or vk
        if vk>=8 and vk<=255 then
            local down,why=pcall(keypress,vk)
            if down then
                task.wait(0.08)
                local up,upWhy=pcall(keyrelease,vk)
                if up then return true,"Executor key "..keyName end
                return false,"Executor release failed: "..tostring(upWhy)
            end
        end
    end
    return false,"No permitted native hotkey injector found (VirtualInputManager / keypress)"
end

-- Auto Skills uses the same actor bridge as the verified no-click slash.
-- This invokes the live Core.Skills.Use path only for equipped hotbar IDs
-- 14 = Drill Thrust, 23 = Torrential Steel; the game checks cooldowns.
-- Kill Aura can slash every 0.75 s, but the game keeps Slash.Slashing
-- true beyond the initial input. First reserve a skill turn, then let the
-- previous slash finish naturally BEFORE invoking the actual skill controller.
local function requestCombatSkill()
    -- One user-facing toggle: Auto Skills. Specials are detected from the hotbar.
    if not Farm.autoCombatSkills then return end
    -- Auto Skills also waits for the live combat Host; a cold startup cast can
    -- collide with a slash or initialize the wrong Actor state after teleport.
    if not Farm:CombatStartupReady() then return end
    if Farm.skillReservation or Farm.unloaded or Farm.attacking
        or Farm.utilityBusy or Farm.bladeRecoveryActive
        or Farm.waitingFreezeActive then return end
    if not hasAuraTarget() then
        Farm.combatSkillLastMessage = "No available Titan target"
        return
    end
    local now = os.clock()
    if now - Farm.opLastAttempt < 0.75 then return end
    Farm.opLastAttempt = now
    local bridge, reason = resolveSlashBridge()
    if not bridge then
        Farm.combatSkillLastMessage = tostring(reason or "Actor not ready")
        Farm.opLastMessage = Farm.combatSkillLastMessage
        return
    end
    local payload = {
        slots = Farm.combatSkillSlots,
        includeSpecial = true,
    }
    -- Only interrupt farming when a selected skill is equipped and off cooldown.
    -- This probe deliberately ignores the temporary slash-active flag.
    local ok, ready, explanation, proposedSkillId = pcall(function()
        return bridge:Invoke("skill_probe", payload)
    end)
    if not ok or not ready then
        Farm.combatSkillLastMessage = ok and tostring(explanation or "No ready skills")
            or ("Skill probe error: " .. tostring(ready))
        Farm.opLastMessage = Farm.combatSkillLastMessage
        return
    end

    Farm.skillReservation = true
    Farm.skillReservationDeadline = os.clock() + 2.5
    Farm.skillPriorityUntil = Farm.skillReservationDeadline
    Farm.combatSkillLastMessage = "Waiting for current slash to finish: " .. tostring(explanation)
    task.spawn(function()
        local activated = false
        local result = "Timed out waiting for slash to finish"
        while not Farm.unloaded and os.clock() < Farm.skillReservationDeadline do
            if not Farm.autoCombatSkills then
                result = "Auto Skills disabled"
                break
            end
            if Farm.bladeRecoveryActive or Farm.utilityBusy then
                result = "Blade recovery/utility action has priority"
                break
            end
            -- Keep new slashes paused even if the Actor request yields.
            Farm.skillPriorityUntil = os.clock() + 0.5
            if Farm.attacking then
                task.wait(0.05)
            else
                -- v55: NEVER move down to the nape for a skill.
                -- The native skill uses its character-bound hitbox, so damage
                -- from 200 studs is not guaranteed (even when casting works).
                local special = tostring(proposedSkillId)=="14" or tostring(proposedSkillId)=="23"
                local allow, canCast = true, true
                if special and Farm.running then
                    local callOK, castReady = pcall(function()
                        return bridge:Invoke("skill_window")
                    end)
                    allow, canCast = callOK, castReady
                end
                if not allow or not canCast then
                    task.wait(0.07)
                else
                    if special then beginSkillNapeAssist(proposedSkillId) end
                    local worked, accepted, detail = pcall(function()
                        return bridge:Invoke("auto_skill", payload)
                    end)
                    if not worked then
                        result = "Skill bridge error: " .. tostring(accepted)
                        break
                    elseif accepted then
                        activated = true
                        result = tostring(detail or "Skill activated") .. " | holding farm height"
                        if special then
                            -- One bounded, experimental nape-registration pulse,
                            -- only while Kill Aura is on. This MAY be rejected:
                            -- the game can require a real slash and skill
                            -- hitbox proximity; this is not verified skill damage.
                            local root = getPlayerRoot()
                            if root and Farm.auraEnabled then
                                registerAuraHits(root)
                                result = result .. " | aura nape attempts sent (not confirmed damage)"
                            end
                        end
                        Farm.combatSkillAttempts = Farm.combatSkillAttempts + 1
                        Farm.opSkillsCount = Farm.opSkillsCount + 1
                        Farm.skillLastVerifiedAt = os.clock()
                        break
                    else
                        result = tostring(detail or "Skill not activated")
                        local slotText,id=result:match("^NATIVE_FIRST_CAST:(%d+):(%d+)$")
                        if slotText then
                            local slot=tonumber(slotText)
                            local retryAt=Farm.skillNativeRetryAt or {}
                            Farm.skillNativeRetryAt=retryAt
                            if os.clock()<(retryAt[slot] or 0) then
                                result="Slot "..slot.." waiting for first-cast retry"
                            elseif id=="109" and LocalPlayer.Character
                                and LocalPlayer.Character:GetAttribute("Rage_Mode")~=nil then
                                result="Rage Mode already active: never toggle off"
                            else
                                local keyOK,keyReady,keyName=pcall(function()
                                    return bridge:Invoke("skill_key",slot)
                                end)
                                if not keyOK or not keyReady then
                                    result="Slot "..slot.." keybind unavailable: "
                                        ..tostring(keyOK and keyName or keyReady)
                                else
                                    -- Avoid rapid presses if input delivery or game
                                    -- state replication is delayed. Rage is a toggle.
                                    retryAt[slot]=os.clock()+(id=="109" and 7 or 2.0)
                                    local pressed,method=Farm.pressSkillHotkey(keyName)
                                    if pressed then
                                        task.wait(0.18)
                                        local checked,started,checkMessage=pcall(function()
                                            return bridge:Invoke("skill_cast_check",{slot=slot,id=id})
                                        end)
                                        if checked and started then
                                            activated=true
                                            Farm.combatSkillAttempts=Farm.combatSkillAttempts+1
                                            Farm.opSkillsCount=Farm.opSkillsCount+1
                                            Farm.skillLastVerifiedAt=os.clock()
                                            result="Native first cast "..id.." in slot "..slot
                                                .." via "..tostring(method).." | "..tostring(checkMessage)
                                        else
                                            result="Pressed skill "..slot.." via "..tostring(method)
                                                .."; not yet verified: "..tostring(checked and checkMessage or started)
                                        end
                                    else
                                        result="Could not auto-initialize slot "..slot..": "..tostring(method)
                                    end
                                end
                            end
                            break
                        end
                        local busy = result:find("slash active", 1, true)
                            or result:find("network request active", 1, true)
                            or result:find("heavy attack active", 1, true)
                        if busy then task.wait(0.07) else break end
                    end
                end
            end
        end
        Farm.skillReservation = false
        Farm.skillReservationDeadline = 0
        Farm.skillPriorityUntil = activated and (os.clock()+0.85) or 0
        Farm.combatSkillLastMessage = result
        Farm.opLastMessage = result
    end)
end

local function startOpWatcher()
    Farm.opRunId = Farm.opRunId + 1
    local token = Farm.opRunId
    task.spawn(function()
        while not Farm.unloaded and
            Farm.autoCombatSkills
            and Farm.opRunId == token do
            requestCombatSkill()
            task.wait(0.18)
        end
    end)
end

function Farm:StartAura()
    if self.unloaded or self.auraEnabled then return end
    self.auraEnabled = true
    self.auraStartedAt = os.clock()
    self.auraAcceptedAtStart = self.slashAccepted
    self.auraLastDiagnosticAt = 0
    self.auraLastBlockReason = nil
    -- Heartbeat only schedules attacks. Slash and registrations run in their
    -- existing guarded coroutine; no frame can start overlapping slashes.
    self.auraRunId = self.auraRunId + 1
    self.auraHeartbeatElapsed = 0
    if self.auraConnection then self.auraConnection:Disconnect() end
    self.auraConnection = RunService.Heartbeat:Connect(function(dt)
        if not Farm.auraEnabled or Farm.unloaded then return end
        Farm.auraHeartbeatElapsed = Farm.auraHeartbeatElapsed + dt
        local tickInterval = Farm.auraMode == "Turbo" and 0.03
            or (Farm.auraMode == "Aggressive" and 0.06 or 0.12)
        if Farm.auraHeartbeatElapsed < tickInterval then return end
        Farm.auraHeartbeatElapsed = 0
        -- Keep the saved toggle ON while the game loads, but do not schedule
        -- a slash before POST and the game's native combat controller are ready.
        local combatReady = Farm:CombatStartupReady()
        -- A lightweight diagnostic runs only every 8 seconds, never in the UI.
        -- It helps distinguish missing Titan napes from combat/reload locks.
        local diagnosticNow = os.clock()
        if diagnosticNow - (Farm.auraLastDiagnosticAt or 0) > 8 then
            Farm.auraLastDiagnosticAt = diagnosticNow
            local blocked = nil
            if not combatReady then
                blocked = "Startup waiting: " .. tostring(Farm.combatStartup.reason)
            elseif not getPlayerRoot() then
                blocked = "Character not ready"
            elseif Farm.utilityBusy then
                blocked = "Utility busy: " .. tostring(Farm.utilityBusyOwner or "Waves/other")
            elseif Farm.bladeRecoveryActive then
                blocked = "Equipped blades broken; awaiting recovery"
            elseif Farm.skillReservation then
                blocked = "Auto Skills has reserved the current attack window"
            elseif not hasAuraTarget() then
                local folder = Workspace:FindFirstChild("Titans")
                blocked = folder and "No living Titans with Hitboxes.Hit.Nape detected"
                    or "Workspace.Titans not replicated yet"
            elseif not POST or not POST.Parent then
                blocked = "Combat POST remote not yet replicated"
            elseif Farm.attackHeld then
                blocked = "Previous slash release is pending: " .. tostring(Farm.slashStatus)
            elseif diagnosticNow - (Farm.auraStartedAt or 0) > 6
                and Farm.slashAccepted <= (Farm.auraAcceptedAtStart or 0) then
                blocked = "No successful slash start yet: " .. tostring(Farm.slashStatus)
            end
            if blocked ~= Farm.auraLastBlockReason then
                if blocked then do end end
                Farm.auraLastBlockReason = blocked
            end
        end
        if not combatReady then return end
        if Farm.attacking or Farm.utilityBusy or Farm.skillReservation
            or Farm.bladeRecoveryActive then return end
        local now = os.clock()
        local gap = ATTACK_GAP
        if now >= Farm.auraBackoffUntil then
            if Farm.auraMode == "Turbo" then gap = TURBO_ATTACK_GAP
            elseif Farm.auraMode == "Aggressive" then gap = AGGRESSIVE_ATTACK_GAP end
        end
        if now - Farm.lastAttack < gap or now - Farm.lastSlashAttempt < FAILED_SLASH_RETRY_GAP then return end
        local root = getPlayerRoot()
        if root and hasAuraTarget() then
            -- Auto Farm movement remains independent; never move from Aura.
            tryAttack(nil, true)
        end
    end)
end

function Farm:StopAura()
    self.opRunId = self.opRunId + 1
    self.auraEnabled = false
    if self.auraConnection then
        self.auraConnection:Disconnect()
        self.auraConnection = nil
    end
    self.auraHeartbeatElapsed = 0
    if self.autoCombatSkills then startOpWatcher() end
    self.auraRunId = self.auraRunId + 1
    releaseSwingFreeze()
    setAttackHeld(false)
end

-- Physics support for Tween mode. TweenService changes CFrame, but the
-- character is still a simulated assembly and can fall between tween updates.
-- Counter gravity plus damp downward/upward drift; never anchor, move,
-- or change the character's CFrame/velocity inside this controller.
local function removeHoverSupport()
    if Farm.hoverForce then
        Farm.hoverForce:Destroy()
        Farm.hoverForce = nil
    end
    if Farm.hoverAttachment then
        Farm.hoverAttachment:Destroy()
        Farm.hoverAttachment = nil
    end
    Farm.hoverRoot = nil
end

local function updateHoverSupport(root)
    if not root then
        removeHoverSupport()
        return
    end
    if Farm.hoverRoot ~= root or not Farm.hoverForce or Farm.hoverForce.Parent ~= root then
        removeHoverSupport()
        -- Remove possible leftovers if a previous execution was interrupted.
        for _, name in ipairs({ "HollowMoonHoverForceV20", "HollowMoonHoverAttachmentV20", "HollowMoonHoverForceV21", "HollowMoonHoverAttachmentV21" }) do
            local prior = root:FindFirstChild(name)
            if prior then prior:Destroy() end
        end
        local attachment = Instance.new("Attachment")
        attachment.Name = "HollowMoonHoverAttachmentV21"
        attachment.Parent = root
        local force = Instance.new("VectorForce")
        force.Name = "HollowMoonHoverForceV21"
        force.Attachment0 = attachment
        force.RelativeTo = Enum.ActuatorRelativeTo.World
        force.ApplyAtCenterOfMass = true
        force.Parent = root
        Farm.hoverRoot = root
        Farm.hoverAttachment = attachment
        Farm.hoverForce = force
    end
    -- Gravity-neutral force, with vertical-velocity damping. Changes FORCE
    -- only, avoiding the root motion/attack conflict seen with AlignPosition.
    local verticalSpeed = root.AssemblyLinearVelocity.Y
    local gravity = Workspace.Gravity
    local acceleration = math.clamp(gravity - verticalSpeed * 8, 0, gravity * 3)
    Farm.hoverForce.Force = Vector3.new(0, root.AssemblyMass * acceleration, 0)
end

-- Momentum-only noclip: disable physical collisions on character BaseParts,
-- not on Titans, weapons' hit detection, or the map. CanTouch and CanQuery
-- are left alone so ordinary attack touch events can still function.
-- Remember original states, including the originally non-collidable pieces.
local function disableMomentumNoclip()
    if Farm.noclipAddedConnection then
        Farm.noclipAddedConnection:Disconnect()
        Farm.noclipAddedConnection = nil
    end
    for part,wasCollidable in pairs(Farm.noclipOriginal) do
        if part.Parent then
            pcall(function() part.CanCollide = wasCollidable end)
        end
    end
    Farm.noclipOriginal = {}
    Farm.noclipCharacter = nil
    Farm.momentumStuckSamplePosition = nil
    Farm.momentumStuckSince = nil
end

local function applyMomentumNoclipPart(part)
    if not part:IsA("BasePart") then return end
    if Farm.noclipOriginal[part] == nil then
        Farm.noclipOriginal[part] = part.CanCollide
    end
    if part.CanCollide then part.CanCollide = false end
end

local function updateMomentumNoclip()
    if Farm.unloaded or not Farm.running or movementUtilityBusy()
        or Farm.method ~= "Momentum (Physics)" or not Farm.momentumNoclip
        or Farm.waitingFreezeActive then
        if Farm.noclipCharacter then disableMomentumNoclip() end
        return
    end
    local character = LocalPlayer.Character
    if not character then
        if Farm.noclipCharacter then disableMomentumNoclip() end
        return
    end
    if Farm.noclipCharacter ~= character then
        disableMomentumNoclip()
        Farm.noclipCharacter = character
        for _,part in ipairs(character:GetDescendants()) do
            applyMomentumNoclipPart(part)
        end
        Farm.noclipAddedConnection = character.DescendantAdded:Connect(function(part)
            if Farm.noclipCharacter == character and Farm.running
                and Farm.method == "Momentum (Physics)" and Farm.momentumNoclip then
                applyMomentumNoclipPart(part)
            end
        end)
    end
    -- Other game code can re-enable CanCollide. Enforce on Heartbeat while
    -- this farm mode runs, but only for the already tracked character parts.
    for part,original in pairs(Farm.noclipOriginal) do
        if part.Parent and part:IsDescendantOf(character) then
            if part.CanCollide then part.CanCollide = false end
        else
            -- Character accessories/tools can be moved outside the character.
            -- Restore their collisions immediately rather than leaving them
            -- ghosted until farming eventually stops.
            if part.Parent then pcall(function() part.CanCollide = original end) end
            Farm.noclipOriginal[part] = nil
        end
    end
end

-- Rare fallback when the root has stopped moving even with noclip active.
-- A small nudge preserves AssemblyLinearVelocity; avoid during a slash.
local function recoverStalledMomentum(root)
    if not Farm.momentumNoclip or not Farm.noclipCharacter
        or Farm.attacking or not getNape(Farm.target) then
        Farm.momentumStuckSince = nil
        Farm.momentumStuckSamplePosition = root.Position
        Farm.momentumStuckSampleAt = os.clock()
        return
    end
    local now = os.clock()
    if not Farm.momentumStuckSamplePosition then
        Farm.momentumStuckSamplePosition = root.Position
        Farm.momentumStuckSampleAt = now
        return
    end
    if now - Farm.momentumStuckSampleAt < 0.35 then return end
    local traveled = (root.Position - Farm.momentumStuckSamplePosition).Magnitude
    local actualSpeed = root.AssemblyLinearVelocity.Magnitude
    Farm.momentumStuckSamplePosition = root.Position
    Farm.momentumStuckSampleAt = now
    if traveled >= 3 or actualSpeed >= 30 then
        Farm.momentumStuckSince = nil
        return
    end
    Farm.momentumStuckSince = Farm.momentumStuckSince or now
    if now - Farm.momentumStuckSince < 1.4
        or now - Farm.momentumLastRecoveryAt < 3 then return end
    local direction = root.CFrame.LookVector
    local horizontal = Vector3.new(direction.X,0,direction.Z)
    if horizontal.Magnitude < 0.1 then horizontal = Vector3.new(1,0,0) end
    root.CFrame = root.CFrame + horizontal.Unit*10 + Vector3.new(0,5,0)
    Farm.momentumLastRecoveryAt = now
    Farm.momentumStuckSince = nil
    do end
end

-- EXPERIMENTAL: physical momentum travel. Boost input is not required;
-- actual physical movement speed is the quantity to test. Unlike a CFrame Tween,
-- this applies real-world-space force to preserve velocity during slashes.
-- Server damage validation may use additional state; Tween stays the default.
local function removeMomentumDrive()
    if Farm.momentumForce then
        Farm.momentumForce:Destroy()
        Farm.momentumForce = nil
    end
    if Farm.momentumAttachment then
        Farm.momentumAttachment:Destroy()
        Farm.momentumAttachment = nil
    end
    Farm.momentumRoot = nil
    Farm.momentumOrbitTitan = nil
    Farm.momentumStuckSamplePosition = nil
    Farm.momentumStuckSince = nil
end

-- V72: teleport to a safe overhead starting point BEFORE starting momentum.
-- This avoids the original diagonal acceleration across the map at ground
-- level while approaching a Titan (dangerous during Eren's scream/AOE).
-- Use Farm's fixed 200-stud-above-head CFrame; do NOT keep teleporting during
-- normal high-speed flight because that would erase physical slash momentum.
function Farm:EnsureAirStart()
    if not self.running or self.unloaded or self.method ~= "Momentum (Physics)" then
        return false
    end
    local root = getPlayerRoot()
    if not root or root.Anchored then return false end
    if self.airStartRoot == root then return true end

    local target = getNape(self.target) and self.target or findClosestTitan(root.Position)
    local nape = getNape(target)
    if not nape then
        -- v109: Mobile may stream the moving Female Titan's model before Nape.
        -- Move toward its actual rig without trying to register premature hits.
        local visibleTarget, visibleAnchor = self:GetClosestNavigationTarget(root.Position)
        if visibleTarget and visibleAnchor then
            self.target = visibleTarget
            cancelTween()
            resetTweenGoalFilter()
            removeMomentumDrive()
            root.CFrame = getFarmCFrame(visibleTarget, visibleAnchor)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            self.airStartRoot = root
            self.airStartLiftedRoot = root
            self.movementElapsed = REPATH_TIME
            do end
            return true
        end
        -- No target spawned yet: leave the ground once, but don't accelerate
        -- horizontally until we can place the character over a real target.
        if self.airStartLiftedRoot ~= root then
            self.airStartLiftedRoot = root
            root.CFrame = root.CFrame + Vector3.new(0, self.farmDistance, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            do end
        end
        return false
    end

    self.target = target
    cancelTween()
    resetTweenGoalFilter()
    removeMomentumDrive()
    local overhead = getFarmCFrame(target, nape)
    root.CFrame = overhead
    -- Reset old ground-level impulse ONCE during the safety teleport.
    -- From the next Heartbeat onward, real momentum is preserved by physics.
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    self.airStartRoot = root
    self.airStartLiftedRoot = root
    self.movementElapsed = REPATH_TIME
    do end
    return true
end

local function updateMomentumDrive(dt)
    if Farm.unloaded or not Farm.running or Farm.method ~= "Momentum (Physics)" then
        removeMomentumDrive()
        return
    end
    local root = getPlayerRoot()
    if not root or root.Anchored then
        removeMomentumDrive()
        return
    end
    if Farm.momentumRoot ~= root or not Farm.momentumForce
        or Farm.momentumForce.Parent ~= root then
        removeMomentumDrive()
        for _,name in ipairs({"HollowMoonMomentumAttachmentV63", "HollowMoonMomentumForceV63"}) do
            local old = root:FindFirstChild(name)
            if old then old:Destroy() end
        end
        local attachment = Instance.new("Attachment")
        attachment.Name = "HollowMoonMomentumAttachmentV63"
        attachment.Parent = root
        local force = Instance.new("VectorForce")
        force.Name = "HollowMoonMomentumForceV63"
        force.Attachment0 = attachment
        force.RelativeTo = Enum.ActuatorRelativeTo.World
        force.ApplyAtCenterOfMass = true
        force.Parent = root
        Farm.momentumAttachment = attachment
        Farm.momentumForce = force
        Farm.momentumRoot = root
    end

    -- The observed damage increase comes from movement speed, not from a
    -- Boost key state. This controller does not simulate Boost or ODM grapples.
    -- Keep actual physical velocity through slash windows; never CFrame-teleport,
    -- anchor or write AssemblyLinearVelocity here.
    local speed = math.clamp(tonumber(Farm.momentumTargetSpeed) or 400,80,2000)
    local currentVelocity = root.AssemblyLinearVelocity
    local desiredVelocity = Vector3.new(currentVelocity.X*0.95, 0, currentVelocity.Z*0.95)
    local nape = getNape(Farm.target) or Farm:GetNavigationAnchor(Farm.target)
    if nape then
        -- Navigation fallback affects only movement; combat still requires Nape.
        local center = getFarmCFrame(Farm.target,nape).Position
        local offset = Vector3.new(root.Position.X-center.X,0,root.Position.Z-center.Z)
        local distance = offset.Magnitude
        local radial
        if distance >= 0.1 then
            radial = offset.Unit
        else
            local look = root.CFrame.LookVector
            radial = Vector3.new(look.X,0,look.Z)
            radial = radial.Magnitude > 0.1 and radial.Unit or Vector3.new(1,0,0)
        end
        local tangent = Vector3.new(-radial.Z,0,radial.X)
        -- Preserve the v66 speed-adaptive orbit when width is 100%; allow the
        -- separate width slider to scale its horizontal radius without affecting
        -- travel speed or the vertical Farm Distance setting.
        local baseOrbitRadius = math.clamp(speed*speed/340,75,500)
        local widthPercent = math.clamp(tonumber(Farm.momentumOrbitWidth) or 100,25,100)
        local orbitRadius = math.clamp(baseOrbitRadius*widthPercent/100,18.75,500)
        local horizontal
        if distance > orbitRadius*2.0 then
            horizontal = -radial -- travel toward Titan if starting very far away
        elseif distance < orbitRadius*0.45 then
            horizontal = radial -- move outward before beginning a fast orbit
        else
            local radialCorrection = math.clamp((orbitRadius-distance)*1.6,
                -speed*0.85,speed*0.85)
            horizontal = tangent*speed + radial*radialCorrection
            if horizontal.Magnitude > 0.1 then horizontal = horizontal.Unit end
        end
        local vertical = math.clamp((center.Y-root.Position.Y)*1.9
            -currentVelocity.Y*0.3,-90,90)
        desiredVelocity = Vector3.new(horizontal.X*speed,vertical,horizontal.Z*speed)
    end
    -- Physical acceleration, not instant velocity injection. Actual speed and
    -- damage can be lower if game movement physics/server validation disagrees.
    local acceleration = (desiredVelocity-currentVelocity)*5.5
    local maxAcceleration = math.clamp(speed*10,350,20000)
    if acceleration.Magnitude > maxAcceleration then
        acceleration = acceleration.Unit*maxAcceleration
    end
    Farm.momentumForce.Force = root.AssemblyMass*(acceleration
        + Vector3.new(0,Workspace.Gravity,0))
    recoverStalledMomentum(root)
end

-- Auto Farm runs on Heartbeat, but deliberately only *decides* where to move
-- every 0.10 seconds (the original v11 cadence). Roblox TweenService handles
-- interpolation between decisions. This avoids continuously overwriting the
-- player's CFrame/velocity while the existing attack system is active.
local function farmStep()
    if Farm.unloaded or not Farm.running or movementUtilityBusy() then return end

    local root = getPlayerRoot()
    if not root then
        Farm.target = nil
        cancelTween()
        resetTweenGoalFilter()
        return
    end

    -- Keep the current tween playing throughout the normal slash and remote
    -- registration. Repath/cancel/create during this window caused visible
    -- corrections competing with the swing. The optional brief anchor is
    -- controlled separately by updateSwingFreeze(), not by TweenService.
    if Farm.method == "Tween" and Farm.auraEnabled and Farm.attacking then
        return
    end

    local nape = getNape(Farm.target)
    local reserved = getReservedLastTitan()
    -- Retarget away from reserved Titan if other living Titans are available.
    if nape and reserved == Farm.target and #getLivingTitans() > 1 then
        nape = nil
    end
    if not nape then
        Farm.target = findClosestTitan(root.Position)
        nape = getNape(Farm.target)
        if not nape then
            -- Only navigation uses a rig part while the streamed hitbox is late.
            local candidate, anchor = Farm:GetClosestNavigationTarget(root.Position)
            Farm.target = candidate
            nape = anchor
        end
        cancelTween()
        resetTweenGoalFilter()
    end
    if not nape or not Farm.target then
        cancelTween()
        resetTweenGoalFilter()
        return
    end

    local desired = getFarmCFrame(Farm.target, nape)
    -- Smooth only Tween's goal (not root CFrame), so the normal slash +
    -- nape registration continues exactly as in the working v21.
    if Farm.method == "Tween" then
        desired = smoothTweenGoal(Farm.target, desired)
    end
    local distance = (root.Position - desired.Position).Magnitude

    if Farm.method == "Momentum (Physics)" then
        -- Heartbeat physics controller owns movement; do not Tween, anchor, or
        -- zero actual ODM velocity while a slash is registered.
        cancelTween()
    elseif Farm.method == "Teleport" then
        -- Identical to working v21 Teleport behavior.
        cancelTween()
        root.CFrame = desired
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    else
        local current = Farm.activeTween
        local isPlaying = current and current.PlaybackState == Enum.PlaybackState.Playing
        local changedTarget = Farm.tweenRoot ~= root or Farm.tweenTarget ~= Farm.target
        local goalShift = Farm.tweenGoal
            and (Farm.tweenGoal.Position - desired.Position).Magnitude
            or math.huge
        local tweenAge = os.clock() - Farm.tweenStartedAt
        local redirectNeeded = isPlaying
            and goalShift >= TWEEN_REPATH_DISTANCE
            and tweenAge >= TWEEN_REPATH_DELAY
        -- If physics pulls us below the intended altitude near the Titan,
        -- refresh the Tween early. Do not force root velocity/CFrame or add a
        -- VectorForce while Kill Aura is on: those broke combat in v20.
        local verticalSink = desired.Position.Y - root.Position.Y
        local sinkRecovery = isPlaying
            and distance <= TWEEN_SINK_RECOVERY_RADIUS
            and verticalSink >= TWEEN_SINK_RECOVERY
            and tweenAge >= TWEEN_SINK_REPATH_DELAY

        if changedTarget or not isPlaying or redirectNeeded or sinkRecovery then
            cancelTween()
            local closeToGoal = distance <= TWEEN_MIN_DISTANCE
            local goal = desired
            local duration
            if closeToGoal then
                -- The old 8-second almost-static Tween was effectively idle.
                -- Short continuous Tweens keep the desired height active.
                goal = desired * CFrame.new(0, TWEEN_HOVER_LIFT, 0)
                duration = TWEEN_HOVER_DURATION
            else
                local speed = TWEEN_SPEED
                if Farm.auraEnabled and Farm.freezeDuringSwing then
                    speed = speed * TWEEN_AURA_CATCHUP
                end
                duration = math.clamp(distance / speed, TWEEN_MIN_DURATION, 15)
            end
            local tween = TweenService:Create(
                root,
                TweenInfo.new(
                    duration,
                    closeToGoal and Enum.EasingStyle.Sine or Enum.EasingStyle.Linear,
                    closeToGoal and Enum.EasingDirection.InOut or Enum.EasingDirection.Out
                ),
                { CFrame = goal }
            )
            Farm.activeTween = tween
            Farm.tweenGoal = desired
            Farm.tweenTarget = Farm.target
            Farm.tweenRoot = root
            Farm.tweenStartedAt = os.clock()
            tween:Play()
        end
    end

    -- Exact v11 close-range attack condition. The separate Aura loop below
    -- still runs untouched; no movement pause and no per-frame velocity resets.
    if not Farm.auraEnabled and canAttackTitan(Farm.target) and
       (root.Position - nape.Position).Magnitude <= ATTACK_DISTANCE then
        tryAttack(Farm.runId, false)
    end
end

-- Diagnostic only. Measures root travel versus camera displacement relative to
-- the root during one attack; does not change the camera or character.
local function recordSwingMotion()
    if not (Farm.auraEnabled and Farm.running and Farm.method == "Tween") then
        Farm.wasSwinging = false
        return
    end
    local root = getPlayerRoot()
    if not root then
        Farm.wasSwinging = false
        return
    end
    local camera = Workspace.CurrentCamera
    local relativeCameraY = camera and (camera.CFrame.Position.Y - root.Position.Y) or nil
    if Farm.attacking and not Farm.wasSwinging then
        Farm.swingStartHeight = root.Position.Y
        Farm.swingStartCameraOffsetY = relativeCameraY
    elseif not Farm.attacking and Farm.wasSwinging then
        Farm.lastSwingEndedAt = os.clock()
        Farm.lastSwingMotion = {
            rootDeltaY = Farm.swingStartHeight and (root.Position.Y - Farm.swingStartHeight) or 0,
            cameraOffsetDeltaY = relativeCameraY and Farm.swingStartCameraOffsetY
                and (relativeCameraY - Farm.swingStartCameraOffsetY) or nil,
        }
    end
    Farm.wasSwinging = Farm.attacking
end

-- Dedicated, non-anchored midair hold while the final Titan is protected.
-- Prevents gravity from dropping the player after we stop the fast orbit, and
-- does not continually teleport/anchor the root or run a second farm loop.
function Farm:UpdateLastTitanAirHold()
    local root = self.waitingFreezeRoot
    local goal = self.lastTitanAirPosition
    if not root or not root.Parent or not goal or root.Anchored then return end

    if self.lastTitanAirRoot ~= root or not self.lastTitanAirAlign
        or self.lastTitanAirAlign.Parent ~= root then
        local oldAlign, oldAttachment = self.lastTitanAirAlign, self.lastTitanAirAttachment
        self.lastTitanAirAlign, self.lastTitanAirAttachment = nil, nil
        if oldAlign then pcall(function() oldAlign:Destroy() end) end
        if oldAttachment then pcall(function() oldAttachment:Destroy() end) end
        for _, name in ipairs({"HollowMoonLastTitanAirPositionV123", "HollowMoonLastTitanAirAttachmentV123"}) do
            local leftover = root:FindFirstChild(name)
            if leftover then leftover:Destroy() end
        end
        -- Lift ONCE if the player wasn't already above the remaining Titan.
        -- All following updates use physical position alignment, never CFrame writes.
        if (root.Position - goal).Magnitude > 65 then
            root.CFrame = CFrame.new(goal) * root.CFrame.Rotation
        end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local attachment = Instance.new("Attachment")
        attachment.Name = "HollowMoonLastTitanAirAttachmentV123"
        attachment.Parent = root
        local align = Instance.new("AlignPosition")
        align.Name = "HollowMoonLastTitanAirPositionV123"
        align.Attachment0 = attachment
        align.Mode = Enum.PositionAlignmentMode.OneAttachment
        align.ApplyAtCenterOfMass = true
        align.RigidityEnabled = false
        align.Responsiveness = 25
        align.MaxVelocity = 220
        align.MaxForce = math.max(20000, root.AssemblyMass * 2000)
        align.Position = goal
        align.Parent = root
        self.lastTitanAirRoot = root
        self.lastTitanAirAttachment = attachment
        self.lastTitanAirAlign = align
    else
        -- Follow a moving Titan's head at the user's selected safe height.
        self.lastTitanAirAlign.Position = goal
    end
end

local function heartbeatFarm(dt)
    if not Farm.running or Farm.unloaded or movementUtilityBusy() then
        releaseSkillNapeAssist()
        releaseLastTitanWaitFreeze()
        -- Stop physical acceleration during resupply, script shutdown,
        -- or other utility actions that need control of the character.
        if Farm.momentumForce then removeMomentumDrive() end
        if Farm.noclipCharacter then disableMomentumNoclip() end
        return
    end
    -- Final-Titan hold takes over only while one protected Titan remains.
    -- Its physical AlignPosition keeps us airborne without root.Anchored.
    updateSwingFreeze()
    if updateLastTitanWaitFreeze() then
        cancelTween()
        if Farm.hoverForce then removeHoverSupport() end
        if Farm.momentumForce then removeMomentumDrive() end
        if Farm.noclipCharacter then disableMomentumNoclip() end
        Farm:UpdateLastTitanAirHold()
        return
    end
    updateMomentumNoclip()
    if Farm.method == "Momentum (Physics)" and not Farm:EnsureAirStart() then
        if Farm.momentumForce then removeMomentumDrive() end
        return -- never fly horizontally toward a Titan from an unsafe spawn height
    end
    recordSwingMotion()
    -- Critical regression fix: the v20 VectorForce conflicted with the
    -- working slash + nape registration when Auto Farm and Kill Aura ran
    -- together.  Return EXACTLY to v17 physics while Kill Aura is enabled.
    -- Also avoid forces during ordinary (non-aura) attacks or without a Titan.
    local combatOrNoTarget = Farm.auraEnabled or Farm.attacking or not getNape(Farm.target)
    if Farm.method == "Tween" and not combatOrNoTarget then
        updateHoverSupport(getPlayerRoot())
    elseif Farm.hoverForce then
        removeHoverSupport()
    end
    if Farm.method == "Momentum (Physics)" then
        updateMomentumDrive(dt)
    elseif Farm.momentumForce then
        removeMomentumDrive()
    end
    Farm.movementElapsed = Farm.movementElapsed + dt
    if Farm.movementElapsed < REPATH_TIME then return end
    Farm.movementElapsed = Farm.movementElapsed % REPATH_TIME
    farmStep()
end

function Farm:Stop()
    local stoppingFarm = self.running or self.farmOwner ~= nil
        or self.momentumForce ~= nil or self.hoverForce ~= nil
    local root = getPlayerRoot()
    self.running = false
    self.farmOwner = nil
    releaseSkillNapeAssist()
    releaseSwingFreeze()
    releaseLastTitanWaitFreeze()
    self.runId = self.runId + 1
    self.target = nil
    if self.movementConnection then
        self.movementConnection:Disconnect()
        self.movementConnection = nil
    end
    self.movementElapsed = 0
    self.wasSwinging = false
    self.swingStartHeight = nil
    self.swingStartCameraOffsetY = nil
    self.lastSwingEndedAt = 0
    cancelTween()
    resetTweenGoalFilter()
    removeHoverSupport()
    removeMomentumDrive()
    disableMomentumNoclip()
    self.airStartRoot = nil
    self.airStartLiftedRoot = nil
    -- Canceled VectorForces do not cancel velocity they already imparted.
    -- When the player turns farming OFF, return control to ordinary Roblox
    -- physics instead of leaving several hundred studs/sec of orbit momentum.
    if root and root.Parent then
        for _, partName in ipairs({
            "HollowMoonMomentumForceV63", "HollowMoonMomentumAttachmentV63",
            "HollowMoonHoverForceV20", "HollowMoonHoverAttachmentV20",
            "HollowMoonHoverForceV21", "HollowMoonHoverAttachmentV21",
            "HollowMoonLastTitanAirPositionV123", "HollowMoonLastTitanAirAttachmentV123",
        }) do
            local leftover = root:FindFirstChild(partName)
            if leftover then pcall(function() leftover:Destroy() end) end
        end
        if stoppingFarm and not root.Anchored then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
    setAttackHeld(false)
end

function Farm:Start()
    if self.running or self.unloaded then return end
    self.momentumNoclip = true -- inseparable from Auto Farm, including old saved settings
    self.running = true
    self.runId = self.runId + 1
    self.airStartRoot = nil
    self.airStartLiftedRoot = nil
    self.movementElapsed = REPATH_TIME -- first position acquired immediately
    if self.method == "Momentum (Physics)" then
        updateMomentumNoclip()
        self:EnsureAirStart() -- teleport BEFORE the first movement Heartbeat
    end
    self.movementConnection = RunService.Heartbeat:Connect(heartbeatFarm)
end

-- Only the active game mode owns Auto Farm. Saved settings remain independent.
-- Wave activity is checked against the live objective (not merely the lobby's
-- selected mode), so leaving Waves releases all movement automatically.
function Farm:SyncFarmMode()
    if self.unloaded then return end
    local wanted = nil
    if game.PlaceId ~= 14916516914 and game.PlaceId ~= 13379208636 then
        local wavesActive = false
        if game.PlaceId == 14012874501 then
            if self.Waves and type(self.Waves.isActive) == "function" then
                local ok, value = pcall(self.Waves.isActive)
                wavesActive = ok and value == true
            else
                -- Early mobile restore, before the Waves controller exists.
                local wf = Workspace:FindFirstChild("Waves")
                local objectives = wf and wf:FindFirstChild("Objectives")
                wavesActive = objectives ~= nil and objectives:FindFirstChild("Waves") ~= nil
            end
        end
        -- A Trost RAID is not the Waves mode. Only active Waves objectives
        -- use the independent Auto Farm Waves toggle. Ordinary Auto Farm
        -- owns every other gameplay map, including non-Waves Trost raids.
        if wavesActive then
            if self.waveFarmEnabled then wanted = "waves" end
        elseif self.generalFarmEnabled then
            wanted = "regular"
        end
    end

    if wanted == self.farmOwner and (wanted == nil or self.running) then return end
    if self.running or self.farmOwner ~= nil then self:Stop() end
    if wanted then
        self.farmOwner = wanted
        self:Start()
    end
end

-- v104: Diagnostics stay OUT of Rayfield. A saved ON toggle can look
-- broken if there is no character, no Titan nape, or a station utility owns
-- movement. Report the actual reason rather than silently appearing idle.
function Farm:ReportFarmMovementStatus()
    if self.unloaded or not self.generalFarmEnabled or game.PlaceId == 14916516914 or game.PlaceId == 13379208636 then return end
    if self.farmOwner == "waves" then return end
    local message
    local root = getPlayerRoot()
    local candidates = self:GetFarmTargetModels()
    if not self.running or self.farmOwner ~= "regular" then
        message = "Regular Auto Farm ON, no movement controller (PlaceId="..game.PlaceId..")"
    elseif not root then
        message = "Auto Farm waiting for character/HumanoidRootPart"
    elseif movementUtilityBusy() then
        message = "Movement paused by utility: "..tostring(self.utilityBusyOwner or "unknown")
    elseif root.Anchored and not self.waitingFreezeActive then
        message = "Movement paused: character root anchored"
    elseif #candidates == 0 then
        local folder = Workspace:FindFirstChild("Titans")
        local visible = #(self.navigationCandidateModels or {})
        message = "Nape hitboxes pending="..tostring(visible)
            .." visible moving raid rigs; "..tostring(self.targetModelSource or "source unknown")
            .. "; direct Titans children="..tostring(folder and #folder:GetChildren() or 0)
            .. "; PlaceId="..tostring(game.PlaceId)
    elseif self.method == "Momentum (Physics)" and self.airStartRoot ~= root then
        message = "Movement acquiring air start; valid targets="..#candidates
    else
        message = "Movement active; targets="..#candidates
            .. "; target="..tostring(self.target and self.target.Name or "acquiring")
    end
    local now = os.clock()
    if message ~= self.lastFarmMovementReport
        or (now - (self.lastFarmMovementReportAt or 0)) > 25 then
        self.lastFarmMovementReport = message
        self.lastFarmMovementReportAt = now
        do end
    end
end

-- Quiet mode watcher: the game can spawn Titans AFTER the script starts.
-- Reconcile independently of UI and report only meaningful status changes.
if game.PlaceId ~= 14916516914 and game.PlaceId ~= 13379208636 then
Farm.farmModeConnection = RunService.Heartbeat:Connect(function(dt)
    if Farm.unloaded then
        if Farm.farmModeConnection then
            Farm.farmModeConnection:Disconnect()
            Farm.farmModeConnection = nil
        end
        return
    end
    Farm.farmModeElapsed = (Farm.farmModeElapsed or 0) + dt
    if Farm.farmModeElapsed >= 0.4 then
        Farm.farmModeElapsed = 0
        Farm:SyncFarmMode()
        Farm.farmDiagnosticElapsed = (Farm.farmDiagnosticElapsed or 0) + 0.4
        if Farm.farmDiagnosticElapsed >= 5 then
            Farm.farmDiagnosticElapsed = 0
            Farm:ReportFarmMovementStatus()
        end
    end
end)
end -- no gameplay farm watchdog in Town Central

-- Blade utilities use the Outskirts client source contracts:
--   GET:InvokeServer("Blades", "Reload") replaces a broken blade pair.
--   POST:FireServer("Attacks", "Reload", refillPart) requests a station refill.
-- As with normal play, the server may reject either operation. Never claim
-- success merely because a remote call returned without throwing.
local UTILITY_TICK = 0.25
local BLADE_RELOAD_COOLDOWN = 1.3
local STATION_REFILL_COOLDOWN = 9.0

local function utilityLog(message)
    Farm.utilityLastMessage = tostring(message)
    do end
end

local function getBladeRig()
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChild("Rig_" .. character.Name)
end

-- Matches the game's ODMG.Blade_Check and ODMG.Get_Reload rules.
-- The rig contains 7 blade segments per hand and up to 3 spare pairs.
local function inspectBlades()
    local rig = getBladeRig()
    if not rig then return nil end

    local leftHand = rig:FindFirstChild("LeftHand")
    local rightHand = rig:FindFirstChild("RightHand")
    if not leftHand or not rightHand then return nil end

    local hasWorkingBlades = false
    local partialPairs, visiblePairs = 0, 0
    for index = 7, 1, -1 do
        local left = leftHand:FindFirstChild("Blade_" .. index)
        local right = rightHand:FindFirstChild("Blade_" .. index)
        if left or right then visiblePairs = visiblePairs + 1 end
        if left and right then
            -- v79 checked only the LEFT blade. A broken right-hand blade
            -- could be mistaken for a usable pair, stopping reload attempts.
            if left:GetAttribute("Broken") == nil and right:GetAttribute("Broken") == nil then
                hasWorkingBlades = true
            else
                partialPairs = partialPairs + 1
            end
        end
    end

    local sparePairs = 0
    for index = 1, 3 do
        local left = rig:FindFirstChild("Left_" .. index, true)
        local right = rig:FindFirstChild("Right_" .. index, true)
        if left and right and left:GetAttribute("Used") == nil
            and right:GetAttribute("Used") == nil then
            sparePairs = sparePairs + 1
        end
    end
    return {
        working = hasWorkingBlades, sparePairs = sparePairs,
        visiblePairs = visiblePairs, partialPairs = partialPairs,
    }
end

-- A hidden, read-only blade guard. It never inserts another UI control and
-- never assumes a reload succeeded until the rig actually contains working blades.
-- Existing Auto Reload / Auto Refill toggles still control the actual actions.
local function bladeNeedsRecovery()
    if not (Farm.utilityAutoReload or Farm.utilityAutoRefill) then return false end
    local b=inspectBlades()
    if not b then return false end
    if not b.working and Farm.utilityAutoReload and b.sparePairs>0 then return true end
    if b.sparePairs==0 and Farm.utilityAutoRefill then return true end
    return false
end
Farm.bladeNeedsRecovery=bladeNeedsRecovery

local function getStationUses(part)
    local holder = part.Parent
    if not holder then return 0 end
    local stationUses = holder:GetAttribute("Refills")
    if stationUses ~= nil then
        return tonumber(stationUses) or 0
    end
    -- In Trost Waves the HQ can purchase extra Refills from its Upgrades
    -- folder. The old utility watcher only read the ordinary player attribute.
    local available=tonumber(LocalPlayer:GetAttribute("Refills")) or 0
    if game.PlaceId==14012874501 then
        local f=Workspace:FindFirstChild("Waves")
        local upgrades=f and f:FindFirstChild("Upgrades")
        local refill=upgrades and upgrades:FindFirstChild("Refills")
        if refill and refill:IsA("ValueBase") then
            available=available + (tonumber(refill.Value) or 0)
        end
    end
    return available
end

local function findRefillStation(origin)
    if os.clock() - Farm.utilityStationScannedAt > 3 then
        local stations = {}
        -- Outskirts snapshot includes six Refill parts near the gate's gas tanks.
        -- Discover them dynamically in case the mission changes the map.
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Refill" then
                table.insert(stations, obj)
            end
        end
        Farm.utilityStationCache = stations
        Farm.utilityStationScannedAt = os.clock()
    end
    local best, bestDistance
    for _, part in ipairs(Farm.utilityStationCache or {}) do
        if part.Parent then
            local uses = getStationUses(part)
            if uses == nil or uses > 0 then
                local distance = (part.Position - origin).Magnitude
                if not bestDistance or distance < bestDistance then
                    best = part
                    bestDistance = distance
                end
            end
        end
    end
    return best
end

local function refreshGET()
    if GET and GET.Parent and GET:IsA("RemoteFunction") then return GET end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    GET = remotes and remotes:FindFirstChild("GET")
    return GET
end

local function refreshPOST()
    if POST and POST.Parent and POST:IsA("RemoteEvent") then return POST end
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    POST = remotes and remotes:FindFirstChild("POST")
    return POST
end

-- Prefer the game's native Actor Host state over the outer attack flag.
-- This readiness probe never changes game state or sends a reload request.
local function nativeReloadWindow()
    if Farm.attacking or Farm.attackHeld or Farm.skillReservation then
        return false, "outer slash/skill still running"
    end
    if os.clock() < (Farm.skillPriorityUntil or 0) then
        return false, "recent skill still settling"
    end
    local bridge, reason = resolveSlashBridge()
    if not bridge then
        -- In environments without Actor access, retain a conservative pause.
        -- A failed fallback request is still verified against the blade rig.
        local elapsed = os.clock() - (Farm.lastSlashAttempt or -100)
        return elapsed > 2.2, "Actor state unavailable (" .. tostring(reason) .. ")"
    end
    local ok, ready, detail = pcall(function()
        return bridge:Invoke("reload_window")
    end)
    if not ok then
        return false, "Actor reload check failed: " .. tostring(ready)
    end
    return ready == true, tostring(detail or "unknown combat state")
end

-- Broken blades own a combat-free window until the game confirms recovery.
-- This keeps Turbo Kill Aura and Auto Skills from jumping into the gaps
-- between individual reload retries.
-- HollowMoonWaveBladeGuardV82: the server may hold InvokeServer indefinitely.
-- A watchdog releases ONLY the reload-owned busy flag; requests are still
-- spaced apart so a stalled server response does not spam duplicate reloads.
local function tryBladeReload()
    if Farm.utilityBusy or Farm.unloaded or not Farm.utilityAutoReload then return end
    local now = os.clock()
    if now < (Farm.utilityReloadBackoffUntil or 0) then return end
    if Farm.utilityReloadPending then
        if now - Farm.utilityReloadPendingSince < 14 then return end
        -- An old yielded RemoteFunction cannot claim a later worker's result.
        Farm.utilityReloadRequestSerial = Farm.utilityReloadRequestSerial + 1
        Farm.utilityReloadPending = false
        Farm.utilityRecoveredStalls = Farm.utilityRecoveredStalls + 1
        Farm.utilityReloadBackoffUntil = now + 1.5
        utilityLog("Reload server request timed out; retrying after cooldown")
        return
    end
    if now - Farm.utilityLastReload < BLADE_RELOAD_COOLDOWN then return end
    Farm.utilityLastReload = now
    Farm.utilityReloadAttempt = Farm.utilityReloadAttempt + 1
    local attempt = Farm.utilityReloadAttempt
    Farm.utilityBusy = true
    Farm.utilityBusyOwner = "blade-reload"
    Farm.utilityBusySince = now

    task.spawn(function()
        local ok, err = pcall(function()
            local deadline = os.clock() + 4.5
            local quietSince = nil
            local lastReason = "Not checked"
            while not Farm.unloaded and Farm.utilityAutoReload
                and os.clock() < deadline do
                if Farm.utilityBusyOwner ~= "blade-reload"
                    or Farm.utilityReloadAttempt ~= attempt then return end
                if Farm.attackHeld and not Farm.attacking then
                    -- Finish a slash the script previously started before reloading.
                    setAttackHeld(false)
                end
                local ready, reason = nativeReloadWindow()
                Farm.utilityReloadLastNativeReady = ready
                Farm.utilityReloadLastNativeReason = reason
                lastReason = reason
                if ready then
                    quietSince = quietSince or os.clock()
                    if os.clock() - quietSince >= 0.2 then break end
                else
                    quietSince = nil
                end
                task.wait(0.1)
            end
            if Farm.unloaded or not Farm.utilityAutoReload then return end
            if Farm.utilityBusyOwner ~= "blade-reload"
                or Farm.utilityReloadAttempt ~= attempt then return end
            if not quietSince or os.clock() - quietSince < 0.2 then
                Farm.utilityReloadBackoffUntil = os.clock() + 0.75
                if Farm.utilityReloadLastBlockLogged ~= lastReason then
                    Farm.utilityReloadLastBlockLogged = lastReason
                    utilityLog("Reload waiting for " .. tostring(lastReason))
                end
                return
            end
            Farm.utilityReloadLastBlockLogged = nil
            local blades = inspectBlades()
            if not blades or blades.working or blades.sparePairs < 1 then return end
            local remote = refreshGET()
            if not remote or not remote:IsA("RemoteFunction") then
                Farm.utilityReloadBackoffUntil = os.clock() + 2
                utilityLog("GET reload remote unavailable; retrying after cooldown")
                return
            end
            Farm.utilityReloadRequestSerial = Farm.utilityReloadRequestSerial + 1
            local serial = Farm.utilityReloadRequestSerial
            Farm.utilityReloadPending = true
            Farm.utilityReloadPendingSince = os.clock()
            local accepted, response = pcall(function()
                return remote:InvokeServer("Blades", "Reload")
            end)
            if serial ~= Farm.utilityReloadRequestSerial then return end
            Farm.utilityReloadPending = false
            if not accepted then
                Farm.utilityReloadMisses = Farm.utilityReloadMisses + 1
                Farm.utilityReloadBackoffUntil = os.clock() + 3
                utilityLog("Reload request error; will retry: " .. tostring(response))
                return
            end
            -- Nil return is inconclusive. Wait for actual equipped blades,
            -- rather than treating successful pcall as successful reload.
            local confirmDeadline = os.clock() + 1.25
            repeat
                if Farm.unloaded or not Farm.utilityAutoReload then return end
                local after = inspectBlades()
                if after and after.working then
                    Farm.utilityReloadMisses = 0
                    Farm.utilityReloadBackoffUntil = 0
                    Farm.utilityReloadLastBlockLogged = nil
                    utilityLog("Blades reloaded; " .. tostring(after.sparePairs) .. " spare pairs remain")
                    return
                end
                task.wait(0.12)
            until os.clock() >= confirmDeadline
            Farm.utilityReloadMisses = Farm.utilityReloadMisses + 1
            local misses = Farm.utilityReloadMisses
            Farm.utilityReloadBackoffUntil = os.clock() + math.min(5, 1.5 + misses * 0.6)
            if misses == 1 or misses % 3 == 0 then
                utilityLog("Reload not confirmed (response=" .. tostring(response)
                    .. "); retry " .. tostring(misses)
                    .. " after native combat idle")
            end
        end)
        if not ok and not Farm.unloaded then
            Farm.utilityReloadBackoffUntil = os.clock() + 2
            utilityLog("Reload worker recovered from error: " .. tostring(err))
        end
        if Farm.utilityBusyOwner == "blade-reload"
            and Farm.utilityReloadAttempt == attempt then
            Farm.utilityBusyOwner = nil
            Farm.utilityBusySince = 0
            Farm.utilityBusy = false
        end
    end)
end

local function tryStationRefill()
    -- A broken-blade shortage also reserves the attack window. Do not starve
    -- emergency refills just because Turbo Aura is continuously attacking.
    if Farm.utilityBusy then return end
    if os.clock() - Farm.utilityLastRefill < STATION_REFILL_COOLDOWN then return end
    Farm.utilityLastRefill = os.clock()
    local root = getPlayerRoot()
    if not root then return end
    local station = findRefillStation(root.Position)
    if not station then
        utilityLog("No refill station with supplies detected")
        return
    end
    if not refreshPOST() then
        utilityLog("POST remote unavailable; cannot refill")
        return
    end
    local originalCFrame = root.CFrame
    local originalRoot = root
    local token = Farm.utilityToken + 1
    Farm.utilityToken = token
    Farm.utilityBusy = true
    Farm.utilityBusyOwner = "station-refill"
    Farm.utilityBusySince = os.clock()
    cancelTween()
    resetTweenGoalFilter()
    releaseSwingFreeze()
    removeHoverSupport()
    setAttackHeld(false)
    local before = inspectBlades()
    utilityLog("Traveling to blade refill station")

    task.spawn(function()
        local function stillActive()
            return not Farm.unloaded and Farm.utilityToken == token
                and Farm.utilityAutoRefill and getPlayerRoot() == originalRoot
                and station.Parent ~= nil
        end
        local ok, err = pcall(function()
            local deadline=os.clock()+1.4
            while Farm.attacking and stillActive() and os.clock()<deadline do
                task.wait(0.04)
            end
            if Farm.attacking or not stillActive() then
                utilityLog("Refill waiting for current slash; retry scheduled")
                return
            end
            -- Pause Auto Farm's movement while resupplying, then restore position.
            -- The actual refill action requires being near the station.
            if not stillActive() then return end
            local approach = station.Position + Vector3.new(0, 2.5, 0)
            local destination = CFrame.new(approach, approach + originalCFrame.LookVector)
            local distance = (root.Position - approach).Magnitude
            if Farm.method == "Tween" and distance < 650 then
                local duration = math.clamp(distance / 280, 0.2, 3.0)
                local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                    CFrame = destination,
                })
                tween:Play()
                local began = os.clock()
                while stillActive() and os.clock() - began < duration + 0.25
                    and (root.Position - approach).Magnitude > 4 do
                    task.wait(0.08)
                end
                tween:Cancel()
                tween:Destroy()
            else
                root.CFrame = destination
            end
            if not stillActive() then return end
            -- Reposition one last time if gravity pulled the character too far.
            if (root.Position - approach).Magnitude > 6 then
                root.CFrame = destination
            end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.45)
            if not stillActive() then return end
            local usedNative=false
            if game.PlaceId==14012874501 and Farm.Waves
                and type(Farm.Waves.actionBridge)=="function" then
                local bridge=Farm.Waves.actionBridge("waves")
                if bridge then
                    local ok,accepted,detail=pcall(function()
                        return bridge:Invoke("refill")
                    end)
                    if ok and accepted then
                        usedNative=true
                        utilityLog("Waves native station refill sent: "..tostring(detail))
                    end
                end
            end
            if not usedNative then
                local post=refreshPOST()
                if post then
                    post:FireServer("Attacks", "Reload", station)
                    utilityLog("Requested refill via fallback station; checking blades")
                end
            end
            -- The normal client schedules this request after the refill animation;
            -- stay near the station while the server processes the request.
            task.wait(2.8)
            local after = inspectBlades()
            if after and before and after.sparePairs > before.sparePairs then
                utilityLog("Blade supply restored: " .. after.sparePairs .. " spare pairs")
            else
                utilityLog("Refill sent; supplies unconfirmed (station/proximity may matter)")
            end
        end)
        if not ok and not Farm.unloaded then
            utilityLog("Refill attempt encountered an error: " .. tostring(err))
        end
        if Farm.utilityToken==token and getPlayerRoot() == originalRoot
            and not Farm.unloaded then
            originalRoot.CFrame = originalCFrame
            originalRoot.AssemblyLinearVelocity = Vector3.zero
        end
        if Farm.utilityBusyOwner == "station-refill" and Farm.utilityToken == token then
            Farm.utilityBusyOwner = nil
            Farm.utilityBusySince = 0
            Farm.utilityBusy = false
        end
        -- Existing Auto Farm resumes finding Titans on its next Heartbeat.
    end)
end

local function bladeUtilityTick()
    if Farm.unloaded then return end
    -- Only unlock a utility operation that THIS watcher owns. During Waves,
    -- utilityBusy belongs to the crate/upgrade workflow and must be preserved.
    if Farm.utilityBusy and Farm.utilityBusyOwner then
        local maxAge=Farm.utilityBusyOwner=="blade-reload" and 10.0 or 15.0
        if os.clock()-Farm.utilityBusySince > maxAge then
            local stalled=Farm.utilityBusyOwner
            if stalled=="station-refill" then
                Farm.utilityToken=Farm.utilityToken+1
            end
            Farm.utilityBusyOwner=nil
            Farm.utilityBusySince=0
            Farm.utilityBusy=false
            Farm.utilityRecoveredStalls=Farm.utilityRecoveredStalls+1
            utilityLog("Recovered stalled "..stalled.." worker; utility checks resumed")
        end
    end
    -- Unstick a Lua-side slash flag only if it has been stale far longer
    -- than the normal ~0.25-second attack. A serial prevents its old worker
    -- from clearing a newer attack when the old call eventually completes.
    if Farm.attacking and Farm.attackStartedAt>0
        and os.clock()-Farm.attackStartedAt>6 then
        Farm.attackSerial=Farm.attackSerial+1
        Farm.attacking=false
        Farm.utilityRecoveredStalls=Farm.utilityRecoveredStalls+1
        utilityLog("Recovered stale slash-in-progress flag; reload can retry")
    end
    -- IMPORTANT: read the rig even while Waves temporarily owns utilityBusy.
    -- Only ACTIONS (remote requests/movement) wait for the owner to release it.
    local blades=inspectBlades()
    local state
    if not blades then
        state="Rig unavailable"
    elseif not blades.working then
        state="BROKEN | spares="..blades.sparePairs
    elseif blades.sparePairs==0 then
        state="Working blades | NO SPARES"
    else
        state="Working blades | spares="..blades.sparePairs
    end
    Farm.bladeWatcherState=state
    Farm.bladeLastObserved=blades
    -- Hidden priority bit. It is set BEFORE checking utilityBusy so it
    -- remains active even when a prior reload attempt has failed/yielded.
    -- Only a BROKEN equipped blade pair must block Kill Aura/Auto Skills.
    -- Empty spares with still-working blades triggers a supply trip, but is
    -- not itself a reason to suppress all combat indefinitely.
    Farm.bladeRecoveryActive = blades ~= nil and (not blades.working)
        and (Farm.utilityAutoReload or Farm.utilityAutoRefill) or false
    if state~=Farm.bladeWatcherLastPrint then
        Farm.bladeWatcherLastPrint=state
        Farm.bladeWatcherLastChange=os.clock()
        if Farm.utilityAutoReload or Farm.utilityAutoRefill then
            utilityLog("Blade guard: "..state)
        end
    end
    if not blades then
        if (Farm.utilityAutoReload or Farm.utilityAutoRefill) and not Farm.utilityWarnedRig then
            Farm.utilityWarnedRig=true
            utilityLog("Character blade rig not found yet; waiting")
        end
        return
    end
    Farm.utilityWarnedRig=false
    if Farm.utilityBusy then return end
    if not (Farm.utilityAutoReload or Farm.utilityAutoRefill) then return end
    -- Recovery order: switch to working spare blades first. If no spare pairs
    -- remain, proactively restock from the station BEFORE the equipped pair breaks.
    if not blades.working and blades.sparePairs>0 and Farm.utilityAutoReload then
        tryBladeReload()
    elseif blades.sparePairs==0 and Farm.utilityAutoRefill then
        local waves=Farm.Waves
        if waves and type(waves.needsEmergencyRefills)=="function"
            and waves.needsEmergencyRefills() then
            return -- let the high-priority HQ stock purchase run first
        end
        tryStationRefill()
    end
end

local function startUtilityWatcher()
    if Farm.utilityConnection then return end
    Farm.utilityElapsed = 0
    Farm.utilityConnection = RunService.Heartbeat:Connect(function(dt)
        -- In Trost the watcher always samples the rig (without UI); switching
        -- off action toggles still disables all automatic reload/refill actions.
        if not (Farm.utilityAutoReload or Farm.utilityAutoRefill
            or game.PlaceId==14012874501) then return end
        Farm.utilityElapsed = Farm.utilityElapsed + dt
        if Farm.utilityElapsed >= UTILITY_TICK then
            Farm.utilityElapsed = Farm.utilityElapsed % UTILITY_TICK
            bladeUtilityTick()
        end
    end)
end

local function stopUtilityWatcherIfIdle()
    if Farm.utilityAutoReload or Farm.utilityAutoRefill
        or game.PlaceId==14012874501 then return end
    Farm.utilityToken = Farm.utilityToken + 1
    if Farm.utilityBusyOwner then
        Farm.utilityBusyOwner=nil
        Farm.utilityBusySince=0
        Farm.utilityBusy=false
    end
    if Farm.utilityConnection then
        Farm.utilityConnection:Disconnect()
        Farm.utilityConnection = nil
    end
end

