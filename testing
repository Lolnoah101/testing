local function IsNearRubble()

    local Root =
        GetRoot()


    if not Root
        or not CurrentRubbleCFrame
    then

        return false
    end


    return (
        Root.Position
        - CurrentRubbleCFrame.Position
    ).Magnitude
        <= RUBBLE_ATTACK_RANGE
end


local function IsCurrentRubbleAlive()

    if not CurrentRubbleInfo
        or not CurrentRubbleInfo.Border
    then

        return false
    end


    local Max =
        CurrentRubbleInfo.Border
            :GetAttribute(
                "RubbleMaxHealth"
            )


    if Max == nil then
        return false
    end


    local Health =
        CurrentRubbleInfo.Border
            :GetAttribute(
                "RubbleHealth"
            )


    if Health == nil then
        Health = Max
    end


    return Health > 0
end


--//============================================================
--// SERVER-AREA SAFETY GATE
--// Never follow a client-predicted area + 2 transition. The server's
-- runStore is authoritative, but a sudden jump means the progression may
-- already be out of sync; stop movement rather than amplifying the skip.
--//============================================================
GENV.__AZ_FARM_EXT.ValidateServerArea = function(AreaNumber)
    local Ext = GENV.__AZ_FARM_EXT
    local Area = tonumber(AreaNumber)
    if not Area then
        Ext.ProgressionFault = "Server area unavailable"
        return false
    end
    if not GetAreaPart(Area) then
        -- Other maps without area volumes keep their original logic.
        Ext.ProgressionFault = nil
        return true
    end
    local Last = Ext.ValidatedArea
    if Last == nil then
        if Area > 1 and not IsPlayerInsideArea(Area) then
            Ext.ProgressionFault = "Loaded outside reported area " .. tostring(Area)
            return false
        end
        Ext.ValidatedArea = Area
        Ext.ProgressionFault = nil
        return true
    end
    if Area > Last + 1 then
        Ext.ProgressionFault = "Skipped area " .. tostring(Last)
            .. " -> " .. tostring(Area) .. "; movement paused"
        return false
    end
    if Area == Last + 1 then
        local Previous = GetRubbleForArea(Last)
        if Previous and Previous.Health ~= nil and Previous.Health > 0 then
            Ext.ProgressionFault = "Next area appeared before rubble "
                .. tostring(Last) .. " was cleared"
            return false
        end
        -- Server advanced by exactly one area, so the crossing can finish.
        Ext.ValidatedArea = Area
        Ext.CrossingArea = nil
        Ext.CrossingStatus = "Server confirmed area " .. tostring(Area)
    elseif Area < Last then
        -- Handles a legitimate fresh stage/retry reverting the area number.
        Ext.ValidatedArea = Area
        Ext.CrossingArea = nil
        Ext.CrossingStatus = "Server reset to area " .. tostring(Area)
    end
    Ext.ProgressionFault = nil
    return true
end

--//============================================================
--// AREA REQUEST
--//============================================================

GENV.__AZ_FARM_EXT.HxhEntry = { Area = nil, Goal = nil, Attempts = 0,
    LastMoveAt = 0, FirstInsideAt = nil, Confirmed = nil, Status = "Idle",
    VerifiedGoal = nil, VerifiedArea = nil, WatchUntil = 0,
    WatchOutsideAt = nil, RearmCount = 0 }

local function GetRequestedEntryArea()
    local Area = tonumber(GetRunValue("area"))
    if not Area or Area <= 1 or not GetRunValue("startedAt") then
        return nil
    end
    local Ext = GENV.__AZ_FARM_EXT
    local Entry = Ext.HxhEntry
    if Entry.Area ~= Area then
        Entry.Area = Area
        Entry.Goal = nil
        Entry.VerifiedGoal = nil
        Entry.VerifiedArea = nil
        Entry.WatchUntil = 0
        Entry.WatchOutsideAt = nil
        Entry.RearmCount = 0
        Entry.Attempts = 0
        Entry.LastMoveAt = 0
        Entry.FirstInsideAt = nil
        Entry.Confirmed = nil
        Entry.Status = "Server requested area " .. tostring(Area)
    end
    if Entry.Confirmed == Area then
        -- POST-RUBBLE WATCHER: a successful landing can be rolled back by
        -- the server shortly afterward.  Do not permanently forget the
        -- destination.  Re-arm only the SAME server-verified marker goal,
        -- never a guessed area-center or a later area's marker.
        local Now = os.clock()
        if IsHxhMap()
            and Settings.AutoFarm
            and Entry.VerifiedArea == Area
            and Entry.VerifiedGoal
            and Now <= (Entry.WatchUntil or 0)
            and not Ext.IsHxhEntryDeep(Area, 3)
        then
            Entry.WatchOutsideAt = Entry.WatchOutsideAt or Now
            -- Give physics/replication time to settle.  The normal Enemy
            -- controller is already responsible if enemies are targetable.
            if Now - Entry.WatchOutsideAt >= 1.75
                and not GetFreshFarmTarget()
            then
                Entry.Confirmed = nil
                Entry.Goal = Entry.VerifiedGoal
                Entry.Attempts = 0
                Entry.LastMoveAt = 0
                Entry.MoveFinishAt = 0
                Entry.RestartAt = nil
                Entry.MarkerObservedAt = Now - 1
                Entry.FirstInsideAt = nil
                Entry.InsideAt = nil
                Entry.RearmCount = (Entry.RearmCount or 0) + 1
                Entry.Status = "Watcher: returned outside AREA "
                    .. tostring(Area) .. "; retrying verified marker"
                print("[Anime Zero][AREA Watcher] Reapproach AREA", Area,
                    "attempt", Entry.RearmCount,
                    "using locked game marker (", Settings.FarmMethod, ")")
                return Area
            end
            return nil
        end
        Entry.WatchOutsideAt = nil
        return nil
    end
    -- Hxh must actually enter the activation volume and receive the new
    -- wave signal. The generic IsPlayerInsideArea check includes 0.5 studs
    -- of padding and was incorrectly confirming the edge of the zone.
    local DeepInside = IsHxhMap()
        and Ext.IsHxhEntryDeep(Area, 3)
        or (not IsHxhMap() and IsPlayerInsideArea(Area))
    local WaveActive = (tonumber(GetRunValue("wave")) or 0) > 0
        or (tonumber(GetRunValue("remaining")) or 0) > 0
    if DeepInside and (not IsHxhMap() or WaveActive) then
        Entry.FirstInsideAt = Entry.FirstInsideAt or os.clock()
        if os.clock() - Entry.FirstInsideAt >= 0.50 then
            Entry.Confirmed = Area
            -- Keep the marker-derived 10-stud goal available if Roblox
            -- subsequently places the character back near the old rubble.
            if Entry.Goal and Entry.VerifiedArea == Area then
                Entry.VerifiedGoal = Entry.Goal
            end
            Entry.Goal = nil
            Entry.WatchOutsideAt = nil
            Entry.WatchUntil = os.clock() + 45
            Entry.Status = "Entered area " .. tostring(Area)
                .. "; watcher active for 45 seconds"
            Ext.PendingAreaEntry = nil
            Ext.AreaEntryLastConfirmed = Area
            return nil
        end
    else
        Entry.FirstInsideAt = nil
        if DeepInside and not WaveActive then
            Entry.Status = "Inside AREA " .. tostring(Area) .. "; waiting for enemies to spawn"
        end
    end
    return Area
end

local function HandleAreaEntry(TargetArea)
    -- Updated Hxh: SINGLE movement owner for an area change.
    -- 1. Server changes area 2..N after rubble drops.
    -- 2. Wait for the game's marker; freeze that exact landing point.
    -- 3. Give the area transition time to settle before moving.
    -- 4. Move with selected Farm Method, confirm physical arrival.
    -- No legacy wave/area-center movement is allowed during this handoff.
    ResetWaveRecovery()
    CurrentTargetId = nil
    CurrentTargetState = nil
    TargetAreaNumber = nil
    DesiredFarmCFrame = nil
    local Ext = GENV.__AZ_FARM_EXT
    local Entry = Ext.HxhEntry
    if Entry.Area ~= TargetArea then return end

    local Root = GetRoot()
    if not Root then return end
    local Now = os.clock()

    -- The marker's *edge* is not the trigger. Never cancel the movement
    -- merely because IsPlayerInsideArea returns true: it has a permissive
    -- border tolerance. Wait until safely inside the X/Z activation zone.
    local DeepInside = IsHxhMap()
        and Ext.IsHxhEntryDeep(TargetArea, 3)
        or (not IsHxhMap() and IsPlayerInsideArea(TargetArea))
    -- Being 3 studs inside a volume does not mean the character reached
    -- the actual 10-stud inset.  Finish the locked approach first unless
    -- the server has already activated the wave.
    local WaveActive = (tonumber(GetRunValue("wave")) or 0) > 0
        or (tonumber(GetRunValue("remaining")) or 0) > 0
    local NearVerifiedGoal = Entry.Goal
        and (Root.Position - Entry.Goal.Position).Magnitude <= 3.0
    if DeepInside and (WaveActive or NearVerifiedGoal) then
        Entry.InsideAt = Entry.InsideAt or Now
        if Ext.AreaMarkerTween then
            pcall(function() Ext.AreaMarkerTween:Cancel() end)
            Ext.AreaMarkerTween = nil
        end
        if (tonumber(GetRunValue("wave")) or 0) > 0
            or (tonumber(GetRunValue("remaining")) or 0) > 0
        then
            Entry.Status = "Inside AREA " .. tostring(TargetArea) .. "; wave started"
            SetFarmMode("Area Entry Confirming " .. tostring(TargetArea))
        else
            Entry.Status = "Inside AREA " .. tostring(TargetArea) .. "; waiting for wave"
            SetFarmMode("Waiting For AREA Wave " .. tostring(TargetArea))
        end
        return
    end
    Entry.InsideAt = nil

    local PreviousRubble = GetRubbleForArea(TargetArea - 1)
    if PreviousRubble and tonumber(PreviousRubble.Health)
        and PreviousRubble.Health > 0 then
        -- Do not attack or re-cross when the server has advanced but a
        -- client-side rubble-health value is stale. Wait for consistency.
        Entry.Status = "Waiting for previous rubble state to synchronize"
        SetFarmMode("Waiting For Rubble To Drop")
        return
    end

    -- A new server area doesn't imply the client is ready to move on the
    -- same frame. The game's marker/geometry replicates asynchronously.
    local ServerSettledAt = Ext.AreaEntryLastChange or Now
    if Now - ServerSettledAt < 0.90 then
        Entry.Status = "Server area settling before marker approach"
        SetFarmMode("Waiting For AREA Marker " .. tostring(TargetArea))
        return
    end

    local MarkerGoal, Reason = Ext.GetGameAreaMarkerGoal(TargetArea)
    if not MarkerGoal then
        -- The game hides NextAreaMarker once its trigger is crossed.  If
        -- position rollback happens afterward, reuse the marker location
        -- already verified for THIS server area (even if wave > 0).
        if Entry.Goal and Entry.VerifiedArea == TargetArea
            and tonumber(GetRunValue("area")) == TargetArea
        then
            MarkerGoal = Entry.Goal
            Reason = "Reusing locked verified AREA marker after rollback"
        else
            if not IsRubblePhysicallyOpen(TargetArea - 1) then
                Entry.Status = "Waiting for rubble to lower"
                SetFarmMode("Waiting For Rubble To Drop")
            else
                Entry.Status = Reason
                SetFarmMode("Waiting For AREA Marker " .. tostring(TargetArea))
            end
            return
        end
    end

    -- Lock the first verified marker position for the WHOLE attempt.
    -- The game's fallback marker is recomputed from character position;
    -- following every tiny change resets the tween and can bounce areas.
    if not Entry.Goal then
        Entry.Goal = MarkerGoal
        Entry.VerifiedGoal = MarkerGoal
        Entry.VerifiedArea = TargetArea
        Entry.Attempts = 0
        Entry.LastMoveAt = 0
        Entry.MoveFinishAt = 0
        Entry.MarkerObservedAt = Now
        Entry.Status = "AREA marker acquired; settling"
    end

    -- Confirm marker stability, rather than firing the first teleport as
    -- soon as a new server area value is observed.
    if Now - (Entry.MarkerObservedAt or Now) < 0.55 then
        Entry.Status = "AREA marker settling"
        SetFarmMode("Waiting For AREA Marker " .. tostring(TargetArea))
        return
    end

    if Settings.FarmMethod == "Legit" then
        local Arrived = GENV.__AZ_LEGIT_NAV.Go(Entry.Goal, 1.7,
            "AREA " .. tostring(TargetArea))
        Entry.Status = Arrived and "At AREA inset; waiting for wave"
            or "Walking to game AREA " .. tostring(TargetArea)
        SetFarmMode(Arrived and "Waiting For AREA Wave " .. tostring(TargetArea)
            or "Move To AREA Marker " .. tostring(TargetArea))
        return
    end

    if Now < (Entry.MoveFinishAt or 0) then
        Entry.Status = "Moving to verified AREA marker"
        SetFarmMode("Area Marker Waiting")
        return
    end

    -- After two failed landings, pause a few seconds and TRY the latest
    -- VERIFIED marker position again. Never rotate among area-center points.
    if Entry.Attempts >= 2 then
        Entry.RestartAt = Entry.RestartAt or (Now + 5)
        if Now < Entry.RestartAt then
            Entry.Status = "AREA marker retry cooldown"
            SetFarmMode("Area Marker Waiting")
            return
        end
        Entry.RestartAt = nil
        Entry.Attempts = 0
        Entry.Goal = MarkerGoal
        -- If the actual marker is still present, update our verified
        -- target; otherwise MarkerGoal is the same locked goal as before.
        Entry.VerifiedGoal = MarkerGoal
        Entry.VerifiedArea = TargetArea
    end

    local Distance = (Root.Position - Entry.Goal.Position).Magnitude
    if Distance <= 1.0 then
        -- The inset goal should be within the activation zone. If the client
        -- is very close but does not register inside, report the mismatch;
        -- do not start a per-frame correction or bounce between area centers.
        Entry.Status = "At AREA inset goal; waiting for zone registration"
        SetFarmMode("Area Marker Waiting")
        return
    end

    Entry.Attempts = Entry.Attempts + 1
    Entry.LastMoveAt = Now
    Entry.Status = "Moving to game AREA " .. tostring(TargetArea)
        .. " marker (" .. Settings.FarmMethod .. ")"
    if Settings.FarmMethod == "Tween" then
        if Ext.AreaMarkerTween then
            pcall(function() Ext.AreaMarkerTween:Cancel() end)
        end
        local Duration = math.max(Distance / math.max(Settings.TweenSpeed or 95, 1), 0.12)
        Entry.MoveFinishAt = Now + Duration + 1.0
        local Tween = game:GetService("TweenService"):Create(
            Root, TweenInfo.new(Duration, Enum.EasingStyle.Linear),
            {CFrame = Entry.Goal}
        )
        Ext.AreaMarkerTween = Tween
        Ext.SetTweenNoclipEnabled(true)
        Tween:Play()
    else
        Entry.MoveFinishAt = Now + 2.0
        Root.CFrame = Entry.Goal
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end
    SetFarmMode("Move To AREA Marker " .. tostring(TargetArea))
end

--//============================================================
--// RAID EXIT
--//
--// Raid segments expose RaidExitOpen instead of normal rubble. Move toward
--// the next area volume when possible; if the active map uses a runtime
--// elevator part instead, fall back to the nearest named elevator/exit.
--//============================================================

GENV.__AZ_FARM_EXT.HandleRaidExit = function()

    if not GENV.__AZ_IS_RAID_MODE()
        or workspace:GetAttribute("RaidExitOpen") ~= true
    then
        return false
    end


    local EnemyId =
        GetFreshFarmTarget()


    if EnemyId then
        return false
    end


    local Root =
        GetRoot()


    if not Root then
        return false
    end


    local Area =
        tonumber(
            GetRunValue("area")
        ) or 1


    local NextArea =
        Area + 1


    local Target =
        ComputeAreaEntryCFrame(
            NextArea,
            Settings.FarmMethod == "Tween"
                and TWEEN_AREA_ENTRY_DEPTH
                or TELEPORT_AREA_ENTRY_DEPTH
        )


    if not Target then

        local World =
            workspace:FindFirstChild("World")

        local BestPart = nil
        local BestDistance = math.huge


        if World then

            for _, Object in ipairs(
                World:GetDescendants()
            ) do

                if Object:IsA("BasePart") then

                    local Name =
                        string.lower(Object.Name)


                    if string.find(Name, "elevator", 1, true)
                        or string.find(Name, "exit", 1, true)
                    then

                        local Distance =
                            (
                                Root.Position
                                - Object.Position
                            ).Magnitude


                        if Distance < BestDistance then

                            BestDistance = Distance
                            BestPart = Object
                        end
                    end
                end
            end
        end


        if BestPart then

            Target =
                BestPart.CFrame
                + Vector3.new(0, 2.5, 0)
        end
    end


    if not Target then
        return false
    end


    CurrentTargetId = nil
    CurrentTargetState = nil
    CurrentRubbleInfo = nil
    CurrentRubbleCFrame = nil
    TargetAreaNumber = NextArea
    DesiredFarmCFrame = Target


    SetFarmMode(
        "Raid Exit -> Area "
        .. tostring(NextArea)
    )


    return true
end


--//============================================================
--// NORMAL FARM
--//============================================================

local function HandleNormalFarm()

    -- Do not clear the locked next-area goal every frame. Clearing it
    -- caused the character to forget where to go after a broken wall.
    TargetAreaNumber = nil

    local EnemyId,
        EnemyState =
        GetFreshFarmTarget()


    if EnemyId
        and EnemyState
    then

        ResetWaveRecovery()


        CurrentRubbleInfo =
            nil


        CurrentRubbleCFrame =
            nil


        DesiredFarmCFrame =
            GetEnemyFarmCFrame(
                EnemyId,
                EnemyState
            )


        GENV.__AZ_FARM_EXT.BelowStandbyTeleportToken = nil
        SetFarmMode(
            "Enemy"
        )


        return
    end


    local Area =
        GetRunValue(
            "area"
        )


    if not Area then

        DesiredFarmCFrame =
            nil


        return
    end


    local Info =
        GetRubbleForArea(
            Area
        )


    CurrentRubbleInfo =
        Info


    if Info
        and Info.Health
        and Info.Health > 0
    then

        ResetWaveRecovery()


        RecordRubbleHeight(
            Info
        )


        CurrentRubbleCFrame =
            GetRubbleFarmCFrame(
                Info
            )


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Rubble"
        )


        return
    end


    -- Hxh: never cross from a predicted zero-health state.
    -- The barrier must physically drop, then the SERVER advances the area,
    -- then the game's own NextAreaMarker becomes visible. HandleAreaEntry
    -- will take over only after all three events are confirmed.
    if Info and Info.Health ~= nil and Info.Health <= 0 then
        DesiredFarmCFrame = nil
        CurrentRubbleCFrame = nil
        if not IsRubblePhysicallyOpen(tonumber(Area)) then
            SetFarmMode("Waiting For Rubble To Drop")
        else
            SetFarmMode("Waiting For Server AREA Marker")
        end
        GENV.__AZ_FARM_EXT.CrossingStatus = "Waiting for game area marker"
        return
    end

    if HandleWaveRecovery(Area) then
        return
    end

    if Info and Info.Health ~= nil and Info.Health <= 0 then
        DesiredFarmCFrame = nil
        SetFarmMode("Waiting For Next Area")
        return
    end


    DesiredFarmCFrame =
        nil


    SetFarmMode(
        "Waiting"
    )
end


--//============================================================
--// AUTO FARM
--//============================================================

local function UpdateAutoFarm()

    if GENV.__AZ_IS_FLOOD_ESCAPE() then
        DesiredFarmCFrame = nil
        SetFarmMode("Flood Escape requires dedicated farm")
        return
    end

    if GENV.__AZ_IS_RAID_MODE() then
        DesiredFarmCFrame = nil
        SetFarmMode("Raid Uses Auto Raid Farm")
        return
    end


    if not IsAlive() then

        DesiredFarmCFrame =
            nil


        return
    end


    if Settings.AutoFarm then

        local ServerArea =
            GetRunValue(
                "area"
            )


        local ServerWave =
            GetRunValue(
                "wave"
            )


        -- Do not continue Hxh movement if the server reports a skipped area
        -- or the player reloaded outside the server's current area.
        if not GENV.__AZ_IS_TRIALS_MODE()
            and not GENV.__AZ_FARM_EXT.ValidateServerArea(ServerArea)
        then
            DesiredFarmCFrame = nil
            CurrentTargetId = nil
            CurrentTargetState = nil
            TargetAreaNumber = nil
            SetFarmMode("Area Sync Paused")
            GENV.__AZ_FARM_EXT.CrossingStatus = "Waiting for valid server state"
            return
        end

        if ServerArea ~= LastServerArea then

            LastServerArea =
                ServerArea

            -- Start an explicit transition on EVERY server area change.
            -- Do not discard the destination if wave 0 advances before
            -- the old area has been left.
            local Ext = GENV.__AZ_FARM_EXT
            local NewArea = tonumber(ServerArea)
            Ext.PendingAreaEntry = (NewArea and NewArea > 1) and NewArea or nil
            Ext.AreaEntryLastChange = os.clock()
            Ext.AreaEntryState = Ext.PendingAreaEntry
                and ("Server changed to area " .. tostring(NewArea))
                or "Area 1 / idle"

            CurrentTargetId =
                nil


            CurrentTargetState =
                nil


            ResetAreaEntryTarget()

            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        if ServerWave ~= LastObservedWave then

            LastObservedWave =
                ServerWave


            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        local RequestedArea =
            GetRequestedEntryArea()


        -- Never let a coin/drop pull us away while the server is asking
        -- us to enter the next area. Area transitions remain top priority.
        if RequestedArea then

            HandleAreaEntry(
                RequestedArea
            )


            return
        end


        if type(
            GENV.__AZ_FARM_EXT
                .HandleRaidExit
        ) == "function"
            and GENV.__AZ_FARM_EXT
                .HandleRaidExit()
        then

            return
        end
    end


    -- Optional short loot travel DURING farm, but never while a live enemy,
    -- rubble blocker, area trigger or opened Trials lift needs movement.
    -- Without this step, the earlier fix intentionally suppressed all loot
    -- travel as soon as Auto Farm was on.
    if Settings.AutoFarm
        and Settings.AutoPickupLoot
        and not GENV.__AZ_IS_FLOOR_EXIT_READY()
        and type(GENV.__AZ_FARM_EXT.GetLootTargetCFrame) == "function"
    then
        local TargetId = GetFreshFarmTarget()
        local Area = tonumber(GetRunValue("area")) or 1
        local Rubble = GetRubbleForArea(Area)
        local RubbleAlive = Rubble
            and type(Rubble.Health) == "number"
            and Rubble.Health > 0
        local StillFighting = (tonumber(GetRunValue("remaining")) or 0) > 0
        if not TargetId
            and GetLivingEnemyCount() == 0
            and not RubbleAlive
            and not IsCurrentRubbleAlive()
            and not StillFighting
        then
            local LootGoal = GENV.__AZ_FARM_EXT.GetLootTargetCFrame()
            if LootGoal then
                CurrentTargetId = nil
                CurrentTargetState = nil
                CurrentRubbleInfo = nil
                CurrentRubbleCFrame = nil
                TargetAreaNumber = nil
                DesiredFarmCFrame = LootGoal
                SetFarmMode("Loot")
                return
            end
        end
    end

    if Settings.AutoPickupLoot
        and not Settings.AutoFarm
        and not Settings.AutoRaidFarm
        and type(
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame
        ) == "function"
    then

        local LootCF =
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame()


        if LootCF then

            CurrentTargetId =
                nil

            CurrentTargetState =
                nil

            CurrentRubbleInfo =
                nil

            CurrentRubbleCFrame =
                nil

            TargetAreaNumber =
                nil

            DesiredFarmCFrame =
                LootCF


            SetFarmMode(
                "Loot"
            )


            return
        end
    end


    if not Settings.AutoFarm then

        DesiredFarmCFrame =
            nil


        SetFarmMode(
            "Idle"
        )


        return
    end


    HandleNormalFarm()

    if Settings.FarmPosition == "Below"
        and Settings.AutoFarm
        and DesiredFarmCFrame == nil
        and (CurrentFarmMode == "Waiting"
            or CurrentFarmMode == "Waiting For Next Area")
        and not GENV.__AZ_IS_FLOOR_EXIT_READY()
    then
        local Standby = GENV.__AZ_FARM_EXT.GetBelowSurfaceGoal(
            GetRoot(), nil, GetRunValue("area")
        )
        if Standby then
            DesiredFarmCFrame = Standby
            SetFarmMode("Below Standby")
        end
    end
end


--//============================================================
--// COMBAT LOOP
--//============================================================

local function RunCombatHeartbeat()

    if GENV.__AZ_IS_FLOOD_ESCAPE() then return end
    if not IsAlive() then
        return
    end


    if Settings.AutoM1 then

        if Settings.AutoFarm
            and not GENV.__AZ_IS_RAID_MODE()
        then

            if CurrentFarmMode == "Rubble"
                and IsCurrentRubbleAlive()
                and IsNearRubble()
            then

                local Sent = TryM1()
                if Sent then
                    GENV.__AZ_FARM_EXT.RubbleM1Requests =
                        (GENV.__AZ_FARM_EXT.RubbleM1Requests or 0) + 1
                    GENV.__AZ_FARM_EXT.RubbleLastM1At = os.clock()
                end


            elseif CurrentFarmMode == "Enemy"
                and GetNearbyEnemy()
            then

                TryM1()
            end


        elseif GetNearbyEnemy() then

            TryM1()
        end
    end


    if Settings.AutoSkills
        or Settings.AutoUltimate
    then

        if (
            not Settings.AutoFarm
            or CurrentFarmMode == "Enemy"
        )
            and GetNearbyEnemy()
        then

            RunAutoSkills()
        end
    end


    if type(GENV.__AZ_FARM_EXT.TickAutoBlock) == "function" then
        GENV.__AZ_FARM_EXT.TickAutoBlock(false)
    else
        RequestBlock(false)
    end

end


