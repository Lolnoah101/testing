local function FindLobbyMap(GamemodeId, MapName)
    -- The optional catalog may replicate after the essential queue modules.
    if not GamemodeSelectEnum and LobbyFolder then
        local EnumFolder = LobbyFolder:FindFirstChild("enums")
        local Module = EnumFolder and EnumFolder:FindFirstChild("gamemodeSelectEnum")
        if Module then
            local OK, Result = pcall(require, Module)
            if OK then GamemodeSelectEnum = Result end
        end
    end
    local Catalog = GamemodeSelectEnum
    if Catalog and Catalog.Gamemode then
        local Mode = Catalog.Gamemode[GamemodeId]
        if Mode and Mode.Maps then
            for _, Map in ipairs(Mode.Maps) do
                if Map.DisplayName == MapName or Map.Id == MapName then
                    return Map
                end
            end
        end
    end

    -- Fallback for place exports that omit gamemodeSelectEnum. IDs are
    -- present in current title/achievement/analytics/material-drop configs.
    local Fallback = {
        Story = {
            {Id = "hxh", DisplayName = "Hxh", Chapters = {1, 2, 3}},
        },
        Infinite = {
            {Id = "infinite", DisplayName = "ZZZ World"},
        },
        Raid = {
            {Id = "spiritedawayraid", DisplayName = "Spirit's Bathtub"},
            {Id = "sololevelingraid", DisplayName = "Shadow Gate"},
            {Id = "fateraid", DisplayName = "Evil Reflection"},
            {Id = "spiritedawayraid", DisplayName = "BathTub"},
            {Id = "sololevelingraid", DisplayName = "ShadowGate"},
        },
        Trials = {
            {Id = "trials", DisplayName = "Trials", Floors = true},
        },
        Escape = {
            {Id = "Flood", DisplayName = "Tidal High Rise"},
            {Id = "Flood", DisplayName = "Molten High Rise"}, -- former patch label
        },
    }
