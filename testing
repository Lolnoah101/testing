    end


    local function OwnsEvolutionCharacter(
        Data,
        Character
    )

        if not Data
            or not Data.UnlockedCharacters
        then

            return false
        end


        for SlotNumber = 1, 4 do

            local SlotData =
                Data.UnlockedCharacters[
                    "Slot"
                    .. tostring(
                        SlotNumber
                    )
                ]


            if SlotData
                and SlotData.Unlocked == true
                and tostring(
                    SlotData.Character or ""
                ) == Character
            then

                return true
            end
        end


        return false
    end


    RefreshEvolutionSlots = function(
        NotifyIfEmpty
    )

        local Data =
            GetExtraAccountData()


        if not Data
            or not Data.UnlockedCharacters
        then

            if NotifyIfEmpty then
                QueueNotification(
                    "Evolutions",
                    "Account slot data is not ready yet.",
                    4
                )
            end

            return false
        end


        local PreviousCharacter =
            ExtraSettings.EvolutionSelection

        local Options = {}

        local PreferredOption = nil


        table.clear(
            EvolutionOptionToCharacter
        )

        table.clear(
            EvolutionOptionToSlot
        )


        for SlotNumber = 1, 4 do

            local SlotName =
                "Slot"
                .. tostring(
                    SlotNumber
                )

            local SlotData =
                Data.UnlockedCharacters[
                    SlotName
                ]


            if SlotData
                and SlotData.Unlocked == true
            then

                local Character =
                    tostring(
                        SlotData.Character
                        or ""
                    )


                if Character ~= "" then

                    local DisplayName =
                        WeaponIdToName[
                            Character
                        ]
                        or Character

                    local IsEvolved =
                        Data.CharactersData
                        and Data.CharactersData[
                            Character
                        ]
                        and Data.CharactersData[
                            Character
                        ].IsUltimateUnlocked
                            == true

                    local Label =
                        "Slot "
                        .. tostring(
                            SlotNumber
                        )
                        .. " - "
                        .. DisplayName
                        .. (
                            IsEvolved
                            and " [Evolved]"
                            or ""
                        )


                    table.insert(
                        Options,
                        Label
                    )

                    EvolutionOptionToCharacter[
                        Label
                    ] = Character

                    EvolutionOptionToSlot[
                        Label
                    ] = SlotNumber


                    if Character
                        == PreviousCharacter
                        and not PreferredOption
                    then

                        PreferredOption = Label
                    end
                end
            end
        end


        pcall(function()
            EvolutionDropdown:Refresh(
                Options
            )
        end)


        if #Options == 0 then

            ExtraSettings.EvolutionSelection =
                nil


            if NotifyIfEmpty then
                QueueNotification(
                    "Evolutions",
                    "No unlocked slot characters were found.",
                    5
                )
            end


            return false
        end


        local Selection =
            PreferredOption
            or Options[1]


        ExtraSettings.EvolutionSelection =
            EvolutionOptionToCharacter[
                Selection
            ]


        pcall(function()
            EvolutionDropdown:Set(
                Selection,
                true
            )
        end)


        return true
    end


