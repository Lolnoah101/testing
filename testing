local function TryM1()

    if not Settings.AutoM1
        or not IsAlive()
    then

        return false
    end


    local Clock =
        os.clock()


    if Clock < NextM1RequestAt then
        return false
    end


    local Store =
        GetPlayerStore()


    if not Store then
        return false
    end


    if IsBlocking(Store)
        or HasActiveStun(Store)
    then

        return false
    end


    if PendingSkillRequestId
        or workspace:GetServerTimeNow()
            < SkillBusyUntil
    then

        return false
    end


    if not M1CooldownReady(
        Store
    )
    then

        return false
    end


    NextM1RequestAt =
        Clock
        + M1_REQUEST_GUARD


    return pcall(function()

        CharacterPackets
            .performM1
            :fire()
    end)
end


pcall(function()

    CharacterPackets
        .m1Performed
        :on(function(Data)

            if Data
                and Data.player
                    == LocalPlayer
            then

                NextM1RequestAt =
                    0
            end
        end)
end)


