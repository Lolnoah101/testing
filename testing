--// SKILL INPUT METHOD (shared by Story, Trials, Raid)
--// The old game's keybindController maps 1/2/3, G (Ultimate),
--// and 4 (optional standalone fifth skill). Real bindings may change.
--//============================================================
GENV.__AZ_SKILL_KEY_INPUT = {
    LastKey = "none",
    LastBackend = "none",
    LastPressAt = 0,
    LastError = "none",
    Presses = 0,
    Failed = 0,
    LastBySlot = {},
    Warned = false,
}

GENV.__AZ_SEND_SKILL_KEY = function(Slot)
    local State = GENV.__AZ_SKILL_KEY_INPUT
    local Keys = {
        [1] = { Enum.KeyCode.One, 0x31, "1" },
        [2] = { Enum.KeyCode.Two, 0x32, "2" },
        [3] = { Enum.KeyCode.Three, 0x33, "3" },
        [4] = { Enum.KeyCode.G,   0x47, "G" },
        [5] = { Enum.KeyCode.Four, 0x34, "4" },
    }
    local Entry = Keys[tonumber(Slot)]
    if not Entry or Settings.SkillMethod ~= "Use Skill Keys" then
        return false
    end

    -- Key input acts on the focused Roblox window, not an open text field.
    local UIS = game:GetService("UserInputService")
    if UIS:GetFocusedTextBox() then return false end

    local Now = os.clock()
    local Last = State.LastBySlot[Slot] or 0
    local Interval = Slot == 4 and 0.36 or 0.19
    if Now - Last < Interval then return false end

    local Pressed = false
    local Backend, ErrorValue = "none", nil
    local OK, Manager = pcall(function()
        return game:GetService("VirtualInputManager")
    end)
    if OK and Manager then
        local Success, Err = pcall(function()
            Manager:SendKeyEvent(true, Entry[1], false, game)
        end)
        if Success then
            Pressed = true
            Backend = "VirtualInputManager"
            task.delay(0.055, function()
                pcall(function()
                    Manager:SendKeyEvent(false, Entry[1], false, game)
                end)
            end)
        else
            ErrorValue = tostring(Err)
        end
    end

    -- Some executors expose keypress/keyrelease but restrict VIM.
    if not Pressed and type(keypress) == "function"
        and type(keyrelease) == "function" then
        local Success, Err = pcall(keypress, Entry[2])
        if Success then
            Pressed = true
            Backend = "keypress"
            task.delay(0.055, function()
                pcall(keyrelease, Entry[2])
            end)
        else
            ErrorValue = tostring(Err)
        end
    end

    State.LastKey = Entry[3]
    State.LastPressAt = Now
    State.LastBackend = Backend
    State.LastError = ErrorValue or "none"
    if Pressed then
        State.LastBySlot[Slot] = Now
        State.Presses += 1
    else
        State.Failed += 1
        if not State.Warned then
            State.Warned = true
            warn("[Anime Zero][Skill Keys] No usable key input backend. Select Use Skills Remote or check executor input support.", State.LastError)
        end
    end
    return Pressed
end

