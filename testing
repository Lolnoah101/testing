-- HollowMoonHub | Beyond Nen | v76 | Early-threat and survival dodge improvements
-- v71 Nen priority, v72 chest workflow and v73 Auto Learn Owned Recipes retained
if game.PlaceId == 6016716328 then
    -- HollowMoonHub | Beyond Nen | Main Menu + Auto Spins | v49
    -- Menu place: 6016716328. Gameplay automation is deliberately not loaded here.
    -- Uses the menu's PlayerService:spin(category, selectedSlot), ServersService:play,
    -- ServersService:join_random_server, and replicated
    -- CharacterData values; stops only after a selected result is observed.
    local function launchBeyondNenMenu()
        if not game:IsLoaded() then game.Loaded:Wait() end

        local Players = game:GetService("Players")
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local Player = Players.LocalPlayer
        if not Player then return end
        local Environment = (getgenv and getgenv()) or _G
        if Environment.HollowMoonBeyondNenMenu and Environment.HollowMoonBeyondNenMenu.Unload then
            pcall(function() Environment.HollowMoonBeyondNenMenu:Unload() end)
        end

        local Menu = {
            Running = true,
            AutoPlay = false,
            QuickJoin = false,
            JoinBusy = false,
            JoinComplete = false,
            JoinToken = 0,
            JoinNextAt = 0,
            JoinStatus = "Off",
            JoinAttempts = 0,
            WatcherErrorAt = 0,
            SpinDataRetryAt = 0,
            Connections = {},
            Active = { Race = false, Lineage = false, Affinity = false, Ability = false },
            Selected = { Race = {}, Lineage = {}, Affinity = {}, Ability = {} },
            SlotGuards = {},
            InternalStop = {},
            Status = { Race = "Off", Lineage = "Off", Affinity = "Off", Ability = "Off" },
            Counts = { Race = 0, Lineage = 0, Affinity = 0, Ability = 0 },
            Order = { "Race", "Lineage", "Affinity", "Ability" },
            NextSpin = 0,
            NextCategoryIndex = 1,
            Busy = false,
            LastError = "None",
            Handles = {},
            LastStatus = {},
            Window = nil,
            Service = nil,
            Knit = nil,
            SpinOdds = nil,
            SpinWallet = nil,
            Policy = nil,
        }
        Environment.HollowMoonBeyondNenMenu = Menu

        function Menu:Unload()
            self.Running = false
            for key in pairs(self.Active) do self.Active[key] = false end
            self.Busy = false
            self.AutoPlay = false
            self.QuickJoin = false
            for _, connection in ipairs(self.Connections) do
                pcall(function() connection:Disconnect() end)
            end
            table.clear(self.Connections)
            if self.Library then
                pcall(function() self.Library:Destroy() end)
            elseif self.Window then
                pcall(function() self.Window:Destroy() end)
            end
            if Environment.HollowMoonBeyondNenMenu == self then
                Environment.HollowMoonBeyondNenMenu = nil
            end
        end

        local function selectedSlot()
            local data = Player:FindFirstChild("Data")
            local shared = data and data:FindFirstChild("SharedData")
            -- Data.SelectedSlot is the source read by the native TitleMenu.
            return (data and tonumber(data:GetAttribute("SelectedSlot")))
                or (shared and tonumber(shared:GetAttribute("SelectedSlot")))
                or tonumber(Player:GetAttribute("SelectedSlot")) or 1
        end

        local function slotData(slot)
            local data = Player:FindFirstChild("Data")
            local saveFolder = data and data:FindFirstChild("SavesSlot")
            local config = saveFolder and saveFolder:FindFirstChild(tostring(slot or selectedSlot()))
            return config and config:FindFirstChild("CharacterData")
        end

        local function readTrait(category, slot)
            local characterData = slotData(slot)
            if not characterData then return nil end
            if category == "Race" then
                local genetics = characterData:FindFirstChild("Genetics")
                return genetics and genetics:GetAttribute("Race") or nil
            elseif category == "Ability" then
                return characterData:GetAttribute("NenAbility")
            elseif category == "Affinity" then
                return characterData:GetAttribute("NenAffinity")
            else
                return characterData:GetAttribute("Lineage")
            end
        end

        local function readable(category)
            local trait = readTrait(category, selectedSlot())
            if type(trait) ~= "string" or trait == "" then return "--" end
            return trait
        end

        local function spinBalances()
            local data = Player:FindFirstChild("Data")
            local shared = data and data:FindFirstChild("SharedData")
            if not shared then return nil, nil, nil end
            local earned = math.max(0, math.floor(tonumber(shared:GetAttribute("Spins")) or 0))
            local paid = math.max(0, math.floor(tonumber(shared:GetAttribute("PaidSpins")) or 0))
            local allowed = earned + paid
            if Menu.Policy and Menu.Policy.IsReady and Menu.Policy.IsRestricted then
                local okReady, ready = pcall(Menu.Policy.IsReady)
                if not okReady or ready ~= true then return nil, earned, paid end
                local okRestricted, restricted = pcall(Menu.Policy.IsRestricted)
                if not okRestricted then return nil, earned, paid end
                if restricted == true then allowed = earned end
            end
            return allowed, earned, paid
        end

        local function readTargetSet(value)
            local result = {}
            if type(value) == "string" then
                if value ~= "" then result[value] = true end
            elseif type(value) == "table" then
                for k, v in pairs(value) do
                    if type(k) == "number" and type(v) == "string" and v ~= "" then
                        result[v] = true
                    elseif type(k) == "string" and v == true then
                        result[k] = true
                    end
                end
            end
            return result
        end

        local function selectedNames(targets)
            local names = {}
            for name, enabled in pairs(targets) do if enabled then table.insert(names, name) end end
            table.sort(names)
            if #names == 0 then return "None" end
            return table.concat(names, ", ")
        end

        local function enableToggle(category, enabled)
            if Menu.InternalStop[category] then return end
            Menu.Active[category] = enabled == true
            if enabled then
                Menu.SlotGuards[category] = selectedSlot()
                Menu.Status[category] = "Checking selected character"
            else
                Menu.SlotGuards[category] = nil
                if Menu.Status[category]:sub(1, 7) ~= "Landed:" then Menu.Status[category] = "Off" end
            end
        end

        local function stopToggle(category, reason)
            Menu.Active[category] = false
            Menu.SlotGuards[category] = nil
            Menu.Status[category] = reason
            Menu.InternalStop[category] = true
            if Menu.Window then
                pcall(function() Menu.Window:Set("HMM47Auto" .. category, false) end)
            end
            local toggle = Menu.Handles[category .. "Toggle"]
            if toggle and type(toggle.Set) == "function" then
                pcall(function() toggle:Set(false) end)
            end
            Menu.InternalStop[category] = nil
        end

        local function loadSpinData()
            local shared = ReplicatedStorage:FindFirstChild("Shared")
            local dataFolder = shared and shared:FindFirstChild("Data")
            local oddsModule = dataFolder and dataFolder:FindFirstChild("SpinOdds")
            if oddsModule then
                pcall(function() Menu.SpinOdds = require(oddsModule) end)
            end
            local walletModule = shared and shared:FindFirstChild("SpinWallet")
            if walletModule then pcall(function() Menu.SpinWallet = require(walletModule) end) end
            local policyModule = shared and shared:FindFirstChild("PaidRandomPolicy")
            if policyModule then pcall(function() Menu.Policy = require(policyModule) end) end
        end
        loadSpinData()

        -- Source-capture fallbacks if menu data has not replicated yet. Live SpinOdds
        -- always overrides these options when present.
        local defaultOptions = {
            Race = { "Celestial", "Cyborg", "Cat", "Rabbit", "Human" },
            Lineage = {
                "Zoldyck", "Freecss", "Kurta", "Netero", "Morrow", "Lucilfer",
                "Krueger", "Hill", "Hazama", "Koshi", "Murasalo", "Mackernasey",
                "Nostrade", "Bine", "Magcub", "Tocino", "Hackett", "Kwalski", "Ndongo", "Clow",
            },
            Affinity = { "Specialist", "Transmutation", "Conjuration", "Enhancement", "Manipulation", "Emission" },
            Ability = {
                "Aura Corruption", "Boost", "Godspeed", "Rising Sun", "Earth Sludge",
                "Crazy Slots", "Tool Box", "Arrow", "Fan Beam", "Jajanken", "Big Bang",
                "Ripper Cyclotron", "Super Attack", "Paper Manipulation", "Enchanting Music",
            },
        }

        local function choices(category)
            local odds = Menu.SpinOdds
            if not odds then return defaultOptions[category] end
            local picked, seen = {}, {}
            local function add(item)
                if type(item) == "string" and item ~= "" and not seen[item] then
                    seen[item] = true
                    table.insert(picked, item)
                end
            end
            if category == "Ability" then
                if type(odds.Abilities) == "table" then
                    for _, items in pairs(odds.Abilities) do
                        if type(items) == "table" then
                            for _, item in ipairs(items) do add(item.Name) end
                        end
                    end
                end
            elseif type(odds.getItems) == "function" then
                local ok, list = pcall(function() return odds.getItems(category) end)
                if ok and type(list) == "table" then
                    for _, item in ipairs(list) do add(item.Name) end
                end
            end
            if #picked == 0 then return defaultOptions[category] end
            table.sort(picked)
            return picked
        end

        local function abilityAvailable(targets, affinity)
            if type(affinity) ~= "string" or affinity == "" or affinity == "None" then
                return false, "Spin Nen Affinity first"
            end
            local odds = Menu.SpinOdds
            if not odds or type(odds.getItems) ~= "function" then
                return false, "Waiting for available abilities"
            end
            local ok, items = pcall(function() return odds.getItems("Affinity_Abilities", affinity) end)
            if not ok or type(items) ~= "table" then return false, "Affinity has no available abilities" end
            for _, item in ipairs(items) do
                if targets[item.Name] then return true, "" end
            end
            return false, "Selected ability needs another affinity (current: " .. affinity .. ")"
        end

        local function acquireSpinService()
            if Menu.Service then return true end
            local packages = ReplicatedStorage:FindFirstChild("Packages")
            local knitModule = packages and packages:FindFirstChild("knit")
            if not knitModule then return false end
            if not Menu.Knit then
                local ok, knit = pcall(require, knitModule)
                if not ok or not knit then return false end
                Menu.Knit = knit
            end
            if Menu.Knit.Started == false then return false end
            local ok, service = pcall(function() return Menu.Knit.GetService("PlayerService") end)
            if ok and service and type(service.spin) == "function" then
                Menu.Service = service
                return true
            end
            return false
        end

        -- Use the same services as the game's TitleMenu / ServersController.
        -- Auto Play runs ServersService:play; Quick Join calls join_random_server.
        -- Do not use direct TeleportService calls or invent a gameplay place ID.
        local function acquireServersService()
            if not Menu.Knit then
                local packages = ReplicatedStorage:FindFirstChild("Packages")
                local module = packages and packages:FindFirstChild("knit")
                if not module then return nil, "Waiting for Knit" end
                local ok, result = pcall(require, module)
                if not ok then return nil, "Waiting for Knit" end
                Menu.Knit = result
            end
            if Menu.Knit.Started == false then return nil, "Waiting for services" end
            local ok, service = pcall(function()
                return Menu.Knit.GetService("ServersService")
            end)
            if not ok or not service then return nil, "Waiting for ServersService" end
            return service
        end

        local function activeSpins()
            if Menu.Busy then return true end
            for _, category in ipairs(Menu.Order) do
                if Menu.Active[category] then return true end
            end
            return false
        end

        local function desiredJoinMode()
            if Menu.QuickJoin then return "Quick" end
            if Menu.AutoPlay then return "Play" end
            return nil
        end

        local function requestJoin(mode, slot)
            local joinToken = Menu.JoinToken
            Menu.JoinBusy = true
            Menu.JoinAttempts += 1
            Menu.JoinStatus = mode == "Quick" and "Requesting Quick Join" or "Requesting Play"
            local service, reason = acquireServersService()
            if not service then
                Menu.JoinStatus = reason
                Menu.JoinNextAt = os.clock() + 2
                Menu.JoinBusy = false
                return
            end
            local ok, transport, accepted, message
            if mode == "Quick" then
                ok, transport, accepted, message = pcall(function()
                    return service:join_random_server(workspace:GetAttribute("server_region_code")):await()
                end)
            else
                ok, transport, accepted, message = pcall(function()
                    return service:play():await()
                end)
            end
            if not Menu.Running then return end
            Menu.JoinBusy = false
            if Menu.JoinToken ~= joinToken or desiredJoinMode() ~= mode then return end
            if not ok or transport ~= true then
                Menu.JoinStatus = "Join request failed: " .. tostring((not ok and transport) or message or "Network error"):sub(1, 100)
                Menu.JoinNextAt = os.clock() + 18
                return
            end
            if mode == "Quick" then
                if accepted == true then
                    Menu.JoinStatus = "Joining server..."
                    Menu.JoinComplete = true
                else
                    Menu.JoinStatus = "Quick Join: " .. tostring(message or "No server currently available"):sub(1, 100)
                    Menu.JoinNextAt = os.clock() + 18
                end
                return
            end
            if accepted == true then
                -- The native Play button opens the server list for the user here.
                local controllerOk, controller = pcall(function()
                    return Menu.Knit.GetController("ServersController")
                end)
                if controllerOk and controller and type(controller.Open) == "function" then
                    local opened, openError = pcall(function() controller:Open() end)
                    if not opened then
                        Menu.JoinStatus = "Play: could not open servers: " .. tostring(openError):sub(1, 80)
                        Menu.JoinNextAt = os.clock() + 15
                        return
                    end
                end
                Menu.JoinStatus = "Server list opened — choose a server, or turn on Quick Join"
                Menu.JoinComplete = true
            elseif message ~= nil then
                Menu.JoinStatus = "Play: " .. tostring(message):sub(1, 100)
                Menu.JoinNextAt = os.clock() + 18
            else
                Menu.JoinStatus = "Play accepted — awaiting server transition"
                Menu.JoinComplete = true
            end
        end

        local function setJoinToggle(key, on)
            Menu.JoinToken += 1
            Menu[key] = on == true
            Menu.JoinComplete = false
            Menu.JoinNextAt = 0
            Menu.JoinStatus = desiredJoinMode() and "Checking character slot" or "Off"
        end

        local function watcherSet(handle, content, key)
            if not handle or Menu.LastStatus[key] == content then return end
            local ok, err = pcall(function() handle:Set(content) end)
            if ok then
                Menu.LastStatus[key] = content
            elseif os.clock() >= Menu.WatcherErrorAt then
                Menu.WatcherErrorAt = os.clock() + 12
                Menu.LastError = "Status display update failed: " .. tostring(err)
                warn("[HollowMoon Menu] " .. Menu.LastError)
            end
        end

        local function slotSummary()
            local slot = selectedSlot()
            local data = Player:FindFirstChild("Data")
            if not data then return "Loading character data..." end
            if not slotData(slot) then return "Slot " .. tostring(slot) .. " | Select a created character" end
            return string.format("Slot %d | %s / %s / %s / %s", slot,
                readable("Race"), readable("Lineage"), readable("Affinity"), readable("Ability"))
        end

        local function walletSummary()
            local allowed, earned, paid = spinBalances()
            if allowed == nil then return "Spin wallet not ready" end
            return string.format("Spins %d usable | %d earned | %d paid", allowed, earned, paid)
        end

        local function runSpin(category, slot)
            Menu.Busy = true
            local before = readTrait(category, slot)
            local beforeAllowed, beforeFree, beforePaid = spinBalances()
            Menu.Status[category] = "Spinning..."
            local result = { done = false, success = false, payload = nil }
            local serviceName = category == "Ability" and "Affinity_Abilities" or category
            local ok, reply = pcall(function() return Menu.Service:spin(serviceName, slot) end)
            if not ok then
                result.done = true
                result.payload = tostring(reply)
            elseif type(reply) == "table" and type(reply.andThen) == "function" then
                local attached, err = pcall(function()
                    reply:andThen(function(value)
                        if not result.done then
                            result.done = true
                            result.success = value ~= false
                            result.payload = value
                        end
                    end, function(reason)
                        if not result.done then
                            result.done = true
                            result.payload = tostring(reason)
                        end
                    end)
                end)
                if not attached then result.done = true; result.payload = tostring(err) end
            else
                result.done = true
                result.success = reply ~= false
                result.payload = reply
            end

            local deadline = os.clock() + 9
            while Menu.Running and not result.done and os.clock() < deadline do task.wait(.06) end
            if not Menu.Running then Menu.Busy = false; return end
            if not result.done or not result.success then
                Menu.LastError = tostring(result.payload or "Spin request timed out")
                Menu.Status[category] = "Spin not confirmed: " .. Menu.LastError:sub(1, 90)
                Menu.NextSpin = os.clock() + 3
                Menu.Busy = false
                return
            end

            -- A roll can return the same trait. A decreased server-replicated spin
            -- balance verifies it was consumed even when the trait string is unchanged.
            local confirmed, after = false, before
            local verifyUntil = os.clock() + 5
            repeat
                if not Menu.Running then break end
                after = readTrait(category, slot)
                local _, earned, paid = spinBalances()
                local spent = beforeFree ~= nil and earned ~= nil and
                    (earned + paid) < (beforeFree + beforePaid)
                if after ~= nil and before ~= after then confirmed = true; break end
                if spent then confirmed = true; break end
                task.wait(.08)
            until os.clock() >= verifyUntil
            if confirmed then
                Menu.Counts[category] += 1
                Menu.Status[category] = "Rolled: " .. tostring(after or "waiting for result")
                local target = Menu.Selected[category]
                if after ~= nil and target[after] then
                    stopToggle(category, "Landed: " .. after)
                end
                Menu.NextSpin = os.clock() + 0.85
            else
                Menu.Status[category] = "Result not replicated; rechecking before next spin"
                Menu.NextSpin = os.clock() + 4
            end
            Menu.Busy = false
        end

        local okLibrary, library = pcall(function()
            local fn, err = loadstring(game:HttpGet("https://sirius.menu/gen2"))
            if not fn then error(err or "Rayfield could not load") end
            return fn()
        end)
        if not okLibrary or not library then
            warn("[HollowMoonHub Menu] Rayfield Gen2 failed: " .. tostring(library))
            Menu:Unload()
            return
        end

        local window = library:CreateWindow({
            name = "HollowMoonHub",
            subtitle = "Beyond Nen | Main Menu v49",
            sidebarLayout = true,
            configuration = { fileName = "HollowMoonBeyondNenMenu_v49", autoSave = true, autoLoad = false },
        })
        Menu.Window = window
        Menu.Library = library
        local main = window:CreateTab({ name = "Main" })
        main:CreateSection({ name = "Join Gameplay" })
        Menu.Handles.JoinWatcher = main:CreateText({
            name = "Join Status", text = "Select a character, then enable a join method"
        })
        local joinControls = main:CreateGroup()
        joinControls:CreateToggle({
            name = "Auto Play", flag = "HMM49AutoPlay", value = false,
            callback = function(on) setJoinToggle("AutoPlay", on) end,
        })
        joinControls:CreateToggle({
            name = "Quick Join Server", flag = "HMM49QuickJoin", value = false,
            callback = function(on) setJoinToggle("QuickJoin", on) end,
        })

        local spins = window:CreateTab({ name = "Auto Spins" })
        Menu.Handles.SlotWatcher = spins:CreateText({
            name = "Character", text = slotSummary()
        })
        Menu.Handles.WalletWatcher = spins:CreateText({
            name = "Spins", text = walletSummary()
        })
        spins:CreateSection({ name = "Spin Targets" })
        local columns = spins:CreateGroup()
        local left = columns:CreateGroup({ direction = "column" })
        local right = columns:CreateGroup({ direction = "column" })

        local function createCategory(parent, category)
            parent:CreateDropdown({
                name="Selected " .. category, flag="HMM47Targets" .. category,
                options=choices(category), multiSelect=true, value={},
                placeholder="Choose results",
                callback=function(value)
                    Menu.Selected[category] = readTargetSet(value)
                end,
            })
            Menu.Handles[category .. "Toggle"] = parent:CreateToggle({
                name="Auto Spin " .. category,
                flag="HMM47Auto" .. category, value=false,
                callback=function(value) enableToggle(category, value) end,
            })
            Menu.Handles[category] = parent:CreateText({text="Off"})
        end
        createCategory(left, "Race")
        createCategory(right, "Lineage")
        createCategory(left, "Affinity")
        createCategory(right, "Ability")
        local settings = window:CreateTab({ name = "Settings" })
        settings:CreateSection({ name = "Script" })
        settings:CreateButton({name="Unload", callback=function() Menu:Unload() end})

        task.spawn(function()
            while Menu.Running do
                local ok, reason = pcall(function()
                    local now = os.clock()
                    if now >= Menu.SpinDataRetryAt and (not Menu.SpinOdds or not Menu.Policy) then
                        Menu.SpinDataRetryAt = now + 4
                        loadSpinData()
                    end
                    watcherSet(Menu.Handles.SlotWatcher, slotSummary(), "Slot")
                    watcherSet(Menu.Handles.WalletWatcher, walletSummary(), "Wallet")
                    local mode = desiredJoinMode()
                    local joinText = (mode and (mode .. " | " .. Menu.JoinStatus) or "Off")
                    watcherSet(Menu.Handles.JoinWatcher, joinText, "Join")
                    for _, category in ipairs(Menu.Order) do
                        local message = string.format("Current: %s | %s | Rolls: %d",
                            readable(category), Menu.Status[category], Menu.Counts[category])
                        watcherSet(Menu.Handles[category], message, category)
                    end
                end)
                if not ok and os.clock() >= Menu.WatcherErrorAt then
                    Menu.WatcherErrorAt = os.clock() + 10
                    Menu.LastError = "Watcher: " .. tostring(reason)
                    warn("[HollowMoon Menu] " .. Menu.LastError)
                end
                task.wait(0.5)
            end
        end)

        -- A chosen character is required. Active spin jobs take priority over travel,
        -- so auto-joining cannot interrupt stop-on-selected-result processing.
        task.spawn(function()
            while Menu.Running do
                task.wait(.35)
                local mode = desiredJoinMode()
                if not mode or Menu.JoinBusy or Menu.JoinComplete or os.clock() < Menu.JoinNextAt then continue end
                local slot = selectedSlot()
                if not slotData(slot) then
                    Menu.JoinStatus = "Choose a created character slot first"
                    continue
                end
                if activeSpins() then
                    Menu.JoinStatus = "Waiting for active Auto Spins"
                    continue
                end
                -- Native Play silently rolls blank Nen traits. The automation will
                -- not consume spins as a side-effect of joining: finish them first.
                local affinity = readTrait("Affinity", slot)
                local ability = readTrait("Ability", slot)
                if not affinity or not ability then
                    Menu.JoinStatus = "Waiting for Nen trait data"
                    continue
                end
                if affinity == "None" or ability == "None" then
                    Menu.JoinStatus = "Set Nen Affinity and Ability before joining"
                    continue
                end
                Menu.JoinNextAt = os.clock() + 5
                task.spawn(requestJoin, mode, slot)
            end
        end)

        table.insert(Menu.Connections, Player.OnTeleport:Connect(function(state)
            if state == Enum.TeleportState.Started then
                Menu.JoinStatus = "Teleporting to gameplay"
                Menu.JoinComplete = true
            end
        end))

        -- Only one server spin at a time, to prevent overlapping ability/affinity
        -- requests and to ensure every stop condition is checked before another roll.
        task.spawn(function()
            while Menu.Running do
                task.wait(.12)
                if Menu.Busy or Menu.JoinBusy or Menu.JoinComplete or os.clock() < Menu.NextSpin then continue end
                for offset = 0, #Menu.Order - 1 do
                    local index = ((Menu.NextCategoryIndex - 1 + offset) % #Menu.Order) + 1
                    local category = Menu.Order[index]
                    if Menu.Active[category] then
                        local slot = selectedSlot()
                        if Menu.SlotGuards[category] ~= slot then
                            stopToggle(category, "Stopped: selected character slot changed")
                            continue
                        end
                        local targets = Menu.Selected[category]
                        if not next(targets) then
                            Menu.Status[category] = "Choose a target first"
                            continue
                        end
                        if not slotData(slot) then
                            Menu.Status[category] = "Waiting for a created character in slot " .. tostring(slot)
                            continue
                        end
                        local current = readTrait(category, slot)
                        if type(current) ~= "string" then
                            Menu.Status[category] = "Waiting for current trait data"
                            continue
                        end
                        if targets[current] then
                            stopToggle(category, "Landed: " .. current)
                            continue
                        end
                        if category == "Ability" then
                            local canRoll, reason = abilityAvailable(targets, readTrait("Affinity", slot))
                            if not canRoll then Menu.Status[category] = reason; continue end
                        end
                        local usable = spinBalances()
                        if usable == nil then
                            Menu.Status[category] = "Waiting for spin balance"
                            continue
                        end
                        if usable <= 0 then
                            Menu.Status[category] = "Out of usable spins"
                            continue
                        end
                        if not acquireSpinService() then
                            Menu.Status[category] = "Waiting for PlayerService"
                            continue
                        end
                        local requestedCategory, requestedSlot = category, slot
                        Menu.NextSpin = os.clock() + 1
                        Menu.NextCategoryIndex = (index % #Menu.Order) + 1
                        task.spawn(function() runSpin(requestedCategory, requestedSlot) end)
                        break
                    end
                end
            end
        end)
    end

    launchBeyondNenMenu()
    return
end

