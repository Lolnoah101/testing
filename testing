local function IsNearRubble()

    local Root =
        GetRoot()


    if not Root
        or not CurrentRubbleCFrame
    then

        return false
    end


    return (
        Root.Position
        - CurrentRubbleCFrame.Position
    ).Magnitude
        <= RUBBLE_ATTACK_RANGE
end


local function IsCurrentRubbleAlive()

    if not CurrentRubbleInfo
        or not CurrentRubbleInfo.Border
    then

        return false
    end


    local Max =
        CurrentRubbleInfo.Border
            :GetAttribute(
                "RubbleMaxHealth"
            )


    if Max == nil then
        return false
    end


    local Health =
        CurrentRubbleInfo.Border
            :GetAttribute(
                "RubbleHealth"
            )


    if Health == nil then
        Health = Max
    end


    return Health > 0
end


