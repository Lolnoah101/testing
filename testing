local function getInventoryData()
    if not nativeController then return nil, "Game client controller unavailable" end
    if not nativeController.ClientLoaded then return nil, "Waiting for game to finish loading" end
    local data = nativeController.Data
    if type(data) ~= "table" then return nil, "Player inventory data not loaded" end
    if type(data.Shadows) ~= "table" then return nil, "Unit inventory is unavailable" end
    if type(data.Shadows_Equipped) ~= "table" then return nil, "Equipped unit data is unavailable" end
    local defs = nativeController.Shared and nativeController.Shared.Shadows
    if type(defs) ~= "table" and type(unitDefinitions) ~= "table" then
        return nil, "Unit rarity definitions unavailable"
    end
    return data
end

local function isProtectedUnit(data, id, owned, definition)
    if owned.Locked or owned.Shiny or (definition and definition.VIP) then
        return true
    end
    if data.Shadows_Equipped[id] then return true end
    local incubator = data.Incubator
    if type(incubator) == "table" and incubator.Shadow == id then
        return true
    end
    return false
end

local function sortedIds(ids)
    table.sort(ids, function(a, b) return tostring(a) < tostring(b) end)
    return ids
end

local function joinedIds(ids)
    local parts = {}
    for _, id in ipairs(ids) do parts[#parts + 1] = tostring(id) end
    return table.concat(parts, ",")
end

local function unitInventorySignature(data)
    local ids = {}
    for id in pairs(data.Shadows) do ids[#ids + 1] = id end
    return joinedIds(sortedIds(ids))
end

-- A second signature observes changes that do not alter unit IDs (locking,
-- equip changes or levels). Only the ID signature confirms material deletion.
function state.UnitEligibilitySignature(data)
    local parts = {}
    for id, owned in pairs(data.Shadows) do
        parts[#parts + 1] = table.concat({
            tostring(id), tostring(owned.Level), tostring(owned.Locked),
            tostring(owned.Shiny), tostring(data.Shadows_Equipped[id] ~= nil)
        }, ":")
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

