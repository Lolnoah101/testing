    s.cameraMouseDrag = true
    s.cameraPriorMouseBehavior = UserInputService.MouseBehavior
    s.cameraPriorMouseIcon = UserInputService.MouseIconEnabled
    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    UserInputService.MouseIconEnabled = false
end

local function renderUnlockedCamera(dt)
    if not s.cameraUnlocked then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    dt = math.clamp(dt or 0, 0, .065)
    camera.CameraType = Enum.CameraType.Scriptable

    if s.cameraMouseDrag then
        -- Cursor capture prevents the mouse stopping at the screen edges.
        -- Read mouse delta once per frame; no double rotation via InputChanged.
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCurrentPosition then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
        local delta = UserInputService:GetMouseDelta()
        if delta.Magnitude > 0 then
            rotateOrbit(delta.X, delta.Y)
        end
    end
    if s.cameraThumbstick.Magnitude > .15 then
        rotateOrbit(s.cameraThumbstick.X * dt * 270, -s.cameraThumbstick.Y * dt * 270)
    end

    local desired = cameraOrbitTarget()
    local smoothing = 1 - math.exp(-dt * 15)
    s.cameraOrbitFocus = s.cameraOrbitFocus and s.cameraOrbitFocus:Lerp(desired, smoothing) or desired
    local focus = s.cameraOrbitFocus
    local yaw, pitch = s.cameraOrbitYaw, s.cameraOrbitPitch
    local radius = s.cameraOrbitDistance
    local offset = Vector3.new(
        math.sin(yaw) * math.cos(pitch) * radius,
        math.sin(pitch) * radius,
        math.cos(yaw) * math.cos(pitch) * radius
    )
    local position = focus + offset
    -- Intentionally skip camera collision raycasts: the camera can pass through walls.
    camera.CFrame = CFrame.lookAt(position, focus)
    camera.Focus = CFrame.new(focus)
    fadeCameraObstructions(focus, position, os.clock())
end

local function cameraInputBegan(input, processed)
    if not s.cameraUnlocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        -- Roblox's default camera/other core input can mark RMB as processed.
        -- Do not discard it, except when typing into a textbox.
        if not UserInputService:GetFocusedTextBox() then
            captureCameraMouse()
        end
    elseif input.UserInputType == Enum.UserInputType.Touch and not processed and not s.cameraActiveTouch then
        s.cameraActiveTouch = input
    end
end
local function cameraInputEnded(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        releaseCameraMouse()
    elseif input == s.cameraActiveTouch then
        s.cameraActiveTouch = nil
    end
end
local function cameraInputChanged(input, processed)
    if not s.cameraUnlocked then return end
    local kind = input.UserInputType
    if kind == Enum.UserInputType.Touch and input == s.cameraActiveTouch and not processed then
        rotateOrbit(input.Delta.X, input.Delta.Y)
    elseif kind == Enum.UserInputType.MouseWheel and not processed then
        s.cameraOrbitDistance = math.clamp(
            s.cameraOrbitDistance * (1 - input.Position.Z * .12), 3, 110
        )
    elseif kind == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick2 then
        s.cameraThumbstick = Vector2.new(input.Position.X, input.Position.Y)
    end
end

function s:SetCameraUnlocked(enabled)
    enabled = enabled == true
    if self.cameraUnlocked == enabled then return end
    self.cameraUnlocked = enabled
    local camera = workspace.CurrentCamera
    if enabled then
        self.cameraUnlockPrevious = camera and {
            cameraType = camera.CameraType, subject = camera.CameraSubject,
        } or nil
        releaseCameraMouse()
        self.cameraActiveTouch = nil
        self.cameraThumbstick = Vector2.zero
        self.cameraFadeCheck = 0
        self.cameraOrbitFocus = cameraOrbitTarget()
        if camera then
            local offset = camera.CFrame.Position - self.cameraOrbitFocus
            local distance = offset.Magnitude
            if distance > .1 then
                self.cameraOrbitDistance = math.clamp(distance, 3, 110)
                self.cameraOrbitPitch = math.asin(math.clamp(offset.Y / distance, -1, 1))
                self.cameraOrbitYaw = math.atan2(offset.X, offset.Z)
            end
            camera.CameraType = Enum.CameraType.Scriptable
        end
        table.insert(self.cameraBindings, UserInputService.InputBegan:Connect(cameraInputBegan))
        table.insert(self.cameraBindings, UserInputService.InputEnded:Connect(cameraInputEnded))
        table.insert(self.cameraBindings, UserInputService.InputChanged:Connect(cameraInputChanged))
        -- Don't leave the mouse locked after alt-tabbing or losing window focus.
        table.insert(self.cameraBindings, UserInputService.WindowFocusReleased:Connect(releaseCameraMouse))
        RunService:BindToRenderStep(CAMERA_BINDING, Enum.RenderPriority.Camera.Value + 1, renderUnlockedCamera)
    else
        RunService:UnbindFromRenderStep(CAMERA_BINDING)
        releaseCameraMouse()
        for _, connection in ipairs(self.cameraBindings) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self.cameraBindings)
        resetCameraFade()
        self.cameraActiveTouch = nil
        self.cameraThumbstick = Vector2.zero
        self.cameraOrbitFocus = nil
        if camera then
            if self.enabled and self.focus and self.focus.Parent then
                camera.CameraType = Enum.CameraType.Custom
                camera.CameraSubject = self.focus
            else
                local previous = self.cameraUnlockPrevious
                camera.CameraType = previous and previous.cameraType or Enum.CameraType.Custom
                if previous and previous.subject and previous.subject.Parent then
                    camera.CameraSubject = previous.subject
                else
                    local _, humanoid = characterReady()
                    if humanoid then camera.CameraSubject = humanoid end
                end
            end
        end
        self.cameraUnlockPrevious = nil
    end
end

local function visualFootOffset(char, humanoid, root)
    -- On R15 characters, use actual feet to align the waiting platform.
    -- Fall back to Humanoid.HipHeight for R6/custom rigs.
    local lowest
    for _, name in ipairs({"LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local footY = part.Position.Y - part.Size.Y * 0.5
            if not lowest or footY < lowest then lowest = footY end
        end
    end
    local fallback = humanoid.HipHeight + root.Size.Y * 0.5
    if lowest then
        local offset = root.Position.Y - lowest
        if offset > 1 and offset < 9 then return offset end
    end
    return fallback
end
local function makePlatform(char, humanoid, root)
    -- Park only ONCE on arrival: repeatedly unanchoring/reanchoring and
    -- replacing the vertical lift was causing the screenshot's jitter.
    if s.parkRoot ~= root then
        releasePark()
        stopTween()
        removeLift()
        setNoclip(char, true)
        s.parkRoot = root
        s.parkOriginalAnchor = root.Anchored
        s.parkLocation = Vector3.new(root.Position.X, undergroundY(), root.Position.Z)
        root.Anchored = true
    end
    -- A slider change only adjusts the depth; X/Z remain stationary.
    local waitAt = Vector3.new(s.parkLocation.X, undergroundY(), s.parkLocation.Z)
    s.parkLocation = waitAt
    if (root.Position - waitAt).Magnitude > 0.04 then
        rootPlacement(root, waitAt.X, waitAt.Z, waitAt.Y)
    end

    if not s.platform then
        local part = Instance.new("Part")
        part.Name = "HollowMoon12x12WaitingPlatform"
        part.Size = Vector3.new(12, 1, 12)
        part.Anchored = true
        part.CanCollide = true
        part.CanTouch = false
        part.CanQuery = false
        part.Color = Color3.fromRGB(70, 83, 112)
        part.Material = Enum.Material.SmoothPlastic
        part.Transparency = .15
        part.Parent = workspace
        s.platform = part
    end
    local feetBelowRoot = visualFootOffset(char, humanoid, root)
    s.platform.CFrame = CFrame.new(waitAt.X, waitAt.Y - feetBelowRoot - 0.5, waitAt.Z)
    -- Root remains anchored until an NPC arrives or Auto Farm is disabled.
    -- The platform is visually under the feet, not relied upon for physics.
end

-- Keep an event-driven NPC cache, including newly spawned enemies.
local function track(m)
    if m and m:IsA("Model") then
        s.enemies[m] = true
        -- Reconsider an available target on the next attack Heartbeat.
        s.nextAttackScan = 0
        s.nextScan = 0
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
        if not s.dodgeEnemySubscriptions[m] then
            local connections = {}
            for _, attribute in ipairs({"AIState", "WindupEnd", "AttackKind"}) do
                connections[#connections + 1] = m:GetAttributeChangedSignal(attribute):Connect(function()
                    s.dodgeNextHazardRefresh = 0
                    s.dodgeNextScan = 0
                    s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
                end)
            end
            s.dodgeEnemySubscriptions[m] = connections
        end
    end
end
local function untrack(m)
    local subs = s.dodgeEnemySubscriptions[m]
    if subs then
        for _, connection in ipairs(subs) do connection:Disconnect() end
        s.dodgeEnemySubscriptions[m] = nil
    end
    s.enemies[m] = nil
    if s.attackTarget == m then s.attackTarget = nil end
    s.nextAttackScan = 0
    s.nextScan = 0
end
local function bindFolder()
    local folder = workspace:FindFirstChild("ActiveEnemies")
    if folder == s.activeFolder then return end
    for _, c in ipairs(s.folderConnections) do c:Disconnect() end
    table.clear(s.folderConnections)
    s.activeFolder = folder
    if folder then
        for _, m in ipairs(folder:GetChildren()) do track(m) end
        connect(folder.ChildAdded, track, s.folderConnections)
        connect(folder.ChildRemoved, function(m)
            if not CollectionService:HasTag(m, "Enemy") then untrack(m) end
        end, s.folderConnections)
    end
end
for _, m in ipairs(CollectionService:GetTagged("Enemy")) do track(m) end
connect(CollectionService:GetInstanceAddedSignal("Enemy"), track)
connect(CollectionService:GetInstanceRemovedSignal("Enemy"), untrack)
-- Tag events can precede the visible warning's next render frame.
for _, tag in ipairs({"VolleyMark", "BossMech"}) do
    connect(CollectionService:GetInstanceAddedSignal(tag), function()
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
        s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
    end)
    connect(CollectionService:GetInstanceRemovedSignal(tag), function()
        s.dodgeNextHazardRefresh = 0
        s.dodgeNextScan = 0
    end)
end
connect(workspace.ChildAdded, function(child)
    if child.Name == "ActiveEnemies" then bindFolder() end
end)
connect(workspace.ChildRemoved, function(child)
    if child == s.activeFolder then s.activeFolder = nil; bindFolder() end
end)
bindFolder()

-- Targets are sticky: one boss remains the priority until it dies or the
-- challenge changes. Ordinary NPC targets use a short lock to avoid jitter.
local function isBoss(model)
    if not model then return false end
    if model:GetAttribute("IsBoss") == true or model:GetAttribute("Boss") == true
        or model:GetAttribute("IsChampion") == true
        or CollectionService:HasTag(model, "Boss")
        or CollectionService:HasTag(model, "Champion") then return true end
    local name = tostring(model:GetAttribute("EnemyType") or model.Name):lower()
    return name:find("champion", 1, true) ~= nil
        or name:find("boss", 1, true) ~= nil
end
local function isRival(model)
    local name = (model and model.Name or ""):lower()
    return name:find("rival",1,true) ~= nil
        or (model and model:GetAttribute("Rival") == true)
        or (model and CollectionService:HasTag(model,"Rival"))
end
local function isChallengeEnemy(model, id)
    return (id == "Champion" and isBoss(model))
        or (id == "Rivals" and isRival(model))
end
local function objectivePosition(instance)
    if not instance or not instance:IsDescendantOf(workspace) then return nil end
    if instance:IsA("BasePart") then return instance.Position end
    if instance:IsA("Attachment") then return instance.WorldPosition end
    if instance:IsA("Model") then return instance:GetPivot().Position end
    return nil
end
local function firstTaggedPosition(tag, fallbackName)
    for _, instance in ipairs(CollectionService:GetTagged(tag)) do
        local p = objectivePosition(instance)
        if p then return p end
    end
    local folder = workspace:FindFirstChild("ChallengeObjects")
    return objectivePosition(folder and folder:FindFirstChild(fallbackName))
end
local function readObjective(now)
    if now < s.lastObjectiveScan then return s.objectiveId end
    s.lastObjectiveScan = now + .20
    if matchHud and type(matchHud.objective) == "function" then
        local ok, objective = pcall(matchHud.objective)
        if ok and type(objective) == "table" and type(objective.id) == "string" then
            s.objectiveDone = objective.completed == true
            s.objectiveId = s.objectiveDone and nil or objective.id
        end
    end
    if gameAttribute("ObjectiveActive") == false then
        s.objectiveDone = true
        s.objectiveId = nil
    end
    local id = not s.objectiveDone and s.objectiveId or nil
    local pos
    if id == "Chariot" then
        pos = firstTaggedPosition("ChallengeChariot", "Chariot")
            or gameAttribute("ObjectivePos")
    elseif id == "Eye" then
        pos = gameAttribute("ObjectivePos") or gameAttribute("EyeStart")
    elseif id == "Treasure" then
        local best, bestDist = nil, math.huge
        local here = s.lastGrounded or s.startPosition or Vector3.zero
        for _, purse in ipairs(CollectionService:GetTagged("Purse")) do
            if not purse:GetAttribute("Taken") and not purse:GetAttribute("Collected") then
                local p = objectivePosition(purse)
                if p then
                    local d = horizontal(here, p)
                    if d < bestDist then best, bestDist = p, d end
                end
            end
        end
        pos = best
    end
    s.objectivePos = typeof(pos) == "Vector3" and pos or nil
    return id
end
local function findTarget(root, now, id)
    local current = rootOf(s.target)
    -- When a boss is alive, stay with it regardless of other NPCs spawning.
    if current and s.focusKind == "Boss" then
        if not (id == "Champion" or id == "Rivals") or isChallengeEnemy(s.target, id) then
            return s.target, current.Position.Y > (s.floorY or 0) + 9, "Boss locked"
        end
    end
    if current and s.focusKind == "Objective NPC" and isChallengeEnemy(s.target, id) then
        return s.target, current.Position.Y > (s.floorY or 0) + 9, "Objective NPC locked"
    end
    local bestBoss, bestBossDist = nil, math.huge
    local bestObjective, bestObjectiveDist = nil, math.huge
    local bestNormal, bestNormalDist = nil, math.huge
    for model in pairs(s.enemies) do
        local enemyRoot = rootOf(model)
        if enemyRoot then
            local d = horizontal(root.Position, enemyRoot.Position)
            if isBoss(model) and d < bestBossDist then
                bestBoss, bestBossDist = model, d
            end
            if id and isChallengeEnemy(model, id) and d < bestObjectiveDist then
                bestObjective, bestObjectiveDist = model, d
            end
            if d < bestNormalDist then bestNormal, bestNormalDist = model, d end
        elseif not model:IsDescendantOf(workspace) then
            s.enemies[model] = nil
        end
    end
    local selected, mode
    if bestObjective then selected, mode = bestObjective, "Objective NPC"
    elseif bestBoss then selected, mode = bestBoss, "Boss"
    elseif current and now < s.lockUntil then selected, mode = s.target, "Normal lock"
    else selected, mode = bestNormal, "Nearest NPC" end
    if selected ~= s.target then
        s.targetSince = now
        s.lockUntil = now + .85
        s.lastGrounded = nil
    end
    s.focusKind = mode
    s.focusName = selected and selected.Name or "None"
    local er = rootOf(selected)
    return selected, er and er.Position.Y > (s.floorY or 0) + 9 or false, mode
end

-- Challenge event handler: only changes the objective ID, never fires
-- undocumented challenge remotes or attempts underground interactions.
local function onMatchPacket(eventName, packet)
    if type(packet) ~= "table" then packet = {} end
    if eventName == "challenge" then
        s.objectiveId = packet.id or packet.challenge or s.objectiveId
        s.objectiveDone = false
        s.lastObjectiveScan = 0
        s.lockUntil = 0
    elseif eventName == "roundStart" then
        s.objectiveId = packet.challenge
        s.objectiveDone = false
        s.lastObjectiveScan = 0
        s.lockUntil = 0
    elseif eventName == "challengeComplete" or eventName == "matchEnd" then
        s.objectiveDone = true
        s.objectiveId = nil
        s.objectivePos = nil
        s.lockUntil = 0
    end
end
if clientState and type(clientState.onMatchEvent) == "function" then
    for _, kind in ipairs({"challenge", "roundStart", "challengeComplete", "matchEnd"}) do
        local ok, con = pcall(clientState.onMatchEvent, kind, function(packet)
            onMatchPacket(kind, packet)
        end)
        if ok and con and (typeof(con) == "RBXScriptConnection"
            or type(con) == "table" and type(con.Disconnect) == "function") then
            table.insert(s.connections, con)
        end
    end
end
local matchRemote = remotes and remotes:FindFirstChild("MatchEvent")
if matchRemote and matchRemote:IsA("RemoteEvent") then
    connect(matchRemote.OnClientEvent, function(eventName, packet)
        if type(eventName) == "table" then
            local kind = eventName.t or eventName.type or eventName.kind
            onMatchPacket(kind, eventName.payload or eventName.data or eventName)
        elseif type(eventName) == "string" then
            onMatchPacket(eventName, packet)
        end
    end)
end

local function startSegment(root, dest)
    stopTween()
    local from = root.Position
    local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z)
    local d = flat.Magnitude
    if d < .7 then return end
    -- Short continuous segments, with no wait for a pathfinder or waypoint callbacks.
    local travel = math.min(d, s.speed * .85)
    local endXZ = from + flat.Unit * travel
    s.segment = {from = from, to = endXZ, target = dest}
    s.driver.Value = 0
    local t = math.max(.05, travel / s.speed)
    s.tween = TweenService:Create(s.driver, TweenInfo.new(t, Enum.EasingStyle.Linear), {Value = 1})
    s.tween:Play()
end
-- Enemy-relative positioning: the enemy's facing changes the horizontal
-- destination continuously, while the avatar Y is ALWAYS tied to arena floor.
-- This means a jumping Lion never lifts the farming character into the sky.
-- Creature IDs in Defs.Creatures include "cerberus". This override applies
-- only to its Behind + Below horizontal offset, never the underground depth.
local function isCerberus(model)
    if not model or not model:IsA("Model") then return false end
    local labels = {
        model.Name,
        model:GetAttribute("CreatureId"),
        model:GetAttribute("CreatureType"),
        model:GetAttribute("EnemyType"),
        model:GetAttribute("EnemyId"),
        model:GetAttribute("TypeId"),
        model:GetAttribute("NPCType"),
    }
    for _, value in pairs(labels) do
        if value ~= nil then
            local id = tostring(value):lower():gsub("[^%a]", "")
            if id:find("cerberus", 1, true) or id:find("cerebrus", 1, true) then
                return true
            end
        end
    end
    return false
end

local function effectiveBehindOffset(target)
    if isCerberus(target) then return 10 end
    return s.behindOffset
end

local function behindGoal(target, enemyRoot, airborne, dt)
    if s.behindTarget ~= target then
        s.behindTarget = target
        s.behindYaw = nil
    end

    -- HumanoidRootPart usually represents NPC facing more reliably than a
    -- decorative or hitbox PrimaryPart; the active model root is fallback.
    local facingRoot = target:FindFirstChild("HumanoidRootPart")
    if not (facingRoot and facingRoot:IsA("BasePart")) then
        facingRoot = enemyRoot
    end
    local look = facingRoot.CFrame.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > .02 then
        local wantedYaw = math.atan2(flatLook.X, flatLook.Z)
        if s.behindYaw == nil then
            s.behindYaw = wantedYaw
        elseif not airborne then
            -- Smooth angular rotation with wraparound, avoiding abrupt side
            -- flips when the enemy turns across the -pi/+pi boundary.
            local diff = math.atan2(
                math.sin(wantedYaw - s.behindYaw),
                math.cos(wantedYaw - s.behindYaw)
            )
            local maxTurn = math.rad(300) * math.clamp(dt, 0, .08)
            s.behindYaw = s.behindYaw + math.clamp(diff, -maxTurn, maxTurn)
        end
    end

    local yaw = s.behindYaw or 0
    local behind = Vector3.new(math.sin(yaw), 0, math.cos(yaw))
    local base = airborne and s.lastGrounded or enemyRoot.Position
    base = base or enemyRoot.Position
    local behindOffset = effectiveBehindOffset(target)
    return Vector3.new(
        base.X - behind.X * behindOffset,
        0,
        base.Z - behind.Z * behindOffset
    )
end

-- Smooth pursuit for continuously rotating targets. Instead of restarting
-- a TweenService animation every time a target turns, interpolate one small
-- step per Heartbeat, capped by the selected Tween Speed in studs/second.
-- The Teleport option still positions immediately at the current behind spot.
local function moveBehindBelow(root, goal, dt)
    if not s.behindActive then
        stopTween()
        s.behindActive = true
    end
    local y = undergroundY()
    local here = root.Position
    local flat = Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)
    local distance = flat.Magnitude
    if s.method == "Teleport" then
        if distance > .45 or math.abs(here.Y - y) > .04 then
            rootPlacement(root, goal.X, goal.Z, y)
        else
            -- Keep turning smoothly even while our behind spot is stationary.
            rootPlacement(root, here.X, here.Z, y)
        end
        return
    end
    if distance <= .20 then
        rootPlacement(root, here.X, here.Z, y)
        return
    end
    local frame = math.clamp(dt, 0, .065)
    local cap = s.speed * frame
    local easedStep = distance * (1 - math.exp(-frame * 13))
    local step = math.min(cap, easedStep, distance)
    local nextXZ = here + flat.Unit * step
    rootPlacement(root, nextXZ.X, nextXZ.Z, y)
end

local function resetBehind()
    s.behindActive = false
    s.behindTarget = nil
    s.behindYaw = nil
end

local function moveBelow(root, goal, now)
    local y = undergroundY()
    if s.method == "Teleport" then
        stopTween()
        local xz = Vector3.new(root.Position.X, y, root.Position.Z)
        if horizontal(xz, goal) > 1.65 then
            rootPlacement(root, goal.X, goal.Z, y)
        else
            rootPlacement(root, xz.X, xz.Z, y)
        end
        return
    end
    -- Replan a moving target without cancelling the tween every Heartbeat.
    local seg = s.segment
    local changed = seg and horizontal(seg.target, goal) > 3.3
    local finished = not seg or s.driver.Value >= .999
    if (finished or (changed and now >= s.nextPlan)) then
        startSegment(root, goal)
        s.nextPlan = now + .20
    end
    local p = root.Position
    if s.segment then
        p = s.segment.from:Lerp(s.segment.to, math.clamp(s.driver.Value, 0, 1))
    end
    rootPlacement(root, p.X, p.Z, y)
end

-- Runtime kit definitions take precedence; fallback durations are from
-- captured client move definitions (not server bypass timings).
local fallbackMoves = {
    Gladiator = {
        {id = "glad_slash1", duration = .42},
        {id = "glad_slash2", duration = .42},
        {id = "glad_bash", duration = .60, recovery = .15},
    },
    Lancer = {
        {id = "lance_thrust1", duration = .50},
        {id = "lance_thrust2", duration = .50},
        {id = "lance_sweep", duration = .70, recovery = .15},
    },
    Berserker = {
        {id = "bers_cleave", duration = .55},
        {id = "bers_reaver", duration = .60},
        {id = "bers_earthsplit", duration = .80, recovery = .15},
    },
    Archer = {
        {id = "bow_shot", duration = .45},
        {id = "bow_shot", duration = .45},
        {id = "bow_volley", duration = .60},
    },
}
local attackRanges = {Gladiator = 7, Lancer = 11, Berserker = 8, Archer = 95}
local function currentSnapshot()
    if clientState and type(clientState.get) == "function" then
        local ok, val = pcall(clientState.get)
        if ok and type(val) == "table" then return val end
    end
    return {}
end
local function cooldownMultiplier(char)
    local data = currentSnapshot()
    local tool = char:FindFirstChildOfClass("Tool")
    local weaponId = player:GetAttribute("WeaponId")
        or (tool and tool:GetAttribute("WeaponId")) or data.SelectedWeapon
    local weapon = lookup(weapons, weaponId)
    local statSheet = data.StatSheet
    if type(statSheet) == "table" and statSheet.weaponId == weaponId then
        local actual = finite(statSheet.cooldownMult, nil)
        if actual then return math.clamp(actual, .5, 2) end
    end
    local skills = type(data.Skills) == "table" and data.Skills or {}
    local skillSpeed = finite(skills.AttackSpeed, 0)
    local weaponSpeed = math.clamp(finite(weapon and weapon.attackSpeed, 0), 0, .9)
    if formulas and type(formulas.attackCooldownMult) == "function" then
        local ok, result = pcall(formulas.attackCooldownMult, skillSpeed, weaponSpeed)
        if ok and finite(result, nil) then
            return math.clamp(result, .5, 2)
        end
    end
    return math.clamp((1 - skillSpeed * .03) * (1 - weaponSpeed), .5, 2)
end
local function currentMove(kit, stage)
    local fallback = (fallbackMoves[kit] or fallbackMoves.Gladiator)[stage]
    if not fallback then return {id = "unknown", duration = .5} end
    local kitDef = lookup(kits, kit)
    local combo = kitDef and (kitDef.combo or kitDef.Combo or kitDef.comboMoves)
    local moveId = type(combo) == "table" and combo[stage] or fallback.id
    local move = lookup(kits and kits.moves, moveId)
        or lookup(kits and kits.Moves, moveId)
        or lookup(kitDef and kitDef.moves, moveId)
    local result = table.clone(fallback)
    if type(move) == "table" then
        for k, v in pairs(move) do result[k] = v end
    end
    result.id = moveId
    return result
end

local function tryEquip(char, humanoid, now)
    if char:FindFirstChildOfClass("Tool") then return true end
    if now < (s.nextEquip or 0) then return false end
    s.nextEquip = now + .7
    local bag = player:FindFirstChildOfClass("Backpack")
    if not bag then return false end
    for _, tool in ipairs(bag:GetChildren()) do
        if tool:IsA("Tool") and (tool:GetAttribute("WeaponId") or tool:GetAttribute("WeaponModelId")) then
            humanoid:EquipTool(tool)
            break
        end
    end
    return false
end
-- Combat direction is separate from camera orbit: changing the view never
-- changes the NPC Auto Attack aim or the farm movement target.
local function predictedPoint(enemyRoot, kit, origin)
    local velocity = enemyRoot.AssemblyLinearVelocity
    if velocity.Magnitude > 65 then velocity = velocity.Unit * 65 end
    if kit == "Archer" then
        -- Cap the lead to avoid arrows scattering when an enemy changes direction.
        local dt = math.clamp((enemyRoot.Position - origin).Magnitude / 180, .04, .22)
        return enemyRoot.Position + Vector3.new(0, 1.1, 0) + velocity * dt
    end
    return enemyRoot.Position + velocity * .035
end
local groupedMeleeAim -- forward-declared: attackNpc uses it before its definition
local function attackNpc(char, humanoid, root, npc, now)
    if not attackRemote then
        s.attackStatus = "Direct Attack remote unavailable"
        return
    end
    if now < s.nextAttack then return end
    if char:GetAttribute("Downed") or char:GetAttribute("Stunned")
        or char:GetAttribute("AttackDisabled") then
        s.attackStatus = "Combat unavailable (disabled state)"
        return
    end
    if not tryEquip(char, humanoid, now) then
        s.attackStatus = "Equipping weapon"
        return
    end
    local enemyRoot = rootOf(npc)
    if not enemyRoot then return end
    local kit = kitName()
    if kit ~= s.attackLastKit then
        s.combo, s.comboLast = 0, 0
        s.attackLastKit = kit
    end
    local reach = attackRanges[kit] or 7
    local delta = enemyRoot.Position - root.Position
    local distance = delta.Magnitude
    s.attackDistance = distance
    -- Deliberately DO NOT gate attack requests by distance. Auto Attack
    -- attempts as long as a living NPC exists; the server still validates
    -- hitboxes and effective attack reach.
    local withinReach = distance <= reach - .12
    local aim
    if kit == "Archer" then
        s.attackGroupEstimate = 1
        local from = root.Position + Vector3.new(0, 1.4, 0)
        local deltaShot = predictedPoint(enemyRoot, kit, from) - from
        if deltaShot.Magnitude < .01 then return end
        aim = deltaShot.Unit
    else
        local flat = Vector3.new(delta.X, 0, delta.Z)
        aim = groupedMeleeAim(root, npc, delta)
    end
    local comboCount = #(fallbackMoves[kit] or fallbackMoves.Gladiator)
    -- Combo reset should happen only after a substantial time without attacking.
    if now - s.comboLast > 1.2 then s.combo = 0 end
    local stage = s.combo % comboCount + 1
    local move = currentMove(kit, stage)
    local remoteSeq = finite(char:GetAttribute("MoveSeq"), nil)
    -- A rapid client sequence can move far beyond the last server-reported
    -- sequence. Rebase after a sustained lack of acknowledgements so one
    -- rejected burst cannot make every later request invalid.
    if remoteSeq and s.seq - remoteSeq > 12
        and now - (s.attackLastAcknowledgedAt or 0) > 1.0 then
        s.seq = remoteSeq
        s.attackResyncs = s.attackResyncs + 1
        s.paceStatus = "Resynced attack sequence after missing acknowledgements"
    end
    s.seq = math.max(s.seq, remoteSeq or 0) + 1
    local ok = pcall(function()
        if kit == "Archer" then
            attackRemote:FireServer(s.seq, aim, false)
        else
            attackRemote:FireServer(s.seq, aim)
        end
    end)
    if not ok then
        s.nextAttack = now + .30
        s.attackStatus = "Attack remote request failed"
        return
    end
    s.combo = stage
    s.comboLast = now
    s.requests = s.requests + 1
    s.attackMove = tostring(move.id or "Attack")
    s.cooldownMult = cooldownMultiplier(char)
    s.attackLastRequest = now
    s.attackLastSeqTime = now
    s.attackLastSeq = s.seq
    -- Track multiple outstanding requests. At rapid rates, tracking only the
    -- latest request would incorrectly discard acknowledgements of earlier ones.
    table.insert(s.pendingAttackSeqs, {seq = s.seq, at = now})
    if #s.pendingAttackSeqs > 40 then table.remove(s.pendingAttackSeqs, 1) end
    -- No speed slider or 3D range gate. Bounded 50ms requests while at
    -- least one living NPC exists. Do not fire every Heartbeat: this keeps
    -- network traffic predictable even on high-FPS devices.
    local interval = .05
    s.lastExpectedAttack = interval
    s.nextAttack = now + interval
    table.insert(s.recentAttackRequests, now)
    while #s.recentAttackRequests > 0 and now - s.recentAttackRequests[1] > 3 do
        table.remove(s.recentAttackRequests, 1)
    end
    if withinReach then
        s.attackStatus = "Rapid attack sent (in class range); server validation pending"
    else
        s.attackStatus = "Rapid attack sent (out of class range; damage not guaranteed)"
    end
end

-- Auto Leave on eliminated teammates or the local player.
-- When the local self-death toggle is enabled, V38 first declines the
-- optional paid revive offer using the game's actual No thanks action.
-- MatchHUDController confirms "Downed" is revivable and "Eliminated"
-- is the team HUD's "Fallen" state. We do not infer death from health=0.
local function matchState(name)
    local stateFolder = ReplicatedStorage:FindFirstChild("GameState")
    local value = stateFolder and stateFolder:GetAttribute(name)
    if value == nil and clientState and type(clientState.game) == "table" then
        value = clientState.game[name]
    end
    return value
end
local function arenaMatchKey()
    local matchId = player:GetAttribute("MatchId")
    if type(matchId) ~= "string" or matchId == "" then
        matchId = matchState("MatchId")
    end
    if type(matchId) ~= "string" then matchId = "" end
    return matchId
end
local function participantIds()
    local ids = {}
    local raw = matchState("Participants")
    if type(raw) == "string" and raw ~= "" then
        for token in raw:gmatch("[^,]+") do
            local id = tonumber(token)
            if id then ids[math.floor(id)] = true end
        end
    end
    return ids, next(ids) ~= nil
end
local function findFullyEliminatedTeammate()
    local ids, hasParticipantList = participantIds()
    local currentId = arenaMatchKey()
    -- Players: check only active match participants, not spectators/lobby.
    for _, member in ipairs(Players:GetPlayers()) do
        local sameMatch = currentId == ""
            or member == player
            or (hasParticipantList and ids[member.UserId] == true)
            or member:GetAttribute("MatchId") == currentId
        local eligible = member ~= player and (
            (hasParticipantList and ids[member.UserId] == true)
            or (not hasParticipantList and member:GetAttribute("Zone") == "Arena" and sameMatch)
        )
        if eligible and sameMatch and member:GetAttribute("CombatState") == "Eliminated" then
            return member.DisplayName, false
        end
    end
    -- AI teammates: MatchHUD gets their state from models tagged "Bot".
    for _, bot in ipairs(CollectionService:GetTagged("Bot")) do
        if bot:IsA("Model") and bot:IsDescendantOf(workspace) then
            local botId = bot:GetAttribute("MatchId")
            local sameMatch = currentId == "" or botId == nil or botId == "" or botId == currentId
            if sameMatch and bot:GetAttribute("CombatState") == "Eliminated" then
                return tostring(bot:GetAttribute("DisplayName") or bot.Name), false
            end
        end
    end
    return nil, false
end
-- GloryBound's SummaryController builds a custom Bronze Kit.button: its
-- visual wrapper is not necessarily a GuiButton. GuiButton:Activate() is not
-- a Roblox API method, and attempting it caused "Activate unavailable".
-- The *actual* Back to the prison action sends LeaveMatch("continue").
-- First detect the visible results screen, then send precisely that action.
local function resultsReturnVisible()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return false end
    local function visible(object)
        while object and object ~= gui do
            if object:IsA("GuiObject") and not object.Visible then return false end
            if object:IsA("ScreenGui") and not object.Enabled then return false end
            object = object.Parent
        end
        return true
    end
    for _, item in ipairs(gui:GetDescendants()) do
        if (item:IsA("TextLabel") or item:IsA("TextButton")) and visible(item) then
            local label = tostring(item.Text or ""):lower():gsub("%s+", " ")
            if label:find("back to the prison", 1, true) or label:find("back to prison", 1, true) then
                return true
            end
        end
    end
    return false
end

local function sendResultsContinue()
    -- SummaryController calls ClientState.fire("LeaveMatch", "continue").
    -- Prefer its built-in wrapper when available, then fall back to the
    -- identical direct RemoteEvent call. Neither path clicks Retry.
    if clientState and type(clientState.fire) == "function" then
        local ok, accepted = pcall(clientState.fire, "LeaveMatch", "continue")
        if ok and accepted ~= false then
            return true, "ClientState"
        end
    end
    local remote = remotes and remotes:FindFirstChild("LeaveMatch")
    if remote and remote:IsA("RemoteEvent") then
        local ok = pcall(function() remote:FireServer("continue") end)
        if ok then return true, "LeaveMatch remote" end
    end
    return false, "Continue request unavailable"
end

local function clickResultReturn(now)
    if not resultsReturnVisible() then
        s.leaveStatus = "Waiting for results-screen return control"
        return false
    end
    if now < s.leaveButtonAttemptAt then return true end
    -- Don't spam the return command during a teleport. Retry only if the
    -- actual results screen is still visible a few seconds later.
    s.leaveButtonAttemptAt = now + 3.0
    s.leaveButtonTries = s.leaveButtonTries + 1
    local sent, method = sendResultsContinue()
    if sent then
        s.leaveStatus = "Return requested via " .. method .. " (attempt " .. s.leaveButtonTries .. ")"
    else
        s.leaveStatus = "Return failed: " .. method
    end
    return true
end

-- V38: The actual "No thanks" choice in ReviveOfferController sends
-- ClientState.fire("ReviveOfferAnswer", activeOffer.id, "decline").
-- Handle that *only* for the local player's enabled self-death toggle.
-- Declining skips the optional self-revive offer; we do not buy a revive.
s.localIsDowned = function()
    if player:GetAttribute("CombatState") == "Downed" then return true end
    local character = player.Character
    return character ~= nil and character:GetAttribute("Downed") == true
end

s.tryDeclineOwnReviveOffer = function()
    if not s.leaveSelfEnabled or not s.localIsDowned() then return false end
    if type(s.leaveOfferId) ~= "number" or s.leaveOfferState ~= "open" then return false end
    local now = os.clock()
    if now < s.leaveOfferNextAt or s.leaveOfferTries >= 3 then return false end
    s.leaveOfferNextAt = now + 0.75
    s.leaveOfferTries = s.leaveOfferTries + 1

    local didSend = false
    if clientState and type(clientState.fire) == "function" then
        local ok, result = pcall(clientState.fire, "ReviveOfferAnswer", s.leaveOfferId, "decline")
        didSend = ok and result == true
    end
    if not didSend then
        local remote = remotes and remotes:FindFirstChild("ReviveOfferAnswer")
        if remote and remote:IsA("RemoteEvent") then
            didSend = pcall(function()
                remote:FireServer(s.leaveOfferId, "decline")
            end)
        end
    end

    if didSend then
        s.leaveStatus = "No thanks requested; awaiting elimination"
    else
        s.leaveStatus = "Revive decline request unavailable"
    end
    return didSend
end

s.observeLocalReviveOffer = function(packet)
    if not s.leaveSelfEnabled or type(packet) ~= "table" then return end
    local id = tonumber(packet.id)
    if not id or id % 1 ~= 0 then return end
    if packet.state == "closed" then
        if s.leaveOfferId == id then
            s.leaveOfferId, s.leaveOfferState = nil, nil
        end
        return
    end
    if packet.state ~= "open" then return end
    if s.leaveOfferId ~= id then
        s.leaveOfferId = id
        s.leaveOfferTries = 0
        s.leaveOfferNextAt = 0
    end
    s.leaveOfferState = "open"
    -- Event-driven response is faster than waiting for the next scan tick.
    s.tryDeclineOwnReviveOffer()
end

s.checkCurrentReviveOffer = function()
    if not s.leaveSelfEnabled or not s.localIsDowned() then return end
    -- Supports enabling Auto Leave while a revive offer is already visible.
    if not s.leaveOfferId then
        local module = controllers and controllers:FindFirstChild("ReviveOfferController")
        local controller = readModule(module)
        if controller and type(controller.current) == "function" then
            local ok, packet = pcall(controller.current)
            if ok and type(packet) == "table" then
                s.observeLocalReviveOffer(packet)
            end
        end
    end
    s.tryDeclineOwnReviveOffer()
end

local function tickAutoLeave()
    if not s.leaveEnabled then return end
    local now = os.clock()
    if now < s.nextLeaveScan then return end
    s.nextLeaveScan = now + .10

    -- While downed, immediately choose No thanks (if the optional revive
    -- offer is open) so the server can confirm elimination sooner.
    s.checkCurrentReviveOffer()

    -- Always handle the results screen when Auto Leave is enabled, even if
    -- the arena ended normally and this script did not issue the initial leave.
    -- Do not mistake the boon picker for the results screen.
    if resultsReturnVisible() then
        -- Prefer the visible result screen over the Zone attribute: the latter
        -- can change before the result UI/teleport transition finishes.
        if not s.leaveReturnPending then
            s.leaveReturnPending = true
            s.leaveButtonAttemptAt = 0
            s.leaveButtonTries = 0
        end
        clickResultReturn(now)
        return
    elseif player:GetAttribute("Zone") == "Lobby" then
        if s.leaveReturnPending then
            s.leaveStatus = "Returned to the prison/lobby"
        end
        s.leaveReturnPending = false
        s.leaveRequested = false
        s.leaveButtonTries = 0
        s.leaveButtonAttemptAt = 0
    elseif s.leaveReturnPending then
        -- An initial LeaveMatch may have happened before the report appeared.
        -- Wait for the real results-screen action, rather than guessing success.
        s.leaveStatus = "Waiting for results screen / server transition"
        return
    end

    if player:GetAttribute("Zone") ~= "Arena" then
        s.leaveRequested = false
        s.leaveMatchKey = nil
        s.leaveStatus = "Waiting for an arena match"

        return
    end
    local phase = matchState("Phase")
    if phase ~= nil and phase ~= "InMatch" then
        s.leaveStatus = "Waiting for an active match"

        return
    end
    local key = arenaMatchKey()
    if key ~= s.leaveMatchKey then
        s.leaveMatchKey = key
        s.leaveRequested = false
    end
    if s.leaveRequested then

        return
    end
    -- Revivable Downed is never a full death. Self and teammate triggers
    -- are independent; only the matching enabled toggle can request leaving.
    local name, isSelf = nil, false
    if s.leaveSelfEnabled and player:GetAttribute("CombatState") == "Eliminated" then
        name, isSelf = player.DisplayName, true
    elseif s.leaveTeammateEnabled then
        name = findFullyEliminatedTeammate()
    end
    if name then
        local leaveRemote = remotes and remotes:FindFirstChild("LeaveMatch")
        if leaveRemote and leaveRemote:IsA("RemoteEvent") then
            -- The game's MatchHUD sends "continue" for already-eliminated
            -- local players, and "leave" while alive (teammate trigger).
            local command = isSelf and "continue" or "leave"
            local success = pcall(function() leaveRemote:FireServer(command) end)
            if success then
                s.leaveRequested = true
                s.leaveReturnPending = true
                s.leaveTarget = name
                s.leaveButtonTries = 0
                s.leaveButtonAttemptAt = 0
                s.leaveStatus = "Leave sent (" .. command .. "); waiting for results"
            else
                s.leaveStatus = "Failed to send leave request"
            end
        else
            s.leaveStatus = "LeaveMatch remote unavailable"
        end
    else
        s.leaveStatus = "Watching enabled full-death conditions (ignores Downed)"
    end

end
-- One shared scanner for two separately configurable death triggers.
-- It runs only if at least one Auto Leave toggle is enabled.
function s:UpdateAutoLeave()
    local active = self.leaveTeammateEnabled or self.leaveSelfEnabled
    if self.leaveEnabled == active then return end
    self.leaveEnabled = active
    self.leaveRequested = false
    self.leaveReturnPending = false
    self.leaveMatchKey = nil
    self.leaveButtonAttemptAt = 0
    self.leaveButtonTries = 0
    self.nextLeaveScan = 0
    if active then
        self.leaveStatus = "Watching enabled full-death conditions"
        if self.leaveHeartbeat then self.leaveHeartbeat:Disconnect() end
        self.leaveHeartbeat = RunService.Heartbeat:Connect(function()
            local success, err = pcall(tickAutoLeave)
            if not success then
                self.leaveStatus = "Leave watcher error"
                if os.clock() >= (self.nextLeaveWarning or 0) then
                    self.nextLeaveWarning = os.clock() + 8
                    warn("[HollowMoonHub Auto Leave] " .. tostring(err))
                end
            end
        end)
    else
        if self.leaveHeartbeat then self.leaveHeartbeat:Disconnect(); self.leaveHeartbeat = nil end
        self.leaveStatus = "Off"
        self.leaveTarget = nil
    end
    self.nextLeaveUi = 0
end

function s:SetAutoLeave(value)
    -- Retain the original saved toggle flag, now teammate-only.
    self.leaveTeammateEnabled = value == true
    self.nextLeaveScan = 0
    self:UpdateAutoLeave()
end

function s:SetAutoLeaveSelf(value)
    self.leaveSelfEnabled = value == true
    self.nextLeaveScan = 0
    if self.leaveReviveOfferConn then
        self.leaveReviveOfferConn:Disconnect()
        self.leaveReviveOfferConn = nil
    end
    self.leaveOfferId, self.leaveOfferState = nil, nil
    self.leaveOfferTries = 0
    self.leaveOfferNextAt = 0
    if self.leaveSelfEnabled then
        local offerEvent = remotes and remotes:FindFirstChild("ReviveOffer")
        if offerEvent and offerEvent:IsA("RemoteEvent") then
            self.leaveReviveOfferConn = offerEvent.OnClientEvent:Connect(function(packet)
                local ok, err = pcall(observeLocalReviveOffer, packet)
                if not ok then warn("[HollowMoonHub No Thanks] " .. tostring(err)) end
            end)
        end
        s.checkCurrentReviveOffer()
    end
    self:UpdateAutoLeave()
end

-- Server-reported NPC hits are more informative than counting requests.
local function attachCombatFeedback(remote)
    if not remote or remote.Name ~= "CombatFx" then return end
    if not (remote:IsA("RemoteEvent") or remote:IsA("UnreliableRemoteEvent")) then return end
    if s.combatFxRemote == remote then return end
    s.combatFxRemote = remote
    connect(remote.OnClientEvent, function(packet)
        if not s.attackEnabled or type(packet) ~= "table" or packet.t ~= "hit" then return end
        if packet.category == "Player" or packet.burn then return end
        local source = finite(packet.byUserId or packet.by, nil)
        local amount = finite(packet.amount, nil)
        if source == player.UserId and amount and amount > 0 then
            s.attackConfirmed = s.attackConfirmed + 1
            s.attackDamage = s.attackDamage + amount
        end
    end)
end
if remotes then
    attachCombatFeedback(remotes:FindFirstChild("CombatFx"))
    connect(remotes.ChildAdded, attachCombatFeedback)
end

-- Separate attack scheduler: Auto Attack can be enabled without Auto Farm.
-- It NEVER moves the player or changes the camera. Farm's movement state
-- and Auto Attack's cooldown / target state are deliberately independent.
local function nearestSpawnedNpc(root, kit)
    local limit = (attackRanges[kit] or attackRanges.Gladiator) - .12
    local spawned = {}
    local inRange = {}
    for npc in pairs(s.enemies) do
        local er = rootOf(npc)
        if er then
            local distance = (er.Position - root.Position).Magnitude
            local entry = {npc = npc, root = er, distance = distance}
            spawned[#spawned + 1] = entry
            if distance <= limit then
                inRange[#inRange + 1] = entry
            end
        elseif not npc:IsDescendantOf(workspace) then
            s.enemies[npc] = nil
        end
    end
    table.sort(spawned, function(a, b) return a.distance < b.distance end)
    table.sort(inRange, function(a, b) return a.distance < b.distance end)
    -- Group aim still uses only the enemies that could be hit by a melee
    -- swing. Target selection itself is intentionally NOT range-limited.
    s.attackCandidates = inRange
    s.attackNearbyCount = #inRange
    s.attackSpawnedCount = #spawned
    if #spawned == 0 then return nil end

    -- Keep the farm's locked boss/objective target when it remains alive.
    if s.enabled and s.target then
        for _, entry in ipairs(spawned) do
            if entry.npc == s.target then return entry.npc end
        end
    end
    -- Hold a current target when it is almost as near as the nearest one.
    -- Prevents flickering between piled-up enemies.
    local nearest = spawned[1]
    for _, entry in ipairs(spawned) do
        if entry.npc == s.attackTarget and entry.distance <= nearest.distance + 2 then
            return entry.npc
        end
    end
    return nearest.npc
end

-- A single accepted melee swing may naturally hit multiple NPCs. Choose an
-- aim vector through the densest nearby cone, without sending extra remotes.
groupedMeleeAim = function(root, npc, delta)
    local primary = Vector3.new(delta.X, 0, delta.Z)
    if primary.Magnitude < .02 then
        s.attackGroupEstimate = 0
        return root.CFrame.LookVector
    end
    local selectedDir = primary.Unit
    local entries = s.attackCandidates or {}
    local bestDir, bestHits, bestWeight = selectedDir, 1, -math.huge
    local candidateCount = math.min(#entries, 16)
    local origin = root.Position
    for index = 1, candidateCount do
        local entry = entries[index]
        if rootOf(entry.npc) then
            local proposed = Vector3.new(entry.root.Position.X - origin.X, 0,
                entry.root.Position.Z - origin.Z)
            if proposed.Magnitude > .03 then
                proposed = proposed.Unit
                -- If the farm's boss/champion is in reach, group aim must
                -- stay oriented around that lock instead of swinging away.
                local focusLocked = s.enabled and s.target == npc
                    and (s.focusKind == "Boss" or s.focusKind == "Objective NPC")
                if not focusLocked or proposed:Dot(selectedDir) >= .75 then
                local sum = Vector3.zero
                local hits, weight = 0, 0
                for _, other in ipairs(entries) do
                    local er = rootOf(other.npc)
                    if er then
                        local direction = Vector3.new(er.Position.X-origin.X, 0,
                            er.Position.Z-origin.Z)
                        if direction.Magnitude > .03 then
                            direction = direction.Unit
                            if proposed:Dot(direction) >= .75 then
                                hits = hits + 1
                                local w = 1 / math.max(2, other.distance)
                                sum = sum + direction*w
                                weight = weight + w
                            end
                        end
                    end
                end
                -- Small stability preference for the farm's locked target.
                local bias = (entry.npc == npc and .20 or 0)
                local quality = hits * 2 + weight + bias
                if quality > bestWeight and sum.Magnitude > .02 then
                    bestWeight, bestDir, bestHits = quality, sum.Unit, hits
                end
                end -- stay within the boss/champion aim cone when locked
            end
        end
    end
    s.attackGroupEstimate = bestHits -- potential targets in aim cone, NOT confirmed hits
    return bestDir
end

-- Every ~1.6s, use server-observed MoveSeq ACKs and damage feedback to
-- find a useful request pace. This cannot increase the game's server limit.
-- If feedback is unavailable, retain the fast default instead of guessing.
local function tuneAttackPace(now)
    if not s.paceWindowAt then
        s.paceWindowAt = now
        s.paceWindowRequests = s.requests
        s.paceWindowAcks = s.attackAccepted
        s.paceWindowHits = s.attackConfirmed
        return
    end
    if now - s.paceWindowAt < 1.6 then return end
    local attempts = math.max(0, s.requests - s.paceWindowRequests)
    local acks = math.max(0, s.attackAccepted - s.paceWindowAcks)
    local hits = math.max(0, s.attackConfirmed - s.paceWindowHits)
    s.attackInterval = .05
    if attempts == 0 then
        s.paceStatus = "Waiting for spawned NPCs"
    elseif hits > 0 then
        s.paceStatus = "Rapid mode: server-reported hits observed"
    elseif acks > 0 then
        s.paceStatus = "Rapid mode: move acknowledgements observed"
    else
        s.paceStatus = "Rapid requests sent; no confirmed damage yet"
    end
    s.paceWindowAt = now
    s.paceWindowRequests = s.requests
    s.paceWindowAcks = s.attackAccepted
    s.paceWindowHits = s.attackConfirmed
end

local function tickAttack()
    if not s.attackEnabled then return end
    if s.reviveHolding then
        s.attackStatus = "Paused while holding teammate revive"
        return
    end
    if s.botBlocking then
        s.attackStatus = "Bot AI | holding a timed defensive block"
        return
    end
    if s:IsDowned() then
        s.attackTarget = nil
        s.attackStatus = "Paused - downed or eliminated"
        return
    end
    local now = os.clock()
    local char, humanoid, root = characterReady()
    if not char then
        s.attackTarget = nil
        s.attackStatus = "Waiting for a living character"

        return
    end
    if s.lastAttackCharacter ~= char then
        s.lastAttackCharacter = char
        s.seq = finite(char:GetAttribute("MoveSeq"), 0)
        s.combo = 0
        s.nextAttack = 0
        s.attackTarget = nil
        s.attackDistance = nil
        s.attackCandidates = {}
        s.attackNearbyCount = 0
        s.attackSpawnedCount = 0
        s.attackGroupEstimate = 0
        s.nextAttackScan = 0
        s.attackBuffer = .006
        s.attackPace = 1
        s.attackInterval = .05
        s.paceWindowAt = nil
        s.paceStatus = "Fast mode: restarted after respawn"
        s.pendingAttackSeqs = {}
        s.attackAckStreak = 0
        s.attackAckAvailable = false
        s.lastExpectedAttack = .5
        s.observedSeq = finite(char:GetAttribute("MoveSeq"), 0)
        s.attackAckAvailable = false
        s.attackLastKit = nil
        s.attackLastSeq = nil
        s.attackLastAcknowledgedAt = now
        table.clear(s.recentAttackRequests)
    end
    -- MoveSeq advances are feedback, NOT proof of hit or extra damage.
    -- Keep acknowledgements for the watcher while allowing rapid requests.
    local moveSeq = finite(char:GetAttribute("MoveSeq"), nil)
    if moveSeq and moveSeq ~= s.observedSeq then
        if moveSeq > (s.observedSeq or 0) then
            local acknowledged = 0
            for i = #s.pendingAttackSeqs, 1, -1 do
                if s.pendingAttackSeqs[i].seq <= moveSeq then
                    table.remove(s.pendingAttackSeqs, i)
                    acknowledged = acknowledged + 1
                end
            end
            if acknowledged > 0 then
                s.attackAckAvailable = true
                -- One MoveSeq advance is one observed acknowledgement event,
                -- not proof that every skipped request was accepted.
                s.attackAccepted = s.attackAccepted + 1
                s.attackLastAcknowledgedAt = now
            end
        end
        s.observedSeq = moveSeq
    end
    -- Discard old outstanding requests so long sessions don't accumulate data.
    for i = #s.pendingAttackSeqs, 1, -1 do
        if now - s.pendingAttackSeqs[i].at > 3 then
            table.remove(s.pendingAttackSeqs, i)
        end
    end
    tuneAttackPace(now)
    local kit = kitName()
    if now >= s.nextAttackScan or not rootOf(s.attackTarget) then
        local found = nearestSpawnedNpc(root, kit)
        s.attackScanCount = s.attackScanCount + 1
        if found ~= s.attackTarget then
            s.attackTargetSwitches = s.attackTargetSwitches + 1
            -- When a newly reachable target appears, do not wait for the
            -- previous target's scan interval. Attack cooldown is still respected.
            s.attackTarget = found
        end
        -- 25ms scan cadence; event-driven cache updates force prompt scans.
        s.nextAttackScan = now + .025
    end
    if s.attackTarget then
        if now >= s.nextAttack then
            attackNpc(char, humanoid, root, s.attackTarget, now)
        end
    else
        s.attackDistance = nil
        s.attackStatus = "Waiting: no living NPC spawned"
    end

end

-- Independent Auto Dodge: all ground-attack danger zones are evaluated in XZ
-- even when the player is 30+ studs below the arena surface.
local function dangerScore(point, zone)
    local dx, dz = point.X-zone.center.X, point.Z-zone.center.Z
    local dist = math.sqrt(dx*dx + dz*dz)
    if zone.shape == "safe-inside" then
        return dist > zone.radius and (dist-zone.radius)*10 + 45 or 0
    end
    if zone.shape == "rectangle" and zone.dir then
        local f = zone.dir
        local forward, across = dx*f.X+dz*f.Z, -dx*f.Z+dz*f.X
        local outsideX = math.abs(forward) - (zone.halfLength or zone.radius)
        local outsideY = math.abs(across) - (zone.halfWidth or 3)
        if outsideX <= 0 and outsideY <= 0 then return 75 end
        return math.max(0, 20-math.max(outsideX, outsideY)*5)
    end
    if zone.shape == "cone" and zone.dir then
        if dist < 1 then return 80 end
        local dot=(dx*zone.dir.X+dz*zone.dir.Z)/dist
        if dot < math.cos(zone.arc or math.rad(55)) then return 0 end
    end
    local margin = zone.radius - dist
    return margin > 0 and 70 + margin*10 or math.max(0, 18 + margin*4)
end
local function flatVector(v)
    if typeof(v) ~= "Vector3" then return nil end
    local h = Vector3.new(v.X, 0, v.Z)
    return h.Magnitude > .001 and h.Unit or nil
end
local function addDanger(list, center, radius, kind, extra)
    if typeof(center) ~= "Vector3" then return end
    local zone={center=center, radius=math.clamp(finite(radius, 8),2,160),kind=kind,shape="circle"}
    if extra then for k,v in pairs(extra) do zone[k]=v end end
    list[#list+1]=zone
end
local function impactTime(value)
    local raw = finite(value, nil)
    if not raw then return nil end
    local serverNow = workspace:GetServerTimeNow()
    -- Some game builds emit match-relative timestamps.
    if raw < 100000000 and serverNow > 100000000 then
        return serverNow + raw - workspace.DistributedGameTime
    end
    return raw
end

-- Keep scheduled warning data that arrives before visible marker objects spawn.
local function registerVolleyFx(packet)
    if type(packet) ~= "table" or packet.kind ~= "volley" then return end
    local now = workspace:GetServerTimeNow()
    local at = impactTime(packet.impactAt or packet.at) or (now + 1)
    if at < now - .12 or at > now + 9 then return end
    local entries = packet.rings or packet.points or packet.marks
    if type(entries) ~= "table" then return end
    for _, entry in ipairs(entries) do
        local pos = typeof(entry) == "Vector3" and entry
            or type(entry) == "table" and (entry.pos or entry.position or entry.center)
        if typeof(pos) == "Vector3" then
            local r = type(entry) == "table" and entry.radius or packet.radius
            local duplicate = false
            for _, old in ipairs(s.eventVolleys) do
                if math.abs(old.at - at) < .2 and horizontal(old.pos, pos) < 1.5 then
                    duplicate = true
                    break
                end
            end
            if not duplicate then
                table.insert(s.eventVolleys, {pos = pos, radius = math.clamp(finite(r, 9), 2, 55), at = at})
                s.dodgeNextHazardRefresh = 0
                s.dodgeNextScan = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end
    end
end
if clientState and type(clientState.onMatchEvent) == "function" then
    local ok, connection = pcall(clientState.onMatchEvent, "challengeFx", registerVolleyFx)
    if ok and connection then table.insert(s.connections, connection) end
end
if remotes then
    local matchEvent = remotes:FindFirstChild("MatchEvent")
    if matchEvent and matchEvent:IsA("RemoteEvent") then
        connect(matchEvent.OnClientEvent, function(packet, data)
            if packet == "challengeFx" and type(data) == "table" then
                registerVolleyFx(data)
            elseif type(packet) == "table" then
                local eventKind = packet.t or packet.event or packet.type or packet.action
                if eventKind == "challengeFx" then
                    registerVolleyFx(packet.payload or packet.data or packet)
                elseif packet.kind == "volley" then
                    registerVolleyFx(packet)
                end
            end
        end)
    end
    local combatFx = remotes:FindFirstChild("CombatFx")
    if combatFx and (combatFx:IsA("RemoteEvent") or combatFx:IsA("UnreliableRemoteEvent")) then
        connect(combatFx.OnClientEvent, function(packet)
            if not s.dodgeEnabled or type(packet) ~= "table" or packet.t ~= "enemyArrow" then return end
            if typeof(packet.o) ~= "Vector3" or typeof(packet.d) ~= "Vector3" then return end
            local dir = Vector3.new(packet.d.X, 0, packet.d.Z)
            if dir.Magnitude < .01 then return end
            local char, hum, root = characterReady()
            if not root then return end
            dir = dir.Unit
            local delta = Vector3.new(root.Position.X - packet.o.X, 0, root.Position.Z - packet.o.Z)
            local along = delta:Dot(dir)
            local side = (delta - dir * along).Magnitude
            if along > 0 and along < 65 and side < 8 then
                local center = packet.o + dir * math.clamp(along, 0, 60)
                table.insert(s.projectileThreats, {pos = center, dir = dir, untilAt = os.clock() + .65})
                s.dodgeNextHazardRefresh = 0
                s.dodgeNextScan = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end)
    end
end
-- A recent hit is a fallback for attacks that expose no detectable warning.
local observedHealthHumanoid, observedHealthConnection, observedHealth = nil, nil, 0
local function bindDamageFallback(char)
    if observedHealthConnection then observedHealthConnection:Disconnect() end
    observedHealthConnection = nil
    observedHealthHumanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not observedHealthHumanoid then return end
    observedHealth = observedHealthHumanoid.Health
    observedHealthConnection = observedHealthHumanoid.HealthChanged:Connect(function(current)
        if s.dodgeEnabled and current > 0 and current < observedHealth then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                s.recentDamagePos = root.Position
                s.recentDamageUntil = os.clock() + .42
                s.dodgeNextScan = 0
                s.dodgeNextHazardRefresh = 0
                s.dodgeLastEventAt = os.clock()
                    s.dodgeLastReactMs = nil
            end
        end
        observedHealth = current
    end)
end
