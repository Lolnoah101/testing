-- V25 SETTINGS | Client-side network recovery and idle handling.
-- A bounded scheduler checks prolonged inactivity proactively, and Roblox's
-- Player.Idled event provides an extra wakeup. The input itself is best-effort;
-- successful API calls do NOT prove Roblox has reset its idle clock.
-- A fully disconnected/crashed client may no longer execute this script.
(function()
    enabled.AutoReconnect = false
    enabled.AntiAFK = false

    local TeleportService = game:GetService("TeleportService")
    local settingsTab = Scheduler.settingsTab or Scheduler.sideTabs.Misc
    local function makeSettingsElement(method, props)
        local ok, result = pcall(function()
            return settingsTab[method](settingsTab, props)
        end)
        if not ok or not result then
            Scheduler.settingsBuildErrors = (Scheduler.settingsBuildErrors or 0) + 1
            warn("[Arise v28] Settings " .. tostring(method)
                .. " failed: " .. tostring(result))
            -- If Settings cannot be created, use the Misc tab as a safe
            -- fallback without moving the Combat controls.
            if settingsTab ~= Scheduler.sideTabs.Misc then
                local fallbackOk, fallback = pcall(function()
                    return Scheduler.sideTabs.Misc[method](Scheduler.sideTabs.Misc, props)
                end)
                if fallbackOk and fallback then return fallback end
                warn("[Arise v28] Misc fallback also failed: " .. tostring(fallback))
            end
            return nil
        end
        return result
    end
    makeSettingsElement("CreateSection", {
        name = Scheduler.settingsTab and "Connection & Idle" or "Settings (under Misc) - Connection & Idle"
    })

    local reconnectText = "Disabled"
    local antiAfkText = "Disabled"
    local reconnectLastAttempt = -math.huge
    local reconnectPending = false
    local antiAfkLastAction = -math.huge
    local antiAfkLastRealInput = os.clock()
    local antiAfkActions = 0
    local antiAfkFailures = 0
    local antiAfkIdleSignals = 0
    local antiAfkSignalsAfterAttempt = 0
    local antiAfkPreferFallback = false
    local antiAfkMethod = "None"
    local antiAfkError = "None"
    local antiAfkSynthUntil = -math.huge
    local UserInputService = game:GetService("UserInputService")

    makeSettingsElement("CreateToggle", {
        name = "Auto Reconnect",
        description = "When a network disconnect prompt is visible, attempt to rejoin this place. Cannot recover if Roblox has completely stopped client scripts.",
        flag = "AS_AutoReconnect", value = false,
        callback = function(value)
            enabled.AutoReconnect = value == true
            reconnectText = enabled.AutoReconnect and "Monitoring for connection errors" or "Disabled"
            if enabled.AutoReconnect then Scheduler.poke("Reconnect") end
            Scheduler.poke("SettingsStatus")
        end,
    })
    makeSettingsElement("CreateToggle", {
        name = "Anti AFK",
        description = "Sends a minimal idle input only when Roblox reports you as idle; no constant clicking or movement.",
        flag = "AS_AntiAFK", value = false,
        callback = function(value)
            enabled.AntiAFK = value == true
            antiAfkLastRealInput = os.clock()
            antiAfkSignalsAfterAttempt = 0
            antiAfkPreferFallback = false
            antiAfkText = enabled.AntiAFK and "Monitoring inactivity (checks every 5s)" or "Disabled"
            if enabled.AntiAFK then Scheduler.poke("AntiAFK") end
            Scheduler.poke("SettingsStatus")
        end,
    })
    local settingsStatus = makeSettingsElement("CreateText", {
        name = "Connection / AFK Status",
        text = "Reconnect: disabled\nAnti AFK: disabled",
    })

    -- Real keyboard/mouse/touch/controller activity postpones synthetic
    -- input. This avoids clicking while the user is actually playing.
    local function recordInput()
        if alive and os.clock() >= antiAfkSynthUntil then
            antiAfkLastRealInput = os.clock()
            antiAfkSignalsAfterAttempt = 0
        end
    end
    Scheduler.track(UserInputService.InputBegan:Connect(recordInput))
    Scheduler.track(UserInputService.InputChanged:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseMovement
            or t == Enum.UserInputType.Touch
            or t == Enum.UserInputType.Gamepad1
            or t == Enum.UserInputType.MouseWheel then
            recordInput()
        end
    end))

    local function sendAntiAfkInput(reason)
        if not alive or not enabled.AntiAFK then return end
        local now = os.clock()
        if now - antiAfkLastAction < 20 then return end
        antiAfkLastAction = now
        -- Do not misclassify our own injected event as a real user input.
        antiAfkSynthUntil = now + 0.8

        local function useVirtualUser()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            local camera = Workspace.CurrentCamera
            local cf = camera and camera.CFrame or CFrame.new()
            -- ClickButton2 is the one-call form of Button2Down/Button2Up.
            vu:ClickButton2(Vector2.new(0, 0), cf)
            return "VirtualUser click"
        end

        local function useAvailableInputFallback()
            -- Some client environments expose their own mouse/keyboard input
            -- APIs. Only use them when already provided; don't require a
            -- plugin-only Roblox service such as VirtualInputManager.
            local move = Globals.mousemoverel or mousemoverel
            if type(move) == "function" then
                move(1, 0)
                task.wait(0.05)
                move(-1, 0)
                return "available mouse input"
            end
            local down = Globals.keypress or keypress
            local up = Globals.keyrelease or keyrelease
            if type(down) == "function" and type(up) == "function" then
                down(0x10) -- SHIFT: brief press/release, without a movement key.
                task.wait(0.05)
                up(0x10)
                return "available keyboard input"
            end
            error("No alternate input method available in this client")
        end

        local ok, methodOrError
        if antiAfkPreferFallback then
            ok, methodOrError = pcall(useAvailableInputFallback)
            if not ok then
                local fallbackError = tostring(methodOrError)
                ok, methodOrError = pcall(useVirtualUser)
                if not ok then methodOrError = fallbackError .. "; " .. tostring(methodOrError) end
            end
        else
            ok, methodOrError = pcall(useVirtualUser)
            if not ok then
                local virtualError = tostring(methodOrError)
                ok, methodOrError = pcall(useAvailableInputFallback)
                if not ok then methodOrError = virtualError .. "; " .. tostring(methodOrError) end
            end
        end

        if ok then
            antiAfkActions += 1
            antiAfkMethod = tostring(methodOrError)
            antiAfkError = "None"
            antiAfkText = string.format("Input attempted: %s (%s)", antiAfkMethod, reason)
        else
            antiAfkFailures += 1
            antiAfkError = tostring(methodOrError):sub(1, 135)
            antiAfkText = "Input unavailable: " .. antiAfkError
            warn("[Arise Anti AFK] " .. antiAfkError)
        end
        Scheduler.poke("SettingsStatus")
    end

    -- Don't depend on Player.Idled firing: an inactive minimized client may
    -- not deliver that signal. Try once per 75s without real user input.
    Scheduler.add("AntiAFK", 5.0, function()
        if not enabled.AntiAFK then return end
        local now = os.clock()
        if now - antiAfkLastRealInput >= 75
            and now - antiAfkLastAction >= 75 then
            sendAntiAfkInput("75s without user input")
        end
    end)

    -- Roblox's error prompt is UI-owned; checking it avoids blindly
    -- teleporting players during normal gameplay, other teleports, or combat.
    local function disconnectPromptMessage()
        local ok, result = pcall(function()
            local coreGui = game:GetService("CoreGui")
            local prompt = coreGui:FindFirstChild("ErrorPrompt", true)
            if not prompt or not prompt:IsA("GuiObject") or not prompt.Visible then
                return nil
            end
            local parts = {}
            for _, child in ipairs(prompt:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextBox"))
                    and child.Text and child.Text ~= "" then
                    table.insert(parts, child.Text)
                end
            end
            return table.concat(parts, " ")
        end)
        return ok and result or nil
    end

    local function isConnectionError(message)
        if type(message) ~= "string" then return false end
        local s = string.lower(message)
        -- Never retry intentional kicks, bans, or moderation decisions.
        for _, blocked in ipairs({"kicked", "banned", "moderation", "suspended", "unauthorized"}) do
            if string.find(s, blocked, 1, true) then return false end
        end
        for _, marker in ipairs({
            "lost connection", "connection lost", "connection timed out",
            "disconnected", "internet connection", "network error",
            "error code: 277", "error code: 279", "error code: 266",
            "server shutdown", "server has shut down",
        }) do
            if string.find(s, marker, 1, true) then return true end
        end
        return false
    end

    Scheduler.add("Reconnect", 2.0, function()
        if not enabled.AutoReconnect or reconnectPending or not alive then return end
        local message = disconnectPromptMessage()
        if not message then
            if os.clock() - reconnectLastAttempt > 30 then
                reconnectText = "Monitoring for connection errors"
            end
            return
        end
        if not isConnectionError(message) then
            reconnectText = "Prompt detected; not a recoverable network disconnect"
            return
        end
        if os.clock() - reconnectLastAttempt < 20 then return end
        reconnectLastAttempt = os.clock()
        reconnectPending = true
        reconnectText = "Network disconnect found; attempting to rejoin"
        Scheduler.poke("SettingsStatus")

        -- TeleportAsync requires a server Script. Teleport is the supported
        -- legacy client method; availability varies by environment.
        local ok, err = pcall(function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end)
        reconnectPending = false
        if not ok then
            reconnectText = "Reconnect request failed: " .. tostring(err):sub(1, 115)
        else
            reconnectText = "Reconnect requested; awaiting Roblox"
        end
        Scheduler.poke("SettingsStatus")
    end)

    Scheduler.track(LocalPlayer.Idled:Connect(function(idleSeconds)
        if not alive or not enabled.AntiAFK then return end
        antiAfkIdleSignals += 1
        -- If Roblox KEEPS reporting idle after our input attempts, the
        -- VirtualUser call may have succeeded without resetting its idle
        -- detector. Prefer an available alternate method next time.
        if os.clock() - antiAfkLastAction <= 70 then
            antiAfkSignalsAfterAttempt += 1
            if antiAfkSignalsAfterAttempt >= 2 then
                antiAfkPreferFallback = true
                antiAfkText = "Still idle after synthetic input; trying alternate method"
            end
        end
        sendAntiAfkInput("Roblox Idled (" .. math.floor(tonumber(idleSeconds) or 0) .. "s)")
        Scheduler.poke("SettingsStatus")
    end))

    Scheduler.track(TeleportService.TeleportInitFailed:Connect(function(player, result, message)
        if player ~= LocalPlayer or not enabled.AutoReconnect then return end
        if os.clock() - reconnectLastAttempt < 45 then
            reconnectText = "Teleport could not start: " .. tostring(message or result):sub(1, 110)
            Scheduler.poke("SettingsStatus")
        end
    end))

    Scheduler.add("SettingsStatus", 2.0, function()
        pcall(function()
            if settingsStatus then settingsStatus:Set(string.format(
                "Engine: %s | Jobs: %d\nAuto Reconnect: %s\nAnti AFK: %s\nInput tries: %d | Errors: %d | Idle signals: %d\nStill idle after attempts: %d | Last method: %s\nLast error: %s",
                Scheduler.initialized and "RUNNING" or "STARTING",
                #Scheduler.jobs, reconnectText, antiAfkText,
                antiAfkActions, antiAfkFailures, antiAfkIdleSignals,
                antiAfkSignalsAfterAttempt, antiAfkMethod, antiAfkError
            )) end
        end)
    end)
end)()


