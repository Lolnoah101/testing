local RECONNECT_MARKER = "TameAnAnimal_V41_Reconnect.enabled"
local RECONNECT_LOADER_FILE = "TameAnAnimal_V41_Reconnect_Loader.lua"

local function lowercase(message)
    return string.lower(tostring(message or ""))
end

local function containsAny(message, phrases)
    for _, term in ipairs(phrases) do
        if string.find(message, term, 1, true) then return true end
    end
    return false
end

local function isBlockedReason(message)
    return containsAny(lowercase(message), {
        "banned", "moderation", "moderated", "kicked by", "you have been kicked",
        "another device", "same account", "error code: 267", "error code 267",
        "error code: 268", "error code 268", "error code: 273", "error code 273",
    })
end

local function isDeadServer(message)
    return containsAny(lowercase(message), {
        "server shut down", "server shutdown", "server has shut down",
        "server is shutting down", "server no longer available", "reserved server",
    })
end

local function isConnectionReason(message)
    local msg = lowercase(message)
    return msg ~= "" and not isBlockedReason(msg) and containsAny(msg, {
        "disconnected", "connection", "error code: 277", "error code 277",
        "error code: 279", "error code 279", "lost connection", "failed to connect",
        "teleport failed", "timed out", "timeout", "please check your internet",
        "server shut down", "server shutdown",
    })
end

local function persistBeforeReconnect()
    saveAllPreferences(true) -- flush both Gen2 config and the backup before reconnect.
end

-- Queued only for an actual reconnect cycle. This is separate from the user's
-- normal Auto Execute switch, and it cannot resurrect after Unload/OFF.
local RECONNECT_TELEPORT_LOADER = [===[
local LOG = "[Tame V46 Reconnect Resume] "
if game.PlaceId ~= 76835646513542 and game.PlaceId ~= 131528475614757 then return end
local E = (type(getgenv) == "function" and getgenv()) or _G
local reader = (type(readfile) == "function" and readfile) or E.readfile
local writer = (type(writefile) == "function" and writefile) or E.writefile
if type(reader) ~= "function" then warn(LOG .. "readfile unavailable"); return end
local ok, marker = pcall(reader, "TameAnAnimal_V41_Reconnect.enabled")
if not ok or marker ~= "1" then return end
if type(writer) == "function" then
    pcall(writer, "TameAnAnimal_V41_Reconnect.enabled", "0")
end
-- Normal Auto Execute takes precedence when both loaders are queued.
local enabledOK, enabled = pcall(reader, "TameAnAnimal_V44.enabled")
if enabledOK and enabled == "1" then return end
if not game:IsLoaded() then game.Loaded:Wait() end
local srcOK, src = pcall(reader, "TameAnAnimal_AutoExecute_Source.lua")
