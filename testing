                        T.stage = GateContested and "Gate contested / waiting for enemies"
                            or "At floor gate vicinity / checking progress"
                        RunCombat2()
                    end
                else
                    T.goal = nil
                    T.stage = "Floor " .. tostring(Floor)
                        .. " gate: no verified ground near gate zone/marker"
                end
                return
