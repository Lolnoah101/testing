local function getCurrentIslandId()
    if not IslandRegionController
        or not IslandRegionController.GetCurrentIslandId then
        return ""
    end

    local ok, islandId = pcall(function()
        return IslandRegionController:GetCurrentIslandId()
    end)

    if ok and type(islandId) == "string" then
        return islandId
    end

    return ""
end

function Systems.isAtIsland(islandId)
    if getCurrentIslandId() == islandId then
        return true
    end

    local root = getCharacterRoot()
    local target = Systems.IslandTeleportCFrames[islandId]

    if not root or not target then
        return false
    end

    return (root.Position - target.Position).Magnitude
        <= math.max(
            40,
            tonumber(Config.TravelArrivalRadius) or 140
        )
end

function Systems.isIslandAvailable(data, islandId)
    local meta = IslandConfig[islandId]

    if not meta then
        return false
    end

    if meta.defaultUnlocked == true then
        return true
    end

    return type(data) == "table"
        and type(data.UnlockedIslands) == "table"
        and data.UnlockedIslands[islandId] == true
end

function Systems.getHighestUnlockedIsland(data)
    local best = nil

    for _, island in ipairs(Systems.IslandDefinitions) do
        if Systems.isIslandAvailable(data, island.id) then
            if not best or island.order > best.order then
                best = island
            end
        end
    end

    return best and best.id or nil
end

function Systems.isTravelSafe()
    if State.TravelBusy
        or State.AutoSellBusy
        or State.RodBusy
        or State.QuestBusy then
        return false
    end

    if not Config.Enabled then
        return true
    end

    return State.Phase == "Idle"
end

function Systems.waitForTravelSafe(timeoutSeconds)
    local deadline = os.clock() + (timeoutSeconds or 8)

    while State.Alive and os.clock() < deadline do
        if Systems.isTravelSafe() then
            return true
        end

        task.wait(0.10)
    end

    return Systems.isTravelSafe()
end

function Systems.getIslandWaterSpawner(islandId)
    if type(islandId) ~= "string" then
        return nil
    end

    local world =
        workspace:FindFirstChild("World")

    local islands =
        world
        and world:FindFirstChild("Islands")

    local island =
        islands
        and islands:FindFirstChild(islandId)

    local spawnPoint =
        island
        and island:FindFirstChild("SpawnPoint")

    local spawners =
        spawnPoint
        and spawnPoint:FindFirstChild("Spawners")

    if not spawners then
        return nil
    end

    -- Use the exact water-side spawner requested by the user.
    local children =
        spawners:GetChildren()

    local waterSpawner =
        children[3]

    if waterSpawner
        and waterSpawner:IsA("BasePart") then
        return waterSpawner
    end

    return nil
end

function Systems.getLoadedBoatMerchantModel(islandId)
    if type(islandId) ~= "string" then
        return nil
    end

    local world =
        workspace:FindFirstChild(
            "World"
        )

    local islands =
        world
        and world:FindFirstChild(
            "Islands"
        )

    local island =
        islands
        and islands:FindFirstChild(
            islandId
        )

    local interactives =
        island
        and island:FindFirstChild(
            "Interactives"
        )

    if not interactives then
        return nil
    end

    local suffix =
        Systems.BoatMerchantSuffix[
            islandId
        ]

    if suffix then
        local exact =
            interactives:FindFirstChild(
                "npc_car_merchant_"
                    .. suffix
            )

        if exact
            and exact:IsA("Model") then

            return exact
        end
    end

    for _, child in ipairs(
        interactives:GetChildren()
    ) do
        if child:IsA("Model") then
            local interactiveId =
                child:GetAttribute(
                    "InteractiveId"
                )

            local childIslandId =
                child:GetAttribute(
                    "IslandId"
                )

            if interactiveId
                    == "npc_car_merchant"
                and (
                    childIslandId == nil
                    or childIslandId
                        == islandId
                ) then

                return child
            end

            if string.find(
                string.lower(
                    child.Name
                ),
                "npc_car_merchant",
                1,
                true
            ) then

                return child
            end
        end
    end

    return nil
end

function Systems.captureLoadedBoatMerchantCFrame(
    islandId
)
    local merchant =
        Systems.getLoadedBoatMerchantModel(
            islandId
        )

    if not merchant then
        return nil
    end

    local ok, pivot =
        pcall(function()
            return merchant:GetPivot()
        end)

    if not ok
        or typeof(pivot) ~= "CFrame" then
        return nil
    end

    Systems.BoatMerchantCFrames[
        islandId
    ] = pivot

    -- Save the newly learned merchant position immediately when local
    -- persistence exists so future sessions can travel directly.
    if Config.AutoSaveLocal
        and Systems.saveLocalAutoSave then

        task.defer(function()
            pcall(
                Systems.saveLocalAutoSave
            )
        end)
    end

    return pivot
end

function Systems.getLoadedClosestBoatMerchantSpawner(
    islandId
)
    local world =
        workspace:FindFirstChild("World")

    local islands =
        world
        and world:FindFirstChild("Islands")

    local island =
        islands
        and islands:FindFirstChild(
            islandId
        )

    local spawnPoint =
        island
        and island:FindFirstChild(
            "SpawnPoint"
        )

    local spawners =
        spawnPoint
        and spawnPoint:FindFirstChild(
            "Spawners"
        )

    if not spawners then
        return nil
    end

    local merchant =
        Systems.getLoadedBoatMerchantModel(
            islandId
        )

    local merchantCFrame = nil

    if merchant then
        local ok, pivot =
            pcall(function()
                return merchant:GetPivot()
            end)

        if ok
            and typeof(pivot) == "CFrame" then

            merchantCFrame = pivot

            Systems.BoatMerchantCFrames[
                islandId
            ] = pivot
        end
    end

    merchantCFrame =
        merchantCFrame
        or Systems.BoatMerchantCFrames[
            islandId
        ]

    if typeof(merchantCFrame)
        ~= "CFrame" then

        return nil
    end

    local bestPart = nil
    local bestDistance =
        math.huge

    local function consider(part)
        if not part:IsA("BasePart") then
            return
        end

        local distance =
            (
                part.Position
                - merchantCFrame.Position
            ).Magnitude

        if distance < bestDistance then
            bestDistance = distance
            bestPart = part
        end
    end

    for _, child in ipairs(
        spawners:GetChildren()
    ) do
        consider(child)
    end

    for _, descendant in ipairs(
        spawners:GetDescendants()
    ) do
        consider(descendant)
    end

    if not bestPart then
        return nil
    end

    local target =
        bestPart.CFrame
        * CFrame.new(
            0,
            3,
            0
        )

    Systems.BoatMerchantSpawnerCFrames[
        islandId
    ] = target

    if Config.AutoSaveLocal
        and Systems.saveLocalAutoSave then

        task.defer(function()
            pcall(
                Systems.saveLocalAutoSave
            )
        end)
    end

    State.TravelLastStatus =
        "Closest spawner: "
        .. bestPart.Name
        .. " • "
        .. string.format(
            "%.1f studs from Boat Merchant",
            bestDistance
        )

    return target
end

function Systems.getClosestBoatMerchantSpawnerCFrame(
    islandId
)
    local live =
        Systems.getLoadedClosestBoatMerchantSpawner(
            islandId
        )

    if live then
        return live
    end

    local cached =
        Systems.BoatMerchantSpawnerCFrames[
            islandId
        ]

    if typeof(cached) == "CFrame" then
        return cached
    end

    return nil
end

function Systems.waitForClosestBoatMerchantSpawner(
    islandId,
    timeoutSeconds
)
    local deadline =
        os.clock()
        + (
            timeoutSeconds
            or 5
        )

    while State.Alive
        and os.clock() < deadline do

        local cf =
            Systems.getClosestBoatMerchantSpawnerCFrame(
                islandId
            )

        if cf then
            return cf
        end

        task.wait(0.10)
    end

    return Systems.getClosestBoatMerchantSpawnerCFrame(
        islandId
    )
end

function Systems.getBoatMerchantTravelCFrame(
    islandId
)
    -- Prefer live data if the destination is already streamed.
    local live =
        Systems.captureLoadedBoatMerchantCFrame(
            islandId
        )

    if not live then
        live =
            Systems.BoatMerchantCFrames[
                islandId
            ]
    end

    if typeof(live) ~= "CFrame" then
        return nil
    end

    -- Stand a few studs in front/behind the NPC instead of overlapping it.
    return live
        * CFrame.new(
            0,
            0,
            6
        )
end

function Systems.waitForBoatMerchantToStream(
