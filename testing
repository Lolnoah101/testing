Systems.StarterBoatMerchantFallback =
    Vector3.new(
        -37.472511291504,
        12.386794090271,
        306.020233154297
    )

function Systems.setBoatKey(keyName, down)
    local keyCode =
        keyName == "W" and Enum.KeyCode.W
        or keyName == "A" and Enum.KeyCode.A
        or keyName == "D" and Enum.KeyCode.D
        or nil

    if not keyCode then
        return
    end

    if State.BoatKeyState[keyName] == down then
        return
    end

    State.BoatKeyState[keyName] = down

    pcall(function()
        VirtualInputManager:SendKeyEvent(
            down,
            keyCode,
            false,
            game
        )
    end)
end

function Systems.releaseBoatControls()
    Systems.setBoatKey("W", false)
    Systems.setBoatKey("A", false)
    Systems.setBoatKey("D", false)
end

function Systems.getCharacterHumanoid()
    local character = LocalPlayer.Character

    return character,
        character
            and character:FindFirstChildOfClass(
                "Humanoid"
            )
            or nil,
        character
            and character:FindFirstChild(
                "HumanoidRootPart"
            )
            or nil
end

function Systems.walkToPosition(
    targetPosition,
    timeoutSeconds
)
    if typeof(targetPosition) ~= "Vector3" then
        return false
    end

    local character, humanoid, root =
        Systems.getCharacterHumanoid()

    if not character
        or not humanoid
        or not root
        or humanoid.Health <= 0 then
        return false
    end

    if (
        root.Position - targetPosition
    ).Magnitude <= 6 then
        return true
    end

    local path =
        PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 5,
        })

    local computed = pcall(function()
        path:ComputeAsync(
            root.Position,
            targetPosition
        )
    end)

    local deadline =
        os.clock()
        + math.max(
            3,
            tonumber(timeoutSeconds) or 25
        )

    local function moveToPoint(
        point,
        jump
    )
        if jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(point)

        while State.Alive
            and os.clock() < deadline do

            if not root.Parent
                or humanoid.Health <= 0 then
                return false
            end

            if (
                root.Position - point
            ).Magnitude <= 4.5 then
                return true
            end

            task.wait(0.08)
        end

        return false
    end

    if computed
        and path.Status
            == Enum.PathStatus.Success then

        for _, waypoint in ipairs(
            path:GetWaypoints()
        ) do
            if not moveToPoint(
                waypoint.Position,
                waypoint.Action
                    == Enum.PathWaypointAction.Jump
            ) then
                break
            end
        end
    else
        moveToPoint(
            targetPosition,
            false
        )
    end

    return root.Parent ~= nil
        and (
            root.Position - targetPosition
        ).Magnitude <= 10
end

function Systems.getStarterBoatMerchantPosition()
    local world = workspace:FindFirstChild("World")
    local islands =
        world and world:FindFirstChild("Islands")

    if islands then
        local merchant =
            islands:FindFirstChild(
                "npc_car_merchant_starter",
                true
            )

        if merchant then
            if merchant:IsA("Model") then
                local part =
                    merchant.PrimaryPart
                    or merchant:FindFirstChild(
                        "HumanoidRootPart",
                        true
                    )
                    or merchant:FindFirstChild(
                        "Head",
                        true
                    )

                if part
                    and part:IsA("BasePart") then
                    return part.Position
                end
            elseif merchant:IsA("BasePart") then
                return merchant.Position
            end
        end
    end

    return Systems.StarterBoatMerchantFallback
end

function Systems.getOwnedBoat()
    local cars =
        workspace:FindFirstChild("Cars")

    if not cars then
        return nil
    end

    local boat =
        cars:FindFirstChild(
            tostring(LocalPlayer.UserId)
        )

    if boat and boat:IsA("Model") then
        local seat =
            boat:FindFirstChild(
                "DSeat",
                true
            )

        local main =
            boat:FindFirstChild(
                "Main",
                true
            )

        if seat
            and seat:IsA("VehicleSeat")
            and main
            and main:IsA("BasePart") then
            return boat, seat, main
        end
    end

    return nil
end

function Systems.spawnFreeProgressionBoat()
    local boat, seat, main =
        Systems.getOwnedBoat()

    if boat then
        return boat, seat, main
    end

    if getCurrentIslandId()
        ~= "island_starter" then

        State.ProgressionNavigationStatus =
            "No boat: return to Starter Island first"
        return nil
    end

    local merchantPosition =
        Systems.getStarterBoatMerchantPosition()

    State.ProgressionNavigationStatus =
        "Walking to Boat Merchant"

    if not Systems.walkToPosition(
        merchantPosition,
        30
    ) then
        State.ProgressionNavigationStatus =
            "Could not reach Boat Merchant"
        return nil
    end

    local _, _, root =
        Systems.getCharacterHumanoid()

    if not root
        or (
            root.Position - merchantPosition
        ).Magnitude > 12 then

        State.ProgressionNavigationStatus =
            "Too far from Boat Merchant"
        return nil
    end

    if os.clock()
        - State.ProgressionBoatLastSpawnAt
        >= 1 then

        State.ProgressionBoatLastSpawnAt =
            os.clock()

        pcall(function()
            SpawnCarPacket:Fire(
                "truck/island_starter"
            )
        end)
    end

    local deadline = os.clock() + 8

    repeat
        boat, seat, main =
            Systems.getOwnedBoat()

        if boat then
            return boat, seat, main
        end

        task.wait(0.10)
    until os.clock() >= deadline

    State.ProgressionNavigationStatus =
        "Free boat did not spawn"
    return nil
end

function Systems.enterProgressionBoat(
    boat,
    seat
)
    local _, humanoid, root =
        Systems.getCharacterHumanoid()

    if not humanoid
        or not root
        or not seat
        or not seat.Parent then
        return false
    end

    if seat.Occupant == humanoid then
        return true
    end

    State.ProgressionNavigationStatus =
        "Walking to free boat"

    Systems.walkToPosition(
        seat.Position,
        20
    )

    if (
        root.Position - seat.Position
    ).Magnitude > 12 then
        State.ProgressionNavigationStatus =
            "Could not reach boat seat"
        return false
    end

    pcall(function()
        seat:Sit(humanoid)
    end)

    local deadline = os.clock() + 5

    while State.Alive
        and os.clock() < deadline do

        if seat.Occupant == humanoid then
            return true
        end

        task.wait(0.08)
    end

    State.ProgressionNavigationStatus =
        "Could not enter free boat"
    return false
end

function Systems.driveBoatTowardIsland(
    islandId,
    boat,
    seat,
    main
)
    local destination =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if not destination then
        return false
    end

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid then
        return false
    end

    local target = destination.Position
    local timeout =
        math.max(
            30,
            tonumber(
                Config.ProgressionBoatTimeout
            ) or 120
        )

    local arrivalRadius =
        math.max(
            90,
            tonumber(
                Config.ProgressionBoatArrivalRadius
            ) or 135
        )

    local deadline = os.clock() + timeout
    local stalledSince = 0
    local previousPosition = main.Position

    State.ProgressionBoatTargetIslandId =
        islandId

    while State.Alive
        and State.ProgressionNavigationBusy
        and os.clock() < deadline do

        if not boat.Parent
            or not seat.Parent
            or not main.Parent then
            break
        end

        if seat.Occupant ~= humanoid then
            State.ProgressionNavigationStatus =
                "Boat seat lost"
            break
        end

        local flatDelta = Vector3.new(
            target.X - main.Position.X,
            0,
            target.Z - main.Position.Z
        )

        local distance =
            flatDelta.Magnitude

        local currentIsland =
            getCurrentIslandId()

        if distance <= arrivalRadius then
            Systems.releaseBoatControls()
            break
        end

        if flatDelta.Magnitude < 0.001 then
            Systems.releaseBoatControls()
            break
        end

        local localDirection =
            main.CFrame:
                VectorToObjectSpace(
                    flatDelta.Unit
                )

        local angle =
            math.atan2(
                localDirection.X,
                -localDirection.Z
            )

        local absAngle =
            math.abs(angle)

        local steerRight =
            angle > 0.10

        local steerLeft =
            angle < -0.10

        -- The game's boat rotates even with zero throttle, so point the
        -- boat first when the destination is far off-axis.
        local driveForward =
            absAngle < 0.70

        Systems.setBoatKey(
            "D",
            steerRight
        )
        Systems.setBoatKey(
            "A",
            steerLeft
        )
        Systems.setBoatKey(
            "W",
            driveForward
        )

        -- Also keep VehicleSeat state aligned with the same normal
        -- steering intent. The game's own Car LocalScript consumes it.
        pcall(function()
            seat.ThrottleFloat =
                driveForward and 1 or 0
            seat.SteerFloat =
                steerRight and 1
                or steerLeft and -1
                or 0
        end)

        State.ProgressionNavigationStatus =
            "Boating to "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )
            .. " ("
            .. tostring(
                math.floor(distance)
            )
            .. " studs)"

        task.wait(0.05)

        local moved =
            (
                Vector3.new(
                    main.Position.X,
                    0,
                    main.Position.Z
                )
                - Vector3.new(
                    previousPosition.X,
                    0,
                    previousPosition.Z
                )
            ).Magnitude

        if driveForward and moved < 0.05 then
            if stalledSince == 0 then
                stalledSince = os.clock()
            end
        else
            stalledSince = 0
        end

        previousPosition = main.Position

        -- If the boat has reached the target island and is pressed
        -- against the shore, stop trying to push farther inland.
        if currentIsland == islandId
            and stalledSince > 0
            and os.clock() - stalledSince > 2 then
            Systems.releaseBoatControls()
            break
        end
    end

    Systems.releaseBoatControls()

    local finalIsland =
        getCurrentIslandId()

    local finalDistance =
        Vector3.new(
            target.X - main.Position.X,
            0,
            target.Z - main.Position.Z
        ).Magnitude

    return finalIsland == islandId
        or finalDistance
            <= arrivalRadius + 75
end

function Systems.leaveBoatAndReachIsland(
    islandId
)
    local character, humanoid =
        Systems.getCharacterHumanoid()

    if not character
        or not humanoid then
        return false
    end

    Systems.releaseBoatControls()

    humanoid.Sit = false
    humanoid.Jump = true

    task.wait(0.50)

    local destination =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if destination then
        State.ProgressionNavigationStatus =
            "Pathfinding onto "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )

        Systems.walkToPosition(
            destination.Position,
            25
        )
    end

    task.wait(0.25)

    return Systems.isAtIsland(islandId)
end

function Systems.progressionNavigateToIsland(
    islandId
)
    if not Config.ProgressionUseFreeBoat then
        return Systems.travelToIsland(
            islandId
        )
    end

    if Systems.isAtIsland(islandId) then
        return true
    end

    if State.ProgressionNavigationBusy then
        return false
    end

    State.ProgressionNavigationBusy = true
    State.ProgressionNavigationStatus =
        "Preparing free boat"
    State.TravelBusy = true

    mouseUp()
    Systems.releaseBoatControls()

    -- Do not send FishCancel here. Progression starts navigation only
    -- after the fishing state is idle, avoiding the backpack/loadout lock.
    State.RodRecoveryHoldUntil =
        os.clock() + 1

    local success = false

    local ok, err = pcall(function()
        local boat, seat, main =
            Systems.spawnFreeProgressionBoat()

        if not boat then
            return
        end

        if not Systems.enterProgressionBoat(
            boat,
            seat
        ) then
            return
        end

        if not Systems.driveBoatTowardIsland(
            islandId,
            boat,
            seat,
            main
        ) then
            return
        end

        success =
            Systems.leaveBoatAndReachIsland(
                islandId
            )
    end)

    Systems.releaseBoatControls()

    State.ProgressionNavigationBusy = false
    State.TravelBusy = false
    State.RodRecoveryHoldUntil =
        os.clock() + 0.75
    State.LastRodWatchCheck = 0
    State.LastCastStarted = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0

    if Config.Mode == "OP" then
        resetOPSession(0.20)
    else
        State.LegitResumeAt =
            os.clock() + 0.35
        State.CurrentFishingState =
            getFishingState()
        State.StateEnteredAt = os.clock()
    end

    if not ok then
        State.ProgressionNavigationStatus =
            "Boat navigation error: "
            .. tostring(err)
        return false
    end

    if success then
        State.ProgressionNavigationStatus =
            "Arrived: "
            .. tostring(
                Systems.IslandIdToName[islandId]
                or islandId
            )
    elseif State.ProgressionNavigationStatus
        == "Preparing free boat" then
        State.ProgressionNavigationStatus =
            "Boat navigation failed"
    end

    return success
end

