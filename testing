PlayerTab:CreateToggle({
    name = "Anti AFK",

    description =
        "Prevents Roblox idle disconnects while enabled",

    flag = "AntiAFK",

    value = false,

    callback = function(Value)
        Settings.AntiAFK =
            Value

        if Settings.AntiAFKConnection then
            pcall(function()
                Settings.AntiAFKConnection:Disconnect()
            end)

            Settings.AntiAFKConnection =
                nil
        end

        local Environment = nil

        if type(getgenv) == "function" then
            local Success, Result =
                pcall(getgenv)

            if Success
                and type(Result) == "table"
            then
                Environment = Result
            end
        end

        if not Environment
            and type(_G) == "table"
        then
            Environment = _G
        end

        if Environment
            and Environment.__GAMEHUB_ANTIAFK_CONNECTION
        then
            pcall(function()
                Environment.__GAMEHUB_ANTIAFK_CONNECTION:Disconnect()
            end)

            Environment.__GAMEHUB_ANTIAFK_CONNECTION =
                nil
        end

        if not Value then
            print("[AntiAFK] Disabled")
            return
        end

        Settings.AntiAFKConnection =
            Player.Idled:Connect(function()
                if not Settings.AntiAFK then
                    return
                end

                local Success, Error =
                    pcall(function()
                        local VirtualUser =
                            game:GetService("VirtualUser")

                        local Camera =
                            Workspace.CurrentCamera

                        local CameraCFrame =
                            Camera
                            and Camera.CFrame
                            or CFrame.new()

                        VirtualUser:CaptureController()

                        VirtualUser:Button2Down(
                            Vector2.new(0, 0),
                            CameraCFrame
                        )

                        task.wait(0.1)

                        VirtualUser:Button2Up(
                            Vector2.new(0, 0),
                            CameraCFrame
                        )
                    end)

                if Success then
                    print(
                        "[AntiAFK] Idle detected - activity sent"
                    )
                else
                    warn(
                        "[AntiAFK] Failed:",
                        Error
                    )
                end
            end)

        if Environment then
            Environment.__GAMEHUB_ANTIAFK_CONNECTION =
                Settings.AntiAFKConnection
        end

        print("[AntiAFK] Enabled")
    end,
})
end

