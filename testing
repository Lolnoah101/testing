--//============================================================
--// AUTO JOIN LOOP
--//============================================================

local LOBBY_ROOM_RETRY =
    1.15


local LOBBY_CREATE_RETRY =
    2.25


if LobbyReady then

    task.spawn(function()

        while SessionAlive() do

            local RequestedMode =
                nil


            if Settings.AutoJoinMap then

                RequestedMode =
                    "Story"


            elseif Settings.AutoJoinEndless then

                RequestedMode =
                    "Infinite"


            elseif Settings.AutoJoinRaid then

                RequestedMode =
                    "Raid"
            end


            if not RequestedMode then

                PendingLobbyMode =
                    nil


                PendingLobbyRoom =
                    nil


            elseif not IsLobbyQueued() then

                PendingLobbyMode =
                    RequestedMode


                local Now =
                    os.clock()


                --================================================
                -- SERVER ALREADY APPROVED A ROOM
                --================================================

                if LobbyOpenRoom then

                    if LastLobbyCreate == 0
                        or (
                            Now
                            - LastLobbyCreate
                        ) >= LOBBY_CREATE_RETRY
                    then

                        CreateLobbyQueue(
                            RequestedMode,
                            LobbyOpenRoom
                        )
                    end


                --================================================
                -- NEED TO ENTER A ROOM FIRST
                --================================================

                elseif (
                    Now
                    - LastLobbyRoomMove
                ) >= LOBBY_ROOM_RETRY
                then

                    local RoomNumber,
                        Room =
                        FindIdleQueueRoom()


                    if RoomNumber
                        and Room
                    then

                        MoveIntoQueueRoom(
                            RoomNumber,
                            Room
                        )

                    else

                        warn(
                            "[Anime Zero] No queue room available."
                        )
                    end
                end
            end


            task.wait(
                0.10
            )
        end
    end)


    print(
        "[Anime Zero] Lobby engine ready."
    )

else

    print(
        "[Anime Zero] Lobby modules not present in this place."
    )
end


