-- v19 called pingSeconds() in Heartbeat without declaring it. This was the
-- repeated "attempt to call a nil value" at line 2715. Cache latency, since
-- polling network stats on every rendered frame is unnecessary.
local cachedPing = 0.075
local nextPingSampleAt = 0
local function pingSeconds()
    local now = os.clock()
    if now >= nextPingSampleAt then
        nextPingSampleAt = now + 0.8
        local ok, value = pcall(function() return LocalPlayer:GetNetworkPing() end)
        if ok and type(value) == "number" and value >= 0 and value < 5 then
            cachedPing = math.clamp(value, 0, 0.35)
        end
    end
    return cachedPing
end

