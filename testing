function Systems.isCharacterSwimming()
    if LocalPlayer:GetAttribute("Swimming") == true then
        return true
    end

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        return false
    end

    return humanoid:GetState()
        == Enum.HumanoidStateType.Swimming
end

function Systems.getIslandDryTravelCFrame(islandId)
    local waterSpawner =
        Systems.getIslandWaterSpawner(
            islandId
        )

    if not waterSpawner then
        return nil,
            "Water-side spawner [3] missing"
    end

    local world =
        workspace:FindFirstChild("World")

    local islands =
        world
        and world:FindFirstChild("Islands")

    local island =
        islands
        and islands:FindFirstChild(
            islandId
        )

    if not island then
        return nil,
            "Island model unavailable"
    end

    local waterY =
        waterSpawner.Position.Y

    pcall(function()
        local resolved =
            Catalog.Island.GetWaterY(
                islandId
            )

        if type(resolved) == "number" then
            waterY = resolved
        end
    end)

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Include

    params.FilterDescendantsInstances = {
        island,
    }

    params.IgnoreWater = true

    local reference =
        waterSpawner.Position

    local bestFrame = nil
    local bestScore =
        math.huge

    local radii = {
        0,
        5,
        9,
        13,
        17,
        21,
        26,
        32,
        38,
        45,
        52,
        60,
    }

    for _, radius in ipairs(radii) do
        local steps =
            radius == 0
            and 1
            or 24

        for step = 0, steps - 1 do
            local angle =
                steps == 1
                and 0
                or math.rad(
                    step
                    * (
                        360 / steps
                    )
                )

            local x =
                reference.X
                + math.cos(angle)
                    * radius

            local z =
                reference.Z
                + math.sin(angle)
                    * radius

            local rayOrigin =
                Vector3.new(
                    x,
                    math.max(
                        reference.Y,
                        waterY
                    ) + 140,
                    z
                )

            local result =
                workspace:Raycast(
                    rayOrigin,
                    Vector3.new(
                        0,
                        -320,
                        0
                    ),
                    params
                )

            if result
                and result.Instance
                and result.Normal.Y >= 0.35
                and result.Position.Y
                    >= waterY + 1.25 then

                local standPosition =
                    result.Position
                    + Vector3.new(
                        0,
                        3.25,
                        0
                    )

                local score =
                    (
                        Vector3.new(
                            standPosition.X,
                            0,
                            standPosition.Z
                        )
                        - Vector3.new(
                            reference.X,
                            0,
                            reference.Z
                        )
                    ).Magnitude

                score +=
                    math.max(
                        0,
                        result.Position.Y
                            - waterY
                    ) * 0.05

                if score < bestScore then
                    bestScore = score

                    bestFrame =
                        CFrame.lookAt(
                            standPosition,
                            Vector3.new(
                                reference.X,
                                standPosition.Y,
                                reference.Z
                            )
                        )
                end
            end
        end

        if bestFrame
            and radius >= 17 then
            break
        end
    end

    if bestFrame then
        return bestFrame,
            "Nearest dry land by water spawner"
    end

    local fallback =
        Systems.IslandTeleportCFrames[
            islandId
        ]

    if fallback then
        return fallback
            * CFrame.new(0, 3, 0),
            "Island spawn fallback"
    end

    return nil,
        "No dry island destination found"
end

function Systems.getNearestIslandIdToPosition(position)
    if typeof(position) ~= "Vector3" then
        return nil
    end

    local nearestId = nil
    local nearestDistance =
        math.huge

    for _, island in ipairs(
        Systems.IslandDefinitions
    ) do
        local spawner =
            Systems.getIslandWaterSpawner(
                island.id
            )

        local fallback =
            Systems.IslandTeleportCFrames[
                island.id
            ]

        local point =
            spawner
            and spawner.Position
            or (
                fallback
                and fallback.Position
            )

        if point then
            local distance =
                (
                    position - point
                ).Magnitude

            if distance
                < nearestDistance then

                nearestDistance =
                    distance

                nearestId =
                    island.id
            end
        end
    end

    return nearestId
end

function Systems.recoverLegitToNearbyLand()
    if State.LegitLandRecoveryBusy then
        return false
    end

    if not Systems.isCharacterSwimming() then
        return true
    end

    local root =
        getCharacterRoot()

    if not root then
        State.LegitBlockReason =
            "Swimming; character root unavailable"
        return false
    end

    local islandId =
        getCurrentIslandId()

    if islandId == "" then
        islandId =
            Systems.getNearestIslandIdToPosition(
                root.Position
            )
    end

    if not islandId then
        State.LegitBlockReason =
            "Swimming; nearby island not found"

        State.LegitLandRecoveryAt =
            os.clock() + 1

        return false
    end

    local target,
        source =
        Systems.getIslandDryTravelCFrame(
            islandId
        )

    if not target then
        State.LegitBlockReason =
            tostring(
                source
                or "Dry land not found"
            )

        State.LegitLandRecoveryAt =
            os.clock() + 1

        return false
    end

    State.LegitLandRecoveryBusy =
        true

    State.LegitLandRecoveryAttempts += 1

    State.LegitBlockReason =
        "Recovering to "
        .. tostring(source)

    mouseUp()

    local previousTravelBusy =
        State.TravelBusy

    State.TravelBusy = true

    local moved =
        tweenCharacterTo(
            target,
            35
        )

    State.TravelBusy =
        previousTravelBusy

    if moved then
        local deadline =
            os.clock() + 1.25

        while State.Alive
            and os.clock() < deadline
            and Systems.isCharacterSwimming() do

            task.wait(0.05)
        end
    end

    local recovered =
        moved == true
        and not Systems.isCharacterSwimming()

    if recovered then
        State.LegitLandRecoverySuccesses += 1
        State.LegitBlockReason =
            "Back on dry land"

        State.LegitResumeAt =
            os.clock() + 0.20

        State.LastCastStarted = 0
        State.LastPrimaryClick = 0
        State.LastRodWatchCheck = 0

        local humanoid =
            LocalPlayer.Character
            and LocalPlayer.Character:
                FindFirstChildOfClass(
                    "Humanoid"
                )

        if humanoid then
            pcall(function()
                humanoid:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end)
        end
    else
        State.LegitBlockReason =
            "Could not leave swimming state"
    end

    State.LegitLandRecoveryBusy =
        false

    State.LegitLandRecoveryAt =
        os.clock()
        + (
            recovered
            and 0.25
            or 1.25
        )

    return recovered
end

function Systems.travelToIsland(islandId)
    if State.TravelBusy then
        return false
    end

    if type(islandId) ~= "string"
        or not IslandConfig[islandId] then

        State.TravelLastStatus =
            "Invalid island"

        return false
    end

    local data =
        getPlayerData()

    if not Systems.isIslandAvailable(
        data,
        islandId
    ) then

        State.TravelLastStatus =
            "Locked: "
            .. tostring(
                Systems.IslandIdToName[
                    islandId
                ]
                or islandId
            )

        return false
    end

    local targetCFrame =
        Systems.getClosestBoatMerchantSpawnerCFrame(
            islandId
        )

    local root =
        getCharacterRoot()

    if root
        and targetCFrame
        and (
            root.Position
            - targetCFrame.Position
        ).Magnitude <= 14 then

        State.TravelLastIsland =
            islandId

        State.TravelLastStatus =
            "Already at closest Boat Merchant spawner: "
            .. tostring(
                Systems.IslandIdToName[
                    islandId
                ]
                or islandId
            )

        return true
    end

    State.TravelLastStatus =
        "Waiting for fishing to become idle"

    if not Systems.waitForTravelSafe(10) then
        State.TravelLastStatus =
            "Travel cancelled: fishing stayed busy"

        return false
    end

    root =
        root
        or getCharacterRoot()

    if not root then
        State.TravelLastStatus =
            "Character unavailable"

        return false
    end

    State.TravelBusy = true
    State.TravelAttempts += 1

    mouseUp()

    State.RodRecoveryHoldUntil =
        os.clock() + 0.50

    if Config.Mode == "OP" then
        resetOPSession(0.20)
    else
        State.LegitResumeAt =
            os.clock() + 0.30
    end

    Config.MovementType = "Tween"
    Config.TravelTweenSpeed = 35

    -- If the island is streamed out and we have never cached its closest
    -- merchant spawner, use the permanent island position only to stream
    -- the island. Then resolve SpawnPoint.Spawners and choose the BasePart
    -- nearest to the Boat Merchant.
    if not targetCFrame then
        local streamTarget =
            Systems.IslandTeleportCFrames[
                islandId
            ]

        if not streamTarget then
            State.TravelBusy = false
            State.TravelLastStatus =
                "No static island stream point"
            return false
        end

        State.TravelLastStatus =
            "Streaming "
            .. tostring(
                Systems.IslandIdToName[
                    islandId
                ]
                or islandId
            )
            .. " at 35 studs/s"

        local streamed,
            streamError =
            tweenCharacterTo(
                streamTarget,
                35
            )

        if not streamed then
            State.TravelBusy = false
            State.TravelLastStatus =
                "Island stream Tween failed: "
                .. tostring(
                    streamError
                    or "cancelled"
                )
            return false
        end

        State.TravelLastStatus =
            "Finding closest spawner to Boat Merchant"

        Systems.captureLoadedBoatMerchantCFrame(
            islandId
        )

        targetCFrame =
            Systems.waitForClosestBoatMerchantSpawner(
                islandId,
                5
            )

        if not targetCFrame then
            State.TravelBusy = false
            State.TravelLastStatus =
                "Closest Boat Merchant spawner did not load"
            return false
        end
    end

    State.TravelLastStatus =
        "Tweening to closest Boat Merchant spawner on "
        .. tostring(
            Systems.IslandIdToName[
                islandId
            ]
            or islandId
        )
        .. " at 35 studs/s"

    local moved, moveError =
        tweenCharacterTo(
            targetCFrame,
            35
        )

    if not moved then
        State.TravelBusy = false
        State.TravelLastStatus =
            "Spawner Tween failed: "
            .. tostring(
                moveError
                or "cancelled"
            )
        return false
    end

    Systems.getLoadedClosestBoatMerchantSpawner(
        islandId
    )

    local regionDeadline =
        os.clock() + 1.50

    while State.Alive
        and os.clock() < regionDeadline
        and not Systems.isAtIsland(
            islandId
        ) do

        task.wait(0.05)
    end

    local refreshedRoot =
        getCharacterRoot()

    if refreshedRoot then
        refreshedRoot.AssemblyLinearVelocity =
            Vector3.zero
        refreshedRoot.AssemblyAngularVelocity =
            Vector3.zero
    end

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0
    State.LastRodWatchCheck = 0
    State.RodRecoveryHoldUntil =
        os.clock() + 0.50

    if Config.Mode == "OP" then
        resetOPSession(0.15)
    else
        State.LegitResumeAt =
            os.clock() + 0.18
        State.CurrentFishingState =
            getFishingState()
        State.StateEnteredAt =
            os.clock()
    end

    State.TravelSuccesses += 1
    State.TravelLastIsland =
        islandId

    State.TravelLastStatus =
        "Arrived at closest Boat Merchant spawner: "
        .. tostring(
            Systems.IslandIdToName[
                islandId
            ]
            or islandId
        )

    State.TravelBusy = false

    if Config.AutoLookAtWater then
        State.AutoLookForceCheck = true
        State.AutoLookLastWatchAt = 0
        State.AutoLookLastIslandId =
            islandId

        State.WaterLookStatus =
            "Rechecking water after island travel"

        task.delay(0.15, function()
            if State.Alive
                and Config.AutoLookAtWater
                and not State.TravelBusy then

                pcall(
                    stepAutoLookWatcher,
                    true
                )
            end
        end)
    end

    return true
end

function Systems.travelToHighestUnlockedIsland()
    local data = getPlayerData()
    local islandId = Systems.getHighestUnlockedIsland(data)

    if not islandId then
        State.TravelLastStatus = "No unlocked island found"
        return false
    end

    Config.SelectedIslandId = islandId
    return Systems.travelToIsland(islandId)
end

function Systems.stepTravelAutomation()
    -- Quest/progression farming owns the destination while a quest target exists.
    if (
        Config.AutoAllQuests
        or Config.AutoProgression
        or Config.AutoQuestManager
    )
        and Config.AutoQuestConfigure
        and State.QuestTargetIslandId then
        return
    end

    if not Config.AutoTravelSelectedIsland
        or State.TravelBusy
        or State.AutoSellBusy then
        return
    end

    local now = os.clock()

    if now - State.LastTravelAutomationCheck
        < math.max(
            0.50,
            tonumber(Config.TravelAutomationCheckInterval) or 1.5
        ) then
        return
    end

    State.LastTravelAutomationCheck = now

    local target = Config.SelectedIslandId

    if not target or target == "" then
        return
    end

    if Systems.isAtIsland(target) then
        return
    end

    if not Systems.isTravelSafe() then
        return
    end

    Systems.travelToIsland(target)
end

