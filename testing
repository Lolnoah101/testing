-- ================================================================
-- MISC / PLAYER: game-native quest claiming and card auto-selling
-- The game's QuestModule uses CompleteDailyQuest for BOTH daily and
-- weekly objectives; the card auto-sell UI uses ChangeSetting and six
-- Setting_AutoSell* bool flags. No guessed inventory deletion remote.
-- ================================================================
local CARD_SELL_RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }
local cardSellLastSent = {}
local questAttemptAfter = {}

local function statDisplay()
    return ReplicatedStorage:FindFirstChild(player.Name .. "StatDisplay")
end

local function claimReadyQuests()
    if not (S.alive and S.autoClaimQuests and statsReady() and inLobby()) then return end
    local settings = getSettings()
    local display = statDisplay()
    if not (settings and display and mainFunction) then return end
    for _, group in ipairs({settings.DailyQuestSettings, settings.WeeklyQuestSettings}) do
        if type(group) == "table" then
            for _, quest in pairs(group) do
                if not (S.alive and S.autoClaimQuests and inLobby()) then return end
                if type(quest) == "table" and type(quest.stat) == "string"
                    and type(quest.completionStat) == "string" then
                    local progress = display:FindFirstChild(quest.stat)
                    local claimed = display:FindFirstChild(quest.completionStat)
                    local required = tonumber(quest.AmountNeeded)
                    local amount = progress and tonumber(progress.Value)
                    if progress and claimed and required and amount
                        and amount >= required and claimed.Value == false then
                        local now = os.clock()
                        if now >= (questAttemptAfter[quest.stat] or 0) then
                            -- A failed request is delayed so unavailable quests
                            -- do not repeatedly hit the server every frame.
                            questAttemptAfter[quest.stat] = now + 12
                            local ok, response = pcall(function()
                                return mainFunction:InvokeServer("CompleteDailyQuest", quest.stat)
                            end)
                            if ok and type(response) == "table" and response.status == "Success" then
                                questAttemptAfter[quest.stat] = now + 3
                            elseif not ok then
                                warnOnce("Auto Claim Quests: " .. tostring(response))
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Weekly Speed Raid rewards: the native SpeedRaidModule uses the
-- LocalStatsModule stats WeeklyShadowRaidsCleared and SpeedRaid_Weekly1..9.
-- Only an unlocked, explicitly unclaimed reward is eligible. The native
-- RewardClaim click sends MainRemoteFunction:InvokeServer(
--     "ClaimWeeklySpeedRaidReward", rewardIndex).
-- Use the same action and current SettingsModule reward table: no guessed
-- remote names, fake rewards, or automatic raid entry.
local speedWeeklyRewardRetryAt = {}
local function claimReadyWeeklySpeedRaidRewards()
    if not (S.alive and S.autoClaimSpeedRaidWeekly and statsReady()
        and regularLobby()) then return end
    local settings = getSettings()
    local rewards = settings and settings.SpeedRaidWeeklyRewards
    if type(rewards) ~= "table" then return end
    local clears = tonumber(stat("WeeklyShadowRaidsCleared"))
    if not clears then return end -- player data hasn't replicated yet
    local now = os.clock()
    for index, reward in ipairs(rewards) do
        if not (S.alive and S.autoClaimSpeedRaidWeekly and regularLobby()) then return end
        if type(reward) == "table" and type(reward.statName) == "string" then
            local required = tonumber(reward.clearsNeeded)
            local claimed = stat(reward.statName)
            if required and clears >= required and claimed == false
                and now >= (speedWeeklyRewardRetryAt[index] or 0) then
                -- A retry backoff prevents repeated network requests when
                -- Roblox has not yet replicated the claimed BoolValue.
                speedWeeklyRewardRetryAt[index] = now + 20
                local response, reason = invokeRoom("ClaimWeeklySpeedRaidReward", index)
                if response and response.status ~= "Fail" then
                    -- Wait for the game's replicated claimed flag before
                    -- considering this milestone eligible again.
                    speedWeeklyRewardRetryAt[index] = now + 30
                elseif reason then
                    warnOnce("Speed Raid weekly reward claim: " .. tostring(reason))
                end
            end
        end
    end
end

-- The game's own UI has these six BoolValue flags, each controlled by
-- MainRemoteEvent:FireServer("ChangeSetting", "Setting_AutoSell"..rarity, bool).
-- Never restore earlier native settings: they could include unselected rarities.
local function nativeCardSellSettings()
    if not (statsReady() and remote) then return nil, false end
    local display = statDisplay()
    if not display then return nil, false end
    local flags, complete, found = {}, true, false
    for _, rarity in ipairs(CARD_SELL_RARITIES) do
        local flag = display:FindFirstChild("Setting_AutoSell" .. rarity)
        if flag and flag:IsA("BoolValue") then
            flags[rarity] = flag
            found = true
        else
            complete = false
        end
    end
    return found and flags or nil, complete
end

local function hasChosenCardRarity()
    if type(S.cardSellRarities) ~= "table" then return false end
    for _, rarity in ipairs(CARD_SELL_RARITIES) do
        if S.cardSellRarities[rarity] == true then return true end
    end
    return false
end

local function applyNativeCardSell(force)
    if not S.alive then return false end
    local flags, complete = nativeCardSellSettings()
    if not flags then return false end

    -- This toggle fully owns the game's native auto-sell configuration.
    -- ON: only selected rarities are enabled (others explicitly OFF).
    -- OFF: every native card auto-sell setting is OFF, avoiding surprises.
    -- Fail closed when a rarity stat has not loaded: disable available flags
    -- until all six can be reconciled, rather than accidentally leaving an
    -- unselected rarity enabled.
    local enabled = complete and S.autoSellCards and hasChosenCardRarity()
    local allAligned = complete
    for _, rarity in ipairs(CARD_SELL_RARITIES) do
        local desired = enabled and S.cardSellRarities[rarity] == true or false
        local flag = flags[rarity]
        if flag and flag.Value ~= desired then
            allAligned = false
            local name = "Setting_AutoSell" .. rarity
            local now = os.clock()
            if force or now - (cardSellLastSent[name] or -math.huge) >= 1.5 then
                cardSellLastSent[name] = now
                local ok, err = pcall(function()
                    remote:FireServer("ChangeSetting", name, desired)
                end)
                if not ok then warnOnce("Auto Sell Cards: " .. tostring(err)) end
            end
        end
    end
    return allAligned
end

-- These are deliberately lightweight periodic workers, not per-Heartbeat
-- remote calls. Completed quests are claimed and native settings reconciled
-- when the game's replicated player data is ready.
task.spawn(function()
    while S.alive do
        if S.autoClaimQuests and inLobby() then
            local ok, err = pcall(claimReadyQuests)
            if not ok then warnOnce("Quest worker: " .. tostring(err)) end
        end
        task.wait(0.65)
    end
end)
task.spawn(function()
    while S.alive do
        if S.autoClaimSpeedRaidWeekly and regularLobby() then
            local ok, err = pcall(claimReadyWeeklySpeedRaidRewards)
            if not ok then warnOnce("Speed Raid weekly claim worker: " .. tostring(err)) end
        end
        task.wait(1.8)
    end
end)
task.spawn(function()
    while S.alive do
        -- Reconcile OFF as well as ON. In particular, disable any stale native
        -- rarity flags left active by v32, the game UI, or a previous session.
        local ok, err = pcall(applyNativeCardSell)
        if not ok then warnOnce("Card sell worker: " .. tostring(err)) end
        task.wait(0.9)
    end
end)

function S.Unload(manual)
    if not S.alive then return end
    if manual == true then S.autoExecute = false end
    -- Strict mode: leaving the script must not reactivate unselected rarities.
    S.autoSellCards = false
    pcall(applyNativeCardSell, true)
    savePreferences()
    S.alive = false
    S.autoFarm, S.autoAttack, S.autoSkills, S.autoDodge = false, false, false, false
    resetTarget()
    releaseMovement()
    clearHazardTracking()
    clearMonsterIndex()
    for _, connection in ipairs(S.connections) do
        pcall(function() connection:Disconnect() end)
    end
    if S.oasis then pcall(function() S.oasis:Unload() end) end
    if env.HollowMoonAnimeDimensions == S then env.HollowMoonAnimeDimensions = nil end
end

