-- Floor samples are restricted to arena geometry whenever that model exists.
-- This prevents airborne NPCs, crates and temporary FX from becoming our Y reference.
local function surfaceAt(x, z, startingY)
    local arena = workspace:FindFirstChild("Arena")
    local params = RaycastParams.new()
    params.FilterType = arena and Enum.RaycastFilterType.Include or Enum.RaycastFilterType.Exclude
    if arena then
        params.FilterDescendantsInstances = {arena}
    else
        local omit = {player.Character}
        local enemies = workspace:FindFirstChild("ActiveEnemies")
        if enemies then table.insert(omit, enemies) end
        if s.platform then table.insert(omit, s.platform) end
        if s.focus then table.insert(omit, s.focus) end
        params.FilterDescendantsInstances = omit
    end
    params.IgnoreWater = true
    pcall(function() params.RespectCanCollide = true end)
    local ray = workspace:Raycast(Vector3.new(x, startingY, z), Vector3.new(0, -220, 0), params)
    if ray and ray.Normal.Y > 0.72 then return ray end
    return nil
end
local function calibrateFloor(root)
    local hit = surfaceAt(root.Position.X, root.Position.Z, root.Position.Y + 14)
    if hit then return hit.Position.Y end
    -- The fallback is approximate; prefer a real raycast floor in the arena.
    return root.Position.Y - 3
end
