-- V16: Shared, persistent noclip for all scripted farm and travel motion.
-- Tween/Teleport farming must cross solid dungeon geometry in ABOVE,
-- BELOW and BEHIND, not only in Below. The original collision values are
-- restored when travel ends; repeated Roblox animation/physics changes are
-- overridden each frame before physics by RunService.Stepped.
-- We change CanCollide only: CanTouch remains enabled for game triggers.
-- The existing Below platform is only visual (CanCollide = false).
local belowPlatform = nil
-- One top-level local keeps this large script under Luau's active-local limit.
local MovementNoclip = (function()
    local reasons = {} -- farm/chest/exit -> current character
    local currentCharacter = nil
    local originalCollision = setmetatable({}, { __mode = "k" })
    local api = {}

    local function restore()
        for part, original in pairs(originalCollision) do
            if part and part.Parent then
                pcall(function() part.CanCollide = original end)
            end
            originalCollision[part] = nil
        end
        currentCharacter = nil
    end

    local function enforce()
        local character = LocalPlayer.Character
        local active = false
        for reason, owner in pairs(reasons) do
            if not alive or owner ~= character or not character then
                reasons[reason] = nil
            else
                active = true
            end
        end
        if not active or not character then
            if currentCharacter then restore() end
            return
        end
        if currentCharacter ~= character then
            restore()
            currentCharacter = character
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                -- Remember true and false distinctly, even if another
                -- character script changes CanCollide during a tween.
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end
                if part.CanCollide then part.CanCollide = false end
            end
        end
    end

    function api.set(reason, character, active)
        if active and alive and character and character == LocalPlayer.Character then
            reasons[reason] = character
        else
            reasons[reason] = nil
        end
        -- Apply before CFrame changes, then enforce every physics step.
        enforce()
    end

    function api.clear()
        for reason in pairs(reasons) do reasons[reason] = nil end
        restore()
    end

    table.insert(connections, RunService.Stepped:Connect(function()
        if alive then enforce() else api.clear() end
    end))
    return api
end)()
