function Systems.getBossRegionIslandId(regionPart)
    if not regionPart then
        return nil
    end

    local current =
        regionPart

    while current
        and current ~= workspace do

        if type(current.Name) == "string"
            and IslandConfig[current.Name] then

            return current.Name
        end

        current = current.Parent
    end

    return nil
end

function Systems.getFreeBoatCarId()
    local bestId = nil
    local bestPrice = math.huge

    for _, entry in ipairs(
        Catalog.Car.GetAll()
    ) do
        local price =
            tonumber(entry.price) or 0

        if price <= 0
            and price < bestPrice then

            bestPrice = price
            bestId = entry.id
        end
    end

    return bestId or "truck"
end

function Systems.getBossBoatMerchantTarget(islandId)
    local target =
        Systems.getClosestBoatMerchantSpawnerCFrame(
            islandId
        )

    if target then
        return target
    end

    local merchant =
        Systems.getBoatMerchantTravelCFrame(
            islandId
        )

    if merchant then
        return merchant
    end

    return Systems.IslandTeleportCFrames[
        islandId
    ]
end

function Systems.spawnFreeBossBoat(islandId)
    if type(islandId) ~= "string"
        or islandId == "" then

        State.BossBoatStage =
            "Boss island unavailable"

        return nil
    end

    local existingBoat,
        existingSeat,
        existingMain,
        existingPrompt =
        Systems.getOwnedBoat()

    -- Reuse the boat only when it is already reasonably close to the
    -- correct island's merchant area.
    local merchantTarget =
        Systems.getBossBoatMerchantTarget(
            islandId
        )

    if existingBoat
        and merchantTarget
        and (
            existingMain.Position
            - merchantTarget.Position
        ).Magnitude <= 220 then

        State.BossBoatStage =
            "Using existing free boat"

        return existingBoat,
            existingSeat,
            existingMain,
            existingPrompt
    end

    State.BossOwnedMovement = true
    State.BossBoatStage =
        "Going to Boat Merchant"

    Systems.stopCurrentCycle()

    if merchantTarget then
        local root =
            getCharacterRoot()

        if root
            and (
                root.Position
                - merchantTarget.Position
            ).Magnitude > 12 then

            local moved =
                tweenCharacterTo(
                    merchantTarget,
                    35
                )

            if not moved then
                State.BossOwnedMovement =
                    false

                State.BossBoatStage =
                    "Boat Merchant tween failed"

                return nil
            end
        end
    end

    State.BossBoatStage =
        "Spawning free boat"

    local freeCarId =
        Systems.getFreeBoatCarId()

    if os.clock()
        - State.BossBoatLastSpawnAt
        >= 0.60 then

        State.BossBoatLastSpawnAt =
            os.clock()

        pcall(function()
            SpawnCarPacket:Fire(
                tostring(freeCarId)
                .. "/"
                .. tostring(islandId)
            )
        end)
    end

    local deadline =
        os.clock()
        + math.max(
            3,
            tonumber(
                Config.BossBoatSpawnTimeout
            ) or 8
        )

    local boat, seat, main, prompt

    repeat
        boat, seat, main, prompt =
            Systems.getOwnedBoat()

        if boat
            and main
            and main.Parent then

            State.BossBoatStage =
                "Free boat spawned"

            State.BossOwnedMovement =
                false

            return boat,
                seat,
                main,
                prompt
        end

        task.wait(0.08)
    until os.clock() >= deadline

    State.BossOwnedMovement = false
    State.BossBoatStage =
        "Free boat did not spawn"

    return nil
end

function Systems.enterBossBoat(
    boat,
    seat,
    prompt
)
    if not boat
        or not boat.Parent
        or not seat
        or not seat.Parent then

        State.BossBoatStage =
            "Boat unavailable"

        return false
    end

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid then
        State.BossBoatStage =
            "Character unavailable"

        return false
    end

    if seat.Occupant == humanoid then
        State.BossBoatStage =
            "Seated in boat"

        return true
    end

    State.BossBoatStage =
        "Entering boat with prompt"

    local entered =
        Systems.enterProgressionBoat(
            boat,
            seat,
            prompt
        )

    if entered then
        State.BossBoatStage =
            "Seated in free boat"
        return true
    end

    -- Normal Seat:Sit is only a last recovery path if the prompt failed.
    pcall(function()
        seat:Sit(humanoid)
    end)

    local deadline =
        os.clock()
        + math.max(
            1.5,
            tonumber(
                Config.BossBoatSeatTimeout
            ) or 4
        )

    while State.Alive
        and os.clock() < deadline do

        if seat.Occupant == humanoid then
            State.BossBoatStage =
                "Seated in free boat"
            return true
        end

        task.wait(0.05)
    end

    State.BossBoatStage =
        "Could not enter boat"

    return false
end

function Systems.getBossBoatTargetCFrame(
    regionPart,
    main
)
    if not regionPart
        or not main then

        return nil
    end

    local center =
        regionPart.Position

    local flatAway =
        Vector3.new(
            main.Position.X - center.X,
            0,
            main.Position.Z - center.Z
        )

    if flatAway.Magnitude < 0.1 then
        local root =
            getCharacterRoot()

        if root then
            flatAway =
                Vector3.new(
                    root.Position.X - center.X,
                    0,
                    root.Position.Z - center.Z
                )
        end
    end

    if flatAway.Magnitude < 0.1 then
        flatAway =
            Vector3.new(
                0,
                0,
                1
            )
    end

    local standDistance =
        math.clamp(
            tonumber(
                Config.BossBoatStandDistance
            ) or 42,
            FishingConfig.Cast.BaitMinDist + 5,
            FishingConfig.Cast.BaitMaxDist - 5
        )

    local targetPosition =
        Vector3.new(
            center.X,
            main.Position.Y,
            center.Z
        )
        + flatAway.Unit
            * standDistance

    return CFrame.lookAt(
        targetPosition,
        Vector3.new(
            center.X,
            targetPosition.Y,
            center.Z
        )
    )
end

function Systems.tweenBoatToCFrame(
    targetMainCFrame,
    boat,
    seat,
    main,
    statusText
)
    if not targetMainCFrame
        or not boat
        or not boat.Parent
        or not seat
        or not seat.Parent
        or not main
        or not main.Parent then

        return false
    end

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid
        or seat.Occupant ~= humanoid then

        State.BossBoatStage =
            "Must be seated before boat tween"

        return false
    end

    State.BossOwnedMovement = true
    State.BossBoatAttempts += 1

    Systems.releaseBoatControls()

    local startPivot =
        boat:GetPivot()

    local mainRelative =
        startPivot:ToObjectSpace(
            main.CFrame
        )

    local targetPivot =
        targetMainCFrame
        * mainRelative:Inverse()

    local distance =
        (
            main.Position
            - targetMainCFrame.Position
        ).Magnitude

    local speed =
        math.clamp(
            tonumber(
                Config.BossBoatTweenSpeed
            ) or 35,
            8,
            35
        )

    local duration =
        math.max(
            0.15,
            distance / speed
        )

    State.BossBoatStage =
        tostring(
            statusText
            or "Tweening boat"
        )
        .. " • "
        .. tostring(
            math.floor(distance)
        )
        .. " studs"

    -- Temporarily disable the normal water-position constraints while our
    -- smooth PivotTo tween owns the boat. They are restored immediately.
    local alignPosition =
        main:FindFirstChild(
            "AlignPosition"
        )

    local alignOrientation =
        main:FindFirstChild(
            "AlignOrientation"
        )

    local oldPositionEnabled =
        alignPosition
        and alignPosition:IsA(
            "AlignPosition"
        )
        and alignPosition.Enabled
        or nil

    local oldOrientationEnabled =
        alignOrientation
        and alignOrientation:IsA(
            "AlignOrientation"
        )
        and alignOrientation.Enabled
        or nil

    if oldPositionEnabled ~= nil then
        alignPosition.Enabled = false
    end

    if oldOrientationEnabled ~= nil then
        alignOrientation.Enabled = false
    end

    local driver =
        Instance.new(
            "CFrameValue"
        )

    driver.Value =
        startPivot

    local changedConnection =
        driver:GetPropertyChangedSignal(
            "Value"
        ):Connect(function()
            if boat.Parent
                and main.Parent then

                boat:PivotTo(
                    driver.Value
                )
            end
        end)

    local tween =
        TweenService:Create(
            driver,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                Value =
                    targetPivot,
            }
        )

    local completedState = nil

    local completedConnection =
        tween.Completed:Connect(
            function(playbackState)
                completedState =
                    playbackState
            end
        )

    tween:Play()

    local deadline =
        os.clock()
        + duration
        + 1.25

    while State.Alive
        and os.clock() < deadline
        and completedState == nil do

        if not boat.Parent
            or not main.Parent
            or seat.Occupant ~= humanoid then

            break
        end

        task.wait(0.04)
    end

    if tween.PlaybackState
        == Enum.PlaybackState.Playing then

        tween:Cancel()
    end

    if changedConnection then
        changedConnection:
            Disconnect()
    end

    if completedConnection then
        completedConnection:
            Disconnect()
    end

    driver:Destroy()

    if oldPositionEnabled ~= nil
        and alignPosition
        and alignPosition.Parent then

        alignPosition.Enabled =
            oldPositionEnabled
    end

    if oldOrientationEnabled ~= nil
        and alignOrientation
        and alignOrientation.Parent then

        alignOrientation.Enabled =
            oldOrientationEnabled
    end

    State.BossOwnedMovement =
        false

    if completedState
        ~= Enum.PlaybackState.Completed then

        State.BossBoatStage =
            "Boat tween interrupted"

        return false
    end

    task.wait(0.20)

    if not boat.Parent
        or not main.Parent then

        State.BossBoatStage =
            "Boat disappeared after tween"

        return false
    end

    local finalDistance =
        (
            main.Position
            - targetMainCFrame.Position
        ).Magnitude

    if finalDistance > 18 then
        State.BossBoatStage =
            "Boat position was corrected"

        return false
    end

    State.BossBoatStage =
        "Boat arrived"

    return true
end

function Systems.exitBoatForBoss(
    boat,
    seat,
    main,
    regionPart
)
    local _, humanoid, root =
        Systems.getCharacterHumanoid()

    if not humanoid
        or not root
        or not boat
        or not main then

        return false
    end

    Systems.releaseBoatControls()

    State.BossBoatStage =
        "Jumping out onto boat"

    humanoid.Sit = false
    humanoid.Jump = true

    pcall(function()
        humanoid:ChangeState(
            Enum.HumanoidStateType.Jumping
        )
    end)

    local deadline =
        os.clock() + 1.25

    while State.Alive
        and os.clock() < deadline
        and seat
        and seat.Parent
        and seat.Occupant == humanoid do

        task.wait(0.04)
    end

    local deckPosition =
        main.Position
        + Vector3.new(
            0,
            math.max(
                3.25,
                main.Size.Y / 2
                    + 2.5
            ),
            0
        )

    local lookTarget =
        regionPart
        and Vector3.new(
            regionPart.Position.X,
            deckPosition.Y,
            regionPart.Position.Z
        )
        or (
            deckPosition
            + main.CFrame.LookVector
        )

    root.CFrame =
        CFrame.lookAt(
            deckPosition,
            lookTarget
        )

    root.AssemblyLinearVelocity =
        Vector3.zero

    root.AssemblyAngularVelocity =
        Vector3.zero

    task.wait(0.12)

    if regionPart then
        local horizontalDistance =
            (
                Vector3.new(
                    root.Position.X,
                    0,
                    root.Position.Z
                )
                - Vector3.new(
                    regionPart.Position.X,
                    0,
                    regionPart.Position.Z
                )
            ).Magnitude

        if horizontalDistance
                < FishingConfig.Cast.BaitMinDist - 3
            or horizontalDistance
                > FishingConfig.Cast.BaitMaxDist + 5 then

            State.BossBoatStage =
                "Boat stopped outside boss cast range"

            return false
        end
    end

    Systems.restoreStandingPromptState()

    State.BossBoatStage =
        "Standing on boat"

    return true
end

function Systems.moveToBossRegionByBoat(
    regionPart,
    regionId
)
    if State.BossBusy
        or State.AutoSellBusy then

        return false
    end

    local islandId =
        Systems.getBossRegionIslandId(
            regionPart
        )
        or getCurrentIslandId()

    if not islandId
        or islandId == "" then

        State.BossLastStatus =
            "Could not resolve Boss island"

        return false
    end

    State.BossBusy = true
    State.BossUsingBoat = true
    State.BossBoatIslandId =
        islandId

    State.BossBoatStage =
        "Preparing free boat"

    Systems.stopCurrentCycle()

    local boat, seat, main, prompt =
        Systems.spawnFreeBossBoat(
            islandId
        )

    if not boat then
        State.BossBusy = false
        State.BossUsingBoat = false
        State.BossLastStatus =
            State.BossBoatStage

        return false
    end

    if not Systems.enterBossBoat(
        boat,
        seat,
        prompt
    ) then

        State.BossBusy = false
        State.BossUsingBoat = false
        State.BossLastStatus =
            State.BossBoatStage

        return false
    end

    local target =
        Systems.getBossBoatTargetCFrame(
            regionPart,
            main
        )

    if not target then
        State.BossBusy = false
        State.BossUsingBoat = false
        State.BossLastStatus =
            "Could not calculate Boss boat target"

        return false
    end

    State.BossBoatTargetCFrame =
        target

    local moved =
        Systems.tweenBoatToCFrame(
            target,
            boat,
            seat,
            main,
            "Tweening free boat to BossRegion"
        )

    if not moved then
        State.BossBusy = false
        State.BossUsingBoat = false
        State.BossLastStatus =
            State.BossBoatStage

        return false
    end

    if not Systems.exitBoatForBoss(
        boat,
        seat,
        main,
        regionPart
    ) then

        State.BossBusy = false
        State.BossUsingBoat = false
        State.BossLastStatus =
            State.BossBoatStage

        return false
    end

    State.BossBoatModel =
        boat

    State.BossBoatSeat =
        seat

    State.BossBoatMain =
        main

    State.BossTargetPosition =
        regionPart.Position

    State.BossRegionId =
        tostring(
            regionId or ""
        )

    local regionInfo =
        State.BossRegionId ~= ""
        and Catalog.BossRegion.GetById(
            State.BossRegionId
        )
        or nil

    State.BossRegionName =
        regionInfo
        and tostring(
            regionInfo.name or ""
        )
        or State.BossRegionId

    State.BossArrivals += 1
    State.BossBoatArrivals += 1

    State.LastCastStarted = 0
    State.NextCastAt = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0

    if Config.Mode == "OP" then
        resetOPSession(0.15)
    end

    State.BossBoatStage =
        "OP fishing from boat"

    State.BossLastStatus =
        "OP farming "
        .. tostring(
            State.BossName
        )
        .. " from free boat"

    State.BossBusy = false

    return true
end

function Systems.returnFromBossBoat(
    savedIslandId,
    savedCFrame
)
    local boat =
        State.BossBoatModel

    local seat =
        State.BossBoatSeat

    local main =
        State.BossBoatMain

    if not boat
        or not boat.Parent
        or not seat
        or not seat.Parent
        or not main
        or not main.Parent then

        return false
    end

    State.BossBoatStage =
        "Returning from Boss"

    local _, humanoid =
        Systems.getCharacterHumanoid()

    if not humanoid then
        return false
    end

    if seat.Occupant ~= humanoid then
        local prompt =
            seat:FindFirstChild(
                "ProximityPrompt",
                true
            )

        if not Systems.enterBossBoat(
            boat,
            seat,
            prompt
        ) then

            return false
        end
    end

    local returnTarget = nil

    if savedIslandId
        and savedIslandId ~= "" then

        returnTarget =
            Systems.getBossBoatMerchantTarget(
                savedIslandId
            )
    end

    if not returnTarget
        and savedCFrame then

        returnTarget =
            CFrame.new(
                savedCFrame.Position.X,
                main.Position.Y,
                savedCFrame.Position.Z
            )
    end

    if not returnTarget then
        return false
    end

    local targetMain =
        CFrame.lookAt(
            Vector3.new(
                returnTarget.Position.X,
                main.Position.Y,
                returnTarget.Position.Z
            ),
            Vector3.new(
                returnTarget.Position.X,
                main.Position.Y,
                returnTarget.Position.Z
            )
            + main.CFrame.LookVector
        )

    local moved =
        Systems.tweenBoatToCFrame(
            targetMain,
            boat,
            seat,
            main,
            "Returning boat to previous island"
        )

    if not moved then
        return false
    end

    Systems.exitBoatForBoss(
        boat,
        seat,
        main,
        nil
    )

    State.BossBoatReturns += 1

    if savedCFrame then
        State.BossOwnedMovement =
            true

        tweenCharacterTo(
            savedCFrame,
            35
        )

        State.BossOwnedMovement =
            false
    end

    return true
end

function Systems.getBossStandCFrame(regionPart)
    if not regionPart
        or not regionPart:IsA("BasePart") then

        return nil,
            "Boss region unavailable"
    end

    local world =
        workspace:FindFirstChild("World")

    local islands =
        world
        and world:FindFirstChild("Islands")

    if not islands then
        return nil,
            "Island geometry unavailable"
    end

    local root =
        getCharacterRoot()

    local center =
        regionPart.Position

    local waterY =
        getWaterY()

    local castMin =
        FishingConfig.Cast.BaitMinDist + 3

    local castMax =
        FishingConfig.Cast.BaitMaxDist - 3

    local rayParams =
        RaycastParams.new()

    rayParams.FilterType =
        Enum.RaycastFilterType.Exclude

    local excluded = {}

    if LocalPlayer.Character then
        table.insert(
            excluded,
            LocalPlayer.Character
        )
    end

    local cars =
        workspace:FindFirstChild("Cars")

    if cars then
        table.insert(excluded, cars)
    end

    for _, bossPart in ipairs(
        CollectionService:GetTagged(
            RegionConfig.BossTag
        )
    ) do
        table.insert(
            excluded,
            bossPart
        )
    end

    rayParams.FilterDescendantsInstances =
        excluded

    rayParams.IgnoreWater =
        true

    local startAngle = 0

    if root then
        local delta =
            Vector3.new(
                root.Position.X
                    - center.X,
                0,
                root.Position.Z
                    - center.Z
            )

        if delta.Magnitude > 0.1 then
            startAngle =
                math.atan2(
                    delta.Z,
                    delta.X
                )
        end
    end

    local bestCFrame = nil
    local bestScore =
        math.huge

    local radii = {
        castMin,
        castMin + 4,
        castMin + 8,
        castMin + 12,
        castMin + 16,
        castMax,
    }

    for _, radius in ipairs(
        radii
    ) do
        for step = 0, 23 do
            local angle =
                startAngle
                + math.rad(
                    step * 15
                )

            local x =
                center.X
                + math.cos(angle)
                    * radius

            local z =
                center.Z
                + math.sin(angle)
                    * radius

            local rayTop =
                math.max(
                    center.Y,
                    root
                        and root.Position.Y
                        or center.Y,
                    waterY
                )
                + 180

            local result =
                workspace:Raycast(
                    Vector3.new(
                        x,
                        rayTop,
                        z
                    ),
                    Vector3.new(
                        0,
                        -420,
                        0
                    ),
                    rayParams
                )

            if result
                and result.Instance
                and result.Instance:
                    IsDescendantOf(
                        islands
                    )
                and result.Normal.Y
                    >= 0.30 then

                local standPosition =
                    result.Position
                    + Vector3.new(
                        0,
                        3.25,
                        0
                    )

                local bossDistance =
                    Vector3.new(
                        standPosition.X
                            - center.X,
                        0,
                        standPosition.Z
                            - center.Z
                    ).Magnitude

                if bossDistance
                        >= castMin - 1
                    and bossDistance
                        <= castMax + 1 then

                    local playerDistance =
                        root
                        and (
                            root.Position
                            - standPosition
                        ).Magnitude
                        or 0

                    -- Prefer the closest legal land to the boss, then
                    -- whichever of those points is closest to the player.
                    local score =
                        bossDistance
                            * 1000
                        + playerDistance

                    if score < bestScore then
                        bestScore =
                            score

                        bestCFrame =
                            CFrame.lookAt(
                                standPosition,
                                Vector3.new(
                                    center.X,
                                    standPosition.Y,
                                    center.Z
                                )
                            )
                    end
                end
            end
        end
    end

    if bestCFrame then
        return bestCFrame,
            "Closest land"
    end

    -- Fallback: try each island's requested water-side spawner if it is
    -- already within boss fishing range.
    for _, island in ipairs(
        Systems.IslandDefinitions
    ) do
        local spawner =
            Systems.getIslandWaterSpawner(
                island.id
            )

        if spawner then
            local position =
                spawner.Position
                + Vector3.new(
                    0,
                    3,
                    0
                )

            local bossDistance =
                Vector3.new(
                    position.X - center.X,
                    0,
                    position.Z - center.Z
                ).Magnitude

            if bossDistance
                    >= castMin - 2
                and bossDistance
                    <= castMax + 4 then

                return CFrame.lookAt(
                    position,
                    Vector3.new(
                        center.X,
                        position.Y,
                        center.Z
                    )
                ),
                "Water-side island spawner"
            end
        end
    end

    return nil,
        "No land found inside boss cast range"
end

function Systems.moveToBossRegion(regionPart, regionId)
    if State.BossBusy or State.TravelBusy or State.AutoSellBusy then
        return false
    end

    local target, targetSource =
        Systems.getBossStandCFrame(
            regionPart
        )

    if not target then
        if Config.BossUseFreeBoatFallback then
            State.BossLastStatus =
                "No land in cast range; switching to free boat"

            return Systems.moveToBossRegionByBoat(
                regionPart,
                regionId
            )
        end

        State.BossLastStatus =
            tostring(
                targetSource
                or "No safe boss land found"
            )

        return false
    end

    State.BossBusy = true
    State.BossUsingBoat = false
    State.BossBoatStage = "Using nearby land"
    State.BossAttempts += 1
    Systems.stopCurrentCycle()

    Config.BossRegionTweenSpeed = 35

    State.BossOwnedMovement = true

    local moved =
        tweenCharacterTo(
            target,
            35
        )

    State.BossOwnedMovement = false
    State.BossBusy = false

    if not moved then
        State.BossLastStatus = "Boss tween failed"
        return false
    end

    State.BossTargetPosition = regionPart.Position
    State.BossRegionId = tostring(regionId or "")

    local regionInfo =
        State.BossRegionId ~= ""
        and Catalog.BossRegion.GetById(State.BossRegionId)
        or nil

    State.BossRegionName =
        regionInfo and tostring(regionInfo.name or "")
        or State.BossRegionId

    State.BossArrivals += 1
    State.LastCastStarted = 0
    State.NextCastAt = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0

    if Config.Mode == "OP" then
        resetOPSession(0.15)
    end

    State.BossLastStatus =
        "Ready on "
        .. tostring(
            targetSource
            or "land"
        )
        .. " near "
        .. tostring(
            State.BossRegionName ~= ""
            and State.BossRegionName
            or "Boss Region"
        )

    return true
end

function Systems.beginBossSession(weatherId, bossId)
    if State.BossSessionActive
        and State.BossId == bossId then
        return
    end

    State.BossResumeOwner =
        State.CoordinatorOwner

    State.BossSessionActive = true
    State.BossPreemptRequested = true
    State.BossWeatherId = weatherId
    State.BossId = bossId
    State.BossName = Systems.BossIdToName[bossId] or bossId
    State.BossSavedCFrame =
        getCharacterRoot()
        and getCharacterRoot().CFrame
        or nil
    State.BossPreviousMode = "OP"
    State.BossFishingWasEnabled = Config.Enabled
    State.BossAutoEnabledFishing = false
    State.BossSavedIslandId =
        getCurrentIslandId()
        or ""

    State.BossUsingBoat = false
    State.BossBoatStage = "Idle"
    State.BossBoatIslandId = ""
    State.BossBoatModel = nil
    State.BossBoatSeat = nil
    State.BossBoatMain = nil
    State.BossBoatTargetCFrame = nil

    if Config.BossAutoEnableFishing
        and not Config.Enabled
        and not State.FullAutoManualDisabled then

        State.BossAutoEnabledFishing =
            true

        Systems.setEnabled(
            true,
            "boss"
        )
    end
end

function Systems.endBossSession(reason)
    if not State.BossSessionActive then
        return
    end

    local saved = State.BossSavedCFrame
    local previousMode = State.BossPreviousMode
    local wasEnabled = State.BossFishingWasEnabled
    local resumeOwner = State.BossResumeOwner

    State.BossSessionActive = false
    State.BossPreemptRequested = false
    State.BossTargetPosition = nil
    State.BossId = ""
    State.BossName = ""
    State.BossRegionId = ""
    State.BossRegionName = ""
    State.BossLastStatus = reason or "Boss event ended"

    local usedBoat =
        State.BossUsingBoat == true

    local savedIslandId =
        State.BossSavedIslandId

    if Config.BossReturnAfterEvent
        and saved then

        if usedBoat then
            State.BossLastStatus =
                "Boss ended; returning by boat"

            local returned =
                Systems.returnFromBossBoat(
                    savedIslandId,
                    saved
                )

            if not returned
                and (
                    resumeOwner == "Quest"
                    or resumeOwner == "Fishing"
                    or resumeOwner == "Idle"
                    or resumeOwner == "Rod"
                    or resumeOwner == "Progression"
                ) then

                State.BossOwnedMovement =
                    true

                tweenCharacterTo(
                    saved,
                    35
                )

                State.BossOwnedMovement =
                    false
            end

        elseif (
            resumeOwner == "Quest"
            or resumeOwner == "Fishing"
            or resumeOwner == "Idle"
            or resumeOwner == "Rod"
        ) then

            State.BossOwnedMovement =
                true

            tweenCharacterTo(
                saved,
                35
            )

            State.BossOwnedMovement =
                false
        end
    end

    local bossOnlyEnabledFishing =
        State.BossAutoEnabledFishing == true
        and not wasEnabled

    local taskStillNeedsFishing =
        Systems.hasPostBossTaskIntent()

    if bossOnlyEnabledFishing
        and Config.Enabled
        and not State.FullAutoUserIntent
        and not taskStillNeedsFishing then

        Systems.setEnabled(
            false,
            "boss restore"
        )
    end

    State.BossSavedCFrame = nil
    State.BossPreviousMode = nil
    State.BossResumeOwner = "Idle"
    State.BossAutoEnabledFishing = false
    State.BossUsingBoat = false
    State.BossBoatStage = "Idle"
    State.BossBoatIslandId = ""
    State.BossBoatModel = nil
    State.BossBoatSeat = nil
    State.BossBoatMain = nil
    State.BossBoatTargetCFrame = nil
    State.BossOwnedMovement = false
    State.BossSavedIslandId = ""
    State.CoordinatorForceRecheck = true

    -- The coordinator now resumes whichever still-enabled toggle has
    -- the highest priority. No task toggle is changed here.
end

function Systems.stepBossWeatherAutomation()
    if not Config.AutoBossFarm then
        if State.BossSessionActive then
            Systems.endBossSession("Auto Boss Farm disabled")
        end

        return false
    end

    local now = os.clock()

    if now - State.BossLastCheck < 0.25 then
        return State.BossSessionActive
    end

    State.BossLastCheck = now

    local weatherId, bossId = Systems.getActiveBossWeather()

    if not weatherId or not bossId then
        if State.BossSessionActive then
            Systems.endBossSession("Boss weather ended")
        else
            State.BossLastStatus = "Waiting for boss weather"
        end

        return false
    end

    if Config.BossesToFarm[bossId] ~= true then
        State.BossLastStatus =
            "Skipped " .. tostring(Systems.BossIdToName[bossId] or bossId)
        return false
    end

    Systems.beginBossSession(weatherId, bossId)

    local sellData =
        getPlayerData()

    if Systems.isAutoSellWorkPending(
        sellData
    ) then
        State.BossLastStatus =
            "Inventory full; waiting for Auto Sell"

        if State.BossUsingBoat then
            State.BossBoatStage =
                "Paused for Auto Sell"
        end

        return true
    end

    local regionPart, regionId = Systems.getActiveBossRegionPart()

    if not regionPart then
        State.BossLastStatus =
            "Boss weather active; waiting for active BossRegion"
        return true
    end

    State.BossTargetPosition = regionPart.Position

    local root = getCharacterRoot()
    local horizontalDistance = math.huge

    if root then
        horizontalDistance =
            (
                Vector3.new(root.Position.X, 0, root.Position.Z)
                - Vector3.new(
                    regionPart.Position.X,
                    0,
                    regionPart.Position.Z
                )
            ).Magnitude
    end

    if horizontalDistance < FishingConfig.Cast.BaitMinDist - 3
        or horizontalDistance > FishingConfig.Cast.BaitMaxDist + 8 then
        Systems.moveToBossRegion(regionPart, regionId)
        return true
    end

    State.BossRegionId = tostring(regionId or "")

    if State.BossUsingBoat then
        State.BossBoatStage =
            "OP fishing from boat"

        State.BossLastStatus =
            string.format(
                "OP farming %s from free boat (%.0f studs)",
                tostring(State.BossName),
                horizontalDistance
            )
    else
        State.BossLastStatus =
            string.format(
                "OP farming %s from nearby land (%.0f studs)",
                tostring(State.BossName),
                horizontalDistance
            )
    end

    return true
end

