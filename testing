function Systems.getRodSkinScore(entry)
    if type(entry) ~= "table"
        or type(entry.catalogId) ~= "string" then
        return -math.huge
    end

    local skin = Catalog.RodSkin.GetById(entry.catalogId)

    if not skin then
        return -math.huge
    end

    local score =
        (Systems.RarityRank[skin.rarity] or 0) * 100000

    for _, mod in ipairs(skin.statBonuses or {}) do
        local stat = tostring(mod.stat or "")
        local value = tonumber(mod.value) or 0

        if stat == "luck" then
            score += value * 500
        elseif stat == "skillDamagePct" then
            score += value * 50000
        elseif stat == "attackDamagePct" then
            score += value * 45000
        elseif stat == "critChance" then
            score += value * 35000
        elseif stat == "critDamage" then
            score += value * 25000
        elseif stat == "sellValuePct" then
            score += value * 20000
        elseif stat == "masteryXpPct" then
            score += value * 15000
        elseif stat == "fishRecoverableHpReductionPct" then
            score += math.abs(value) * 20000
        elseif stat == "runSpeedPct" then
            score += value * 1000
        end
    end

    return score
end

function Systems.getBestRodSkinKey(data)
