-- The Tween itself is still the ONLY thing that moves the player in Tween mode.
-- These values filter the desired position, not the player's CFrame/velocity.
local function resetTweenGoalFilter()
    Farm.smoothedGoalPosition = nil
    Farm.smoothedGoalTarget = nil
    Farm.smoothedGoalUpdatedAt = 0
end

local function smoothTweenGoal(titan, desired)
    local now = os.clock()
    if Farm.smoothedGoalTarget ~= titan or not Farm.smoothedGoalPosition then
        -- Switching Titans should begin toward the new target immediately.
        Farm.smoothedGoalTarget = titan
        Farm.smoothedGoalPosition = desired.Position
    else
        local elapsed = math.clamp(now - Farm.smoothedGoalUpdatedAt, 0, 0.5)
        local alpha = 1 - math.exp(-elapsed / TWEEN_GOAL_SMOOTH_TIME)
        Farm.smoothedGoalPosition = Farm.smoothedGoalPosition:Lerp(desired.Position, alpha)
    end
    Farm.smoothedGoalUpdatedAt = now
    local forward = desired.LookVector
    local position = Farm.smoothedGoalPosition
    return CFrame.lookAt(position, position + forward)
end

local function getPlayerRoot()
    local character = LocalPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root then
        return nil
    end
    return root
end

-- Experimental combat freeze: pause travel and anchor the character only
-- from the start of a Kill Aura swing through its remote registration.
-- No extra force/position changes are made while the attack is in progress.
-- This may be rejected by games that validate anchored character state.
local function releaseSwingFreeze()
    local root = Farm.frozenRoot
    local pausedTween = Farm.tweenPausedForSwing
    Farm.tweenPausedForSwing = nil
    if not root then return end
    local previouslyAnchored = Farm.frozenWasAnchored
    Farm.frozenRoot = nil
    Farm.frozenWasAnchored = nil
    if root.Parent and not previouslyAnchored then
        pcall(function()
            root.Anchored = false
            -- One-time reset only; no per-frame root movement or velocity writes.
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    -- Continue the SAME Tween from the point where it was paused. This avoids
    -- creating a brand-new Tween from rest after every 0.75-second attack.
    if pausedTween and pausedTween == Farm.activeTween
        and root.Parent and Farm.running and Farm.method == "Tween"
        and not Farm.unloaded
        and pausedTween.PlaybackState == Enum.PlaybackState.Paused then
        pcall(function() pausedTween:Play() end)
    end
end

local function updateSwingFreeze()
    local shouldFreeze = Farm.freezeDuringSwing
        and Farm.running
        and Farm.auraEnabled
        and Farm.attacking
        and Farm.method == "Tween"
        and not Farm.unloaded
    if not shouldFreeze then
        releaseSwingFreeze()
        return
    end
    local root = getPlayerRoot()
    if not root then
        releaseSwingFreeze()
        return
    end
    if Farm.frozenRoot == root then return end
    releaseSwingFreeze()
    -- Don't overwrite an existing anchor set by another game system.
    if root.Anchored then return end

    -- Pausing (instead of canceling) retains interpolation progress and goal.
    -- We can safely hold the character still during the existing damage window
    -- without a new Tween starting from scratch every time the swing finishes.
    local current = Farm.activeTween
    if current and current.PlaybackState == Enum.PlaybackState.Playing then
        local paused = pcall(function() current:Pause() end)
        Farm.tweenPausedForSwing = paused and current or nil
    else
        Farm.tweenPausedForSwing = nil
    end
    Farm.frozenRoot = root
    Farm.frozenWasAnchored = root.Anchored
    root.Anchored = true
end

local function getNape(model)
    if not model or not model:IsA("Model") or not model.Parent then
        return nil
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return nil
    end
    local hitboxes = model:FindFirstChild("Hitboxes")
    local hits = hitboxes and hitboxes:FindFirstChild("Hit")
    local nape = hits and hits:FindFirstChild("Nape")
    if nape and nape:IsA("BasePart") then
        return nape
    end
    return nil
end

-- v109: On phones a raid Titan's visual rig can replicate before its
-- dedicated Nape hitbox. This anchor is for NAVIGATION ONLY. Slash/hit
-- registration still requires getNape(), never this fallback part.
function Farm:GetNavigationAnchor(model)
    if not model or not model:IsA("Model") or not model.Parent then return nil end
    if model == LocalPlayer.Character or Players:GetPlayerFromCharacter(model) then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local primary = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local fake = model:FindFirstChild("Fake")
    local head = (fake and fake:FindFirstChild("Head")) or model:FindFirstChild("Head")
    local part = primary or head
    return (part and part:IsA("BasePart")) and part or nil
end

-- v105: Raid maps sometimes place NPC models one or more folders below
-- Workspace.Titans, whereas ordinary Missions use direct children. Cache
-- discovery briefly instead of repeatedly walking large trees on Heartbeat.
-- Only accept models with a living Humanoid and the same Nape hitbox contract.
function Farm:GetFarmTargetModels()
    local now = os.clock()
    -- On low-end/mobile clients, avoid expensive repeated Workspace tree scans
    -- while raid rigs are still streaming. A cached scan still refreshes when ready.
    local interval = self.targetModelCache and #self.targetModelCache > 0 and 0.45 or 0.9
    if self.targetModelCache and now - (self.targetModelScannedAt or 0) < interval then
        return self.targetModelCache
    end
    local found, seen = {}, {}
    local navigation, navSeen = {}, {}
    local function add(model)
        if not model or not model:IsA("Model") then return end
        if not navSeen[model] and Farm:GetNavigationAnchor(model) then
            navSeen[model] = true
            navigation[#navigation + 1] = model
        end
        if not seen[model] and getNape(model) then
            seen[model] = true
            found[#found + 1] = model
        end
    end
    local function scan(container)
        if not container then return end
        add(container)
        for _, child in ipairs(container:GetChildren()) do
            add(child)
            if not (child:IsA("Model") and getNape(child)) then
                -- A raid NPC can be grouped beneath a container Model/Folder.
                for _, nested in ipairs(child:GetDescendants()) do
                    if nested:IsA("Model") then add(nested) end
                end
            end
        end
    end
    local primary = Workspace:FindFirstChild("Titans")
    if primary then scan(primary) end
    if #found == 0 then
        local nested = Workspace:FindFirstChild("Titans", true)
        if nested and nested ~= primary then scan(nested) end
    end
    if #found == 0 then
        for _, containerName in ipairs({"Enemies", "Bosses", "Mobs", "NPCs", "Raid"}) do
            local container = Workspace:FindFirstChild(containerName, true)
            if container then scan(container) end
            if #found > 0 then break end
        end
    end
    self.targetModelCache = found
    self.navigationCandidateModels = navigation
    self.targetModelScannedAt = now
    self.targetModelSource = #found > 0
        and (primary and "Titans / raid nested" or "nested raid targets")
        or (primary and "no valid napes in Titans" or "no raid Titan container")
    return found
end

-- Used only when a moving raid boss is visible but its Nape has not
-- replicated yet. Enables movement to acquire the boss without sending any hits.
function Farm:GetClosestNavigationTarget(fromPosition)
    self:GetFarmTargetModels()
    local nearest, anchor, minDistance = nil, nil, math.huge
    for _, model in ipairs(self.navigationCandidateModels or {}) do
        local part = Farm:GetNavigationAnchor(model)
        if part then
            local distance = (part.Position - fromPosition).Magnitude
            if distance < minDistance then
                nearest, anchor, minDistance = model, part, distance
            end
        end
    end
    return nearest, anchor
end

-- The match start fallback is based on the first replicated, living Titan,
-- not when Delta loads the script or Rayfield creates the interface. Cached
-- GetFarmTargetModels means this does not re-scan the whole map every frame.
Farm.clockHasActiveTarget = function()
    return #Farm:GetFarmTargetModels() > 0
end

-- Keep ONE living Titan completely protected BEFORE it becomes the last one.
-- Waiting until the count reaches 1 is too late: an aura swing may hit both of
-- the final two Titans in the same registration batch.
local function getLivingTitans()
    local alive = {}
    for _, model in ipairs(Farm:GetFarmTargetModels()) do
        if getNape(model) then alive[#alive + 1] = model end
    end
    return alive
end

local function getReservedLastTitan()
    if not Farm.lastTitanEnabled then
        Farm.lastTitanReserved = nil
        return nil
    end
    local elapsed = getMatchElapsed()
    if elapsed >= Farm.lastTitanAtSeconds then
        Farm.lastTitanReserved = nil
        return nil
    end
    local alive = getLivingTitans()
    if #alive == 0 then
        Farm.lastTitanReserved = nil
        return nil
    end
    for _, model in ipairs(alive) do
        if model == Farm.lastTitanReserved then return model end
    end
    -- Choose the farthest living Titan as the reserved one to avoid
    -- accidentally prioritizing it in normal Auto Farm movement.
    local root = getPlayerRoot()
    local from = root and root.Position or Vector3.zero
    local chosen, maxDistance = nil, -math.huge
    for _, model in ipairs(alive) do
        local nape = getNape(model)
        local distance = nape and (nape.Position - from).Magnitude or 0
        if distance > maxDistance then
            chosen, maxDistance = model, distance
        end
    end
    Farm.lastTitanReserved = chosen
    return chosen
end

-- Keep the protected final Titan alive without freezing the game's character.
-- The actual airborne position controller is created below, where the normal
-- movement cleanup functions have been defined. It uses AlignPosition instead
-- of root.Anchored, and is removed the moment the timed hold ends.
local function releaseLastTitanWaitFreeze()
    local align = Farm.lastTitanAirAlign
    local attachment = Farm.lastTitanAirAttachment
    Farm.lastTitanAirAlign = nil
    Farm.lastTitanAirAttachment = nil
    Farm.lastTitanAirRoot = nil
    Farm.lastTitanAirPosition = nil
    Farm.lastTitanAirOrbitStartedAt = nil
    Farm.waitingFreezeActive = false
    Farm.waitingFreezeRoot = nil
    if align then pcall(function() align:Destroy() end) end
    if attachment then pcall(function() attachment:Destroy() end) end
    -- The next movement Heartbeat should target the Titan immediately.
    Farm.movementElapsed = REPATH_TIME
end

local function updateLastTitanWaitFreeze()
    if Farm.unloaded or not Farm.running or movementUtilityBusy()
        or not Farm.lastTitanEnabled then
        releaseLastTitanWaitFreeze()
        return false
    end
    local elapsed = getMatchElapsed()
    if elapsed >= Farm.lastTitanAtSeconds then
        releaseLastTitanWaitFreeze()
        return false
    end
    local living = getLivingTitans()
    if #living ~= 1 or living[1] ~= getReservedLastTitan() then
        releaseLastTitanWaitFreeze()
        return false
    end
    local root = getPlayerRoot()
    local titan = living[1]
    local nape = getNape(titan)
    if not root or not nape then
        releaseLastTitanWaitFreeze()
        return false
    end
    -- Complete an in-flight slash before taking over player movement.
    if Farm.attacking or Farm.frozenRoot or Farm.skillReservation then
        releaseLastTitanWaitFreeze()
        return false
    end
    if not Farm.waitingFreezeActive then
        Farm.lastTitanAirOrbitStartedAt = Farm.clockNow()
    end
    local fake = titan:FindFirstChild("Fake")
    local head = (fake and fake:FindFirstChild("Head")) or titan:FindFirstChild("Head")
    local anchor = (head and head:IsA("BasePart")) and head or nape
    local extra = anchor == head and head.Size.Y * 0.5 or 0
    local altitude = math.max(120, tonumber(Farm.farmDistance) or 200)
    -- Controlled inactivity test: keep a slow, 16-stud horizontal orbit rather
    -- than remaining motionless over the Titan. We do not touch the server's
    -- match timer or send fake activity/attack requests. All motion remains in
    -- the existing AlignPosition controller at the player's safe farm height.
    local horizontal = Vector3.zero
    if Farm.lastTitanAirOrbitEnabled then
        local startedAt = Farm.lastTitanAirOrbitStartedAt or Farm.clockNow()
        local angle = math.max(0, Farm.clockNow() - startedAt) * (2 * math.pi / 12)
        horizontal = Vector3.new(math.sin(angle) * 16, 0, (1 - math.cos(angle)) * 16)
    end
    Farm.lastTitanAirPosition = anchor.Position + horizontal
        + Vector3.new(0, altitude + extra, 0)
    Farm.waitingFreezeRoot = root
    Farm.waitingFreezeActive = true
    return true
end

local function canAttackTitan(model)
    return model ~= nil and getNape(model) ~= nil
        and (getReservedLastTitan() ~= model)
end

local function hasAuraTarget()
    for _, titan in ipairs(getLivingTitans()) do
        if canAttackTitan(titan) then return true end
    end
    return false
end

local function findClosestTitan(fromPosition)
    local closest, bestDistance = nil, math.huge
    local reserved = getReservedLastTitan()
    for _, model in ipairs(Farm:GetFarmTargetModels()) do
        local nape = getNape(model)
        -- Farm all other Titans first; only follow the reserved Titan when
        -- it is the sole remaining target, without attacking until the time.
        if nape and model ~= reserved then
            local distance = (nape.Position - fromPosition).Magnitude
            if distance < bestDistance then
                closest, bestDistance = model, distance
            end
        end
    end
    return closest or reserved
end

-- Keep live nape lookups dynamic so respawns and dead Titans cannot leave stale targets.
-- v34 rotated all eight slots, sometimes skipping the farm target or nearest Titan.
-- Here the selected farm target and closest Titan get priority on every swing;
-- remaining slots rotate fairly instead of monopolizing the same few Titans.
local function getAuraNapes(fromPosition)
    local targets = {}
    for _, titan in ipairs(Farm:GetFarmTargetModels()) do
        local nape = getNape(titan)
        if nape then
            targets[#targets + 1] = {
                titan = titan,
                nape = nape,
                distance = (nape.Position - fromPosition).Magnitude,
            }
        end
    end
    table.sort(targets, function(a, b)
        if a.distance == b.distance then
            return tostring(a.titan.Name) < tostring(b.titan.Name)
        end
        return a.distance < b.distance
    end)
    return targets
end

-- Priority list is rebuilt immediately before each registration so moving Titans
-- are not registered using a nape that was destroyed during the slash.
local function getPrioritizedAuraTargets(fromPosition)
    local ordered = getAuraNapes(fromPosition)
    local livingCount = #ordered
    local reserved = getReservedLastTitan()
    if reserved then
        local allowed = {}
        for _, entry in ipairs(ordered) do
            if entry.titan ~= reserved then
                allowed[#allowed + 1] = entry
            end
        end
        ordered = allowed
    end
    local count = #ordered
    if count == 0 then return {}, livingCount end

    local selected, used = {}, {}
    local function add(entry)
        if not entry or used[entry.titan] then return false end
        if not getNape(entry.titan) then return false end
        used[entry.titan] = true
        selected[#selected + 1] = entry
        return true
    end

    -- Guarantee the currently farmed Titan, if it is still alive.
    if Farm.running and Farm.target then
        for _, entry in ipairs(ordered) do
            if entry.titan == Farm.target then
                add(entry)
                break
            end
        end
    end
    -- Always include the closest Titan, even when the cursor points elsewhere.
    add(ordered[1])

    if Farm.auraMode ~= "Reliable" then
        -- Finish an already weakened Titan before spreading remaining strikes.
        -- This is only prioritization, not additional damage or a server bypass.
        local weakest, weakestRatio = nil, math.huge
        for _, entry in ipairs(ordered) do
            local humanoid = entry.titan:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 and humanoid.MaxHealth > 0 then
                local ratio = humanoid.Health / humanoid.MaxHealth
                if ratio < weakestRatio then
                    weakest, weakestRatio = entry, ratio
                end
            end
        end
        add(weakest)
    end

    local maxTargets = Farm.auraMode == "Turbo" and TURBO_AURA_TARGETS
        or (Farm.auraMode == "Aggressive" and AGGRESSIVE_AURA_TARGETS
        or MAX_AURA_TARGETS_PER_SWING)
    local cursor = ((Farm.auraCursor - 1) % count) + 1
    local added = 0
    for i = 0, count - 1 do
        if #selected >= maxTargets then break end
        if add(ordered[((cursor + i - 1) % count) + 1]) then
            added = added + 1
        end
    end
    -- Advance by the number of *optional* Titans visited, not just one.
    -- This prevents large waves from repeatedly hitting the same first 20 Titans.
    Farm.auraCursor = ((cursor + math.max(1, added) - 1) % count) + 1
    return selected, livingCount
end

-- Outskirts Titans have a visual head under Fake.Head.
-- Stand directly over its top surface, with the slider defining extra clearance.
-- If an alternate Titan model lacks Fake.Head, use its nape as a fallback.
local function getTitanHead(titan)
    local fake = titan:FindFirstChild("Fake")
    local head = fake and fake:FindFirstChild("Head")
    if not head then
        head = titan:FindFirstChild("Head")
    end
    return (head and head:IsA("BasePart")) and head or nil
end

local function getFarmCFrame(titan, nape)
    local head = getTitanHead(titan)
    local anchor = head or nape
    local topOffset = head and head.Size.Y * 0.5 or 0
    local position = anchor.Position + Vector3.new(0, topOffset + Farm.farmDistance, 0)

    -- Stay upright above the head instead of pitching the character downward.
    -- Look horizontally toward the nape, or use the Titan's own facing direction.
    local horizontal = Vector3.new(nape.Position.X - position.X, 0, nape.Position.Z - position.Z)
    if horizontal.Magnitude < 0.05 then
        local rootPart = titan:FindFirstChild("HumanoidRootPart") or titan.PrimaryPart
        local forward = rootPart and rootPart.CFrame.LookVector or anchor.CFrame.LookVector
        horizontal = Vector3.new(forward.X, 0, forward.Z)
    end
    if horizontal.Magnitude < 0.05 then
        horizontal = Vector3.new(0, 0, -1)
    end
    return CFrame.lookAt(position, position + horizontal.Unit)
end

-- Skills 14/23 create a server-side hitbox WELDED TO THE PLAYER.
-- Unlike the normal slash's Hitboxes/Register call, a skill's hitbox does not
-- automatically reach napes hundreds of studs above the map.
-- Optional skill assist moves close to ONE valid nape for the skill's own hit
-- window, then restores the selected normal farm height through farmStep().
-- It does NOT spoof skill hits or send arbitrary nape damage registrations.
local function releaseSkillNapeAssist()
    if not Farm.skillNapeActive then return end
    local root = Farm.skillNapeRoot
    local originallyAnchored = Farm.skillNapeWasAnchored
    Farm.skillNapeActive = false
    Farm.skillNapeRoot = nil
    Farm.skillNapeTarget = nil
    Farm.skillNapeUntil = 0
    Farm.skillNapeWasAnchored = false
    if root and root.Parent and not originallyAnchored then
        pcall(function()
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

-- v55: passive, non-moving skill posture. Actual skills 14/23 have native
-- character-bound hitboxes, so a cast at 200 studs may NOT deal damage.
-- We never teleport, anchor, or CFrame-change the character for skills.
local function beginSkillNapeAssist(skillId)
    Farm.skillNapeLastResult = "Stayed at farm altitude for skill " .. tostring(skillId)
        .. "; skill hitbox range is governed by the game"
    return false
end

-- The game's Character.Actor.Client creates a live Host containing
-- Modules.ODMG.M1 (start) and Modules.Input.Slash (release).
-- Because each Roblox Actor has a separate Luau VM, requiring those modules
-- from here would create a different copy of their state, NOT the live Host.
-- This optional test attempts to run within the character's own Actor VM.
-- It requires an executor exposing run_on_actor and getgc in that Actor.
-- NO mouse events, keyboard events, or fallback simulated inputs are used.
local BRIDGE_NAME = "HollowMoonClientSlashV127"
local ACTOR_SOURCE = [==[
local Players = game:GetService("Players")
local character = Players.LocalPlayer.Character
local actor = character and character:FindFirstChildOfClass("Actor")
if not actor then
    do end
    return
end
local bridge = actor:FindFirstChild("HollowMoonClientSlashV127")
if bridge and not bridge:IsA("BindableFunction") then
    bridge:Destroy()
    bridge = nil
end
if not bridge then
    bridge = Instance.new("BindableFunction")
    bridge.Name = "HollowMoonClientSlashV127"
    bridge.Parent = actor
end

local liveHost = nil
local lastScan = -math.huge
local skillCursor = 1
local rageActivationPendingUntil = 0
local function validHost(host)
    if type(host) ~= "table" then return false end
    local cache = rawget(host, "Cache")
    local modules = rawget(host, "Modules")
    if type(cache) ~= "table" or type(modules) ~= "table" then return false end
    local vars = rawget(cache, "Variables")
    local odm = rawget(modules, "ODMG")
    local input = rawget(modules, "Input")
    return cache.Character == Players.LocalPlayer.Character
        and type(vars) == "table"
        and type(vars.Slash) == "table"
        and type(odm) == "table"
        and type(odm.M1) == "function"
        and type(input) == "table"
        and type(input.Slash) == "function"
end
local function resolveHost(force)
    if validHost(liveHost) then return liveHost, "Live combat Host located" end
    liveHost = nil
    if not force and os.clock() - lastScan < 0.6 then
        return nil, "Waiting to retry combat Host scan"
    end
    lastScan = os.clock()
    if type(getgc) ~= "function" then
        return nil, "getgc is not available inside this Actor"
    end
    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then
        ok, objects = pcall(getgc)
    end
    if not ok or type(objects) ~= "table" then
        return nil, "Cannot scan objects within this Actor"
    end
    for _, candidate in pairs(objects) do
        if validHost(candidate) then
            liveHost = candidate
            return candidate, "Live combat Host located"
        end
    end
    return nil, "Live combat Host not found in Actor VM"
end

-- Raid cinematics can become available BEFORE the combat Host's slash modules.
-- Resolve the game's live Raids controller independently of weapon readiness.
local liveCinematicHost = nil
local lastCinematicScan = -100
local function validCinematicHost(h)
    if type(h) ~= "table" then return false end
    local cache = rawget(h, "Cache")
    local modules = rawget(h, "Modules")
    local raids = type(modules) == "table" and rawget(modules, "Raids")
    return type(cache) == "table"
        and cache.Character == Players.LocalPlayer.Character
        and type(raids) == "table"
        and type(raids.Skip) == "function"
        and cache.Interface ~= nil
end
local function resolveCinematicHost()
    if validCinematicHost(liveCinematicHost) then return liveCinematicHost end
    if validCinematicHost(liveHost) then
        liveCinematicHost = liveHost
        return liveHost
    end
    if os.clock() - lastCinematicScan < 0.75 then
        return nil, "Raid controller still initializing"
    end
    lastCinematicScan = os.clock()
    if type(getgc) ~= "function" then return nil, "Actor GC lookup unavailable" end
    local ok, objects = pcall(getgc, true)
    if not ok or type(objects) ~= "table" then ok, objects = pcall(getgc) end
    if not ok or type(objects) ~= "table" then return nil, "Actor objects unavailable" end
    for _, candidate in pairs(objects) do
        if validCinematicHost(candidate) then
            liveCinematicHost = candidate
            return candidate
        end
    end
    return nil, "Raid controller not ready"
end

-- Command handler executes with Actor-local access to the original client state.
bridge.OnInvoke = function(command, payload)
    if command == "cinematic_skip" then
        -- Native, non-forced Skip. The Stohess controller deliberately hides
        -- its Skip button for early Female Titan / QTE cinematics.
        local h, reason = resolveCinematicHost()
        if not h then return false, reason end
        local raids = h.Modules.Raids
        local interface = h.Cache.Interface
        local skipUI = interface and interface:FindFirstChild("Skip")
        if not skipUI or not skipUI:IsA("GuiObject") or skipUI.Visible ~= true then
            return false, "Native raid Skip button not available"
        end
        if not (raids.Can_Skip and raids.Can_Skip.Value == true)
            or raids.Interacted == true then
            return false, "Raid controller has not enabled skipping"
        end
        -- Do NOT pass true as the third parameter: doing so bypasses
        -- Can_Skip / Interacted and can advance the cinematic too early.
        local ok, err = pcall(raids.Skip, h, interface, nil)
        if not ok then return false, "Native raid Skip failed: " .. tostring(err) end
        if raids.Interacted == true then
            return true, "Native raid controller accepted Skip"
        end
        return false, "Native Skip did not change the controller state"
    end
    local host, state = resolveHost(command == "status")
    if command == "status" then
        if host then return true, "READY: " .. state end
        return false, state
    end
    if not host then return false, state end
    -- Raid chest operations must run in the SAME Actor VM as the game's
    -- live Host. This calls its Chests controller, not the reward remote.
    -- The controller itself checks eligibility and plays its animations.
    if command == "raid_chest" then
        local request = type(payload) == "table" and payload or {}
        if workspace:GetAttribute("Type") ~= "Raids" then
            return false, "Not an active Raid"
        end
        local modules = host.Modules
        local chest = modules and modules.Chests
        local rewards = modules and modules.Rewards
        local ui = host.Cache and host.Cache.Interface and host.Cache.Interface.Chests
        if type(chest) ~= "table" or type(rewards) ~= "table" or not ui then
            return false, "Native Chests controller is not initialized"
        end
        local player = Players.LocalPlayer
        local data = host.Cache.Data
        local slot = data and data.Slots and data.Slots[data.Current_Slot]
        local items = slot and slot.Inventory and slot.Inventory.Items
        -- A present inventory with no key entry means zero keys; a missing
        -- inventory means loading is incomplete, not proof of zero keys.
        local keys = items and (tonumber(items["Emperor's Key"]) or 0) or nil
        local credit = tonumber(player:GetAttribute("Stat"))
        local result = {
            visible = ui.Visible == true,
            state = chest.State,
            ready = chest.State == "In" and ui.Visible == true and chest.End ~= nil,
            freeClaimed = rewards.Free_Claimed == true,
            premiumClaimed = rewards.Premium_Claimed == true,
            credit = credit,
            keys = keys,
            animating = chest.Other ~= nil,
            finished = chest.State ~= "In" or ui.Visible ~= true,
        }
        if request.action == "status" then return true, result end
        if request.action == "open" then
            local choice = request.choice == "Premium" and "Premium" or "Free"
            if not result.ready then return false, "Chest controller/screen not ready" end
            if (choice == "Free" and result.freeClaimed)
                or (choice == "Premium" and result.premiumClaimed) then
                return false, choice .. " chest already claimed"
            end
            if credit == nil then return false, "Waiting for raid credit" end
            if credit < 5 then return false, "Raid credit below 5%" end
            if choice == "Premium" and keys == nil then
                return false, "Waiting for inventory/key count"
            end
            if choice == "Premium" and keys < 1 then
                return false, "Premium requires an Emperor's Key"
            end
            if type(chest.Open) ~= "function" or not ui:FindFirstChild(choice) then
                return false, "Native Open handler unavailable"
            end
            local ok, err = pcall(chest.Open, host, ui, ui[choice])
            if not ok then return false, "Native Open failed: " .. tostring(err) end
            return true, "Native " .. choice .. " Open controller invoked"
        end
        if request.action == "finish" then
            -- Finishing without Premium is valid when no Emperor's Key is owned.
            -- No selected-chest claim is required by the native Finish routine.
            -- But never close the interface in the middle of an opening.
            if not result.ready or result.animating then
                return false, "CHESTS is not ready to finish"
            end
            if type(chest.Finish) ~= "function" then
                return false, "Native Finish handler unavailable"
            end
            local ok, err = pcall(chest.Finish, host)
            if not ok then return false, "Native Finish failed: " .. tostring(err) end
            return true, "Native Finish controller invoked"
        end
        return false, "Unknown chest operation"
    end
    local char = Players.LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        return false, "Character not ready"
    end
    local slash = host.Cache.Variables.Slash
    -- This is the native combat Host's actual idle state. The outer
    -- Farm.attacking flag often ends before Slash.Slashing/Transition does.
    if command == "reload_window" then
        local v = host.Cache.Variables
        local reasons = {}
        if host.Invoked then reasons[#reasons + 1] = "network action active" end
        if host.Skill then reasons[#reasons + 1] = "skill active" end
        if slash.Slashing or slash.Transition or slash.Holding then
            reasons[#reasons + 1] = "slash animation active"
        end
        if v.Reload or v.Full_Reload then reasons[#reasons + 1] = "reload animation active" end
        if v.Heavy and (v.Heavy.Hitting or v.Heavy.Transition) then
