-- A queue is not private just because its gate matches your selected rank.
-- If we enter a queue that belongs to another hunter, step off its pad so
-- the server drops our queue membership (there is no Gates.Leave remote).
function Scheduler.stepOffForeignQueue(gate)
    if not (gate and gate:IsA("Model")) then return end
    local pad = gate:FindFirstChild("QueuePad", true)
    local character, root = getCharacter()
    if not (pad and pad:IsA("BasePart") and character and root) then return end
    local planar = Vector3.new(root.Position.X - pad.Position.X, 0,
        root.Position.Z - pad.Position.Z)
    if planar.Magnitude < 0.1 then
        local facing = pad.CFrame.LookVector
        planar = Vector3.new(facing.X, 0, facing.Z)
    end
    if planar.Magnitude < 0.1 then planar = Vector3.new(1, 0, 0) end
    local reach = math.max(pad.Size.X, pad.Size.Z) * 0.5 + 15
    local exitPoint = pad.Position + planar.Unit * reach
    local hum = character:FindFirstChildOfClass("Humanoid")
    exitPoint = Vector3.new(exitPoint.X, pad.Position.Y + pad.Size.Y * 0.5
        + (hum and hum.HipHeight or 2) + root.Size.Y * 0.5, exitPoint.Z)
    root.AssemblyLinearVelocity = Vector3.zero
    character:PivotTo(CFrame.new(exitPoint))
end

-- No public/other-player gate fallback. A gate must have been spawned by us;
-- the first person in its queue must also be us (or the queue is empty).
local function findMatchingGate(level)
    local folder = Workspace:FindFirstChild("Gates")
    if not folder then return nil end
    for _, gate in ipairs(folder:GetChildren()) do
        if gate:IsA("Model") and gate:GetAttribute("Level") == level
            and gate:GetAttribute("State") == "Open"
            and gate:GetAttribute("SpawnerId") == LocalPlayer.UserId then
            return gate
        end
    end
    return nil
end
local function tickAutoJoin()
    if moneyWalkBusy or isInRaid() or LocalPlayer:GetAttribute("Traveling") then return end
    local level = settings.DungeonLevel
    if not level then return end
    local entry = getDungeonCatalogEntry(level)
    local gate = findMatchingGate(level)
    local char, root = getCharacter()
    if not char or not root then return end
    local queueId = LocalPlayer:GetAttribute("GateQueue")
    if queueId == nil then
        Scheduler.ownQueuePendingName = nil
        Scheduler.ownQueuePendingSince = nil
    end
    if queueId ~= nil then
        -- If we are inside somebody else's queue (including a different
        -- dungeon), withdraw instead of starting or following their run.
        local queuedGate = Workspace:FindFirstChild("Gates")
        queuedGate = queuedGate and queuedGate:FindFirstChild(tostring(queueId))
        local spawnerId = queuedGate and queuedGate:GetAttribute("SpawnerId")
        local leaderId = queuedGate and queuedGate:GetAttribute("OwnerId")
        -- GateQueue sometimes replicates slightly before OwnerId. Give
        -- the server a brief chance to assign leadership to the creator.
        if spawnerId == LocalPlayer.UserId and leaderId == nil then
            if Scheduler.ownQueuePendingName ~= tostring(queueId) then
                Scheduler.ownQueuePendingName = tostring(queueId)
                Scheduler.ownQueuePendingSince = os.clock()
            end
            if os.clock() - (Scheduler.ownQueuePendingSince or 0) < 1.5 then
                Scheduler.ownGateStatus = "Your gate · Waiting for queue leadership"
                return
            end
        end
        local ours = spawnerId == LocalPlayer.UserId
            and leaderId == LocalPlayer.UserId
        if not ours then
            Scheduler.ownGateStatus = "Leaving another player's queue"
            Scheduler.stepOffForeignQueue(queuedGate)
            return
        end
        if gate and queuedGate == gate and os.clock() - lastGateStart >= 4 then
            lastGateStart = os.clock()
            Scheduler.ownGateStatus = "Your queue · Requesting START"
            attempt("GateStart", 4, function() GateStart:FireServer() end)
        else
            Scheduler.ownGateStatus = "Waiting for your own queued gate"
        end
        return
    end
    if not gate then
        Scheduler.ownGateStatus = "No own gate found · Spawning your selected dungeon"
        if not entry or entry.Available ~= true or catalogState.Busy
            or (catalogState.CooldownUntil or 0) > Workspace:GetServerTimeNow()
            or os.clock() < nextSpawn then return end
        nextSpawn = os.clock() + 12
        attempt("SpawnDungeon", 12, function()
            DungeonRequest:FireServer("Spawn", level)
        end)
        return
    end
    local leader = gate:GetAttribute("OwnerId")
    local queued = tonumber(gate:GetAttribute("Queued")) or 0
    if leader ~= LocalPlayer.UserId and (leader ~= nil or queued > 0) then
        Scheduler.ownGateStatus = "Your gate is led/occupied by another player · Waiting"
        return
    end
    local pad = gate:FindFirstChild("QueuePad", true)
    if not (pad and pad:IsA("BasePart")) then
        Scheduler.ownGateStatus = "Waiting for own gate's queue pad"
        return
    end
    Scheduler.ownGateStatus = "Joining your own empty dungeon queue"
    if (root.Position - pad.Position).Magnitude > 3 then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local standing = pad.Size.Y * 0.5 + (hum and hum.HipHeight or 2) + root.Size.Y * 0.5
        root.AssemblyLinearVelocity = Vector3.zero
        char:PivotTo(CFrame.new(pad.Position + Vector3.new(0, standing, 0)))
    end
end

