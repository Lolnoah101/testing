        local CharacterConfig = SkillTreeConfig
            and SkillTreeConfig.characters
            and SkillTreeConfig.characters[Character]

        if not CharacterConfig
            or not CharacterConfig.branches
        then
            return nil
        end

        local Skills = CharacterData.Progression.Skills
        local AvailableTokens

        local Success, Tokens = pcall(function()
            return CharacterLevelProgression.getAvailableTokens(
                Character,
                CharacterData.Progression.Xp or "0",
                Skills
