            local function NumberText(Value)

                local Number =
                    tonumber(Value) or 0

                local Negative =
                    Number < 0

                Number =
                    math.floor(math.abs(Number) + 0.5)

                local Text =
                    tostring(Number)

                Text =
                    Text:reverse()
                        :gsub(
                            "(%d%d%d)",
