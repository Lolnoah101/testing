-- =============================================================
-- V29: automatic defensive positioning from the game's telegraph VFX.
-- AttackIndicator.render creates GroundWarning BaseParts inside
-- workspace.Visuals. This watches THOSE parts rather than screen pixels.
-- Exact server hit validation remains server-owned; do not assume a
-- visual warning represents every possible attack.
-- =============================================================
do
    local dodge = {
        active = false, destination = nil, holdUntil = 0,
        lastUpdate = 0, lastMoveTo = 0, lastLabel = -math.huge,
        warnings = setmetatable({}, {__mode = "k"}),
        watching = nil, status = "Waiting for warnings", tries = 0,
    }
    Scheduler.dodge = dodge
    local MonsterAttack = require(ReplicatedStorage.Utility:WaitForChild("MonsterAttack"))
    -- Target ~3.5 studs beyond the visual attack boundary, not 3.5
    -- studs beyond the warning CENTER. Extra 0.1 avoids floating error.
    local DODGE_CLEARANCE = 3.5
    local DODGE_TARGET = 3.6

    local function addWarning(part)
        if part:IsA("BasePart") and part.Name == "GroundWarning"
            and part:IsDescendantOf(Workspace) then
            dodge.warnings[part] = true
            Scheduler.poke("Dodge")
        end
    end
    local function bindVisuals(folder)
        if not folder or folder ~= Workspace:FindFirstChild("Visuals")
            or dodge.watching == folder then return end
        dodge.watching = folder
        for _, item in ipairs(folder:GetDescendants()) do addWarning(item) end
        Scheduler.track(folder.DescendantAdded:Connect(addWarning))
        Scheduler.track(folder.DescendantRemoving:Connect(function(item)
            dodge.warnings[item] = nil
        end))
    end
    bindVisuals(Workspace:FindFirstChild("Visuals"))
    Scheduler.track(Workspace.ChildAdded:Connect(function(item)
        if item.Name == "Visuals" then bindVisuals(item) end
    end))

    local function makeShape(part)
        local gui = part:FindFirstChildOfClass("SurfaceGui")
        if not gui then return nil end
        local isCone = gui:FindFirstChildOfClass("ImageLabel") ~= nil
        local radius = math.max(part.Size.X, part.Size.Z) * 0.5
        if radius < 0.5 or radius > 800 then return nil end
        if isCone then
            local image = gui:FindFirstChildOfClass("ImageLabel")
            local offset = image.ImageRectOffset
            local index = math.floor(offset.Y / 256) * 4 + math.floor(offset.X / 256) + 1
            local angle = MonsterAttack.sectorAngles[index] or 120
            -- GroundWarning rotates its source frame -90 degrees about Y.
            return {
                kind = "Cone", radius = radius, angle = angle,
                frame = part.CFrame * CFrame.Angles(0, math.pi * 0.5, 0),
                origin = part.Position,
            }
        end
        local filled = nil
        local ringWidth = nil
        for _, child in ipairs(gui:GetChildren()) do
            if child:IsA("Frame") then
                local stroke = child:FindFirstChildOfClass("UIStroke")
                if stroke and child.BackgroundTransparency >= 0.95 then
                    local w = stroke.Thickness / 32
                    if w >= 0.1 and w < radius then ringWidth = w end
                elseif child:FindFirstChildOfClass("UICorner") then
                    filled = true
                end
            end
        end
        if ringWidth then
            return {kind = "Ring", radius = radius,
                inner = math.max(0, radius - ringWidth), origin = part.Position}
        end
        if not filled and math.abs(part.Size.X - part.Size.Z) > 0.75 then
            return {kind = "Rectangle", frame = part.CFrame,
                width = part.Size.Z, length = part.Size.X, origin = part.Position}
        end
        return {kind = "Circle", radius = radius, origin = part.Position}
    end

    -- Return approximate danger depth (>0 inside warning, <=0 outside).
    -- For rings respect their safe inner hole, rather than fleeing every
    -- large ring visible in a boss fight.
    local function depth(shape, p)
        local pos = shape.origin
        local dx, dz = p.X - pos.X, p.Z - pos.Z
        local dist = math.sqrt(dx * dx + dz * dz)
        local margin = DODGE_CLEARANCE
        if shape.kind == "Ring" then
            if dist < shape.inner - margin or dist > shape.radius + margin then
                return 0
            end
            return math.min(dist - shape.inner + margin,
                shape.radius - dist + margin)
        elseif shape.kind == "Circle" then
            return math.max(0, shape.radius + margin - dist)
        elseif shape.kind == "Rectangle" then
            local localPoint = shape.frame:PointToObjectSpace(p)
            local insideX = shape.length * 0.5 + margin - math.abs(localPoint.X)
            local insideZ = shape.width * 0.5 + margin - math.abs(localPoint.Z)
            return math.max(0, math.min(insideX, insideZ))
        else
            local localPoint = shape.frame:PointToObjectSpace(p)
            local inFront = -localPoint.Z
            if inFront < -margin or dist > shape.radius + margin then return 0 end
            local angle = math.abs(math.atan2(localPoint.X, math.max(0.01, inFront)))
            local limit = math.rad(shape.angle * 0.5)
            if angle > limit + 0.05 then return 0 end
            return math.max(0, math.min(shape.radius + margin - dist,
                (limit - angle + 0.05) * math.max(1, dist)))
        end
    end
    local function danger(point, shapes)
        local total = 0
        for _, shape in ipairs(shapes) do
            total += depth(shape, point)
        end
        return total
    end
    -- Project just outside the actual danger-zone EDGE, keeping the shortest
    -- escape. A ring may be safer by stepping into its center than running
    -- all the way past its outer rim.
    local function boundaryCandidates(shape, p)
        local candidates = {}
        local dx = p.X - shape.origin.X
        local dz = p.Z - shape.origin.Z
        local dist = math.sqrt(dx * dx + dz * dz)
        local nx, nz = 1, 0
        if dist > 0.001 then nx, nz = dx / dist, dz / dist end
        local function radial(radius)
            if radius < 0 then return end
            table.insert(candidates, Vector3.new(
                shape.origin.X + nx * radius, p.Y,
                shape.origin.Z + nz * radius))
        end
        if shape.kind == "Circle" then
            radial(shape.radius + DODGE_TARGET)
        elseif shape.kind == "Ring" then
            if shape.inner > DODGE_TARGET then
                radial(shape.inner - DODGE_TARGET)
            end
            radial(shape.radius + DODGE_TARGET)
        elseif shape.kind == "Rectangle" then
            local q = shape.frame:PointToObjectSpace(p)
            local hx, hz = shape.length * 0.5, shape.width * 0.5
            local function pointLocal(x, z)
                local pointWorld = shape.frame:PointToWorldSpace(Vector3.new(x, q.Y, z))
                table.insert(candidates, Vector3.new(pointWorld.X, p.Y, pointWorld.Z))
            end
            pointLocal( hx + DODGE_TARGET, math.clamp(q.Z, -hz, hz))
            pointLocal(-hx - DODGE_TARGET, math.clamp(q.Z, -hz, hz))
            pointLocal(math.clamp(q.X, -hx, hx),  hz + DODGE_TARGET)
            pointLocal(math.clamp(q.X, -hx, hx), -hz - DODGE_TARGET)
            -- Corner exit for diagonal approaches.
            local cx, cz = math.clamp(q.X, -hx, hx), math.clamp(q.Z, -hz, hz)
            local ox, oz = q.X - cx, q.Z - cz
            local ol = math.sqrt(ox * ox + oz * oz)
            if ol > 0.001 then
                pointLocal(cx + ox / ol * DODGE_TARGET,
                    cz + oz / ol * DODGE_TARGET)
            end
        elseif shape.kind == "Cone" then
            radial(shape.radius + DODGE_TARGET)
            local q = shape.frame:PointToObjectSpace(p)
            local half = math.rad(shape.angle * 0.5)
            -- Go perpendicular to the closest cone edge, rather than moving
            -- out past the whole attack radius whenever the tip is far away.
            for _, sign in ipairs({-1, 1}) do
                local bx, bz = sign * math.sin(half), -math.cos(half)
                local t = math.max(0, q.X * bx + q.Z * bz)
                local nxEdge, nzEdge = sign * math.cos(half), math.sin(half)
                local qx = bx * t + nxEdge * DODGE_TARGET
                local qz = bz * t + nzEdge * DODGE_TARGET
                local world = shape.frame:PointToWorldSpace(Vector3.new(qx, q.Y, qz))
                table.insert(candidates, Vector3.new(world.X, p.Y, world.Z))
            end
        end
        return candidates
    end

    local function findSafe(point, shapes)
        if danger(point, shapes) <= 0 then return nil end
        local best, shortest = nil, math.huge
        local function consider(candidate)
            if danger(candidate, shapes) > 0.001 then return end
            local length = (candidate - point).Magnitude
            if length < shortest then best, shortest = candidate, length end
        end
        for _, shape in ipairs(shapes) do
            for _, candidate in ipairs(boundaryCandidates(shape, point)) do
                consider(candidate)
            end
        end
        if best then return best end

        -- Overlapping warnings can make every individual edge point unsafe.
        -- Search outward along multiple directions, then binary-search the
        -- FIRST safe point (not preset 7/13/22/34/52/75 stud dodges).
        local maxRadius = 0
        for _, shape in ipairs(shapes) do
            maxRadius = math.max(maxRadius, shape.radius or
                math.max(shape.width or 0, shape.length or 0))
        end
        local maxTravel = math.clamp(maxRadius * 2.5 + 12, 75, 1200)
        for i = 0, 23 do
            local theta = i * math.pi / 12
            local direction = Vector3.new(math.cos(theta), 0, math.sin(theta))
            local low, high = 0, 2
            while high <= maxTravel do
                local candidate = point + direction * high
                if danger(candidate, shapes) <= 0.001 then
                    for _ = 1, 11 do
                        local middle = (low + high) * 0.5
                        if danger(point + direction * middle, shapes) <= 0.001 then
                            high = middle
                        else
                            low = middle
                        end
                    end
                    consider(point + direction * (high + 0.1))
                    break
                end
                low, high = high, high * 1.75
            end
        end
        return best
    end
    local function endDodge()
        dodge.active = false
        dodge.destination = nil
        MovementNoclip.set("dodge", nil, false)
    end

    Scheduler.add("Dodge", 0.06, function()
        if not alive or not enabled.AutoDodge then
            endDodge()
            dodge.status = "Disabled"
            return
        end
        if not LocalPlayer:GetAttribute("Raid") then
            endDodge()
            dodge.status = "Waiting for dungeon"
            return
        end
        local character, root = getCharacter()
        if not character or not root then
            endDodge()
            return
        end
        local shapes = {}
        for part in pairs(dodge.warnings) do
            if part.Parent and math.abs(part.Position.Y - root.Position.Y) < 15
                and (part.Position - root.Position).Magnitude < 300 then
                local shape = makeShape(part)
                if shape then table.insert(shapes, shape) end
            elseif not part.Parent or not part:IsDescendantOf(Workspace) then
                dodge.warnings[part] = nil
            end
        end
        if #shapes == 0 then
            endDodge()
            dodge.status = "No warnings nearby"
            return
        end
        local now = os.clock()
        local exposure = danger(root.Position, shapes)
        if exposure > 0 then
            local destination = findSafe(root.Position, shapes)
            if destination then
                dodge.destination = destination
                dodge.active = true
                dodge.holdUntil = now + 0.35
                dodge.status = "Dodging ~3.5 studs outside " .. #shapes .. " warning(s)"
                -- Dodge takes precedence over offensive combo traffic.
                Scheduler.combat.attackPauseUntil = math.max(
                    Scheduler.combat.attackPauseUntil, now + 0.22)
            end
        elseif dodge.active then
            -- Stay at the nearby safe boundary until the warning disappears;
            -- otherwise the farm follow-loop immediately pulls us back in.
            dodge.holdUntil = now + 0.35
            dodge.status = "Holding ~3.5 studs outside AoE"
        elseif now >= dodge.holdUntil then
            endDodge()
            dodge.status = "Outside warning area"
        end
    end)

    -- Movement priority is evaluated on the same Heartbeat as dungeon farm.
    -- No extra input spam. Only trigger MoveTo when needed in Legit mode.
    Scheduler.track(RunService.Heartbeat:Connect(function(dt)
        if not alive or not enabled.AutoDodge or not dodge.active
            or not dodge.destination then return end
        local character, root = getCharacter()
        if not character or not root then endDodge(); return end
        local dest = dodge.destination
        local diff = dest - root.Position
        local d = diff.Magnitude
        if d < 0.25 then return end
        local method = settings.FarmMethod
        MovementNoclip.set("dodge", character, method ~= "Legit")
        if method == "Teleport" then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(dest) * (root.CFrame - root.Position)
        elseif method == "Tween" then
            root.AssemblyLinearVelocity = Vector3.zero
            local speed = math.max(85, tonumber(settings.TweenSpeed) or 65)
            local step = math.min(d, speed * math.clamp(dt, 0, 0.1))
            root.CFrame = CFrame.new(root.Position + diff.Unit * step)
                * (root.CFrame - root.Position)
        else
            if os.clock() - dodge.lastMoveTo > 0.22 then
                dodge.lastMoveTo = os.clock()
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then humanoid:MoveTo(dest) end
            end
        end
    end))

    Scheduler.add("DodgeStatus", 0.65, function()
        if Scheduler.dodgeStatusLabel then
            pcall(function()
                Scheduler.dodgeStatusLabel:Set(dodge.status)
            end)
        end
    end)
end

local function clearFarmLock()
    lockedEnemy = nil
    lockedEnemyPart = nil
    nextFarmScan = 0
    lastLegitTarget = nil
end

local function stopMovement()
    if AriseCoordinator.reset then AriseCoordinator.reset() end
    removeBelowPlatform()
    MovementNoclip.set("farm", nil, false)
    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween = nil
    tweenTarget = nil
    clearFarmLock()
    farmSeekBossPosition = nil
    Scheduler.seekEnemyGoal.raid, Scheduler.seekEnemyGoal.id = nil, nil
    Scheduler.seekEnemyGoal.position, Scheduler.seekEnemyGoal.remaining = nil, 0
    EventState.eventGoalPosition, EventState.eventGoalId, EventState.eventGoalRaid = nil, nil, nil
    farmStatusText = "Idle"
    farmRaid = nil
    farmPhase = nil
    if farmHeartbeatConnection then
        farmHeartbeatConnection:Disconnect()
        farmHeartbeatConnection = nil
    end
end

local function raidBossActive(raid)
    return raid and raid:GetAttribute("PhaseId") == "Boss"
        and (tonumber(raid:GetAttribute("BossHealth")) or 0) > 0
end

local function bossIntroRunning(raid)
    if not raidBossActive(raid) then return false end
    local untilTime = raid:GetAttribute("BossIntroUntil")
    return type(untilTime) == "number" and Workspace:GetServerTimeNow() < untilTime
end

local function validFarmEnemy(enemy, raid)
    if not raid or not enemy or not enemy:IsA("Model") or not enemy.Parent
        or not enemy:IsDescendantOf(raid)
        or enemy:GetAttribute("Corpse") == true
        or enemy:GetAttribute("Dormant") == true then
        return false
    end
    local hp = enemy:GetAttribute("Health")
    if type(hp) == "number" then return hp > 0 end
    -- During boss introduction the raid can have authoritative boss HP
    -- before the monster model gets its own Health attribute.
    return enemy:GetAttribute("Boss") == true and raidBossActive(raid)
end

local function enemyRoot(enemy)
    if not enemy then return nil end
    local part = enemy:FindFirstChild("Root")
        or enemy:FindFirstChild("HumanoidRootPart")
        or enemy.PrimaryPart
    if part and part:IsA("BasePart") then return part end
    return enemy:FindFirstChildWhichIsA("BasePart", true)
end

local function dungeonEnemy()
    local _, root = getCharacter()
    local raid = currentRaid()
    if not root or not raid then
        clearFarmLock()
        return nil
    end
    local phase = tostring(raid:GetAttribute("PhaseId") or "")
    if farmRaid ~= raid or farmPhase ~= phase then
        -- The previous enemy might still have >0 HP in the client for a
        -- moment after the encounter advances. Never keep that stale lock.
        clearFarmLock()
        farmRaid, farmPhase = raid, phase
    end

    local bossPhase = raidBossActive(raid)
    if bossPhase and bossIntroRunning(raid) then
        clearFarmLock()
        return nil
    end

    local wantBoss = phase == "Boss"
    if validFarmEnemy(lockedEnemy, raid)
        and ((lockedEnemy:GetAttribute("Boss") == true) == wantBoss) then
        local part = enemyRoot(lockedEnemy)
        if part then
            lockedEnemyPart = part
            return lockedEnemy, part
        end
    end

    local now = os.clock()
    if now < nextFarmScan then
        -- Don't push the next scan forward on a cache miss. A boss which
        -- isn't streamed in yet still needs regular re-scans.
        lockedEnemy, lockedEnemyPart = nil, nil
        return nil
    end
    nextFarmScan = now + 0.10
    lockedEnemy, lockedEnemyPart = nil, nil
    local bestDistance = math.huge

    local function consider(enemy)
        if not validFarmEnemy(enemy, raid) then return end
        if (enemy:GetAttribute("Boss") == true) ~= wantBoss then return end
        local part = enemyRoot(enemy)
        if not part then return end
        local distance = (root.Position - part.Position).Magnitude
        if distance < bestDistance then
            bestDistance = distance
            lockedEnemy, lockedEnemyPart = enemy, part
        end
    end

    -- The game keeps boss models under Raids/<raid>/Monsters. Scanning this
    -- first means an untagged newly spawned boss can still be detected.
    local monsters = raid:FindFirstChild("Monsters")
    if monsters then
        for _, enemy in ipairs(monsters:GetChildren()) do
            consider(enemy)
        end
    end
    for _, enemy in ipairs(CollectionService:GetTagged(EnemyTag)) do
        if enemy:IsDescendantOf(raid) then consider(enemy) end
    end

    -- The Boss model can be created a little after PhaseId changes. The
    -- next 0.1-second scan picks it up without switching back to old mobs.
    return lockedEnemy, lockedEnemyPart
end
local function farmDestination(enemyPart)
    local distance = math.clamp(tonumber(settings.FarmDistance) or 7, 3, 20)
    local look = enemyPart.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
    flat = flat.Unit
    local enemyPosition = enemyPart.Position
    local position
    if settings.FarmPosition == "Above" then
        position = enemyPosition + Vector3.new(0, distance + 2, 0)
    elseif settings.FarmPosition == "Below" then
        position = enemyPosition - Vector3.new(0, distance, 0)
    else
        -- Enemy root's LOOK VECTOR defines its actual behind position.
        position = enemyPosition - flat * distance + Vector3.new(0, 2, 0)
    end
    local towardEnemy = Vector3.new(enemyPosition.X - position.X, 0, enemyPosition.Z - position.Z)
    local facing = towardEnemy.Magnitude > 0.01 and towardEnemy.Unit or flat
    return CFrame.lookAt(position, position + facing)
end
-- V18: Arise dead enemies before walking/tweening to the next pack.
-- The game's corpse model contains CorpseId, player-specific Arise attempts,
-- player-specific rank, and the normal Arise proximity distance. This does
-- not send paid/guaranteed requests. All requests are server-validated.
do
    local currentCorpse = nil
    local currentRaidRef = nil
    local retry = setmetatable({}, {__mode = "k"})
    local hpHumanoid = nil
    local hpLast = nil
    local lastDamageAt = -math.huge
    local threatRadius = 35
    local seenKill = setmetatable({}, {__mode = "k"})
    local lastKillAt = -math.huge

    local function setIdle()
        currentCorpse = nil
        AriseCoordinator.target = nil
        AriseCoordinator.status = "Idle"
    end

    AriseCoordinator.reset = function()
        setIdle()
        currentRaidRef = nil
    end

    -- Combining recent health loss with a live-enemy proximity check avoids
    -- stealing movement control while the player is under active pressure.
    local function safe(raid)
        if not raid or raid:GetAttribute("State") == "Cleared"
            or bossIntroRunning(raid)
            or LocalPlayer:GetAttribute("Traveling") or not gameActionReady() then
            return false
        end
        local character, root = getCharacter()
        if not character or not root then return false end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid ~= hpHumanoid then
            hpHumanoid, hpLast = humanoid, humanoid and humanoid.Health
            lastDamageAt = -math.huge
        elseif humanoid then
            if hpLast and humanoid.Health < hpLast - 0.1 then
                lastDamageAt = os.clock()
            end
            hpLast = humanoid.Health
        end
        if os.clock() - lastDamageAt < 1.75 then return false end

        local function nearLiveEnemy(enemy)
            if not enemy:IsA("Model") or not enemy:IsDescendantOf(raid)
                or enemy:GetAttribute("Corpse") == true
                or enemy:GetAttribute("Dormant") == true then return false end
            local hp = enemy:GetAttribute("Health")
            if type(hp) ~= "number" or hp <= 0 then return false end
            local part = enemyRoot(enemy)
            return part ~= nil and (part.Position - root.Position).Magnitude <= threatRadius
        end
        -- Scan both the replicated raid model and the enemy tag. Some bosses
        -- briefly exist before CollectionService assigns their usual tag.
        local monsters = raid:FindFirstChild("Monsters")
        if monsters then
            for _, enemy in ipairs(monsters:GetChildren()) do
                if nearLiveEnemy(enemy) then return false end
            end
        end
        for _, enemy in ipairs(CollectionService:GetTagged(EnemyTag)) do
            if nearLiveEnemy(enemy) then return false end
        end
        return true
    end
    AriseCoordinator.safe = safe

    local function canArise(corpse, raid, now)
        if not corpse:IsA("Model") or not corpse.Parent
            or not corpse:IsDescendantOf(raid)
            or corpse:GetAttribute("Corpse") ~= true
            or corpse:GetAttribute("CorpseId") == nil then return nil end
        local attempts = corpse:GetAttribute("Arise_" .. LocalPlayer.UserId)
        if type(attempts) ~= "number" or attempts <= 0 then return nil end
        local rankNumber = tonumber(corpse:GetAttribute("AriseRank_" .. LocalPlayer.UserId))
            or tonumber(corpse:GetAttribute("Rank"))
        local rank = rankNumber and RankConfig.Ranks[rankNumber]
        if not rank or not settings.AriseRanks[rank.Name] then return nil end
        local part = enemyRoot(corpse)
        if not part then return nil end
        local expires = corpse:GetAttribute("ExpiresAt")
        if type(expires) == "number" and Workspace:GetServerTimeNow() >= expires - 0.6 then
            return nil
        end
        local r = retry[corpse]
        if r and r.blockedUntil and now < r.blockedUntil then return nil end
        return part, rank.Name, attempts
    end

    AriseCoordinator.tick = function(raid)
        if not enabled.AutoArise or not alive or not EventState.farmEnabledFor(raid)
            or not next(settings.AriseRanks) then
            setIdle()
            return false
        end
        if raid ~= currentRaidRef then
            currentRaidRef = raid
            setIdle()
        end
        if not safe(raid) then
            setIdle()
            return false -- return control to combat immediately when unsafe
        end
        local data = dataNow()
        local owned = data and data.shadows and data.shadows.owned
        if type(owned) ~= "table" then setIdle(); return false end
        local count = 0
        for _ in pairs(owned) do count += 1 end
        if count >= ShadowConfig.MaxOwned then
            setIdle()
            return false -- do not hold up farming with a full shadow army
        end
        local _, root = getCharacter()
        if not root then setIdle(); return false end
        local now = os.clock()
        -- Briefly allow newly defeated enemies to acquire their Corpse tag
        -- before advancing to the next pack or the distant boss arena.
        if lockedEnemy and not seenKill[lockedEnemy]
            and (lockedEnemy:GetAttribute("Corpse") == true
                or (type(lockedEnemy:GetAttribute("Health")) == "number"
                    and lockedEnemy:GetAttribute("Health") <= 0)) then
            seenKill[lockedEnemy] = true
            lastKillAt = now
        end
        local part, rankName, attempts
        if currentCorpse then
            part, rankName, attempts = canArise(currentCorpse, raid, now)
        end
        if not part then
            local bestDistance = math.huge
            currentCorpse = nil
            for _, corpse in ipairs(CollectionService:GetTagged(Enums.Tags.Corpse)) do
                local p, name, remaining = canArise(corpse, raid, now)
                if p then
                    local d = (p.Position - root.Position).Magnitude
                    if d < bestDistance then
                        bestDistance = d
                        currentCorpse, part, rankName, attempts = corpse, p, name, remaining
                    end
                end
            end
        end
        if not currentCorpse or not part then
            setIdle()
            if now - lastKillAt < 0.65 then
                AriseCoordinator.status = "Checking fallen shadows before next group"
                return true
            end
            return false -- no matching corpses; go on to the next enemy batch
        end
        local distance = (root.Position - part.Position).Magnitude
        local maxRange = math.max(3, ShadowConfig.Extraction.PromptRange - 1.5)
        if distance > maxRange then
            -- Offset from corpse's root to avoid overlapping its collision box.
            local flat = Vector3.new(root.Position.X - part.Position.X, 0,
                root.Position.Z - part.Position.Z)
            if flat.Magnitude < 0.05 then flat = Vector3.new(1, 0, 0) end
            local pos = part.Position + flat.Unit * 5 + Vector3.new(0, 2.5, 0)
            AriseCoordinator.target = CFrame.lookAt(pos, part.Position)
            AriseCoordinator.status = "Moving to " .. rankName .. " corpse ("
                .. math.floor(distance) .. " studs)"
            return true
        end

        -- Already in prompt range: stop pursuing, send the normal request,
        -- and give the server time to decrement attempts/remove the corpse.
        AriseCoordinator.target = nil
        AriseCoordinator.status = "Arising " .. rankName .. " (" .. attempts .. " attempts left)"
        local info = retry[currentCorpse]
        if not info then
            info = { tries = 0, prevAttempts = attempts, nextAt = 0 }
            retry[currentCorpse] = info
        end
        if attempts < info.prevAttempts then
            info.tries = 0 -- server confirmed progress; allow remaining attempts
        end
        info.prevAttempts = attempts
        if now >= info.nextAt then
            if info.tries >= 3 then
                -- If the server never acknowledges a request, don't stall the
                -- dungeon forever. Skip this corpse temporarily and continue.
                info.blockedUntil = now + 12
                setIdle()
                return false
            end
            info.nextAt = now + 1.1
            info.tries += 1
            local id = currentCorpse:GetAttribute("CorpseId")
            local ok, err = pcall(function()
                ShadowArise:FireServer(id, nil)
            end)
            if not ok then warn("[Arise V18] Between-group Arise:", err) end
        end
        return true
    end

    -- V21: Raid State becomes Cleared on boss death, which used to disable
    -- normal Auto Arise and immediately enable the chest/exit workers.
    -- Hold rewards briefly while the boss corpse replicates, move within
    -- regular Arise range, and spend available NORMAL attempts before exit.
    local postBoss = {
        raid = nil, since = 0, finished = false, corpse = nil,
        previousAttempts = nil, misses = 0, nextTry = 0,
        sawBoss = false, lastStatus = "",
    }

    local function bossDone(message)
        postBoss.finished = true
        AriseCoordinator.target = nil
        AriseCoordinator.postBossActive = false
        AriseCoordinator.status = message or "Boss Arise finished"
        return false
    end

    AriseCoordinator.postBoss = function(raid)
        if not raid or raid:GetAttribute("State") ~= "Cleared" then
            AriseCoordinator.postBossActive = false
            return false
        end
        if postBoss.raid ~= raid then
            postBoss = {
                raid = raid, since = os.clock(), finished = false, corpse = nil,
                previousAttempts = nil, misses = 0, nextTry = 0,
                sawBoss = false, lastStatus = "",
            }
        end
        if postBoss.finished then return false end
        if os.clock() - postBoss.since > 40 then
            return bossDone("Boss Arise timed out; continuing to rewards")
        end
        if not enabled.AutoArise or not next(settings.AriseRanks) then
            return bossDone("Boss Arise skipped (toggle/ranks not selected)")
        end
        if LocalPlayer:GetAttribute("Traveling") then
            return bossDone("Boss Arise skipped (travel started)")
        end
        local character, root = getCharacter()
        if not character or not root then
            AriseCoordinator.postBossActive = true
            AriseCoordinator.status = "Waiting for character before boss Arise"
            return true
        end
        local data = dataNow()
        local owned = data and data.shadows and data.shadows.owned
        if type(owned) == "table" then
            local count = 0
            for _ in pairs(owned) do count += 1 end
            if count >= ShadowConfig.MaxOwned then
                return bossDone("Boss Arise skipped (shadow storage full)")
            end
        end

        local now = os.clock()
        local bossPos = raid:GetAttribute("BossPosition")
        local best, bestPart, bestRank, bestAttempts = nil, nil, nil, nil
        local foundUnselectedBossRank = false
        local foundSelectedSpent = false
        -- The normal corpse tag is the main source. Some client snapshots
        -- apply the tag a frame after setting the Corpse attribute, so also
        -- inspect the current raid's Monsters children.
        local function consider(corpse)
            if not corpse:IsA("Model") or not corpse.Parent
                or corpse:GetAttribute("Corpse") ~= true
                or corpse:GetAttribute("Boss") ~= true
                or corpse:GetAttribute("CorpseId") == nil then return end
            local part = enemyRoot(corpse)
            if not part then return end
            local inRaid = corpse:IsDescendantOf(raid)
            if not inRaid then
                if typeof(bossPos) ~= "Vector3"
                    or (part.Position - bossPos).Magnitude > 65 then return end
            end
            postBoss.sawBoss = true
            local rankIndex = tonumber(corpse:GetAttribute("AriseRank_" .. LocalPlayer.UserId))
                or tonumber(corpse:GetAttribute("Rank"))
            local rank = rankIndex and RankConfig.Ranks[rankIndex]
            if not rank then return end
            if not settings.AriseRanks[rank.Name] then
                foundUnselectedBossRank = true
                return
            end
            local attempts = corpse:GetAttribute("Arise_" .. LocalPlayer.UserId)
            if type(attempts) ~= "number" then return end
            if attempts <= 0 then
                foundSelectedSpent = true
                return
            end
            local expiry = corpse:GetAttribute("ExpiresAt")
            if type(expiry) == "number" and Workspace:GetServerTimeNow() >= expiry - 0.5 then return end
            if not best or (part.Position - root.Position).Magnitude
                < (bestPart.Position - root.Position).Magnitude then
                best, bestPart, bestRank, bestAttempts = corpse, part, rank.Name, attempts
            end
        end
        for _, corpse in ipairs(CollectionService:GetTagged(Enums.Tags.Corpse)) do
            consider(corpse)
        end
        local monsters = raid:FindFirstChild("Monsters")
        if monsters then
            for _, model in ipairs(monsters:GetChildren()) do
                if model:IsA("Model") then consider(model) end
            end
        end
        if not best then
            -- Once the boss is known to have no eligible attempts, or the
            -- corpse disappears after an attempt, go claim the rewards.
            if postBoss.corpse ~= nil then
                return bossDone("Boss Arise complete / no attempts remaining")
            end
            if foundUnselectedBossRank then
                return bossDone("Boss rank not selected")
            end
            if foundSelectedSpent then
                return bossDone("Boss has no Arise attempts remaining")
            end
            local elapsed = now - postBoss.since
            local far = typeof(bossPos) == "Vector3"
                and (root.Position - bossPos).Magnitude > 40
            if not postBoss.waitLimit then
                postBoss.waitLimit = far and 14 or 5
            end
            local waitLimit = postBoss.waitLimit
            if elapsed >= waitLimit then
                return bossDone("Boss corpse not available; continuing to rewards")
            end
            AriseCoordinator.postBossActive = true
            AriseCoordinator.status = "Waiting for boss corpse (" .. math.ceil(waitLimit - elapsed) .. "s)"
            -- Walking toward the advertised boss arena allows StreamingEnabled
            -- to replicate the corpse even when it is not initially visible.
            if far then
                local approach = bossPos + Vector3.new(0, 3, 0)
                local facing = Vector3.new(bossPos.X - root.Position.X, 0,
                    bossPos.Z - root.Position.Z)
                if facing.Magnitude < 0.1 then facing = Vector3.new(0, 0, -1) end
                AriseCoordinator.target = CFrame.lookAt(approach, approach + facing.Unit)
                AriseCoordinator.status = "Approaching boss corpse arena"
            else
                AriseCoordinator.target = nil
            end
            return true
        end

        if postBoss.corpse ~= best then
            postBoss.corpse = best
            postBoss.previousAttempts = bestAttempts
            postBoss.misses = 0
            postBoss.nextTry = 0
        elseif postBoss.previousAttempts and bestAttempts < postBoss.previousAttempts then
            -- A reduced attempt count confirms the server handled our request.
            postBoss.misses = 0
        end
        postBoss.previousAttempts = bestAttempts
        local distance = (root.Position - bestPart.Position).Magnitude
        local maxDistance = math.max(3, ShadowConfig.Extraction.PromptRange - 1.5)
        AriseCoordinator.postBossActive = true
        if distance > maxDistance then
            local away = Vector3.new(root.Position.X - bestPart.Position.X,
                0, root.Position.Z - bestPart.Position.Z)
            if away.Magnitude < 0.1 then away = Vector3.new(1,0,0) end
            local pos = bestPart.Position + away.Unit * 5 + Vector3.new(0,2.5,0)
            AriseCoordinator.target = CFrame.lookAt(pos, bestPart.Position)
            AriseCoordinator.status = "Approaching " .. bestRank .. " boss corpse ("
                .. math.floor(distance) .. " studs)"
            return true
        end
        AriseCoordinator.target = nil
        AriseCoordinator.status = "Arising " .. bestRank .. " boss ("
            .. bestAttempts .. " attempts left)"
        if now >= postBoss.nextTry then
            if postBoss.misses >= 3 then
                return bossDone("Boss Arise requests unconfirmed; continuing to rewards")
            end
            postBoss.nextTry = now + 1.1
            postBoss.misses += 1
            local id = best:GetAttribute("CorpseId")
            local ok, err = pcall(function()
                ShadowArise:FireServer(id, nil)
            end)
            if not ok then warn("[Arise v21] Boss Arise:", err) end
        end
        return true
    end
end

-- Ask the client to stream around either a distant enemy-group goal or the
-- boss marker. Actual movement remains the fallback if streaming is denied.
local function requestFarmStreaming(position)
    local now = os.clock()
    if now - lastBossStreamRequest < 4 then return end
    lastBossStreamRequest = now
    task.spawn(function()
        pcall(function()
            LocalPlayer:RequestStreamAroundAsync(position, 2)
        end)
    end)
end

-- V30: use the SAME replicated enemy goal markers as RaidMarkersController.
-- Each EnemyGoal_<packId> has an EnemiesLeft_<packId> counter. This avoids
-- stopping at the entrance merely because the far-away monster models
-- haven't streamed in. Keep a chosen pack until cleared, so we don't jitter
-- between several distant packs every frame.
Scheduler.findEnemyGoal = function(raid, root)
    local state = Scheduler.seekEnemyGoal
    if not raid or not root or raid:GetAttribute("PhaseId") == "Boss" then
        state.raid, state.id, state.position, state.remaining = nil, nil, nil, 0
        return nil
    end
    if state.raid == raid and state.id then
        local position = raid:GetAttribute("EnemyGoal_" .. state.id)
        local remaining = tonumber(raid:GetAttribute("EnemiesLeft_" .. state.id)) or 0
        if typeof(position) == "Vector3" and remaining > 0 then
            state.position, state.remaining = position, remaining
            return state.id, position, remaining
        end
    end
    local nearestId, nearestPosition, nearestCount = nil, nil, 0
    local shortest = math.huge
    for name, position in pairs(raid:GetAttributes()) do
        local id = string.match(name, "^EnemyGoal_(.+)$")
        if id and typeof(position) == "Vector3" then
            local count = tonumber(raid:GetAttribute("EnemiesLeft_" .. id)) or 0
            if count > 0 then
                local distance = (root.Position - position).Magnitude
                if distance < shortest then
                    nearestId, nearestPosition, nearestCount = id, position, count
                    shortest = distance
                end
            end
        end
    end
    state.raid, state.id = raid, nearestId
    state.position, state.remaining = nearestPosition, nearestCount
    return nearestId, nearestPosition, nearestCount
end

-- Heartbeat tracks real enemies when streamed in; otherwise it approaches
-- server-published enemy pack goals (or BossPosition during the boss phase).
local function farmHeartbeat(dt)
    if not alive or not isInRaid()
        or (not EventState.farmEnabledFor(currentRaid())
            and not AriseCoordinator.postBossActive) then
        removeBelowPlatform()
        MovementNoclip.set("farm", nil, false)
        return
    end
    local raid = currentRaid()
    if not raid or (raid:GetAttribute("State") == "Cleared"
            and not AriseCoordinator.postBossActive)
        or LocalPlayer:GetAttribute("Traveling")
        or SkillState.Cinematic or bossIntroRunning(raid) then
        removeBelowPlatform()
        MovementNoclip.set("farm", nil, false)
        return
    end
    local character, root = getCharacter()
    if not character or not root then
        removeBelowPlatform()
        MovementNoclip.set("farm", nil, false)
        return
    end
    if enabled.AutoDodge and Scheduler.dodge and Scheduler.dodge.active then
        -- The dodge worker temporarily owns character positioning.
        removeBelowPlatform()
        MovementNoclip.set("farm", nil, false)
        return
    end

    local seekingLantern = not AriseCoordinator.postBossActive
        and enabled.LightLanterns and EventState.isHalloweenRaid(raid)
        and EventState.eventGoalRaid == raid and typeof(EventState.eventGoalPosition) == "Vector3"
    local seekingArise = not seekingLantern and enabled.AutoArise
        and AriseCoordinator.target ~= nil
    local part = not seekingLantern and not seekingArise
        and validFarmEnemy(lockedEnemy, raid) and enemyRoot(lockedEnemy) or nil
    local seekingBoss = not seekingLantern and not seekingArise and part == nil
        and farmSeekBossPosition ~= nil and raidBossActive(raid)
    local packGoal = Scheduler.seekEnemyGoal
    local seekingPack = not seekingLantern and not seekingArise and part == nil
        and not seekingBoss and packGoal.raid == raid
        and packGoal.position ~= nil
        and (tonumber(raid:GetAttribute("EnemiesLeft_" .. tostring(packGoal.id))) or 0) > 0
    if not part and not seekingBoss and not seekingPack
        and not seekingLantern and not seekingArise then
        removeBelowPlatform()
        MovementNoclip.set("farm", nil, false)
        return
    end

    local desired
    if seekingLantern then
        local p = EventState.eventGoalPosition + Vector3.new(0, 3, 0)
        local toward = Vector3.new(EventState.eventGoalPosition.X - root.Position.X,
            0, EventState.eventGoalPosition.Z - root.Position.Z)
        local face = toward.Magnitude > 0.01 and toward.Unit or root.CFrame.LookVector
        desired = CFrame.lookAt(p, p + face)
    elseif seekingArise then
        -- Between groups: move into normal Arise range before next pack.
        -- The same Tween/Teleport/Legit and noclip movement applies.
        desired = AriseCoordinator.target
    elseif part then
        lockedEnemyPart = part
        desired = farmDestination(part)
    elseif seekingPack then
        -- Aim at the center of the next enemy group even before its models
        -- replicate. The usual character noclip/tween/teleport logic applies.
        local center = packGoal.position
        local approach = center + Vector3.new(0, 3, 0)
        local horizontal = Vector3.new(center.X - root.Position.X,
            0, center.Z - root.Position.Z)
        local face = horizontal.Magnitude > 0.01 and horizontal.Unit
            or root.CFrame.LookVector
        desired = CFrame.lookAt(approach, approach + face)
    else
        -- Position from the server's boss arena marker. Aim toward the arena
        -- instead of needing an enemy model that may still be streamed out.
        local center = farmSeekBossPosition
        local approach = center + Vector3.new(0, 3.5, 0)
        local separation = (root.Position - approach).Magnitude
        if separation <= 8 then
            MovementNoclip.set("farm", nil, false)
            removeBelowPlatform()
            return -- Close enough to await the monster's replication.
        end
        local facing = Vector3.new(center.X - approach.X, 0, center.Z - approach.Z)
        local look = facing.Magnitude > 0.01 and facing.Unit or root.CFrame.LookVector
        desired = CFrame.lookAt(approach, approach + look)
    end
    local offset = desired.Position - root.Position
    local distance = offset.Magnitude
    local method = settings.FarmMethod
    -- Keep collision disabled for the WHOLE pursuit in Tween/Teleport,
    -- regardless of farm position. Below remains noclip in every method.
    local needsNoclip = method == "Tween" or method == "Teleport"
        or (part ~= nil and settings.FarmPosition == "Below")
    MovementNoclip.set("farm", character, needsNoclip)
    if needsNoclip and (method == "Tween" or method == "Teleport") then
        -- Prevent a previous contact impulse from pushing us into a wall.
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    if method == "Teleport" then
        if distance > 0.2 then root.CFrame = desired
        else
            root.CFrame = CFrame.new(root.Position) * (desired - desired.Position)
        end
    elseif method == "Tween" then
        -- Linear, speed-limited movement evaluated every Heartbeat.
        -- No lag from frozen tween end positions, and no tween cancel spam.
        local speed = math.clamp(tonumber(settings.TweenSpeed) or 65, 15, 250)
        local step = math.min(distance, speed * math.clamp(dt, 0, 0.1))
        local newPosition = distance > 0.001
            and (root.Position + offset.Unit * step) or root.Position
        local facing = desired.LookVector
        local currentLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
        local targetLook = Vector3.new(facing.X, 0, facing.Z)
        if currentLook.Magnitude < 0.01 then currentLook = targetLook end
        local blend = 1 - math.exp(-18 * math.clamp(dt, 0, 0.1))
        local blendedLook = currentLook:Lerp(targetLook, blend)
        if blendedLook.Magnitude < 0.01 then blendedLook = targetLook end
        root.CFrame = CFrame.lookAt(newPosition, newPosition + blendedLook.Unit)
    else -- Legit: continuously re-issue MoveTo to the moving target.
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and (os.clock() - lastLegitMove > 0.2
            or not lastLegitTarget or (lastLegitTarget - desired.Position).Magnitude > 2) then
            lastLegitMove = os.clock()
            lastLegitTarget = desired.Position
            humanoid:MoveTo(desired.Position)
        end
    end
    if part and settings.FarmPosition == "Below" then
        -- Farm noclip is already active, before movement, for Below mode.
        -- Keep gravity and lingering momentum from pulling a noncolliding
        -- character away from the desired position between Heartbeat ticks.
        if method ~= "Legit" then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        else
            -- There can be no physical standing with all parts noclip.
            -- Hold the character at the calculated location in Below mode.
            root.CFrame = desired
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        placeBelowPlatform(root)
    else
        removeBelowPlatform()
    end
end
local function tickFarm()
    if not isInRaid() then stopMovement(); return end
    local raid = currentRaid()
    if not raid or not EventState.farmEnabledFor(raid) or raid:GetAttribute("State") == "Cleared" then
        stopMovement()
        return
    end
    local character, root = getCharacter()
    if not character or not root then
        farmStatusText = "Waiting for active character"
        return
    end
    -- During the Halloween lantern phase, farming temporarily yields to
    -- Auto Light Lanterns; pursuit resumes as soon as the lantern is lit.
    if enabled.LightLanterns and EventState.isHalloweenRaid(raid)
        and EventState.eventGoalRaid == raid and EventState.eventGoalPosition then
        farmSeekBossPosition = nil
        Scheduler.seekEnemyGoal.position = nil
        farmStatusText = "Approaching lantern " .. tostring(EventState.eventGoalId or "")
        if not farmHeartbeatConnection then
            farmHeartbeatConnection = RunService.Heartbeat:Connect(farmHeartbeat)
        end
        return
    end
    -- Before advancing to a different pack, collect eligible corpses only
    -- while enemies cannot hit us. Combat takes priority if danger returns.
    if AriseCoordinator.tick(raid) then
        clearFarmLock()
        farmSeekBossPosition = nil
        Scheduler.seekEnemyGoal.position = nil
        farmStatusText = AriseCoordinator.status
        if not farmHeartbeatConnection then
            farmHeartbeatConnection = RunService.Heartbeat:Connect(farmHeartbeat)
        end
        return
    end
    local enemy, part = dungeonEnemy()
    if enemy and part then
        -- A replicated enemy model takes priority over any fallback marker.
        farmSeekBossPosition = nil
        Scheduler.seekEnemyGoal.position = nil
        farmStatusText = (raidBossActive(raid) and "Locked onto boss" or "Locked onto enemy")
            .. " (" .. math.floor((root.Position - part.Position).Magnitude) .. " studs)"
    else
        -- The server advertises this position to the same raid marker system
        -- responsible for the BOSS ARENA marker visible in your screenshot.
        local bossPosition = raid:GetAttribute("BossPosition")
        if raidBossActive(raid) and typeof(bossPosition) == "Vector3"
            and not bossIntroRunning(raid) then
            farmSeekBossPosition = bossPosition
            Scheduler.seekEnemyGoal.position = nil
            requestFarmStreaming(bossPosition)
            local distance = math.floor((root.Position - bossPosition).Magnitude)
            farmStatusText = "Approaching boss arena (" .. distance .. " studs)"
        elseif not raidBossActive(raid) then
            farmSeekBossPosition = nil
            local packId, packPosition, count = Scheduler.findEnemyGoal(raid, root)
            if packPosition then
                -- The game's own distant ENEMY markers are backed by this
                -- position even if there are currently no tagged enemy models.
                requestFarmStreaming(packPosition)
                local distance = math.floor((root.Position - packPosition).Magnitude)
                farmStatusText = "Approaching enemy group " .. tostring(packId)
                    .. " (" .. distance .. " studs; " .. count .. " enemies)"
            else
                farmStatusText = "Waiting for enemy groups to spawn"
                return
            end
        else
            farmSeekBossPosition = nil
            Scheduler.seekEnemyGoal.position = nil
            farmStatusText = bossIntroRunning(raid) and "Waiting for boss intro"
                or "Waiting for boss position"
            return
        end
    end
    if not farmHeartbeatConnection then
        farmHeartbeatConnection = RunService.Heartbeat:Connect(farmHeartbeat)
    end
    -- The actual enemy's location, not the arena marker, governs attacks.
    if enemy and part and gameActionReady()
        and (root.Position - part.Position).Magnitude < ATTACK_RANGE then
        directAttack(character)
        if enabled.AutoAbility then directAbility(character, root) end
    end
end

-- Raid rewards are claimed through an actual ProximityPrompt, not an
-- unverified chest remote. RaidChestController identifies this prompt as
-- RewardChest.ClaimChest; the chest's claimed status is player attribute
-- RaidChestClaimed == the active raid's name.
local chestPromptBusy = false
local lastChestTry = -math.huge
local chestTravelStarted = false
local lastChestRaid = nil
local function clearChestTravel()
    chestTravelStarted = false
    lastChestRaid = nil
    MovementNoclip.set("chest", nil, false)
    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween = nil
    tweenTarget = nil
end

-- Stand BESIDE the chest (not on its center/top) to avoid physics launches.
local function safeChestStandingPosition(chest, root, prompt, character)
    local away = Vector3.new(root.Position.X - chest.Position.X, 0, root.Position.Z - chest.Position.Z)
    if away.Magnitude < 0.2 then
        away = Vector3.new(chest.CFrame.LookVector.X, 0, chest.CFrame.LookVector.Z)
    end
    if away.Magnitude < 0.2 then away = Vector3.new(1, 0, 0) end
    away = away.Unit
    -- Stay within prompt range, while clearing the chest's bounds.
    local halfExtent = math.max(chest.Size.X, chest.Size.Z) * 0.5
    local usableRadius = math.max(3, (prompt.MaxActivationDistance or 12) - 2)
    local lateral = math.min(usableRadius - 0.5, math.max(halfExtent + 2, 4))
    lateral = math.max(2.5, lateral)
    local projected = chest.Position + away * lateral
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, chest }
    local origin = projected + Vector3.new(0, 18, 0)
    local hit = Workspace:Raycast(origin, Vector3.new(0, -60, 0), params)
    local y = hit and hit.Position.Y + 3.1 or chest.Position.Y + 2.5
    local destination = Vector3.new(projected.X, y, projected.Z)
    if (destination - chest.Position).Magnitude > usableRadius then
        -- Honor the actual prompt range; fall back to chest level if needed.
        destination = chest.Position + away * math.max(2, usableRadius - 1) + Vector3.new(0, 2.0, 0)
    end
    return destination
end

local function moveToChest(root, character, chest, prompt)
    if not chestTravelStarted then
        stopMovement() -- once only; doesn't continually cancel the new tween
        chestTravelStarted = true
    end
    local destination = safeChestStandingPosition(chest, root, prompt, character)
    MovementNoclip.set("chest", character, settings.FarmMethod ~= "Legit")
    if settings.FarmMethod == "Legit" then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and (os.clock() - lastLegitMove > 0.35
            or not lastLegitTarget or (lastLegitTarget - destination).Magnitude > 2) then
            lastLegitMove = os.clock()
            lastLegitTarget = destination
            humanoid:MoveTo(destination)
        end
        return
    end
    -- Both Tween and Teleport modes use a controlled, short arrival tween.
    -- Instant teleporting into the chest caused character physics flings.
    local speed = settings.FarmMethod == "Tween"
        and math.clamp(tonumber(settings.TweenSpeed) or 65, 15, 250) or 95
    if not tweenTarget or (tweenTarget - destination).Magnitude > 2.5 then
        if activeTween then pcall(function() activeTween:Cancel() end) end
        tweenTarget = destination
        local duration = math.clamp((root.Position - destination).Magnitude / speed, 0.14, 8)
        local lookAt = Vector3.new(chest.Position.X, destination.Y, chest.Position.Z)
        if (lookAt - destination).Magnitude < 0.01 then lookAt = destination + Vector3.new(0, 0, -1) end
        local cf = CFrame.lookAt(destination, lookAt)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        activeTween = TweenService:Create(root, TweenInfo.new(duration,
            Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = cf })
        activeTween:Play()
    end
end

local function tickCollectChest(raid)
    if not enabled.CollectChest or not raid then return end
    if raid:GetAttribute("State") ~= "Cleared" then return end
    if raid:GetAttribute("ChestPosition") == nil then return end
    if lastChestRaid ~= raid then
        clearChestTravel()
        lastChestRaid = raid
    end
    if LocalPlayer:GetAttribute("RaidChestClaimed") == raid.Name then
        if chestTravelStarted then clearChestTravel() end
        return
    end
    if LocalPlayer:GetAttribute("Traveling") or chestPromptBusy then return end
    local chest = raid:FindFirstChild("RewardChest")
    if not chest or not chest:IsA("BasePart") then return end
    local character, root = getCharacter()
    if not character or not root then return end
    local prompt = chest:FindFirstChild("ClaimChest")
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    local range = math.max(3, (prompt.MaxActivationDistance or 14) - 1.5)
    if (root.Position - chest.Position).Magnitude > range then
        moveToChest(root, character, chest, prompt)
        return
    end
    -- Stop smoothly and trigger the chest after arriving within reach.
    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween, tweenTarget = nil, nil
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    if not prompt.Enabled or os.clock() - lastChestTry < 2.5 then return end
    lastChestTry = os.clock()
    chestPromptBusy = true
    task.spawn(function()
        local ok, err = pcall(function()
            if type(fireproximityprompt) == "function" then
                fireproximityprompt(prompt, (prompt.HoldDuration or 0) + 0.1)
            else
                prompt:InputHoldBegin()
                task.wait((prompt.HoldDuration or 0) + 0.15)
                prompt:InputHoldEnd()
            end
        end)
        if not ok then warn("[Arise v14] Chest claim prompt: " .. tostring(err)) end
        chestPromptBusy = false
    end)
end

-- PortalPromptController creates a client-side PortalPrompt for tagged Gate
-- models with Kind = "Exit" inside the raid. The raid also publishes
-- ExitPosition, which RaidMarkersController uses for the "EXIT PORTAL" marker.
-- We travel to the real portal before activating the prompt. If the portal's
-- client-generated prompt is unavailable, request Raid.Exit only *at* the
-- exit location, rather than from anywhere in the dungeon.
local lastExitPromptAttempt = -math.huge
local exitPromptBusy = false
local function findRaidExitPortal(raid)
    for _, gate in ipairs(CollectionService:GetTagged(Enums.Tags.Gate)) do
        if gate:IsA("Model") and gate:GetAttribute("Kind") == "Exit"
            and gate:IsDescendantOf(raid) then
            local frame = gate:GetAttribute("Frame")
            local destination = typeof(frame) == "CFrame" and frame.Position or gate:GetPivot().Position
            local prompt = gate:FindFirstChild("PortalPrompt", true)
            if prompt and not prompt:IsA("ProximityPrompt") then prompt = nil end
            return destination, prompt
        end
    end
    local pos = raid:GetAttribute("ExitPosition")
    if typeof(pos) == "Vector3" then return pos, nil end
    return nil, nil
end

local function moveToExitPortal(character, root, portalPosition)
    local destination = portalPosition + Vector3.new(0, 2.5, 0)
    local method = settings.FarmMethod
    MovementNoclip.set("exit", character, method ~= "Legit")
    if method == "Legit" then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and (os.clock() - lastLegitMove > 0.3
            or not lastLegitTarget or (lastLegitTarget - destination).Magnitude > 2) then
            lastLegitMove = os.clock()
            lastLegitTarget = destination
            humanoid:MoveTo(destination)
        end
    elseif method == "Tween" then
        if not tweenTarget or (tweenTarget - destination).Magnitude > 3 then
            if activeTween then pcall(function() activeTween:Cancel() end) end
            tweenTarget = destination
            local speed = math.clamp(tonumber(settings.TweenSpeed) or 65, 15, 250)
            local duration = math.clamp((root.Position - destination).Magnitude / speed, 0.1, 20)
            activeTween = TweenService:Create(root,
                TweenInfo.new(duration, Enum.EasingStyle.Linear),
                { CFrame = CFrame.lookAt(destination, portalPosition) })
            activeTween:Play()
        end
    else -- Teleport
        if activeTween then pcall(function() activeTween:Cancel() end) end
        activeTween = nil
        tweenTarget = nil
        root.CFrame = CFrame.new(destination)
    end
end

local function tickLeaveDungeon(raid)
    if not enabled.LeaveDungeon or not raid then return end
    if raid:GetAttribute("State") ~= "Cleared" then return end
    if raid:GetAttribute("Tutorial") == true then return end
    if raid:GetAttribute("ChestPosition") ~= nil
        and LocalPlayer:GetAttribute("RaidChestClaimed") ~= raid.Name then
        return -- The game itself warns that the reward chest is unopened.
    end
    if LocalPlayer:GetAttribute("Traveling") or exitPromptBusy then return end
    -- The exit portal becomes available during the Exit phase.
    if raid:GetAttribute("PhaseId") ~= "Exit" then return end
    local character, root = getCharacter()
    if not character or not root then return end
    local portalPosition, prompt = findRaidExitPortal(raid)
    if not portalPosition then return end
    local activationDistance = math.min(7,
        prompt and math.max(3, prompt.MaxActivationDistance - 3)
            or (DungeonConfig.Exit.Radius - 2))
    if (root.Position - portalPosition).Magnitude > activationDistance then
        moveToExitPortal(character, root, portalPosition)
        return
    end
    if os.clock() - lastExitPromptAttempt < 2.5 then return end
    lastExitPromptAttempt = os.clock()
    if activeTween then pcall(function() activeTween:Cancel() end) end
    activeTween = nil
    tweenTarget = nil
    if prompt then
        if not prompt.Enabled then return end
        exitPromptBusy = true
        task.spawn(function()
            local ok, err = pcall(function()
                if type(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt, (prompt.HoldDuration or 0) + 0.1)
                else
                    prompt:InputHoldBegin()
                    task.wait((prompt.HoldDuration or 0) + 0.15)
                    prompt:InputHoldEnd()
                end
            end)
            if not ok then warn("[Arise V10] Exit portal prompt:", err) end
            exitPromptBusy = false
        end)
    else
        -- Valid only after we've actually arrived in the exit-portal area.
        attempt("PortalExit:" .. raid.Name, 3, function()
            RaidExit:FireServer()
        end)
    end
end


