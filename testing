            local function ReadLastMatchKey()

                if type(readfile) == "function"
                    and type(isfile) == "function"
                    and isfile(LastMatchFile)
                then

                    local Success, Value =
                        pcall(
                            readfile,
                            LastMatchFile
                        )


                    if Success then
                        return tostring(Value)
                    end
                end


                return tostring(
                    GENV.__AZ_WEBHOOK_LAST_MATCH_KEY
                    or ""
                )
            end


            local function SaveLastMatchKey(Key)

                GENV.__AZ_WEBHOOK_LAST_MATCH_KEY =
                    Key


                if type(writefile) == "function" then

                    if makefolder then
                        pcall(makefolder, "AnimeZero")
                    end


                    pcall(
                        writefile,
                        LastMatchFile,
                        tostring(Key)
                    )
                end
            end


            -- Runtime-level state: a single dispatch path is shared by both
            -- the watcher and the end-action vote guard.
            local LastSentKey = ReadLastMatchKey()
            local LastNotice = nil
            local LastNoticeAt = 0
            local LastFailureAt = 0

            local function Notice(Status)
                local Now = os.clock()
                if Status ~= LastNotice or Now - LastNoticeAt >= 30 then
                    LastNotice = Status
                    LastNoticeAt = Now
                    print("[Anime Zero][Webhook] " .. tostring(Status))
                end
            end

            local function ReadCompletedResult()
                local State = GetRunState()
                if not State then
                    return nil, nil, nil, "Waiting for run modules"
                end

                local Participant = GetParticipant(State)
                if not Participant then
                    return nil, nil, nil, "Waiting for player result data"
                end

                local Status = tostring(ReadLeaf(Participant.status) or "active")
                if Status == "active" then
                    return nil, nil, nil, "Watching active match"
                end

                local FinishedAt = ReadLeaf(State.finishedAt)
                    or ReadLeaf(Participant.finishedAt)
                    or ReadLeaf(State.resultEndsAt)

                if FinishedAt == nil then
                    return nil, nil, nil, "Waiting for final result"
                end

                local RunStartedAt = tonumber(ReadLeaf(State.startedAt))
                if not RunStartedAt or RunStartedAt <= 0 then
                    RunStartedAt = tonumber(ReadLeaf(Participant.joinedAt))
                end
                if not RunStartedAt or RunStartedAt <= 0 then
                    RunStartedAt = tonumber(FinishedAt) or 0
                end

                local Key = tostring(game.PlaceId)
                    .. ":" .. tostring(RunStartedAt)
                    .. ":" .. tostring(Status)

                return State, Participant, Key, Status
            end

            local function BeginReport(Participant, Key, Status)
                if Key == LastSentKey or Runtime.PendingKey == Key then
                    return
                end

                local Now = os.clock()
                if Runtime.LastAttemptKey == Key
                    and Now - (Runtime.LastAttemptAt or 0) < 3
                then
                    return
                end

                Runtime.LastAttemptKey = Key
                Runtime.LastAttemptAt = Now
                Runtime.PendingKey = Key
                Runtime.PendingAt = Now
                Notice("Match " .. Status .. " detected; sending report")

                task.spawn(function()
                    -- Give payout totals a short replication beat while the
                    -- end-action guard keeps the result store available.
                    task.wait(0.35)
                    local Ok, Sent, Message = pcall(Send, Participant, false)
                    if Ok and Sent then
                        LastSentKey = Key
                        SaveLastMatchKey(Key)
                        Notice("Match report sent to Discord")
                    else
                        if os.clock() - LastFailureAt > 2 then
                            LastFailureAt = os.clock()
                            warn(
                                "[Anime Zero][Webhook] Match report failed:",
                                Ok and tostring(Message) or tostring(Sent)
                            )
                        end
                    end
                    if Runtime.PendingKey == Key then
                        Runtime.PendingKey = nil
                    end
                end)
            end

            local function PollResult()
                if not Settings.WebhookEnabled then
                    Notice("Disabled (test button bypasses this switch)")
                    return true
                end
                if not IsDiscordWebhook(Settings.WebhookURL) then
                    Notice("Enabled, but Discord URL is missing or invalid")
                    return true
                end

                local State, Participant, Key, Status = ReadCompletedResult()
                if not Key then
                    Notice(Status)
                    return true
                end
                if Key == LastSentKey then
                    Notice("Already reported this match")
                    return true
                end

                BeginReport(Participant, Key, Status)
                return false
            end

            -- Both normal and Raid end-action loops call this BEFORE voting
            -- Retry / Next / Leave. It delays travel only briefly and never
            -- blocks a run indefinitely if Discord has an outage.
            GENV.__AZ_WEBHOOK_BEFORE_END_ACTION = function()
                if not Runtime.Active
                    or not Settings.WebhookEnabled
                    or not IsDiscordWebhook(Settings.WebhookURL)
                then
                    return true
                end

                local State, Participant, Key, Status = ReadCompletedResult()
                if not Key then
                    return true
                end
                if Key == LastSentKey then
                    return true
                end

                if Runtime.VoteHoldKey ~= Key then
                    Runtime.VoteHoldKey = Key
                    Runtime.VoteHoldAt = os.clock()
                end

                BeginReport(Participant, Key, Status)

                if os.clock() - Runtime.VoteHoldAt >= 5 then
                    Notice("Report timeout; allowing game retry/leave")
                    return true
                end

                return false
            end

            -- Manually send actual finished-match data while its result store
            -- is still available; unlike the ordinary connection test.
            GENV.__AZ_WEBHOOK_SEND_RESULT = function()
                local State, Participant, Key, Status = ReadCompletedResult()
                if not Key then
                    return false, "No finished match data is available: " .. tostring(Status)
                end
                local Ok, Sent, Message = pcall(Send, Participant, false)
                if Ok and Sent then
                    LastSentKey = Key
                    SaveLastMatchKey(Key)
                    Notice("Match report sent manually")
                    return true, tostring(Message)
                end
                return false, Ok and tostring(Message) or tostring(Sent)
            end

            Notice("Reporter started; waiting for settings and match data")
            task.spawn(function()
                while Runtime.Active do
                    task.wait(0.15)
                    local Good, Err = pcall(PollResult)
                    if not Good then
                        local Now = os.clock()
                        if Now - LastFailureAt >= 8 then
                            LastFailureAt = Now
                            warn("[Anime Zero][Webhook] Watcher error:", tostring(Err))
                        end
                    end
                end
            end)
        end)()


        task.spawn(function()

            task.wait(2)


            while GENV.__AZ_PLAYER_MISC_SETTINGS
                == PlayerMiscSettings
            do

                local Save =
                    GENV.__AZ_PLAYER_MISC_SAVE_FUNCTION


                if type(Save) == "function" then
                    pcall(Save)
                end


                task.wait(4)
            end
        end)

        Window:CreateSection({
            name = "TOOLS",
        })

        local PlayerTab =
            Window:CreateTab({
                name = "Player",
            })


        --//====================================================
        --// PLAYER PRESETS | 4 EQUIPMENT SLOTS + 1 TITLE
        --// Uses the game's own slot/config modules and the owned account
        --// inventory. A button press makes a finite, acknowledged equip pass.
        --// This intentionally does not start crafting or automation tasks.
        --//====================================================
        ;(function()
            local PresetNames = {
                "Full DMG", "Full EXP", "Full Drop", "Full Coins",
                "Full Crit", "Full CDR", "Full HP", "Balanced",
            }
            local PresetWeights = {
                ["Full DMG"] = {
                    ["Damage"] = 100,
                    ["Critical Chance"] = 2, ["Critical Damage"] = 2,
                    ["Attack Speed"] = 1, ["Cooldown Reduction"] = 1,
                },
                ["Full EXP"] = {
                    ["Exp"] = 100, ["Damage"] = 0.3,
                    ["Drop Rate"] = 0.1,
                },
                ["Full Drop"] = {
                    ["Drop Rate"] = 100, ["Damage"] = 0.3,
                    ["Exp"] = 0.1,
                },
                ["Full Coins"] = {
                    ["Coins"] = 100, ["Damage"] = 0.3,
                },
                ["Full Crit"] = {
                    ["Critical Chance"] = 100,
                    ["Critical Damage"] = 12, ["Damage"] = 1,
                },
                ["Full CDR"] = {
                    ["Cooldown Reduction"] = 100,
                    ["Attack Speed"] = 1, ["Damage"] = 0.3,
                },
                ["Full HP"] = {
                    ["HP"] = 100, ["Defense"] = 30,
                    ["Damage"] = 0.3,
                },
                ["Balanced"] = {
                    ["Damage"] = 6, ["HP"] = 3,
                    ["Defense"] = 3, ["Exp"] = 2,
                    ["Drop Rate"] = 2, ["Coins"] = 2,
                    ["Critical Chance"] = 3,
                    ["Critical Damage"] = 2,
                    ["Cooldown Reduction"] = 3,
                    ["Attack Speed"] = 2,
                },
            }
            local Selected = "Full DMG"
            local StorageKey = "__AZ_PLAYER_PRESET_V1"
            local StorageFile = "AnimeZero/player_preset_v1.json"
            local TeleportService = game:GetService("TeleportService")
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local HttpService = game:GetService("HttpService")
            local Previous = GENV.__AZ_PLAYER_PRESET_RUNTIME
            if type(Previous) == "table" then
                Previous.Active = false
            end
            local State = {Active = true, Busy = false}
            GENV.__AZ_PLAYER_PRESET_RUNTIME = State

            local function Allowed(Name)
                return type(Name) == "string"
                    and PresetWeights[Name] ~= nil
            end
            local Saved = GENV[StorageKey]
            if not Allowed(Saved) then
                pcall(function()
                    Saved = TeleportService:GetTeleportSetting(StorageKey)
                end)
            end
            if not Allowed(Saved) and type(isfile) == "function"
                and type(readfile) == "function" and isfile(StorageFile)
            then
                pcall(function()
                    local Data = HttpService:JSONDecode(readfile(StorageFile))
                    Saved = type(Data) == "table" and Data.Preset or nil
                end)
            end
            if Allowed(Saved) then Selected = Saved end

            local function Persist()
                GENV[StorageKey] = Selected
                pcall(function()
                    TeleportService:SetTeleportSetting(StorageKey, Selected)
                end)
                if type(writefile) == "function" then
                    pcall(function()
                        if type(makefolder) == "function" then
                            makefolder("AnimeZero")
                        end
                        writefile(StorageFile, HttpService:JSONEncode({Preset = Selected}))
                    end)
                end
            end
            Persist()

            local function Notice(Message, Seconds)
                print("[Anime Zero][Presets] " .. tostring(Message))
                QueueNotification("Presets", tostring(Message), Seconds or 5)
            end
            local function Modules()
                local Global = ReplicatedStorage:FindFirstChild("global")
                local Assets = ReplicatedStorage:FindFirstChild("assets")
                local Lobby = ReplicatedStorage:FindFirstChild("lobby")
                local Stores = Global and Global:FindFirstChild("stores")
                local Config = Assets and Assets:FindFirstChild("config")
                if not Stores or not Config or not Lobby then return nil end
                local Ok, Result = pcall(function()
                    return {
                        Accounts = require(Stores:WaitForChild("accountNamespace", 5)),
                        Accessories = require(Config:WaitForChild("accessoryConfig", 5)),
                        Slots = require(Config:WaitForChild("accessorySlotConfig", 5)),
                        Titles = require(Config:WaitForChild("titleConfig", 5)),
                        Packets = require(Lobby:WaitForChild("packets", 5)),
                    }
                end)
                return Ok and Result or nil
            end
            local function DataOf(M)
                local Ok, Data = pcall(function()
                    local Account = M.Accounts.getLocalPlayerAccount()
                    return Account and Account:toTable() or nil
                end)
                return Ok and Data or nil
            end
            local function Score(Definition, Preset)
                local Weights = PresetWeights[Preset]
                if not Weights or type(Definition) ~= "table" then
                    return -math.huge
                end
                local Total = 0
                for _, Buff in ipairs(Definition.Buffs or {}) do
                    Total = Total
                        + (tonumber(Weights[tostring(Buff.Type)]) or 0)
                        * (tonumber(Buff.Percent or Buff.Amount) or 0)
                end
                return Total
            end
            local function CurrentSlot(Data, Slot, SlotConfig)
                local Equipped = Data.equippedAccessories
                if type(Equipped) == "table" and type(Equipped[Slot]) == "string"
                    and Equipped[Slot] ~= ""
                then
                    return Equipped[Slot]
                end
                local Legacy = tostring(Data.equippedAccessory or "")
                if SlotConfig.GetSlot(Legacy) == Slot then
                    return Legacy
                end
                return ""
            end
            local function BestEquipment(Data, M, Preset)
                local Found = {}
                local Scores = {}
                for Id, Definition in pairs(M.Accessories) do
                    local Key = tostring(Id)
                    local Owned = tonumber(
                        type(Data.accessory) == "table" and Data.accessory[Key]
                    ) or 0
                    local Slot = M.Slots.GetSlot(Key)
                    if Owned > 0 and Slot then
                        local Value = Score(Definition, Preset)
                        -- Stable tie-breaker; don't swap equal-stat items randomly.
                        local Old = Scores[Slot]
                        if Old == nil or Value > Old
                            or (Value == Old and Key < tostring(Found[Slot]))
                        then
                            Found[Slot] = Key
                            Scores[Slot] = Value
                        end
                    end
                end
                local BestTitle, BestTitleScore = nil, -math.huge
                for Id, Definition in pairs(M.Titles) do
                    local Key = tostring(Id)
                    if type(Data.title) == "table" and Data.title[Key] == true then
                        local Value = Score(Definition, Preset)
                        if Value > BestTitleScore
                            or (Value == BestTitleScore and Key < tostring(BestTitle))
                        then
                            BestTitle, BestTitleScore = Key, Value
                        end
                    end
                end
                return Found, BestTitle
            end
            local function IsRunning()
                return State.Active and GENV.__AZ_PLAYER_PRESET_RUNTIME == State
            end
            local function WaitForSlot(M, Slot, Id, Timeout)
                local Deadline = os.clock() + Timeout
                while IsRunning() and os.clock() < Deadline do
                    local Latest = DataOf(M)
                    if Latest and CurrentSlot(Latest, Slot, M.Slots) == Id then
                        return true
                    end
                    task.wait(0.2)
                end
                return false
            end
            local function WaitForTitle(M, Id, Timeout, Field)
                local Deadline = os.clock() + Timeout
                while IsRunning() and os.clock() < Deadline do
                    local Latest = DataOf(M)
                    if Latest and tostring(Latest[Field] or "") == Id then
                        return true
                    end
                    task.wait(0.2)
                end
                return false
            end
            local function EquipPreset()
                if State.Busy then
                    Notice("Already equipping a preset.", 4)
                    return
                end
                State.Busy = true
                local CurrentPreset = Selected
                local Ok, ErrorMessage = pcall(function()
                    local M = Modules()
                    if not M or not M.Packets.setEquippedAccessory
                        or not M.Packets.equipTitle
                    then
                        Notice("Equipment is available from the lobby only.")
                        return
                    end
                    local Data = DataOf(M)
                    if not Data then
                        Notice("Account inventory isn't loaded yet. Try again.")
                        return
                    end
                    local Chosen, TitleId = BestEquipment(Data, M, CurrentPreset)
                    local EquippedCount, AlreadyCount, FailedCount = 0, 0, 0
                    for _, Slot in ipairs(M.Slots.Order) do
                        if not IsRunning() then return end
                        local Id = Chosen[Slot]
                        if Id then
                            local Latest = DataOf(M) or Data
                            if CurrentSlot(Latest, Slot, M.Slots) == Id then
                                AlreadyCount += 1
                            else
                                local Fired = pcall(function()
                                    M.Packets.setEquippedAccessory:fire(Id)
                                end)
                                if Fired and WaitForSlot(M, Slot, Id, 3) then
                                    EquippedCount += 1
                                else
                                    FailedCount += 1
                                end
                            end
                        end
                    end
                    local TitleStatus = "no unlocked title"
                    if TitleId and IsRunning() then
                        local StatOk, VisualOk = false, false
                        local Latest = DataOf(M) or Data
                        if tostring(Latest.equippedStatsTitle or "") == TitleId then
                            StatOk = true
                        else
                            local Fired = pcall(function()
                                M.Packets.equipTitle:fire({titleId = TitleId, titleType = "Stats"})
                            end)
                            StatOk = Fired and WaitForTitle(M, TitleId, 3, "equippedStatsTitle")
                        end
                        Latest = DataOf(M) or Data
                        if tostring(Latest.equippedTitle or "") == TitleId then
                            VisualOk = true
                        else
                            local Fired = pcall(function()
                                M.Packets.equipTitle:fire({titleId = TitleId, titleType = "Visual"})
                            end)
                            VisualOk = Fired and WaitForTitle(M, TitleId, 3, "equippedTitle")
                        end
                        TitleStatus = "Stats: " .. (StatOk and "confirmed" or "unconfirmed")
                            .. ", Visual: " .. (VisualOk and "confirmed" or "unconfirmed")
                    end
                    local FinalData = DataOf(M)
                    GENV.__AZ_PRESET_LAST_RESULT = {
                        preset = CurrentPreset, chosenAccessories = Chosen,
                        chosenTitle = TitleId, equipped = EquippedCount,
                        already = AlreadyCount, failed = FailedCount,
                        statTitle = FinalData and FinalData.equippedStatsTitle or "unavailable",
                        visualTitle = FinalData and FinalData.equippedTitle or "unavailable",
                        titleStatus = TitleStatus,
                    }
                    if IsRunning() then
                        Notice(CurrentPreset .. ": " .. EquippedCount
                            .. " accessories equipped, " .. AlreadyCount
                            .. " already equipped, " .. FailedCount
                            .. " unconfirmed; " .. TitleStatus .. ".", 8)
                    end
                end)
                State.Busy = false
                if not Ok then
                    warn("[Anime Zero][Presets] Equip failed:", ErrorMessage)
                    Notice("Equip failed; check console.", 5)
                end
            end

            PlayerTab:CreateSection({name = "Presets"})
            PlayerTab:CreateDropdown({
                name = "Preset",
                flag = "PlayerStatPreset",
                options = PresetNames,
                value = Selected,
                callback = function(Value)
                    if type(Value) == "table" then
                        Value = Value[1] or next(Value)
                    end
                    if Allowed(Value) then
                        Selected = Value
                        Persist()
                    end
