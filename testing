local function GetChestFolder()
    return workspace:FindFirstChild("Chests")
end

local function IsChestPrompt(Object)
    local ChestFolder =
        GetChestFolder()

    return ChestFolder
        and Object
        and Object:IsA("ProximityPrompt")
        and Object:IsDescendantOf(ChestFolder)
end

local function OpenChestPrompt(Prompt)
    if not HubRunning
        or not Settings.AutoOpenChest
        or not IsChestPrompt(Prompt)
        or not Prompt.Enabled
    then
        return false
    end

    local LastAttempt =
        ChestPromptLastAttempt[Prompt]
        or 0

    if os.clock() - LastAttempt
        < PROMPT_RETRY_DELAY
    then
        return false
    end

    ChestPromptLastAttempt[Prompt] =
        os.clock()

    local Success, ErrorMessage =
        pcall(function()
            if type(fireproximityprompt) ~= "function" then
                error("fireproximityprompt is unavailable")
            end

            fireproximityprompt(Prompt)
        end)

    if not Success then
        warn(
            "[Combat Hub] Auto Open Chest: "
                .. tostring(ErrorMessage)
        )

        return false
    end

    -- Do not permanently mark this prompt as completed.
    -- If the server ignored it because you were too far away,
    -- the scanner will try again after PROMPT_RETRY_DELAY.
    return true
end

local function ScanExistingChests()
    local ChestFolder =
        GetChestFolder()

    if not ChestFolder then
        return
    end

    for _, Object in ipairs(
        ChestFolder:GetDescendants()
    ) do
        if IsChestPrompt(Object) then
            OpenChestPrompt(Object)
        end
    end
end

local function StartAutoOpenChest()
    AutoChestLoopID += 1

    local LoopID =
        AutoChestLoopID

    table.clear(
        ChestPromptLastAttempt
    )

    ScanExistingChests()

    task.spawn(function()
        while HubRunning
            and Settings.AutoOpenChest
            and LoopID == AutoChestLoopID
        do
            ScanExistingChests()

            for Prompt in pairs(
                ChestPromptLastAttempt
            ) do
                if not Prompt
                    or not Prompt.Parent
                then
                    ChestPromptLastAttempt[Prompt] =
                        nil
                end
            end

            task.wait(
                CHEST_SCAN_INTERVAL
            )
        end
    end)
end

local function StopAutoOpenChest()
    Settings.AutoOpenChest = false

    AutoChestLoopID += 1

    table.clear(
        ChestPromptLastAttempt
    )
end

ChestAddedConnection =
