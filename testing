        end)


    if Success then
        return Participant
    end


    return nil
end


local function GetLocalParticipantValue(Name)

    local Participant =
        GetLocalParticipant()


    if not Participant then
        return nil
    end


    local Entry =
        Participant[
            Name
        ]


    if not Entry then
        return nil
    end


    local Success,
        Value =
        pcall(function()

            return Entry:get()
        end)


    if Success then
        return Value
    end


    return nil
end


--//============================================================
--// ENEMIES
--//============================================================

local function GetAllEnemies()

    -- The updated enemy controller still renders every live enemy directly
    -- under workspace.enemies.  Treat those visible models as authoritative
    -- for target acquisition, while preserving the replicated Dime state when
    -- it is available for health/name/cooldown information.
    local Enemies = {}


    pcall(function()

        local Stored =
            EnemyStore
                .state
                :getAll()


        if type(Stored) == "table" then

            for EnemyId, EnemyState in pairs(Stored) do
                Enemies[EnemyId] = EnemyState
            end
        end
    end)


    local Folder =
        workspace:FindFirstChild(
            "enemies"
        )


    if Folder then

        for _, Model in ipairs(
            Folder:GetChildren()
        ) do

            if Model:IsA("Model") then

                local RootPart =
                    Model:FindFirstChild(
                        "HumanoidRootPart"
                    )


                if RootPart
                    and RootPart:IsA("BasePart")
                then

                    local EnemyId =
                        tonumber(Model.Name)
                        or Model.Name


                    local StoredState =
                        Enemies[EnemyId]
                        or Enemies[Model.Name]


                    local Humanoid =
                        Model:FindFirstChildOfClass(
                            "Humanoid"
                        )


                    -- Always wrap the visible model, even when the store already
                    -- has this id.  This avoids an updated/partially reconciled
                    -- Dime entry preventing the farm from seeing a model that is
                    -- plainly alive on the client.
                    Enemies[EnemyId] = {
                        __AZVisualFallback = true,
                        __AZModel = Model,
                        __AZStoreState = StoredState,
                        health =
                            Humanoid
                            and math.max(Humanoid.Health, 1)
                            or 1,
                        position = RootPart.Position,
                        name =
                            Model:GetAttribute("EnemyName")
                            or Model.Name,
                    }
                end
            end
        end
    end


    return Enemies
end


local function EnemyGet(
    EnemyState,
    Key
)

    if not EnemyState then
        return nil
    end


    local Entry =
        EnemyState[
            Key
        ]


    -- Visual wrappers keep the original replicated store state here. Prefer
    -- that value when present, otherwise use the direct model snapshot.
    if type(EnemyState) == "table"
        and EnemyState.__AZStoreState
        and EnemyState.__AZStoreState[Key] ~= nil
    then
        Entry = EnemyState.__AZStoreState[Key]
    end


    if Entry == nil then
        return nil
    end


    -- Dime values use :get(); visual-fallback states use plain values.
    local Success,
        Value =
        pcall(function()

            return Entry:get()
        end)


    if Success then
        return Value
    end


    if typeof(Entry) == "Instance"
        and Entry:IsA("ValueBase")
    then
        return Entry.Value
    end


    return Entry
end


local function GetEnemyHealth(EnemyState)

    local Health =
        EnemyGet(
            EnemyState,
            "health"
        )


    if tonumber(Health) then
        return tonumber(Health)
    end


    local Model =
        type(EnemyState) == "table"
        and EnemyState.__AZModel
        or nil


    if Model
        and Model.Parent
    then

        local Humanoid =
            Model:FindFirstChildOfClass(
                "Humanoid"
            )


        if Humanoid then
            return math.max(Humanoid.Health, 1)
        end


        return 1
    end


    return 0
end


local function GetEnemyPosition(EnemyState)

    local Position =
        EnemyGet(
            EnemyState,
            "position"
        )


    if typeof(Position) == "Vector3" then
        return Position
    end


    local Model =
        type(EnemyState) == "table"
        and EnemyState.__AZModel
        or nil


    local RootPart =
        Model
        and Model:FindFirstChild(
            "HumanoidRootPart"
        )


    return RootPart
        and RootPart.Position
        or nil
end


local function GetEnemyName(EnemyState)

    local Name =
        EnemyGet(
            EnemyState,
            "name"
        )


    if Name ~= nil then
        return Name
    end


    local Model =
        type(EnemyState) == "table"
        and EnemyState.__AZModel
        or nil


    return Model
        and (
            Model:GetAttribute("EnemyName")
            or Model.Name
        )
        or nil
end


local function GetLivingEnemyCount()

    local Count = 0


    for _, EnemyState
        in pairs(
            GetAllEnemies()
        )
    do

        if GetEnemyHealth(
            EnemyState
        ) > 0
        then

            Count =
                Count + 1
        end
    end


    return Count
end


local function GetEnemyModel(EnemyId)

    local Folder =
        workspace
            :FindFirstChild(
