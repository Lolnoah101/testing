            tostring(p.Level),tostring(p.Effect or "Bonuses unavailable"))
    end
    if Equip.texts.perk then pcall(function() Equip.texts.perk:Set(status) end) end
end
local function getEquipmentBridge()
    if game.PlaceId~=LOBBY_PLACE_ID then return nil,"Equipment automation runs in Town Central" end
    local actor=getLobbyActor()
    if not actor then return nil,"Lobby Actor not available" end
    local existing=actor:FindFirstChild(EQUIPMENT_BRIDGE_NAME)
    if existing and existing:IsA("BindableFunction") then return existing end
    if os.clock()-Equip.bridgeRequestAt<2 then return nil,"Equipment bridge initializing" end
    local runner=type(run_on_actor)=="function" and run_on_actor or ENV.run_on_actor
    if type(runner)~="function" then return nil,"run_on_actor not supported" end
    Equip.bridgeRequestAt=os.clock()
    local ok,err=pcall(runner,actor,EQUIPMENT_ACTOR_SOURCE)
    if not ok then return nil,"Equipment bridge error: "..tostring(err) end
    for _=1,12 do
        local new=actor:FindFirstChild(EQUIPMENT_BRIDGE_NAME)
        if new and new:IsA("BindableFunction") then return new end
        task.wait(0.04)
    end
    return nil,"Equipment bridge not ready"
end
local function equipmentCall(command,params)
    local bridge,err=getEquipmentBridge()
    if not bridge then return false,err end
    local ok,result,detail=pcall(function() return bridge:Invoke(command,params) end)
    if not ok then return false,tostring(result) end
    return result==true,detail
end
local function equipmentAction(command,params)
    if Equip.pending or Farm.unloaded then return end
    Equip.pending=true
    task.spawn(function()
        local ok,msg=equipmentCall(command,params)
        Equip.status=(ok and "OK: " or "Blocked: ")..tostring(msg)
        if not ok and (command=="SellInventory" or command=="RollArtifactByID"
            or command=="OpenCrate") then
            Equip.spendBlocked[command]=true
            Equip.securityNote="Paused "..command.." after an unconfirmed request; toggle off/on to retry"
        end
        if ok then Equip.refreshAt=0 end
        Equip.pending=false
    end)
end
-- Lobby inventory actions use observed native requests, check live ownership,
-- and stop on unconfirmed inventory changes to avoid repeated consumption.
Equip.refreshLobbyDetails=function()
    local data=Equip.snapshot
    if not data then return end
    local function refresh(handle,key,options,selected)
        local signature=table.concat(options,"|")
        if handle and Equip[key]~=signature then
            Equip[key]=signature
            pcall(function() handle:Refresh(options) end)
            if selected and table.find(options,selected) then
                pcall(function() handle:Set(selected) end)
            end
        end
    end
    local slots=Equip.artifactSlot=="Slot 2" and {Neck=true,Back=true}
        or {Hat=true,Face=true}
    local artOptions, artMap={},{}
    for _,item in ipairs(data.Artifacts or {}) do
        if slots[item.Slot] then
            local label=item.Name.." ["..item.ID.."] • "..item.Slot
            artOptions[#artOptions+1]=label;artMap[label]=item
        end
    end
    table.sort(artOptions)
    if #artOptions==0 then artOptions={"No owned artifacts for this slot"} end
    Equip.artifactMap=artMap
    if not artMap[Equip.artifactChoice] then Equip.artifactChoice=artOptions[1] end
    refresh(Equip.artifactDropdown,"lastArtifactKey",artOptions,Equip.artifactChoice)
    local artifact=artMap[Equip.artifactChoice]
    Equip.artifactID=artifact and artifact.ID or ""
    if Equip.texts.artifact then
        local description="No compatible owned artifacts found"
        if artifact then
            local rows={}
            for _,stat in ipairs(artifact.Rolls or {}) do
                local amount=tostring(stat.Display)
                rows[#rows+1]=stat.Name..": "..amount..(amount:find("%%") and "" or "%")
            end
            description=artifact.Name.." | "..artifact.Slot.." | "..artifact.Rarity
                .." | "..(#rows>0 and table.concat(rows," | ") or "No rolled stat values in inventory")
            if type(artifact.Passives)=="string" and #artifact.Passives>0 then
                description=description.." | "..artifact.Passives
            end
            local function meets(name,target)
                if name=="" or name=="Waiting for rolled stat names" then return false end
                for _,stat in ipairs(artifact.Rolls or {}) do
                    if stat.Name==name and type(stat.Value)=="number" and stat.Value>=target then
                        return true
                    end
                end
                return false
            end
            if Equip.autoRollArtifact then
                description=description.." | Goal "..(meets(Equip.artifactStat1,Equip.artifactMin1)
                    and meets(Equip.artifactStat2,Equip.artifactMin2) and "MET" or "not met")
            end
        end
        pcall(function() Equip.texts.artifact:Set(description) end)
    end
    -- Usable artifact roll targets from the game's supported equipment stat family.
    -- Combine these with observed roll names so an item can target a stat it
    -- does not currently have, while still retaining new stats after updates.
    local statNames={"ODM_Damage","ODM_Crit_Damage","ODM_Crit_Chance",
        "Blade_Durability","ODM_Speed","ODM_Control","ODM_Range","ODM_Gas",
        "Damage","Titan_Damage","Shifter_Damage","Health",
        "TS_Damage","TS_Crit_Damage","TS_Crit_Chance"}
    if artifact then
        for _,stat in ipairs(artifact.Rolls or {}) do
            if not table.find(statNames,stat.Name) then statNames[#statNames+1]=stat.Name end
        end
    end
    table.sort(statNames)
    if not table.find(statNames,Equip.artifactStat1) then Equip.artifactStat1=statNames[1] end
    if not table.find(statNames,Equip.artifactStat2) then Equip.artifactStat2=statNames[1] end
    refresh(Equip.artifactStatOneDropdown,"lastStatOneKey",statNames,Equip.artifactStat1)
    refresh(Equip.artifactStatTwoDropdown,"lastStatTwoKey",statNames,Equip.artifactStat2)
    local memoryOptions={}
    for _,name in ipairs(data.MemoryOptions or {}) do
        if not table.find(memoryOptions,name) then memoryOptions[#memoryOptions+1]=name end
    end
    if #memoryOptions==0 then
        for _,item in ipairs(data.Memories or {}) do
            if not table.find(memoryOptions,item.Name) then memoryOptions[#memoryOptions+1]=item.Name end
        end
    end
    table.sort(memoryOptions)
    if #memoryOptions==0 then memoryOptions={"No owned memories detected"} end
    if not table.find(memoryOptions,Equip.memoryTarget) then Equip.memoryTarget=memoryOptions[1] end
    refresh(Equip.memoryDropdown,"lastMemoryKey",memoryOptions,Equip.memoryTarget)
    local crateOptions={}
    for _,item in ipairs(data.Crates or {}) do
        if item.Count>0 then crateOptions[#crateOptions+1]=item.Name.." ("..item.Count..")" end
    end
    table.sort(crateOptions)
    if #crateOptions==0 then crateOptions={"No owned crates detected"} end
    if not table.find(crateOptions,Equip.selectedCrate) then Equip.selectedCrate=crateOptions[1] end
    refresh(Equip.crateDropdown,"lastCrateKey",crateOptions,Equip.selectedCrate)
    if Equip.texts.crates then
        pcall(function() Equip.texts.crates:Set(
            "Owned: "..(#(data.Crates or {})).." crate types | Selected: "..Equip.selectedCrate
            .." | From inventory data") end)
    end
    if Equip.texts.boosts then
        local rows={}
        for _,item in ipairs(data.Boosts or {}) do
            rows[#rows+1]=item.Name.." x"..item.Count
        end
        pcall(function() Equip.texts.boosts:Set(#rows>0 and table.concat(rows," | ")
            or "No live boost inventory/time data exposed") end)
    end
    if Equip.texts.prestige then
        pcall(function() Equip.texts.prestige:Set(
            string.format("Prestige %s | Level %s | Gold %s | Memories detected: %s",
                tostring(data.Prestige),tostring(data.Level),tostring(data.Gold),
                tostring(#(data.Memories or {})))) end)
    end
    local recipes={}
    for _,recipe in ipairs(data.CraftTargets or {}) do
        if recipe.Category==Equip.craftCategory and type(recipe.Tag)=="string" then
            recipes[#recipes+1]=recipe.Tag
        end
    end
    local recipeRank={Common=1,Rare=2,Epic=3,Legendary=4,Mythic=5,Divine=6}
    table.sort(recipes,function(a,b)
        local ar=recipeRank[a:match("^(%w+)_")] or 99
        local br=recipeRank[b:match("^(%w+)_")] or 99
        if ar~=br then return ar<br end
        return a<b
    end)
    if #recipes==0 then recipes={"Waiting for game recipe definitions"} end
    if not table.find(recipes,Equip.craftTarget) then Equip.craftTarget=recipes[1] end
    refresh(Equip.craftTargetDropdown,"lastCraftKey",recipes,Equip.craftTarget)
    Equip.craftRecipeData=nil
    for _,recipe in ipairs(data.CraftTargets or {}) do
        if recipe.Category==Equip.craftCategory and recipe.Tag==Equip.craftTarget then
            Equip.craftRecipeData=recipe;break
        end
    end
    local craft=Equip.craftRecipeData
    if Equip.texts.craft then
        local text=craft and ("Recipe "..craft.Tag.." | "..tostring(craft.Rarity or "Unknown")
            .." | Recipe loaded from game data; auto-craft requires verified materials/chance")
            or "Waiting for game crafting definitions"
        if craft and craft.NativeCategory=="Fragments" then
            text=text.." | This perk uses Divine Fragments"
        elseif Equip.craftCategory=="Vessels" then
            text=text.." | Vessels use the native Vessel material rules"
        end
        pcall(function() Equip.texts.craft:Set(text) end)
    end
end

Equip.runGuardedLobbyAutomation=function()
    -- Only invoke the already verified S_Equipment/Forge request; do not sell,
    -- reroll, spend boosts, or prestige using guessed remote names.
    local info=Equip.snapshot
    if not info then return end
    if Equip.autoEquipSelectedArtifact and Equip.artifactID~="" then
        for _,a in ipairs(info.Artifacts or {}) do
            if a.ID==Equip.artifactID and not a.Equipped
                and os.clock()-(Equip.lastTimes.artifactSelected or -100)>5 then
                Equip.lastTimes.artifactSelected=os.clock()
                equipmentAction("EquipArtifactByID",{id=a.ID})
                return
            end
        end
    end
    -- Match only exact live inventory rarities; never sell equipped or currently
    -- selected perks/artifacts. One bounded batch per tick prevents mass deletion.
    local function rarityList(selection)
        local values={}
        if type(selection)=="table" then
            for key,v in pairs(selection) do
                if type(key)=="number" and type(v)=="string" then
                    values[#values+1]=v
                elseif type(key)=="string" and v==true then
                    values[#values+1]=key
                end
            end
        end
        return values
    end
    local now=os.clock()
    local perkRarities=rarityList(Equip.perkSellRarities)
    if Equip.autoSellPerks and #perkRarities>0 and not Equip.spendBlocked.SellInventory
        and now-(Equip.lastTimes.sellPerks or -100)>=8 then
        local allowed={}
        for _,rarity in ipairs(perkRarities) do allowed[rarity]=true end
        local ids={}
        for _,p in ipairs(info.Perks or {}) do
            if allowed[p.Rarity] and not (info.EquippedPerkIDs or {})[p.ID]
                and p.Name~=Equip.perkName then
                ids[#ids+1]=p.ID
            end
            if #ids>=6 then break end
        end
        if #ids>0 then
            Equip.lastTimes.sellPerks=now
            equipmentAction("SellInventory",{kind="Perk",ids=ids,
                rarities=perkRarities,protectName=Equip.perkName})
            return
        end
    end
    local artifactRarities=rarityList(Equip.artifactRarities)
    if Equip.autoSellArtifacts and #artifactRarities>0 and not Equip.spendBlocked.SellInventory
        and now-(Equip.lastTimes.sellArtifacts or -100)>=8 then
        local allowed={}
        for _,rarity in ipairs(artifactRarities) do allowed[rarity]=true end
        local ids={}
        for _,a in ipairs(info.Artifacts or {}) do
            if allowed[a.Rarity] and not a.Equipped and a.ID~=Equip.artifactID then
                ids[#ids+1]=a.ID
            end
            if #ids>=6 then break end
        end
        if #ids>0 then
            Equip.lastTimes.sellArtifacts=now
            equipmentAction("SellInventory",{kind="Artifact",ids=ids,
                rarities=artifactRarities,protectId=Equip.artifactID})
            return
        end
    end
    if Equip.autoRollArtifact and not Equip.spendBlocked.RollArtifactByID
        and Equip.artifactID~="" and now-(Equip.lastTimes.rollArtifact or -100)>=5 then
        local chosen
        for _,a in ipairs(info.Artifacts or {}) do
            if a.ID==Equip.artifactID then chosen=a;break end
        end
        local min1,min2=tonumber(Equip.artifactMin1) or 0,tonumber(Equip.artifactMin2) or 0
        local function reached(statName,minimum)
            if minimum<=0 then return true end
            if not chosen or type(statName)~="string" or statName=="" then return false end
            for _,r in ipairs(chosen.Rolls or {}) do
                if r.Name==statName and type(r.Value)=="number" and r.Value>=minimum then
                    return true
                end
            end
            return false
        end
        if chosen and (min1>0 or min2>0)
            and not (reached(Equip.artifactStat1,min1) and reached(Equip.artifactStat2,min2)) then
            Equip.lastTimes.rollArtifact=now
            equipmentAction("RollArtifactByID",{id=chosen.ID})
            return
        end
    end
    -- Open only the exact owned crate chosen in the dropdown.
    if Equip.autoOpenCrates and not Equip.spendBlocked.OpenCrate
        and now-(Equip.lastTimes.openCrate or -100)>=5 then
        local selected=tostring(Equip.selectedCrate or "")
        for _,c in ipairs(info.Crates or {}) do
            if c.Count>0 and selected==c.Name.." ("..c.Count..")" then
                Equip.lastTimes.openCrate=now
                equipmentAction("OpenCrate",{name=c.Name})
                return
            end
        end
    end
    if Equip.autoCraftPerks and Equip.craftCategory=="Perks" then
        local recipe=Equip.craftRecipeData
        local count=recipe and recipe.Required
        if not recipe or recipe.Chance~=100 or not count or count<1
            or type(recipe.SelectedMaterialIDs)~="string" then
            Equip.securityNote="Auto Craft waiting: confirmed 100% chance and exact game-selected materials required"
            return
        end
        if os.clock()-(Equip.lastTimes.craftAuto or -100)<10 then return end
        local candidates={}
        local rarityOrder={Common=1,Rare=2,Epic=3,Legendary=4,Mythic=5,Divine=6}
        for _,p in ipairs(info.Perks or {}) do
            if not (info.EquippedPerkIDs or {})[p.ID] then
                candidates[#candidates+1]=p
            end
        end
        table.sort(candidates,function(a,b)
            local ar,br=rarityOrder[a.Rarity] or 99,rarityOrder[b.Rarity] or 99
            if ar~=br then return ar<br end
            if a.Level~=b.Level then return a.Level<b.Level end
            return a.ID<b.ID
        end)
        if #candidates<count then
            Equip.securityNote="Auto Craft waiting: insufficient unequipped materials"
            return
        end
        local ids,selectedCount={},0
        for id in recipe.SelectedMaterialIDs:gmatch("[^,%s]+") do
            if not (info.EquippedPerkIDs or {})[id] then
                for _,candidate in ipairs(candidates) do
                    if candidate.ID==id and not ids[id] then
                        ids[id]=1;selectedCount=selectedCount+1;break
                    end
                end
            end
        end
        if selectedCount~=count then
            Equip.securityNote="Auto Craft waiting: displayed materials do not match owned unequipped perks"
            return
        end
        Equip.lastTimes.craftAuto=os.clock()
        equipmentAction("Forge",{category="Perks",target=recipe.Tag,ids=ids,
            chance=recipe.Chance,requireGuaranteed=true})
    end
end

local function equipmentTick()
    if game.PlaceId~=LOBBY_PLACE_ID or Farm.unloaded then return end
    if Equip.pending then return end
    local now=os.clock()
    if now>=Equip.refreshAt then
        local ok,data=equipmentCall("Snapshot")
        if ok and type(data)=="table" then
            Equip.snapshot=data
            Equip.refreshAt=now+1.5
        else
            Equip.status=tostring(data)
            Equip.refreshAt=now+1.5
        end
    end
    local info=Equip.snapshot
    if not info then return end
    local function tryAuto(enabled,key,delay,command,params)
        if enabled and (now-(Equip.lastTimes[key] or -100))>=delay then
            Equip.lastTimes[key]=now
            equipmentAction(command,params)
            return true
        end
    end
    if tryAuto(Equip.autoEquip and info.Weapon~=Equip.weapon,"weapon",3,"EquipWeapon",Equip.weapon) then return end
    if tryAuto(Equip.autoUpgrade,"upgrade",2,"Upgrade") then return end
    if tryAuto(Equip.autoSkills,"skills",3,"UnlockSkill",{direction=Equip.skillDirection,branch=Equip.skillBranch}) then return end
    if tryAuto(Equip.autoPerk and type(Equip.perkName)=="string"
        and #Equip.perkName>0 and Equip.perkChoiceMap[Equip.perkName]
        and table.find(info.UnlockedPerkSlots or {},Equip.perkCategory)~=nil,
        "perk",5,"EquipPerk",{name=Equip.perkName,category=Equip.perkCategory}) then return end
    if Equip.runGuardedLobbyAutomation then Equip.runGuardedLobbyAutomation() end
end
local function equipmentHeartbeat(dt)
    Equip.elapsed=Equip.elapsed+dt
    if Equip.elapsed<0.9 then return end
    Equip.elapsed=0
    if Farm.unloaded then return end
    if game.PlaceId==LOBBY_PLACE_ID and not Equip.pending then task.spawn(equipmentTick) end
    local d=Equip.snapshot
    if d then
        local line=string.format("Equipped: %s | Grade: %s (%s/15) | Blades: %s | Spears: %s | Gold: %s",
            tostring(d.Weapon),tostring(d.GradeTag),tostring(d.Grade or "?"),
            tostring(d.GradeBlades or "?"),tostring(d.GradeSpears or "?"),tostring(d.Gold))
        if Equip.texts.grade then pcall(function() Equip.texts.grade:Set(line) end) end
        local skillLine=string.format("Level %d | Prestige %d | Skills unlocked %d | SP %s",
            d.Level,d.Prestige,d.Unlocked,tostring(d.SkillPoints or "?"))
        if Equip.texts.skills then pcall(function() Equip.texts.skills:Set(skillLine) end) end
        -- All UI controls are refreshed from the live character snapshot.
        -- If a user changes slot, this runs immediately on the next heartbeat.
        if Equip.refreshPerkSelectors then Equip.refreshPerkSelectors() end
        if Equip.refreshLobbyDetails then Equip.refreshLobbyDetails() end
    end
    if Equip.texts.status then pcall(function()
        Equip.texts.status:Set(Equip.securityNote~="" and Equip.securityNote or Equip.status)
    end) end
end

