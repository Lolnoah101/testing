    --//========================================================
    --// AUTO CLAIM DAILY QUESTS
    --//
    --// Match the game's own QuestsWindowHandler:
    --// - read daily/weekly periods from the live account state
    --// - rebuild active quest ids from those live periods
    --// - read completed/claimed directly from the reactive maps
    --// - clear stale pending state immediately when a reset occurs
    --//========================================================

    local PendingQuest = nil
    local NextQuestAt = 0
    local LastQuestDailyPeriod = nil
    local LastQuestWeeklyPeriod = nil

    local function GetQuestAccount()
        if not AccountNamespace
            or not AccountNamespace.getLocalPlayerAccount
        then
            return nil
        end

        local Success, Account = pcall(function()
            return AccountNamespace.getLocalPlayerAccount()
        end)

        if Success then
            return Account
        end

        return nil
    end

    local function ReadQuestBool(MapState, QuestId)
        if not MapState then
            return false
        end

        local Success, Value = pcall(function()
            local Leaf = MapState:get(QuestId)

            if not Leaf then
                return false
            end

            return Leaf:get() == true
        end)

        return Success and Value == true
    end

    local function ReadQuestPeriods(Account)
        if not Account
            or not Account.state
            or not Account.state.quests
        then
            return nil, nil
        end

        local Success, DailyPeriod, WeeklyPeriod = pcall(function()
            return Account.state.quests.dailyPeriod:get(),
                Account.state.quests.weeklyPeriod:get()
        end)

        if not Success then
            return nil, nil
        end

        return tonumber(DailyPeriod),
            tonumber(WeeklyPeriod)
    end

    local function RefreshQuestPeriodState(Account)
        local DailyPeriod, WeeklyPeriod =
            ReadQuestPeriods(Account)

        if DailyPeriod == nil
            or WeeklyPeriod == nil
        then
            return nil, nil
        end

        local PeriodChanged =
            LastQuestDailyPeriod ~= nil
            and (
                DailyPeriod ~= LastQuestDailyPeriod
                or WeeklyPeriod ~= LastQuestWeeklyPeriod
            )

        if PeriodChanged then
            PendingQuest = nil
            NextQuestAt = 0

            print(
                "[Anime Zero][Daily Quests] Quest period refreshed | Daily:",
                DailyPeriod,
                "| Weekly:",
                WeeklyPeriod
            )
        end

        LastQuestDailyPeriod = DailyPeriod
        LastQuestWeeklyPeriod = WeeklyPeriod

        return DailyPeriod, WeeklyPeriod
    end

    local function FindClaimableDailyQuest()
        local Account = GetQuestAccount()

        if not Account
            or not Account.state
            or not Account.state.quests
            or not QuestConfig
            or not QuestConfig.getActiveIds
            or type(QuestConfig.order) ~= "table"
            or type(QuestConfig.quests) ~= "table"
        then
            return nil
        end

        local DailyPeriod, WeeklyPeriod =
            RefreshQuestPeriodState(Account)

        if DailyPeriod == nil
            or WeeklyPeriod == nil
        then
            return nil
        end

        local Success, ActiveIds = pcall(function()
            return QuestConfig.getActiveIds(
                DailyPeriod,
                WeeklyPeriod
            )
        end)

        if not Success
            or type(ActiveIds) ~= "table"
        then
            return nil
        end

        local QuestState = Account.state.quests

        for _, QuestId in ipairs(QuestConfig.order) do
            local Definition = QuestConfig.quests[QuestId]

            if ActiveIds[QuestId] == true
                and Definition
                and Definition.Category == "Daily"
                and ReadQuestBool(
                    QuestState.completed,
                    QuestId
                )
                and not ReadQuestBool(
                    QuestState.claimed,
                    QuestId
                )
            then
                return QuestId
            end
        end

        return nil
    end

    -- Reset stale request timing as soon as the live quest period changes,
    -- just like the game's quest UI listens to dailyPeriod/weeklyPeriod.
    if AccountNamespace
        and type(AccountNamespace.onLocalAccountLoad) == "function"
    then
        local Success, Cleanup = pcall(function()
            return AccountNamespace.onLocalAccountLoad(
                function(Account)
                    if not Account
                        or not Account.state
                        or not Account.state.quests
                    then
                        return
                    end

                    RefreshQuestPeriodState(Account)

                    local Listeners = {
                        Account.state.quests.dailyPeriod:listen(function()
                            RefreshQuestPeriodState(Account)
                        end),
                        Account.state.quests.weeklyPeriod:listen(function()
                            RefreshQuestPeriodState(Account)
                        end),
                    }

                    return function()
                        for _, Disconnect in ipairs(Listeners) do
                            pcall(Disconnect)
                        end
                    end
                end
            )
        end)

        if Success and Cleanup then
            table.insert(Runtime.Connections, Cleanup)
        end
    end

    if Packets.questActionResult then
        local Connection =
            Packets.questActionResult
                :on(function(Result)
                    if not Alive()
                        or not Result
                        or not PendingQuest
                    then
                        return
                    end

                    if Result.requestId
                        ~= PendingQuest.requestId
                    then
                        return
                    end


                    if PendingQuest.claimAll ~= true
                        and tostring(Result.questId)
                            ~= PendingQuest.questId
                    then
                        return
                    end


                    local FinishedQuest =
                        PendingQuest.claimAll == true
                        and "Claim All"
                        or PendingQuest.questId

                    PendingQuest = nil
                    NextQuestAt =
                        os.clock()
                        + (Result.success == true
                            and 0.45
                            or 1.5)

                    if Result.success == true then
                        print(
                            "[Anime Zero][Daily Quests] Claimed:",
                            FinishedQuest
                        )

                    elseif tostring(Result.reason or "") ~= "" then
                        warn(
                            "[Anime Zero][Daily Quests]",
                            Result.reason
                        )
                    end
                end)

        table.insert(Runtime.Connections, Connection)
    end

    task.spawn(function()
        while Alive() do
            local Account = GetQuestAccount()

            if Account then
                RefreshQuestPeriodState(Account)
            end

            if Settings.AutoClaimDailyQuests
                and not PendingQuest
                and os.clock() >= NextQuestAt
                and Packets.claimQuestReward
            then
                local QuestId = FindClaimableDailyQuest()

                if QuestId then
                    local Id = NextRequestId(
                        RequestIds,
                        "Quest"
                    )

                    local UseClaimAll =
                        Packets.claimQuestRewards ~= nil


                    PendingQuest = {
                        requestId = Id,
                        questId = QuestId,
                        claimAll = UseClaimAll,
                        sentAt = os.clock(),
                    }


                    local Fired, ErrorMessage = pcall(function()

                        if UseClaimAll then

                            Packets.claimQuestRewards:fire({
                                requestId = Id,
                            })

                        else

                            Packets.claimQuestReward:fire({
                                questId = QuestId,
                                requestId = Id,
                            })
                        end
                    end)

                    if not Fired then
                        PendingQuest = nil
                        NextQuestAt = os.clock() + 1.5

                        warn(
                            "[Anime Zero][Daily Quests] Claim request failed:",
                            ErrorMessage
                        )
                    end
                end
            end

            if PendingQuest
                and os.clock() - PendingQuest.sentAt >= 7
            then
                PendingQuest = nil
                NextQuestAt = os.clock() + 1.5
            end

            task.wait(0.30)
        end
    end)

