    local function isQueued()
        -- Terminal queue states must NOT be treated as successful matchmaking.
        local q = player:GetAttribute("Queue")
        if q == true then return true end
        if type(q) == "string" and q ~= "" and not queueEnded[q:lower()] then
            return true
        end
