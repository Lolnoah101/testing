function Hub:V61ConnectSkillCooldowns()
    local E=self.V44
    if E.AbilityCooldownConnected then return end
    local events=ReplicatedStorage:FindFirstChild("Remotes")
    local remote=events and events:FindFirstChild("SkillCooldown")
    if not remote or not remote:IsA("RemoteEvent") then
        E.AbilityStatus="Waiting for SkillCooldown event"
        return
    end
    E.AbilityCooldownConnected=true
    E.AbilityCooldowns=E.AbilityCooldowns or {}
    E.AbilityFailures=E.AbilityFailures or {}
    table.insert(self.Connections,remote.OnClientEvent:Connect(function(skill,duration,endsAt)
        if not self.Running or type(skill)~="string" then return end
        local nowServer=workspace:GetServerTimeNow()
        local seconds=tonumber(duration) or 0
        local deadline=tonumber(endsAt)
        if not deadline then deadline=nowServer+math.max(0,seconds) end
        E.AbilityCooldowns[skill]=math.max(nowServer,deadline)
        E.AbilityFailures[skill]=nil
    end))
end
