            if not ok then settingsWarn("Unload cleanup error: " .. tostring(err)) end
        end
        if env.HollowMoonBelowFarmWindow == window then
            env.HollowMoonBelowFarmWindow = nil
        end
        local ok, err = pcall(function()
            if type(window.Unload) == "function" then window:Unload()
            elseif type(window.Destroy) == "function" then window:Destroy() end
        end)
        if not ok then settingsWarn("Window unload error: " .. tostring(err)) end
    end,
})

-- V62: re-arm the executor's one-shot queue at the start of EVERY place.
-- Rayfield restores UI state independently; the file preference is canonical.
local function restoreAndArmAutoExecute()
    if not settingsState.alive or not readAutoExecuteEnabled() then return end
    settingsState.autoExecute = true
    -- Migrates the older preference and disables still-queued V60 payloads.
    if saveAutoExecuteEnabled(true) then queueAutoExecute() end
end
restoreAndArmAutoExecute()

-- Teleport failures can invalidate a queued request in certain executors.
-- Don't add a second request to a queue that is already armed.
pcall(function()
    table.insert(settingsState.connections, player.OnTeleport:Connect(function(state)
        if not (settingsState.alive and settingsState.autoExecute) then return end
        if state == Enum.TeleportState.Failed then
            settingsState.queued = false
            task.defer(queueAutoExecute)
        elseif state == Enum.TeleportState.Started and not settingsState.queued then
            queueAutoExecute()
        end
    end))
end)

-- Delayed retry covers queue APIs which initialize after the GUI loads.
task.delay(3, function()
    if settingsState.alive and settingsState.autoExecute and not settingsState.queued then
        queueAutoExecute()
    end
end)

end)()
