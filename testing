        end
        if not price or price <= 0 then return false, nil end
        return (tonumber(cash) or 0) >= price, price
    end
    local function selectedList(value)
        local result = {}
        if type(value) == "string" then result[value] = true
        elseif type(value) == "table" then
            for key, item in pairs(value) do
                if type(key) == "string" and item == true then result[key] = true end
                if type(item) == "string" then result[item] = true end
            end
        end
        return result
    end
    local function promptPosition(prompt)
        local a = prompt.Parent
        if a and a:IsA("Attachment") then return a.WorldPosition end
        if a and a:IsA("BasePart") then return a.Position end
        if a and a:IsA("Model") then return a:GetPivot().Position end
        return nil
    end
    local function nearbyPrompt(name)
        local _, _, root = characterReady()
        if not root then return nil end
        local best, closest = nil, math.huge
        for _, instance in ipairs(workspace:GetDescendants()) do
            if instance:IsA("ProximityPrompt") and instance.Name == name and instance.Enabled then
                local pos = promptPosition(instance)
                local range = tonumber(instance.MaxActivationDistance) or 10
                local dist = pos and (root.Position - pos).Magnitude or math.huge
                if dist <= range + 1 and dist < closest then
                    best, closest = instance, dist
                end
            end
        end
        return best
    end
    -- TrainingController itself uses: ClientState.fire("TrainRep", pendingReps).
    -- The server only counts reps AFTER a real barbell has started a Training session.
    local function machineOfPrompt(prompt)
        local node = prompt and prompt.Parent
        for _ = 1, 8 do
            if not node or node == workspace then break end
            if node:IsA("Model") and node:GetAttribute("MachineId") ~= nil then
                return node
            end
            node = node.Parent
        end
        return nil
    end
    local function stationAvailable(machine)
        if not machine or not machine.Parent then return false end
        local id = tostring(machine:GetAttribute("MachineId") or "")
        if id == "" then return false end
        local occupant = tonumber(machine:GetAttribute("Occupant")) or 0
        if occupant > 0 and occupant ~= player.UserId then return false end
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player and other:GetAttribute("Training") == id then
                return false
            end
        end
        -- The game marks the 1.5x area with an Unlock string and exposes
        -- unlock status through the server-set BoostUnlocked player attribute.
        local requirement = machine:GetAttribute("Unlock")
        if type(requirement) == "string" and requirement ~= ""
            and player:GetAttribute("BoostUnlocked") ~= true then
            return false
        end
        return true
    end
    local function boostOf(machine)
        return math.clamp(tonumber(machine and machine:GetAttribute("Boost")) or 1, 1, 10)
    end
    local function machineByTrainingId(trainingId)
        local lobby = workspace:FindFirstChild("Lobby")
        local gym = lobby and lobby:FindFirstChild("Gym")
        local barbells = gym and gym:FindFirstChild("Barbells")
        if not barbells or type(trainingId) ~= "string" or trainingId == "" then return nil end
        for _, desc in ipairs(barbells:GetDescendants()) do
            if desc:IsA("Model") and tostring(desc:GetAttribute("MachineId") or "") == trainingId then
                return desc
            end
        end
        return nil
    end
    local function chooseWeightStation()
        local lobby = workspace:FindFirstChild("Lobby")
        local gym = lobby and lobby:FindFirstChild("Gym")
        local barbells = gym and gym:FindFirstChild("Barbells")
        local source = barbells or gym
        local _, _, root = characterReady()
        if not source or not root then return nil, nil, nil end
        local bestPrompt, bestMachine, bestPos = nil, nil, nil
        local bestBoost, bestDistance = -1, math.huge
        for _, desc in ipairs(source:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Name == "TrainPrompt" and desc.Enabled then
                local machine = machineOfPrompt(desc)
                local pos = promptPosition(desc)
                if pos and stationAvailable(machine) then
                    local boost = boostOf(machine)
                    local dist = (root.Position - pos).Magnitude
                    -- BOOST ALWAYS WINS. Distance only breaks ties between
                    -- equally strong, free, unlocked training stations.
                    if boost > bestBoost + 0.001
                        or (math.abs(boost - bestBoost) <= 0.001 and dist < bestDistance) then
                        bestBoost, bestDistance = boost, dist
                        bestPrompt, bestMachine, bestPos = desc, machine, pos
                    end
                end
            end
        end
        return bestPrompt, bestMachine, bestPos
    end
    -- V32: TravelTo('Rebirth') remains the game's server-owned shrine travel.
    -- For the RETURN to weights, avoid a single PivotTo at floor level while
    -- the previous training/rebirth pose and angular velocity are still active.
    -- Start above verified ground and ease the final landing upright.
    function lobbyState.finishStationLanding(landing)
        if not landing or landing.finished then return end
        landing.finished = true
        if landing.connection then
            landing.connection:Disconnect()
            landing.connection = nil
        end
        if landing.tween then
            pcall(function() landing.tween:Cancel() end)
            landing.tween = nil
        end
        if landing.root and landing.root.Parent then
            pcall(function()
                landing.root.AssemblyLinearVelocity = Vector3.zero
                landing.root.AssemblyAngularVelocity = Vector3.zero
                landing.root.Anchored = landing.wasAnchored
            end)
        end
        if lobbyState.stationLanding == landing then
            lobbyState.stationLanding = nil
        end
    end

    local function teleportToStation(prompt, machine, pos)
        if lobbyState.stationLanding then
            return false, "Finishing previous weight-station landing"
        end
        local char, humanoid, root = characterReady()
        if not char or not humanoid or not root or not pos then
            return false, "Character not ready"
        end

        local facingAway = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z)
        if facingAway.Magnitude < 0.1 and machine then
            local look = machine:GetPivot().LookVector
            facingAway = Vector3.new(-look.X, 0, -look.Z)
        end
        if facingAway.Magnitude < 0.1 then facingAway = Vector3.new(0, 0, 1) end
        facingAway = facingAway.Unit
        local sideways = Vector3.new(-facingAway.Z, 0, facingAway.X)
        local activationRadius = tonumber(prompt.MaxActivationDistance) or 8
        local offset = math.clamp(activationRadius * 0.38, 1.8, 3.2)

        -- Respect solid ground; don't use a decorative prop / vertical wall
        -- as the surface that determines the root's landing height.
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, machine}
        params.RespectCanCollide = true

        local choices = {facingAway, sideways, -sideways, -facingAway}
        local target, floorY
        for _, dir in ipairs(choices) do
            local candidate = pos + dir * offset
            local origin = Vector3.new(candidate.X, pos.Y + 13, candidate.Z)
            local hit = workspace:Raycast(origin, Vector3.new(0, -34, 0), params)
            if hit and hit.Normal.Y > 0.65 and math.abs(hit.Position.Y - pos.Y) <= 8 then
                local rootY = hit.Position.Y + humanoid.HipHeight + root.Size.Y * 0.5 + 0.4
                local landing = Vector3.new(candidate.X, rootY, candidate.Z)
                if (landing - pos).Magnitude <= activationRadius + 0.4 then
                    target, floorY = landing, hit.Position.Y
                    break
                end
            end
        end
        if not target then
            return false, "No clear floor within weight prompt range"
        end

        -- Keep the entire character upright. Never preserve a tilted pivot
        -- left by the previous training animation or a server travel.
        local face = Vector3.new(pos.X-target.X, 0, pos.Z-target.Z)
        if face.Magnitude < 0.05 then face = Vector3.new(0, 0, -1) end
        face = face.Unit
        local upright = CFrame.lookAt(target, target + face, Vector3.yAxis)
        local lifted = CFrame.lookAt(target + Vector3.new(0, 3, 0), target + Vector3.new(0, 3, 0) + face, Vector3.yAxis)

        local landing = {
            root = root, char = char, wasAnchored = root.Anchored,
            finished = false, tween = nil, connection = nil,
        }
        lobbyState.stationLanding = landing
        local ok, err = pcall(function()
            humanoid.Sit = false
            humanoid.PlatformStand = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.Anchored = true
            char:PivotTo(lifted)
            local tween = TweenService:Create(root,
                TweenInfo.new(0.36, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
                {CFrame = upright})
            landing.tween = tween
            landing.connection = tween.Completed:Connect(function(playbackState)
                if not landing.finished and root.Parent then
                    if playbackState == Enum.PlaybackState.Completed then
                        pcall(function() root.CFrame = upright end)
                    end
                    lobbyState.finishStationLanding(landing)
                    if player.Character == char and humanoid.Health > 0 then
                        pcall(function()
                            humanoid.Sit = false
                            humanoid.PlatformStand = false
                            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                        end)
                    end
                else
                    lobbyState.finishStationLanding(landing)
                end
            end)
            tween:Play()
        end)
        if not ok then
            lobbyState.finishStationLanding(landing)
            return false, "Safe landing failed: " .. tostring(err)
        end
        -- Always release the root if tween callbacks do not arrive, or if
        -- another script/session cancels the movement.
        task.delay(0.8, function() lobbyState.finishStationLanding(landing) end)
        return true
    end
    local function startPromptInteraction(prompt)
        -- Prevent a delayed barbell prompt from restarting training during rebirth.
        if not (lobbyState.train or (grind.enabled and grind.phase == "training")) or not inLobby()
            or (lobbyState.rebirth and lobbyState.rebirthPhase ~= "idle") then
            lobbyState.stationPending = false
            return
        end
        if type(player:GetAttribute("Training")) == "string" and player:GetAttribute("Training") ~= "" then
            lobbyState.stationPending = false
            return
        end
        if not prompt or not prompt.Parent or not prompt.Enabled then
            lobbyState.trainStatus = "Barbell prompt unavailable; retrying"
            lobbyState.stationPending = false
            return
        end
        local _, _, root = characterReady()
        local pos = promptPosition(prompt)
        local dist = pos and root and (root.Position - pos).Magnitude or math.huge
        if dist > (tonumber(prompt.MaxActivationDistance) or 8) + 1 then
            lobbyState.trainStatus = string.format("Too far from barbell prompt (%.1f studs)", dist)
            lobbyState.stationPending = false
            return
        end
        -- Use the actual ProximityPrompt; never invent a TrainStart remote.
        local invoked = false
        if type(fireproximityprompt) == "function" then
            invoked = pcall(fireproximityprompt, prompt)
        end
        if not invoked then
            local ok = pcall(function() prompt:InputHoldBegin() end)
            if ok then
                invoked = true
                task.delay(math.max(0.06, tonumber(prompt.HoldDuration) or 0) + 0.05, function()
                    pcall(function() if prompt.Parent then prompt:InputHoldEnd() end end)
                end)
            end
        end
        lobbyState.stationPending = false
        lobbyState.trainStatus = invoked
            and "Barbell activated; waiting for server Training state"
            or "Prompt activation failed; will retry"
    end
    local function tryStartTraining(now)
        if lobbyState.rebirth and lobbyState.rebirthPhase ~= "idle" then return end
        if now < lobbyState.rebirthResumeAt then return end
        if lobbyState.stationPending then return end
        if now - lobbyState.lastStation < 4 then return end
        lobbyState.lastStation = now
        local prompt, machine, pos = chooseWeightStation()
        if not prompt then
            lobbyState.trainStatus = "No available TrainPrompt in Lobby.Gym.Barbells"
            return
        end
        lobbyState.stationName = tostring(machine:GetAttribute("MachineId") or machine.Name)
        lobbyState.stationBoost = boostOf(machine)
        lobbyState.stationPrompt = prompt
        lobbyState.stationAttempts = lobbyState.stationAttempts + 1
        local ok, why = teleportToStation(prompt, machine, pos)
        if not ok then lobbyState.trainStatus = why or "Teleport failed"; return end
        lobbyState.trainStatus = string.format("Teleported to %s (%.1fx weight); activating",
            lobbyState.stationName, lobbyState.stationBoost)
        lobbyState.stationPending = true
        -- Wait a frame for the position and local prompt range to update.
        task.delay(0.62, function()
            if not lobbyState.alive then return end
            if lobbyState.stationLanding then
                lobbyState.trainStatus = "Settling at weight station"
                return
            end
            startPromptInteraction(prompt)
        end)
    end
    local function doTraining(now)
        -- The cycle overrides only the effective worker state; it does not
        -- change or uncheck the saved Auto Train toggle.
        if grind.enabled and grind.phase == "gameplay" then
            local active = player:GetAttribute("Training")
            if inLobby() and type(active) == "string" and active ~= ""
                and now - grind.lastTrainStop > 1.1 then
                grind.lastTrainStop = now
                fireRemote("TrainStop")
            end
            lobbyState.trainStatus = "Paused for gameplay phase"
            return
        end
        if not (lobbyState.train or (grind.enabled and grind.phase == "training")) then
            lobbyState.pendingReps = 0
            lobbyState.stationPending = false
            lobbyState.weightUpgradePending = false
            lobbyState.trainStatus = "Off"
            return
        end
        if not inLobby() then
            lobbyState.pendingReps = 0
            lobbyState.weightUpgradePending = false
            lobbyState.trainStatus = "Lobby only"
            return
        end
        -- Rebirth takes priority AS SOON AS ready, even before reaching the statue.
        -- This also blocks TrainRep calls and barbell reactivation during travel.
        if lobbyState.rebirth and lobbyState.rebirthPhase ~= "idle" then
            lobbyState.pendingReps = 0
            lobbyState.stationPending = false
            lobbyState.weightUpgradePending = false
            lobbyState.trainStatus = "Paused for rebirth (" .. lobbyState.rebirthPhase .. ")"
            return
        end
        if now < lobbyState.rebirthResumeAt then
            lobbyState.pendingReps = 0
            lobbyState.trainStatus = "Waiting for rebirth animation to finish"
            return
        end
        local station = player:GetAttribute("Training")
        if type(station) ~= "string" or station == "" then
            lobbyState.pendingReps = 0
            if lobbyState.weightUpgradePending then
                -- The server cleared training: choose the best currently
                -- available station (not necessarily the previous candidate).
                lobbyState.weightUpgradePending = false
                lobbyState.lastStation = -100
                lobbyState.lastRep = 0
                lobbyState.stationPending = false
            end
            tryStartTraining(now)
            return
        end
        lobbyState.stationPending = false
        local currentMachine = machineByTrainingId(station)
        if currentMachine then
            lobbyState.stationBoost = boostOf(currentMachine)
        end

        -- Upgrade automatically if a stronger station is available, including
        -- when the 1.5x area gets unlocked mid-session. Never interfere with
        -- rebirth, which is processed ahead of doTraining on Heartbeat.
        if not lobbyState.weightUpgradePending and currentMachine
            and now - lobbyState.lastWeightReview >= 2.5 then
            lobbyState.lastWeightReview = now
            local _, strongestMachine = chooseWeightStation()
            if strongestMachine and boostOf(strongestMachine) > boostOf(currentMachine) + 0.001 then
                lobbyState.weightUpgradePending = true
                lobbyState.pendingReps = 0
                lobbyState.stationName = tostring(strongestMachine:GetAttribute("MachineId") or strongestMachine.Name)
            end
        end
        if lobbyState.weightUpgradePending then
            lobbyState.pendingReps = 0
            if now - lobbyState.weightUpgradeLastStop >= 1.5 then
                lobbyState.weightUpgradeLastStop = now
                if fireRemote("TrainStop") then
                    lobbyState.trainStatus = "Stopping current weight for stronger station"
                else
                    lobbyState.trainStatus = "Cannot switch weights: TrainStop unavailable"
                end
            else
                lobbyState.trainStatus = "Waiting for server to release current weight"
            end
            return
        end
        -- Match the client game's real Push batching and configured rep rate.
        local settings = type(config.Training) == "table" and config.Training or {}
        local maxRps = math.clamp(tonumber(settings.MaxRepsPerSecond) or 3, 1, 20)
        local sendEvery = math.max(0.2, tonumber(settings.RepSendInterval) or 0.5)
        if lobbyState.lastRep == 0 then lobbyState.lastRep = now - 1 / maxRps end
        local elapsed = now - lobbyState.lastRep
        if elapsed >= 1 / maxRps then
            local due = math.min(8, math.floor(elapsed * maxRps))
            lobbyState.lastRep = now
            lobbyState.pendingReps = math.min(8, lobbyState.pendingReps + due)
        end
        if lobbyState.pendingReps > 0 and now - lobbyState.lastRepSend >= sendEvery then
            local count = lobbyState.pendingReps
            if fireRemote("TrainRep", count) then
                lobbyState.repSent = lobbyState.repSent + count
                lobbyState.trainStatus = string.format("Pushing at %s (%.1fx) | %d reps requested",
                    station, lobbyState.stationBoost, lobbyState.repSent)
                lobbyState.pendingReps = 0
                lobbyState.lastRepSend = now
            else
                lobbyState.trainStatus = "TrainRep RemoteEvent unavailable"
            end
        end
    end
    local function nearRebirthShrine()
        local lobby = workspace:FindFirstChild("Lobby")
        local stations = lobby and lobby:FindFirstChild("Stations")
        local shrine = stations and stations:FindFirstChild("RebirthShrine")
        local _, _, root = characterReady()
        if not shrine or not root then return false end
        for _, object in ipairs(shrine:GetDescendants()) do
            if object:IsA("ProximityPrompt") then
                local pos = promptPosition(object)
                if pos and (root.Position-pos).Magnitude <= (tonumber(object.MaxActivationDistance) or 10) + 4 then
                    return true
                end
            end
        end
        return false
    end
    local function doRebirth(now, data)
        -- Allow an already-started rebirth to complete; do not begin a new
        -- one during gameplay. The original Auto Rebirth toggle is preserved.
        if grind.enabled and grind.phase == "gameplay"
            and lobbyState.rebirthPhase == "idle" then
            lobbyState.rebirthStatus = "Paused for gameplay phase"
            return
        end
        if not lobbyState.rebirth then
            lobbyState.rebirthPhase = "idle"
            lobbyState.rebirthStatus = "Off"
            return
        end
        if not inLobby() then
            lobbyState.rebirthStatus = "Lobby only"
            return
        end

        -- After a confirmed rebirth, give the server a moment to publish the
        -- new training cap before starting another rebirth cycle.
        if lobbyState.rebirthPhase == "idle" and now < lobbyState.rebirthResumeAt then
            lobbyState.rebirthStatus = "Rebirth confirmed; waiting for new stats"
            return
        end
        local currentRebirth = tonumber(data.Rebirth) or 0
        local ready = data.RebirthReady == true
        if not ready then
            local cap, strength = tonumber(data.StrengthCap), tonumber(data.Strength)
            ready = cap ~= nil and strength ~= nil and strength >= cap
        end

        -- Never resume training merely because RebirthReady becomes false during
        -- a pending server response. Confirm a change in the server rebirth count.
        if lobbyState.rebirthPhase == "awaiting" then
            if lobbyState.rebirthBefore ~= nil and currentRebirth > lobbyState.rebirthBefore then
                lobbyState.rebirthPhase = "idle"
                lobbyState.rebirthBefore = nil
                lobbyState.rebirthBeforeSince = 0
                lobbyState.rebirthAttempts = 0
                lobbyState.rebirthResumeAt = now + 2.1
                lobbyState.lastStation = -100
                lobbyState.lastRep = 0
                lobbyState.pendingReps = 0
                lobbyState.stationPending = false
                lobbyState.rebirthStatus = "Rebirth confirmed! Resuming Auto Train"
                return
            end
            if now - lobbyState.rebirthSentAt < 5 then
                lobbyState.rebirthStatus = "Rebirth requested at shrine; waiting for confirmation"
                return
            end
            if lobbyState.rebirthAttempts >= 3 then
                lobbyState.rebirthStatus = "No server confirmation after 3 attempts (check shrine/rules)"
                return
            end
            -- A request can fail even if FireServer did not throw. Retry only
            -- after a delay, and re-check the shrine and training state first.
            lobbyState.rebirthPhase = "travel"
            lobbyState.rebirthStatus = "Retrying rebirth at shrine"
        end

        if not ready then
            lobbyState.rebirthPhase = "idle"
            lobbyState.rebirthBefore = nil
            lobbyState.rebirthAttempts = 0
            lobbyState.rebirthStatus = "Training until rebirth is available"
            return
        end

        if lobbyState.rebirthPhase == "idle" then
            lobbyState.rebirthPhase = "stopping"
            lobbyState.rebirthStopAt = 0
            lobbyState.rebirthAttempts = 0
            lobbyState.rebirthBefore = nil
        end

        -- Critical fix: STOP training *before* trying to travel to the statue.
        -- The training prompt and rep-loop must stay paused throughout this phase.
        if lobbyState.stationLanding then
            lobbyState.finishStationLanding(lobbyState.stationLanding)
        end
        lobbyState.stationPending = false
        lobbyState.pendingReps = 0
        local trainingId = player:GetAttribute("Training")
        local isTraining = type(trainingId) == "string" and trainingId ~= ""
        if isTraining then
            lobbyState.rebirthPhase = "stopping"
            lobbyState.rebirthStopAt = 0
            if now - lobbyState.rebirthLastStop >= 1.1 then
                lobbyState.rebirthLastStop = now
                if fireRemote("TrainStop") then
                    lobbyState.rebirthStatus = "TrainStop sent; waiting for server to release weight"
                else
                    lobbyState.rebirthStatus = "TrainStop remote unavailable"
                end
            else
                lobbyState.rebirthStatus = "Waiting for training state to clear"
            end
            return
        end

        if lobbyState.rebirthPhase == "stopping" then
            if lobbyState.rebirthStopAt == 0 then
                lobbyState.rebirthStopAt = now
            end
            -- The game's own RebirthController waits briefly after TrainStop.
            if now - lobbyState.rebirthStopAt < 0.35 then
                lobbyState.rebirthStatus = "Training stopped; preparing travel"
                return
            end
            lobbyState.rebirthPhase = "travel"
        end

        if not nearRebirthShrine() then
            if now - lobbyState.rebirthLastTravel >= 4 then
                lobbyState.rebirthLastTravel = now
                if fireRemote("TravelTo", "Rebirth") then
                    lobbyState.rebirthStatus = "TravelTo('Rebirth') sent; waiting for statue"
                else
                    lobbyState.rebirthStatus = "TravelTo remote unavailable"
                end
            else
                lobbyState.rebirthStatus = "Travelling to rebirth statue"
            end
            return
        end

        -- Direct no-argument remote; the server still validates requirements
        -- and shrine proximity. Do not click/hold the rebirth UI.
        if now - lobbyState.lastRebirth < 3 then return end
        lobbyState.lastRebirth = now
        lobbyState.rebirthBefore = currentRebirth
        lobbyState.rebirthBeforeSince = now
        if fireRemote("Rebirth") then
            lobbyState.rebirthAttempts = lobbyState.rebirthAttempts + 1
            lobbyState.rebirthPhase = "awaiting"
            lobbyState.rebirthSentAt = now
            lobbyState.rebirthStatus = "Rebirth sent at statue (attempt " .. lobbyState.rebirthAttempts .. ")"
        else
            lobbyState.rebirthStatus = "Rebirth remote unavailable"
        end
    end
    local function doQueue(now)
        if grind.enabled and grind.phase == "training" then
            -- Auto Join may remain ON, but no matchmaking during training.
            if inLobby() and isQueued()
                and now - grind.lastQueueLeave >= 3 then
                grind.lastQueueLeave = now
                fireRemote("QueueLeave")
            end
            lobbyState.queueIssued = false
            lobbyState.queueStatus = "Paused until training phase finishes"
            lobbyState.joinReadyAt = nil
            return
        end
        if not lobbyState.play then
            lobbyState.queueStatus = "Off"
            lobbyState.joinReadyAt = nil
            return
        end
        -- Queueing and pushing reps are independent. Don't gate QueueJoin on
        -- Training or on the rebirth worker. The server decides eligibility.
        if not inLobby() then
            lobbyState.everInMatch = true
            lobbyState.joinReadyAt = nil
            lobbyState.queueStatus = "In match"
            return
        end
        if isQueued() then
            lobbyState.joinReadyAt = nil
            lobbyState.queueIssued = true
            lobbyState.queueRejected = false
            local training = player:GetAttribute("Training")
            lobbyState.queueStatus = (type(training) == "string" and training ~= "")
                and "Queued — training continues while matchmaking"
                or "Queued — awaiting match"
            return
        end
        if lobbyState.queueRejected then
            -- Don't hammer QueueJoin after an explicit server refusal.
            -- Turn Auto Join off/on to retry after the game state changes.
            return
        end
        if lobbyState.everInMatch then
            lobbyState.queueIssued = false
            lobbyState.queueTries = 0
            lobbyState.everInMatch = false
            lobbyState.lastQueue = -100
            lobbyState.joinReadyAt = now + lobbyState.joinDelay
        end
        if not lobbyState.joinReadyAt then
            lobbyState.joinReadyAt = now + lobbyState.joinDelay
        end
        if now < lobbyState.joinReadyAt then
            lobbyState.queueStatus = string.format("Joining in %.1f seconds", lobbyState.joinReadyAt - now)
            return
        end
        if lobbyState.queueIssued then
            if now - lobbyState.lastQueue < 10 then return end
            if lobbyState.queueTries >= 3 then
                lobbyState.queueStatus = "No queue confirmation after 3 requests — toggle to retry"
                return
            end
            lobbyState.queueIssued = false
        end
        if now - lobbyState.lastQueue < 2 then return end
        lobbyState.lastQueue = now
        local mode = lobbyState.mode == "Trials" and "Trials" or "ArenaPVE"
        local def = type(defsModes.get) == "function" and defsModes.get(mode) or nil
        if type(def) == "table" and (def.enabled == false or def.queueable == false) then
            lobbyState.queueStatus = "Mode currently locked/disabled by game"
            return
        end
        -- November update: Survival now offers Team or Solo. The game client
        -- queues ArenaPVE + "solo" only when SurvivalSolo is enabled and unlocked.
        local soloRequested = mode == "ArenaPVE" and lobbyState.survivalChoice == "Solo"
        if soloRequested then
            local solo = type(config.SurvivalSolo) == "table" and config.SurvivalSolo
                or readModule(shared and shared:FindFirstChild("ConfigSurvival"))
            local liveEnabled = gameAttribute("SurvivalSoloOn")
            if liveEnabled == nil then liveEnabled = type(solo) == "table" and solo.On end
            if liveEnabled ~= true or (type(solo) == "table"
                and solo.ModeId ~= nil and solo.ModeId ~= "ArenaPVE") then
                lobbyState.queueStatus = "Solo Survival unavailable in this server"
                return
            end
            if player:GetAttribute("TutorialStage") ~= "Done" then
                lobbyState.queueStatus = "Solo Survival unlocks after the tutorial"
                return
            end
            local partySize = tonumber(player:GetAttribute("PartySize")) or 0
            local partyId = player:GetAttribute("PartyId")
            if partySize >= 2 or (type(partyId) == "string" and partyId ~= ""
                and player:GetAttribute("PartyLeader") ~= true) then
                lobbyState.queueStatus = "Leave the party before joining Solo Survival"
                return
            end
        end
        local okay
        if mode == "Trials" then
            local key = trialKeys[lobbyState.trial] or "t1"
            local trial = type(trialsDef.get) == "function" and trialsDef.get(key) or nil
            if type(trial) == "table" and trial.requires ~= nil then
                -- Leave unlock decisions to server; do not invent flags.
            end
            okay = fireRemote("QueueJoin", "Trials", key)
        elseif soloRequested then
            okay = fireRemote("QueueJoin", "ArenaPVE", "solo")
        else
            okay = fireRemote("QueueJoin", "ArenaPVE")
        end
        lobbyState.queueIssued = okay
        if okay then lobbyState.queueTries = lobbyState.queueTries + 1 end
        local isTraining = type(player:GetAttribute("Training")) == "string"
            and player:GetAttribute("Training") ~= ""
        local choiceLabel = mode == "ArenaPVE" and (" " .. lobbyState.survivalChoice) or ""
        lobbyState.queueStatus = okay and (
            "Queue requested: " .. lobbyState.mode .. choiceLabel
            .. (isTraining and " (training continues)" or "")
            .. " — awaiting server confirmation"
        ) or "QueueJoin remote missing"
    end
    local function doChest(now, data)
        if not lobbyState.chestBuy then lobbyState.chestStatus = "Off"; return end
        if not inLobby() then lobbyState.chestStatus = "Lobby only"; return end
        if now < lobbyState.chestBuyBackoffUntil then return end
        local cash = tonumber(data.Cash) or 0
        if lobbyState.chestCashBefore ~= nil then
            -- Only buy another chest after the previous purchase is reflected in
            -- Cash or the exact purchased UID is present in OwnedChests.
            local owned = type(data.OwnedChests) == "table" and data.OwnedChests or nil
            if cash < lobbyState.chestCashBefore
                or (lobbyState.chestBuyUid and owned and owned[lobbyState.chestBuyUid] ~= nil) then
                lobbyState.chestCashBefore = nil
                lobbyState.chestBuyUid = nil
            elseif now < lobbyState.chestWaitUntil then
                lobbyState.chestStatus = "Awaiting purchase sync"
                return
            else
                -- An event alone can be ahead of the ClientState inventory.
                -- Back off rather than repeatedly buying against stale Cash.
                lobbyState.chestCashBefore = nil
                lobbyState.chestBuyUid = nil
                lobbyState.chestBuyBackoffUntil = now + 0.8
                lobbyState.chestStatus = "Purchase unconfirmed; waiting for sync"
                return
            end
        end
        local affordable, price = canAffordChest(lobbyState.chestTier, cash)
        if not price then lobbyState.chestStatus = "Chest price unavailable"; return end
        if not affordable then
            lobbyState.chestStatus = string.format("Need %d Cash | Have %d", price, cash)
            return
        end
        -- The game's Chest config caps owned chests. Leave room for auto-open
        -- to process them instead of sending rejected purchases at the cap.
        if type(data.OwnedChests) == "table" then
            local ownedCount, maxOwned = 0, tonumber(chestSettings.MaxOwned) or 60
            for _ in pairs(data.OwnedChests) do ownedCount = ownedCount + 1 end
            if ownedCount >= maxOwned then
                lobbyState.chestStatus = "Chest inventory full; open chests first"
                return
            end
        end
        if now - lobbyState.lastChest < chestPace.buy then return end
        lobbyState.lastChest = now
        if fireRemote("ChestBuy", lobbyState.chestTier) then
            lobbyState.chestCashBefore = cash
            lobbyState.chestBuyTier = lobbyState.chestTier
            lobbyState.chestBuyUid = nil
            lobbyState.chestWaitUntil = now + chestPace.buyTimeout
            lobbyState.chestStatus = "Buying " .. lobbyState.chestTier .. " Chest — awaiting server"
        else
            lobbyState.chestStatus = "ChestBuy remote missing"
            lobbyState.chestBuyBackoffUntil = now + 1
        end
    end
    -- Open the oldest owned chest, using the exact owned chest UID. The
    -- Chest Merchant dropdown controls buying; opening processes all earned
    -- tiers, including reward chests, while in the lobby.
    local chestResult = remotes and remotes:FindFirstChild("ChestResult")
    if chestResult and chestResult:IsA("RemoteEvent") then
        lobbyState.chestOpenResultConn = chestResult.OnClientEvent:Connect(function(packet)
            if type(packet) ~= "table" then return end
            if packet.bought then
                -- Purchase results share the ChestResult event with openings.
                if lobbyState.chestCashBefore ~= nil
                    and (packet.tier == nil or packet.tier == lobbyState.chestBuyTier) then
                    if packet.ok == false then
                        lobbyState.chestCashBefore = nil
                        lobbyState.chestBuyUid = nil
                        lobbyState.chestBuyBackoffUntil = os.clock() + 1.5
                        lobbyState.chestStatus = "Purchase denied: " .. tostring(packet.reason or "unknown")
                    elseif packet.ok == true then
                        if type(packet.chestUid) == "string" then
                            lobbyState.chestBuyUid = packet.chestUid
                        end
                        lobbyState.chestStatus = "Purchase accepted; syncing inventory"
                    end
                end
                return
            end
            if packet.purchased then return end
            local uid = lobbyState.chestOpenPending
            if not uid then return end
            if packet.chestUid and packet.chestUid ~= uid then return end
            if packet.ok and type(packet.item) == "table" then
                lobbyState.chestOpenStatus = "Opened " .. uid
                lobbyState.chestOpenPending = nil
            elseif packet.ok == false then
                lobbyState.chestOpenStatus = "Chest refused: " .. tostring(packet.reason or "unknown")
                lobbyState.chestOpenSkip[uid] = os.clock() + 12
                lobbyState.chestOpenPending = nil
            end
        end)
    end
    -- V31: Chest results are awarded by the server's ChestResult event.
    -- The visible Collect button is a LOCAL Bronze Kit button; there is no
    -- ChestCollect RemoteEvent in this captured game. Use the game's own
    -- Bronze Kit button .press() so its Collect callback closes the overlay.
    -- Also use the game's registered chest-skip input while a reveal plays.
    local chestUi = {
        kit = nil, controller = nil, nextRequire = 0,
        lastCollect = -100, lastSkip = -100, nextScan = 0,
        lastUiState = "", lastCollectButton = nil,
    }

    function chestUi.load(now)
        if now < chestUi.nextRequire then return end
        chestUi.nextRequire = now + 1.0
        if not chestUi.kit then
            local uiFolder = shared and shared:FindFirstChild("UI")
            local bronze = uiFolder and uiFolder:FindFirstChild("Bronze")
            chestUi.kit = readModule(bronze and bronze:FindFirstChild("Kit"))
        end
        if not chestUi.controller and type(s.getCutsceneController) == "function" then
            chestUi.controller = s.getCutsceneController("ChestController")
        end
    end

    function chestUi.visible(object)
        local gui = player:FindFirstChildOfClass("PlayerGui")
        if not gui or not object:IsDescendantOf(gui) then return false end
        local node = object
        while node and node ~= gui do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        return true
    end

    function chestUi.reveal()
        local gui = player:FindFirstChildOfClass("PlayerGui")
        if not gui then return nil, nil end
        local screen = gui:FindFirstChild("ChestReveal", true)
        if not screen or not screen:IsA("ScreenGui") or not screen.Enabled then
            return nil, nil
        end
        return screen, screen:FindFirstChild("ChestOpening", true)
    end

    function chestUi.busy()
        local controller = chestUi.controller
        if not controller or type(controller.isBusy) ~= "function" then return false end
        local ok, busy = pcall(controller.isBusy)
        return ok and busy == true
    end

    function chestUi.skip()
        -- Space is bound by ChestRevealFx and ChestCutscene3D to their own
        -- skip handlers. The game may lock skipping on a first-time reveal.
        local ok, virtualInput = pcall(function()
            return game:GetService("VirtualInputManager")
        end)
        if not ok or not virtualInput then return false end
        return pcall(function()
            virtualInput:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
            virtualInput:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        end)
    end

    function chestUi.tick(now)
        local skipEnabled = s.cutsceneSkipState and s.cutsceneSkipState.enabled == true
        if not (lobbyState.chestOpen or skipEnabled) then return end
        if now < chestUi.nextScan then return end
        chestUi.nextScan = now + 0.05
        chestUi.load(now)

        local screen, overlay = chestUi.reveal()
        local busy = chestUi.busy()
        if not overlay and not busy then
            chestUi.lastCollectButton = nil
            return
        end

        -- Once the server result has reached the reward screen, the game
        -- constructs a TextButton named Collect. Its Bronze Kit .press()
        -- invokes the same local close callback as a genuine user press.
        if overlay then
            local collect = overlay:FindFirstChild("Collect", true)
            if collect and collect:IsA("GuiButton") and chestUi.visible(collect) then
                if not lobbyState.chestOpen then return end
                if now - chestUi.lastCollect >= 0.14 then
                    chestUi.lastCollect = now
                    local kit = chestUi.kit
                    local registered = kit and kit.padButtons and kit.padButtons[collect]
                    if registered and type(registered.press) == "function" then
                        local okPress, pressed = pcall(registered.press)
                        if okPress and pressed ~= false then
                            lobbyState.chestOpenStatus = "Collected reward; closing reveal"
                            chestUi.lastCollectButton = collect
                            return
                        end
                    end
                    -- Optional fallback for client versions without Bronze Kit
                    -- button registration. This is a local UI action, NOT a
                    -- fabricated Collect server remote.
                    if type(getconnections) == "function" then
                        local okCon, connections = pcall(getconnections, collect.Activated)
                        if okCon and type(connections) == "table" then
                            for _, conn in ipairs(connections) do
                                if type(conn.Function) == "function" then
                                    local okFire = pcall(conn.Function)
                                    if okFire then
                                        lobbyState.chestOpenStatus = "Collected reward via UI callback"
                                        return
                                    end
                                end
                            end
                        end
                    end
                    -- Input fallback if this game version does not expose the
                    -- Kit button registry. Press only the actual Collect button.
                    local okInput, virtualInput = pcall(function()
                        return game:GetService("VirtualInputManager")
                    end)
                    if okInput and virtualInput and collect.AbsoluteSize.X > 0 then
                        local pos, size = collect.AbsolutePosition, collect.AbsoluteSize
                        local x = math.floor(pos.X + size.X / 2)
                        local y = math.floor(pos.Y + size.Y / 2)
                        local clicked = pcall(function()
                            virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
                            virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
                        end)
                        lobbyState.chestOpenStatus = clicked
                            and "Collect click attempted" or "Collect input unavailable"
                    else
                        lobbyState.chestOpenStatus = "Collect input unavailable"
                    end
                end
                return -- Never issue Skip while Collect is visible.
            end
        end

        -- Auto Open always skips its own reveals. Skip Cutscenes also skips
        -- manually opened chests but does NOT auto-collect those rewards.
        if (lobbyState.chestOpen or skipEnabled) and (overlay or busy)
           and now - chestUi.lastSkip >= 0.2 then
            chestUi.lastSkip = now
            -- The overlay's Skip is a full-screen TextButton whose Activated
            -- handler toggles the game's own skip flag during the shake phase.
            local skipButton = overlay and overlay:FindFirstChild("Skip", true)
            local fired = false
            if skipButton and skipButton:IsA("GuiButton") and type(getconnections) == "function" then
                local okCon, connections = pcall(getconnections, skipButton.Activated)
                if okCon and type(connections) == "table" then
                    for _, conn in ipairs(connections) do
                        if type(conn.Function) == "function" then
                            fired = pcall(conn.Function) or fired
                        end
                    end
                end
            end
            if not fired and skipButton and type(firesignal) == "function" then
                fired = pcall(firesignal, skipButton.Activated)
            end
            if not fired then
                chestUi.skip()
            end
        end
    end

    local function doChestOpen(now, data)
        if not lobbyState.chestOpen then
            lobbyState.chestOpenStatus = "Off"
            return
        end
        if not inLobby() then
            lobbyState.chestOpenStatus = "Waiting for lobby"
            return
        end
        -- Do not request another ChestOpen until the previous reward's
        -- Collect callback has closed the current chest reveal.
        chestUi.load(now)
        if chestUi.busy() then
            lobbyState.chestOpenStatus = "Waiting for chest reveal / Collect"
            return
        end
        local activeChestScreen, activeChestOverlay = chestUi.reveal()
        if activeChestOverlay then
            lobbyState.chestOpenStatus = "Finishing chest reward screen"
            return
        end
        local owned = type(data.OwnedChests) == "table" and data.OwnedChests or nil
        if not owned then
            lobbyState.chestOpenStatus = "Owned chests not available yet"
            return
        end
        local pending = lobbyState.chestOpenPending
        if pending then
            if owned[pending] == nil then
                lobbyState.chestOpenPending = nil
                lobbyState.chestOpenStatus = "Chest opened: " .. tostring(pending)
            elseif now - lobbyState.chestOpenSentAt <= 6 then
                lobbyState.chestOpenStatus = "Waiting for chest result"
                return
            else
                -- Avoid endlessly retrying the same chest when rejected.
                lobbyState.chestOpenSkip[pending] = now + 12
                lobbyState.chestOpenPending = nil
                lobbyState.chestOpenStatus = "No confirmation; trying next later"
                return
            end
        end
        if now - lobbyState.lastChestOpen < chestPace.open then return end
        local candidates = {}
        for uid, entry in pairs(owned) do
            local tier = type(entry) == "string" and entry
                or type(entry) == "table" and (entry.tier or entry.Tier)
            if type(uid) == "string" and type(tier) == "string"
                and now >= (lobbyState.chestOpenSkip[uid] or 0) then
                candidates[#candidates+1] = {uid = uid, tier = tier}
            end
        end
        if #candidates == 0 then
            lobbyState.chestOpenStatus = "No unopened chests"
            return
        end
        local tierOrder = {Common = 1, Rare = 2, Epic = 3, Legendary = 4}
        table.sort(candidates, function(a,b)
            local ta, tb = tierOrder[a.tier] or 9, tierOrder[b.tier] or 9
            if ta ~= tb then return ta < tb end
            return a.uid < b.uid
        end)
        local pick = candidates[1]
        lobbyState.lastChestOpen = now
        if fireRemote("ChestOpen", pick.uid) then
            lobbyState.chestOpenPending = pick.uid
            lobbyState.chestOpenSentAt = now
            lobbyState.chestOpenStatus = "Requested " .. pick.tier .. " chest " .. pick.uid
        else
            lobbyState.chestOpenStatus = "ChestOpen remote unavailable"
        end
    end
    local function defFor(tbl, id)
        if type(id) ~= "string" then return nil end
        if type(tbl.get) == "function" then
            local ok, def = pcall(tbl.get, id)
            if ok and type(def) == "table" then return def end
        end
        if type(tbl.byId) == "table" and type(tbl.byId[id]) == "table" then return tbl.byId[id] end
        if type(tbl[id]) == "table" then return tbl[id] end
        if type(tbl.list) == "table" then
            for _, x in ipairs(tbl.list) do
                if type(x) == "table" and x.id == id then return x end
            end
        end
        return nil
    end
    local function selectedWeapon(data, id)
        if data.SelectedWeapon == id then return true end
        if type(data.SelectedWeapons) == "table" then
            for _, x in pairs(data.SelectedWeapons) do
                if x == id then return true end
            end
        end
        return false
    end
    -- The in-game Inventory has a "Sell spares" action. Its remote is
    -- ItemSell:FireServer("All"), which handles duplicate armor and weapon
    -- spares without selling the last base copy of each weapon/item.
    -- Read the same inventory collections to avoid redundant sell requests.
    local function spareInventory(data)
        local groups, entries, total = {}, {}, 0
        local ownedArmor = type(data.OwnedArmor) == "table" and data.OwnedArmor or {}
        for _, id in pairs(ownedArmor) do
            if type(id) == "string" then
                groups[id] = (groups[id] or 0) + 1
            end
        end
        for id, count in pairs(groups) do
            local extra = count - 1
            if extra > 0 and defFor(defsArmor, id) then
                total = total + extra
                entries[#entries + 1] = "A:" .. id .. ":" .. tostring(extra)
            end
        end
        local spares = type(data.Spares) == "table" and data.Spares or {}
        local weapons = type(spares.Weapon) == "table" and spares.Weapon or {}
        for id, quantity in pairs(weapons) do
            local n = tonumber(quantity)
            n = n and n == n and n ~= math.huge and n ~= -math.huge
                and math.max(0, math.floor(n)) or 0
            if n > 0 and type(id) == "string" and defFor(defsWeapons, id) then
                total = total + n
                entries[#entries + 1] = "W:" .. id .. ":" .. tostring(n)
            end
        end
        table.sort(entries)
        return total, table.concat(entries, "|")
    end

    local function saleCandidate(data)
        local locks = type(data.ItemLocks) == "table" and data.ItemLocks or {}
        local armored = type(data.OwnedArmor) == "table" and data.OwnedArmor or {}
        local equipped = type(data.EquippedArmor) == "table" and data.EquippedArmor or {}
        local groups = {}
        for uid, id in pairs(armored) do
            if type(uid) == "string" and type(id) == "string" then
                local def = defFor(defsArmor, id)
                if def and lobbyState.rarities[def.rarity] then
                    local item = groups[id]
                    if not item then item = {count = 0, free = 0}; groups[id] = item end
                    item.count = item.count + 1
                    local isEquipped = false
                    for _, eqUid in pairs(equipped) do
                        if eqUid == uid then isEquipped = true; break end
                    end
                    if not isEquipped and not (type(locks.Armor) == "table" and locks.Armor[uid] == true) then
                        item.free = item.free + 1
                    end
                end
            end
        end
        for id, group in pairs(groups) do
            if group.free > 0 then
                return "Armor", id, "Armor " .. id
            end
        end
        local weaponsOwned = type(data.OwnedWeapons) == "table" and data.OwnedWeapons or {}
        local spares = type(data.Spares) == "table" and type(data.Spares.Weapon) == "table" and data.Spares.Weapon or {}
        for id, owned in pairs(weaponsOwned) do
            if owned == true and type(id) == "string" then
                local def = defFor(defsWeapons, id)
                if def and lobbyState.rarities[def.rarity] and def.starter ~= true
                    and not (type(locks.Weapon) == "table" and locks.Weapon[id] == true) then
                    local spareCount = tonumber(spares[id]) or 0
                    if spareCount > 0 or not selectedWeapon(data, id) then
                        -- If only one weapon remains, preserve it for its kit.
                        local other = false
                        for otherId, has in pairs(weaponsOwned) do
                            if has == true and otherId ~= id then
                                local alt = defFor(defsWeapons, otherId)
                                if alt and alt.kit == def.kit and alt.enabled ~= false then
                                    other = true; break
                                end
                            end
                        end
                        if spareCount > 0 or other then
                            return "Weapon", id, "Weapon " .. id
                        end
                    end
                end
            end
        end
        return nil
    end
    local function signature(data, kind, id)
        if kind == "All" then
            local _, fingerprint = spareInventory(data)
            return fingerprint
        end
        local owned = kind == "Armor" and data.OwnedArmor or data.OwnedWeapons
        if type(owned) ~= "table" then return "missing" end
        if kind == "Armor" then
            local n = 0
            for _, x in pairs(owned) do if x == id then n = n + 1 end end
            return tostring(n)
        end
        local spares = type(data.Spares) == "table" and data.Spares.Weapon or {}
        return tostring(owned[id]) .. ":" .. tostring(type(spares) == "table" and spares[id] or 0)
    end
    local function doSell(now, data)
        if not lobbyState.sell then lobbyState.sellStatus = "Off"; return end
        if not inLobby() then lobbyState.sellStatus = "Lobby only"; return end
        if next(lobbyState.rarities) == nil then
            lobbyState.sellStatus = "Select rarities first"
            return
        end
        if lobbyState.saleId ~= nil then
            local current = signature(data, lobbyState.saleKind, lobbyState.saleId)
            if current == lobbyState.saleSignature
                and now - lobbyState.lastSell < chestPace.sellAckTimeout then
                lobbyState.sellStatus = "Awaiting item inventory update"
                return
            end
            lobbyState.saleId, lobbyState.saleSignature = nil, nil
        end
        if now - lobbyState.lastSell < chestPace.sell then return end
        -- "Spares" is a seventh multi-select option, independent of rarity.
        -- Use the real in-game Sell Spares action. Do not repeatedly send the
        -- same request if the server hasn't reflected an inventory change.
        if lobbyState.rarities.Spares then
            local count, fingerprint = spareInventory(data)
            if count > 0 then
                if fingerprint ~= lobbyState.lastSpareSignature or now >= lobbyState.nextSpareRetry then
                    lobbyState.lastSell = now
                    lobbyState.lastSpareSignature = fingerprint
                    lobbyState.nextSpareRetry = now + 6
                    lobbyState.saleId = "__all_spares__"
                    lobbyState.saleKind = "All"
                    lobbyState.saleSignature = fingerprint
                    if fireRemote("ItemSell", "All") then
                        lobbyState.sellStatus = "Sell spares requested: " .. tostring(count)
                    else
                        lobbyState.sellStatus = "ItemSell remote unavailable"
                        lobbyState.saleId, lobbyState.saleSignature = nil, nil
                        lobbyState.nextSpareRetry = now + 2
                    end
                    return
                end
            end
        end
        local kind, id, name = saleCandidate(data)
        if not kind then
            lobbyState.sellStatus = lobbyState.rarities.Spares
                and "No other eligible gear; waiting for spares" or "No eligible unlocked, unequipped gear"
            return
        end
        lobbyState.lastSell = now
        lobbyState.saleId = id
        lobbyState.saleKind = kind
        lobbyState.saleSignature = signature(data, kind, id)
        if fireRemote("ItemSell", kind, id) then
            lobbyState.sellStatus = "Sell request: " .. name
        else
            lobbyState.sellStatus = "ItemSell remote missing"
            lobbyState.saleId, lobbyState.saleSignature = nil, nil
        end
    end
    -- V42: isolate UI-only locals inside their own function so this large
    -- lobby automation scope stays below Luau's 200-local-register limit.
    -- This retains the same control callbacks and saved flags.
    local function buildLobbyControls()
        -- Lobby: compact columns, grouped by the action each feature controls.
        lobbyTab:CreateSection({name = "Matchmaking"})
