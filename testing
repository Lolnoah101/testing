                Snapshot.Earned = tonumber(ReadLeaf(Participant.earned)) or 0
                Snapshot.Bonus = tonumber(ReadLeaf(Participant.bonus)) or 0
                Snapshot.Gems = tonumber(ReadLeaf(Participant.gems)) or 0
                Snapshot.XP = tonumber(ReadLeaf(Participant.xp)) or 0
                Snapshot.Crystals = tonumber(ReadLeaf(Participant.crystals)) or 0
