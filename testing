-- Scoped so the UI display handle does not increase the main Luau local
-- register count in this already very large script.
;(function()
    local TrialsFloorDisplay = LobbyTab:CreateStat({
        name = "Trials Floor",
        value = 0,
    })

    -- UI-only status refresh. The queue builder resolves the live floor again
    -- at join time; no stale saved-floor value is used for queue requests.
    task.spawn(function()
        local last = nil
        while GENV.__AZ_ACTIVE_WINDOW == Window and not Window.unloaded do
            local top = GENV.__AZ_GET_TOP_TRIALS_FLOOR()
            if top then
                Settings.SelectedTrialsRoom = top
                if top ~= last then
                    last = top
                    pcall(function() TrialsFloorDisplay:Set(top) end)
                    print("[Anime Zero][Trials] Highest unlocked floor:", top)
                end
            end
            task.wait(3)
        end
    end)
end)()

