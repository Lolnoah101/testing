local function GetSingleSelection(Value)

    if typeof(Value) == "string" then
        return Value
    end


    if typeof(Value) == "table" then

        if typeof(Value[1]) == "string" then
            return Value[1]
        end


        for Key, Enabled in pairs(Value) do

            if typeof(Key) == "string"
                and Enabled == true
            then

                return Key
            end
        end
    end


    return nil
end


local function ApplySkillSelection(Value)

    Settings.SelectedSkills = {
        ["Skill 1"] = false,
        ["Skill 2"] = false,
        ["Skill 3"] = false,
    }


    if typeof(Value) ~= "table" then
        return
    end


    for Key, Selected in pairs(Value) do

        if typeof(Key) == "number"
            and typeof(Selected) == "string"
        then

            if Settings.SelectedSkills[Selected] ~= nil then
                Settings.SelectedSkills[Selected] = true
            end


        elseif typeof(Key) == "string"
            and Selected == true
        then

            if Settings.SelectedSkills[Key] ~= nil then
                Settings.SelectedSkills[Key] = true
            end
        end
    end
end


