--//============================================================
--// CORE UI FLAG BRIDGE
--//
--// Rayfield Gen2 keeps the live control values in Window.Flags. The game
--// update/reload path can occasionally leave a visual toggle changed while
--// the script's Settings table is still holding the previous value. The
--// farm/queue engines read Settings, so that looks exactly like "the toggle
--// does nothing" even though the UI moved.
--//
--// This bridge watches the actual Rayfield flags and only reacts when a flag
--// really changes. It does NOT continuously overwrite Settings, so internal
--// automation can still temporarily change Settings without fighting the UI.
--//============================================================

;(function()

    if type(GENV.__AZ_CORE_UI_BRIDGE) == "table" then
        GENV.__AZ_CORE_UI_BRIDGE.Active = false
    end

    local Bridge = {
        Active = true,
        Last = {},
        LastChangeAt = 0,
    }

    GENV.__AZ_CORE_UI_BRIDGE = Bridge

    local Specs = {
        AutoJoinMap = { setting = "AutoJoinMap", group = "lobby" },
        AutoJoinEndless = { setting = "AutoJoinEndless", group = "lobby" },
        AutoJoinRaid = { setting = "AutoJoinRaid", group = "lobby" },
        AutoJoinTrials = { setting = "AutoJoinTrials", group = "lobby" },
        AutoJoinTidal = { setting = "AutoJoinTidal", group = "lobby" },
        AutoStartVote = { setting = "AutoStartVote", group = "lobby" },
        AutoRetry = { setting = "AutoRetry", group = "lobby" },
        AutoLeave = { setting = "AutoLeave", group = "lobby" },
        AutoNext = { setting = "AutoNext", group = "lobby" },
        AutoLeaveAfterMatches = { setting = "AutoLeaveAfterMatches", group = "lobby" },
        AutoLeaveEndlessAtWave = { setting = "AutoLeaveEndlessAtWave", group = "lobby" },

        AutoFarm = { setting = "AutoFarm", group = "farm" },
        AutoTrialsFarm = { setting = "AutoTrialsFarm", group = "farm" },
        AutoRaidFarm = { setting = "AutoRaidFarm", group = "farm" },
        AutoTidalFarm = { setting = "AutoTidalFarm", group = "farm" },
        AutoFateBlessings = { setting = "AutoFateBlessings", group = "farm" },
        AutoMoltenBlessings = { setting = "AutoMoltenBlessings", group = "farm" },
        AutoArise = { setting = "AutoArise", group = "farm" },
        AutoPickupLoot = { setting = "AutoPickupLoot", group = "farm" },
        AutoM1 = { setting = "AutoM1", group = "farm" },
        AutoSkills = { setting = "AutoSkills", group = "farm" },
        AutoUltimate = { setting = "AutoUltimate", group = "farm" },
        AutoBlock = { setting = "AutoBlock", group = "farm" },
    }

    local function SetOtherFlag(Flag, Value)
        local Spec = Specs[Flag]
        if Spec and Spec.group == "lobby"
            and type(Settings.SetLobbyUserPreference) == "function"
        then
            pcall(Settings.SetLobbyUserPreference, Spec.setting, Value == true)
        end
        pcall(function()
            if Window
                and type(Window.Set) == "function"
            then
                Window:Set(Flag, Value)
            end
        end)
    end

    local function ApplyFlag(Flag, Spec, Value, Initial)
        Value = Value == true
        Settings[Spec.setting] = Value

        if Spec.group == "lobby" then
            if type(Settings.SetLobbyUserPreference) == "function" then
                pcall(Settings.SetLobbyUserPreference, Spec.setting, Value)
            end
        elseif Spec.group == "farm" then
            if type(Settings.SetFarmUserPreference) == "function" then
                pcall(Settings.SetFarmUserPreference, Spec.setting, Value)
            end
        end

        if Flag == "AutoJoinMap" and Value then
            Settings.AutoJoinEndless = false
            Settings.AutoJoinRaid = false
            Settings.AutoJoinTrials = false
            Settings.AutoJoinTidal = false
            SetOtherFlag("AutoJoinEndless", false)
            SetOtherFlag("AutoJoinRaid", false)
            SetOtherFlag("AutoJoinTrials", false)
            SetOtherFlag("AutoJoinTidal", false)
            pcall(ResetLobbyState)

        elseif Flag == "AutoJoinEndless" and Value then
            Settings.AutoJoinMap = false
            Settings.AutoJoinRaid = false
            Settings.AutoJoinTrials = false
            Settings.AutoJoinTidal = false
            SetOtherFlag("AutoJoinMap", false)
            SetOtherFlag("AutoJoinRaid", false)
            SetOtherFlag("AutoJoinTrials", false)
            SetOtherFlag("AutoJoinTidal", false)
            pcall(ResetLobbyState)

        elseif Flag == "AutoJoinRaid" and Value then
            Settings.AutoJoinMap = false
            Settings.AutoJoinEndless = false
            Settings.AutoJoinTrials = false
            Settings.AutoJoinTidal = false
            SetOtherFlag("AutoJoinMap", false)
            SetOtherFlag("AutoJoinEndless", false)
            SetOtherFlag("AutoJoinTrials", false)
            SetOtherFlag("AutoJoinTidal", false)
            pcall(ResetLobbyState)

        elseif Flag == "AutoJoinTrials" and Value then
            Settings.AutoJoinMap = false
            Settings.AutoJoinEndless = false
            Settings.AutoJoinRaid = false
            Settings.AutoJoinTidal = false
            SetOtherFlag("AutoJoinMap", false)
            SetOtherFlag("AutoJoinEndless", false)
            SetOtherFlag("AutoJoinRaid", false)
            SetOtherFlag("AutoJoinTidal", false)
            pcall(ResetLobbyState)

        elseif Flag == "AutoJoinTidal" and Value then
            for _, Other in ipairs({
                "AutoJoinMap", "AutoJoinEndless", "AutoJoinRaid", "AutoJoinTrials"
            }) do
                Settings[Other] = false
                SetOtherFlag(Other, false)
            end
            pcall(ResetLobbyState)

        elseif Flag == "AutoRetry" and Value then
            Settings.AutoLeave = false
            Settings.AutoNext = false
            SetOtherFlag("AutoLeave", false)
            SetOtherFlag("AutoNext", false)

        elseif Flag == "AutoLeave" and Value then
            Settings.AutoRetry = false
            Settings.AutoNext = false
            SetOtherFlag("AutoRetry", false)
            SetOtherFlag("AutoNext", false)

        elseif Flag == "AutoNext" and Value then
            Settings.AutoRetry = false
            Settings.AutoLeave = false
            SetOtherFlag("AutoRetry", false)
            SetOtherFlag("AutoLeave", false)

        elseif Flag == "AutoFarm" and not Value then
            if not GENV.__AZ_IS_RAID_MODE() then
                pcall(ReleaseFarmMovement)
            end

        elseif Flag == "AutoM1" and Value then
            NextM1RequestAt = 0

        elseif Flag == "AutoArise" then
            if type(GENV.__AZ_FARM_RESCUE_RUNTIME) == "table" then
                GENV.__AZ_FARM_RESCUE_RUNTIME.AriseState =
                    Value and "Waiting" or "Off"
            end
        end

        if not Initial then
            Bridge.LastChangeAt = os.clock()
            print(
                "[Anime Zero][UI Bridge]",
                tostring(Flag),
                "=",
                tostring(Value),
                "| runtime=",
                tostring(Settings[Spec.setting] == true)
            )
        end
    end

    task.spawn(function()
        -- Let Rayfield finish its own autoLoad first.
        task.wait(1.0)

        while Bridge.Active
            and GENV.__AZ_CORE_UI_BRIDGE == Bridge
        do
            for Flag, Spec in pairs(Specs) do
                local Success, Value = pcall(function()
                    return Window.Flags[Flag]
                end)

                if Success and type(Value) == "boolean" then
                    local Previous = Bridge.Last[Flag]

                    if Previous == nil then
                        -- Avoid manufacturing a toggle press when an old
                        -- Rayfield config doesn't match cross-place settings.
                        -- Live callbacks handle real user presses.
                        Bridge.Last[Flag] = Value

                    elseif Previous ~= Value then
                        Bridge.Last[Flag] = Value
                        ApplyFlag(Flag, Spec, Value, false)
                    end
                end
            end

            task.wait(0.08)
        end
    end)
end)()


