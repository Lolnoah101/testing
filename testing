Farm.timerStatusConnection = RunService.Heartbeat:Connect(function(dt)
    if Farm.unloaded then return end
    Farm.timerStatusAccum = Farm.timerStatusAccum + dt
    if Farm.timerStatusAccum < 0.5 then return end
    Farm.timerStatusAccum = 0
    local elapsed, source = getMatchElapsed()
    local aliveCount = #getLivingTitans()
    local reserved = getReservedLastTitan()
    local state
    if not Farm.lastTitanEnabled then
        state = "Off"
    elseif source == "Waiting for first Titan" then
        state = "Waiting for match start"
    elseif elapsed >= Farm.lastTitanAtSeconds then
        state = "Ready to finish"
    elseif Farm.waitingFreezeActive then
        state = Farm.lastTitanAirOrbitEnabled
            and "Last Titan protected (air orbit test)"
            or "Last Titan protected (air hold)"
    elseif reserved then
        state = "Holding 1 Titan"
    else
        state = "Waiting for Titans"
    end
    local shownTime = source == "Waiting for first Titan" and "waiting"
        or ((tostring(source):find("estimate", 1, true) and "~" or "") .. formatTime(elapsed))
    local line = string.format("Match %s | Kill at %s | %s | Titans %d | %s",
        shownTime, Farm.lastTitanAtText, state, aliveCount, source)
    -- Game Seconds is a results snapshot in this export. Show it as a
    -- reference, not a running clock. Never treat it as proof of active time.
    local snapshot = Farm.matchServerSecondsLast
