    --//========================================================
    --// AUTO CRAFT
    --//========================================================

    task.spawn(function()

        while ExtraAlive() do

            local AccessoryData =
                GetAccessoryAutomationSettings()

            local AccessoryMode =
                AccessoryData
                and AccessoryData.AutoCraftAccessories == true

            if not ExtraSettings.AutoCraft
                and not AccessoryMode
            then
                task.wait(0.10)
                continue
            end


            local SelectedName = nil
            local Recipe = nil
            local AutomationMode = false


            if AccessoryMode then
                AutomationMode = true

                -- The multi-accessory automation owns crafting while active,
                -- so the older single-item toggle cannot send competing requests.
                if ExtraSettings.AutoCraft then
                    ExtraSettings.AutoCraft = false
                    RequestToggle(
                        "Craft",
                        false
                    )
                end

                local SelectedCount = 0
                local IncompleteCount = 0

                for _, ItemName in ipairs(CraftOptions) do
                    if type(AccessoryData.SelectedAccessories) == "table"
                        and AccessoryData.SelectedAccessories[ItemName] == true
                    then
                        SelectedCount = SelectedCount + 1

                        local Candidate =
                            CraftRecipes[ItemName]

                        if Candidate then
                            local Owned =
                                GetExtraAccessoryCount(
                                    Candidate.AccessoryId
                                )

                            local Complete =
                                AccessoryData.CraftOneEach == true
                                and Owned >= 1

                            if not Complete then
                                IncompleteCount =
                                    IncompleteCount + 1

                                local CanCraft =
                                    CheckCraftMaterials(
                                        Candidate
                                    )

                                if CanCraft
                                    and not Recipe
                                then
                                    SelectedName = ItemName
                                    Recipe = Candidate
                                end
                            end
                        end
                    end
                end

                if SelectedCount == 0 then
                    StopAccessoryAutomation(
                        "Select at least one accessory first."
                    )
                    task.wait(0.25)
                    continue
                end

                if AccessoryData.CraftOneEach == true
                    and IncompleteCount == 0
                then
                    StopAccessoryAutomation(
                        "Finished: you own at least one of every selected accessory."
                    )
                    task.wait(0.25)
                    continue
                end

                -- Nothing affordable right now. Keep the automation enabled
                -- so newly earned materials can immediately be used later.
                if not Recipe then
                    task.wait(0.75)
                    continue
                end

            else
                SelectedName =
                    ExtraSettings.CraftItem

                Recipe =
                    CraftRecipes[SelectedName]

                if not Recipe then
                    ExtraSettings.AutoCraft = false
                    RequestToggle(
                        "Craft",
                        false
                    )
                    task.wait(0.20)
                    continue
                end

                local CanCraft,
                    Missing =
                    CheckCraftMaterials(
                        Recipe
                    )

                if not CanCraft then
                    ExtraSettings.AutoCraft = false
                    RequestToggle(
                        "Craft",
                        false
                    )

                    local Text =
                        MissingMaterialsText(
                            Missing
                        )

                    warn(
                        "[Anime Zero][Crafting] Missing materials:\n"
                        .. Text
                    )

                    QueueNotification(
                        "Missing Materials",
                        Text,
                        8
                    )

                    task.wait(0.20)
                    continue
                end
            end


            local Before =
                CraftSnapshot(
                    Recipe
                )

            local SelectedBefore =
                SelectedName

            local Fired,
                ErrorMessage =
                pcall(function()
                    ExtraPackets
                        .craftAccessory
                        :fire(
                            Recipe.CraftId
                        )
                end)

            if not Fired then
                warn(
                    "[Anime Zero][Crafting]",
                    ErrorMessage
                )

                if AutomationMode then
                    task.wait(0.75)
                else
                    ExtraSettings.AutoCraft = false
                    RequestToggle(
                        "Craft",
                        false
                    )
                    task.wait(0.20)
                end

                continue
            end


            local Deadline =
                os.clock() + 4

            local Changed =
                false

            repeat
                local CurrentAccessoryData =
                    GetAccessoryAutomationSettings()

                local StillEnabled =
                    AutomationMode
                    and CurrentAccessoryData
                    and CurrentAccessoryData.AutoCraftAccessories == true
                    or (
                        not AutomationMode
                        and ExtraSettings.AutoCraft == true
                    )

                if not ExtraAlive()
                    or not StillEnabled
                then
                    break
                end

                if not AutomationMode
                    and ExtraSettings.CraftItem
                        ~= SelectedBefore
                then
                    break
                end

                task.wait(0.10)

                local After =
                    CraftSnapshot(
                        Recipe
                    )

                if CraftChanged(
                    Before,
                    After
                )
                then
                    Changed = true
                    break
                end

            until os.clock() >= Deadline


            local CurrentAccessoryData =
                GetAccessoryAutomationSettings()

            local StillEnabled =
                AutomationMode
                and CurrentAccessoryData
                and CurrentAccessoryData.AutoCraftAccessories == true
                or (
                    not AutomationMode
                    and ExtraSettings.AutoCraft == true
                )

            if not StillEnabled then
                continue
            end

            if not AutomationMode
                and ExtraSettings.CraftItem
                    ~= SelectedBefore
            then
                task.wait(0.10)
                continue
            end

            if not Changed then
                if AutomationMode then
                    warn(
                        "[Anime Zero][Accessory Automation] Craft request timed out for",
                        SelectedBefore
                    )
                    task.wait(0.75)
                else
                    ExtraSettings.AutoCraft = false
                    RequestToggle(
                        "Craft",
                        false
                    )
                    QueueNotification(
                        "Crafting",
                        "Craft request timed out.",
                        5
                    )
                end

                continue
            end

            print(
                "[Anime Zero][Accessory Automation] Crafted:",
                SelectedBefore
            )

            task.wait(0.25)
        end
    end)


