            local function PostWebhook(Payload)

                local URL =
                    tostring(Settings.WebhookURL or "")


                if not IsDiscordWebhook(URL) then
                    return false,
                        "Enter a valid Discord webhook URL."
                end


                local Body =
                    HttpService:JSONEncode(Payload)

                local Request =
                    GetRequestFunction()


                if Request then

                    local Success,
                        Response =
                        pcall(
                            Request,
                            {
                                Url = URL,
                                Method = "POST",
                                Headers = {
                                    ["Content-Type"] = "application/json",
                                },
                                Body = Body,
                            }
                        )


                    if not Success then
                        return false,
                            "Executor HTTP request failed."
                    end


                    if type(Response) == "table" then

                        local Status =
                            tonumber(
                                Response.StatusCode
                                or Response.Status
                                or Response.status_code
                            )


                        if Status
                            and (
                                Status < 200
                                or Status >= 300
                            )
                        then
                            return false,
                                "Discord returned HTTP "
                                .. tostring(Status)
                        end
                    end


                    return true,
                        "Discord received the embed."
                end


                local Success =
                    pcall(function()
                        HttpService:PostAsync(
                            URL,
                            Body,
                            Enum.HttpContentType.ApplicationJson,
                            false
                        )
                    end)


                return Success,
