            )


        if not Id then

            SetState(
                "Accessory Loadout: no owned accessories"
            )

            return false
        end


        local Equipped =
            tostring(
                Data.equippedAccessory
                or ""
            )


        if Equipped == Id then

            return true,
                Id,
                Definition,
                Score
        end


        if not IsLobby()
            or not LobbyPackets
            or not LobbyPackets
                .setEquippedAccessory
        then

            SetState(
                "Accessory Loadout: waiting for lobby to equip "
                .. tostring(
                    Definition.Name
                    or Id
