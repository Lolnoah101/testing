local savedToggleKeys = {
    AS_KillAura = "KillAura", AS_AutoSummon = "AutoSummon",
    AS_AutoAbility = "AutoAbility", AS_AutoArise = "AutoArise",
    AS_BestCommanders = "BestCommanders", AS_BestArmy = "BestArmy",
    AS_ReleaseShadows = "ReleaseShadows", AS_AutoUpgrade = "AutoUpgrade",
    AS_CollectMoney = "CollectMoney", AS_BuyAura = "BuyAura",
    AS_EquipAura = "EquipAura", AS_BestSword = "BestSword",
    AS_DailyReward = "DailyReward", AS_PlaytimeRewards = "PlaytimeRewards",
    AS_IndexRewards = "IndexRewards", AS_SkipCutscenes = "SkipCutscenes",
    AS_JoinHalloween = "JoinHalloween", AS_FarmHalloween = "FarmHalloween",
    AS_LightLanterns = "LightLanterns", AS_ClaimHalloweenPass = "ClaimHalloweenPass",
    AS_AutoExchange = "AutoExchange", AS_JoinDungeon = "JoinDungeon",
    AS_FarmDungeon = "FarmDungeon", AS_CollectChest = "CollectChest",
    AS_LeaveDungeon = "LeaveDungeon", AS_AutoReconnect = "AutoReconnect",
    AS_AntiAFK = "AntiAFK",
}
Scheduler.add("SettingsSync", 0.8, function()
    if not Window then return end
    local changed = false
    for flag, field in pairs(savedToggleKeys) do
        local ok, actual = pcall(function() return Window:Get(flag) end)
        if ok and type(actual) == "boolean" and enabled[field] ~= actual then
            -- Prefer invoking Rayfield's callback; it can reset the relevant
            -- cooldowns and wake jobs. Fall back to state reconciliation.
            local applied, result = pcall(function() return Window:Set(flag, actual) end)
            if not applied or result == false or enabled[field] ~= actual then
                enabled[field] = actual
            end
            changed = true
        end
    end
    if changed then Scheduler.pokeAll() end
end)

local function stop()
    alive = false
    Scheduler.initialized = false
    if schedulerConnection then schedulerConnection:Disconnect() end
    for _, signal in ipairs(Scheduler.signals) do
        pcall(function() signal:Disconnect() end)
    end
    if Scheduler.healthSignal then Scheduler.healthSignal:Disconnect() end
    for _, signal in ipairs(raidSignals) do signal:Disconnect() end
    stopMovement()
    MovementNoclip.clear()
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    enabled.KillAura = false
    enabled.AutoSummon = false
    enabled.AutoAbility = false
    enabled.BestSword = false
    enabled._swordSwap.active = false
    enabled._swordSwap.target = nil
    if animatorConnection then
        animatorConnection:Disconnect()
        animatorConnection = nil
    end
    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end
    if weaponConnection then
        weaponConnection:Disconnect()
        weaponConnection = nil
    end
    pcall(function()
        Window:Unload()
    end)
end

