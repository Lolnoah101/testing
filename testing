local function modelDeadOrDespawning(model, hum)
    if not model or not hum or Hub.RetiredModels[model] then return true end
    if not model:IsDescendantOf(workspace) or not hum:IsDescendantOf(model) then return true end
    if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    for _, attr in ipairs({"Dead", "IsDead", "Dying", "DeathStarted", "Killed", "Despawning", "Despawned"}) do
        if model:GetAttribute(attr) == true or hum:GetAttribute(attr) == true then return true end
    end
    for _, tag in ipairs({"Dead", "Dying", "Corpse", "Killed", "Despawning"}) do
        if model:HasTag(tag) or hum:HasTag(tag) then return true end
    end
    local p = model.Parent
    while p and p ~= workspace do
        if p.Name == "DebrisFolder" or p.Name == "Corpses" or p.Name == "DeadNPCs" then
            return true
        end
        p = p.Parent
    end
    return false
end
local function modelTemporarilyUntargetable(model, hum)
    if modelDeadOrDespawning(model, hum) then return true end
    if model:HasTag("Knocked") or model:HasTag("KnockedOut")
        or model:GetAttribute("KnockedOut") == true then return true end
    return false
end

-- Only pursue NPC models that are currently spawned. The place capture also
-- contains placed/template humanoids under Workspace; an entry in Observed
-- alone does not mean a target is active in the live world.
local function spawnIsLive(record)
    if not record or not record.Root or not record.Model or not record.Hum then return false end
    local model, root, hum = record.Model, record.Root, record.Hum
    if not model:IsDescendantOf(workspace) or not root:IsDescendantOf(model)
        or not hum:IsDescendantOf(model) or hum.Health <= 0 or hum.MaxHealth <= 0
        or characterBelongsToPlayer(model) then return false end
    if model:GetAttribute("Spawned") == false
        or model:GetAttribute("IsActive") == false
        or model:GetAttribute("Alive") == false
        or model:HasTag("NotSpawned") then return false end
    -- Stationary template rigs may have full health before they spawn. Only
    -- treat an anchored root as live with affirmative active-combat evidence.
    local w = workspace:FindFirstChild("World")
    local live = w and w:FindFirstChild("Live")
    local insideLive = live and model:IsDescendantOf(live)
    -- Live combat NPCs can have an anchored HumanoidRootPart during spawn,
    -- stuns or a combat animation. Do not confuse them with template rigs.
    if root.Anchored and not insideLive and model:GetAttribute("Spawned") ~= true
        and model:GetAttribute("IsActive") ~= true
        and not model:HasTag("Enemy") and not model:HasTag("CombatNPC")
        and not model:HasTag("Boss") then
        -- Zombies can rise from the floor with an anchored root. An observed
        -- emergence animation is positive evidence of a LIVE NPC, unlike an
        -- inert anchored rig in saved template storage.
        local emerging=(record.NPCName=="Zombie" or record.NPCName=="Big Zombie")
            and (record.EmergingUntil or 0)>os.clock()
        if not emerging then return false end
        return true -- emergence is a known live animation, not a template rig
    end
    if insideLive then return true end
    for _, folderName in ipairs({"RoamingNpcs", "Humanoids", "NPCs", "Enemies", "Mobs", "LiveNPCs"}) do
        local folder = workspace:FindFirstChild(folderName)
        if folder and model:IsDescendantOf(folder) then return true end
    end
    if model:HasTag("Enemy") or model:HasTag("Hostile")
        or model:HasTag("CombatNPC") or model:HasTag("Boss")
        or model:GetAttribute("IsEnemy") == true
        or model:GetAttribute("IsBoss") == true then return true end
    -- Newer server builds can put spawned enemies directly under World or
    -- in named NPC subfolders. Reject known template/quest storage branches.
    local node = model.Parent
    while node and node ~= workspace do
        local n = node.Name:lower()
        if n:find("template",1,true) or n:find("storage",1,true)
            or n:find("cutscene",1,true) or n == "assets"
            or n == "replicatedstorage" or n == "serverstorage" then return false end
        if n == "npc" or n == "npcs" or n == "enemy" or n == "enemies"
            or n == "mobs" or n == "live" or n == "liveactors"
            or n == "characters" then return true end
        node = node.Parent
    end
    -- Important: a recognized Raider standing in the world is still valid
    -- even when it does not use World.Live.NPC. The old folder-only gate
    -- excluded such models. Anchored untagged templates remain excluded.
    if record.NPCName and not root.Anchored then
        local charRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        return charRoot ~= nil and (charRoot.Position-root.Position).Magnitude < 650
    end
    return false
end

local function activeNpcRecord(record)
    if record and record.Model then
        local untilAt = Hub.QuestCreditExclusions[record.Model]
        if untilAt and os.clock() < untilAt then return false end
        if untilAt then Hub.QuestCreditExclusions[record.Model] = nil end
    end
    if record and not record.NPCName and os.clock() >= (record.NextIdentityResolveAt or 0) then
        record.NextIdentityResolveAt = os.clock() + 2
        record.NPCName = canonicalNpcName(record.Model, record.Hum)
    end
    local live = record and record.Model and record.Model.Parent
        and record.Root and record.Root:IsDescendantOf(record.Model)
        and record.Hum and not modelTemporarilyUntargetable(record.Model, record.Hum)
        and spawnIsLive(record)
    if live then
        record.VerifiedLive = true
        if record.NPCName then
            local label=NpcPreferredVisible[record.NPCName] or record.NPCName
            local now=os.clock()
            if now-(record.LastKnownSpawnAt or 0)>9 then
                record.LastKnownSpawnAt=now
                local locations=Hub.LastKnownEnemyAreas[label]
                if not locations then
                    locations={}; Hub.LastKnownEnemyAreas[label]=locations
                end
                local point=record.Root.Position
                local found=false
                for _,known in ipairs(locations) do
                    if (known-point).Magnitude<35 then found=true;break end
                end
                if not found then
                    if #locations>=6 then table.remove(locations,1) end
                    table.insert(locations,point)
                end
            end
            queueLiveNpcLabel(record)
        end
    end
    return live == true
end
-- Use nearest visible body-part surface, not only NPC root-center. This makes
-- the fixed 10-stud M1 range meaningful when farming Above/Below tall NPCs.
local function targetBodyDistance(from, record)
    local shortest = math.huge
    for _, name in ipairs({"HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso",
        "LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
        local part = record.Model:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local localPoint = part.CFrame:PointToObjectSpace(from)
            local half = part.Size * 0.5
            local closest = Vector3.new(
                math.clamp(localPoint.X, -half.X, half.X),
                math.clamp(localPoint.Y, -half.Y, half.Y),
                math.clamp(localPoint.Z, -half.Z, half.Z))
            shortest = math.min(shortest, (localPoint - closest).Magnitude)
        end
    end
    if shortest == math.huge then return (from - record.Root.Position).Magnitude end
    return shortest
end
-- Combat targeting is separate from the Auto Farm selection. Favor hostile
-- NPCs already engaging the player, but never attack a player or send out-of-
-- range packets simply because the mob is aggroed from far away.
local function aggroedOnUs(record)
    if not record or not record.Model then return false end
    local model = record.Model
    for _, attr in ipairs({"AggroTarget", "AgroTarget", "Target", "TargetPlayer", "CurrentTarget"}) do
        local v = model:GetAttribute(attr)
        if v == LocalPlayer.UserId or v == LocalPlayer.Name
            or v == tostring(LocalPlayer.UserId) then return true end
    end
    for _, childName in ipairs({"Aggro", "Agro", "Target", "TargetPlayer"}) do
        local obj = model:FindFirstChild(childName)
        if obj and obj:IsA("ObjectValue") and (obj.Value == LocalPlayer
            or obj.Value == LocalPlayer.Character) then return true end
    end
    return type(record.LastAttacking) == "number"
        and os.clock() - record.LastAttacking <= 2.1
end
local function activeCombatRecord(record)
    if not record or not record.Model or not record.Model.Parent
        or record.Model == LocalPlayer.Character
        or Players:GetPlayerFromCharacter(record.Model) then return false end
    if not activeNpcRecord(record) then return false end
    -- Known combat NPCs, as well as newer hostile NPC variants with different
    -- names, are valid. Non-hostile service NPCs are deliberately ignored.
    if record.NPCName then return true end
    local model = record.Model
    return aggroedOnUs(record) or model:HasTag("Enemy")
        or model:HasTag("Hostile") or model:HasTag("CombatNPC")
        or model:GetAttribute("IsEnemy") == true
        or model:GetAttribute("Hostile") == true
end
-- Offense and navigation must agree on WHICH mob is being fought. The v37
-- scorer could choose a nearby unrelated NPC while Auto Farm was tracking a
-- selected boss; fighting and defensive facing then pulled in two directions.
local function npcCombatTarget(myRoot)
    local preferred = (Hub.AutoQuest and Hub.QuestCombatActive and Hub.QuestTarget)
        or (Hub.AutoFarm and Hub.FarmTarget)
    -- Preserve ownership while the selected NPC is knocked down or stunned:
    -- a temporary combat-unavailable state must NOT let M1 choose a third mob.
    local hardLock = preferred and preferred.Model and preferred.Hum
        and not modelDeadOrDespawning(preferred.Model, preferred.Hum)
    local locked = hardLock and activeCombatRecord(preferred)
    local nearest, bestScore, bestDistance = nil, math.huge, nil
    local nearestAggro, nearestAggroDistance = nil, math.huge
    for _, record in pairs(Hub.Observed) do
        if activeCombatRecord(record) then
            local rootDist = (record.Root.Position-myRoot.Position).Magnitude
            if rootDist <= 45 then
                if aggroedOnUs(record) and rootDist < nearestAggroDistance then
                    nearestAggro, nearestAggroDistance = record, rootDist
                end
                -- A valid farm/quest lock owns Auto Attack. Never switch to
                -- the nearest incidental mob just because it walked past.
                if not hardLock or record == preferred then
                    local dist = rootDist <= 24
                        and targetBodyDistance(myRoot.Position,record) or math.huge
                    if dist <= ATTACK_RANGE then
                        local score = locked and dist
                            or (dist - (aggroedOnUs(record) and 2 or 0))
                        if score < bestScore then
                            nearest, bestScore, bestDistance = record, score, dist
                        end
                    end
                end
            end
        end
    end
    Hub.CombatLock = hardLock and (preferred.NPCName or preferred.Model.Name)
        or (nearest and (nearest.NPCName or nearest.Model.Name)) or "None"
    Hub.CombatLockReason = hardLock and (locked and "Selected farm/quest enemy" or "Selected target temporarily unable to fight")
        or (nearest and "Nearest combat NPC" or "No target in melee range")
    Hub.CombatLockDistance = hardLock and preferred.Root and (preferred.Root.Position-myRoot.Position).Magnitude
        or bestDistance
    Hub.NearestAggro = nearestAggro and nearestAggro.Model.Name or "None"
    Hub.AttackTargetDistance = bestDistance
    Hub.AttackTargetName = nearest and nearest.Model.Name or "None"
    return nearest
end

local function allowedSelection(record)
    if not activeNpcRecord(record) then return false end
    if Hub.BossSelection ~= "None" then
        return selectionMatches(record, Hub.BossSelection)
    end
    for name, enabled in pairs(Hub.MobSelections) do
        if enabled and selectionMatches(record, name) then return true end
    end
    return false
end
-- Keep the exact living NPC instance until its death/despawn is confirmed.
-- Knockdown, stagger, combat-recovery tags and another nearby enemy are NOT
-- reasons to switch targets. Selection changes from the UI still take effect.
function Hub:FarmLockPersistent(record)
    if not record or not record.Model or not record.Hum or not record.Root then return false end
    if modelDeadOrDespawning(record.Model,record.Hum) then return false end
    if self.BossSelection ~= "None" then
        return selectionMatches(record,self.BossSelection)
    end
    for name,enabled in pairs(self.MobSelections) do
        if enabled and selectionMatches(record,name) then return true end
    end
    return false
end
local function selectFarmTarget(root)
    local existing = Hub.FarmTarget
    if existing and (modelDeadOrDespawning(existing.Model, existing.Hum)
        or not spawnIsLive(existing)) then
        if modelDeadOrDespawning(existing.Model, existing.Hum) then
            Hub.RetiredModels[existing.Model] = true
        end
        Hub.RetargetsAfterDeath += 1
        Hub.FarmTarget = nil
        Hub.FarmNavToken += 1
        Hub.FarmSmoothVelocity = Vector3.zero
        Hub.FarmFocus, Hub.FarmNav = nil, nil
        existing = nil
    end
    if allowedSelection(existing) then
        Hub.FarmMatchCount = math.max(1, Hub.FarmMatchCount)
        Hub.TargetState = "Following living " .. tostring(existing.Hum.DisplayName)
        return existing
    end
    Hub.FarmTarget = nil
    local best, bestDist, matches = nil, math.huge, 0
    for _, record in pairs(Hub.Observed) do
        if allowedSelection(record) then
            matches += 1
            local dist = (record.Root.Position - root.Position).Magnitude
            if dist < bestDist then
                best, bestDist = record, dist
            end
        end
    end
    Hub.FarmMatchCount = matches
    if best then
        Hub.FarmTarget = best
        Hub.FarmLastTarget = best.Model.Name
        Hub.TargetState = "Acquired " .. tostring(best.Hum.DisplayName)
        Hub.Stats.TargetAcquisitions += 1
    else
        Hub.TargetState = "No living selected NPC spawned"
    end
    return best
end
