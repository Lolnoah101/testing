local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local env = (type(getgenv) == "function" and getgenv()) or _G
local priorBoot = env.HollowMoonADStartupV47
if type(priorBoot) == "table" and priorBoot.placeId == game.PlaceId and priorBoot.jobId == game.JobId then
    if priorBoot.status == "waiting" or priorBoot.status == "starting" then
        return -- duplicate Auto Execute invocation for the same destination
    end
    local running = env.HollowMoonAnimeDimensions
    if priorBoot.status == "running" and type(running) == "table" and running.alive then
        return -- avoid running two copies from queued + executor Auto Execute
    end
end
local boot = { status = "waiting", placeId = game.PlaceId, jobId = game.JobId }
env.HollowMoonADStartupV47 = boot

local lobbyPlaces = {
    [6938803436] = true,
    [6616269295] = true,
    [7274690025] = true,
    [7338881230] = true,
}
local function isReady()
    if not game:IsLoaded() then return false, "Roblox place", nil, nil end
    local player = Players.LocalPlayer
    if not player then return false, "LocalPlayer", nil, nil end
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if not gui then return false, "PlayerGui", nil, nil end
    local values = gui:FindFirstChild("LocalValues")
    local flag = values and values:FindFirstChild("StatsLoaded")
    if not flag or not flag:IsA("BoolValue") or not flag.Value then
        return false, "StatsLoaded", nil, nil
    end
    -- ClientLibrary and skill module must be present before our game-specific
    -- initializers are allowed to run. StatsLoaded alone is not enough.
    if not gui:FindFirstChild("ClientLibrary") then
        return false, "ClientLibrary", nil, nil
    end
    local modules = gui:FindFirstChild("Modules")
    if not (modules and modules:FindFirstChild("ClientSkillModule")) then
        return false, "ClientSkillModule", nil, nil
    end
    -- When the game presents its own data-loading overlay, do not race it.
    local universalGui = gui:FindFirstChild("UniversalGui")
    if not universalGui then return false, "game UI", nil, nil end
    local centerGui = universalGui:FindFirstChild("UniversalCenterUIFrame")
    local loadingNotice = centerGui and centerGui:FindFirstChild("DataLoadingNotice")
    if loadingNotice and loadingNotice:IsA("GuiObject") and loadingNotice.Visible then
        return false, "loading overlay", nil, nil
    end
    local remoteFolder = RS:FindFirstChild("RemoteEvents")
    if not (remoteFolder and remoteFolder:FindFirstChild("MainRemoteEvent")) then
        return false, "combat remote", nil, nil
    end
    if lobbyPlaces[game.PlaceId] then
        local functionFolder = RS:FindFirstChild("RemoteFunctions")
        if not (functionFolder and functionFolder:FindFirstChild("MainRemoteFunction")) then
            return false, "lobby remote", nil, nil
        end
        local display = RS:FindFirstChild(player.Name .. "StatDisplay")
        if not (display and display:FindFirstChild("Level")) then
            return false, "player level", nil, nil
        end
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and root and hum.Health > 0) then
        return false, "character spawn", nil, nil
    end
    return true, "ready", char, flag
end

local untilTime = os.clock() + 180
local stableSince, lastChar, lastFlag = nil, nil, nil
local lastReason = "game loading"
local cleared = false
local noticeShown = false
local bootStartedAt = os.clock()
while os.clock() < untilTime do
    if env.HollowMoonADStartupV47 ~= boot then return end
    local ok, reason, char, flag = isReady()
    lastReason = reason
    if ok then
        if char ~= lastChar or flag ~= lastFlag then
            lastChar, lastFlag = char, flag
            stableSince = os.clock()
        end
        if stableSince and os.clock() - stableSince >= 3 then
            cleared = true
            break
        end
    else
        stableSince, lastChar, lastFlag = nil, nil, nil
    end
    if not noticeShown and os.clock() - bootStartedAt > 10 then
        noticeShown = true
        warn("[HollowMoonHub AD v47] Waiting for Anime Dimensions data: " .. tostring(lastReason))
    end
    task.wait(0.2)
end
if not cleared then
    boot.status = "failed"
    warn("[HollowMoonHub AD v47] Startup cancelled: " .. tostring(lastReason)
        .. " never became ready. No UI, combat, auto start or reconnect was started.")
    return
end

boot.status = "starting"
-- Only AFTER the entire readiness gate succeeds do we touch the game.
local fn, err = loadstring(CORE)
if not fn then
    boot.status = "failed"
    error("[HollowMoonHub AD v47] Compile failure: " .. tostring(err))
end
local ok, runErr = pcall(fn)
if not ok then
    boot.status = "failed"
    error("[HollowMoonHub AD v47] Initialization failure: " .. tostring(runErr))
end
boot.status = "running"
-- One stable core cache per game. Create the game folder only if the
-- executor supports it, and NEVER create versioned vXX_core.lua files.
-- Existing settings JSONs and older backups are intentionally untouched.
if type(writefile) == "function" then
    local cachePath = "HollowMoonHub/AnimeDimensions/HollowMoonHub_Core.lua"
    local function ensureFolder(folder)
        if type(isfolder) == "function" then
            local ok, present = pcall(isfolder, folder)
            if ok and present then return true end
        end
        if type(makefolder) == "function" then
            pcall(makefolder, folder)
        end
        if type(isfolder) == "function" then
            local ok, present = pcall(isfolder, folder)
            if ok and present then return true end
        end
        return false
    end
    ensureFolder("HollowMoonHub")
    ensureFolder("HollowMoonHub/AnimeDimensions")
    -- Never overwrite a genuinely newer backup, but ALWAYS replace an older
    -- core when this source is updated. Derive the version from the embedded
    -- marker, so subsequent updates don't require a hardcoded threshold.
    local currentVersion = tonumber(CORE:match(
        "^%s*%-%- HMH_ANIME_DIMENSIONS_V(%d+)")) or 0
    local overwrite = true
    if type(readfile) == "function" then
        local okRead, existing = pcall(readfile, cachePath)
        if okRead and type(existing) == "string" then
            local savedVersion = tonumber(existing:match(
                "^%s*%-%- HMH_ANIME_DIMENSIONS_V(%d+)"))
            if savedVersion and savedVersion > currentVersion then overwrite = false end
        end
    end
    if overwrite then
        local okWrite = pcall(writefile, cachePath, CORE)
        if not okWrite then
            warn("[HollowMoonHub AD v47] Local core backup unavailable; GitHub Auto Execute remains available. Check executor folder/file support.")
        end
    end
end
