-- Native RoomModule.leaveParty fires RemovePlayerFromParty and closes the
-- party UI. "Already in a party" is a SERVER state, not a local room flag:
-- clearing createdOwnRoom alone cannot resolve it.
S.recoverStaleDimensionParty = function()
    if not S.alive or not S.autoStart or not inLobby()
        or game.PlaceId == 7338881230 then return false end
    -- Do not dismiss public/multiplayer raid queues or a live special request.
    if S.modeIntent == "RaidQueue" or S.modeIntent == "Raid" or S.specialBusy then
        return false
    end
    local now = os.clock()
    if now - (S.partyRecoveryWindowAt or 0) > 90 then
        S.partyRecoveryAttempts = 0
        S.partyRecoveryWindowAt = now
    end
    S.partyRecoveryAttempts = (S.partyRecoveryAttempts or 0) + 1
    local count = S.partyRecoveryAttempts
    -- Up to three leaves in a 90-second window, then cool down rather than
    -- repeatedly firing a remote into a server that refuses to release a party.
    if count > 3 then
        S.roomUnavailableUntil = now + 30
        warnOnce("Auto Start: server still reports an active party; pausing new room attempts for 30 seconds")
        return false
    end
    if now - (S.partyRecoveryLastTryAt or 0) < 3 then
        S.roomUnavailableUntil = now + 6
        return false
    end
    S.partyRecoveryLastTryAt = now
    S.roomUnavailableUntil = now + (count == 1 and 6 or count == 2 and 9 or 12)
    -- Prefer the native game procedure to keep the party UI in sync.
    local released = false
    local ok = pcall(function()
        local gui = player:FindFirstChildOfClass("PlayerGui")
        local module = gui and gui:FindFirstChild("ClientLibrary")
        if module and module:IsA("ModuleScript") then
            local library = require(module)
            local room = library and library.RoomModule
            if room and type(room.leaveParty) == "function" then
                room.leaveParty()
                released = true
            end
        end
    end)
    if (not ok or not released) and remote then
        released = pcall(function()
            remote:FireServer("RemovePlayerFromParty")
        end)
    end
    if released then
        warnOnce("Auto Start found an old party; leaving it before creating the next Dimension room")
    else
        warnOnce("Auto Start: could not leave the old party; will retry safely")
    end
    -- The server must be given time to remove us. No CreateRoom command is
    -- issued until the cooldown has passed. Leave user toggle ON throughout.
    S.createdOwnRoom = false
    S.createdOwnRoomAt = 0
    S.roomStartRequested = false
    S.roomStartRequestedAt = 0
    S.roomStartFailedAt = 0
    S.roomStartFailureReason = ""
    return released
end

local function autoStartWorker()
    if game.PlaceId == 7338881230 then return end -- raid lobby is raid-only
    if os.time() < (S.reconnectResumeEpoch or 0) then return end
    -- The priority scheduler is the ONLY caller of this worker. Its
    -- specialSelected flag is informational and can be reasserted by a
    -- still-enabled (but unavailable) Boss Rush toggle between scheduling
    -- and the hand-off. Only an actual special request/worker blocks entry.
    if S.specialBusy or S.modeIntent~="" then return end
    if S.lobbyBusy or not S.alive or not inLobby() or not S.autoStart or S.sessionStopped then return end
    if os.clock() < (S.roomUnavailableUntil or 0) then return end
    S.lobbyBusy = true
    S.lastLobbyWorkerKickAt=os.clock()
    S.lobbyGeneration = S.lobbyGeneration + 1
    local token = S.lobbyGeneration
    task.spawn(function()
        -- A runtime exception in the room worker must not leave lobbyBusy
        -- permanently set. Network teleport success deliberately keeps it set
        -- until the destination place loads (or watchdog expiry).
        local workerOK,workerErr=pcall(function()
        -- Wait for replicated stats without blocking the interface.
        local started = os.clock()
        while S.alive and S.autoStart and token == S.lobbyGeneration
            and (not statsReady() or not playerLevel())
            and os.clock() - started < 35 do task.wait(0.25) end
        if not (S.alive and S.autoStart and token == S.lobbyGeneration and inLobby()) then
            S.lobbyBusy = false; return
        end
        if not statsReady() then
            -- Stay armed for a future run, but do not create a lobby room
            -- before Roblox finishes loading all stats.
            S.lobbyBusy = false
            warnOnce("Auto Start waiting for loaded player stats")
            return
        end
        local request, why = buildRoomData()
        if not request then
            -- A locked map, missing level, or invalid difficulty is a temporary
            -- eligibility state. NEVER overwrite what the user toggled ON.
            warnOnce("Auto Start waiting (still enabled): " .. tostring(why))
            S.roomUnavailableUntil = os.clock() + 12
            S.lobbyBusy = false
            return
        end
        S.roomUnavailableUntil = 0
        local response, err = invokeRoom("CreateRoom", request)
        if not response or response.status ~= "Success" then
            local failure = tostring(err or (response and response.message) or "Unknown server response")
            if failure:lower():find("already in a party", 1, true) then
                -- Returning from a mode can leave an old server-side party,
                -- even though the local room state was cleared by the watchdog.
                -- Native party exit, cooldown, and normal scheduler retry.
                S.recoverStaleDimensionParty()
                S.lobbyBusy = false
                return
            end
            warnOnce("CreateRoom failed: " .. failure)
            S.lobbyBusy = false
            S.roomUnavailableUntil = os.clock() + 8
            return
        end
        -- The previous stale-party situation is resolved if CreateRoom is
        -- accepted. Resume normal room creation without altering preferences.
        S.partyRecoveryAttempts = 0
        S.partyRecoveryWindowAt = 0
        S.createdOwnRoom = true
        S.createdOwnRoomAt = os.clock()
        S.roomStartFailedAt = 0
        S.roomStartFailureReason = ""
        task.wait(S.startDelay)
        if not (S.alive and S.autoStart and token == S.lobbyGeneration and inLobby()) then
            S.lobbyBusy = false; return
        end
        -- Mark the request BEFORE invoking the server, so an absent response
        -- cannot make the room appear idle while the server still teleports.
        S.roomStartRequested=true
        S.roomStartRequestedAt=os.clock()
        local startedResult, errorText = invokeRoom("TeleportPlayers")
        if startedResult and startedResult.status == "Fail" then
            -- A confirmed rejection should not lock Auto Start until the old
            -- 90-second watchdog, nor create a competing second room.
            S.roomStartFailedAt=os.clock()
            S.roomStartFailureReason=tostring(startedResult.message or "Server rejected start")
            warnOnce("TeleportPlayers rejected: "..S.roomStartFailureReason)
            return
        end
        if not startedResult then
            -- Nil / missing reply can still represent a queued teleport.
            -- Let the watchdog clean it up only if we're STILL in this lobby.
            S.roomStartFailureReason=tostring(errorText or "No start confirmation")
            warnOnce("TeleportPlayers unconfirmed: checking transfer before retry")
        end
        savePreferences()
        -- Keep the lock while a teleport might be in progress; the watchdog
        -- safely releases it if no place transition actually occurs.
        S.lobbyBusy = true
        end)
        if not workerOK then
            -- If a room already exists, do not clear its busy flag and
            -- immediately create another party. The watchdog releases it.
            if not S.createdOwnRoom then S.lobbyBusy=false end
            warnOnce("Room automation error: " .. tostring(workerErr))
        end
    end)
end

-- Each completed results screen is one match, not every Heartbeat it stays open.
local function resultsWorkflowTick(now, visible)
    if not visible then
        if not S.resultsHiddenSince then S.resultsHiddenSince = now end
        if now - S.resultsHiddenSince >= 1.5 then S.resultsHandled = false end
        return
    end
    S.resultsHiddenSince = nil
    if S.resultsHandled then return end
    S.resultsHandled = true
    local gameMode = tostring(Workspace:GetAttribute("GameMode") or "")
    if gameMode == "ShadowRaid" or S.modeIntent == "SpeedRaid" then
        if S.speedAutoLeave and remote then
            task.delay(0.35, function()
                if S.alive and game.PlaceId == 6990129309 then
                    remote:FireServer("LeaveDungeon")
                end
            end)
        end
        return -- Never retry a weekly-used Speed Raid character.
    end
    if S.modeIntent == "DailyRaid" then
        if remote then task.delay(0.35, function()
            if S.alive and game.PlaceId == 6990129309 then remote:FireServer("LeaveDungeon") end
        end) end
        return -- Rewards can only be earned once daily; no automatic retry.
    end
    if S.modeIntent == "BossRush" then
        if remote then
            local action = S.bossAutoLeave and "LeaveDungeon"
                or S.bossAutoRetry and "RetryDungeon" or nil
            if action then task.delay(0.35,function()
                if S.alive and game.PlaceId == 6990129309 then remote:FireServer(action) end
            end) end
        end
        return -- Do not apply general match counter to Boss Rush.
    end
    if S.modeIntent=="Raid" or S.modeIntent=="RaidQueue" then
        -- Raids have their own result handler and should never also fire the
        -- normal Dimensions retry/leave action.
        return
    end
    -- Match limits are per run cycle, not a global stop condition.
    if not (S.autoRetry or S.autoLeaveMatches) then return end
    S.matchesCompleted = S.matchesCompleted + 1
    savePreferences()
    local shouldLeave = S.autoLeaveMatches and S.matchesCompleted >= S.matchesToLeave
    if shouldLeave then
        -- Reach the configured number of regular Dimension results, return to
        -- lobby and begin the NEXT match cycle with Auto Start still enabled.
        -- Do not set sessionStopped or change either toggle preference.
        S.matchesCompleted = 0
        S.sessionStopped = false
        savePreferences()
    elseif not S.autoRetry then
        -- Count the completed match but don't take an action until limit.
        return
    end
    task.delay(0.4, function()
        if not S.alive or game.PlaceId ~= 6990129309 then return end
        if shouldLeave then
            -- We already confirmed the match result. A UI transition should
            -- not cancel the return to lobby just because the panel hid.
            if remote then remote:FireServer("LeaveDungeon") end
            return
        end
        local gui = player:FindFirstChildOfClass("PlayerGui")
        local result = gui and gui:FindFirstChild("ResultUI", true)
        if not (result and result:IsA("GuiObject") and result.Visible) then return end
        if remote then remote:FireServer("RetryDungeon") end
    end)
end


