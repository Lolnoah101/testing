    end
    Farm.utilityAutoReload = Farm.fastResumeFlags.AutoReloadBlades
    Farm.utilityAutoRefill = Farm.fastResumeFlags.AutoRefillBlades
    if Farm.utilityAutoReload or Farm.utilityAutoRefill then
