        if candidate and current ~= candidate.Id then
            attempt("EquipAura", 3, function()
                AuraRequest:FireServer("Equip", candidate.Id)
            end)
        end
    end
end

-- V23: Auto Equip Best Sword pauses combat temporarily instead of
-- requiring a manual Kill Aura toggle. Retain all owned-sword comparisons
-- from v17 and the exact game Weapons.Equip remote.
do
    local weaponEquip = Remotes.Weapons.Equip
    local swordStatus = PlayerTab:CreateText({
        name = "Best Sword Status",
        text = "Disabled. Waiting for Auto Equip Best Sword...",
    })
    local lastStatus = nil
    local function reportSword(message)
        if lastStatus ~= message then
            lastStatus = message
            pcall(function() swordStatus:Set(message) end)
        end
    end
    local function releaseSwordSwap()
        local wasActive = enabled._swordSwap.active
        enabled._swordSwap.active = false
        enabled._swordSwap.target = nil
        enabled._swordSwap.releaseAt = nil
        if wasActive then
            Scheduler.pokeMany({"KillAura", "Ability", "Summon", "DungeonFarm"})
        end
    end

    Scheduler.add("BestSword", 0.20, function()
        if not enabled.BestSword then
            releaseSwordSwap()
            enabled._swordSwap.retryAfter = 0
            reportSword("Disabled. Waiting for Auto Equip Best Sword...")
            return
        end
        local ok, err = pcall(function()
            local data = dataNow()
            if not data then
                reportSword("Waiting for player weapon data...")
                return
            end
            local inventory = data.weapons or {}
            local owned = inventory.owned or {}
            local bestId = WeaponConfig.Default
            local bestDamage, bestSpeed = -math.huge, -math.huge
            for id, config in pairs(WeaponConfig.ById) do
                if id == WeaponConfig.Default or owned[id] == true then
                    local damage = tonumber(config.Damage) or 0
                    local speed = tonumber(config.Speed) or 0
                    if damage > bestDamage or (damage == bestDamage and speed > bestSpeed)
                        or (damage == bestDamage and speed == bestSpeed and id < bestId) then
                        bestId, bestDamage, bestSpeed = id, damage, speed
                    end
                end
            end
            local currentId = inventory.equipped or WeaponConfig.Default
            local now = os.clock()
            local name = (WeaponConfig.ById[bestId] or {}).Name or bestId

            -- Only stop combat when the actual owned best sword is different.
            if currentId == bestId then
                if enabled._swordSwap.active then
                    if not enabled._swordSwap.releaseAt then
                        enabled._swordSwap.releaseAt = now + 0.45
                    end
                    if now < enabled._swordSwap.releaseAt then
                        reportSword(string.format("Equipped %s (%.2fx); resuming combat...", name, bestDamage))
                        return
                    end
                end
                releaseSwordSwap()
                enabled._swordSwap.retryAfter = 0
                reportSword(string.format("Equipped best: %s (%.2fx damage)", name, bestDamage))
                return
            end

            -- If the server does not confirm a switch within 18 seconds,
            -- never hold Kill Aura paused forever: resume and retry later.
            if now < enabled._swordSwap.retryAfter then
                reportSword(string.format("Switch not confirmed; combat running. Retrying %s shortly.", name))
                return
            end
            if not enabled._swordSwap.active or enabled._swordSwap.target ~= bestId then
                enabled._swordSwap.active = true
                enabled._swordSwap.target = bestId
                enabled._swordSwap.since = now
                enabled._swordSwap.lastRequest = -math.huge
                enabled._swordSwap.releaseAt = nil
                reportSword(string.format("Pausing combat to equip %s (%.2fx)...", name, bestDamage))
                return
            end
            if now - enabled._swordSwap.since >= 18 then
                enabled._swordSwap.retryAfter = now + 6
                releaseSwordSwap()
                reportSword("Sword switch not confirmed; combat resumed. Will retry automatically.")
                return
            end
            -- Let any ongoing attack/ability finish before sending the
            -- equip request. All our attack paths check enabled._swordSwap.active.
            local elapsed = now - enabled._swordSwap.since
            if elapsed < 3.5 then
                reportSword(string.format("Waiting for combat to stop (%.1fs)...", 3.5 - elapsed))
                return
            end
            if now - enabled._swordSwap.lastRequest >= 4 then
                if not getCharacter() then
                    reportSword("Waiting for active character before equipping " .. name)
                    return
                end
                enabled._swordSwap.lastRequest = now
                weaponEquip:FireServer(bestId)
                reportSword(string.format("Requested %s (%.2fx); waiting for equip confirmation...", name, bestDamage))
            end
        end)
        if not ok then
            -- Avoid leaving combat locked if local equipment logic fails.
            releaseSwordSwap()
            enabled._swordSwap.retryAfter = os.clock() + 6
            warn("[Arise V23] Best Sword:", err)
            reportSword("Best sword worker error; combat resumed: " .. tostring(err))
        end
    end)
end

