-- Current raid is rebound on raid changes. This catches boss phases, exit
-- portal/chest spawning and lantern state changes in the same frame.
local raidSignals = {}
local boundRaid = nil
local function bindActiveRaid()
    local raid = currentRaid()
    if raid == boundRaid then return end
    for _, signal in ipairs(raidSignals) do signal:Disconnect() end
    table.clear(raidSignals)
    boundRaid = raid
    if not raid then return end
    table.insert(raidSignals, raid.AttributeChanged:Connect(function(attribute)
        if attribute == "State" or attribute == "PhaseId"
            or attribute == "BossHealth" or attribute == "BossPosition"
            or attribute == "BossIntroUntil" or attribute:find("^Lantern")
            or attribute:find("^EnemyGoal_") or attribute:find("^EnemiesLeft_") then
            Scheduler.pokeMany({"DungeonFarm", "Halloween", "DungeonWatcher", "Arise"})
        end
    end))
    table.insert(raidSignals, raid.DescendantAdded:Connect(function(instance)
        if instance:IsA("ProximityPrompt") or instance.Name == "Monsters"
            or (instance:IsA("Model") and instance.Parent
                and instance.Parent.Name == "Monsters")
            or instance.Name == "RewardChest" or instance.Name == "ExitPortal" then
            Scheduler.pokeMany({"DungeonFarm", "Halloween"})
        end
    end))
    Scheduler.pokeMany({"DungeonFarm", "Halloween", "DungeonWatcher"})
end
