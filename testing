    if not GENV.__AZ_FARM_EXT.LocalClientStore
        or not GENV.__AZ_FARM_EXT.LocalClientStore.state
    then
        return false
    end


    local Success,
        Busy =
        pcall(function()

            if GENV.__AZ_FARM_EXT.LocalClientStore.state.dashing
                and GENV.__AZ_FARM_EXT.LocalClientStore.state.dashing:get()
            then
                return true
            end


            local SkillState =
                GENV.__AZ_FARM_EXT.LocalClientStore.state.skill


            if SkillState then

                if SkillState.pending
                    and SkillState.pending:get()
                then
                    return true
                end


                if SkillState.till
                    and workspace:GetServerTimeNow()
                        < (SkillState.till:get() or 0)
                then
                    return true
                end
            end


            return false
        end)


    return Success
        and Busy == true
end

