local function mapLevel(info)
    if not (type(info) == "table" and type(info.difficulties) == "table") then return math.huge end
    local lowest = math.huge
    for _, v in pairs(info.difficulties) do
        if type(v) == "table" then lowest = math.min(lowest, tonumber(v.levelReq) or math.huge) end
    end
    return lowest
end
local function isActiveMap(info)
    if type(info) ~= "table" or info.excludeFromList == true then return false end
    if info.endTime and (tonumber(info.endTime) or 0) < Workspace:GetServerTimeNow() then return false end
    local raidLobby = game.PlaceId == 7338881230
    if raidLobby then return info.isRaid == true and info.isShadowRaid ~= true end
    return info.isRaid ~= true
end
local mapLabels, sortedMaps = {}, {}
local function mapOptions()
    mapLabels, sortedMaps = {}, {}
    local settings = getSettings()
    local maps = settings and settings.MapInfo
    if type(maps) == "table" then
        for key, info in pairs(maps) do
            if isActiveMap(info) then
                sortedMaps[#sortedMaps+1] = { id = key, info = info, lvl = mapLevel(info) }
            end
        end
    end
    table.sort(sortedMaps, function(a,b)
        local oa, ob = tonumber(a.info.order) or 10000, tonumber(b.info.order) or 10000
        if oa == ob then return a.id < b.id end
        return oa < ob
    end)
    local options = { "Hardest" }
    for _, row in ipairs(sortedMaps) do
        local name = tostring(row.info.displayName or row.id)
        local label = string.format("%s (Lv %s)", name, row.lvl == math.huge and "?" or tostring(row.lvl))
        if mapLabels[label] then label = label .. " - " .. row.id end
        mapLabels[label] = row.id
        options[#options+1] = label
    end
    return options
end
local function hardestMap(level)
    local settings = getSettings()
    local maps = settings and settings.MapInfo
    if type(maps) ~= "table" then return nil end
    local choice, bestOrder, bestLevel = nil, -math.huge, -math.huge
    for key, info in pairs(maps) do
        -- Hardest deliberately means regular, unlocked progression Dimension;
        -- not an event, raid, challenge or an Infinite/Boss Rush mode.
        local order = tonumber(info.order)
        if isActiveMap(info) and info.isEvent ~= true and info.isRaid ~= true
            and info.isInfinite ~= true and info.keyRequired ~= true
            and type(key) == "string" and string.find(key, "Dimension", 1, true)
            and order and order > 0 and mapLevel(info) <= level then
            if order > bestOrder or (order == bestOrder and mapLevel(info) > bestLevel) then
                choice, bestOrder, bestLevel = key, order, mapLevel(info)
            end
        end
    end
    return choice
end
local function chooseMap(level)
    if S.mapChoice == "Hardest" then return hardestMap(level) end
    local settings = getSettings()
    local info = settings and settings.MapInfo and settings.MapInfo[S.mapChoice]
    if info and isActiveMap(info) then return S.mapChoice end
end
local function listDifficulties(mapId)
    local out = { "Hardest" }
    local settings = getSettings()
    local info = settings and settings.MapInfo and settings.MapInfo[mapId]
    if info and type(info.difficulties) == "table" then
        local sorted = {}
        for name, v in pairs(info.difficulties) do
            sorted[#sorted+1] = { name = name, order = tonumber(v.order) or 1000 }
        end
        table.sort(sorted, function(a,b) return a.order < b.order end)
        for _, row in ipairs(sorted) do out[#out+1] = row.name end
    end
    return out
end
local function chooseDifficulty(mapId, level)
    local settings = getSettings()
    local info = settings and settings.MapInfo and settings.MapInfo[mapId]
    if not (info and type(info.difficulties) == "table") then return nil end
    if S.difficultyChoice ~= "Hardest" then
        local candidate = info.difficulties[S.difficultyChoice]
        if candidate and (tonumber(candidate.levelReq) or math.huge) <= level then
            return S.difficultyChoice
        end
        return nil
    end
    local choice, reqBest, rankBest = nil, -math.huge, -math.huge
    for name, v in pairs(info.difficulties) do
        local required = tonumber(v.levelReq) or math.huge
        local rank = tonumber(v.order) or 0
        if required <= level and (required > reqBest or (required == reqBest and rank > rankBest)) then
            choice, reqBest, rankBest = name, required, rank
        end
    end
    return choice
end
local function buildRoomData()
    local level = playerLevel()
    if not level then return nil, "Player level not loaded" end
    local mapId = chooseMap(level)
    if not mapId then return nil, "No eligible map for this lobby and selection" end
    local settings = getSettings()
    local info = settings and settings.MapInfo and settings.MapInfo[mapId]
    local difficulty = chooseDifficulty(mapId, level)
    if not difficulty then return nil, "Difficulty is locked or unavailable" end
    if S.hardcore and (level < 5 or info.isRaid or info.isInfinite or info.noHardcore) then
        return nil, "Hardcore unavailable for this map or level"
    end
    return {
        MapName = mapId,
        Difficulty = difficulty,
        FriendsOnly = (info.keyRequired == true) or (S.friendsOnly == true),
        Hardcore = S.hardcore == true,
    }
end
