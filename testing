                    and Purchase.tokens >= Purchase.cost
                then
                    local Id = NextRequestId(RequestIds, "Skill")

                    PendingSkillTree = {
                        requestId = Id,
                        character = Purchase.character,
                        branch = Purchase.branch,
                        tier = Purchase.tier,
                        sentAt = os.clock(),
