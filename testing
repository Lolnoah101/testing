--========================================================
-- CLEANING JOB
--========================================================

local CleaningThread = nil
local CleaningFailures = {}

local function GetCleaningFolder()
    local Map =
        Workspace:FindFirstChild("Map")

    local Jobs =
        Map
        and Map:FindFirstChild("Jobs")

    local CleanNPC =
        Jobs
        and Jobs:FindFirstChild("CleanNPC")

    return CleanNPC
        and CleanNPC:FindFirstChild("Clean")
end

local function GetCleanPrompt(
    Spot
)
    if not Spot
        or not Spot.Parent
    then
        return nil
    end

    for _, Object in ipairs(
        Spot:GetChildren()
    ) do
        if Object:IsA("ProximityPrompt")
            and Object.ObjectText
                == "Clean"
        then
            return Object
        end
    end

    return nil
end

local function IsSpotDirty(
    Spot
)
    return
        Spot
        and Spot.Parent
        and Spot.Transparency
            <= 0.3
end

local function IsSpotFinished(
    Spot
)
    if not Spot
        or not Spot.Parent
    then
        return true
    end

    if Spot.Transparency > 0.3 then
        return true
    end

    local Prompt =
        GetCleanPrompt(
            Spot
        )

    return
        not Prompt
        or not Prompt.Parent
        or not Prompt.Enabled
end

local function GetSpotFailureKey(
    Spot
)
    if not Spot then
        return nil
    end

    return Spot
end

local function IsSpotOnCooldown(
    Spot
)
    local Key =
        GetSpotFailureKey(
            Spot
        )

    if not Key then
        return false
    end

    local UntilTime =
        CleaningFailures[
            Key
        ]

    if not UntilTime then
        return false
    end

    if os.clock() >= UntilTime then
        CleaningFailures[Key] = nil
        return false
    end

    return true
end

local function MarkSpotFailed(
    Spot
)
    local Key =
        GetSpotFailureKey(
            Spot
        )

    if not Key then
        return
    end

    CleaningFailures[Key] =
        os.clock()
        + Settings.CleaningFailureCooldown
end

local function ClearSpotFailure(
    Spot
)
    local Key =
        GetSpotFailureKey(
            Spot
        )

    if Key then
        CleaningFailures[Key] = nil
    end
end

--========================================================
-- GET CURRENT DIRTY SPOTS
--========================================================

local function GetDirtySpots()
    local Folder =
        GetCleaningFolder()

    if not Folder then
        return {}
    end

    local Spots = {}

    for _, Spot in ipairs(
        Folder:GetChildren()
    ) do
        if Spot:IsA("BasePart") then
            local Prompt =
                GetCleanPrompt(
                    Spot
                )

            if Prompt
                and Prompt.Enabled
                and IsSpotDirty(Spot)
            then
                table.insert(
                    Spots,
                    Spot
                )
            end
        end
    end

    -- Nearest-first is more reliable than holding a long
    -- numeric snapshot while spots are changing underneath us.
    local RootPart =
        Player.Character
        and Player.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    table.sort(
        Spots,

        function(A, B)
            if RootPart then
                local ADistance =
                    (
                        RootPart.Position
                        - A.Position
                    ).Magnitude

                local BDistance =
                    (
                        RootPart.Position
                        - B.Position
                    ).Magnitude

                if math.abs(
                    ADistance - BDistance
                ) > 0.05 then
                    return ADistance < BDistance
                end
            end

            local ANumber =
                tonumber(A.Name)

            local BNumber =
                tonumber(B.Name)

            if ANumber
                and BNumber
            then
                return ANumber < BNumber
            end

            return A.Name < B.Name
        end
    )

    return Spots
end

--========================================================
-- PICK ONE FRESH TARGET
--
-- Re-scan after every cleaning instead of keeping a stale
-- 8-spot list for the whole pass.
--========================================================

local function GetNextDirtySpot()
    local Spots =
        GetDirtySpots()

    for _, Spot in ipairs(
        Spots
    ) do
        if not IsSpotOnCooldown(
            Spot
        ) then
            return Spot
        end
    end

    return nil
end

--========================================================
-- CLEAN ONE SPOT
--========================================================

local function CleanSpot(
    Spot
)
    if not Settings.AutoCleaning
        or not Spot
        or not Spot.Parent
        or IsSpotFinished(Spot)
    then
        return false,
            "Unavailable"
    end

    local Target =
        GetTargetCFrame(
            Spot
        )

    if not Target then
        return false,
            "NoTarget"
    end

    print(
        "[Cleaning] Going to:",
        Spot.Name
    )

    local Reached =
        MoveToJobTarget(
            Target,

            function()
                return
                    Settings.AutoCleaning
                    and Spot
                    and Spot.Parent ~= nil
            end
        )

    if not Settings.AutoCleaning then
        return false,
            "Stopped"
    end

    -- The spot can finish/disappear while traveling.
    if IsSpotFinished(Spot) then
        ClearSpotFailure(Spot)
        return true,
            "FinishedOnRoute"
    end

    if not Reached then
        return false,
            "MovementFailed"
    end

    local LastTrigger = 0
    local Started = os.clock()

    while Settings.AutoCleaning do
        if IsSpotFinished(Spot) then
            ClearSpotFailure(Spot)

            print(
                "[Cleaning] Finished:",
                Spot.Name
            )

            return true,
                "Finished"
        end

        if not Spot
            or not Spot.Parent
        then
            return true,
                "Removed"
        end

        local Prompt =
            GetCleanPrompt(
                Spot
            )

        if not Prompt
            or not Prompt.Parent
            or not Prompt.Enabled
        then
            return true,
                "PromptEnded"
        end

        if
            os.clock()
            - LastTrigger
            >= Settings.CleaningRetryDelay
        then
            local Triggered =
                TriggerPrompt(
                    Prompt
                )

            LastTrigger =
                os.clock()

            if not Triggered then
                return false,
                    "PromptFailed"
            end
        end

        -- A broken/stale spot should never hold the entire
        -- worker forever. Let it cool down and try another.
        if os.clock() - Started > 8 then
            return false,
                "SpotTimeout"
        end

        task.wait(0.05)
    end

    return false,
        "Stopped"
end

--========================================================
-- CLEANING WORKER
--========================================================

local function RunCleaningWorker()
    print(
        "[Cleaning] Started"
    )

    while Settings.AutoCleaning do
        local Spot =
            GetNextDirtySpot()

        if not Spot then
            task.wait(
                Settings.CleaningNoSpotDelay
            )

            continue
        end

        local Success,
            Cleaned,
            Reason =
            xpcall(
                function()
                    return CleanSpot(
                        Spot
                    )
                end,

                function(Error)
                    return debug.traceback(
                        tostring(Error),
                        2
                    )
                end
            )

        if not Success then
            warn(
                "[Cleaning] Spot error:",
                Cleaned
            )

            MarkSpotFailed(
                Spot
            )

        elseif Cleaned then
            ClearSpotFailure(
                Spot
            )

        else
            if Reason ~= "Stopped"
                and Reason ~= "Unavailable"
            then
                warn(
                    "[Cleaning] Skipping spot",
                    Spot and Spot.Name or "?",
                    "for",
                    Settings.CleaningFailureCooldown,
                    "seconds | Reason:",
                    Reason
                )

                MarkSpotFailed(
                    Spot
                )
            end
        end

        -- Always rescan after one target.
        task.wait(
            Settings.CleaningRescanDelay
        )
    end
end

--========================================================
-- START / SELF-RECOVER
--========================================================

local function StartAutoCleaning()
    if CleaningThread then
        return
    end

    CleaningThread =
        task.spawn(function()
            local Success,
                Error =
                xpcall(
                    RunCleaningWorker,

                    function(Message)
                        return debug.traceback(
                            tostring(Message),
                            2
                        )
                    end
                )

            if not Success then
                warn(
                    "[Cleaning] Worker crashed:",
                    Error
                )
            end

            -- IMPORTANT:
            -- Always release this reference, even after an error.
            CleaningThread = nil

            if Settings.AutoCleaning then
                warn(
                    "[Cleaning] Worker restarting..."
                )

                task.wait(
                    Settings.CleaningRestartDelay
                )

                if Settings.AutoCleaning
                    and not CleaningThread
                then
                    StartAutoCleaning()
                end

            else
                print(
                    "[Cleaning] Stopped"
                )
            end
        end)
end

local function StopAutoCleaning()
    Settings.AutoCleaning = false

    CleaningFailures = {}

    StopJobMovement()
end

