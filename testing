local function readPromptText(prompt)
    local parts = {}
    local ok = pcall(function()
        for _, node in ipairs(prompt:GetDescendants()) do
            if node:IsA("TextLabel") or node:IsA("TextButton") then
                local message = tostring(node.Text or "")
                if message ~= "" then parts[#parts + 1] = message end
            end
        end
    end)
    return ok and table.concat(parts, " ") or ""
end

local function inspectPrompt(prompt)
    if not permitted(false) or not prompt or not prompt.Parent then return end
    local message = readPromptText(prompt)
    if isConnectionReason(message) then startReconnect(message, false) end
end

local function attachPromptWatcher(overlay)
    if idleRuntime.PromptOverlay == overlay then return end
    idleRuntime.PromptOverlay = overlay
    promptMonitoringAvailable = true
    hookRuntimeConnection(overlay.ChildAdded:Connect(function(child)
        task.delay(0.2, function() inspectPrompt(child) end)
    end))
    for _, child in ipairs(overlay:GetChildren()) do
        task.defer(function() inspectPrompt(child) end)
    end
end

