-- RAYFIELD
--========================================================

local Rayfield

do
local function IsValidRayfield(
    Library
)
    return
        type(Library) == "table"
        and type(
            Library.CreateWindow
        ) == "function"
end

local function GetEnvironment()
    if type(getgenv) ~= "function" then
        return nil
    end

    local Success, Environment =
        pcall(getgenv)

    if Success
        and type(Environment) == "table"
    then
        return Environment
    end

    return nil
end

local function FindExistingRayfield()
    local Environment =
        GetEnvironment()

    local Candidates = {}

    if Environment then
        table.insert(
            Candidates,
            Environment.__GAMEHUB_RAYFIELD
        )

        table.insert(
            Candidates,
            Environment.Rayfield
        )
    end

    if type(_G) == "table" then
        table.insert(
            Candidates,
            rawget(
                _G,
                "__GAMEHUB_RAYFIELD"
            )
        )
    end

    if type(shared) == "table" then
        table.insert(
            Candidates,
            shared.__GAMEHUB_RAYFIELD
        )
    end

    for _, Candidate in ipairs(
        Candidates
    ) do
        if IsValidRayfield(
            Candidate
        ) then
            return Candidate
        end
    end

    return nil
end

local function CacheRayfield(
    Library
)
    local Environment =
        GetEnvironment()

    if Environment then
        Environment.__GAMEHUB_RAYFIELD =
            Library
    end

    if type(_G) == "table" then
        _G.__GAMEHUB_RAYFIELD =
            Library
    end

    if type(shared) == "table" then
        shared.__GAMEHUB_RAYFIELD =
            Library
    end
end

local function LoadRayfieldURL(
    URL
)
    local Existing =
        FindExistingRayfield()

    if Existing then
        return Existing
    end

    local HttpSuccess, Source =
        pcall(function()

            return game:HttpGet(
                URL
            )
        end)

    if not HttpSuccess
        or type(Source) ~= "string"
    then
        return nil
    end

    local Loader =
        loadstring(
            Source
        )

    if not Loader then
        return nil
    end

    local RunSuccess, Result =
        pcall(
            Loader
        )

    if RunSuccess
        and IsValidRayfield(
            Result
        )
    then
        CacheRayfield(
            Result
        )

        return Result
    end

    task.wait(0.15)

    return FindExistingRayfield()
end

Rayfield =
    FindExistingRayfield()
    or LoadRayfieldURL(
        "https://sirius.menu/gen2"
    )
    or LoadRayfieldURL(
        "https://sirius.menu/gen2-preview"
    )
end

if not Rayfield then
    warn(
        "[Game Hub] Rayfield failed to initialize."
    )

    return
end

