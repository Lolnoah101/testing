        if not bank then E.FishStatus="Fishing water loaded; no confirmed safe shore";return end
        pcall(function() char:PivotTo(CFrame.new(bank)) end)
        E.FishStatus="Traveling to fishing bank";E.FishAt=now+1.2;return
    end
