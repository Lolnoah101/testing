            local good,allowed,why=pcall(CombatV2Gate.canStart,char,LocalPlayer,"Block","BlockStart",0)
            if not good or allowed~=true then
                Hub.DefenseDebug="Block unavailable: "..tostring(why or "attack recovery/cooldown")
                return false
            end
        end
        if CombatV2State and type(CombatV2State.hasAny)=="function" then
            local good,blocked=pcall(CombatV2State.hasAny,char,
                {"TrueStun","GuardBroken","Ragdoll","Parried","Knocked","Scene","MoveLock"})
            if good and blocked then return false end
        end
        return true
    end
    if Combat and type(Combat.IsActionInProgress)=="function" and Combat.IsActionInProgress() then return false end
    if char:HasTag("Attacking") and Combat and type(Combat.OwnRecoveryEchoes)=="function"
        and not Combat.OwnRecoveryEchoes(true) then return false end
    return true
end
local function canParry(char, ctrl, now)
    if now < Hub.NextParry then return false end
    if char:GetAttribute("ParryOnCooldown") == true then return false end
    local reentry = char:GetAttribute("ParryReentryUntil")
    if type(reentry) == "number" and workspace:GetServerTimeNow() < reentry then return false end
    if CombatV2 then
        -- The updated game independently tracks the real local parry cooldown
        -- and the post-parry reentry lock. Never claim a parry is ready when
        -- our estimate has expired but its native gate has not.
        if CombatV2Gate and type(CombatV2Gate.cooldownLeft)=="function" then
            local ok,remaining=pcall(CombatV2Gate.cooldownLeft,LocalPlayer,"Parry")
            if ok and type(remaining)=="number" and remaining>0.01 then return false end
        end
        if CombatV2State and type(CombatV2State.has)=="function" then
            local ok,locked=pcall(CombatV2State.has,char,"ParryReentry")
            if ok and locked then return false end
        end
    end
    return canDefend(char, ctrl)
end
local function releaseDefense()
    local mode = Hub.DefenseMode
    Hub.DefenseMode, Hub.DefenseReleaseAt = nil, 0
    if not mode or manualHoldingBlock() then return end
    -- Wait for the server's short post-parry/block endlag instead of
    -- immediately starting another M1 on the same frame as release.
    Hub.DefenseUntil = math.max(Hub.DefenseUntil, os.clock() + 0.16)
    Hub.GuardUntil = math.max(Hub.GuardUntil, os.clock() + 0.08)
    if CombatV2 and CombatV2.input then
        safeCall(function() CombatV2.input.block(false) end)
    else
        local ctrl=controller()
        if ctrl then safeCall(function() ctrl:EndBlock(true) end) end
    end
end
local function faceTarget(myRoot, otherRoot)
    -- The farm flight controller owns the ENTIRE 3-D rotation when active.
    -- A flat LookAt here used to turn a horizontal Above/Below avatar upright
    -- in the middle of combat. Behind already faces its selected NPC.
    if Hub.FarmFlightRoot == myRoot then return end
    -- Native defensive hit checks generally depend on facing, so don't let an
    -- orbiting Behind/Above/Below farm pose turn our block away mid-swing.
    if not myRoot or not otherRoot or not otherRoot.Parent then return end
    local p, q = myRoot.Position, otherRoot.Position
    local flat = Vector3.new(q.X - p.X, 0, q.Z - p.Z)
    if flat.Magnitude < 0.12 then
        -- Above/Below often means identical XZ coordinates. Face against the
        -- enemy's forward direction instead of normalizing a zero vector.
        local enemyForward = otherRoot.CFrame.LookVector
        flat = Vector3.new(-enemyForward.X, 0, -enemyForward.Z)
    end
    if flat.Magnitude > 0.05 then
        myRoot.CFrame = CFrame.lookAt(p, p + flat.Unit)
    end
end
