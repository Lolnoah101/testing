function Hub.QuestFns.objPosition(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then
        local p = inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChild("Head")
            or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
        return p and p.Position or nil
    end
    -- Some quest boards use Folder containers rather than Model parts.
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position or nil
end

