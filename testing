        "Last seen progress (may be another quest): "..tostring(Hub.QuestDebugLastProgress),
        "Last runtime error: "..tostring(Hub.Stats.LastError),
    }
    return table.concat(lines,"\n")
end
function Hub:GetQuestDebugText(maxEvents)
    local limit=math.clamp(math.floor(tonumber(maxEvents) or 30),0,80)
    local lines={"HOLLOWMOON BEYOND NEN | QUEST DEBUG v59",questDebugSnapshot(),"", "RECENT EVENTS:"}
    for i=math.max(1,#self.QuestDebugEvents-limit+1),#self.QuestDebugEvents do
        local e=self.QuestDebugEvents[i]
        if e then table.insert(lines,e.Time.." "..e.Kind.." | "..e.Detail) end
    end
    return table.concat(lines,"\n")
end
function Hub:PrintQuestDebug(maxEvents)
    print(self:GetQuestDebugText(maxEvents))
end
function Hub:ClearQuestDebug()
    table.clear(self.QuestDebugEvents)
    Hub.QuestFns.questDebugEvent("DEBUG", "Cleared diagnostic history")
end
