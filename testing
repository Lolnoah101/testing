    local function visibleWaveHud()
        local now=os.clock()
        if now-(W.leaveHudScannedAt or -100)<1.5 then
            return W.leaveHudValue,W.leaveHudSource
        end
        W.leaveHudScannedAt=now
        W.leaveHudValue=nil
        W.leaveHudSource=nil
        local gui=LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not gui then return nil,nil end
        local best=nil
        for _,d in ipairs(gui:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
                local content=tostring(d.Text or "")
                if #content<=60 then
                    local number=content:match("^[Ww][Aa][Vv][Ee][Ss]?%s*[:#%-]?%s*(%d+)%f[%D]")
                    if number then
                        local visible=true
                        local parent=d.Parent
                        while parent and parent~=gui do
                            if parent:IsA("GuiObject") and not parent.Visible then
                                visible=false
                                break
                            end
                            parent=parent.Parent
                        end
                        if visible then
                            local n=tonumber(number)
                            if n and n>=1 and n<=10000 and (not best or n>best) then
                                best=n
                                W.leaveHudSource="Visible HUD: "..d.Name
                            end
                        end
                    end
                end
            end
        end
        W.leaveHudValue=best
        return W.leaveHudValue,W.leaveHudSource
    end
    W.readWaveCounter=function()
        if game.PlaceId~=TROST then return nil,"Not in Trost" end
        local f=folder()
        local obj=waveObjective()
        local found={}
        local function offer(value,source)
            local number=tonumber(value)
            if number and number>=0 and number<=10000
                and number==math.floor(number) then
                found[#found+1]={number=number,source=source}
            end
        end
        if f then
            offer(f:GetAttribute("Wave"),"Waves.Wave")
            offer(f:GetAttribute("CurrentWave"),"Waves.CurrentWave")
            local objectives=f:FindFirstChild("Objectives")
            for _,parent in ipairs({f, objectives}) do
                if parent then
                    for _,name in ipairs({"Wave","CurrentWave"}) do
                        local entry=parent:FindFirstChild(name)
                        if entry and entry:IsA("ValueBase") then
                            offer(entry.Value,entry:GetFullName())
                        end
                    end
                end
            end
        end
        offer(Workspace:GetAttribute("Wave"),"Workspace.Wave")
        offer(Workspace:GetAttribute("CurrentWave"),"Workspace.CurrentWave")
        if obj then
            offer(obj:GetAttribute("Wave"),"Objective.Wave")
            offer(obj:GetAttribute("CurrentWave"),"Objective.CurrentWave")
        end
        local hud,hudSource=visibleWaveHud()
        if hud then offer(hud,hudSource) end
        if #found==0 then
            W.leaveLastCandidates="No counter found (Waves folder="..tostring(f~=nil)..")"
            return nil,W.leaveLastCandidates
        end
        table.sort(found,function(a,b)
            if a.number==b.number then return a.source<b.source end
            return a.number>b.number
        end)
        local descriptions={}
        for index,entry in ipairs(found) do
            if index>7 then break end
            descriptions[#descriptions+1]=entry.source.."="..tostring(entry.number)
        end
        W.leaveLastCandidates=table.concat(descriptions," | ")
        W.leaveLastSource=found[1].source
        return found[1].number,found[1].source
    end
    -- The event reports real teleport initiation failures. It cannot report
    -- an ignored custom leave remote, so show that as unconfirmed separately.
    W.teleportFailureConnection=TeleportService.TeleportInitFailed:Connect(function(player,result,message,placeId)
        if player~=LocalPlayer or not W.flags.leave or game.PlaceId~=TROST then return end
        W.leaveLastTeleportFailure=tostring(result)..": "..tostring(message)
        W.leaveStatus="Teleport to "..tostring(placeId).." failed: "..W.leaveLastTeleportFailure
        do end
    end)
    W.tryLobbyTeleport=function()
        if Farm.unloaded or game.PlaceId~=TROST or not W.flags.leave then return end
        local now=os.clock()
        if now-W.leaveFallbackAttempt<12 then return end
        W.leaveFallbackAttempt=now
        W.leaveStatus="Town Central teleport requested; awaiting Roblox transfer"
        log("Auto Leave: using client teleport fallback to Town Central")
        task.spawn(function()
            local ok,err=pcall(function()
                TeleportService:Teleport(lobby,LocalPlayer)
            end)
            if not ok and game.PlaceId==TROST then
                W.leaveStatus="Town Central teleport call failed: "..tostring(err)
                do end
            end
        end)
    end
    local function waveLeaveTask()
        if Farm.unloaded or not W.flags.leave or game.PlaceId~=TROST then return false end
        local current,source=W.readWaveCounter()
        if current==nil then
            W.leaveStatus="Wave counter unavailable: "..tostring(source)
            return false
        end
        W.leaveObserved=current
        if current<W.leaveAtWave then
            W.leaveFirstReachedAt=nil
            W.leaveStatus=string.format("Wave %d / %d (source: %s)",current,W.leaveAtWave,source)
            return false
        end
        if not W.leaveFirstReachedAt then
            W.leaveFirstReachedAt=os.clock()
            W.leaveRequestedWave=current
            log(string.format("Auto Leave target reached: live wave %d >= chosen %d (source: %s). Counters: %s",
                current,W.leaveAtWave,source,W.leaveLastCandidates))
        end
        local now=os.clock()
        if now-W.lastLeaveAttempt<7 then
            if now-(W.leaveFirstReachedAt or now)>=9 and now-W.leaveLastNoticeAt>=12 then
                W.leaveLastNoticeAt=now
                W.leaveStatus=string.format(
                    "Wave %d >= %d; STILL in Trost after %d leave request(s). Server transfer not confirmed.",
                    current,W.leaveAtWave,W.leaveAttempts)
                do end
            end
            return true
        end
        W.lastLeaveAttempt=now
        W.leaveAttempts=W.leaveAttempts+1
        local attempt=W.leaveAttempts
        W.leaveStatus=string.format("Wave %d >= %d; native leave request %d (source: %s)",
            current,W.leaveAtWave,attempt,source)
        log("Auto Leave: "..W.leaveStatus)
        local post=getRemote("POST")
        if post and post:IsA("RemoteEvent") then
            local ok,err=pcall(function() post:FireServer("Functions","Teleport") end)
            if not ok then
                W.leaveStatus="Native leave request ERROR: "..tostring(err)
                do end
            else
                W.leaveStatus="Native leave submitted (NOT confirmed by server)"
            end
        else
            W.leaveStatus="Native POST remote missing; trying Town Central fallback"
            do end
        end
        task.delay(2.5,function()
            if Farm.unloaded or not W.flags.leave or game.PlaceId~=TROST then return end
            W.tryLobbyTeleport()
        end)
        return true
    end
    local function waveTick()
        if not wavesActive() or W.busy or W.inWorkflow
            or Farm.utilityBusy then return end
        local active,reason,token=breakWindow()
        W.downtimeStatus=reason
        if not active then
            W.breakToken=nil
            local f=folder()
            if f and f:GetAttribute("Finalised")~=nil then
                local busyWebhook=Farm.Webhook and (
                    (Farm.Webhook.collecting and os.clock()-(Farm.Webhook.collectingSince or 0)<6)
                    or (Farm.Webhook.sending and os.clock()-(Farm.Webhook.sendingSince or 0)<9))
                if not busyWebhook then waveLeaveTask() end
                return
            end
            -- Outside the Skip break, only the emergency blade-supply shortage
            -- may leave combat. Its own worker handles returning to the farm.
            emergencyRefillTask()
            return
        end
        if W.breakToken~=token then
            W.breakToken=token
            W.breakSeenAt=os.clock()
            W.equipRejected={}
            W.equipTransient={}
            W.actionCursor=1
        end
        if os.clock()-W.breakSeenAt<0.24 then return end
        if waveLeaveTask() then return end
        -- First let the hidden blade watcher reload/restock. Crate and
        -- equipment movement must not take control away mid-recovery.
        if type(Farm.bladeNeedsRecovery)=="function" and Farm.bladeNeedsRecovery() then
            W.downtimeStatus="Blade guard priority: "..tostring(Farm.bladeWatcherState)
            if W.needsEmergencyRefills and W.needsEmergencyRefills() then
                emergencyRefillTask()
            end
            return
        end
        local root=rootPart()
        if not root then return end
        local savedCFrame,savedVelocity=root.CFrame,root.AssemblyLinearVelocity
        W.inWorkflow=true
        W.workflowMode="intermission"
        Farm.utilityBusy=true
        W.workshopRuns=W.workshopRuns+1
        local ok,err=pcall(function()
            local deadline=os.clock()+2
            while Farm.attacking and os.clock()<deadline do task.wait(0.04) end
            if Farm.attacking or not W.continueWindow() then return end
            RunService.Heartbeat:Wait()
            snapshot()
            -- Collect crate first, then equipment upgrades until no selected
            -- level can be purchased at our present Gold, then HQ/base spends.
            observeCurrentCrate()
            crateTask()
            if not W.continueWindow() then return end
            local extras={healTask,
                function() return marketTask("Perks") end,
                function() return marketTask("Artifacts") end,
                function() return marketTask("Memories") end,
                function() return marketTask("Shifting") end,blessingTask}
            local idleCycles=0
            local started=os.clock()
            for cycle=1,85 do
                if Farm.unloaded or not W.continueWindow()
                    or os.clock()-started>21 then break end
                if type(Farm.bladeNeedsRecovery)=="function"
                    and Farm.bladeNeedsRecovery() then break end
                local acted=false
                if W.flags.crate then
                    local okCrate,handledCrate=pcall(crateTask)
                    if not okCrate then do end end
                    if okCrate and handledCrate then acted=true end
                end
                -- No HQ or market purchase is allowed while ANY selected
                -- equipment stat still has a level worth attempting.
                if #equipmentCandidates()>0 then
                    local success,handled=pcall(equipTask)
                    if not success then do end end
                    if success and handled then acted=true end
                else
                    -- Spend remaining Gold on selected base upgrades first.
                    local success,handled=pcall(baseTask)
                    if not success then do end end
                    if success and handled then acted=true end
                    if not handled and os.clock()-W.lastBase>=0.42 then
                        -- Non-upgrade jobs are kept, but only run once no
                        -- affordable selected HQ upgrade could be purchased.
                        for offset=0,#extras-1 do
                            local index=(W.actionCursor+offset-1)%#extras+1
                            local okExtra,used=pcall(extras[index])
                            if not okExtra then do end end
                            if okExtra and used then
                                W.actionCursor=index%#extras+1
                                acted=true
                                break
                            end
                        end
                    end
                end
                if acted then idleCycles=0 else idleCycles=idleCycles+1 end
                -- Allow at least one full 0.42s upgrade throttle before exit.
                if idleCycles>=8 then break end
                task.wait(0.08)
            end
        end)
        if root.Parent and not Farm.unloaded and rootPart()==root then
            -- A single return to the original spot after ALL purchases;
            -- if no zone travel happened, skip this CFrame assignment too.
            if (root.Position-savedCFrame.Position).Magnitude>0.4 then
                root.CFrame=savedCFrame
                root.AssemblyLinearVelocity=Farm.running and savedVelocity or Vector3.zero
                root.AssemblyAngularVelocity=Vector3.zero
            end
        end
        Farm.utilityBusy=false
        W.inWorkflow=false
        W.workflowMode=nil
        if not ok then do end end
    end
    local function updateStatus()
