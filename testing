                            Character,

                        requestId =
                            Id,
                    })
            end)


        if Success then
            LastTraitRequestAt = PendingTrait.sentAt
        else
            PendingTrait = nil

            -- Temporary transport error: back off rather than spam.
            NextTraitAutoSpinAt =
                math.max(
                    NextTraitAutoSpinAt,
                    os.clock() + (IsInstantSpinOn()
                        and TRAIT_INSTANT_ROLL_DELAY
                        or TRAIT_ROLL_DELAY)
