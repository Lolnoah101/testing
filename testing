    -- The official Survival picker now distinguishes Team (default) from Solo.
    -- Keep the existing Mode flag, so saved Survival/Trials preferences persist.
    modes:CreateDropdown({
        name = "Survival Party", flag = "GloryLobbySurvivalPartyV62",
        options = {"Team", "Solo"}, value = "Team", multiSelect = false,
        callback = function(value)
            local chosen = type(value) == "table" and value[1] or value
            if chosen ~= "Team" and chosen ~= "Solo" then return end
            if lobbyState.survivalChoice == chosen then return end
