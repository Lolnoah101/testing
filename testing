                end
            end

            if PendingSkillTree
                and os.clock() - PendingSkillTree.sentAt >= 7
            then
                PendingSkillTree = nil
                NextSkillTreeAt = os.clock() + 1.5
            end

            task.wait(0.20)
        end
    end)

    --//========================================================
    --// AUTO REDEEM ALL AVAILABLE CODES
