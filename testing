local function islandUnlocked(island)
    if not island or island == "Barnyard" then return true end
    if Player:GetAttribute("Island") == island then return true end
    local unlocked = ClientData.Get("UnlockedIslands")
    if type(unlocked) ~= "table" then
        -- This snapshot may not expose an unlock list. The server decides.
        return true
    end
    if unlocked[island] then return true end
    for _, id in pairs(unlocked) do
        if id == island then return true end
    end
    return false
end

local function doAutoBuy()
    if not running or not autoBuyWeapon or not ClientData.IsReady() then return end
    local id, info = nextWeaponToBuy()
    if not id or not info then return end
    local price = tonumber(info.Price) or math.huge
    if getNumber("Coins", 0) < price then return end
    if not islandUnlocked(info.Island) then return end
    local now = os.clock()

    if weaponPending and weaponPending.id ~= id then
        weaponPending = nil
        weaponAttempts = 0
    end
    if weaponPending and now - weaponPending.at < 5 then return end
    if weaponPending then
        weaponAttempts += 1
        if weaponAttempts >= 3 then
            if buyToggle then buyToggle:Set(false) else autoBuyWeapon = false end
            warn("[Tame V44] Auto Buy paused: purchase not confirmed. Try visiting the weapon shop.")
            return
        end
    end
    weaponPending = {id = id, at = now}
    ShopRemote:FireServer("BuyWeapon", id)
end

