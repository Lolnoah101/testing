function Systems.stopCurrentCycle()
    mouseUp()

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    if Config.Mode == "OP" and State.Phase ~= "Idle" then
        safeFire(FishingPackets.FishCancel)
    end
end

function Systems.setMode(value)
    if value ~= "Legit" and value ~= "OP" then
        return
    end

    if Config.Mode == value then
        return
    end

    local wasEnabled = Config.Enabled
    Systems.stopCurrentCycle()

    Config.Mode = value

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0
    State.SkillIndex = 1

    if value == "OP" then
        State.LastPacketAt = os.clock()
        resetOPSession(wasEnabled and 0.10 or 0)
    else
        State.CurrentFishingState = getFishingState()
        State.StateEnteredAt = os.clock()
    end

    log("Mode ->", value)
end

function Systems.setEnabled(value)
    local newValue = value == true
    if Config.Enabled == newValue then
        return
    end

    Config.Enabled = newValue

    if Config.Enabled then
        Systems.applyOptimalFishingSettings()

        -- Force the watchdog to validate the currently equipped rod
        -- and rebuild the fishing session before the next cast.
        State.LastObservedRodId = nil
        State.RodMissingSince = 0
        State.LastRodWatchCheck = 0
        State.LastSkillTransferRodId = nil

        if Config.Mode == "OP" then
            State.LastPacketAt = os.clock()
            resetOPSession(0.10)
        else
            mouseUp()

            local currentState = getFishingState()

            if currentState ~= FState.Idling then
                pcall(function()
                    safeFire(FishingPackets.FishCancel)
                end)
            end

            State.LastCastStarted = 0
            State.LastPrimaryClick = 0
            State.NextReelAt = 0
            State.NextSkillAt = 0
            State.NextLootClickAt = 0
            State.LegitResumeAt = os.clock() + 0.10
            State.CurrentFishingState = currentState
            State.StateEnteredAt = os.clock()

            task.delay(0.10, function()
                if State.Alive
                    and Config.Enabled
                    and Config.Mode == "Legit" then

                    State.CurrentFishingState = getFishingState()
                    State.StateEnteredAt = os.clock()
                    State.LastCastStarted = 0
                end
            end)
        end

        log("Enabled", "mode=" .. Config.Mode)
    else
        Systems.stopCurrentCycle()
        if Config.Mode == "OP" then
            resetOPSession(0)
        end
        log("Disabled")
    end
end

