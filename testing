local charCached, charCachedAt = nil, -math.huge
local function characterData()
    if os.clock() - charCachedAt < 0.2 then return charCached end
    charCachedAt = os.clock()
    local settings = getSettings()
    if not (settings and settings.CharacterSettings) then return nil end
    local name
    local client = getSkillModule()
    if client and type(client.returnCharacterName) == "function" then
        local ok, value = pcall(client.returnCharacterName, player)
        if ok and type(value) == "string" then name = value end
    end
    if not name then
        local stats = ReplicatedStorage:FindFirstChild(player.Name .. "StatDisplay")
        local value = stats and (stats:FindFirstChild("BattleCharacterName") or stats:FindFirstChild("CharacterName"))
        if value and value:IsA("StringValue") then name = value.Value end
    end
    charCached = name and settings.CharacterSettings[name] or nil
    return charCached
end

local function getCharacter()
    local character = player.Character
    if not (character and character.Parent) then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if hum and root and hum.Health > 0 then return character, hum, root end
end

-- A giant's decorative UpperTorso/Head can be dozens of studs away from
-- the combat root. The original v7 selected those parts first and added
-- half their height, making the farm hover far outside attack range.
-- Use the HumanoidRootPart (the game's own auto combat target anchor).
local function findCombatRoot(rig)
    local root = rig:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    root = rig:FindFirstChild("HumanoidRootPart", true)
    if root and root:IsA("BasePart") then return root end
    if rig.PrimaryPart then return rig.PrimaryPart end
    for _, name in ipairs({"LowerTorso", "Torso", "UpperTorso", "Hitbox", "HitBox", "Head"}) do
        local p = rig:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then return p end
    end
end

local function validTarget(t)
    if not (t and t.model and t.model:IsDescendantOf(Workspace)
        and t.hum and t.hum.Parent and t.hum.Health > 0
        and t.root and t.root:IsDescendantOf(t.model)) then
        return false
    end
    -- Some maps flag a monster for despawn before removing its Humanoid.
    -- Only trust explicit Boolean flags; do not guess from animations.
    for _, field in ipairs({"Dead", "IsDead", "Defeated", "Dying"}) do
        if t.model:GetAttribute(field) == true then return false end
    end
    if t.hum:GetState() == Enum.HumanoidStateType.Dead then return false end
    return true
end

local function closestBoxPoint(part, worldPosition)
    local objectPoint = part.CFrame:PointToObjectSpace(worldPosition)
    local half = part.Size * 0.5
    local clamped = Vector3.new(
        math.clamp(objectPoint.X, -half.X, half.X),
        math.clamp(objectPoint.Y, -half.Y, half.Y),
        math.clamp(objectPoint.Z, -half.Z, half.Z)
    )
    return part.CFrame:PointToWorldSpace(clamped)
end

local function effectiveDistance(t, fromPosition)
    -- Only for deciding whether to use a skill. Skill validation is server-side.
    local center = (t.root.Position - fromPosition).Magnitude
    local surface = (closestBoxPoint(t.root, fromPosition) - fromPosition).Magnitude
    local d = math.min(center, surface)
    -- Some giant rigs have a small central root but very large nearby torsos.
    -- Allow the skill attempt when beside that torso; do not use a huge model
    -- bounding box, which can include unrelated attachments and decorations.
    for _, name in ipairs({"LowerTorso", "Torso", "UpperTorso", "Head", "Hitbox", "HitBox"}) do
        local body = t.model:FindFirstChild(name, true)
        if body and body:IsA("BasePart") and body ~= t.root then
            d = math.min(d, (closestBoxPoint(body, fromPosition) - fromPosition).Magnitude)
        end
    end
    return d
end

local function clearTargetConnections()
    for _, connection in ipairs(S.targetConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(S.targetConnections)
end

local function setTarget(nextTarget)
    if S.target == nextTarget then return end
    S.stallTarget = nil
    S.stallProbePosition = nil
    clearTargetConnections()
    S.target = nextTarget
    S.targetChangedAt = os.clock()
    S.waypoints = nil
    S.lastPathGoal = nil
    S.lastMoveTo = -HUGE
    S.pathAt = -HUGE
    S.pathGeneration = S.pathGeneration + 1
    S.pathPending = false
    -- Do NOT reset the character's pose or release Physics on target changes.
    -- Tween should continue seamlessly from the actual current position.
    if nextTarget then
        local forward = nextTarget.root.CFrame.LookVector
        local flat = Vector3.new(forward.X, 0, forward.Z)
        if flat.Magnitude > 0.05 then S.lateral = flat.Unit end

        local lost = function()
            if S.target == nextTarget then
                setTarget(nil)
                S.lastTargetScan = -HUGE -- force selection on next Heartbeat
            end
        end
        S.targetConnections[#S.targetConnections + 1] = nextTarget.hum.HealthChanged:Connect(function(health)
            if health <= 0 then lost() end
        end)
        S.targetConnections[#S.targetConnections + 1] = nextTarget.model.AncestryChanged:Connect(function()
            if not nextTarget.model:IsDescendantOf(Workspace) then lost() end
        end)
        for _, attr in ipairs({"Dead", "IsDead", "Defeated", "Dying"}) do
            S.targetConnections[#S.targetConnections + 1] = nextTarget.model:GetAttributeChangedSignal(attr):Connect(function()
                if nextTarget.model:GetAttribute(attr) == true then lost() end
            end)
        end
    end
end

-- Keep a cached index of live monster rigs. DescendantAdded / HealthChanged /
-- Died events update it without a full GetDescendants() scan every frame.
local function removeIndexedHumanoid(hum)
    local entry = S.indexedTargets[hum]
    if entry then
        S.indexedTargets[hum] = nil
        for _, conn in ipairs(entry.connections) do
            pcall(function() conn:Disconnect() end)
        end
        if S.target == entry.target then
            setTarget(nil)
        end
    end
    S.pendingHumanoids[hum] = nil
end

local function trackHumanoid(hum)
    if not hum:IsA("Humanoid") or S.indexedTargets[hum] then return end
    if hum.Health <= 0 then return end
    local rig = hum.Parent
    if not (rig and rig:IsA("Model") and rig:IsDescendantOf(S.monsterFolder)) then
        return
    end
    local targetRoot = findCombatRoot(rig)
    if not targetRoot then
        S.pendingHumanoids[hum] = true
        return
    end
    S.pendingHumanoids[hum] = nil
    local t = {model=rig, hum=hum, root=targetRoot, part=targetRoot, priority=(hum.Name == "Monster" and 1 or 0)}
    local entry = {target=t, connections={}}
    S.indexedTargets[hum] = entry
    entry.connections[#entry.connections+1] = hum.HealthChanged:Connect(function(health)
        if health <= 0 then removeIndexedHumanoid(hum) end
    end)
    entry.connections[#entry.connections+1] = hum.Died:Connect(function()
        removeIndexedHumanoid(hum)
    end)
    entry.connections[#entry.connections+1] = hum.AncestryChanged:Connect(function()
        if S.monsterFolder and not hum:IsDescendantOf(S.monsterFolder) then
            removeIndexedHumanoid(hum)
        end
    end)
    S.lastTargetScan = -HUGE
end

local function clearMonsterIndex()
    for hum in pairs(S.indexedTargets) do removeIndexedHumanoid(hum) end
    for _, conn in ipairs(S.monsterWatch) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(S.monsterWatch)
    table.clear(S.pendingHumanoids)
    S.monsterFolder = nil
end

local function bindMonsterIndex()
    local folders = Workspace:FindFirstChild("Folders")
    local folder = folders and folders:FindFirstChild("Monsters")
    if folder == S.monsterFolder then return end
    clearMonsterIndex()
    S.monsterFolder = folder
    if not folder then return end
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("Humanoid") then trackHumanoid(item) end
    end
    S.monsterWatch[#S.monsterWatch+1] = folder.DescendantAdded:Connect(function(item)
        if item:IsA("Humanoid") then
            trackHumanoid(item)
        elseif item:IsA("BasePart") then
            -- The rig's root may spawn AFTER the Humanoid.
            local rig = item:FindFirstAncestorOfClass("Model")
            if rig then
                local hum = rig:FindFirstChildOfClass("Humanoid")
                if hum and S.pendingHumanoids[hum] then trackHumanoid(hum) end
            end
        end
    end)
    S.monsterWatch[#S.monsterWatch+1] = folder.DescendantRemoving:Connect(function(item)
        if item:IsA("Humanoid") then removeIndexedHumanoid(item) end
    end)
end

-- Rebuild missing entries if a stage loads a complete monster rig without a
-- Humanoid/Root descendant event. Do not scan the whole Workspace or choose
-- NPCs outside the game's Monsters folder.
S.reconcileMonsterIndex = function(now, urgent)
    local interval = urgent and 1.1 or 7
    if now - (S.lastMonsterReconcileAt or -HUGE) < interval then return end
    S.lastMonsterReconcileAt = now
    bindMonsterIndex()
    local folder = S.monsterFolder
    if not folder then return end
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("Humanoid") then
            local entry = S.indexedTargets[item]
            if entry and (not entry.target or not entry.target.root
                or not entry.target.root:IsDescendantOf(entry.target.model)) then
                removeIndexedHumanoid(item)
            end
            if item.Health > 0 and not S.indexedTargets[item] then
                trackHumanoid(item)
            end
        end
    end
end

local function extremeModeActive()
    local mode=tostring(Workspace:GetAttribute("GameMode") or ""):lower()
    return mode:find("extreme",1,true)~=nil or S.modeIntent=="ExtremeDimension"
end
S.bossBarActive = function()
    local gui=player:FindFirstChildOfClass("PlayerGui")
    local battle=gui and gui:FindFirstChild("BattleCenterUIFrame",true)
    local frame=battle and battle:FindFirstChild("BossHealthFrame")
    return frame and frame:IsA("GuiObject") and frame.Visible==true or false
end
local function bossScore(target)
    if not target or not target.model then return 0 end
    local model=target.model
    if model:GetAttribute("IsBoss")==true or model:GetAttribute("Boss")==true
        or target.hum:GetAttribute("IsBoss")==true then return 100 end
    local flag=model:FindFirstChild("IsBoss") or model:FindFirstChild("Boss")
    if flag and flag:IsA("BoolValue") and flag.Value then return 100 end
    local name=model.Name:lower()
    if name:find("portal",1,true) or name:find("minion",1,true) then return -10 end
    if name:find("boss",1,true) or name:find("guardian",1,true)
        or name:find("final",1,true) or name:find("vampire king",1,true)
        or name:find("pumpkin king",1,true) then return 80 end
    -- Some boss rigs have no explicit marker. Prefer substantially larger
    -- combat roots over portal adds, never mere decorative parts.
    local size=target.root.Size
    if math.max(size.X,size.Y,size.Z)>=14 then return 25 end
    return 0
end
S.targetInCurrentArea = function(t, root)
    if not validTarget(t) then return false end
    local dist = (t.root.Position - root.Position).Magnitude
    if dist <= S.localFarmRange then return true end
    -- A very large boss may have its actual root far below its visible torso.
    return dist <= S.localFarmRange + 90
        and effectiveDistance(t, root.Position) <= 45
end
S.bossWithinCurrentArea = function(t, root)
    if not S.targetInCurrentArea(t,root) then return false end
    return (t.root.Position - root.Position).Magnitude <= S.localBossPriorityRange
        or effectiveDistance(t,root.Position) <= 40
end
local function findTarget(root)
    bindMonsterIndex()
    local folder = S.monsterFolder
    if not folder then
        if S.target then setTarget(nil) end
        return nil
    end
    local current = S.target
    local prioritizeBoss=extremeModeActive() or S.bossBarActive()
    local highestBoss = 0
    if prioritizeBoss then
        for _,entry in pairs(S.indexedTargets) do
            local candidate=entry.target
            if validTarget(candidate) and candidate.model:IsDescendantOf(folder)
                and S.bossWithinCurrentArea(candidate,root) then
                highestBoss=math.max(highestBoss,bossScore(candidate))
            end
        end
    end
    if current and S.targetInCurrentArea(current,root) and current.model:IsDescendantOf(folder)
        and (not prioritizeBoss or
            (highestBoss > 0 and S.bossWithinCurrentArea(current,root)
                and bossScore(current) >= highestBoss) or
            (highestBoss <= 0 and
                (current.root.Position-root.Position).Magnitude < S.localBossPriorityRange)) then
        return current
    end
    -- Pending rigs are checked immediately on the next Heartbeat.
    for hum in pairs(S.pendingHumanoids) do
        if hum.Parent and hum.Health > 0 then
            trackHumanoid(hum)
        else
            S.pendingHumanoids[hum] = nil
        end
    end
    local localBest, localDistance, localPriority = nil, math.huge, -math.huge
    local fallbackBest, fallbackDistance = nil, math.huge
    for hum, entry in pairs(S.indexedTargets) do
        local t = entry.target
        if validTarget(t) and t.model:IsDescendantOf(folder) then
            local d = (t.root.Position-root.Position).Magnitude
            if S.targetInCurrentArea(t,root) then
                local score = prioritizeBoss and S.bossWithinCurrentArea(t,root)
                    and bossScore(t) or t.priority
                if not localBest or score > localPriority
                    or (score == localPriority and d < localDistance) then
                    localBest, localDistance, localPriority = t,d,score
                end
            elseif d < fallbackDistance then
                -- No arbitrary height or 220-stud lockout: if the avatar was
                -- sent onto a roof, choose the nearest living enemy anywhere.
                fallbackBest, fallbackDistance = t,d
            end
        else
            removeIndexedHumanoid(hum)
        end
    end
    local best = localBest
    if not best then
        -- Preserve the existing living target during long-distance travel;
        -- a newly spawned nearby enemy still overrides it immediately.
        if current and validTarget(current) and current.model:IsDescendantOf(folder) then
            best = current
        else
            best = fallbackBest
        end
    end
    if S.target ~= best then setTarget(best) end
    return best
end

local function faceFlat(root, target)
    if S.autoFarm then return end -- movement controller owns rotation while farming
    local focus = target.root.Position
    local flat = Vector3.new(focus.X, root.Position.Y, focus.Z)
    if (flat - root.Position).Magnitude > 0.1 then
        root.CFrame = CFrame.lookAt(root.Position, flat)
    end
end

local releaseMovement, desiredFarmPose, farmTick

-- Aim target selection: use a body part for tall bosses, if present.
-- The captured skill remotes contain an HRP CFrame, NOT a mouse-position argument.
local function aimPosition(target)
    local torso = target.model:FindFirstChild("UpperTorso", true)
        or target.model:FindFirstChild("Torso", true)
        or target.model:FindFirstChild("Head", true)
    if torso and torso:IsA("BasePart") then
        return torso.Position
    end
    return target.root.Position
end

local function safeLookAt(pos, look, up)
    local direction = look - pos
    if direction.Magnitude <= 0.1 then return CFrame.new(pos) end
    local fwd = direction.Unit
    local vertical = (up or Vector3.yAxis).Unit
    if math.abs(fwd:Dot(vertical)) > .95 then
        vertical = math.abs(fwd:Dot(Vector3.yAxis)) < .9 and Vector3.yAxis or Vector3.xAxis
    end
    return CFrame.lookAt(pos, look, vertical)
end

-- The game's EffectsModule.createTelegraphTimer creates red, anchored,
-- neon warning Parts inside Workspace.Folders.Debris. These may grow during
-- the warning, so we track them by color/material rather than initial size.
local function isHazard(part)
    if not part:IsA("BasePart") or not part.Anchored then return false end
    if part.Transparency >= 0.94 or part.Material ~= Enum.Material.Neon then return false end
    local c = part.Color
    -- The game's telegraph tint is Color3.fromRGB(255, 89, 92).
    if c.R < 0.60 or c.R < c.G * 1.5 or c.R < c.B * 1.4 then return false end
    -- A warning may start under one stud wide/long before it expands.
    -- Ignore only particle-like specks with *both* very small horizontal axes.
    return math.max(part.Size.X, part.Size.Z) >= 1.5
end

-- The game's CreateTelegraphTimer builds a thin part and TWEENS IT ACROSS
-- the entire danger area. Looking only at its current position misses the
-- future attack volume. The matching server event supplies the full area:
-- cframe, area size, preview duration, and circle/rectangle type.
-- We listen (no interception, no hook) and retain the region through impact.
local function addFullTelegraph(cf, areaSize, fillSize, duration, circle, tint)
    if not S.autoDodge then return end
    if typeof(cf) ~= "CFrame" or typeof(areaSize) ~= "Vector3" then return end
    if type(duration) ~= "number" or duration <= 0 or duration > 30 then return end
    if typeof(tint) == "Color3" and (tint.R < .5 or tint.R < tint.G * 1.25) then return end
    local now = os.clock()
    local zone = {
        cf = cf,
        circle = circle == true,
        expires = now + duration + IMPACT_HOLD,
        born = now,
    }
    if zone.circle then
        local grow = typeof(fillSize) == "Vector3" and fillSize or areaSize
        local diameter = math.max(grow.X, grow.Y, grow.Z, areaSize.X, areaSize.Y, areaSize.Z)
        zone.size = Vector3.new(diameter, 1, diameter)
    else
        zone.size = Vector3.new(math.abs(areaSize.X), 1,
            math.abs(areaSize.Z))
    end
    if zone.size.X < 1 or zone.size.Z < 1 then return end
    S.remoteHazards[#S.remoteHazards + 1] = zone
end

if remote then
    S.connections[#S.connections + 1] = remote.OnClientEvent:Connect(function(command, cf, size, fillSize, duration, circle, tint)
        if command == "CreateTelegraphTimer" then
            addFullTelegraph(cf, size, fillSize, duration, circle, tint)
        end
    end)
end

local function clearHazardTracking()
    for _, conn in ipairs(S.telegraphConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(S.telegraphConnections)
    table.clear(S.hazardParts)
    table.clear(S.dangerList)
    table.clear(S.visualHazardMemory)
    table.clear(S.remoteHazards)
    S.telegraphFolder = nil
    S.dodgeGoal = nil
    S.dodgeHoldUntil = -HUGE
    S.dodgeLastClear = nil
    S.dodgeResumeUntil = -HUGE
end

local function bindHazards(now)
    if now - S.lastHazardBind < 0.5 then return end
    S.lastHazardBind = now
    local folders = Workspace:FindFirstChild("Folders")
    local debris = folders and folders:FindFirstChild("Debris")
    if debris == S.telegraphFolder then return end
    for _, conn in ipairs(S.telegraphConnections) do pcall(function() conn:Disconnect() end) end
    table.clear(S.telegraphConnections)
    table.clear(S.hazardParts)
    S.telegraphFolder = debris
    if not debris then return end
    for _, d in ipairs(debris:GetDescendants()) do
        if d:IsA("BasePart") then S.hazardParts[d] = true end
    end
    S.telegraphConnections[#S.telegraphConnections+1] = debris.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") then S.hazardParts[d] = true end
    end)
    S.telegraphConnections[#S.telegraphConnections+1] = debris.DescendantRemoving:Connect(function(d)
        S.hazardParts[d] = nil -- cached snapshot lives through impact
    end)
end

local function nearZone(zone, pos)
    local diameter = zone.size.Magnitude
    return (zone.cf.Position - pos).Magnitude < math.max(130, diameter * .9 + 40)
end

local function nearbyHazards(rootPos, now)
    bindHazards(now)
    -- Look ahead to the current farm target as well as our present position.
    -- A fast Tween should not enter a telegraph before it is recognized.
    local targetPos = S.target and S.target.root and S.target.root.Parent
        and S.target.root.Position or nil
    local function relevant(zone)
        return nearZone(zone, rootPos) or (targetPos and nearZone(zone, targetPos))
            or (S.autoFarm and S.autoDodge and (zone.cf.Position - rootPos).Magnitude < 420)
    end
    if now - S.lastHazardRead < 0.016 then return S.dangerList end
    S.lastHazardRead = now
    local zones = {}
    for index = #S.remoteHazards, 1, -1 do
        local zone = S.remoteHazards[index]
        if now >= zone.expires then
            table.remove(S.remoteHazards, index)
        elseif relevant(zone) then
            zones[#zones + 1] = zone
        end
    end

    for part in pairs(S.hazardParts) do
        if not part.Parent then
            S.hazardParts[part] = nil
        elseif isHazard(part) then
            -- Follow the moving visual marker and maintain a swept corridor
            -- between its first position and its latest position. This is only
            -- the fallback for telegraphs not received from the remote event.
            local m = S.visualHazardMemory[part]
            if not m then
                m = { first = part.Position, position = part.Position, cf = part.CFrame,
                    size = part.Size, expires = now + IMPACT_HOLD }
                S.visualHazardMemory[part] = m
            end
            local difference = part.Position - m.first
            local travel = math.abs(difference:Dot(part.CFrame.LookVector))
            local center = m.first:Lerp(part.Position, .5)
            m.cf = CFrame.new(center) * part.CFrame.Rotation
            m.size = Vector3.new(math.max(1, part.Size.X), math.max(1, part.Size.Y),
                math.max(1, part.Size.Z + travel + 12))
            m.position = part.Position
            m.expires = now + IMPACT_HOLD
        end
    end
    for part, snapshot in pairs(S.visualHazardMemory) do
        if now >= snapshot.expires then
            S.visualHazardMemory[part] = nil
        elseif relevant(snapshot) then
            zones[#zones+1] = snapshot
        end
    end
    S.dangerList = zones
    return zones
end

local function positionDanger(pos, zones, margin)
    margin = margin or 1
    local worst = 0
    for _, zone in ipairs(zones) do
        local q = zone.cf:PointToObjectSpace(pos)
        -- Ground telegraphs often strike high above the painted floor,
        -- especially on giant boss attacks. Keep a forgiving height band.
        local height = math.max(36, math.min(65, zone.size.Y * 0.5 + 38))
        if math.abs(q.Y) <= height then
            local halfX = zone.size.X * .5 + margin
            local halfZ = zone.size.Z * .5 + margin
            if zone.circle then
                local radius = math.max(halfX, halfZ)
                local radial = math.sqrt(q.X*q.X + q.Z*q.Z)
                if radial <= radius then worst = math.max(worst, 1 + radius-radial) end
            elseif math.abs(q.X) <= halfX and math.abs(q.Z) <= halfZ then
                worst = math.max(worst, 1 + math.min(halfX - math.abs(q.X), halfZ - math.abs(q.Z)))
            end
        end
    end
    return worst
end

-- Probe a possible escape position, ignoring monsters and transient effects.
-- A position beyond an arena ledge must not be chosen as a "safe" dodge goal.
-- Ground may be far below giant bosses, so cast deeply enough to find it.
local function groundSupportAt(position)
    local ignores = {}
    if player.Character then ignores[#ignores + 1] = player.Character end
    local folders = Workspace:FindFirstChild("Folders")
    if folders then
        local monsters = folders:FindFirstChild("Monsters")
        local debris = folders:FindFirstChild("Debris")
        if monsters then ignores[#ignores + 1] = monsters end
        if debris then ignores[#ignores + 1] = debris end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    -- Starting above the avatar can accidentally intersect a low cave roof.
    -- Probe from the avatar's own elevation, and only down toward the floor.
    local startPoint = position + Vector3.new(0, 2, 0)
    local direction = Vector3.new(0, -460, 0)
    for _ = 1, 8 do
        params.FilterDescendantsInstances = ignores
        local hit = Workspace:Raycast(startPoint, direction, params)
        if not hit then return nil end
        if hit.Normal.Y >= 0.55 and hit.Instance.CanCollide
            and hit.Position.Y > Workspace.FallenPartsDestroyHeight + 25 then
            return hit.Position.Y
        end
        ignores[#ignores + 1] = hit.Instance
    end
    return nil
end

-- Farm destinations are based on the enemy, never on a remembered arena
-- floor or roof height. No arena-height clamp interferes with Auto Farm.

local function supportedEscapePoint(point)
    -- Dodge still requires real support beneath an escape destination, but
    -- it must not prohibit moving between different arena elevations.
    return groundSupportAt(point) ~= nil
end

local function chooseSafeDodgePoint(fromPos, zones, nearPos)
    -- Rank with cheap geometry first, then raycast only the best candidates.
    -- Doing a floor raycast for every direction on every Heartbeat would
    -- cause lag precisely when combat and evasive movement matter most.
    local fallbacks = {}
    for _, radius in ipairs({8, 13, 20, 30, 44, 60, 78, 100}) do
        local clearCandidates = {}
        for i = 1, 24 do
            local angle = (i - 1) * math.pi * 2 / 24
            local point = fromPos + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
            local danger = positionDanger(point, zones, 6)
            local transitDanger = 0
            for fraction = 1, 3 do
                local along = fromPos:Lerp(point, fraction / 4)
                transitDanger = math.max(transitDanger, positionDanger(along, zones, 1))
            end
            local score = radius * 0.7 + transitDanger * 0.1
            if nearPos then score = score + math.min((point - nearPos).Magnitude, 100) * 0.3 end
            local candidate = {point = point, score = score}
            if danger == 0 then
                clearCandidates[#clearCandidates + 1] = candidate
            else
                candidate.score = score + danger * 100
                fallbacks[#fallbacks + 1] = candidate
            end
        end
        table.sort(clearCandidates, function(a, b) return a.score < b.score end)
        for i = 1, math.min(#clearCandidates, 10) do
            if supportedEscapePoint(clearCandidates[i].point) then
                return clearCandidates[i].point
            end
        end
    end
    -- If no perfect destination exists, try a supported partial escape.
    table.sort(fallbacks, function(a, b) return a.score < b.score end)
    for i = 1, math.min(#fallbacks, 15) do
        if supportedEscapePoint(fallbacks[i].point) then
            return fallbacks[i].point
        end
    end
    -- Staying in a warning is preferable to flying into the kill plane.
    return fromPos
end

-- No unsafe shortcut: only resume regular farming if its destination and
-- the entire return corridor are clear of the *current* telegraph volume.
local function pathClearOfDanger(startPos, endPos, zones)
    local length = (endPos - startPos).Magnitude
    local steps = math.clamp(math.ceil(length / 5), 2, 24)
    for i = 0, steps do
        if positionDanger(startPos:Lerp(endPos, i / steps), zones, 3) > 0 then
            return false
        end
    end
    return true
end

-- During a telegraph, another enemy may have a safe combat position.
-- Prefer farming that enemy over standing idle outside the danger zone.
-- Never select a target purely by proximity if its farm pose is in danger.
local function findSafeAlternateEnemy(root, current, zones, now)
    if not (S.autoFarm and current and #zones > 0) then return nil, nil end
    if now - S.lastAlternateCheck < 0.09 then
        local cached = S.safeAlternate
        if cached and cached ~= current and validTarget(cached) then
            local goal = desiredFarmPose(root, cached).Position
            if positionDanger(goal, zones, 7) == 0
                and positionDanger(cached.root.Position, zones, 5) == 0 then
                return cached, goal
            end
        end
        return nil, nil
    end
    S.lastAlternateCheck = now
    S.safeAlternate = nil
    local choices = {}
    local folder = S.monsterFolder
    for _, entry in pairs(S.indexedTargets) do
        local candidate = entry.target
        if candidate ~= current and validTarget(candidate)
            and folder and candidate.model:IsDescendantOf(folder) then
            local goal = desiredFarmPose(root, candidate).Position
            local distance = (goal - root.Position).Magnitude
            if distance < 350 and positionDanger(goal, zones, 7) == 0
                and positionDanger(candidate.root.Position, zones, 5) == 0 then
                choices[#choices+1] = {
                    target = candidate, goal = goal,
                    score = distance + (candidate.priority == 0 and 6 or 0)
                }
            end
        end
    end
    table.sort(choices, function(a,b) return a.score < b.score end)
    -- Ground support is expensive: verify only the best few candidates.
    for i = 1, math.min(5, #choices) do
        local option = choices[i]
        if S.farmMethod == "Legit" or supportedEscapePoint(option.goal) then
            S.safeAlternate = option.target
            return option.target, option.goal
        end
    end
    return nil, nil
end

local function endDodge(now)
    S.safeAlternate = nil
    S.dodgeGoal = nil
    S.dodgeLastClear = nil
    S.dodgeHoldUntil = -HUGE
    S.dodgeResumeUntil = now + REENGAGE_BOOST_TIME
end

local function dodgeTick(dt, root, humanoid, target, now)
    if not S.autoDodge then
        S.dodgeGoal, S.dodgeLastClear = nil, nil
        return false
    end
    local zones = nearbyHazards(root.Position, now)
    local farmPose = (S.autoFarm and target) and desiredFarmPose(root, target) or nil
    local farmGoal = farmPose and farmPose.Position
    local hereUnsafe = positionDanger(root.Position, zones, 4) > 0
    local farmUnsafe = farmGoal and positionDanger(farmGoal, zones, 5) > 0
    local blockedFarmPath = farmGoal and #zones > 0
        and not pathClearOfDanger(root.Position, farmGoal, zones)
    if blockedFarmPath then farmUnsafe = true end
    local goalUnsafe = S.dodgeGoal and positionDanger(S.dodgeGoal, zones, 5) > 0

    -- If our target is in danger, try a different, attackable enemy before
    -- going idle. Do not fly across an active hazard to reach the alternate.
    local alternate, alternateGoal
    if (hereUnsafe or farmUnsafe) and target then
        alternate, alternateGoal = findSafeAlternateEnemy(root, target, zones, now)
        if alternate and not hereUnsafe
            and pathClearOfDanger(root.Position, alternateGoal, zones) then
            setTarget(alternate)
            endDodge(now)
            return false
        end
    end

    -- If the current target's combat position is clear, instantly resume;
    -- this takes precedence over a previously planned dodge hold.
    if S.dodgeGoal and farmGoal and not hereUnsafe and not farmUnsafe
        and pathClearOfDanger(root.Position, farmGoal, zones) then
        endDodge(now)
        return false
    end

    if hereUnsafe or farmUnsafe or goalUnsafe then
        S.dodgeLastClear = nil
        local hold = now + DODGE_MIN_HOLD
        for _, zone in ipairs(zones) do
            if nearZone(zone, root.Position) or (farmGoal and nearZone(zone, farmGoal)) then
                hold = math.max(hold, zone.expires)
            end
        end
        S.dodgeHoldUntil = math.max(S.dodgeHoldUntil, hold)
        if not S.dodgeGoal or goalUnsafe then
            if not hereUnsafe and farmUnsafe then
                -- Stand off at the current safe point until the attack clears.
                S.dodgeGoal = root.Position
            else
                S.dodgeGoal = chooseSafeDodgePoint(root.Position, zones,
                    alternateGoal or farmGoal or (target and target.root.Position)) or root.Position
            end
        end
    elseif S.dodgeGoal then
        if now < S.dodgeHoldUntil then
            S.dodgeLastClear = nil
        else
            S.dodgeLastClear = S.dodgeLastClear or now
            if now - S.dodgeLastClear >= DODGE_CLEAR_CONFIRM then
                endDodge(now)
                return false
            end
        end
    else
        return false
    end

    local goal = S.dodgeGoal
    if not goal then return false end
    if S.autoFarm and S.farmMethod ~= "Legit" then
        local pose
        if target then
            if S.farmPosition == "Above" or S.farmPosition == "Below" then
                -- Keep exactly the same flat body pose during evasive motion.
                -- Looking from the dodge point toward the enemy would pitch
                -- or roll the avatar sideways while it travels.
                pose = CFrame.new(goal) * desiredFarmPose(root, target).Rotation
            else
                local focus = target.root.Position
                local flat = Vector3.new(focus.X, goal.Y, focus.Z)
                pose = safeLookAt(goal, flat, Vector3.yAxis)
            end
        else
            pose = CFrame.new(goal) * root.CFrame.Rotation
        end
        farmTick(dt, root, humanoid, target, now, pose)
    else
        if S.oldCharacter and S.farmMethod ~= "Legit" then releaseMovement() end
        local walking = Vector3.new(goal.X, root.Position.Y, goal.Z)
        humanoid:MoveTo(walking)
        local dir = walking - root.Position
        if dir.Magnitude > 2 and now - S.lastDodgeDash > .4 then
            local client = getSkillModule()
            if client and type(client.dash) == "function" then pcall(client.dash, dir.Unit) end
            S.lastDodgeDash = now
        end
    end
    return true
end

-- Safe ground point: ignore monster rigs, telegraph effects, and non-walkable
-- surfaces. Used before restoring gravity after midair / noclip farming.
local function findWalkableLanding(root, character, maxDrop)
    local ignores = { character }
    local folders = Workspace:FindFirstChild("Folders")
    local monsters = folders and folders:FindFirstChild("Monsters")
    local debris = folders and folders:FindFirstChild("Debris")
    if monsters then ignores[#ignores+1] = monsters end
    if debris then ignores[#ignores+1] = debris end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true
    local source = root.Position + Vector3.new(0, 6, 0)
    for _ = 1, 16 do
        params.FilterDescendantsInstances = ignores
        local hit = Workspace:Raycast(source, Vector3.new(0, -(maxDrop or 650), 0), params)
        if not hit then return nil end
        local part = hit.Instance
        if hit.Normal.Y >= 0.58 and part.CanCollide
            and hit.Position.Y > Workspace.FallenPartsDestroyHeight + 12 then
            local hum = character:FindFirstChildOfClass("Humanoid")
            local hip = hum and hum.HipHeight or 2
            local clearance = math.max(2.7, hip + root.Size.Y * .5 + 0.4)
            return Vector3.new(hit.Position.X, hit.Position.Y + clearance, hit.Position.Z)
        end
        ignores[#ignores+1] = part
    end
end

local function rememberGround(root, humanoid, character)
    if humanoid.FloorMaterial == Enum.Material.Air then return end
    local safe = findWalkableLanding(root, character, 25)
    if safe and (root.Position - safe).Magnitude < 14 then
        S.groundBackup = safe
    end
end

local function resultScreenVisible(now)
    if not statsReady() then
        S.resultVisible = false
        return false
    end
    if now - S.lastResultCheck < .12 then return S.resultVisible end
    S.lastResultCheck = now
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local result = gui and gui:FindFirstChild("ResultUI", true)
    S.resultVisible = result and result:IsA("GuiObject") and result.Visible or false
    return S.resultVisible
end

releaseMovement = function(resetFacing)
    -- Land while Physics/noclip is still owned by the farm controller.
    -- Do not simply turn off PlatformStand in the air: Roblox gravity will
    -- drop the rig through a floor when restored before collision resolution.
    local character, humanoid, root = S.oldCharacter, S.oldHumanoid, S.oldRoot
    local sameCharacter = character and character == player.Character
    if sameCharacter and humanoid and root and root.Parent
        and humanoid.Parent and humanoid.Health > 0 and S.forcedPhysics then
        local landing = findWalkableLanding(root, character, 650)
        if not landing then landing = S.groundBackup end
        local facing = root.CFrame.LookVector
        local flat = Vector3.new(facing.X, 0, facing.Z)
        if flat.Magnitude < .1 then flat = S.lateral end
        if flat.Magnitude < .1 then flat = Vector3.new(0, 0, -1) end
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.lookAt(landing or root.Position,
                (landing or root.Position) + flat.Unit)
        end)
    elseif root and root.Parent and humanoid and humanoid.Health > 0
        and resetFacing ~= false and S.farmMethod ~= "Legit" then
        local facing = root.CFrame.LookVector
        local flat = Vector3.new(facing.X, 0, facing.Z)
        if flat.Magnitude < .1 then flat = S.lateral end
        if flat.Magnitude > .1 then
            pcall(function()
                root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
            end)
        end
    end

    for part, original in pairs(S.oldCollisions) do
        if part and part.Parent then pcall(function() part.CanCollide = original end) end
        S.oldCollisions[part] = nil
    end

    if humanoid and humanoid.Parent then
        if S.oldPlatformStand ~= nil then
            pcall(function() humanoid.PlatformStand = S.oldPlatformStand end)
        end
        if S.oldAutoRotate ~= nil then
            pcall(function() humanoid.AutoRotate = S.oldAutoRotate end)
        end
        if S.forcedPhysics and humanoid.Health > 0 and not humanoid.PlatformStand then
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if root and root.Parent and humanoid.Health > 0 then
            pcall(function() humanoid:MoveTo(root.Position) end)
        end
    end
    S.oldAutoRotate, S.oldPlatformStand = nil, nil
    S.oldCharacter, S.oldHumanoid, S.oldRoot = nil, nil, nil
    S.forcedPhysics = false
    S.waypoints = nil
    S.pathGeneration = S.pathGeneration + 1
    S.pathPending = false
    S.smoothPose = nil
    S.lastScriptPosition = nil
    S.lastClipCheck = -HUGE
end

local function makeNoClip(character)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if S.oldCollisions[part] == nil then S.oldCollisions[part] = part.CanCollide end
            if part.CanCollide then part.CanCollide = false end
        end
    end
end

-- Freeze the horizontal body axis once per farm session. Enemy yaw and
-- animations must never rotate a prone Above/Below avatar sideways.
local function stablePoseHeading(root)
    if S.poseHeading and S.poseHeading.Magnitude > 0.1 then
        return S.poseHeading
    end
    local facing = root.CFrame.LookVector
    local heading = Vector3.new(facing.X, 0, facing.Z)
    if heading.Magnitude < 0.1 then
        local up = root.CFrame.UpVector
        heading = Vector3.new(up.X, 0, up.Z)
    end
    if heading.Magnitude < 0.1 then heading = Vector3.new(0, 0, -1) end
    S.poseHeading = heading.Unit
    return S.poseHeading
end

desiredFarmPose = function(root, target)
    local enemyRoot = target.root
    local focus = enemyRoot.Position
    local distance = S.farmDistance
    local position, lookAt, up
    local forward = enemyRoot.CFrame.LookVector
    local horizontal = Vector3.new(forward.X, 0, forward.Z)
    if horizontal.Magnitude < 0.05 then horizontal = S.lateral end
    horizontal = horizontal.Unit

    if S.farmPosition == "Above" then
        position = focus + Vector3.yAxis * distance
        lookAt = focus -- always exactly down, not diagonally at the torso
        up = stablePoseHeading(root)
    elseif S.farmPosition == "Below" then
        position = focus - Vector3.yAxis * distance
        lookAt = focus -- always exactly up, not diagonally at the torso
        up = stablePoseHeading(root)
    else
        position = focus - horizontal * distance
        lookAt = Vector3.new(focus.X, position.Y, focus.Z)
        up = Vector3.yAxis
    end
    return CFrame.lookAt(position, lookAt, up)
end

local function moveLegit(humanoid, root, target, now)
    -- Legit = grounded walking/pathfinding. No flight or below-the-map movement.
    local focus = target.root.Position
    local look = target.root.CFrame.LookVector
    local direction = Vector3.new(look.X, 0, look.Z)
    if direction.Magnitude < 0.05 then direction = S.lateral end
    local goal = focus - direction.Unit * S.farmDistance
    goal = Vector3.new(goal.X, root.Position.Y, goal.Z)
    local delta = goal - root.Position
    if delta.Magnitude <= 2 then
        if now - S.lastMoveTo > 0.12 then
            humanoid:MoveTo(root.Position)
            S.lastMoveTo = now
        end
        return
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { player.Character, target.model }
    local blocked = Workspace:Raycast(root.Position, delta, rayParams)
    if not blocked then
        if now - S.lastMoveTo > 0.12 then
            humanoid:MoveTo(goal)
            S.lastMoveTo = now
        end
        S.waypoints = nil
        return
    end
    if (now - S.pathAt > 0.6 or not S.waypoints or (S.lastPathGoal and (goal - S.lastPathGoal).Magnitude > 5))
        and not S.pathPending then
        S.pathAt = now
        S.lastPathGoal = goal
        S.pathPending = true
        local generation = S.pathGeneration
        local fromPosition = root.Position
        task.spawn(function()
            local ok, result = pcall(function()
                local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
                path:ComputeAsync(fromPosition, goal)
                if path.Status == Enum.PathStatus.Success then return path:GetWaypoints() end
            end)
            if not S.alive or generation ~= S.pathGeneration then return end
            S.pathPending = false
            if ok and result and #result > 0 then
                S.waypoints = result
                S.waypointIndex = math.min(2, #result)
            else
                S.waypoints = nil
            end
        end)
    end
    local waypoint = S.waypoints and S.waypoints[S.waypointIndex]
    if waypoint then
        if (Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z) - root.Position).Magnitude < 3 then
            S.waypointIndex = math.min(S.waypointIndex + 1, #S.waypoints)
            waypoint = S.waypoints[S.waypointIndex]
        end
        if waypoint and now - S.lastMoveTo >= 0.12 then
            if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
            humanoid:MoveTo(waypoint.Position)
            S.lastMoveTo = now
        end
    elseif now - S.lastMoveTo >= 0.12 then
        humanoid:MoveTo(goal)
        S.lastMoveTo = now
    end
end

farmTick = function(dt, root, humanoid, target, now, dodgeOverride)
    local character = player.Character
    if not character then return end
    if S.oldCharacter ~= character then
        releaseMovement()
        rememberGround(root, humanoid, character)
        S.oldCharacter = character
        S.oldHumanoid = humanoid
        S.oldRoot = root
        S.oldAutoRotate = humanoid.AutoRotate
        S.oldPlatformStand = humanoid.PlatformStand
    end

    if S.farmMethod == "Legit" then
        S.lastScriptPosition = nil
        rememberGround(root, humanoid, character)
        if next(S.oldCollisions) then
            for p, original in pairs(S.oldCollisions) do
                if p.Parent then p.CanCollide = original end
                S.oldCollisions[p] = nil
            end
        end
        humanoid.AutoRotate = true
        S.smoothPose = nil
        moveLegit(humanoid, root, target, now)
        return
    end

    humanoid.AutoRotate = false
    -- AutoRotate only disables yaw rotation. Roblox's running/falling
    -- humanoid controller can STILL right the rig upright each frame.
    -- Disable that controller while using a horizontal flight pose.
    if not humanoid.PlatformStand then humanoid.PlatformStand = true end
    if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end
    S.forcedPhysics = true
    if now - S.lastClipCheck >= 0.1 then
        makeNoClip(character)
        S.lastClipCheck = now
    end
    local goalPose = dodgeOverride or desiredFarmPose(root, target)
    -- If the avatar is stranded far above/outside the active fight, directly
    -- rejoin the selected enemy rather than staying on an old floor reference.
    -- Normal Tween distances remain smooth; dodge movement retains priority.
    if target and not dodgeOverride and S.farmMethod == "Tween" then
        local offset = goalPose.Position - root.Position
        if math.abs(offset.Y) >= 90 or offset.Magnitude >= 400 then
            root.CFrame = goalPose
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            S.smoothPose = goalPose
            S.lastScriptPosition = root.Position
            return
        end
    end
    if S.farmMethod == "Tween" and target and not dodgeOverride then
        -- Only rescue a genuinely stalled Tween. Do not snap during ordinary
        -- travel; the speed slider continues to govern all normal movement.
        local remaining = (goalPose.Position - root.Position).Magnitude
        if remaining >= 16 and not root.Anchored and humanoid.Health > 0 then
            if S.stallTarget ~= target or not S.stallProbePosition then
                S.stallTarget = target
                S.stallProbePosition = root.Position
                S.stallProbeAt = now
            elseif now - S.stallProbeAt >= 2.6 then
                local progressed = (root.Position - S.stallProbePosition).Magnitude
                if progressed < 2 and now - (S.lastStallRescueAt or -HUGE) >= 7 then
                    -- A direct rejoin is intentional ONLY after movement fails
                    -- for several seconds while a living enemy is in range.
                    root.CFrame = goalPose
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    S.smoothPose = goalPose
                    S.lastScriptPosition = root.Position
                    S.lastStallRescueAt = now
                    S.stallProbePosition = root.Position
                    S.stallProbeAt = now
                    return
                end
                S.stallProbePosition = root.Position
                S.stallProbeAt = now
            end
        else
            S.stallTarget = nil
            S.stallProbePosition = nil
        end
    elseif not dodgeOverride then
        S.stallTarget = nil
        S.stallProbePosition = nil
    end
    if S.farmMethod == "Teleport" then
        -- Instant mode follows target only when position/rotation changes materially.
        if (root.Position - goalPose.Position).Magnitude >= 0.3
            or root.CFrame.LookVector:Dot(goalPose.LookVector) < 0.999
            or root.CFrame.UpVector:Dot(goalPose.UpVector) < 0.999 then
            root.CFrame = goalPose
        end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        S.smoothPose = goalPose
    else
        -- Visibly smooth, continuous Tween-style follow at the user's chosen
        -- world-space speed. Old builds used 550-950 studs/sec and a huge
        -- exponential correction, making ordinary travel look like teleport.
        -- Dodge can temporarily travel faster to escape imminent strikes.
        local current = root.CFrame
        local safeDt = math.clamp(dt, 0, 0.07)
        local speed = math.clamp(tonumber(S.tweenSpeed) or 120, 40, 650)
        if dodgeOverride then speed = math.max(speed, 250) end
        local alpha = 1 - math.exp(-safeDt * (dodgeOverride and 14 or 9))
        local delta = goalPose.Position - current.Position
        local magnitude = delta.Magnitude
        local newPosition = current.Position
        if magnitude > 0.025 then
            -- Constant speed on long travel; soft easing in the last few studs.
            local step = math.min(magnitude, speed * safeDt, magnitude * alpha)
            if magnitude > 8 then step = math.min(magnitude, speed * safeDt) end
            newPosition = current.Position + delta.Unit * step
        end
        local rotated = current:Lerp(CFrame.new(current.Position) * goalPose.Rotation, alpha)
        root.CFrame = CFrame.new(newPosition) * rotated.Rotation
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        S.smoothPose = root.CFrame
    end
    S.lastScriptPosition = root.Position
end

local function holdFarmPose(root, humanoid)
    if S.oldCharacter ~= player.Character or S.oldRoot ~= root then return end
    if S.farmMethod == "Legit" then
        -- Legit movement shouldn't keep walking toward a dead monster.
        humanoid:MoveTo(root.Position)
        return
    end
    -- Still in a wave: keep flying in place until a new target spawns.
    -- Gravity must not take over during the 1-2 second spawn gap.
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    if humanoid:GetState() ~= Enum.HumanoidStateType.Physics then
        humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end
    local pose = S.smoothPose or root.CFrame
    root.CFrame = pose
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    S.lastScriptPosition = root.Position
end

local function fireBasic(root, data, now)
    if not remote or now - S.lastAttack < S.attackDelay then return end
    if now - S.lastAttack > 2 then S.attackNumber = 0 end
    local attacks = data and data.BasicAttacks
    local custom = data and not attacks and data.CustomBasicAttack
    local payload = { hrpCFrame = root.CFrame }
    local delay = 0.35
    local number
    if custom then
        local maxCombo = math.max(1, tonumber(data.CustomBasicAttackMaxCombo) or 1)
        number = S.attackNumber % maxCombo + 1
        payload.combo = number
        delay = tonumber(data.CustomBasicAttackDelay) or delay
    else
        local total = type(attacks) == "table" and #attacks or 1
        total = math.max(total, 1)
        number = S.attackNumber % total + 1
        payload.attackNumber = number
        local attackDef = type(attacks) == "table" and attacks[number]
        delay = attackDef and tonumber(attackDef.timeBetweenAttack) or delay
    end
    local ok, err = pcall(remote.FireServer, remote, "UseSkill", payload, "BasicAttack")
    if not ok then warnOnce(err); return end
    S.lastAttack = now
    S.attackDelay = math.max(0.06, delay)
    S.attackNumber = number
end

-- Each ability has its OWN cooldown watch. Never cycle with a shared cursor.
-- ClientSkillModule.returnCooldown is the native per-key cooldown counter.
-- Native client cooldowns take priority; otherwise use a short guarded retry.
local function skillReady(client, key, now, def, isAssist)
    if def and def.skillDisplayName == "None" then return false end
    local sentAt = S.lastSkills[key] or -HUGE
    if client and type(client.returnCooldown) == "function" then
        local ok, remaining = pcall(client.returnCooldown, key)
        if ok and type(remaining) == "number" then
            if remaining > 0.02 then
                S.cooldownSeen[key] = true
                return false
            end
            -- A *real* positive -> zero transition means the game has
            -- announced the ability is ready. No round-robin wait here.
            if S.cooldownSeen[key] then return true end
        end
    end
    -- Direct remote use may not update local timers. If no reliable client
    -- cooldown is exposed, retry sooner without claiming the cast succeeded.
    return now - sentAt >= SKILL_GAP
end

local assistDefCache, assistDefAt = {}, -math.huge
local function assistSkillDefinition(num)
    local now = os.clock()
    if now - assistDefAt < 0.2 then return assistDefCache[num] end
    assistDefAt = now
    local settings = getSettings()
    local stats = ReplicatedStorage:FindFirstChild(player.Name .. "StatDisplay")
    local nextDefs = {}
    for i = 1, 2 do
        local field = stats and stats:FindFirstChild("AssistCharacterName"..i)
        local name = field and field.Value
        local info = type(name) == "string" and settings and settings.CharacterSettings
            and settings.CharacterSettings[name]
        local skill = info and info.AssistSkill and info.AssistSkill[1]
        if skill and skill.skillDisplayName ~= "None" then nextDefs[i] = skill end
    end
    assistDefCache = nextDefs
    return assistDefCache[num]
end

local assistVisibleCache, assistVisibleAt = {}, -math.huge
local function assistVisible(num)
    local now = os.clock()
    if now - assistVisibleAt < 0.2 then return assistVisibleCache[num] == true end
    assistVisibleAt = now
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local modules = gui and gui:FindFirstChild("Modules")
    local module = modules and modules:FindFirstChild("ClientDirectory")
    if not module then return false end
    local ok, clientDir = pcall(require, module)
    if not ok or type(clientDir) ~= "table" then return false end
    local frame = clientDir.UniversalCenterUIFrame
    for i = 1,2 do
        -- ClientDirectory's UniversalCenterUIFrame is a dictionary, NOT an Instance.
        local slot = type(frame) == "table" and frame["SkillAssist"..i] or nil
        assistVisibleCache[i] = slot ~= nil and slot:IsA("GuiObject") and slot.Visible == true or false
    end
    return assistVisibleCache[num] == true
end

-- Z invokes UseFruitSkill(1), as confirmed in ClientSkillModule.
-- Read the equipped fruit from the GAME'S replicated stats and definition;
-- checking a ClientDirectory UI element is unreliable and caused Z to be skipped.
-- In particular UniversalCenterUIFrame is a flattened *table*, not a GUI Instance.
local fruitDefinitionCache, fruitDefinitionName, fruitDefinitionAt = nil, nil, -math.huge
local function equippedFruitSkill1()
    local now = os.clock()
    local display = ReplicatedStorage:FindFirstChild(player.Name .. "StatDisplay")
    local fruitObject = display and display:FindFirstChild("EquippedFruitName")
    local fruitName = fruitObject and fruitObject.Value
    if type(fruitName) ~= "string" or fruitName == "" or fruitName == "None" then
        return false, nil
    end
    if fruitDefinitionName ~= fruitName or now - fruitDefinitionAt >= 0.25 then
        local settings = getSettings()
        local entry = settings and settings.FruitInfo and settings.FruitInfo[fruitName]
        fruitDefinitionCache = entry and entry.SkillInfo and entry.SkillInfo.Skill1 or nil
        fruitDefinitionName = fruitName
        fruitDefinitionAt = now
    end
    local def = fruitDefinitionCache
    if type(def) ~= "table" or def.skillDisplayName == "None" then
        return false, nil
    end
    return true, def
end

local function fireSkills(root, target, now)
    if not remote or not validTarget(target) then return end
    if effectiveDistance(target, root.Position) > SKILL_RANGE then return end
    local client = getSkillModule()
    if client and type(client.returnSkillIsInUse) == "function" then
        local ok, busy = pcall(client.returnSkillIsInUse)
        if ok and busy == true then return end
    end
    local charInfo = characterData()
    -- Check every chosen ability on each Heartbeat. No shared skill rotation.
    -- Character skills 1-4, E/R assists, and Z (equipped fruit skill 1).
    for action = 1, 7 do
        local isAssist = action == 5 or action == 6
        local isFruit = action == 7
        local assistNum = action - 4
        local key = isFruit and "Fruit1" or (isAssist and ("Assist"..assistNum) or action)
        local chosen = isFruit and S.selectedFruits[1]
            or (isAssist and S.selectedAssists[assistNum] or S.selectedSkills[action])
        local def
        local available = true
        if isFruit then
            available, def = equippedFruitSkill1()
        elseif isAssist then
            def = assistSkillDefinition(assistNum)
            available = def ~= nil or assistVisible(assistNum)
        else
            def = charInfo and charInfo.Skills and charInfo.Skills[action]
        end
        if chosen and available and skillReady(client, key, now, def, isAssist) then
            local command = isFruit and "UseFruitSkill" or (isAssist and "UseAssistSkill" or "UseSkill")
            local number = isFruit and 1 or (isAssist and assistNum or action)
            local ok, err = pcall(remote.FireServer, remote, command,
                { hrpCFrame = root.CFrame }, number)
            if not ok then
                warnOnce(err)
            else
                S.lastSkills[key] = now
                S.cooldownSeen[key] = false
                -- One cast per frame; all independent ready checks resume next frame.
                return
            end
        end
    end
end

local function resetTarget()
    setTarget(nil)
    S.lastTargetScan = -HUGE
    S.noTargetSince = nil
    S.safeAlternate = nil
end

-- ================================================================
-- SETTINGS: Anti-AFK / reconnect / GitHub Auto Execute
-- ================================================================
-- The native Idled event fires after ~2 minutes and repeatedly thereafter,
-- but some executor environments miss idle events. Use an infrequent periodic
-- fallback as well. Only VirtualUser input (not mouse targeting or camera aim).
local function antiAfkPulse()
    if not (S.alive and S.antiAfk) then return end
    local now=os.clock()
    if now - (S.antiAfkLastPulse or 0) < 65 then return end
    S.antiAfkLastPulse=now
    task.spawn(function()
        local ok, err=pcall(function()
            VirtualUser:CaptureController()
            local camera = Workspace.CurrentCamera
            local cameraCF = camera and camera.CFrame or CFrame.new()
            VirtualUser:Button2Down(Vector2.new(0,0),cameraCF)
            task.wait(0.12)
            VirtualUser:Button2Up(Vector2.new(0,0),cameraCF)
        end)
        if not ok and not S.antiAfkFailureReported then
            S.antiAfkFailureReported=true
            warnOnce("Anti-AFK simulated input unavailable in this executor: "..tostring(err))
        end
    end)
end
local idleOk,idleConn=pcall(function()
    return player.Idled:Connect(antiAfkPulse)
end)
if idleOk and idleConn then S.connections[#S.connections+1]=idleConn end
-- Backup pulse every seven minutes, not every frame and not during startup.
