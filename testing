                    local mastery=info.ID:lower():find("mastery",1,true)~=nil
                    local score=(E.NenSkillFocus=="Mastery First" and (mastery and 100 or 0))
                        or (E.NenSkillFocus=="Attack First" and (mastery and 0 or 100)) or 50
                    table.insert(available,{Group=group,Branch=branch,Index=i,Info=info,Score=score-i})
                end
            end
        end
    end
    local skills=ReplicatedStorage:FindFirstChild("SecondaryShared")
    skills=skills and skills:FindFirstChild("NenSkills")
    local canRead,definitions=pcall(function() return skills and require(skills) end)
    if canRead and type(definitions)=="table" then
        for branch,list in pairs(definitions) do
            if type(list)=="table" and type(branch)=="string" then consider("NenSkills",branch) end
        end
    end
    table.sort(available,function(a,b) return a.Score>b.Score end)
    local target=available[1]
    if not target then E.NenStatus="No confirmed unlockable skills";return end
    E.NenStatus="Unlocking "..target.Info.ID
    self:StartJob("v44_skill",nil,function(alive)
        if not E.AutoNenSkills or not alive() then return end
        local sent,reply=pcall(function() return service:unlock(target.Group,target.Index,target.Branch) end)
        local good,result=false,nil
        if sent then good,result=self:AwaitReply(reply,alive,5) end
        if not alive() then return end
        local confirmed=good and result~=false and self:WaitConfirmed(function()
            return tree:IsSkillUnlocked(target.Group,target.Index,target.Branch)==true
        end,alive,2)
        if confirmed then E.Stats.SkillUnlocks+=1;E.NenStatus="Unlocked "..target.Info.ID
        else E.NenStatus="Skill not confirmed: "..target.Info.ID end
        E.SkillAt=os.clock()+(confirmed and 1 or 10)
    end)
end
function Hub:V44MeditationInit()
    local E=self.V44
    if E.MeditationBound then return end
    local service=self:V44Service("MeditationService")
    if not service then return end
    E.MeditationBound=true
    local function listen(signal,callback)
        if signal then
            local ok,conn=pcall(function() return signal:Connect(callback) end)
            if ok and conn then table.insert(self.Connections,conn) end
        end
    end
    listen(service.KeyPrompt,function(id,window)
        if not self.Running or not E.AutoMeditate then return end
        -- The game enforces a minimum reaction window; never send a duplicate instantly.
        task.delay(.27,function()
            if not self.Running or not E.AutoMeditate then return end
            pcall(function() service:KeyPromptResult(id,true) end)
            E.NenStatus="Meditation key prompt"
        end)
    end)
    listen(service.GamePrompt,function(id,kind,data)
        if not self.Running or not E.AutoMeditate then return end
        if kind=="Circles" then
            task.delay(.35,function()
                if E.AutoMeditate then pcall(function() service:KeyPromptResult(id,true) end) end
            end)
        elseif kind=="Reel" or kind=="Charge" then
            E.NenStatus="Meditation "..kind.." (timing observation)"
            -- GameInput is an event, not a promise. A short hold is an honest first-pass
            -- attempt; game-side target windows still decide if it counts.
            pcall(function() service.GameInput:Fire(id,true) end)
            task.delay(kind=="Charge" and .72 or .9,function()
                if E.AutoMeditate then pcall(function() service.GameInput:Fire(id,false) end) end
            end)
        end
    end)
end
function Hub:V44MeditationTick(now)
    local E=self.V44
    if not E.AutoMeditate or now<(E.MeditateAt or 0) then return end
    E.MeditateAt=now+3
    if LocalPlayer:GetAttribute("NenUnlocked")~=true then E.NenStatus="Unlock Nen first";return end
    self:V44MeditationInit()
    local char,root=myCharacter()
    if not root then return end
    if char:GetAttribute("meditating")==true then E.NenStatus="Meditating";return end
    local service=self:V44Service("MeditationService")
    if not service then E.NenStatus="MeditationService unavailable";return end
    -- Never reserve movement before verifying that combat does not own it.
    -- v54 reserved the meditation slot even when farming was active, which
    -- made Auto Farm appear enabled but idle.
    if not self:V44CanWork() then
        E.NenStatus="Waiting for Auto Farm / Auto Quest to finish"
        return
    end
    if not self:V44Activity("Meditation",3) then return end
    local folder=workspace:FindFirstChild("MeditationParts")
    local mat=folder and folder:FindFirstChild(LocalPlayer.Name)
    if not mat then
        if not self:V44CanWork() and self.AutoFarm then E.NenStatus="Pause regular farming to place mat";return end
        local pos=root.Position
        local success=pcall(function() service:PlaceCarpet(pos) end)
        E.NenStatus=success and "Placing meditation mat" or "Mat placement rejected"
        return
    end
    if mat:IsA("BasePart") and (root.Position-mat.Position).Magnitude>4 then
        if not self:V44CanWork() then E.NenStatus="Waiting to approach mat";return end
        char:PivotTo(CFrame.new(mat.Position+Vector3.new(0,2.5,0)))
        E.NenStatus="Approaching mat";return
    end
    -- Wait for server to confirm placement before requesting meditation.
    if mat:GetAttribute("placed")~=true then E.NenStatus="Waiting for mat registration";return end
    E.NenStatus="Starting meditation"
    self:StartJob("v44_meditation",nil,function(alive)
        if not E.AutoMeditate or not alive() then return end
        local sent,reply=pcall(function() return service:StartMeditation() end)
        local accepted,result=false,nil
        if sent then accepted,result=self:AwaitReply(reply,alive,5) end
        if alive() then E.NenStatus=accepted and result~=false and "Meditation started" or "Meditation start unconfirmed" end
    end)
end
function Hub:V66HudSkill(key)
    local E=self.V44
    local now=os.clock()
    if E.HudSkillCache and now<(E.HudSkillAt or 0) then
        return E.HudSkillCache[key]
    end
    E.HudSkillCache={}
    E.HudSkillAt=now+0.8
    local pg=LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    -- Updated SkillsController clones SkillButtonTemplate into Main.SkillButtons.
    -- Its button Name is the exact SkillsService skill ID; KeyText is its
    -- current mapped key. Don't infer an ID from the displayed weapon name.
    local main=pg:FindFirstChild("Main")
    local buttons=pg:FindFirstChild("SkillButtons") or (main and main:FindFirstChild("SkillButtons"))
    if buttons then
        for _,button in ipairs(buttons:GetChildren()) do
            if button:IsA("GuiObject") and button.Visible
                and button:GetAttribute("Locked")~=true then
                local label=button:FindFirstChild("KeyText")
                local code=label and label:IsA("TextLabel")
                    and label.Text:upper():gsub("[^A-Z]","") or ""
                if ({Z=true,X=true,C=true,V=true,B=true})[code] then
                    E.HudSkillCache[code]=button.Name
                end
            end
        end
    end
    for _,node in ipairs(pg:GetDescendants()) do
        if node:IsA("GuiObject") and node.Visible
            and not node:IsA("TextLabel") and not node:IsA("TextButton") then
            local attr=node:GetAttribute("Keybind") or node:GetAttribute("Key")
                or node:GetAttribute("Slot")
            local bound=(typeof(attr)=="EnumItem" and attr.Name) or tostring(attr or "")
            local label=node:FindFirstChild("KeyText") or node:FindFirstChild("KeyLabel")
                or node:FindFirstChild("Key")
            if label and label:IsA("TextLabel") then bound=label.Text end
            bound=bound:upper():gsub("[^A-Z]","")
            local skillName=node:GetAttribute("SkillName") or node:GetAttribute("AbilityName")
            local nm=tostring(skillName or node.Name)
            if ({Z=true,X=true,C=true,V=true,B=true})[bound]
                and not E.HudSkillCache[bound]
                and nm~="" and nm~="SkillButtons" and nm~="Main"
                and nm~="Key" and nm~="KeyText"
                and not nm:lower():find("slot",1,true) then
                E.HudSkillCache[bound]=nm
            end
        end
    end
    -- Some updated hotbars put the key and skill name in sibling labels.
    for _,node in ipairs(pg:GetDescendants()) do
        if (node:IsA("TextLabel") or node:IsA("TextButton")) and node.Visible then
            local keyText=tostring(node.Text or ""):upper():gsub("[^A-Z]","")
            if ({Z=true,X=true,C=true,V=true,B=true})[keyText]
                and not E.HudSkillCache[keyText] then
                local parent=node.Parent
                for _=1,3 do
                    if not parent or not parent:IsA("GuiObject") then break end
                    local found=nil
                    for _,candidate in ipairs(parent:GetDescendants()) do
                        if candidate~=node and candidate:IsA("TextLabel") and candidate.Visible then
                            local value=tostring(candidate.Text or "")
                            if #value>=4 and #value<=35 and not value:match("^%d")
                                and not value:lower():find("cooldown",1,true) then
                                found=value;break
                            end
                        end
                    end
                    if found then E.HudSkillCache[keyText]=found;break end
                    parent=parent.Parent
                end
            end
        end
    end
    return E.HudSkillCache[key]
end
