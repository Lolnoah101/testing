--//============================================================
--// RUBBLE
--//============================================================

local function GetRubbleForArea(
    AreaNumber
)

    if not AreaNumber
        or AreaNumber < 1
    then

        return nil
    end


    local Map =
        GetCurrentMapConfig()


    if not Map
        or not Map.areas
    then

        return nil
    end


    local AreaConfig =
        Map.areas[
            AreaNumber
        ]


    if not AreaConfig
        or not AreaConfig.border
    then

        return nil
    end


    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    local WorldMap =
        World
        and World
            :FindFirstChild(
                "Map"
            )


    if not WorldMap then
        return nil
    end


    local Border =
        WorldMap
            :FindFirstChild(
                AreaConfig.border
            )


    if not Border then
        return nil
    end


    local Rubble =
        Border
            :FindFirstChild(
                "Rubble"
            )


    local Blocker =
        Border
            :FindFirstChild(
                "Blocker"
            )


    local RubbleBar =
        Blocker
        and Blocker
            :FindFirstChild(
                "RubbleBar"
            )


    local MaxHealth =
        Border:GetAttribute(
            "RubbleMaxHealth"
        )


    local Health = nil


    if MaxHealth ~= nil then

        Health =
            Border:GetAttribute(
                "RubbleHealth"
            )


        if Health == nil then
            Health = MaxHealth
        end
    end


    return {

        Area =
            AreaNumber,

        Border =
            Border,

        Rubble =
            Rubble,

        Blocker =
            Blocker,

        RubbleBar =
            RubbleBar,

        Health =
            Health,

        MaxHealth =
            MaxHealth,
    }
end


--//============================================================
--// RUBBLE Y
--//============================================================

local function GetRubbleY(Rubble)

    if not Rubble
        or not Rubble.Parent
    then

        return nil
    end


    if Rubble:IsA(
        "BasePart"
    )
    then

        return Rubble.Position.Y
    end


    if Rubble:IsA(
        "Model"
    )
    then

        return Rubble
            :GetPivot()
            .Position
            .Y
    end


    local Part =
        Rubble
            :FindFirstChildWhichIsA(
                "BasePart",
                true
            )


    if Part then
        return Part.Position.Y
    end


    return nil
end


local function RecordRubbleHeight(Info)

    if not Info
        or not Info.Rubble
    then

        return
    end


    if RubbleInitialY[
        Info.Area
    ] == nil
    then

        local Y =
            GetRubbleY(
                Info.Rubble
            )


        if Y then

            RubbleInitialY[
                Info.Area
            ] = Y
        end
    end
end


--//============================================================
--// RUBBLE OPEN
--//============================================================

local function IsRubblePhysicallyOpen(
    PreviousArea
)

    local Info =
        GetRubbleForArea(
            PreviousArea
        )


    local StartTime =
        RubbleBreakTime[
            PreviousArea
        ]


    if not StartTime then

        RubbleBreakTime[
            PreviousArea
        ] = os.clock()


        StartTime =
            RubbleBreakTime[
                PreviousArea
            ]
    end


    local Elapsed =
        os.clock()
        - StartTime


    if Elapsed < RUBBLE_MIN_WAIT then
        return false
    end


    if not Info then
        return true
    end


    if Info.Blocker
        and Info.Blocker:IsA(
            "BasePart"
        )
        and Info.Blocker.CanCollide
            == false
    then

        return true
    end


    if not Info.Rubble
        or not Info.Rubble.Parent
    then

        return true
    end


    local InitialY =
        RubbleInitialY[
            PreviousArea
        ]


    local CurrentY =
        GetRubbleY(
            Info.Rubble
        )


    if InitialY
        and CurrentY
    then

        if (
            InitialY
            - CurrentY
        ) >= RUBBLE_DROP_DISTANCE
        then

            return true
        end
    end


    if Elapsed >= RUBBLE_MAX_WAIT then
        return true
    end


    return false
end


--//============================================================
--// RUBBLE FARM POSITION
--//============================================================

local function GetRubbleFarmCFrame(Info)

    if not Info then
        return nil
    end


    local Root =
        GetRoot()


    if not Root then
        return nil
    end


    local TargetPosition = nil


    if Info.RubbleBar
        and Info.RubbleBar:IsA(
            "Attachment"
        )
    then

        local Position =
            Info.RubbleBar.WorldPosition


        TargetPosition =
            Vector3.new(
                Position.X,
                Root.Position.Y,
                Position.Z
            )
    end


    if not TargetPosition
        and Info.Blocker
    then

        local Look =
            Info.Blocker.CFrame.LookVector


        local Flat =
            Vector3.new(
                Look.X,
                0,
                Look.Z
            )


        if Flat.Magnitude < 0.01 then

            Flat =
                Vector3.new(
                    0,
                    0,
                    1
                )

        else

            Flat =
                Flat.Unit
        end


        TargetPosition =
            Info.Blocker.Position
            + Flat * 8


        TargetPosition =
            Vector3.new(
                TargetPosition.X,
                Root.Position.Y,
                TargetPosition.Z
            )
    end


    if not TargetPosition then
        return nil
    end


    local LookAt =
        Info.Blocker
        and Info.Blocker.Position
        or TargetPosition
            + Vector3.new(
                0,
                0,
                -1
            )


    LookAt =
        Vector3.new(
            LookAt.X,
            Root.Position.Y,
            LookAt.Z
        )


    return CFrame.lookAt(
        TargetPosition,
        LookAt,
        Vector3.yAxis
    )
end


--//============================================================
--// AREA PART
--//============================================================

local function GetAreaPart(AreaNumber)

    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    if not World then
        return nil
    end


    local Areas =
        World
            :FindFirstChild(
                "Areas"
            )


    if not Areas then
        return nil
    end


    local Area =
        Areas
            :FindFirstChild(
                tostring(
                    AreaNumber
                )
            )


    if Area
        and Area:IsA(
            "BasePart"
        )
    then

        return Area
    end


    return nil
end


--//============================================================
--// GROUNDED AREA TARGET
--//
--// Area volumes are tall (their center Y is not the floor). If the
--// character gets shoved under a ramp/floor, reusing Root.Position.Y
--// keeps recovery targets underground. Raycast the map at the target X/Z
--// and place the recovery target just above the real surface instead.
--//============================================================

GENV.__AZ_FARM_EXT.GetGroundedAreaCFrame = function(
    AreaNumber,
    TargetCF
)

    if not TargetCF then
        return nil
    end


    local Area =
        GetAreaPart(
            AreaNumber
        )


    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    local Map =
        World
        and World
            :FindFirstChild(
                "Map"
            )


    if not Area
        or not Map
    then

        return TargetCF
    end


    local Params =
        RaycastParams.new()


    Params.FilterType =
        Enum.RaycastFilterType.Include


    Params.FilterDescendantsInstances = {
        Map,
    }


    Params.IgnoreWater =
        true


    local Origin =
        Vector3.new(
            TargetCF.Position.X,
            Area.Position.Y,
            TargetCF.Position.Z
        )


    local Result =
        workspace:Raycast(
            Origin,
            Vector3.new(
                0,
                -(math.max(
                    Area.Size.Y,
                    80
                ) + 80),
                0
            ),
            Params
        )


    if not Result then
        return TargetCF
    end


    local SafePosition =
        Result.Position
        + Vector3.new(
            0,
            3.5,
            0
        )


    local LookAt =
        Vector3.new(
            Area.Position.X,
            SafePosition.Y,
            Area.Position.Z
        )


    if (
        LookAt
        - SafePosition
    ).Magnitude < 0.01
    then

        LookAt =
            SafePosition
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        SafePosition,
        LookAt,
        Vector3.yAxis
    )
end


--//============================================================
--// INSIDE AREA
--//============================================================

local function IsPlayerInsideArea(
    AreaNumber
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return false
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    return math.abs(Relative.X)
            <= Half.X
                + AREA_INSIDE_TOLERANCE

        and math.abs(Relative.Y)
            <= Half.Y
                + AREA_INSIDE_TOLERANCE

        and math.abs(Relative.Z)
            <= Half.Z
                + AREA_INSIDE_TOLERANCE
end


--//============================================================
--// AREA ENTRY
--//============================================================

local function ComputeAreaEntryCFrame(
    AreaNumber,
    Depth
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return nil
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            Depth,
            math.max(
                Half.X - 2,
                2
            )
        )


    local ZInset =
        math.min(
            Depth,
            math.max(
                Half.Z - 2,
                2
            )
        )


    local YInset =
        math.min(
            3,
            math.max(
                Half.Y - 1,
                1
            )
        )


    local LocalTarget =
        Vector3.new(

            math.clamp(
                Relative.X,
                -Half.X + XInset,
                Half.X - XInset
            ),

            math.clamp(
                Relative.Y,
                -Half.Y + YInset,
                Half.Y - YInset
            ),

            math.clamp(
                Relative.Z,
                -Half.Z + ZInset,
                Half.Z - ZInset
            )
        )


    local WorldTarget =
        Area.CFrame
            :PointToWorldSpace(
                LocalTarget
            )


    local LookPosition =
        Vector3.new(
            Area.Position.X,
            WorldTarget.Y,
            Area.Position.Z
        )


    if (
        LookPosition
        - WorldTarget
    ).Magnitude < 0.01
    then

        LookPosition =
            WorldTarget
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        WorldTarget,
        LookPosition,
        Vector3.yAxis
    )
end


--//============================================================
--// BOUNDS
--//============================================================

local function GetInstanceBounds(Object)

    if not Object
        or not Object.Parent
    then

        return nil, nil
    end


    if Object:IsA(
        "BasePart"
    )
    then

        return Object.CFrame,
            Object.Size
    end


    if Object:IsA(
        "Model"
    )
    then

        local Success,
            BoundingCF,
            BoundingSize =
            pcall(function()

                return Object:GetBoundingBox()
            end)


        if Success then

            return BoundingCF,
                BoundingSize
        end
    end


    local FirstPart =
        Object
            :FindFirstChildWhichIsA(
                "BasePart",
                true
            )


    if FirstPart then

        return FirstPart.CFrame,
            FirstPart.Size
    end


    return nil, nil
end


--//============================================================
--// CLAMP POINT
--//============================================================

local function ClampPointInsideArea(
    Area,
    WorldPosition,
    Inset
)

    local LocalPosition =
        Area.CFrame
            :PointToObjectSpace(
                WorldPosition
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            Inset,
            math.max(
                Half.X - 1,
                1
            )
        )


    local ZInset =
        math.min(
            Inset,
            math.max(
                Half.Z - 1,
                1
            )
        )


    local YInset =
        math.min(
            3,
            math.max(
                Half.Y - 1,
                1
            )
        )


    local LocalTarget =
        Vector3.new(

            math.clamp(
                LocalPosition.X,
                -Half.X + XInset,
                Half.X - XInset
            ),

            math.clamp(
                LocalPosition.Y,
                -Half.Y + YInset,
                Half.Y - YInset
            ),

            math.clamp(
                LocalPosition.Z,
                -Half.Z + ZInset,
                Half.Z - ZInset
            )
        )


    return Area.CFrame
        :PointToWorldSpace(
            LocalTarget
        )
end


--//============================================================
--// AREA 5
--//============================================================

local function ComputeArea5SafeEntryCFrame()

    local Root =
        GetRoot()


    local Area5 =
        GetAreaPart(
            5
        )


    if not Root
        or not Area5
    then

        return nil
    end


    local Border4 =
        GetRubbleForArea(
            4
        )


    if Border4
        and Border4.Rubble
        and Border4.Rubble.Parent
    then

        local RubbleCF,
            RubbleSize =
            GetInstanceBounds(
                Border4.Rubble
            )


        if RubbleCF
            and RubbleSize
        then

            local Direction =
                Area5.Position
                - RubbleCF.Position


            Direction =
                Vector3.new(
                    Direction.X,
                    0,
                    Direction.Z
                )


            if Direction.Magnitude > 0.01 then

                Direction =
                    Direction.Unit


                local Extent =
                    math.abs(
                        Direction:Dot(
                            RubbleCF.RightVector
                        )
                    )
                    * (RubbleSize.X / 2)

                    + math.abs(
                        Direction:Dot(
                            RubbleCF.UpVector
                        )
                    )
                    * (RubbleSize.Y / 2)

                    + math.abs(
                        Direction:Dot(
                            RubbleCF.LookVector
                        )
                    )
                    * (RubbleSize.Z / 2)


                local SafePosition =
                    RubbleCF.Position

                    + Direction
                    * (
                        Extent
                        + AREA5_RUBBLE_CLEARANCE
                    )


                SafePosition =
                    Vector3.new(
                        SafePosition.X,
                        Root.Position.Y,
                        SafePosition.Z
                    )


                SafePosition =
                    ClampPointInsideArea(
                        Area5,
                        SafePosition,
                        AREA5_VOLUME_INSET
                    )


                return CFrame.lookAt(
                    SafePosition,
                    SafePosition + Direction,
                    Vector3.yAxis
                )
            end
        end
    end


    return ComputeAreaEntryCFrame(
        5,
        AREA5_FALLBACK_DEPTH
    )
end


--//============================================================
--// LOCK ENTRY
--//============================================================

local function GetLockedAreaEntryCFrame(
    AreaNumber
)

    if LockedAreaEntryNumber == AreaNumber
        and LockedAreaEntryCFrame
        and LockedAreaEntryMethod == Settings.FarmMethod
    then

        return LockedAreaEntryCFrame
    end


    local Target


    if AreaNumber == 5 then

        Target =
            ComputeArea5SafeEntryCFrame()

    else

        local Depth


        if Settings.FarmMethod == "Tween" then

            Depth =
                TWEEN_AREA_ENTRY_DEPTH

        else

            Depth =
                TELEPORT_AREA_ENTRY_DEPTH
        end


        Target =
            ComputeAreaEntryCFrame(
                AreaNumber,
                Depth
            )
    end


    if Target then

        Target =
            GENV.__AZ_FARM_EXT.GetGroundedAreaCFrame(
                AreaNumber,
                Target
            )


        LockedAreaEntryNumber =
            AreaNumber


        LockedAreaEntryCFrame =
            Target


        LockedAreaEntryMethod =
            Settings.FarmMethod
    end


    return Target
end


--//============================================================
--// ENTRY COMPLETE
--//============================================================

local function DistanceToLockedAreaTarget()

    local Root =
        GetRoot()


    if not Root
        or not LockedAreaEntryCFrame
    then

        return math.huge
    end


    return (
        Root.Position
        - LockedAreaEntryCFrame.Position
    ).Magnitude
end


local function HasCompletedAreaEntry(
    AreaNumber
)

    if not IsPlayerInsideArea(
        AreaNumber
    )
    then

        return false
    end


    if not LockedAreaEntryCFrame then
        return false
    end


    local RequiredDistance


    if Settings.FarmMethod == "Tween" then

        RequiredDistance =
            TWEEN_AREA_CONFIRM_DISTANCE

    else

        RequiredDistance =
            TELEPORT_AREA_CONFIRM_DISTANCE
    end


    return DistanceToLockedAreaTarget()
        <= RequiredDistance
end


--//============================================================
--// WAVE RECOVERY POSITION
--//============================================================

local function ComputeWaveRecoveryCFrame(
    AreaNumber,
    Attempt
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return nil
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            WAVE_RECOVERY_EDGE_INSET,
            math.max(
                Half.X - 2,
                2
            )
        )


    local ZInset =
        math.min(
            WAVE_RECOVERY_EDGE_INSET,
            math.max(
                Half.Z - 2,
                2
            )
        )


    local TargetX
    local TargetZ


    if Attempt <= 1 then

        local Planar =
            Vector3.new(
                Relative.X,
                0,
                Relative.Z
            )


        if Planar.Magnitude > 0.01 then

            local Candidate =
                Relative
                - Planar.Unit
                * WAVE_RECOVERY_NUDGE


            TargetX =
                Candidate.X


            TargetZ =
                Candidate.Z

        else

            TargetX = 0
            TargetZ = 0
        end


    else

        local Patterns = {

            { 0, 0 },

            { 0.30, 0 },

            { -0.30, 0 },

            { 0, 0.30 },

            { 0, -0.30 },

            { 0.22, 0.22 },

            { -0.22, 0.22 },

            { 0.22, -0.22 },

            { -0.22, -0.22 },
        }


        local Pattern =
            Patterns[
                (
                    (Attempt - 2)
                    % #Patterns
                ) + 1
            ]


        TargetX =
            Pattern[1]
            * math.max(
                Half.X - XInset,
                0
            )


        TargetZ =
            Pattern[2]
            * math.max(
                Half.Z - ZInset,
                0
            )
    end


    TargetX =
        math.clamp(
            TargetX,
            -Half.X + XInset,
            Half.X - XInset
        )


    TargetZ =
        math.clamp(
            TargetZ,
            -Half.Z + ZInset,
            Half.Z - ZInset
        )


    local TargetY =
        math.clamp(
            Relative.Y,
            -Half.Y + 3,
            Half.Y - 3
        )


    local WorldTarget =
        Area.CFrame
            :PointToWorldSpace(
                Vector3.new(
                    TargetX,
                    TargetY,
                    TargetZ
                )
            )


    local LookAt =
        Vector3.new(
            Area.Position.X,
            WorldTarget.Y,
            Area.Position.Z
        )


    if (
        LookAt
        - WorldTarget
    ).Magnitude < 0.01
    then

        LookAt =
            WorldTarget
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        WorldTarget,
        LookAt,
        Vector3.yAxis
    )
end


--//============================================================
--// GENERAL FARM STILLNESS RECOVERY
--//
--// If the server says enemies remain but enemyStore has no living enemy
--// and the character has not moved for the configured delay, hard-snap to
--// a grounded point farther inside the current area. This handles the
--// Area 5 edge/under-map stall shown in the user's screenshot.
--//============================================================

GENV.__AZ_FARM_EXT.RunStillnessRecovery = function()

    local Ext = GENV.__AZ_FARM_EXT


    if not Settings.AutoFarm
        or not IsAlive()
    then

        Ext.ResetStillness()
        return false
    end


    local Root = GetRoot()

    local Area =
        tonumber(
            GetRunValue(
                "area"
            )
        )

    local Remaining =
        tonumber(
            GetRunValue(
                "remaining"
            )
        )

    local FinishedAt =
        GetRunValue(
            "finishedAt"
        )


    if not Root
        or not Area
        or FinishedAt ~= nil
    then

        Ext.ResetStillness()
        return false
    end


    local LivingEnemies =
        GetLivingEnemyCount()


    -- Only force a relocation when the run still expects enemies but the
    -- replicated enemy store has nothing for Auto Farm to target.
    if not Remaining
        or Remaining <= 0
        or LivingEnemies > 0
    then

        Ext.StillPosition = Root.Position
        Ext.StillSince = os.clock()
        Ext.StillRecoveryArea = Area
        Ext.StillRecoveryAttempt = 0

        return false
    end


    local Now = os.clock()


    if Ext.StillRecoveryArea ~= Area then

        Ext.ResetStillness()

        Ext.StillRecoveryArea = Area
        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    if not Ext.StillPosition then

        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    if (
        Root.Position
        - Ext.StillPosition
    ).Magnitude >= 2.25
    then

        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    local Delay =
        math.clamp(
            tonumber(
                Settings.StuckRecoveryDelay
            ) or 2.5,
            1,
            6
        )


    if (
        Now
        - (Ext.StillSince or Now)
    ) < Delay
    then

        return false
    end


    if (
        Now
        - (Ext.LastStillRecoveryAt or 0)
    ) < 1.25
    then

        return false
    end


    Ext.StillRecoveryAttempt =
        (Ext.StillRecoveryAttempt or 0) + 1


    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            Area,
            Ext.StillRecoveryAttempt
        )


    if not RecoveryCF then
        return false
    end


    RecoveryCF =
        Ext.GetGroundedAreaCFrame(
            Area,
            RecoveryCF
        )


    if not RecoveryCF then
        return false
    end


    CurrentTargetId = nil
    CurrentTargetState = nil
    CurrentRubbleInfo = nil
    CurrentRubbleCFrame = nil
    TargetAreaNumber = nil


    DesiredFarmCFrame =
        RecoveryCF


    Root.CFrame =
        RecoveryCF


    Root.AssemblyLinearVelocity =
        Vector3.zero


    Root.AssemblyAngularVelocity =
        Vector3.zero


    Ext.LastStillRecoveryAt =
        Now

    Ext.StillPosition =
        RecoveryCF.Position

    Ext.StillSince =
        Now


    SetFarmMode(
        "Stuck Recovery"
    )


    print(
        "[Anime Zero] Farm stillness recovery | Area:",
        Area,
        "| Remaining:",
        Remaining,
        "| Attempt:",
        Ext.StillRecoveryAttempt
    )


    return true
end


--//============================================================
--// AREA ENTRY RECOVERY
--//============================================================

GENV.__AZ_FARM_EXT.HandleAreaEntryRecovery = function(
    AreaNumber
)

    if not AreaNumber then
        return nil
    end


    local Ext =
        GENV.__AZ_FARM_EXT


    local Now =
        os.clock()


    if Ext.AreaEntryRecoveryArea
        ~= AreaNumber
    then

        Ext.ResetAreaEntryRecovery()

        Ext.AreaEntryRecoveryArea =
            AreaNumber

        Ext.AreaEntryStartedAt =
            Now
    end


    if not Ext.AreaEntryStartedAt then

        Ext.AreaEntryStartedAt =
            Now
    end


    if (
        Now
        - Ext.AreaEntryStartedAt
    ) < Ext.AreaEntryRecoveryDelay
    then

        return Ext.LastAreaEntryRecoveryTarget
    end



    if Ext.AreaEntryRecoveryAttempt > 0
        and (
            Now
            - Ext.LastAreaEntryRecoveryAt
        ) < Ext.AreaEntryRecoveryRetry
    then

        return Ext.LastAreaEntryRecoveryTarget
    end



    Ext.AreaEntryRecoveryAttempt =
        Ext.AreaEntryRecoveryAttempt + 1


    -- Attempt 2 in the existing recovery pattern begins at the
    -- center, then cycles through several alternate points.
    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            AreaNumber,
            Ext.AreaEntryRecoveryAttempt + 1
        )


    if not RecoveryCF then
        return Ext.LastAreaEntryRecoveryTarget
    end


    RecoveryCF =
        Ext.GetGroundedAreaCFrame(
            AreaNumber,
            RecoveryCF
        )


    Ext.LastAreaEntryRecoveryAt =
        Now


    Ext.LastAreaEntryRecoveryTarget =
        RecoveryCF


    -- Make completion checks use the new point too.
    LockedAreaEntryNumber =
        AreaNumber

    LockedAreaEntryCFrame =
        RecoveryCF

    LockedAreaEntryMethod =
        Settings.FarmMethod


    return RecoveryCF
end


--//============================================================
--// BETWEEN WAVES
--//============================================================

local function IsBetweenWaves()

    local Wave =
        GetRunValue(
            "wave"
        )


    local WaveCount =
        GetRunValue(
            "waveCount"
        )


    local Remaining =
        GetRunValue(
            "remaining"
        )


    local FinishedAt =
        GetRunValue(
            "finishedAt"
        )


    if FinishedAt ~= nil then
        return false
    end


    if Wave == nil
        or WaveCount == nil
        or Remaining == nil
    then

        return false
    end


    if Remaining ~= 0 then
        return false
    end


    if Wave == 0
        and WaveCount > 0
    then

        return true
    end


    return Wave > 0
        and Wave < WaveCount
end


--//============================================================
--// WAVE RECOVERY
--//============================================================

local function HandleWaveRecovery(
    AreaNumber
)

    if not AreaNumber then
        return false
    end


    if GetLivingEnemyCount() > 0 then

        ResetWaveRecovery()

        return false
    end


    if not IsBetweenWaves() then

        ResetWaveRecovery()

        return false
    end


    local Now =
        os.clock()


    if WaveRecoveryArea ~= AreaNumber then

        ResetWaveRecovery()

        WaveRecoveryArea =
            AreaNumber
    end


    if not WaveNoEnemySince then

        WaveNoEnemySince =
            Now
    end


    local ParticipantArea =
        GetLocalParticipantValue(
            "area"
        )


    local PhysicallyInside =
        IsPlayerInsideArea(
            AreaNumber
        )


    local CorrectArea =
        ParticipantArea == nil
        or ParticipantArea == AreaNumber


    local Delay


    if not PhysicallyInside
        or not CorrectArea
    then

        Delay =
            WAVE_OUTSIDE_RECOVERY_DELAY

    else

        Delay =
            WAVE_RECOVERY_DELAY
    end


    if (
        Now
        - WaveNoEnemySince
    ) < Delay
    then

        SetFarmMode(
            "Waiting For Wave"
        )


        DesiredFarmCFrame =
            LastWaveRecoveryTarget


        return true
    end


    if WaveRecoveryAttempt > 0
        and (
            Now
            - LastWaveRecoveryAt
        ) < WAVE_RECOVERY_RETRY
    then

        SetFarmMode(
            "Wave Recovery"
        )


        DesiredFarmCFrame =
            LastWaveRecoveryTarget


        return true
    end


    WaveRecoveryAttempt =
        WaveRecoveryAttempt + 1


    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            AreaNumber,
            WaveRecoveryAttempt
        )


    if not RecoveryCF then
        return true
    end


    LastWaveRecoveryAt =
        Now


    LastWaveRecoveryTarget =
        RecoveryCF


    DesiredFarmCFrame =
        RecoveryCF


    SetFarmMode(
        "Wave Recovery"
    )


    local Root =
        GetRoot()


    if Root then

        Root.CFrame =
            RecoveryCF
    end


    return true
end


--//============================================================
--// TELEPORT MOVEMENT
--//============================================================

local function ShouldTeleportUpdate(
    Root,
    TargetCF,
    Now
)

    if (
        Now
        - LastTeleportTime
    ) < TELEPORT_UPDATE_RATE
    then

        return false
    end


    if not LastTeleportGoal then
        return true
    end


    if (
        LastTeleportGoal.Position
        - TargetCF.Position
    ).Magnitude
        >= TELEPORT_TARGET_MOVE
    then

        return true
    end


    if (
        Root.Position
        - TargetCF.Position
    ).Magnitude
        >= TELEPORT_PLAYER_ERROR
    then

        return true
    end


    return false
end


local function ApplyTeleportEnemyFollow(
    Root,
    TargetCF,
    DeltaTime
)

    local Distance =
        (
            Root.Position
            - TargetCF.Position
        ).Magnitude


    if Distance
        >= TELEPORT_ENEMY_EMERGENCY_DISTANCE
    then

        Root.CFrame =
            TargetCF


        TeleportFollowingEnemy =
            true


        return
    end


    if not TeleportFollowingEnemy
        and Distance
            >= TELEPORT_ENEMY_SNAP_DISTANCE
    then

        Root.CFrame =
            TargetCF


        TeleportFollowingEnemy =
            true


        return
    end


    local Alpha =
        1
        - math.exp(
            -TELEPORT_ENEMY_FOLLOW_SHARPNESS
            * DeltaTime
        )


    Root.CFrame =
        Root.CFrame:Lerp(
            TargetCF,
            math.clamp(
                Alpha,
                0,
                1
            )
        )


    TeleportFollowingEnemy =
        true
end


--//============================================================
--// FARM MOVEMENT
--//============================================================

local function ApplyFarmMovement(
    DeltaTime
)

    local MovementEnabled =
        Settings.AutoFarm
        or (
            Settings.AutoPickupLoot
            and CurrentFarmMode
                == "Loot"
        )


    local UseTweenNoclip =
        MovementEnabled
        and Settings.FarmMethod
            == "Tween"
        and DesiredFarmCFrame
            ~= nil


    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(
        UseTweenNoclip
    )


    if not MovementEnabled
        or not DesiredFarmCFrame
    then

        return
    end


    local Root =
        GetRoot()


    if not Root then
        return
    end


    -- Emergency stuck recovery for area transitions. The normal selected
    -- farm method gets the first chance to move. If the character is not
    -- getting closer for 1.25s (for example, wedged under map geometry),
    -- force a CFrame snap to the grounded target and zero residual velocity.
    local IsAreaMovement =
        TargetAreaNumber
        and (
            CurrentFarmMode
                == (
                    "Entering Area "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
            or CurrentFarmMode
                == (
                    "Area Recovery "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
        )


    if IsAreaMovement then

        local Ext =
            GENV.__AZ_FARM_EXT


        local Now =
            os.clock()


        local TargetPosition =
            DesiredFarmCFrame.Position


        local Distance =
            (
                Root.Position
                - TargetPosition
            ).Magnitude


        if not Ext.AreaMoveTarget
            or (
                Ext.AreaMoveTarget
                - TargetPosition
            ).Magnitude > 2
        then

            Ext.AreaMoveTarget =
                TargetPosition

            Ext.AreaMoveBestDistance =
                Distance

            Ext.AreaMoveLastProgressAt =
                Now

        elseif Distance
            < (
                (Ext.AreaMoveBestDistance or Distance)
                - 1.25
            )
        then

            Ext.AreaMoveBestDistance =
                Distance

            Ext.AreaMoveLastProgressAt =
                Now

        elseif Distance > 3
            and (
                Now
                - (Ext.AreaMoveLastProgressAt or Now)
            ) >= 1.25
            and (
                Now
                - (Ext.LastAreaHardSnapAt or 0)
            ) >= 1.00
        then

            Root.CFrame =
                DesiredFarmCFrame


            Root.AssemblyLinearVelocity =
                Vector3.zero


            Root.AssemblyAngularVelocity =
                Vector3.zero


            Ext.LastAreaHardSnapAt =
                Now

            Ext.AreaMoveLastProgressAt =
                Now

            Ext.AreaMoveBestDistance =
                0

            Ext.AreaHardSnapCount =
                (Ext.AreaHardSnapCount or 0)
                + 1


            LastTeleportGoal =
                DesiredFarmCFrame


            LastTeleportTime =
                Now


            print(
                "[Anime Zero] Area stuck recovery hard-snap | Area:",
                TargetAreaNumber,
                "| Attempt:",
                Ext.AreaHardSnapCount
            )


            return
        end

    else

        local Ext =
            GENV.__AZ_FARM_EXT

        Ext.AreaMoveTarget = nil
        Ext.AreaMoveBestDistance = nil
        Ext.AreaMoveLastProgressAt = 0
        Ext.AreaHardSnapCount = 0
    end


    if CurrentFarmMode == "Wave Recovery"
        or CurrentFarmMode == "Waiting For Wave"
    then

        if (
            Root.Position
            - DesiredFarmCFrame.Position
        ).Magnitude > 2
        then

            Root.CFrame =
                DesiredFarmCFrame
        end


        return
    end


    if Settings.FarmMethod == "Teleport" then

        if CurrentFarmMode == "Enemy"
            and CurrentTargetId
        then

            ApplyTeleportEnemyFollow(
                Root,
                DesiredFarmCFrame,
                DeltaTime
            )


            return
        end


        TeleportFollowingEnemy =
            false


        local Now =
            os.clock()


        if ShouldTeleportUpdate(
            Root,
            DesiredFarmCFrame,
            Now
        )
        then

            Root.CFrame =
                DesiredFarmCFrame


            LastTeleportGoal =
                DesiredFarmCFrame


            LastTeleportTime =
                Now
        end


        return
    end


    TeleportFollowingEnemy =
        false


    local Distance =
        (
            Root.Position
            - DesiredFarmCFrame.Position
        ).Magnitude


    if Distance <= 0.05 then

        Root.CFrame =
            DesiredFarmCFrame


        return
    end


    local Speed =
        TWEEN_SPEED


    if TargetAreaNumber
        and (
            CurrentFarmMode
                == (
                    "Entering Area "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
            or CurrentFarmMode
                == (
                    "Area Recovery "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
        )
    then

        Speed =
            AREA_TWEEN_SPEED
    end


    local Alpha =
        math.clamp(
            (
                Speed
                * DeltaTime
            )
            / Distance,
            0,
            1
        )


    Root.CFrame =
        Root.CFrame:Lerp(
            DesiredFarmCFrame,
            Alpha
        )
end


