        Rescue.GetRaidAreaGoal = function(Root, Area)
            if not Root or not Area then
                return nil
            end

            if workspace:GetAttribute("Mode") == "fateraid" then
                return Rescue.GetFateArenaGoal(Root, Area)
            end

            -- Keep the player's current Y whenever it already falls within the
            -- area's vertical bounds. This avoids teleporting to the geometric
            -- center of a tall trigger volume high above the actual floor.
            local LocalRoot =
                Area.CFrame:PointToObjectSpace(
                    Root.Position
                )

            local HalfY =
                math.max(
                    Area.Size.Y * 0.5 - 2,
                    0
                )

            local SafeLocalY =
                math.clamp(
                    LocalRoot.Y,
                    -HalfY,
                    HalfY
                )

            return Area.CFrame
                * CFrame.new(
                    0,
                    SafeLocalY,
                    0
                )
        end


        Rescue.PointInsideRaidArea = function(Position, Area)
            if typeof(Position) ~= "Vector3"
                or not Area
                or not Area:IsA("BasePart")
            then
                return false
            end

            local LocalPosition =
                Area.CFrame:PointToObjectSpace(Position)

            local Half = Area.Size * 0.5

            return math.abs(LocalPosition.X) <= math.max(Half.X - 2, 0)
                and math.abs(LocalPosition.Y) <= Half.Y
                and math.abs(LocalPosition.Z) <= math.max(Half.Z - 2, 0)
        end


        Rescue.ShouldHoldRaidCenter = function(Root, Area)
            if workspace:GetAttribute("Mode") ~= "spiritedawayraid"
                or not Root
                or not Area
            then
                return false
            end

            local ServerArea =
                tonumber(ReadRunValue2("area")) or 0

            if ServerArea ~= 3 then
                Rescue.RaidLastWave = nil
                Rescue.RaidLastVisibleCount = 0
                Rescue.RaidSpawnStableSince = 0
                Rescue.RaidHoldUntil = 0
                return false
            end

            local Wave =
                tonumber(ReadRunValue2("wave")) or 0

            local Remaining =
                tonumber(ReadRunValue2("remaining")) or 0

            local _,
                VisibleCount,
                AttackableCount,
                GuardedBoss =
                GetEnemySnapshot2()

            local Now = os.clock()

            if Wave ~= Rescue.RaidLastWave then
                Rescue.RaidLastWave = Wave
                Rescue.RaidLastVisibleCount = VisibleCount
                Rescue.RaidSpawnStableSince = Now
                Rescue.RaidHoldUntil = Now + 1.15

            elseif VisibleCount > Rescue.RaidLastVisibleCount then
                -- Only an INCREASE extends the settle timer. Enemy deaths should
                -- not pull the player back to center after the wave is populated.
                Rescue.RaidSpawnStableSince = Now
                Rescue.RaidHoldUntil =
                    math.max(
                        Rescue.RaidHoldUntil or 0,
                        Now + 0.80
                    )
            end

            Rescue.RaidLastVisibleCount = VisibleCount

            if Wave <= 0 then
                return false
            end

            if Now < (Rescue.RaidHoldUntil or 0) then
                Rescue.RaidState =
                    "Area3 Spawn Hold"
                return true
            end

            -- Normal mainhall waves are count=10. `remaining` includes enemies
            -- that still have to be brought in, so do not chase the first one
            -- away from center while the rest are pending.
            if Wave <= 3
                and Remaining > 0
                and VisibleCount < Remaining
            then
                Rescue.RaidHoldUntil = Now + 0.30
                Rescue.RaidState =
                    "Area3 Waiting Spawns "
                    .. tostring(VisibleCount)
                    .. "/"
                    .. tostring(Remaining)
                return true
            end

            -- Final No-Face becomes [IMMUNE] through guardedAt while summons /
            -- clone phases are active. Give those adds a short center settle so
            -- the full group can appear before we choose one and leave center.
            if GuardedBoss then
                if AttackableCount <= 0 then
                    Rescue.RaidState =
                        "Boss Immune - Waiting Adds"
                    return true
                end

                if Now - (Rescue.RaidSpawnStableSince or 0) < 0.80 then
                    Rescue.RaidState =
                        "Boss Immune - Settling Adds"
                    return true
                end
            end

            return false
        end


        Rescue.PruneSpikeHazards = function()
            local ServerNow = workspace:GetServerTimeNow()

            for Index = #Rescue.SpikeHazards, 1, -1 do
                local Hazard = Rescue.SpikeHazards[Index]

                if not Hazard
                    or ServerNow > (Hazard.ExpiresAt or 0)
                then
                    table.remove(Rescue.SpikeHazards, Index)
                end
            end
        end


        Rescue.CollectRaidThreats = function(Position)
            local Threats = {}
            local ServerNow = workspace:GetServerTimeNow()

            Rescue.PruneSpikeHazards()

            for _, Hazard in ipairs(Rescue.SpikeHazards) do
                local TimeToImpact =
                    (Hazard.EruptAt or ServerNow)
                    - ServerNow

                if TimeToImpact <= 0.85
                    and TimeToImpact >= -0.22
                then
                    table.insert(Threats, {
                        Position = Hazard.Position,
                        Radius = (Hazard.Radius or 4.5) + 4,
                        Kind = "Spike",
                    })
                end
            end

            -- The game's enemy controller creates aoeIndicator parts for
            -- telegraphed boss attacks (including No-Face's slam). Reading the
            -- real indicator makes the dodge generic instead of hardcoding one
            -- boss animation.
            local Effects = workspace:FindFirstChild("effects")

            if Effects then
                for _, Object in ipairs(Effects:GetChildren()) do
                    if Object:IsA("BasePart")
                        and string.find(
                            string.lower(Object.Name),
                            "aoe",
                            1,
                            true
                        )
                    then
                        table.insert(Threats, {
                            Position = Object.Position,
                            Radius =
                                math.max(Object.Size.X, Object.Size.Z)
                                * 0.5
                                + 4,
                            Kind = "Indicator",
                        })
                    end
                end
            end

            local CurrentDanger = false

            if typeof(Position) == "Vector3" then
                for _, Threat in ipairs(Threats) do
                    local Delta =
                        Vector3.new(
                            Position.X - Threat.Position.X,
                            0,
                            Position.Z - Threat.Position.Z
                        )

                    if Delta.Magnitude <= Threat.Radius then
                        CurrentDanger = true
                        break
                    end
                end
            end

            return Threats, CurrentDanger
        end


        Rescue.PositionSafeFromThreats = function(Position, Threats)
            for _, Threat in ipairs(Threats or {}) do
                local Delta =
                    Vector3.new(
                        Position.X - Threat.Position.X,
                        0,
                        Position.Z - Threat.Position.Z
                    )

                if Delta.Magnitude <= Threat.Radius then
                    return false
                end
            end

            return true
        end


        Rescue.GetRaidDodgeGoal = function(Root, Area, FarmGoal)
            if Settings.AutoDodgeRaidAOE == false
                or not GENV.__AZ_IS_RAID_MODE()
                or not Root
                or not Area
            then
                Rescue.RaidDodgeState = "Idle"
                Rescue.RaidDodgeActive = false
                Rescue.RaidDodgeGoal = nil
                Rescue.RaidDodgeCombatReady = false
                return nil
            end

            local Threats, InDanger =
                Rescue.CollectRaidThreats(Root.Position)

            local Now = os.clock()
            local FarmDanger = false

            -- The old detector only checked the player's CURRENT position.
            -- After one dodge frame the player was safe, so Auto Farm pulled
            -- them straight back onto the boss/AOE. Also test the farm goal.
            if FarmGoal and #Threats > 0 then
                FarmDanger =
                    not Rescue.PositionSafeFromThreats(
                        FarmGoal.Position,
                        Threats
                    )
            end

            -- Fast re-engage: as soon as the boss farm point is no longer
            -- covered by a live threat, give movement back to Auto Raid Farm in
            -- THIS heartbeat. We no longer wait for unrelated AOEs elsewhere
            -- in the room, and there is no long post-AOE clear hold.
            if Rescue.RaidDodgeActive then
                local CurrentSafe =
                    Rescue.PositionSafeFromThreats(
                        Root.Position,
                        Threats
                    )

                if #Threats == 0
                    or (not FarmDanger and CurrentSafe)
                then
                    Rescue.RaidDodgeActive = false
                    Rescue.RaidDodgeGoal = nil
                    Rescue.RaidDodgeHoldUntil = 0
                    Rescue.RaidDodgeCombatReady = false
                    Rescue.RaidDodgeReason = "Cleared"
                    Rescue.RaidDodgeState = "Reengage"
                    return nil
                end

                if Rescue.RaidDodgeGoal
                    and Rescue.PointInsideRaidArea(
                        Rescue.RaidDodgeGoal.Position,
                        Area
                    )
                    and Rescue.PositionSafeFromThreats(
                        Rescue.RaidDodgeGoal.Position,
                        Threats
                    )
                then
                    Rescue.RaidDodgeState =
                        "Locked " .. tostring(Rescue.RaidDodgeReason)
                    return Rescue.RaidDodgeGoal
                end
            end

            if (not InDanger and not FarmDanger) or #Threats == 0 then
                Rescue.RaidDodgeState = "Safe"
                return nil
            end

            local Closest = nil
            local ClosestDistance = math.huge
            local Origin = Root.Position

            -- If the boss-farm point is what's dangerous, choose a direction
            -- away from the threat around that point instead of waiting until
            -- the player has already been pulled into it.
            local ThreatReference =
                (FarmDanger and FarmGoal and FarmGoal.Position)
                or Root.Position

            for _, Threat in ipairs(Threats) do
                local Distance =
                    Vector3.new(
                        ThreatReference.X - Threat.Position.X,
                        0,
                        ThreatReference.Z - Threat.Position.Z
                    ).Magnitude

                if Distance < ClosestDistance then
                    ClosestDistance = Distance
                    Closest = Threat
                end
            end

            local Away = Vector3.new(1, 0, 0)

            if Closest then
                local Delta =
                    Vector3.new(
                        ThreatReference.X - Closest.Position.X,
                        0,
                        ThreatReference.Z - Closest.Position.Z
                    )

                if Delta.Magnitude > 0.05 then
                    Away = Delta.Unit
                end
            end

            local Angles = {
                0,
                math.rad(45),
                math.rad(-45),
                math.rad(90),
                math.rad(-90),
                math.rad(135),
                math.rad(-135),
                math.rad(180),
            }

            local Distances = { 12, 18, 26, 34 }

            for _, Distance in ipairs(Distances) do
                for _, Angle in ipairs(Angles) do
                    local Direction =
                        CFrame.Angles(0, Angle, 0)
                            :VectorToWorldSpace(Away)

                    local Candidate =
                        Origin + Direction * Distance

                    if Rescue.PointInsideRaidArea(Candidate, Area)
                        and Rescue.PositionSafeFromThreats(
                            Candidate,
                            Threats
                        )
                    then
                        local Reason =
                            Closest and Closest.Kind or "AOE"

                        local Goal = CFrame.new(Candidate)
                            * Root.CFrame.Rotation

                        Rescue.RaidDodgeActive = true
                        Rescue.RaidDodgeGoal = Goal
                        Rescue.RaidDodgeReason = Reason
                        Rescue.RaidDodgeState = Reason
                        Rescue.RaidDodgeHoldUntil = 0
                        Rescue.RaidDodgeCombatReady = false
                        Rescue.LastDodgeAt = Now

                        return Goal
                    end
                end
            end

            -- Last-resort fallback: the center of the active raid area is often
            -- safer than remaining inside an imminent ground marker.
            local CenterGoal =
                Rescue.GetRaidAreaGoal(Root, Area)

            if CenterGoal
                and Rescue.PositionSafeFromThreats(
                    CenterGoal.Position,
                    Threats
                )
            then
                CenterGoal = CFrame.new(CenterGoal.Position)
                    * Root.CFrame.Rotation

                Rescue.RaidDodgeActive = true
                Rescue.RaidDodgeGoal = CenterGoal
                Rescue.RaidDodgeReason = "CenterFallback"
                Rescue.RaidDodgeState = "CenterFallback"
                Rescue.RaidDodgeHoldUntil = 0
                Rescue.RaidDodgeCombatReady = false
                Rescue.LastDodgeAt = Now
                return CenterGoal
            end

            Rescue.RaidDodgeState = "NoSafePoint"
            return nil
        end


        if EnemyPackets2
            and EnemyPackets2.spikes
            and type(EnemyPackets2.spikes.on) == "function"
        then
            pcall(function()
                Rescue.SpikeListenerCleanup =
                    EnemyPackets2.spikes:on(function(Data)

                        if not Rescue.Active
                            or type(Data) ~= "table"
                            or type(Data.spots) ~= "table"
                        then
                            return
                        end

                        local ServerNow = workspace:GetServerTimeNow()

                        for Index, Position in pairs(Data.spots) do
                            if typeof(Position) == "Vector3" then
                                local Delay =
                                    type(Data.delays) == "table"
                                    and tonumber(Data.delays[Index])
                                    or 0

                                local Radius =
                                    type(Data.radii) == "table"
                                    and tonumber(Data.radii[Index])
                                    or tonumber(Data.radius)
                                    or 4.5

                                local EruptAt =
                                    (tonumber(Data.eruptAt) or ServerNow)
                                    + (Delay or 0)

                                table.insert(
                                    Rescue.SpikeHazards,
                                    {
                                        Position = Position,
                                        Radius = Radius,
                                        EruptAt = EruptAt,
                                        ExpiresAt = EruptAt + 0.45,
                                    }
                                )
                            end
                        end
                    end)
            end)
        end


        Rescue.HandleRaidRoute = function(Root, EnemyRoot)
            local IsTrials = GENV.__AZ_IS_TRIALS_MODE()
            if not GENV.__AZ_IS_RAID_MODE() and not IsTrials then
                Rescue.RaidState = "NotRaidOrTrials"
                return false
            end

            local World,
                Area,
                Exit,
                ExitPrompt =
                Rescue.GetRaidRouteObjects()

            -- Every elevator transition swaps/rebuilds the active World segment.
            -- Treat that as a new area route immediately.
            if World ~= Rescue.RaidLastWorld then
                Rescue.RaidLastWorld = World
                Rescue.RaidAreaPart = Area
                Rescue.RaidLastAreaAt = 0
                Rescue.RaidState = "NewArea"
            elseif Area ~= Rescue.RaidAreaPart then
                Rescue.RaidAreaPart = Area
                Rescue.RaidLastAreaAt = 0
            end

            local ExitOpen =
                GENV.__AZ_IS_FLOOR_EXIT_READY()
                or (
                    ExitPrompt
                    and ExitPrompt.Enabled == true
                )

            -- Trials must ONLY use the exit section below. During combat
            -- its original Story/Trials farm controller still owns movement.
            if IsTrials and not ExitOpen then
                Rescue.RaidState = "TrialsCombat"
                return false
            end

            -- Exit state is authoritative. Ignore stale enemies and prioritize
            -- the center elevator platform as soon as RaidExitOpen is signaled.
            if ExitOpen then
                Rescue.RaidState = "Elevator"

                -- Give newly spawned drops a small, bounded collection window
                -- before ascending Trials floors. The old global loot policy
                -- prevented travel entirely whenever Auto Farm was enabled.
                if IsTrials then
                    if Rescue.TrialsExitWorld ~= World then
                        Rescue.TrialsExitWorld = World
                        Rescue.TrialsExitSeenAt = os.clock()
                    end
                    if Rescue.TrialsExitSeenAt == 0 then
                        Rescue.TrialsExitSeenAt = os.clock()
                    end
                    local Elapsed = os.clock() - Rescue.TrialsExitSeenAt
                    if Settings.AutoPickupLoot and Elapsed < 2.75 then
                        local HasDrops = false
                        if DropStore2 and DropStore2.store then
                            pcall(function()
                                local Drops = DropStore2.store.state:getAll()
                                HasDrops = type(Drops) == "table" and next(Drops) ~= nil
                            end)
                        end
                        if HasDrops then
                            local Ext = GENV.__AZ_FARM_EXT
                            local LootGoal = Ext
                                and type(Ext.GetLootTargetCFrame) == "function"
                                and Ext.GetLootTargetCFrame()
                            if typeof(LootGoal) == "CFrame" then
                                -- Same one-teleport-per-drop logic as normal
                                -- farming; then wait for pickup/store removal.
                                if Settings.FarmMethod == "Legit" then
                                    GENV.__AZ_LEGIT_NAV.Go(LootGoal, 3, "Trials Loot")
                                else
                                    GENV.__AZ_FARM_EXT.TeleportToLootOnce(Root, LootGoal)
                                end
                                Rescue.RaidState = "Trials Exit Loot"
                                return true
                            elseif Elapsed < 1.85 then
                                Rescue.RaidState = "Waiting For Fresh Drop"
                                return true
                            end
                        end
                    end
                else
                    Rescue.TrialsExitWorld = nil
                    Rescue.TrialsExitSeenAt = 0
                end

                local PromptParent = ExitPrompt and ExitPrompt.Parent
                local PromptPosition = nil
                if PromptParent and PromptParent:IsA("Attachment") then
                    PromptPosition = PromptParent.WorldPosition
                elseif PromptParent and PromptParent:IsA("BasePart") then
                    PromptPosition = PromptParent.Position
                end

                local ExitPosition = nil
                if Exit and Exit:IsA("BasePart") then
                    ExitPosition = Exit.Position
                elseif Exit and Exit:IsA("Attachment") then
                    ExitPosition = Exit.WorldPosition
                elseif Exit and Exit:IsA("Model") then
                    local Pad = Exit.PrimaryPart
                        or Exit:FindFirstChildWhichIsA("BasePart", true)
                    ExitPosition = Pad and Pad.Position or nil
                end

                -- The pad marker is the center location. Prompt attachments
                -- are a fallback and can be mounted above the actual surface.
                local Destination = ExitPosition or PromptPosition
                if not Destination and Area then
                    Destination = Area.Position
                    Rescue.RaidState = "Elevator Center Fallback"
                end

                if Destination then
                    -- Preserve floor height for nearby players, but if the
                    -- farm previously hovered far above the floor, reposition
                    -- to a few studs above the real Lift marker so the prompt
                    -- is actually inside its activation radius.
                    local GoalY = Root.Position.Y
                    if math.abs(GoalY - Destination.Y) > 8 then
                        GoalY = Destination.Y + 3
                    end
                    local GoalPosition = Vector3.new(
                        Destination.X,
                        GoalY,
                        Destination.Z
                    )
                    if (Root.Position - GoalPosition).Magnitude > 1.8 then
                        if workspace:GetAttribute("Mode") == "fateraid" then
                            Rescue.MoveFateEntry(Root,
                                CFrame.new(GoalPosition) * Root.CFrame.Rotation,
                                nil, "Raid Exit", 1.7)
                        elseif Settings.FarmMethod == "Legit" then
                            GENV.__AZ_LEGIT_NAV.Go(GoalPosition, 1.7, "Elevator")
                        else
                            Root.CFrame = CFrame.new(GoalPosition) * Root.CFrame.Rotation
                            Root.AssemblyLinearVelocity = Vector3.zero
                            Root.AssemblyAngularVelocity = Vector3.zero
                        end
                        Rescue.RaidState = "Moving To Elevator Center"
                    else
                        Rescue.RaidState = "Elevator Center Ready"
                    end

                    -- Prefer the normal prompt interaction, when present.
                    -- No remote is invented when the server provides a pad
                    -- that activates simply by standing in the center.
                    if ExitPrompt and ExitPrompt.Enabled and PromptPosition then
                        local MaxDistance = tonumber(ExitPrompt.MaxActivationDistance) or 10
                        if (Root.Position - PromptPosition).Magnitude
                            <= math.max(1, MaxDistance - 0.5)
                        then
                            if Rescue.FireRaidExitPrompt(ExitPrompt) then
                                Rescue.RaidState = "Elevator Prompt"
                                Rescue.RaidLastAreaAt = 0
                            end
                        else
                            Rescue.RaidState = "Waiting For Elevator Prompt Range"
                        end
                    end
                else
                    Rescue.RaidState = "Waiting For Elevator Marker"
                end

                return true
            end

            -- Area 3 must stay in the middle long enough for the full wave /
            -- summon group to materialize. Do this BEFORE following the first
            -- replicated enemy away from the activation volume.
            if Area
                and Rescue.ShouldHoldRaidCenter(
                    Root,
                    Area
                )
            then
                local CenterGoal =
                    Rescue.GetRaidAreaGoal(
                        Root,
                        Area
                    )

                if CenterGoal
                    and (
                        Root.Position
                        - CenterGoal.Position
                    ).Magnitude > 2
                then
                    if Settings.FarmMethod == "Legit" then
                        GENV.__AZ_LEGIT_NAV.Go(CenterGoal, 2.0, "Raid Center")
                    else
                        Root.CFrame = CenterGoal
                    end
                end

                return true
            end

            -- Once an ATTACKABLE enemy exists, normal rescue movement/combat
            -- follows it. Guarded/immune No-Face is filtered by NearestEnemy2.
            if EnemyRoot then
                Rescue.RaidState =
                    Rescue.RaidGuardedBoss
                    and "Adds / Shadow"
                    or "Enemy"
                return false
            end

            if not World then
                Rescue.RaidState = "WaitingForWorld"
                return true
            end

            if not Area then
                Rescue.RaidState = "WaitingForArea"
                return true
            end

            if Rescue.IsInsideRaidArea(Root, Area) then
                -- After a cleared wave the server waits for players to occupy
                -- the activation center, not merely any edge of the area.
                -- Do not take movement from a live attackable target.
                if not EnemyRoot
                    and ReadRunValue2("finishedAt") == nil
                then
                    local Center = Rescue.GetRaidAreaGoal(Root, Area)
                    if Center and (Root.Position - Center.Position).Magnitude > 2.5 then
                        if workspace:GetAttribute("Mode") == "fateraid" then
                            Rescue.MoveFateEntry(Root, Center, nil, "Next Wave", 2.2)
                        elseif Settings.FarmMethod == "Legit" then
                            GENV.__AZ_LEGIT_NAV.Go(Center, 2.2, "Raid Wave")
                        else
                            Root.CFrame = Center
                        end
                        Rescue.RaidState = "Area Center / Next Wave"
                    else
                        Rescue.RaidState = "Area Center Ready"
                    end
                else
                    Rescue.RaidState = "AreaReady"
                end
                return true
            end

            local Now = os.clock()

            if Now - Rescue.RaidLastAreaAt < 0.35 then
                Rescue.RaidState = "EnteringArea"
                return true
            end

            Rescue.RaidLastAreaAt = Now

            local Goal =
                Rescue.GetRaidAreaGoal(
                    Root,
                    Area
                )

            if Goal then
                Rescue.RaidState =
                    "EnterArea "
                    .. tostring(Area.Name)

                -- Area activation should be reliable and immediate. This mirrors
                -- the Story/Join-map behavior of moving inside the real area
                -- volume rather than chasing individual enemy spawn positions.
                if workspace:GetAttribute("Mode") == "fateraid" then
                    Rescue.MoveFateEntry(Root, Goal, nil, "Raid Area", 2.5)
                elseif Settings.FarmMethod == "Legit" then
                    GENV.__AZ_LEGIT_NAV.Go(Goal, 2.5, "Raid Area")
                else
                    Root.CFrame = Goal
                end
            else
                Rescue.RaidState = "AreaGoalMissing"
            end

            return true
        end


