-- Boss/world chest collection. This reuses the native ChestService flow,
-- never invents reward items, and waits for server-replicated Items removal.
-- Built as one Heartbeat worker with an internal .18-second scan cadence.
function Hub:InstallChestAutomation()
    self.ChestDrained=setmetatable({}, {__mode="k"})
    local chestService=nil
    local claimController=nil
    local function services()
        if not chestService then
            local ok,v=pcall(function() return Knit.GetService("ChestService") end)
            if ok then chestService=v end
        end
        if not claimController then
            local ok,v=pcall(function() return Knit.GetController("ChestClaimController") end)
            if ok then claimController=v end
        end
        return chestService
    end
    local function positionOf(obj)
        if not obj or not obj.Parent then return nil end
        if obj:IsA("BasePart") then return obj.Position end
        if obj:IsA("Model") then
            local ok,v=pcall(function() return obj:GetPivot().Position end)
            if ok then return v end
        end
        local part=obj:FindFirstChildWhichIsA("BasePart",true)
        return part and part.Position or nil
    end
    local function isClaimable(obj)
        if not obj or not obj.Parent then return false end
        local retryAt=Hub.ChestSkipped[obj]
        if retryAt and (type(retryAt)~="number" or os.clock()<retryAt) then return false end
        local rarity=obj:GetAttribute("VisualRarity") or obj:GetAttribute("ChestRarity")
        if rarity=="Mythical" and LocalPlayer:GetAttribute("IsHunter")~=true then return false end
        if Hub.ChestDrained[obj] then
            local items=obj:FindFirstChild("Items")
            if not items or #items:GetChildren()==0 then return false end
            Hub.ChestDrained[obj]=nil
        end
        local owner=obj:GetAttribute("Owner")
        if owner~=nil and owner~=LocalPlayer.UserId then
            if obj:GetAttribute("OwnerOpened")~=true then return false end
        end
        if obj:GetAttribute("PickedUp")==true then return false end
        local id=obj:GetAttribute("Id") or obj:GetAttribute("ChestId")
        return (typeof(id)=="string" and id~=""
            or typeof(id)=="number") and positionOf(obj)~=nil
    end
    local function closeSession(session,reason)
        if not Hub.Running or Hub.ChestSession~=session then return end
        local nativeClosed=false
        if claimController and not session.LeaveUIOpen then
            pcall(function()
                if claimController:GetOpenChestId()==session.Id then
                    claimController:Close();nativeClosed=true
                end
            end)
        end
        -- Release the server session even when the claim UI never became ready.
        if not nativeClosed and not session.LeaveUIOpen and chestService then
            pcall(function()
                local reply=chestService:CloseChest(session.Id)
                if reply and type(reply.catch)=="function" then reply:catch(function() end) end
            end)
        end
        -- Never leave the reward panel in a permanent blocked state.
        session.LeaveUIOpen=nil
        Hub.ChestSession=nil
        Hub.ChestStatus=reason
        if session.StartedAt then Hub.ChestLastCycleTime=os.clock()-session.StartedAt end
        Hub:ReleaseFarmFlight()
        Hub.FarmNextSearch=0;Hub.QuestScanNextAt=0
        -- v68: A successfully emptied chest releases the inventory placement
        -- queue immediately. v67 left a +2-second completion marker followed
        -- by a 2.25-second check, delaying the NEXT chest by ~4.25 seconds.
        -- Never erase failure backoffs or interrupt an unconfirmed claim.
        local fullChest=(reason=="Blocked rewards remain; skipped chest")
        if reason=="Rewards collected; chest UI closed" or reason=="Chest empty; UI closed"
            or fullChest then
            -- The server must acknowledge CloseChest, but the client should not
            -- impose a second multi-second wait after rewards are processed.
            local nextAt=os.clock()+math.clamp(0.055+pingSeconds()*0.6,0.075,0.22)
            Hub.InventoryChestLast=math.min(Hub.InventoryChestLast or 0,nextAt-0.08)
            Hub.InventoryChestPendingUntil=math.min(Hub.InventoryChestPendingUntil or 0,nextAt)
            Hub.ChestNextScan=0
            if session.Kind=="Inventory" and Hub.AutoInventoryChests then
                Hub.InventoryChestStatus=fullChest and "Skipped full chest; next chest"
                    or "Chest cleared; opening next chest"
            end
        end
    end
    function Hub:CloseActiveChest(reason)
        if self.ChestSession then closeSession(self.ChestSession,reason or "Closed") end
    end
    local function requestOpen(session,now)
        if session.Pending then return end
        if not services() then Hub.ChestStatus="ChestService not ready";return end
        if claimController then
            local ok,active=pcall(function()
                return claimController:GetOpenChestId()==session.Id
            end)
            if ok and active then
                session.Pending=false
                session.Phase="Loot"
                session.OpenedAt=now
                session.LastChanged=now
                Hub.ChestStatus="Collecting already-open chest"
                return
            end
        end
        if session.Attempts>=3 then
            Hub.ChestSkipped[session.Object]=os.clock()+30
            closeSession(session,"Chest open rejected or timed out")
            return
        end
        session.Attempts+=1
        session.Pending=true
        session.SentAt=now
        session.Phase="Opening"
        session.RequestSerial=(session.RequestSerial or 0)+1
        local requestSerial=session.RequestSerial
        Hub.ChestStatus="Opening chest"
        local ok,promise=pcall(function() return chestService:OpenChest(session.Id) end)
        if not ok or not promise then session.Pending=false;return end
        local bound=pcall(function()
            promise:andThen(function(success)
                if not Hub.Running or Hub.ChestSession~=session or session.RequestSerial~=requestSerial then return end
                session.Pending=false
                if success then
                    session.Phase="Loot"
                    session.OpenedAt=os.clock()
                    session.LastChanged=os.clock()
                    Hub.ChestOpened+=1
                    Hub.ChestStatus="Chest opened; collecting rewards"
                    -- Let the game's native OpenedChest/visual reveal handle UI.
                    -- If the controller missed the event, open its real claim UI.
                    task.delay(0.20,function()
                        if Hub.Running and Hub.ChestSession==session
                            and claimController and session.Object.Parent then
                            pcall(function()
                                if claimController:GetOpenChestId()~=session.Id then
                                    claimController:Open(session.Object,session.Id)
                                end
                            end)
                        end
                    end)
                else
                    session.Phase="Approach"
                    session.RetryAt=os.clock()+1.2
                end
            end)
            promise:catch(function()
                if Hub.Running and Hub.ChestSession==session and session.RequestSerial==requestSerial then
                    session.Pending=false;session.Phase="Approach"
                    session.RetryAt=os.clock()+1.2
                end
            end)
        end)
        if not bound then session.Pending=false;session.Phase="Approach" end
    end
    -- v72: Native Claim All FIRST, immediately after ChestService:OpenChest.
    -- The game can reject an item because its stack is full (Wings Glasses in
    -- the user's video). Keep that reward in the chest, close the panel, and
    -- defer this particular chest instead of blocking the whole batch.
    local function claimOne(session,items,now)
        local remaining=items:GetChildren()
        if #remaining==0 then return end
        session.BlockedItems=session.BlockedItems or {}
        session.ItemFailures=session.ItemFailures or {}
        session.InflightItems=session.InflightItems or {}
        session.NextItemAt=session.NextItemAt or 0
        local function itemTotal(name)
            local quantity=0
            for _,entry in ipairs(items:GetChildren()) do
                if entry.Name==name then
                    quantity+=tonumber(entry:GetAttribute("Quantity")) or 1
                end
            end
            return quantity
        end
        local function deferUnclaimable()
            -- The chest still contains real rewards: don't mark it drained.
            -- A later pass can retry if the user makes inventory space.
            Hub.ChestSkipped[session.Object]=now+180
            Hub.ChestDeferredCount=(Hub.ChestDeferredCount or 0)+1
            Hub.InventoryChestStatus="Reward stack full; skipping chest for now"
            closeSession(session,"Blocked rewards remain; skipped chest")
        end
        -- Avoid exceeding the session TTL when inventory is full or a service
        -- ignores a claim. Real successful removals continuously reset the timer.
        if now-(session.LastChanged or session.OpenedAt)>4.0 then
            deferUnclaimable()
            return
        end
        if not session.TriedTakeAll then
            session.TriedTakeAll=true
            session.TakeAllAt=now
            session.TakeAllPending=true
            session.TakeAllWaitUntil=now+math.clamp(0.42+pingSeconds()*1.6,0.55,1.05)
            Hub.ChestStatus="Claim All: requesting all available rewards"
            local ok,promise=pcall(function() return chestService:TakeAll(session.Id) end)
            if not ok then
                session.TakeAllPending=false
                session.TakeAllWaitUntil=now
            elseif type(promise)=="table" and type(promise.andThen)=="function" then
                -- Do not await this promise serially: the Items folder itself
                -- is the authoritative signal that rewards were collected.
                pcall(function()
                    promise:andThen(function()
                        if Hub.ChestSession==session then session.TakeAllPending=false end
                    end):catch(function()
                        if Hub.ChestSession==session then session.TakeAllPending=false end
                    end)
                end)
            else
                session.TakeAllPending=false
            end
            return
        end
        if now<(session.TakeAllWaitUntil or 0) then return end
        local inflightCount=0
        for name,request in pairs(session.InflightItems) do
            local total=itemTotal(name)
            if total<request.Quantity then
                -- Handles two rewards with the SAME name, not just FindFirstChild.
                session.InflightItems[name]=nil
                session.ItemFailures[name]=0
                session.LastChanged=now
            elseif now-request.At>math.clamp(0.48+pingSeconds()*1.5,0.60,1.18) then
                session.InflightItems[name]=nil
                session.ItemFailures[name]=(session.ItemFailures[name] or 0)+1
                -- Two server rejections/timeouts are enough to identify a full
                -- inventory stack for the current visit. Do not spam retries.
                if session.ItemFailures[name]>=2 then session.BlockedItems[name]=true end
                session.NextItemAt=math.max(session.NextItemAt,now+0.075)
            else
                inflightCount+=1
            end
        end
        local eligible={}
        local names={}
        for _,entry in ipairs(remaining) do
            if not names[entry.Name] and not session.BlockedItems[entry.Name] then
                names[entry.Name]=true
                eligible[#eligible+1]=entry
            end
        end
        if #eligible==0 and inflightCount==0 then
            deferUnclaimable()
            return
        end
        -- A chest may have too many distinct rewards to handle within a single
        -- short request window. Don't expire while removals are still happening.
        if now<session.NextItemAt or inflightCount>=2 then return end
        local item=nil
        for _,entry in ipairs(eligible) do
            if not session.InflightItems[entry.Name] then item=entry;break end
        end
        if not item then
            Hub.ChestStatus="Waiting for pending reward confirmations"
            return
        end
        local name=item.Name
        local request={At=now,Quantity=itemTotal(name)}
        session.InflightItems[name]=request
        session.NextItemAt=now+0.045
        Hub.ChestStatus="Claim remaining reward: "..name
        local ok,promise=pcall(function() return chestService:TakeItem(session.Id,name) end)
        local function failed()
            if Hub.ChestSession~=session or session.InflightItems[name]~=request then return end
            session.InflightItems[name]=nil
            session.ItemFailures[name]=(session.ItemFailures[name] or 0)+1
            if session.ItemFailures[name]>=2 then session.BlockedItems[name]=true end
            session.NextItemAt=math.max(session.NextItemAt,os.clock()+0.075)
        end
        if not ok then failed();return end
        if type(promise)=="table" and type(promise.andThen)=="function" then
            pcall(function()
                promise:andThen(function(value)
                    if value==false or (type(value)=="table"
                        and (value.Success==false or value.success==false)) then failed() end
                end):catch(function() failed() end)
            end)
        end
    end
    -- Record a boss death from replicated health transitions, including NPCs
    -- that are retired from FarmTarget on the exact death frame.
    local observedBossHP=setmetatable({}, {__mode="k"})
    local nextBossDeathScan=0
    table.insert(self.Connections,RunService.Heartbeat:Connect(function()
        if not Hub.Running or os.clock()<nextBossDeathScan then return end
        nextBossDeathScan=os.clock()+0.18
        local char,root=myCharacter()
        if not root then return end
        for model,record in pairs(Hub.Observed) do
            local hum=record.Hum or (model and model:FindFirstChildOfClass("Humanoid"))
            local part=record.Root or (model and model:FindFirstChild("HumanoidRootPart"))
            local name=record.NPCName or (model and model.Name)
            if model and hum and part and (BossSet[name] or model:HasTag("Boss") or model:GetAttribute("IsBoss")==true)
                and (part.Position-root.Position).Magnitude<180 then
                local last=observedBossHP[model]
                local hp=hum.Health
                if last and last>0 and hp<=0 then
                    Hub.RecentBossDeathPosition=part.Position
                    Hub.RecentBossDeathAt=os.clock()
                    Hub.MapChestStatus="Boss drop window active"
                end
                observedBossHP[model]=hp
            end
        end
    end))
    -- Map exploration is based on actual saved world-chest positions, NOT
    -- ReplicatedStorage.NpcSpawnPoints (which caused teleports to enemies).
    local mapAnchors={}
    local mapScannedAt=0
    for _,p in ipairs(Hub.CapturedMapChestAnchors) do
        table.insert(mapAnchors,p)
    end
    local function rememberMapAnchor(p)
        if typeof(p)~="Vector3" then return end
        for _,known in ipairs(mapAnchors) do
            if (known-p).Magnitude<18 then return end
        end
        table.insert(mapAnchors,p)
    end
    -- v66: No speculative land grid. Those positions were sometimes directly
    -- beside NPCs or quest boards. Additional destinations are learned only
    -- when an actual world chest streams in or the owned Chest Scanner reports
    -- its position. Preserve verified observations across re-execution.
    local memory=Env.HollowMoonBeyondNenWorldChestAnchors
    if type(memory)=="table" then
        for _,position in ipairs(memory) do rememberMapAnchor(position) end
    end
    Env.HollowMoonBeyondNenWorldChestAnchors=mapAnchors
    Hub.MapChestScoutCount=#mapAnchors
    Hub.MapChestCheckedAt={}
    local function isWorldMapChest(obj,at)
        if not obj or not at then return false end
        if obj:GetAttribute("Owner")~=nil then return false end
        if obj:GetAttribute("PlacedByUser")==true or obj:GetAttribute("Placed")==true then return false end
        if obj:GetAttribute("MapChest")==true or obj:GetAttribute("WorldChest")==true then return true end
        local label=tostring(obj:GetAttribute("ChestLabel") or obj.Name):lower()
        -- Map chests in the saved place are Adventure Chest parts. Boss-drop
        -- Normal / Legendary Chest objects must not enter this category.
        if label:find("adventure chest",1,true) then return true end
        -- Position-only fallback must still be an actual chest instance.
        if label:find("chest",1,true) then
            for _,saved in ipairs(Hub.CapturedMapChestAnchors) do
                if (at-saved).Magnitude<=14 then return true end
            end
        end
        return false
    end
    local function nextMapAnchor(root,now)
        if Hub.MapChestScoutBusy or Hub.V70NenPriority then return end
        if not Hub.AutoMapChests or Hub.ChestSession then return end
        if Hub.V44 and Hub.V44.ActivityOwner
            and now<(Hub.V44.ActivityUntil or 0) then return end
        if now<(Hub.MapChestScanAt or 0) or not Hub:MaintenanceSafe() then return end
        Hub.MapChestScanAt=now+0.8
        -- The game's Workspace.ChestSpawns is authoritative for chest patrol routes.
        local spawnFolder=workspace:FindFirstChild("ChestSpawns")
        if spawnFolder then
            for _,spawnPart in ipairs(spawnFolder:GetChildren()) do
                if spawnPart:IsA("BasePart") and spawnPart.Name=="ChestSpawn" then
                    rememberMapAnchor(spawnPart.Position)
                end
            end
        end
        Hub.MapChestScoutCount=#mapAnchors
        -- Learn from real world Adventure Chests already observed nearby.
        local world=workspace:FindFirstChild("World")
        local folder=world and world:FindFirstChild("Chests")
        if folder then
            for _,obj in ipairs(folder:GetChildren()) do
                local at=positionOf(obj)
                if isWorldMapChest(obj,at) then rememberMapAnchor(at) end
            end
        end
        -- New server builds can tag streamed chests outside World.Chests.
        -- Only genuine chest instances qualify, never a nearby NPC/board.
        local collection=game:GetService("CollectionService")
        for _,tag in ipairs({"AdventureChest","MapChest","WorldChest"}) do
            for _,chest in ipairs(collection:GetTagged(tag)) do
                if chest:IsDescendantOf(workspace) then
                    local at=positionOf(chest)
                    if isWorldMapChest(chest,at) then rememberMapAnchor(at) end
                end
            end
        end
        -- The game's optional Chest Scanner may expose remote world chest
        -- positions for owners; do not assume that perk or its data exists.
        local hasScanner=false
        pcall(function()
            local gp=require(ReplicatedStorage.Shared.Data.FeatureGamepasses)
            hasScanner=gp.Owns(LocalPlayer,"ChestScanner") == true
        end)
        if now-mapScannedAt>20 and hasScanner then
            mapScannedAt=now
            if services() and type(chestService.GetScannedChests)=="function" then
                pcall(function()
                    local promise=chestService:GetScannedChests()
                    if promise and type(promise.andThen)=="function" then
                        promise:andThen(function(points)
                            if not Hub.Running or type(points)~="table" then return end
                            for _,entry in pairs(points) do
                                if type(entry)=="table" then rememberMapAnchor(entry.Position) end
                            end
                        end)
                    end
                end)
            end
        end
        if #mapAnchors==0 then
            Hub.MapChestStatus="No verified world-chest anchors in this capture"
            return
        end
        local chosenIndex=nil
        local checked=Hub.MapChestCheckedAt
        for _=1,#mapAnchors do
            local index=((Hub.MapChestStreamIndex or 0)%#mapAnchors)+1
            Hub.MapChestStreamIndex=index
            if now-(checked[index] or -100000)>40 then
                chosenIndex=index
                break
            end
        end
        if not chosenIndex then
            Hub.MapChestStatus="All known regions checked; waiting to rescan"
            Hub.MapChestScanAt=now+10
            return
        end
        local pos=mapAnchors[chosenIndex]
        Hub.MapChestScoutEpoch=(Hub.MapChestScoutEpoch or 0)+1
        local epoch=Hub.MapChestScoutEpoch
        Hub.MapChestStatus=string.format("Checking verified chest area %d/%d",
            chosenIndex,#mapAnchors)
        Hub.MapChestScoutBusy=true
        task.spawn(function()
            local success,reason=pcall(function()
            if not Hub.Running or not Hub.AutoMapChests then return end
            local streamed=pcall(function() LocalPlayer:RequestStreamAroundAsync(pos,3) end)
            if not Hub.Running or not Hub.AutoMapChests
                or Hub.MapChestScoutEpoch~=epoch
                or Hub.ChestSession or Hub.V70NenPriority
                or (Hub.V44 and Hub.V44.ActivityOwner
                    and os.clock()<(Hub.V44.ActivityUntil or 0)) then return end
            local char=LocalPlayer.Character
            local root=char and char:FindFirstChild("HumanoidRootPart")
            if not char or not root then return end
            local params=RaycastParams.new()
            params.FilterType=Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances={char}
            params.RespectCanCollide=true
            local landing=nil
            for _,offset in ipairs({
                Vector3.zero,Vector3.new(6,0,0),Vector3.new(-6,0,0),
                Vector3.new(0,0,6),Vector3.new(0,0,-6)
            }) do
                local cast=workspace:Raycast(
                    Vector3.new(pos.X+offset.X,1000,pos.Z+offset.Z),
                    Vector3.new(0,-1300,0),params)
                if cast and cast.Instance and cast.Instance.CanCollide
                    and cast.Instance.Anchored
                    and cast.Material~=Enum.Material.Water
                    and cast.Normal.Y>0.65 and cast.Position.Y>-200 then
                    landing=cast.Position+Vector3.new(0,3.5,0)
                    break
                end
            end
            if not landing then
                -- Retry this location soon rather than mark it checked for four minutes.
                checked[chosenIndex]=os.clock()-225
                Hub.MapChestStatus=streamed and "Scouting: no safe loaded ground"
                    or "Scouting: area streaming failed"
                return
            end
            if (landing-root.Position).Magnitude>25 then
                pcall(function() char:PivotTo(CFrame.new(landing)) end)
            end
            -- Stay near this region until server-replicated chest instances and
            -- IDs have time to arrive. Never confuse a ChestSpawn marker with
            -- a live, claimable chest.
            pcall(function() LocalPlayer:RequestStreamAroundAsync(pos,2.5) end)
            local untilAt=os.clock()+3.0
            local detected=false
            repeat
                if not Hub.Running or not Hub.AutoMapChests or Hub.ChestSession
                    or Hub.V70NenPriority or Hub.MapChestScoutEpoch~=epoch then break end
                local w=workspace:FindFirstChild("World")
                local c=w and w:FindFirstChild("Chests")
                if c then
                    for _,chest in ipairs(c:GetChildren()) do
                        local at=positionOf(chest)
                        if at and (at-pos).Magnitude<=32 and isWorldMapChest(chest,at) then
                            detected=true
                            if isClaimable(chest) then
                                Hub.MapChestStatus="Live map chest found; approaching and opening"
                                Hub.ChestNextScan=0
                                break
                            else
                                Hub.MapChestStatus="Visible map chest; waiting for ChestId/claim permission"
                            end
                        end
                    end
                end
                if detected then break end
                task.wait(0.15)
            until os.clock()>=untilAt
            if Hub.ChestSession then
                checked[chosenIndex]=os.clock()-34
                Hub.MapChestStatus="Chest session active; collecting before moving"
                return
            end
            if not detected then
                checked[chosenIndex]=os.clock()
                Hub.MapChestStatus="No live chest at this spawn; checking next region"
            else
                -- Retry incomplete chest replication soon, not in four minutes.
                checked[chosenIndex]=os.clock()-34
            end
            end)
            if Hub.MapChestScoutEpoch==epoch then Hub.MapChestScoutBusy=false end
            if not success and Hub.Running and Hub.MapChestScoutEpoch==epoch then
                Hub.MapChestStatus="Map scout error: "..tostring(reason):sub(1,100)
            end
        end)
    end
    local function chooseChest(root,now)
        local world=workspace:FindFirstChild("World")
        local folder=world and world:FindFirstChild("Chests")
        if not folder then return nil end
        local best,bestDist=nil,math.huge
        for _,obj in ipairs(folder:GetChildren()) do
            local atAny=positionOf(obj)
            if Hub.AutoMapChests and atAny
                and (atAny-root.Position).Magnitude<45
                and isWorldMapChest(obj,atAny) and not isClaimable(obj) then
                local idAny=obj:GetAttribute("Id") or obj:GetAttribute("ChestId")
                Hub.MapChestStatus=idAny==nil
                    and "Map chest visible; server ChestId not replicated"
                    or "Map chest visible but not yet claimable (hunter/owner/cooldown)"
            end
            if isClaimable(obj) then
                local owned=obj:GetAttribute("Owner")==LocalPlayer.UserId
                local at=positionOf(obj)
                local dist=(at-root.Position).Magnitude
                local recent=Hub.RecentBossDeathPosition
                local nearDrop=recent and (now-Hub.RecentBossDeathAt)<70
                    and (at-recent).Magnitude<=38
                local worldChest=obj:GetAttribute("Owner")==nil
                local placed=obj:GetAttribute("PlacedByUser")==true or obj:GetAttribute("Placed")==true
                local bossCandidate=Hub.AutoOpenChest and nearDrop and not placed
                local mapCandidate=worldChest and Hub.AutoMapChests
                    and isWorldMapChest(obj,at)
                if bossCandidate or mapCandidate or (Hub.AutoInventoryChests and owned and not bossCandidate) then
                    if dist<bestDist then
                        best,bestDist=obj,dist
                    end
                end
            end
        end
        return best
    end
    table.insert(self.Connections,RunService.Heartbeat:Connect(function(dt)
        if not self.Running then return end
        if not self.AutoOpenChest and not self.AutoInventoryChests and not self.AutoMapChests then
            if self.ChestSession then
                closeSession(self.ChestSession,"Disabled")
            else
                self.ChestStatus="Off"
            end
            return
        end
        if self.V70NenPriority or self:InventoryBusy() then return end
        local now=os.clock()
        if now<(self.ChestNextScan or 0) then return end
        self.ChestNextScan=now+0.055
        local char,root,hum=myCharacter()
        if not char then return end
        local session=self.ChestSession
        if not session then
            -- Don't start opening an unrelated chest while a boss is alive.
            local enemy=self.QuestCombatActive and self.QuestTarget or self.FarmTarget
            if enemy and activeNpcRecord(enemy)
                and (enemy.Root.Position-root.Position).Magnitude<60
                and not self.AutoMapChests then return end
            if os.clock()<self.ManualUntil or self.DodgeActive or self.DefenseMode then return end
            local chest=chooseChest(root,now)
            if not chest then
                nextMapAnchor(root,now)
                self.ChestStatus=self.AutoOpenChest and "Watching near recent boss kills"
                    or (self.AutoMapChests and self.MapChestStatus)
                    or "Watching for placed inventory chests"
                return
            end
            local id=chest:GetAttribute("Id") or chest:GetAttribute("ChestId")
            session={Object=chest,Id=id,Phase="Approach",Attempts=0,
                Kind=(self.RecentBossDeathPosition and now-self.RecentBossDeathAt<70
                    and (positionOf(chest)-self.RecentBossDeathPosition).Magnitude<=38
                    and not isWorldMapChest(chest,positionOf(chest))
                    and chest:GetAttribute("PlacedByUser")~=true and chest:GetAttribute("Placed")~=true)
                    and "Boss" or (isWorldMapChest(chest,positionOf(chest)) and "Map" or "Inventory"),
                Character=char,StartedAt=now,
                Pending=false,SentAt=0,OpenedAt=0,RetryAt=0,LastChanged=now}
            self.ChestSession=session
            self.ChestStatus="Chest detected; approaching"
        end
        if session.Kind=="Boss" and not self.AutoOpenChest
            or session.Kind=="Map" and not self.AutoMapChests
            or session.Kind=="Inventory" and not self.AutoInventoryChests then
            closeSession(session,"Collection disabled");return
        end
        if not session.Object.Parent then
            closeSession(session,"Chest removed")
            return
        end
        if char~=session.Character or now-session.StartedAt>30 then
            self.ChestSkipped[session.Object]=now+20
            closeSession(session,"Chest session interrupted / timed out");return
        end
        if os.clock()<self.ManualUntil then
            closeSession(session,"Paused for manual input");return
        end
        local at=positionOf(session.Object)
        if not at then closeSession(session,"Chest position unavailable");return end
        local delta=at-root.Position
        if delta.Magnitude>9.5 then
            -- The chest claim controller closes beyond 25 studs; approach
            -- once, then hold near the chest until all replicated items vanish.
            local lateral=Vector3.new(delta.X,0,delta.Z)
            lateral=lateral.Magnitude>0.05 and lateral.Unit or Vector3.zAxis
            local dest=at-lateral*5+Vector3.new(0,2.7,0)
            -- Teleport into interaction range for dropped/placed chests.
            -- Small local adjustments are still smoothed on Heartbeat.
            local alpha=1-math.exp(-math.clamp(dt,0.01,0.18)*14)
            local moved=(dest-root.Position).Magnitude>16 and dest
                or root.Position:Lerp(dest,alpha)
            local look=Vector3.new(at.X,moved.Y,at.Z)
            if (look-moved).Magnitude<0.1 then look=moved+Vector3.zAxis end
            self:ApplyFarmPose(char,root,CFrame.lookAt(moved,look))
            self.ChestStatus="Approaching dropped chest"
            return
        end
        self:HoldFarmFlight(root,root.CFrame)
        if session.Phase=="Approach" and now>=session.RetryAt then
            requestOpen(session,now)
        elseif session.Phase=="Opening" then
            if session.Pending and now-session.SentAt>3 then
                session.Pending=false;session.RequestSerial=(session.RequestSerial or 0)+1;session.Phase="Approach"
                session.RetryAt=now+0.5
            end
        elseif session.Phase=="Loot" then
            local items=session.Object:FindFirstChild("Items")
            if items then
                local count=#items:GetChildren()
                if session.LootLastCount and count<session.LootLastCount then
                    Hub.ChestItemsTaken+=session.LootLastCount-count
                    session.LastChanged=now
                end
                session.LootLastCount=count
                if count==0 then
                    session.ItemPending=nil
                    if now-session.OpenedAt>(session.HasSeenItems and 0.045 or 0.24) then
                        self.ChestDrained[session.Object]=true
                        closeSession(session,session.HasSeenItems and "Rewards collected; chest UI closed" or "Chest empty; UI closed")
                    end
                else
                    session.HasSeenItems=true
                    claimOne(session,items,now)
                end
            elseif now-session.OpenedAt>5.5 then
                -- Do not report success when loot state never replicated.
                self.ChestSkipped[session.Object]=os.clock()+30
            closeSession(session,"Chest items missing; closing UI and retrying later")
            end
        end
    end))
end

-- v70 inventory chest batch: retain the user's equipped tool until the last chest.
-- Avoid restoring an old tool over a manual tool change.
function Hub:V70RestoreChestBatchTool()
    local batch=self.V70ChestBatchRestore
    self.V70ChestBatchRestore=nil
    if not batch or not batch.Tool or not batch.Tool.Parent then return end
    if LocalPlayer.Character~=batch.Character then return end
    local char=batch.Character
    local hum=char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 then return end
    local current=char:FindFirstChildOfClass("Tool")
    local currentIsChest=false
    if current then
        local uuid=current:GetAttribute("UUID")
        local info
        local p=self.Progression
        if p and uuid and p.playerData and p.itemList and p.itemInfo then
            local data=p.playerData()
            local inv=data and data:FindFirstChild("Inventory")
            local entry=inv and inv:FindFirstChild(tostring(uuid))
            if entry then info=p.itemInfo(entry:GetAttribute("item_id"),p.itemList() or {}) end
        end
        currentIsChest=type(info)=="table" and info.Type=="Chest"
    end
    if not current or currentIsChest then
        if batch.Tool.Parent==LocalPlayer:FindFirstChildOfClass("Backpack") then
            pcall(function() hum:EquipTool(batch.Tool) end)
        end
    end
end

-- v44 base progression: verified native requests, normalized gear scores, no tool swaps for gear.
function Hub:InstallProgressionAutomation()
    local H={Cache={},Failures={},Definitions={},Buffs=nil,Inventory=nil,BoundSlot=nil,Signals={}}
    self.Progression=H
    self.StatKeys={Strength="StrengthStat",Durability="DurabilityStat",Nen="NenStat",Weapons="WeaponStat",Stamina="StaminaStat"}
    function H.service(name)
        if H.Cache[name] then return H.Cache[name] end
        local ok,value=pcall(Knit.GetService,name)
        if ok and value then H.Cache[name]=value;return value end
    end
    function H.playerData()
        local data=LocalPlayer:FindFirstChild("Data")
        local slots=data and data:FindFirstChild("SavesSlot")
        local selected=tonumber(LocalPlayer:GetAttribute("SelectedSlot")) or (data and tonumber(data:GetAttribute("SelectedSlot"))) or 1
        local slot=slots and slots:FindFirstChild(tostring(selected))
        return slot and (slot:FindFirstChild("PlayerData") or slot),selected
    end
    function H.currentEquipped(data)
        local equipped={}
        local equipment=data and data:FindFirstChild("Equipment")
        local accessories=equipment and equipment:FindFirstChild("Accessories")
        if accessories then
            for _,entry in ipairs(accessories:GetDescendants()) do
                local uuid=entry:GetAttribute("uuid") or entry:GetAttribute("UUID")
                if uuid~=nil and tostring(uuid)~="" then equipped[tostring(uuid)]=true end
            end
        end
        local outfit=LocalPlayer:GetAttribute("CustomOutfitUUID")
        if outfit and tostring(outfit)~="" then equipped[tostring(outfit)]=true end
        return equipped
    end
    function H.itemInfo(id,list)
        if id==nil then return nil end
        local key=tostring(id)
        return list[id] or list[key] or (tonumber(key) and list[string.format("%03d",tonumber(key))])
    end
    function H.itemList()
        if H.List then return H.List end
        local ok,list=pcall(function() return require(ReplicatedStorage.Shared.Data.InventoryItems.ItemList) end)
        if ok and type(list)=="table" then H.List=list;return list end
    end
    function H.buffReader()
        if H.Buffs then return H.Buffs end
        local scripts=LocalPlayer:FindFirstChild("PlayerScripts")
        local client=scripts and scripts:FindFirstChild("Client")
        local controllers=client and client:FindFirstChild("Controllers")
        local inventory=controllers and controllers:FindFirstChild("InventoryController")
        local module=inventory and inventory:FindFirstChild("buff_sources")
        local ok,value=pcall(function() return module and require(module) end)
        if ok and value and type(value.item_stats)=="function" then H.Buffs=value;return value end
    end
    -- Convert all categories to percent-scale utility. Negative bonuses remain penalties.
    -- Flat capacities are measured against fixed reference capacities so the same inventory
    -- cannot oscillate merely because equipping an item changed a live maximum.
    function H.normalized(entry,key)
        local amount=tonumber(entry.amount) or 0
        if amount~=amount or math.abs(amount)==math.huge then return 0 end
        if entry.format=="fraction" then return amount*100 end
        if entry.format=="multiplier" then return (amount-1)*100 end
        if entry.format=="flat" or entry.format=="raw" then
            local reference=key=="ExtraPosture" and 60 or 100
            return amount*100/reference
        end
        return amount
    end
    H.Presets={
        Balanced={Damage=1.4,Defense=1.1,Nen=1.1,Stamina=1,Mobility=.8,Farming=.25,Boss=1,Other=.2},
        Damage={Damage=4,Defense=.35,Nen=.45,Stamina=.3,Mobility=.3,Farming=.05,Boss=2.5,Other=.1},
        ["Boss Damage"]={Damage=2.8,Defense=.5,Nen=.45,Stamina=.3,Mobility=.35,Farming=.15,Boss=5,Other=.1},
        Defense={Damage=.4,Defense=4,Nen=.3,Stamina=1.1,Mobility=.7,Farming=.1,Boss=.2,Other=.1},
        Nen={Damage=1.3,Defense=.6,Nen=4,Stamina=.7,Mobility=.3,Farming=.1,Boss=1,Other=.1},
        Stamina={Damage=.4,Defense=.5,Nen=.2,Stamina=4,Mobility=1.6,Farming=.1,Boss=.2,Other=.1},
        Mobility={Damage=.4,Defense=.5,Nen=.2,Stamina=1.6,Mobility=4,Farming=.2,Boss=.2,Other=.1},
        Farming={Damage=.8,Defense=.3,Nen=.2,Stamina=.3,Mobility=.5,Farming=5,Boss=.4,Other=.1},
    }
    function H.gearWeight(key,preset)
        local name=string.lower(key)
        local group="Other"
        if name:find("bossdamage",1,true) then group="Boss"
        elseif name:find("drop",1,true) or name:find("money",1,true) or name:find("experience",1,true) or name:find("ore",1,true) then group="Farming"
        elseif name:find("damagereduction",1,true) or name:find("health",1,true) or name:find("durability",1,true) or name:find("posture",1,true) then group="Defense"
        elseif name:find("damageincrease",1,true) or name:find("penetration",1,true) or name:find("scalingbonus",1,true) or name:find("strength",1,true) or name:find("weapon",1,true) then
            if preset=="Nen" and (name:find("nen",1,true) or name:find("all",1,true)) then group="Nen" else group="Damage" end
        elseif name:find("stamina",1,true) then group="Stamina"
        elseif name:find("nen",1,true) then group="Nen"
        elseif name:find("speed",1,true) or name:find("dash",1,true) or name:find("dodge",1,true) then group="Mobility" end
        return (H.Presets[preset] or H.Presets.Balanced)[group] or .1
    end
    function H.score(info,item,preset)
        local reader=H.buffReader()
        if not reader then return nil end
        local score=0
        local function add(entries)
            for key,entry in pairs(entries or {}) do
                if type(entry)=="table" then score+=H.normalized(entry,tostring(key))*H.gearWeight(tostring(key),preset) end
            end
        end
        add(reader.item_stats(info))
        local blessing=item:GetAttribute("Blessing")
        if blessing and blessing~="" then
            local ok,rules=pcall(function() return require(ReplicatedStorage.Shared.Data.AccessoryBlessings) end)
            if ok and rules then
                local normalized=rules.Normalize(info.ItemName,blessing)
                if normalized then add(reader.item_stats({ItemName=rules.Key(info.ItemName,normalized)})) end
            end
        end
        return score
    end
    function H.refreshBindings()
        local data,slot=H.playerData()
        local inventory=data and data:FindFirstChild("Inventory")
        if data==H.BoundSlot and inventory==H.Inventory then return end
        for _,conn in ipairs(H.Signals) do pcall(function() conn:Disconnect() end) end
        table.clear(H.Signals)
        H.BoundSlot=data;H.Inventory=inventory
        -- Invalidate delayed work from the previous save slot.
        Hub:CancelJobs()
        Hub.StatBusy=false;Hub.GearBusy=false;Hub.MilestoneBusy=false;Hub.InventoryChestBusy=false;Hub.HunterExamBusy=false
        Hub.GearNext=0;Hub.StatNext=0;Hub.MilestoneNext=0;Hub.InventoryChestLast=0
        table.clear(H.Failures);table.clear(H.Definitions);table.clear(H.GearBackoff or {})
        if inventory then
            local function changed()
                Hub.GearNext=math.min(Hub.GearNext,os.clock()+.5)
                Hub.InventoryChestLast=math.min(Hub.InventoryChestLast,os.clock()-2)
            end
            for _,signal in ipairs({inventory.ChildAdded,inventory.ChildRemoved,inventory.DescendantAdded,inventory.DescendantRemoving}) do
                local conn=signal:Connect(changed)
                table.insert(H.Signals,conn);table.insert(Hub.Connections,conn)
            end
        end
    end
    function H.milestones()
        if not Hub.AutoMilestones or Hub.MilestoneBusy or os.clock()<Hub.MilestoneNext then return end
        Hub.MilestoneNext=os.clock()+1.2
        local data,slot=H.playerData()
        local folder=data and data:FindFirstChild("Milestones")
        local service=H.service("MilestonesService")
        local definitions=ReplicatedStorage:FindFirstChild("Common")
        definitions=definitions and definitions:FindFirstChild("MilestonesHandlers")
        local ok,controller=pcall(Knit.GetController,"DataController")
        if not ok or not folder or not service or not definitions then Hub.MilestoneStatus="Waiting for milestone data";return end
        local good,records=pcall(controller.get,slot,"PlayerData","Milestones")
        if not good or type(records)~="table" then Hub.MilestoneStatus="Milestones not replicated";return end
        local keys={};for key in pairs(records) do table.insert(keys,key) end;table.sort(keys,function(a,b) return tostring(a)<tostring(b) end)
        for _,key in ipairs(keys) do
            local progress=records[key]
            if type(progress)=="table" and not progress.collected and os.clock()>=(H.Failures[key] or 0) then
                local definition=H.Definitions[key]
                if not definition then
                    local module=definitions:FindFirstChild(tostring(key))
                    local valid,value=pcall(function() return module and require(module) end)
                    if valid and type(value)=="table" then definition=value;H.Definitions[key]=value end
                end
                if definition and tonumber(definition.NEEDED) and (tonumber(progress.current) or 0)>=definition.NEEDED then
                    Hub.MilestoneBusy=true;Hub.MilestoneStatus="Claiming "..tostring(key)
                    Hub:StartJob("milestone","AutoMilestones",function(alive)
                        if not alive() then return end
                        local sent,reply=pcall(function() return service:claim(key) end)
                        local accepted,value=false,nil
                        if sent then accepted,value=Hub:AwaitReply(reply,alive) end
                        local confirmed=sent and accepted and value~=false and Hub:WaitConfirmed(function()
                            local current=controller.get(slot,"PlayerData","Milestones")
                            return type(current)=="table" and type(current[key])=="table" and current[key].collected==true
                        end,alive,3)
                        if not alive() then return end
                        if confirmed then Hub.MilestoneClaimed+=1;Hub.MilestoneStatus="Claimed "..tostring(key)
                        else H.Failures[key]=os.clock()+15;Hub.MilestoneStatus="Claim unconfirmed: "..tostring(key) end
                        Hub.MilestoneNext=os.clock()+(confirmed and .3 or 2)
                    end,function() if Hub.Running then Hub.MilestoneBusy=false end end)
                    return
                end
            end
        end
        Hub.MilestoneStatus="No claimable milestones"
    end
    function H.stats()
        if not Hub.AutoStatPoints or Hub.StatBusy or os.clock()<Hub.StatNext then return end
        Hub.StatNext=os.clock()+.75
