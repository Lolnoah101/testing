    --//========================================================
    --// AUTO SKILL TREE
    --//
    --// Strict priority requested by user:
    --// ATK -> CRIT -> DEF -> SPD
    --// A lower-priority branch is not purchased while the next
    --// higher-priority node is still locked for lack of tokens.
    --//========================================================

    local SkillPriority = {
        "ATK",
        "CRIT",
        "DEF",
        "SPD",
    }

    local PendingSkillTree = nil
    local NextSkillTreeAt = 0

    local function GetNextSkillTreePurchase()
        local Data = GetAccountData()

        if not Data
            or type(Data.character) ~= "string"
            or Data.character == ""
            or not Data.CharactersData
        then
            return nil
        end

        local Character = Data.character
        local CharacterData = Data.CharactersData[Character]

        if not CharacterData
            or not CharacterData.Progression
            or type(CharacterData.Progression.Skills) ~= "table"
        then
            return nil
        end

        local CharacterConfig = SkillTreeConfig
            and SkillTreeConfig.characters
            and SkillTreeConfig.characters[Character]

        if not CharacterConfig
            or not CharacterConfig.branches
        then
            return nil
        end

        local Skills = CharacterData.Progression.Skills
        local AvailableTokens

        local Success, Tokens = pcall(function()
            return CharacterLevelProgression.getAvailableTokens(
                Character,
                CharacterData.Progression.Xp or "0",
                Skills
            )
        end)

        if Success then
            AvailableTokens = tonumber(Tokens)
        end

        if AvailableTokens == nil then
            return nil
        end

        for _, Branch in ipairs(SkillPriority) do
            local BranchConfig = CharacterConfig.branches[Branch]
            local CurrentTier = tonumber(Skills[Branch]) or 1

            if BranchConfig
                and type(BranchConfig.tiers) == "table"
                and CurrentTier < #BranchConfig.tiers
            then
                local NextTier = CurrentTier + 1
                local TierData = BranchConfig.tiers[NextTier]
                local Cost = TierData and tonumber(TierData.cost) or 0

                return {
                    character = Character,
                    branch = Branch,
                    tier = NextTier,
                    cost = Cost,
                    tokens = AvailableTokens,
                }
            end
        end

        return nil
    end

    if SkillTreePackets
        and SkillTreePackets.characterSkillPurchaseResult
    then
        local Connection =
            SkillTreePackets.characterSkillPurchaseResult
                :on(function(Result)
                    if not Alive()
                        or not Result
                        or not PendingSkillTree
                    then
                        return
                    end

                    if Result.requestId ~= PendingSkillTree.requestId
                        or tostring(Result.character)
                            ~= PendingSkillTree.character
                        or tostring(Result.branch)
                            ~= PendingSkillTree.branch
                        or tonumber(Result.tier)
                            ~= PendingSkillTree.tier
                    then
                        return
                    end

                    PendingSkillTree = nil

                    if Result.success == true then
                        NextSkillTreeAt = os.clock() + 0.45
                    else
                        NextSkillTreeAt = os.clock() + 1.50

                        if tostring(Result.reason or "") ~= "" then
                            warn(
                                "[Anime Zero][Skill Tree]",
                                Result.reason
