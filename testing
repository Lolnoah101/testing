--// ============================================================

local function UnloadHub()
    if not HubRunning then
        return
    end

    HubRunning = false
    Settings.AutoSwing = false

    pcall(function()
        Window:Unload()
    end)

    getgenv().__HOLLOWMOON_NEWGAME_UNLOAD =
        nil
end


getgenv().__HOLLOWMOON_NEWGAME_UNLOAD =
    UnloadHub


SettingsTab:CreateButton({
    name = "Unload Hub",
    callback = UnloadHub,
})


