                and Saved.SelectedRaidMap
            or Settings.SelectedRaidMap,

        AutoJoinRaid =
            ReadSavedBool("AutoJoinRaid", Settings.AutoJoinRaid),

        SelectedTrialsRoom =
            math.clamp(math.floor(tonumber(Saved.SelectedTrialsRoom) or 1), 1, 65535),

        AutoJoinTrials =
