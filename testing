-- Full captured combo:
--   1 -> 0.13
--   2 -> 0
--   3 -> 0
--   4 -> 0
--   5 -> 0.15
--
-- The small client-side delay keeps the five requests ordered instead
-- of pushing every combo stage in the exact same scheduler slice.
-- Balanced client-side combo pacing.
-- Going too fast can cause the game/server to ignore later combat
-- requests, so keep this only moderately faster than the original.
-- The captured timing values sent to the server stay unchanged.
local COMBO_STEP_DELAY = 0.04
local COMBO_RESET_DELAY = 0.08

local AutoClickLoopID = 0
local AntiAFKConnection = nil
local ChestAddedConnection = nil
