local function resolveIslandArrival(id)
    local def = Islands[id]
    if type(def) ~= "table" or typeof(def.Center) ~= "Vector3" then
        return nil, "No island configuration"
    end
    local map = Workspace:FindFirstChild("Map")
    local island = map and map:FindFirstChild(id)
    -- Grounded positions first; avoid the island's waterline/center when possible.
    if island then
        for _, name in ipairs({"Spawn", "PlayerSpawn", "IslandSpawn", "Arrival", "TownSpawn", "Dock"}) do
            local marker = island:FindFirstChild(name,true)
            if marker and marker:IsA("BasePart") then
                return marker.Position + Vector3.new(0,5,0), "Map "..name
            end
            local cf = island:GetAttribute("SAA_Mark_"..name)
            if typeof(cf) == "CFrame" then
                return cf.Position+Vector3.new(0,5,0),"Island "..name
            end
        end
    end
    -- The config.Center is the island's actual horizontal center, not a safe Y.
    -- Raycast for solid land in the vicinity. Excludes player's character.
    local center=def.Center
    local char=Player.Character
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances=char and {char} or {}
    params.IgnoreWater=true
    for _, offset in ipairs({Vector3.zero,Vector3.new(45,0,0),Vector3.new(0,0,45),Vector3.new(-45,0,0)}) do
        local origin=Vector3.new(center.X+offset.X,650,center.Z+offset.Z)
        local hit=Workspace:Raycast(origin,Vector3.new(0,-1150,0),params)
        if hit and hit.Normal.Y > 0.45 and hit.Position.Y >= -10 then
            return hit.Position+Vector3.new(0,5,0),"Island ground"
        end
    end
    return nil,"Island ground not streamed; approach/load island first"
end

Aux.updateTravel = function()
    if not Aux.autoTravel then return end
    if isDungeonPlace() then
        travelStatus = "Travel disabled in dungeon interior"
        return
    end
    if Aux.travelBusy then return end
    local root=getRoot()
    if not root then travelStatus="Waiting for character" return end
    if travelLastChar ~= Player.Character then
        travelLastChar=Player.Character
        travelArrivedId=nil
    end
    local id=selectedTravelIsland
    if travelArrivedId==id then return end
    if os.clock()<travelNextTry then return end
    local destination,source=resolveIslandArrival(id)
    if not destination then
        travelStatus=source
        travelNextTry=os.clock()+1.5
        return
    end
    local distance=(root.Position-destination).Magnitude
    if distance < 14 then
        travelArrivedId=id
        travelStatus="Already at "..id
        return
    end
    cancelDungeonTween()
    dungeonMovementToken += 1
    travelLastGoal=destination
    local expected=travelGeneration+1
    travelGeneration=expected
    if travelMethod == "Teleport" then
        root.CFrame=CFrame.new(destination)
        travelArrivedId=id
        travelStatus="Teleported to "..id.." ("..source..")"
        return
    end
    Aux.travelBusy=true
    travelStatus=string.format("Tweening to %s: %.0f studs @ %d studs/s",id,distance,travelTweenSpeed)
    local duration=math.clamp(distance/travelTweenSpeed,0.2,90)
    local tween=TweenService:Create(root,TweenInfo.new(duration,Enum.EasingStyle.Linear),
        {CFrame=CFrame.new(destination)})
    currentTravelTween=tween
    tween.Completed:Connect(function(state)
        if expected~=travelGeneration or not running then return end
        currentTravelTween=nil
        Aux.travelBusy=false
        if state==Enum.PlaybackState.Completed then
            travelArrivedId=id
            travelStatus="Arrived at "..id.." via Tween"
        else
            travelStatus="Travel canceled or interrupted"
            travelNextTry=os.clock()+0.8
        end
    end)
    tween:Play()
end

