-- AUTOMATION COORDINATOR / TOGGLE WATCHERS
-- Priority:
--   Boss > Auto Sell > Auto All Quest > Auto Progression
--        > Regular Fishing
--==============================================================

Systems.CoordinatorToggleKeys = {
    "Enabled",
    "AutoSkills",
    "AutoLookAtWater",
    "AutoSellEnabled",
    "AntiAFK",
    "AFKWatchdog",
    "AutoEquipRod",
    "AutoEquipBestRod",
    "AutoEquipBestSkills",
    "AutoBuyNextRod",
    "AutoEquipBestAura",
    "AutoEquipBestRodSkin",
    "AutoEquipBestTitle",
    "AutoAllQuests",
    "AutoProgression",
    "AutoBossFarm",
    "BossReturnAfterEvent",
    "AutoEquipBait",
    "BaitFallbackToWorm",
    "AutoDailyReward",
    "AutoGroupReward",
    "FishESP",
    "BossRegionESP",
    "NpcESP",
}

function Systems.setCoordinatorOwner(owner, status)
    owner = owner or "Idle"
    status = status or owner

    if State.CoordinatorOwner ~= owner then
        State.CoordinatorPreviousOwner =
            State.CoordinatorOwner

        State.CoordinatorOwner =
            owner

        State.CoordinatorChangedAt =
            os.clock()

        State.CoordinatorTransitions += 1

        log(
            "Coordinator:",
            tostring(State.CoordinatorPreviousOwner),
            "->",
            tostring(owner)
        )
    end

    State.CoordinatorStatus =
        status
end

function Systems.stepToggleWatchers()
    local snapshot =
        State.ToggleWatchSnapshot

    for _, key in ipairs(
        Systems.CoordinatorToggleKeys
    ) do
        local value =
            Config[key]

        if snapshot[key] ~= value then
            local previous =
                snapshot[key]

            snapshot[key] =
                value

            State.CoordinatorForceRecheck =
                true

            if key == "AutoSkills" then
                State.NextSkillAt = 0

            elseif key == "AutoLookAtWater" then
                State.WaterLookReadyAt = 0
                State.WaterLookDirection = nil
                State.AutoLookTurnGeneration += 1

            elseif key == "AutoSellEnabled" then
                State.LastAutoSellCheck = 0
                State.AutoSellBlocked = false

            elseif key == "AutoEquipRod" then
                State.AutoEquipRodLastAt = 0
                State.AutoEquipRodPendingUntil = 0

                if value == true then
                    State.AutoEquipRodStatus =
                        "Armed"
                else
                    State.AutoEquipRodStatus =
                        "Off"
                end

            elseif key == "AutoEquipBestRod"
                or key == "AutoBuyNextRod" then

                State.LastRodAutomationCheck = 0

            elseif key == "AutoEquipBestSkills" then
                State.LastBestSkillCheck = 0
                State.LastSkillTransferRodId = nil

            elseif key == "AutoEquipBestAura"
                or key == "AutoEquipBestRodSkin"
                or key == "AutoEquipBestTitle" then

                State.LastExtraEquipmentCheck = 0

            elseif key == "AutoAllQuests" then
                State.LastQuestCheck = 0

                if value ~= true
                    and State.CoordinatorOwner == "Quest" then
                    Systems.clearQuestOverrides()
                end

            elseif key == "AutoProgression" then
                State.LastProgressionCheck = 0

                if value ~= true then
                    State.ProgressionTargetIslandId = nil
                    State.ProgressionTargetQuestId = nil
                end

            elseif key == "AutoBossFarm" then
                State.BossLastCheck = 0

                if value ~= true
                    and State.BossSessionActive
                    and Systems.endBossSession then

                    Systems.endBossSession(
                        "Auto Boss Farm disabled"
                    )
                end

            elseif key == "AutoEquipBait"
                or key == "BaitFallbackToWorm" then

                State.LastBaitCheck = 0

            elseif key == "AutoDailyReward"
                or key == "AutoGroupReward" then

                State.LastRewardCheck = 0

            elseif key == "FishESP"
                or key == "BossRegionESP"
                or key == "NpcESP" then

                State.LastESPUpdate = 0
            end

            if previous ~= nil then
                if key == "Enabled" then
                    log(
                        "Watcher:",
                        key,
                        tostring(previous),
                        "->",
                        tostring(value),
                        "source="
                            .. tostring(
                                State.LastEnabledSource
                            )
                    )
                else
                    log(
                        "Watcher:",
                        key,
                        tostring(previous),
                        "->",
                        tostring(value)
                    )
                end
            end
        end
    end
end

function Systems.hasAutoQuestWork(data)
    if not Config.AutoAllQuests then
        return false
    end

    data =
        data
        or getPlayerData()

    if not data then
        return true
    end

    if Systems.getCurrentQuest(data) then
        return true
    end

    return Systems.getNextAllQuestId(
        data
    ) ~= nil
end

function Systems.isAutoSellWorkPending(data)
    if not Config.AutoSellEnabled then
        return false
    end

    if State.AutoSellBusy then
        return true
    end

    data =
        data
        or getPlayerData()

    if not data then
        return false
    end

    local count, capacity =
        getFishCountAndCapacity(data)

    return capacity > 0
        and count >= capacity
end

function Systems.hasSelectedBossEventActive()
    if not Config.AutoBossFarm then
        return false
    end

    if State.BossSessionActive then
        return true
    end

    local weatherId, bossId =
        Systems.getActiveBossWeather()

    return weatherId ~= nil
        and bossId ~= nil
        and Config.BossesToFarm[bossId] == true
end

function Systems.hasPostBossTaskIntent()
    local data =
        getPlayerData()

    if Systems.hasAutoQuestWork(
        data
    ) then
        return true
    end

    if Config.AutoProgression then
        return true
    end

    return false
end

function Systems.ensureCoordinatorFishing(owner)
    if owner ~= "Quest"
        and owner ~= "Progression"
        and owner ~= "Boss" then

        return
    end

    if Config.Enabled
        or State.OPShutdownBusy then

        return
    end

    if State.FullAutoManualDisabled then
        State.CoordinatorStatus =
            "Full Auto manually disabled"

        return
    end

    Systems.setEnabled(
        true,
        "coordinator:" .. tostring(owner)
    )

    if Systems.syncUIFromConfig then
        Systems.syncUIFromConfig()
    end
end

function Systems.chooseCoordinatorOwner(data)
    if Systems.isAutoSellWorkPending(
        data
    ) then
        return "AutoSell",
            "Inventory full; selling before resuming Boss/task"
    end

    if State.BossSessionActive
        or State.BossPreemptRequested then

        return "Boss",
            "Boss event has priority after Auto Sell"
    end

    if Systems.hasAutoQuestWork(
        data
    ) then
        local current =
            data
            and Systems.getCurrentQuest(data)
            or nil

        return "Quest",
            current
            and (
                "Working quest: "
                .. tostring(current.Id)
            )
            or "Finding next Auto All Quest"
    end

    if Config.AutoProgression then
        return "Progression",
            "Auto To Last Island"
    end

    if Config.Enabled then
        return "Fishing",
            "Regular auto fishing"
    end

    return "Idle",
        "Waiting for enabled automation"
end

function Systems.stepCoordinatorOwner(owner)
    if owner == "Boss" then
        Systems.ensureCoordinatorFishing(
            "Boss"
        )
        return

    elseif owner == "AutoSell" then
        Systems.stepAutoSell()
        return

    elseif owner == "Quest" then
        Systems.ensureCoordinatorFishing(
            "Quest"
        )

        Systems.stepQuestAutomation()

        -- Quest-required rod overrides must beat generic best-rod logic.
        Systems.stepRodAutomation()
        return

    elseif owner == "Progression" then
        Systems.ensureCoordinatorFishing(
            "Progression"
        )

        Systems.stepAutoProgression()
        return

    end

    Systems.stepRodAutomation()
end

function Systems.stepAutomationCoordinator(
    bossOwnsAutomation
)
    Systems.stepToggleWatchers()

    local data =
        getPlayerData()

    if Systems.isAutoSellWorkPending(
        data
    ) then
        Systems.setCoordinatorOwner(
            "AutoSell",
            State.BossSessionActive
            and "Inventory full; pausing Boss to sell"
            or "Inventory full; selling"
        )

        Systems.stepCoordinatorOwner(
            "AutoSell"
        )

        State.CoordinatorForceRecheck =
            false

        State.CoordinatorLastCheck =
            os.clock()

        return "AutoSell"
    end

    if bossOwnsAutomation
        or State.BossSessionActive then

        State.BossPreemptRequested =
            true

        Systems.setCoordinatorOwner(
            "Boss",
            "Boss event has priority"
        )

        Systems.stepCoordinatorOwner(
            "Boss"
        )

        return "Boss"
    end

    State.BossPreemptRequested =
        false

    local owner, status =
        Systems.chooseCoordinatorOwner(
            data
        )

    Systems.setCoordinatorOwner(
        owner,
        status
    )

    Systems.stepCoordinatorOwner(
        owner
    )

    State.CoordinatorForceRecheck =
        false

    State.CoordinatorLastCheck =
        os.clock()

    return owner
end


--==============================================================
-- CLEAN OP SHUTDOWN
--==============================================================

function Systems.getFishingControllerSnapshot()
    local controllerState =
        getFishingState()

    local loadoutLocked =
        false

    if FishingController
        and type(
            FishingController.IsLoadoutLocked
        ) == "function" then

        local ok, value =
            pcall(function()
                return FishingController:
                    IsLoadoutLocked()
            end)

        if ok then
            loadoutLocked =
                value == true
        end
    end

    return controllerState,
        loadoutLocked
end

function Systems.isFishingControllerReleased()
    local controllerState,
        loadoutLocked =
        Systems.getFishingControllerSnapshot()

    local safeState =
        controllerState == FState.Idling
        or controllerState == FState.Holding

    local skillBusy =
        LocalPlayer:GetAttribute(
            "IsUsingSkill"
        ) == true

    return safeState
        and not loadoutLocked
        and not skillBusy,
        controllerState,
        loadoutLocked,
        skillBusy
end

function Systems.requestOPCancel(reason)
    mouseUp()

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    if FishingController
        and type(
            FishingController.CancelQtePrompt
        ) == "function" then

        pcall(function()
            FishingController:
                CancelQtePrompt()
        end)
    end

    State.OPCancelRequests += 1
    State.OPShutdownStatus =
        "Cancelling OP fishing"
        .. (
            reason
            and (
                " (" .. tostring(reason) .. ")"
            )
            or ""
        )

    return safeFire(
        FishingPackets.FishCancel
    )
end

function Systems.beginOPShutdown(reason)
    State.OPShutdownGeneration += 1

    local generation =
        State.OPShutdownGeneration

    State.OPShutdownBusy = true
    State.OPShutdownStatus =
        "Stopping OP fishing"

    -- Do not trust only State.Phase here. The game controller/server may
    -- still be in Waiting/Reeling/Result even if our local OP phase drifted.
    Systems.requestOPCancel(
        reason or "Full Auto disabled"
    )

    task.spawn(function()
        local startedAt =
            os.clock()

        local cancelRetryAt =
            startedAt
            + math.max(
                0.65,
                (
                    FishingConfig.General
                    and FishingConfig.General.CastCancelDelay
                    or 0.50
                )
                + 0.15
            )

        local deadline =
            startedAt
            + math.max(
                4.0,
                (
                    FishingConfig.Loot
                    and FishingConfig.Loot.ConfirmReadyDelay
                    or 0.75
                )
                + (
                    FishingConfig.General
                    and FishingConfig.General.ResultDisplayTime
                    or 1
                )
                + (
                    FishingConfig.General
                    and FishingConfig.General.CastCancelDelay
                    or 0.50
                )
                + 1.0
            )

        local retried =
            false

        while State.Alive
            and generation
                == State.OPShutdownGeneration
            and os.clock() < deadline do

            local released,
                controllerState,
                loadoutLocked,
                skillBusy =
                Systems.isFishingControllerReleased()

            if released then
                State.OPSessionActive =
                    false

                resetOPSession(
                    Config.Enabled
                    and Config.Mode == "OP"
                    and 0.10
                    or 0
                )

                State.OPShutdownBusy =
                    false

                State.OPShutdownStatus =
                    "OP fishing stopped cleanly"

                State.LastRodWatchCheck =
                    0

                return
            end

            State.OPShutdownStatus =
                "Waiting for fishing unlock: "
                .. tostring(
                    controllerState
                )
                .. (
                    loadoutLocked
                    and " [loadout locked]"
                    or ""
                )
                .. (
                    skillBusy
                    and " [skill active]"
                    or ""
                )

            -- One retry after the game's normal 0.5s cancel delay.
            -- This covers a cancel sent during a state transition without
            -- turning it into a packet-spam loop.
            if not retried
                and os.clock()
                    >= cancelRetryAt then

                retried = true

                Systems.requestOPCancel(
                    "cleanup retry"
                )
            end

            task.wait(0.05)
        end

        if generation
            ~= State.OPShutdownGeneration then
            return
        end

        -- Keep Auto Fishing off even if the controller took too long.
        -- Send one final cancel, then clear only our local OP engine state.
        Systems.requestOPCancel(
            "cleanup timeout"
        )

        State.OPSessionActive =
            false

        resetOPSession(
            Config.Enabled
            and Config.Mode == "OP"
            and 0.10
            or 0
        )

        State.OPShutdownBusy =
            false

        State.OPShutdownStatus =
            "OP cleanup timed out; final cancel sent"

        State.LastRodWatchCheck =
            0
    end)
end

--==============================================================
-- MODE / ENABLE CONTROL
--==============================================================

function Systems.stopCurrentCycle()
    mouseUp()

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    if Config.Mode == "OP" then
        local controllerState,
            loadoutLocked =
            Systems.getFishingControllerSnapshot()

        local controllerBusy =
            controllerState ~= FState.Idling
            and controllerState ~= FState.Holding

        if State.OPSessionActive
            or State.Phase ~= "Idle"
            or controllerBusy
            or loadoutLocked then

            Systems.requestOPCancel(
                "stop current cycle"
            )
        end
    end
end

function Systems.setMode(_value)
    if Config.Mode ~= "OP" then
        Config.Mode = "OP"
        State.LastPacketAt = os.clock()
        resetOPSession(
            Config.Enabled
            and 0.10
            or 0
        )
    end

    return "OP"
end

function Systems.setEnabled(value, source)
    local newValue = value == true
    source = tostring(source or "system")

    if source == "user" then
        State.FullAutoUserIntent =
            newValue

        State.FullAutoManualDisabled =
            not newValue

        State.FullAutoLastUserToggleAt =
            os.clock()

        State.CoordinatorForceRecheck =
            true
    end

    if Config.Enabled == newValue then
        State.LastEnabledSource =
            source
        return
    end

    Config.Enabled = newValue
    State.LastEnabledSource =
        source

    if Config.Enabled then
        Config.Mode = "OP"
        Systems.applyOptimalFishingSettings()

        -- Force the watchdog to validate the currently equipped rod
        -- and rebuild the fishing session before the next cast.
        State.LastObservedRodId = nil
        State.LastHeldRodToolId = nil
        State.WaitingForManualRod = true
        State.RodMissingSince = 0
        State.LastRodWatchCheck = 0
        State.LastSkillTransferRodId = nil

        if Config.Mode == "OP" then
            State.LastPacketAt =
                os.clock()

            if State.OPShutdownBusy then
                State.OPShutdownStatus =
                    "Waiting for previous OP cleanup"
            else
                resetOPSession(0.10)
            end
        else
            mouseUp()

            State.LastCastStarted = 0
            State.LastPrimaryClick = 0
            State.NextReelAt = 0
            State.NextSkillAt = 0
            State.NextLootClickAt = 0
            State.LegitResumeAt =
                os.clock() + 0.05

            State.CurrentFishingState =
                getFishingState()

            State.StateEnteredAt =
                os.clock()

            State.WaitingForManualRod =
                not hasHeldRodTool()

            if State.WaitingForManualRod then
                State.RodWatchStatus =
                    "Waiting for equipped rod"
            end
        end

        log("Enabled", "mode=" .. Config.Mode, "source=" .. source)
    else
        if Config.Mode == "OP" then
            Systems.beginOPShutdown(
                "Full Auto disabled"
            )
        else
            Systems.stopCurrentCycle()
        end

        State.WaitingForManualRod =
            false
        State.LastHeldRodToolId =
            nil
        State.RodWatchStatus =
            "Full Auto disabled"

        log("Disabled", "source=" .. source)
    end
end

