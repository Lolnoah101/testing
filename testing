end


--//============================================================
--// RUBBLE
--//============================================================

local function GetRubbleForArea(
    AreaNumber
)

    if not AreaNumber
        or AreaNumber < 1
    then

        return nil
    end


    local Map =
        GetCurrentMapConfig()


    if not Map
        or not Map.areas
    then

        return nil
    end


    local AreaConfig =
        Map.areas[
            AreaNumber
        ]


    if not AreaConfig
        or not AreaConfig.border
    then

        return nil
    end


    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    local WorldMap =
        World
        and World
            :FindFirstChild(
                "Map"
            )


    if not WorldMap then
        return nil
    end


    local Border =
        WorldMap
            :FindFirstChild(
                AreaConfig.border
            )


    if not Border then
        return nil
    end


    local Rubble =
        Border
            :FindFirstChild(
                "Rubble"
            )


    local Blocker =
        Border
            :FindFirstChild(
                "Blocker"
            )


    local RubbleBar =
        Blocker
        and Blocker
            :FindFirstChild(
                "RubbleBar"
            )


    local MaxHealth =
        Border:GetAttribute(
            "RubbleMaxHealth"
        )


    local Health = nil


    if MaxHealth ~= nil then

        Health =
            Border:GetAttribute(
                "RubbleHealth"
            )


        if Health == nil then
            Health = MaxHealth
        end
    end


    return {

        Area =
            AreaNumber,

        Border =
            Border,

        Rubble =
            Rubble,

        Blocker =
            Blocker,

        RubbleBar =
            RubbleBar,

        Health =
            Health,

        MaxHealth =
            MaxHealth,
    }
end


--//============================================================
--// RUBBLE Y
--//============================================================

local function GetRubbleY(Rubble)

    if not Rubble
        or not Rubble.Parent
    then

        return nil
    end


    if Rubble:IsA(
        "BasePart"
    )
    then

        return Rubble.Position.Y
    end


    if Rubble:IsA(
        "Model"
    )
    then

        return Rubble
            :GetPivot()
            .Position
            .Y
    end


    local Part =
        Rubble
            :FindFirstChildWhichIsA(
                "BasePart",
                true
            )


    if Part then
        return Part.Position.Y
    end


    return nil
end


local function RecordRubbleHeight(Info)

    if not Info
        or not Info.Rubble
    then

        return
    end


    if RubbleInitialY[
        Info.Area
    ] == nil
    then

        local Y =
            GetRubbleY(
                Info.Rubble
            )


        if Y then

            RubbleInitialY[
                Info.Area
            ] = Y
        end
    end
end


--//============================================================
--// RUBBLE OPEN
--//============================================================

local function IsRubblePhysicallyOpen(
    PreviousArea
)

    local Info =
        GetRubbleForArea(
            PreviousArea
        )


    local StartTime =
        RubbleBreakTime[
            PreviousArea
        ]


    if not StartTime then

        RubbleBreakTime[
            PreviousArea
        ] = os.clock()


        StartTime =
            RubbleBreakTime[
                PreviousArea
            ]
    end


    local Elapsed =
        os.clock()
        - StartTime


    if Elapsed < RUBBLE_MIN_WAIT then
        return false
    end


    if not Info then
        return true
    end


    if Info.Blocker
        and Info.Blocker:IsA(
            "BasePart"
        )
        and Info.Blocker.CanCollide
            == false
    then

        return true
    end


    if not Info.Rubble
        or not Info.Rubble.Parent
    then

        return true
    end


    local InitialY =
        RubbleInitialY[
            PreviousArea
        ]


    local CurrentY =
        GetRubbleY(
            Info.Rubble
        )


    if InitialY
        and CurrentY
    then

        if (
            InitialY
            - CurrentY
        ) >= RUBBLE_DROP_DISTANCE
        then

            return true
        end
    end


    -- An empty health bar is NOT proof that the barrier has lowered.
    -- Wait for the actual collision/geometry change (or despawn) instead.
    -- The new game's AREA marker will be verified separately before travel.
    return false
end


