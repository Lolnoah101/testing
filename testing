local function GetDeliveryGroundPoint(
    Position
)
    if not Position then
        return nil
    end

    -- Delivery prompts sit on NPC/prop parts.  A simple
    -- downward ray can hit the NPC, bag, signs, or an
    -- overhead piece instead of the walkable floor.  Keep
    -- those models out of the ground probe and start the ray
    -- only a few studs above the interaction height.
    local Excludes = {
        GetCharacter()
    }

    local DeliveryJob =
        GetDeliveryJob()

    if DeliveryJob then
        table.insert(
            Excludes,
            DeliveryJob
        )
    end

    local NPC =
        GetDeliveryNPC()

    if NPC then
        table.insert(
            Excludes,
            NPC
        )
    end

    local Params =
        RaycastParams.new()

    Params.FilterType =
        Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances =
        Excludes

    Params.IgnoreWater =
        false

    local Origin =
        Position
        + Vector3.new(
            0,
            7,
            0
        )

    -- Skip non-collidable decorative hits if any remain.
    for _ = 1, 8 do
        local Result =
            Workspace:Raycast(
                Origin,
                Vector3.new(
                    0,
                    -35,
                    0
                ),
                Params
            )

        if not Result then
            break
        end

        if Result.Instance
            and Result.Instance.CanCollide
        then
            return Result.Position
        end

        if Result.Instance then
            table.insert(
                Excludes,
                Result.Instance
            )

            Params.FilterDescendantsInstances =
                Excludes

            Origin =
                Result.Position
                - Vector3.new(
                    0,
                    0.05,
                    0
                )
        else
            break
        end
    end

    return Position
end

local function GetDeliveryApproachCFrame(
    Prompt
)
    local PromptPosition =
        GetDeliveryPromptPosition(
            Prompt
        )

    if not PromptPosition then
        local NPC =
            GetDeliveryNPC()

        if NPC
            and Prompt:IsDescendantOf(NPC)
        then
            local Anchor =
                GetDeliveryNPCAnchorPart()

            if Anchor then
                PromptPosition =
                    Anchor.Position
            end
        end

        if not PromptPosition then
            return nil
        end
    end

    RequestDeliveryStreaming(
        PromptPosition
    )

    local RootPart =
        GetRootPart()

    local RootHeight =
        GetRootHeight()

    --====================================================
    -- DELIVERY START SPECIAL CASE
    --
    -- The bag is only a few studs from the Delivery Man's
    -- start prompt and is a much better navigation anchor
    -- than the NPC torso itself.  Path to the ground under
    -- the bag first; from there the start prompt is already
    -- inside its 7.5-stud activation radius.
    --====================================================

    if Prompt == GetDeliveryStartPrompt() then
        local BagPart =
            GetDeliveryBagPart()

        if BagPart then
            local BagGround =
                GetDeliveryGroundPoint(
                    BagPart.Position
                )

            if BagGround then
                local BagCandidate =
                    BagGround
                    + Vector3.new(
                        0,
                        RootHeight,
                        0
                    )

                local TestPath =
                    ComputePath(
                        RootPart.Position,
                        BagCandidate
                    )

                if TestPath then
                    return CFrame.new(
                        BagCandidate
                    )
                end
            end
        end
    end

    --====================================================
    -- DELIVERY BAG SPECIAL CASE
    --
    -- The bag itself sits inside the restaurant setup and
    -- isn't a reliable navmesh destination.  The game's own
    -- return marker (POI.Track.ChickenJob) is on the open
    -- walkway near the bag.  Build the final approach from
    -- that marker toward the bag so the destination stays
    -- inside prompt range but remains on walkable ground.
    --====================================================

    if Prompt == GetDeliveryBagPrompt() then
        local ReturnWaypoint =
            GetDeliveryReturnWaypoint()

        if ReturnWaypoint then
            local TowardReturn =
                Vector3.new(
                    ReturnWaypoint.Position.X
                        - PromptPosition.X,
                    0,
                    ReturnWaypoint.Position.Z
                        - PromptPosition.Z
                )

            if TowardReturn.Magnitude > 0.05 then
                local MaxDistance =
                    tonumber(
                        Prompt.MaxActivationDistance
                    ) or 7.5

                local Radius =
                    math.clamp(
                        MaxDistance - 1.25,
                        4.5,
                        6.25
                    )

                local Approximate =
                    PromptPosition
                    + (TowardReturn.Unit * Radius)

                local Ground =
                    GetDeliveryGroundPoint(
                        Approximate
                    )

                if Ground then
                    local Candidate =
                        Ground
                        + Vector3.new(
                            0,
                            RootHeight,
                            0
                        )

                    local TestPath =
                        ComputePath(
                            RootPart.Position,
                            Candidate
                        )

                    if TestPath then
                        return CFrame.new(
                            Candidate
                        )
                    end
                end
            end
        end
    end

    local FlatAway =
        Vector3.new(
            RootPart.Position.X
                - PromptPosition.X,
            0,
            RootPart.Position.Z
                - PromptPosition.Z
        )

    if FlatAway.Magnitude < 0.05 then
        FlatAway =
            Vector3.new(
                0,
                0,
                1
            )
    else
        FlatAway =
            FlatAway.Unit
    end

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 10

    -- Use most of the interaction radius instead of standing
    -- right beside the NPC.  This makes it much more likely
    -- the candidate sits on open navmesh while remaining well
    -- inside prompt range.
    local ApproachRadius =
        math.clamp(
            MaxDistance - 1.25,
            4.5,
            7
        )

    local Angles = {
        0,
        30,
        -30,
        60,
        -60,
        90,
        -90,
        120,
        -120,
        150,
        -150,
        180,
    }

    local Fallback = nil

    for _, Degrees in ipairs(
        Angles
    ) do
        local Rotation =
            CFrame.Angles(
                0,
                math.rad(Degrees),
                0
            )

        local Direction =
            Rotation:VectorToWorldSpace(
                FlatAway
            )

        local ApproximateGround =
            PromptPosition
            + (
                Direction
                * ApproachRadius
            )

        local Ground =
            GetDeliveryGroundPoint(
                ApproximateGround
            )

        if Ground then
            local Candidate =
                Ground
                + Vector3.new(
                    0,
                    RootHeight,
                    0
                )

            if not Fallback then
                Fallback =
                    CFrame.new(
                        Candidate
                    )
            end

            local TestPath =
                ComputePath(
                    RootPart.Position,
                    Candidate
                )

            if TestPath then
                return CFrame.new(
                    Candidate
                )
            end
        end
    end

    return Fallback
end

local function IsDeliveryJobActive()
    local StartPrompt =
        GetDeliveryStartPrompt()

    -- If the restaurant is streamed in, the start prompt is
    -- the strongest source of truth and also refreshes our
    -- persistent local state.
    if StartPrompt
        and StartPrompt.Parent
    then
        DeliveryKnownActive =
            StartPrompt.ObjectText
            == "End Delivery Job"

        return DeliveryKnownActive
    end

    -- While far from the restaurant its model may be streamed
    -- out completely.  In that case, customer/order state and
    -- Job events are more reliable than treating a missing
    -- prompt as "job inactive".
    if GetDeliveryNPC() then
        DeliveryKnownActive = true
        return true
    end

    local BagPrompt =
        GetDeliveryBagPrompt()

    if BagPrompt
        and BagPrompt.Parent
        and BagPrompt.Enabled
    then
        DeliveryKnownActive = true
        return true
    end

    if DeliveryAwaitingBagReturn
        or DeliveryServerDelivered
    then
        DeliveryKnownActive = true
        return true
    end

    return DeliveryKnownActive
end

local function DeliveryBagReady()
    local Prompt =
        GetDeliveryBagPrompt()

    return Prompt
        and Prompt.Parent
        and Prompt.Enabled
end

local function DeliveryWaitingForNPC()
    if not IsDeliveryJobActive() then
        return false
    end

    local BagPrompt =
        GetDeliveryBagPrompt()

    return BagPrompt
        and BagPrompt.Parent
        and not BagPrompt.Enabled
end

--========================================================
-- DELIVERY BAG DOOR BRIDGE
--
-- PathfindingService can treat the restaurant doorway as
-- disconnected navmesh even though the physical opening is
-- clear.  Once Tween has reached the game's ChickenJob
-- return marker, bridge only the short doorway segment with
-- the existing smooth Tween follower.  We first verify the
-- segment with the same character-width collision rays used
-- by the Tween corner smoother.
--========================================================

local function GetDeliveryBagDoorTarget(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local ReturnWaypoint =
        GetDeliveryReturnWaypoint()

    local PromptPosition =
        GetDeliveryPromptPosition(
            Prompt
        )

    if not ReturnWaypoint
        or not PromptPosition
    then
        return nil
    end

    -- The restaurant's entrance is directly in front of the
    -- ChickenJob return marker.  The previous bridge aimed
    -- diagonally at the bag, which could cut across the wall/
    -- counter geometry.  Cross the facade on one axis first,
    -- then let normal pathfinding handle the inside turn.
    local Difference =
        PromptPosition
        - ReturnWaypoint.Position

    local DoorDirection

    if math.abs(Difference.X)
        >= math.abs(Difference.Z)
    then
        DoorDirection =
            Vector3.new(
                Difference.X >= 0 and 1 or -1,
                0,
                0
            )
    else
        DoorDirection =
            Vector3.new(
                0,
                0,
                Difference.Z >= 0 and 1 or -1
            )
    end

    -- About 5 studs inward from the game's outside return
    -- marker places us fully inside the doorway without
    -- aiming at the bag/counter.
    local Approximate =
        ReturnWaypoint.Position
        + (DoorDirection * 5)

    local Ground =
        GetDeliveryGroundPoint(
            Approximate
        )

    if not Ground then
        return nil
    end

    return CFrame.new(
        Ground
        + Vector3.new(
            0,
            GetRootHeight(),
            0
        )
    )
end

local function GetDeliveryBagInteractionCFrame(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return nil
    end

    local PromptPosition =
        GetDeliveryPromptPosition(
            Prompt
        )

    if not PromptPosition then
        return nil
    end

    local RootPart =
        GetRootPart()

    local MaxDistance =
        tonumber(
            Prompt.MaxActivationDistance
        ) or 7.5

    local CurrentDistance =
        (
            RootPart.Position
            - PromptPosition
        ).Magnitude

    -- If we are already safely inside the prompt radius,
    -- keep the current position.  Do not move closer than needed.
    if CurrentDistance
        <= math.max(
            1,
            MaxDistance - 0.75
        )
    then
        return CFrame.new(
            RootPart.Position
        )
    end

    -- IMPORTANT:
    -- The bag sits behind/on the service counter.  A ray cast all
    -- the way toward the bag is EXPECTED to hit that counter, so
    -- "clear line to bag" is the wrong test here.  We only need to
    -- stand on the CUSTOMER SIDE while inside the 7.5-stud prompt
    -- sphere.
    --
    -- Use our current customer-side direction away from the bag and
    -- stop roughly 4.25 studs horizontally from the prompt.  This is
    -- close enough to interact while still leaving room for the
    -- counter between the character and the bag.

    local Away =
        Vector3.new(
            RootPart.Position.X
                - PromptPosition.X,
            0,
            RootPart.Position.Z
                - PromptPosition.Z
        )

    if Away.Magnitude < 0.05 then
        local ReturnWaypoint =
            GetDeliveryReturnWaypoint()

        if ReturnWaypoint then
            Away =
                Vector3.new(
                    ReturnWaypoint.Position.X
                        - PromptPosition.X,
                    0,
                    ReturnWaypoint.Position.Z
                        - PromptPosition.Z
                )
        end
    end

    if Away.Magnitude < 0.05 then
        Away =
            Vector3.new(
                -1,
                0,
                0
            )
    else
        Away =
            Away.Unit
    end

    local DesiredHorizontalDistance =
        math.min(
            4.25,
            math.max(
                3.25,
                MaxDistance - 3.0
            )
        )

    local Target =
        Vector3.new(
            PromptPosition.X
                + Away.X
                * DesiredHorizontalDistance,
            RootPart.Position.Y,
            PromptPosition.Z
                + Away.Z
                * DesiredHorizontalDistance
        )

    -- If this still ends up outside the true 3D prompt radius because
    -- of height difference, pull the point inward in small steps while
    -- staying on the same customer-side line.
    local SafeDistance =
        math.max(
            1,
            MaxDistance - 0.85
        )

    for _ = 1, 8 do
        local PromptDistance =
            (
                Target
                - PromptPosition
            ).Magnitude

        if PromptDistance <= SafeDistance then
            break
        end

        DesiredHorizontalDistance =
            math.max(
                2.25,
                DesiredHorizontalDistance - 0.35
            )

        Target =
            Vector3.new(
                PromptPosition.X
                    + Away.X
                    * DesiredHorizontalDistance,
                RootPart.Position.Y,
                PromptPosition.Z
                    + Away.Z
                    * DesiredHorizontalDistance
            )
    end

    return CFrame.new(
        Target
    )
end

local function TryDeliveryBagInteriorApproach(
    Prompt,
    IgnoreEnabled
)
    if Settings.JobFarmingMethod ~= "Tween"
        or not Settings.AutoDelivery
        or not Prompt
        or not Prompt.Parent
    then
        return false
    end

    -- Use strict bag range here.  Do not use the generic +0.75
    -- tolerance because that can stop before the prompt is usable.
    if IsDeliveryBagSafelyInRange(
        Prompt,
        IgnoreEnabled
    ) then
        return true
    end

    local Target =
        GetDeliveryBagInteractionCFrame(
            Prompt
        )

    if not Target then
        warn(
            "[Delivery] Could not build customer-side bag point"
        )

        return false
    end

    local RootPart =
        GetRootPart()

    local Distance =
        (
            RootPart.Position
            - Target.Position
        ).Magnitude

    -- This helper is only for the small interior section.
    if Distance > 24 then
        return false
    end

    print(
        "[Delivery] Moving to counter pickup range | prompt distance:",
        string.format(
            "%.2f",
            GetDeliveryPromptDistance(
                Prompt
            )
        )
    )

    local Generation =
        MovementGeneration

    local Success =
        FollowSmoothPath(
            {
                RootPart.Position,
                Target.Position,
            },

            function()
                return Settings.AutoDelivery
            end,

            function()
                return false
            end,

            Generation
        )

    if not Success
        or not Settings.AutoDelivery
    then
        return false
    end

    -- Reacquire because the server can reset/replace state while
    -- we are walking back after a completed delivery.
    local CurrentPrompt =
        GetDeliveryBagPrompt()
        or Prompt

    local InRange =
        IsDeliveryBagSafelyInRange(
            CurrentPrompt,
            IgnoreEnabled
        )

    print(
        "[Delivery] Counter approach finished | prompt distance:",
        string.format(
            "%.2f",
            GetDeliveryPromptDistance(
                CurrentPrompt
            )
        ),
        "| in range:",
        tostring(InRange)
    )

    return InRange
end

local function TryDeliveryBagDoorBridge(
    Prompt,
    IgnoreEnabled
)
    if Settings.JobFarmingMethod ~= "Tween"
        or not Settings.AutoDelivery
        or not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if IsDeliveryBagSafelyInRange(
        Prompt,
        IgnoreEnabled
    ) then
        return true
    end

    local Target =
        GetDeliveryBagDoorTarget(
            Prompt
        )

    if not Target then
        return false
    end

    local RootPart =
        GetRootPart()

    local Distance =
        (
            RootPart.Position
            - Target.Position
        ).Magnitude

    -- Door bridge is only for the short restaurant entrance.
    if Distance > 18 then
        return false
    end

    RequestDeliveryStreaming(
        Target.Position
    )

    -- Give the entrance geometry a moment to stream, then
    -- cross straight through the doorway.  The generic
    -- character-width route test is safe here because the
    -- target is no longer diagonal through the wall.
    for Attempt = 1, 10 do
        if not Settings.AutoDelivery then
            return false
        end

        if IsDeliveryBagSafelyInRange(
            Prompt,
            IgnoreEnabled
        ) then
            return true
        end

        RootPart =
            GetRootPart()

        if IsRouteClear(
            RootPart.Position,
            Target.Position
        ) then
            print(
                "[Delivery] Crossing restaurant doorway"
            )

            local Generation =
                MovementGeneration

            local Success =
                FollowSmoothPath(
                    {
                        RootPart.Position,
                        Target.Position,
                    },

                    function()
                        return Settings.AutoDelivery
                    end,

                    function()
                        return false
                    end,

                    Generation
                )

            if not Success
                or not Settings.AutoDelivery
            then
                return false
            end

            if IsDeliveryPromptInRange(
                Prompt,
                0.75,
                IgnoreEnabled
            ) then
                return true
            end

            -- We are now inside the restaurant.  Do not ask
            -- PathfindingService to reach the bag/counter.
            -- Move directly to a clear point already inside the
            -- prompt radius on the customer side of the counter.
            task.wait(0.1)

            print(
                "[Delivery] Inside restaurant - approaching counter"
            )

            if TryDeliveryBagInteriorApproach(
                Prompt,
                IgnoreEnabled
            ) then
                return true
            end

            return IsDeliveryPromptInRange(
                Prompt,
                0.75,
                IgnoreEnabled
            )
        end

        task.wait(0.15)
    end

    return false
end

--========================================================
-- MOVE TO / TRIGGER A DELIVERY PROMPT
--========================================================

local function MoveToDeliveryPrompt(
    Prompt,
    Label
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if IsDeliveryPromptInRange(
        Prompt,
        0.75
    ) then
        return true
    end

    local PromptPosition =
        GetDeliveryPromptPosition(
            Prompt
        )

    RequestDeliveryStreaming(
        PromptPosition
    )

    --====================================================
    -- BAG RETURN STAGING
    --
    -- After a customer delivery the game's own client points
    -- back to POI.Track.ChickenJob.  Use that open waypoint
    -- for the long leg of the return trip, then compute only
    -- the short final approach to the bag.
    --====================================================

    if Label == "bag pickup"
        and Settings.AutoDelivery
    then
        local ReturnWaypoint =
            GetDeliveryReturnWaypoint()

        if ReturnWaypoint then
            local RootPart =
                GetRootPart()

            local FlatDistance =
                Vector3.new(
                    RootPart.Position.X
                        - ReturnWaypoint.Position.X,
                    0,
                    RootPart.Position.Z
                        - ReturnWaypoint.Position.Z
                ).Magnitude

            -- If we're returning from a customer, don't ask
            -- pathfinding to solve the bag prop as one long
            -- route.  Go to the game's own restaurant marker.
            if FlatDistance > 18 then
                print(
                    "[Delivery] Returning to restaurant waypoint"
                )

                RequestDeliveryStreaming(
                    ReturnWaypoint.Position
                )

                local ReturnGround =
                    GetDeliveryGroundPoint(
                        ReturnWaypoint.Position
                    )

                if ReturnGround then
                    local ReturnTarget =
                        CFrame.new(
                            ReturnGround
                            + Vector3.new(
                                0,
                                GetRootHeight(),
                                0
                            )
                        )

                    MoveToJobTarget(
                        ReturnTarget,

                        function()
                            return Settings.AutoDelivery
                        end
                    )
                end

                if not Settings.AutoDelivery then
                    return false
                end

                if IsDeliveryPromptInRange(
                    Prompt,
                    0.75
                ) then
                    return true
                end

                -- The long return leg is complete.  Refresh
                -- streaming and compute a fresh short path.
                RequestDeliveryStreaming(
                    PromptPosition
                )

                task.wait(0.1)
            end
        end

        -- The restaurant doorway is a known navmesh break.
        -- Once the long path has brought us to the return
        -- marker, use a short collision-checked Tween bridge
        -- instead of asking PathfindingService to cross it.
        if TryDeliveryBagDoorBridge(
            Prompt
        ) then
            return true
        end
    end

    -- If we are already inside/near the restaurant, avoid
    -- navmesh entirely for the last few studs to the bag.
    if Label == "bag pickup"
        and TryDeliveryBagInteriorApproach(
            Prompt
        )
    then
        return true
    end

    local Target =
        GetDeliveryApproachCFrame(
            Prompt
        )

    if not Target then
        warn(
            "[Delivery] Missing approach target for:",
            Label
        )

        return false
    end

    print(
        "[Delivery] Going to:",
        Label
    )

    local Reached =
        MoveToJobTarget(
            Target,

            function()
                return Settings.AutoDelivery
            end
        )

    if IsDeliveryPromptInRange(
        Prompt,
        0.75
    ) then
        return true
    end

    --====================================================
    -- JOB START / BAG FALLBACK
    --====================================================

    if not Reached
        and Settings.AutoDelivery
        and (
            Label == "job start"
            or Label == "bag pickup"
        )
    then
        local StagePart

        if Label == "bag pickup" then
            StagePart =
                GetDeliveryReturnWaypoint()
        else
            StagePart =
                GetDeliveryAreaPart()
        end

        if StagePart then
            if Label == "bag pickup" then
                print(
                    "[Delivery] Retrying from restaurant waypoint"
                )
            else
                print(
                    "[Delivery] Staging near delivery job"
                )
            end

            RequestDeliveryStreaming(
                StagePart.Position
            )

            local StageGround =
                GetDeliveryGroundPoint(
                    StagePart.Position
                )

            if StageGround then
                local StageTarget =
                    CFrame.new(
                        StageGround
                        + Vector3.new(
                            0,
                            GetRootHeight(),
                            0
                        )
                    )

                MoveToJobTarget(
                    StageTarget,

                    function()
                        return Settings.AutoDelivery
                    end
                )
            end

            if IsDeliveryPromptInRange(
                Prompt,
                0.75
            ) then
                return true
            end

            if Label == "bag pickup"
                and TryDeliveryBagDoorBridge(
                    Prompt
                )
            then
                return true
            end

            local RetryTarget =
                GetDeliveryApproachCFrame(
                    Prompt
                )

            if RetryTarget then
                Reached =
                    MoveToJobTarget(
                        RetryTarget,

                        function()
                            return Settings.AutoDelivery
                        end
                    )
            end
        end
    end

    if IsDeliveryPromptInRange(
        Prompt,
        0.75
    ) then
        return true
    end

    return Reached
end

local function TriggerDeliveryPromptUntil(
    Prompt,
    FinishedCondition,
    Timeout
)
    Timeout =
        Timeout or 5

    local Started =
        os.clock()

    local LastTrigger =
        0

    while Settings.AutoDelivery
        and os.clock() - Started < Timeout
    do
        if FinishedCondition() then
            return true
        end

        if not Prompt
            or not Prompt.Parent
        then
            return FinishedCondition()
        end

        if Prompt.Enabled
            and os.clock() - LastTrigger
                >= Settings.DeliveryRetryDelay
        then
            TriggerPrompt(
                Prompt
            )

            LastTrigger =
                os.clock()
        end

        task.wait(0.05)
    end

    return FinishedCondition()
end

--========================================================
-- START DELIVERY JOB
--========================================================

local function StartDeliveryJobState()
    local Prompt =
        GetDeliveryStartPrompt()

    if not Prompt then
        return false
    end

    if IsDeliveryJobActive() then
        return true
    end

    local Reached =
        MoveToDeliveryPrompt(
            Prompt,
            "job start"
        )

    if not Reached
        or not Settings.AutoDelivery
    then
        return false
    end

    print(
        "[Delivery] Starting job"
    )

    return TriggerDeliveryPromptUntil(
        Prompt,

        function()
            return IsDeliveryJobActive()
                or DeliveryBagReady()
        end,

        5
    )
end

--========================================================
-- PICK UP DELIVERY BAG
--========================================================

local function PickupDeliveryBag()
    local Prompt =
        GetDeliveryBagPrompt()

    if not Prompt then
        return false
    end

    if not Prompt.Enabled then
        return true
    end

    -- Make sure we are ACTUALLY inside the bag's real activation
    -- range before firing it.  This is especially important on the
    -- second loop after returning through the restaurant doorway.
    if not IsDeliveryBagSafelyInRange(
        Prompt,
        false
    ) then
        local Reached =
            MoveToDeliveryPrompt(
                Prompt,
                "bag pickup"
            )

        Prompt =
            GetDeliveryBagPrompt()
            or Prompt

        if not Reached
            or not Settings.AutoDelivery
            or not IsDeliveryBagSafelyInRange(
                Prompt,
                false
            )
        then
            -- One final deterministic counter-side approach, without
            -- asking PathfindingService to solve the bag position.
            TryDeliveryBagInteriorApproach(
                Prompt,
                false
            )

            Prompt =
                GetDeliveryBagPrompt()
                or Prompt
        end
    end

    if not Settings.AutoDelivery
        or not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if not Prompt.Enabled then
        return true
    end

    if not IsDeliveryBagSafelyInRange(
        Prompt,
        false
    ) then
        warn(
            "[Delivery] Bag is enabled but still outside real pickup range | distance:",
            string.format(
                "%.2f",
                GetDeliveryPromptDistance(
                    Prompt
                )
            )
        )

        return false
    end

    print(
        "[Delivery] Picking up bag | distance:",
        string.format(
            "%.2f",
            GetDeliveryPromptDistance(
                Prompt
            )
        )
    )

    return TriggerDeliveryPromptUntil(
        Prompt,

        function()
            local Current =
                GetDeliveryBagPrompt()

            return Current
                and Current.Parent
                and not Current.Enabled
        end,

        5
    )
end

--========================================================
-- WAIT FOR DELIVERY NPC
--========================================================

local function WaitForDeliveryNPCPrompt()
    local Started =
        os.clock()

    while Settings.AutoDelivery
        and os.clock() - Started
            < Settings.DeliveryNPCWaitTimeout
    do
        local Prompt =
            GetDeliveryNPCPrompt()

        if Prompt
            and Prompt.Parent
        then
            return Prompt
        end

        -- If the bag already came back, the previous
        -- delivery completed and there is no NPC to wait for.
        if DeliveryBagReady() then
            return nil
        end

        task.wait(0.1)
    end

    return nil
end

--========================================================
-- RETURN / RECOVER DELIVERY RESTAURANT
--========================================================

local function ReturnToDeliveryRestaurant(
    Reason
)
    local ReturnWaypoint =
        GetDeliveryReturnWaypoint()

    if not ReturnWaypoint
        or not ReturnWaypoint.Parent
    then
        return false
    end

    if Reason then
        print(
            "[Delivery] " .. Reason
        )
    end

    RequestDeliveryStreaming(
        ReturnWaypoint.Position
    )

    local RootPart =
        GetRootPart()

    local FlatDistance =
        Vector3.new(
            RootPart.Position.X
                - ReturnWaypoint.Position.X,
            0,
            RootPart.Position.Z
                - ReturnWaypoint.Position.Z
        ).Magnitude

    if FlatDistance > 12 then
        local ReturnGround =
            GetDeliveryGroundPoint(
                ReturnWaypoint.Position
            )

        if ReturnGround then
            local ReturnTarget =
                CFrame.new(
                    ReturnGround
                    + Vector3.new(
                        0,
                        GetRootHeight(),
                        0
                    )
                )

            local Reached =
                MoveToJobTarget(
                    ReturnTarget,

                    function()
                        return Settings.AutoDelivery
                    end
                )

            if not Reached
                and Settings.AutoDelivery
            then
                return false
            end
        end
    end

    RequestDeliveryStreaming(
        ReturnWaypoint.Position
    )

    task.wait(0.35)

    return true
end

--========================================================
-- WAIT FOR NEXT DELIVERY BAG
--========================================================

local function WaitForDeliveryBagReturn()
    DeliveryKnownActive = true
    DeliveryAwaitingBagReturn = true

    print(
        "[Delivery] Waiting for next bag"
    )

    -- Return immediately.  Do not wait at the customer for the
    -- prompt reset because the restaurant may be streamed out.
    ReturnToDeliveryRestaurant(
        "Returning after delivery"
    )

    local Started =
        os.clock()

    local LastApproach = 0
    local LastStatus = 0

    while Settings.AutoDelivery do
        -- Always fetch the CURRENT prompt; do not keep the object that
        -- existed before the previous order was delivered.
        local BagPrompt =
            GetDeliveryBagPrompt()

        if BagPrompt
            and BagPrompt.Parent
        then
            local SafeRange =
                IsDeliveryBagSafelyInRange(
                    BagPrompt,
                    true
                )

            -- Getting physically into pickup range has priority over
            -- Prompt.Enabled.  The bag may reset while we are walking,
            -- and we still want to end up beside it either way.
            if not SafeRange
                and os.clock() - LastApproach >= 0.55
            then
                LastApproach =
                    os.clock()

                local RootPart =
                    GetRootPart()

                local ReturnWaypoint =
                    GetDeliveryReturnWaypoint()

                if ReturnWaypoint then
                    local FlatDistance =
                        Vector3.new(
                            RootPart.Position.X - ReturnWaypoint.Position.X,
                            0,
                            RootPart.Position.Z - ReturnWaypoint.Position.Z
                        ).Magnitude

                    if FlatDistance > 18 then
                        ReturnToDeliveryRestaurant(
                            "Returning to bag"
                        )
                    end
                end

                BagPrompt =
                    GetDeliveryBagPrompt()
                    or BagPrompt

                if not IsDeliveryBagSafelyInRange(
                    BagPrompt,
                    true
                ) then
                    TryDeliveryBagDoorBridge(
                        BagPrompt,
                        true
                    )
                end

                BagPrompt =
                    GetDeliveryBagPrompt()
                    or BagPrompt

                if not IsDeliveryBagSafelyInRange(
                    BagPrompt,
                    true
                ) then
                    TryDeliveryBagInteriorApproach(
                        BagPrompt,
                        true
                    )
                end

                BagPrompt =
                    GetDeliveryBagPrompt()
                    or BagPrompt

                SafeRange =
                    IsDeliveryBagSafelyInRange(
                        BagPrompt,
                        true
                    )
            end

            -- Do not leave reset-wait state merely because Enabled=true.
            -- We also require real, safely-inside pickup distance.
            if BagPrompt.Enabled
                and SafeRange
            then
                DeliveryAwaitingBagReturn = false
                DeliveryServerDelivered = false

                print(
                    "[Delivery] Next bag ready and in pickup range | distance:",
                    string.format(
                        "%.2f",
                        GetDeliveryPromptDistance(
                            BagPrompt
                        )
                    )
                )

                return true
            end

            if os.clock() - LastStatus >= 1.5 then
                LastStatus =
                    os.clock()

                print(
                    "[Delivery] Bag return state | enabled:",
                    tostring(BagPrompt.Enabled),
                    "| distance:",
                    string.format(
                        "%.2f",
                        GetDeliveryPromptDistance(
                            BagPrompt
                        )
                    ),
                    "| safe range:",
                    tostring(SafeRange)
                )
            end

        else
            ReturnToDeliveryRestaurant(
                "Recovering bag prompt"
            )
        end

        -- Only accept a true job-end signal while the restaurant's
        -- visible start prompt is loaded and explicitly says the job ended.
        local StartPrompt =
            GetDeliveryStartPrompt()

        if StartPrompt
            and StartPrompt.Parent
            and StartPrompt.ObjectText ~= "End Delivery Job"
        then
            DeliveryKnownActive = false
            DeliveryAwaitingBagReturn = false
            DeliveryServerDelivered = false

            return false
        end

        if os.clock() - Started
            >= Settings.DeliveryBagReturnTimeout
        then
            Started =
                os.clock()

            local CurrentPrompt =
                GetDeliveryBagPrompt()

            print(
                "[Delivery] Bag reset check | prompt:",
                CurrentPrompt and "found" or "missing",
                "| enabled:",
                CurrentPrompt and tostring(CurrentPrompt.Enabled) or "n/a",
                "| distance:",
                CurrentPrompt and string.format(
                    "%.2f",
                    GetDeliveryPromptDistance(
                        CurrentPrompt
                    )
                ) or "n/a"
            )

            ReturnToDeliveryRestaurant(
                "Refreshing restaurant state"
            )
        end

        task.wait(0.1)
    end

    return false
end

--========================================================
-- DELIVER TO NPC
--========================================================

local function DeliverToNPC()
    local Prompt =
        WaitForDeliveryNPCPrompt()

    if not Prompt then
        if DeliveryBagReady() then
            return true
        end

        if DeliveryAwaitingBagReturn
            or DeliveryServerDelivered
        then
            return WaitForDeliveryBagReturn()
        end

        return false
    end

    local NPC =
        GetDeliveryNPC()

    print(
        "[Delivery] NPC found:",
        NPC and NPC.Name or "Unknown"
    )

    local Reached =
        MoveToDeliveryPrompt(
            Prompt,
            "customer"
        )

    if not Reached
        or not Settings.AutoDelivery
    then
        return false
    end

    print(
        "[Delivery] Delivering order"
    )

    DeliveryServerDelivered = false

    local Accepted =
        TriggerDeliveryPromptUntil(
            Prompt,

            function()
                -- Best signal: the game's own Delivered event.
                if DeliveryServerDelivered then
                    return true
                end

                -- Fallbacks for cases where the dynamic customer
                -- is removed/disabled before the bag comes back.
                if DeliveryBagReady() then
                    return true
                end

                if not Prompt.Parent
                    or not Prompt.Enabled
                then
                    return true
                end

                return GetDeliveryNPC() == nil
            end,

            8
        )

    if not Accepted then
        return false
    end

    print(
        "[Delivery] Order accepted"
    )

    -- IMPORTANT: do not immediately re-enter the customer
    -- state. The game's client waits before enabling the next
    -- bag, so stay in an explicit reset-wait state instead.
    return WaitForDeliveryBagReturn()
end

--========================================================
-- AUTO DELIVERY LOOP
--========================================================

local function StartAutoDelivery()
    if DeliveryThread then
        return
    end

    DeliveryThread =
        task.spawn(function()

            print(
                "[Delivery] Started"
            )

            local Success, Error =
                xpcall(
                    function()
                        while Settings.AutoDelivery do
                            local NPC =
                                GetDeliveryNPC()

                            local BagPrompt =
                                GetDeliveryBagPrompt()

                            local StartPrompt =
                                GetDeliveryStartPrompt()

                            -- State 0: customer already accepted the
                            -- order and the restaurant is resetting.
                            if DeliveryAwaitingBagReturn
                                or DeliveryServerDelivered
                            then
                                WaitForDeliveryBagReturn()

                            -- State 1: a live assigned customer is the
                            -- strongest evidence that we're carrying.
                            elseif NPC then
                                DeliveryKnownActive = true
                                DeliverToNPC()

                            -- State 2: restaurant is streamed and a bag
                            -- is ready for the next delivery.
                            elseif BagPrompt
                                and BagPrompt.Parent
                                and BagPrompt.Enabled
                            then
                                DeliveryKnownActive = true
                                PickupDeliveryBag()

                            -- State 3: restaurant is streamed, so the
                            -- visible start prompt can tell us whether to
                            -- begin/recover the job.
                            elseif StartPrompt
                                and StartPrompt.Parent
                            then
                                if StartPrompt.ObjectText
                                    == "End Delivery Job"
                                then
                                    DeliveryKnownActive = true

                                    if DeliveryWaitingForNPC() then
                                        DeliverToNPC()
                                    else
                                        task.wait(
                                            Settings.DeliveryStateDelay
                                        )
                                    end
                                else
                                    DeliveryKnownActive = false
                                    StartDeliveryJobState()
                                end

                            -- State 4: all restaurant objects are streamed
                            -- out.  Do not interpret that as "job ended".
                            -- Return to the persistent restaurant waypoint
                            -- and reconstruct the real state from there.
                            else
                                ReturnToDeliveryRestaurant(
                                    "Restaurant unloaded - recovering state"
                                )
                            end

                            task.wait(
                                Settings.DeliveryStateDelay
                            )
                        end
                    end,

                    debug.traceback
                )

            DeliveryThread = nil

            if not Success then
                warn(
                    "[Delivery] Worker error:\n"
                    .. tostring(Error)
                )

                if Settings.AutoDelivery then
                    task.wait(0.5)

                    StartAutoDelivery()

                    return
                end
            end

            print(
                "[Delivery] Stopped"
            )
        end)
end

local function MoveToDeliveryEndPromptForExit(
    Prompt
)
    if not Prompt
        or not Prompt.Parent
    then
        return false
    end

    if IsDeliveryPromptInRange(
        Prompt,
        0.75,
        true
    ) then
        return true
    end

    local Target =
        GetDeliveryApproachCFrame(
            Prompt
        )

    if Target then
        local Reached =
            MoveToJobTarget(
                Target,

                function()
                    return DeliveryExitBusy
                end
            )

        if IsDeliveryPromptInRange(
            Prompt,
            0.75,
            true
        ) then
            return true
        end

        if Reached then
            return GetDeliveryPromptDistance(
                Prompt
            ) <= (
                (tonumber(
                    Prompt.MaxActivationDistance
                ) or 7.5)
                + 0.5
            )
        end
    end

    return false
end

local function EndDeliveryJobGracefully()
    if DeliveryExitBusy then
        return
    end

    DeliveryExitBusy = true

    task.spawn(function()
        print(
            "[Delivery] Toggle off - ending in-game job"
        )

        -- Cancel the farming movement first.  The exit routine
        -- has its own active predicate and can still use Tween.
        StopJobMovement()
        task.wait(0.15)

        if not IsDeliveryJobActive() then
            print(
                "[Delivery] In-game job already ended"
            )

            DeliveryExitBusy = false
            return
        end

        local Area =
            GetDeliveryAreaPart()

        if Area
            and Area.Parent
        then
            RequestDeliveryStreaming(
                Area.Position
            )

            -- If the restaurant/start NPC is currently streamed
            -- out, stage at the job area to load it back in.
            if not GetDeliveryStartPrompt() then
                local Ground =
                    GetDeliveryGroundPoint(
                        Area.Position
                    )

                if Ground then
                    print(
                        "[Delivery] Returning to job terminal"
                    )

                    MoveToJobTarget(
                        CFrame.new(
                            Ground
                            + Vector3.new(
                                0,
                                GetRootHeight(),
                                0
                            )
                        ),

                        function()
                            return DeliveryExitBusy
                        end
                    )
                end
            end
        end

        local Started = os.clock()
        local Prompt = GetDeliveryStartPrompt()

        while DeliveryExitBusy
            and (not Prompt or not Prompt.Parent)
            and os.clock() - Started < 4
        do
            if Area then
                RequestDeliveryStreaming(
                    Area.Position
                )
            end

            task.wait(0.1)
            Prompt = GetDeliveryStartPrompt()
        end

        if not Prompt
            or not Prompt.Parent
        then
            warn(
                "[Delivery] Could not find end-job prompt"
            )

            DeliveryExitBusy = false
            return
        end

        if Prompt.ObjectText
            ~= "End Delivery Job"
        then
            DeliveryKnownActive = false
            DeliveryAwaitingBagReturn = false
            DeliveryServerDelivered = false

            print(
                "[Delivery] In-game job already ended"
            )

            DeliveryExitBusy = false
            return
        end

        if not MoveToDeliveryEndPromptForExit(
            Prompt
        ) then
            warn(
                "[Delivery] Could not reach end-job prompt"
            )

            DeliveryExitBusy = false
            return
        end

        print(
            "[Delivery] Ending job"
        )

        local LastTrigger = 0
        local EndStarted = os.clock()

        while DeliveryExitBusy
            and Prompt.Parent
            and Prompt.ObjectText
                == "End Delivery Job"
            and os.clock() - EndStarted < 7
        do
            if os.clock() - LastTrigger >= 0.75
                and IsDeliveryPromptInRange(
                    Prompt,
                    0.75,
                    true
                )
            then
                TriggerPrompt(
                    Prompt
                )

                LastTrigger = os.clock()
            end

            task.wait(0.05)
        end

        local Ended =
            not Prompt.Parent
            or Prompt.ObjectText
                ~= "End Delivery Job"
            or not DeliveryKnownActive

        if Ended then
            DeliveryKnownActive = false
            DeliveryAwaitingBagReturn = false
            DeliveryServerDelivered = false

            print(
                "[Delivery] In-game job ended"
            )
        else
            warn(
                "[Delivery] End-job prompt did not reset"
            )
        end

        DeliveryExitBusy = false
    end)
end

local function StopAutoDelivery()
    Settings.AutoDelivery = false

    -- Stop the farming loop, then deliberately end the actual
    -- in-game Delivery job so the player is not left clocked in.
    StopJobMovement()
    EndDeliveryJobGracefully()
end

