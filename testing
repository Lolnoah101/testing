    -- The game's InstantSpins.IsOn() checks BOTH ownership and the player's
    -- actual game setting. Never force an instant request for a non-owner.
    local function IsInstantSpinOn()
        if ExtraInstantSpins
            and type(ExtraInstantSpins.IsOn) == "function"
        then
            local Success, Enabled = pcall(ExtraInstantSpins.IsOn)
            return Success and Enabled == true
        end
        return false
    end


    local function GetWeaponRollCooldown()

        if ExtraInstantSpins
            and type(ExtraInstantSpins.IsOwned) == "function"
        then

            local Success, Owned =
                pcall(ExtraInstantSpins.IsOwned)


            if Success and Owned == true then
                return WEAPON_ROLL_INSTANT_COOLDOWN
            end
        end


        return WEAPON_ROLL_NORMAL_COOLDOWN
    end


    local function ScheduleNextWeaponRoll()

        NextWeaponAutoSpinAt =
            math.max(
                NextWeaponAutoSpinAt,
                LastWeaponRequestAt
                    + GetWeaponRollCooldown()
                    + WEAPON_ROLL_RETRY_GUARD
            )
    end

