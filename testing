                    end)

                    if not Fired then
                        PendingQuest = nil
                        NextQuestAt = os.clock() + 1.5

                        warn(
                            "[Anime Zero][Daily Quests] Claim request failed:",
                            ErrorMessage
                        )
                    end
                end
            end

            if PendingQuest
                and os.clock() - PendingQuest.sentAt >= 7
            then
                PendingQuest = nil
                NextQuestAt = os.clock() + 1.5
            end

            task.wait(0.30)
        end
    end)

