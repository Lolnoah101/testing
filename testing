        local okChest,chestConn=pcall(function()
            return service.ChestFished:Connect(function()
                if E.AutoFish then
                    E.FishChestCaught=(E.FishChestCaught or 0)+1
                    E.FishStatus="Fishing chest obtained"
                end
            end)
        end)
        if okChest and chestConn then table.insert(self.Connections,chestConn) end
    end
    local hb=RunService.Heartbeat:Connect(function()
        if self.Running and not self.V70NenPriority and E.AutoFish
            and (E.FishState=="Reeling" or E.FishState=="NativeReeling") then
            local tm=os.clock()
            if tm>=(E.FishReelNext or 0) then
                -- Match native 60Hz reeling more closely; remote transitions
                -- remain rate-limited independently below.
