        if Profile.mode == "Infinite" then
            table.insert(
                Lines,
                "Run: Infinite "
                    .. tostring(Profile.endlessMap or "ZZZ World")
                    .. " - "
                    .. tostring(Profile.difficulty)
                    .. " / Wave "
                    .. tostring(Profile.leaveWave or "?")
            )

        elseif Profile.mode == "Raid" then

            table.insert(
                Lines,
                "Run: Raid Spirit's Bathtub - Nightmare"
            )


            if Profile.raidCharacter then

                table.insert(
                    Lines,
                    "Storage: "
                        .. tostring(
                            ReadProgress(
                                Data,
                                "storage." .. tostring(Profile.character)
                            )
                        )
                        .. " | Pity: "
                        .. tostring(
                            math.min(
                                ReadProgress(
                                    Data,
                                    "raidPity." .. tostring(Profile.character)
                                ),
                                35
                            )
                        )
                        .. "/35"
                )
            end

        else
            table.insert(
                Lines,
                "Run: "
                    .. tostring(Profile.map)
                    .. " "
                    .. tostring(Profile.act)
                    .. " - "
                    .. tostring(Profile.difficulty)
            )
        end

        if Definition
            and type(Definition.UnlockRequirement) == "string"
        then
            table.insert(Lines, Definition.UnlockRequirement)
        end

        if IsUnlocked(Data, Profile) then
            table.insert(Lines, "Status: Unlocked")
            return table.concat(Lines, "\n")
        end

        if Profile.progressKey then
            local Current =
                ReadProgress(Data, Profile.progressKey)

            table.insert(
                Lines,
                tostring(Profile.progressLabel or "Progress")
                    .. ": "
                    .. tostring(
                        math.min(
                            Current,
                            tonumber(Profile.progressGoal) or Current
                        )
                    )
                    .. "/"
                    .. tostring(Profile.progressGoal or "?")
            )
        end

        if Definition
            and type(Definition.Progress) == "table"
        then
            for _, Entry in ipairs(Definition.Progress) do
                local Current = ReadProgress(Data, Entry.Key)
                table.insert(
                    Lines,
                    tostring(Entry.Label or "Progress")
                        .. ": "
                        .. tostring(math.min(Current, tonumber(Entry.Goal) or Current))
                        .. "/"
                        .. tostring(Entry.Goal or "?")
                )
            end
        end

        if Definition
            and type(Definition.Best) == "table"
        then
            local Current = ReadProgress(Data, Definition.Best.Key)
            local Goal = tonumber(Definition.Best.Goal) or 0

            table.insert(
                Lines,
                "Best: "
                    .. (Current > 0 and ClockText(Current) or "--:--")
                    .. " / Goal: "
                    .. ClockText(Goal)
            )
        end

        return table.concat(Lines, "\n")
    end

