    local function NextRequestId()
        Runtime.RequestId = Runtime.RequestId % 65535 + 1
        return Runtime.RequestId
    end

    local function EnsureEquipped(Data, SlotNumber)
        if not LobbyPackets
            or not LobbyPackets.equipCharacterSlot
        then
            return false
        end

        local Equipped = Data
            and Data.EquippedCharacterSlots
            and tonumber(Data.EquippedCharacterSlots.Slot1)
            or 0

        if Equipped == SlotNumber then
            return true
        end

        local Now = os.clock()

        if Now - Runtime.LastEquipAt >= 1.5 then
            Runtime.LastEquipAt = Now

            pcall(function()
                LobbyPackets.equipCharacterSlot:fire({
                    slot = SlotNumber,
                    gameSlot = 1,
                    requestId = NextRequestId(),
                })
            end)
        end

        return false
    end

    local function IsProfileProgressComplete(
        Data,
        Profile
    )
        if not Profile.progressKey
            or not Profile.progressGoal
        then
            return false
        end

        return ReadProgress(
            Data,
            Profile.progressKey
        ) >= tonumber(Profile.progressGoal)
    end

    local function HoldLobbyQueue()
        local Changed =
            Settings.AutoJoinMap == true
            or Settings.AutoJoinEndless == true
            or Settings.AutoJoinRaid == true
            or Runtime.LastQueueProfile ~= nil

        Settings.AutoJoinMap = false
        Settings.AutoJoinEndless = false
        Settings.AutoJoinRaid = false
        Settings.AutoRetry = false
        Settings.AutoNext = false
        Settings.AutoLeave = false
        Settings.AutoLeaveAfterMatches = false

        Runtime.LastQueueProfile = nil

        if Changed
            and os.clock() - Runtime.LastQueueHoldAt >= 0.25
        then
            Runtime.LastQueueHoldAt = os.clock()
            pcall(ResetLobbyState)
        end
    end

    local function ApplyRunProfile(Profile)
        local Mode =
            Profile.mode or "Story"

        local ProfileKey

        if Mode == "Infinite" then
            ProfileKey =
                "Infinite|"
                .. tostring(Profile.endlessMap or "ZZZ World")
                .. "|"
                .. tostring(Profile.difficulty or "Easy")
                .. "|"
                .. tostring(Profile.leaveWave or 100)

            Settings.SelectedEndlessMap =
                Profile.endlessMap or "ZZZ World"
            Settings.SelectedEndlessDifficulty =
                Profile.difficulty or "Easy"
            Settings.EndlessLeaveWave =
                tonumber(Profile.leaveWave) or 100
            Settings.AutoLeaveEndlessAtWave = true

            Settings.AutoJoinMap = false
            Settings.AutoJoinEndless = true
            Settings.AutoJoinRaid = false

        elseif Mode == "Raid" then

            Settings.SelectedRaidMap =
                Profile.raidMap or "Spirit's Bathtub"

            ProfileKey =
                "Raid|"
                .. tostring(Settings.SelectedRaidMap)
                .. "|Nightmare"

            Settings.AutoJoinMap = false
            Settings.AutoJoinEndless = false
            Settings.AutoJoinRaid = true
            Settings.AutoLeaveEndlessAtWave = false

        else
            ProfileKey =
                tostring(Profile.map)
                .. "|"
                .. tostring(Profile.act)
                .. "|"
                .. tostring(Profile.difficulty)

            Settings.SelectedMap = Profile.map
            Settings.SelectedAct = Profile.act
            Settings.SelectedMapDifficulty = Profile.difficulty
            Settings.AutoJoinMap = true
            Settings.AutoJoinEndless = false
            Settings.AutoJoinRaid = false
            Settings.AutoLeaveEndlessAtWave = false
        end

        local QueueChanged =
            Runtime.LastQueueProfile ~= ProfileKey

        Settings.AutoRetry = true
        Settings.AutoLeave = false
        Settings.AutoNext = false
        Settings.AutoLeaveAfterMatches = false


        if QueueChanged then
            Runtime.LastQueueProfile = ProfileKey
            pcall(ResetLobbyState)
        end

        if type(Settings.PersistDungeonAutomation) == "function" then
            pcall(Settings.PersistDungeonAutomation)
        end
    end

    local function FinishInLobby(Profile)
        StopExtraWeaponSpin()
        GENV.__AZ_SUPPRESS_ULTIMATE = false

        if Automation.AutoEquipTitle
            and LobbyPackets
            and LobbyPackets.equipTitle
        then
            pcall(function()
                LobbyPackets.equipTitle:fire(Profile.id)
            end)
        end

        SetState("Completed " .. tostring(Automation.SelectedTitle))

        Notify(
            "Title Grinder Complete",
            tostring(Automation.SelectedTitle)
                .. " is unlocked. Automation stopped.",
            7
        )

        SetAutoToggle(false)
        RestoreSnapshot()
    end

    task.spawn(function()
        while Alive() do
            if not Automation.AutoGrindTitle then

                GENV.__AZ_SUPPRESS_ULTIMATE = false

                if Runtime.Snapshot then
                    StopExtraWeaponSpin()
                    RestoreSnapshot()
                    SetState("Idle")
                end

                task.wait(0.35)
                continue
            end

            CaptureSnapshot()

            local Profile = GetProfile()

            if not Profile then
                GENV.__AZ_SUPPRESS_ULTIMATE = false
                SetState("Unsupported title")
                task.wait(1)
                continue
            end

            local Data = GetData()

            if not Data then
                SetState("Waiting for account data")
                task.wait(0.5)
                continue
            end

            if IsUnlocked(Data, Profile) then
                -- In a dungeon there is no lobby EquipTitle packet. Leave the
                -- completed run first, then finish/equip when the script reloads
                -- in the lobby with Auto Grind still saved on.
                if LobbyPackets then
                    FinishInLobby(Profile)
                else
                    Settings.AutoRetry = false
                    Settings.AutoNext = false
                    Settings.AutoLeave = true
                    SetState("Title unlocked - leaving for lobby")
                end

                task.wait(0.5)
                continue
            end

            if Profile.achievementTitle
                and IsProfileProgressComplete(
                    Data,
                    Profile
                )
            then
                StopExtraWeaponSpin()

                if LobbyPackets then
                    HoldLobbyQueue()

                    local Misc =
                        GENV.__AZ_PLAYER_MISC_SETTINGS

                    if type(Misc) == "table" then
                        Misc.AutoClaimAchievements = true
                    end

                    SetState(
                        "Goal complete - claiming "
                            .. tostring(Automation.SelectedTitle)
                    )
                else
                    Settings.AutoRetry = false
                    Settings.AutoNext = false
                    Settings.AutoLeave = true
                    SetState(
                        "Goal complete - returning to lobby to claim title"
                    )
                end

                task.wait(0.5)
                continue
            end

            if LobbyPackets then
                if Profile.character then
                    local SlotNumber =
                        math.clamp(
                            tonumber(Automation.WeaponSlot) or 1,
                            1,
                            4
                        )

                    local Slot = GetSlot(Data, SlotNumber)

                    if not Slot
                        or Slot.Unlocked ~= true
                    then
                        HoldLobbyQueue()
                        StopExtraWeaponSpin()
                        SetState(
                            "Slot "
                                .. tostring(SlotNumber)
                                .. " is locked"
                        )
                        task.wait(1)
                        continue
                    end

                    local CurrentCharacter =
                        tostring(Slot.Character or "")

                    if CurrentCharacter ~= Profile.character then

                        HoldLobbyQueue()
                        GENV.__AZ_SUPPRESS_ULTIMATE = false


                        if Profile.raidCharacter then

                            StopExtraWeaponSpin()


                            local Stored =
                                ReadProgress(
                                    Data,
                                    "storage." .. tostring(Profile.character)
                                )


                            if Stored > 0
                                and LobbyPackets.placeStoredUnit
                            then

                                local Now = os.clock()


                                if Now - (Runtime.LastStorageAt or 0) >= 1.5 then

                                    Runtime.LastStorageAt = Now


                                    pcall(function()

                                        LobbyPackets.placeStoredUnit:fire({
                                            character = Profile.character,
                                            slot = SlotNumber,
                                            requestId = NextRequestId(),
                                        })
                                    end)
                                end


                                SetState(
                                    "Placing stored Flame Director into Slot "
                                        .. tostring(SlotNumber)
                                )

                            else

                                ApplyRunProfile(Profile)

                                SetState(
                                    "Flame Director not owned - farming Raid | Pity "
                                        .. tostring(
                                            math.min(
                                                ReadProgress(
                                                    Data,
                                                    "raidPity." .. tostring(Profile.character)
                                                ),
                                                35
                                            )
                                        )
                                        .. "/35"
                                )
                            end


                            task.wait(0.4)
                            continue
                        end


                        local LastRoll =
                            GENV.__AZ_LAST_WEAPON_ROLL

                        if type(LastRoll) == "table"
                            and tonumber(LastRoll.slot) == SlotNumber
                            and tostring(LastRoll.character) == Profile.character
                            and os.clock() - (tonumber(LastRoll.at) or 0) < 4
                        then
                            StopExtraWeaponSpin()
                            SetState(
                                "Required weapon rolled - waiting for Slot "
                                    .. tostring(SlotNumber)
                                    .. " account state to confirm"
                            )
                            task.wait(0.20)
                            continue
                        end

                        if StartRequiredWeaponSpin(
                            Profile,
                            SlotNumber
                        ) then
                            SetState(
                                "Rolling Slot "
                                    .. tostring(SlotNumber)
                                    .. " until it becomes "
                                    .. tostring(Automation.SelectedTitle)
                            )
                        else
                            SetState("Waiting for weapon spinner")
                        end

                        task.wait(0.4)
                        continue
                    end

                    StopExtraWeaponSpin()

                    if not EnsureEquipped(Data, SlotNumber) then
                        HoldLobbyQueue()
                        SetState(
                            "Required weapon found - equipping inventory Slot "
                                .. tostring(SlotNumber)
                                .. " into Combat Slot 1"
                        )
                        task.wait(0.4)
                        continue
                    end

                    -- Only after BOTH conditions are confirmed from account
                    -- state do we arm Auto Join. Flame Director additionally
                    -- suppresses Ultimate only for this title objective; the
                    -- user's saved Farm setting is never changed.
                    GENV.__AZ_SUPPRESS_ULTIMATE =
                        Profile.suppressUltimate == true

                    ApplyRunProfile(Profile)

                    if Profile.mode == "Raid" then

                        SetState(
                            "Flame Director + Combat Slot confirmed - joining Raid [Nightmare]"
                        )

                    else

                        SetState(
                            "Weapon + Combat Slot confirmed - joining "
                                .. tostring(Profile.map)
                                .. " "
                                .. tostring(Profile.act)
                                .. " ["
                                .. tostring(Profile.difficulty)
                                .. "]"
                        )
                    end
                else
                    StopExtraWeaponSpin()
                    ApplyRunProfile(Profile)

                    if Profile.mode == "Infinite" then
                        SetState(
                            "Joining Infinite "
                                .. tostring(Profile.endlessMap or "ZZZ World")
                                .. " ["
                                .. tostring(Profile.difficulty)
                                .. "] to wave "
                                .. tostring(Profile.leaveWave or 100)
                        )

                    elseif Profile.mode == "Raid" then

                        SetState(
                            "Joining Raid [Nightmare]"
                        )

                    else
                        SetState(
                            "Joining "
                                .. tostring(Profile.map)
                                .. " "
                                .. tostring(Profile.act)
                                .. " ["
                                .. tostring(Profile.difficulty)
                                .. "]"
                        )
                    end
                end
            else

                if Profile.raidCharacter then

                    local SlotNumber =
                        math.clamp(
                            tonumber(Automation.WeaponSlot) or 1,
                            1,
                            4
                        )

                    local Slot =
                        GetSlot(Data, SlotNumber)

                    local HasRaidCharacter =
                        Slot
                        and tostring(Slot.Character or "") == Profile.character


                    if not HasRaidCharacter
                        and ReadProgress(
                            Data,
                            "storage." .. tostring(Profile.character)
                        ) > 0
                    then

                        GENV.__AZ_SUPPRESS_ULTIMATE = false
                        Settings.AutoRetry = false
                        Settings.AutoNext = false
                        Settings.AutoLeave = true

                        SetState(
                            "Flame Director stored - returning to lobby to place unit"
                        )

                        task.wait(0.35)
                        continue
                    end


                    GENV.__AZ_SUPPRESS_ULTIMATE =
                        HasRaidCharacter
                        and Profile.suppressUltimate == true

                else

                    GENV.__AZ_SUPPRESS_ULTIMATE =
                        Profile.suppressUltimate == true
                end


                ApplyRunProfile(Profile)

                SetState(
                    "Grinding "
                        .. tostring(Automation.SelectedTitle)
                        .. " - using Farm tab settings"
                )
            end

            task.wait(0.35)
        end
    end)

    print("[Anime Zero] Title automation ready.")
end)



