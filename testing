local function lookup(tbl, id)
    if type(tbl) ~= "table" or id == nil then return nil end
    if type(tbl.get) == "function" then
        local ok, val = pcall(tbl.get, id)
        if ok and type(val) == "table" then return val end
    end
    if type(tbl[id]) == "table" then return tbl[id] end
    for _, field in ipairs({"byId", "list", "all", "Kits", "kits", "Moves", "moves"}) do
        local sub = tbl[field]
        if type(sub) == "table" then
            if type(sub[id]) == "table" then return sub[id] end
            for _, item in pairs(sub) do
                if type(item) == "table" and item.id == id then return item end
            end
        end
    end
    return nil
end
