--==============================================================
-- UNLOAD
--==============================================================

API.Unload = function()
    if not State.Alive then
        return
    end

    State.Alive = false
    Config.Enabled = false
    Config.AutoBossFarm = false
    State.BossSessionActive = false
    State.BossTargetPosition = nil

    Systems.clearESP()

    if State.ActiveMovementTween then
        pcall(function()
            State.ActiveMovementTween:Cancel()
        end)
        State.ActiveMovementTween = nil
    end

    Systems.stopCurrentCycle()
    mouseUp()

    if State.AutoSellBusy or next(State.AutoSellTempLocks) ~= nil then
        pcall(restoreTemporaryLocks)
    end

    for _, connection in ipairs(State.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(State.Connections)

    if State.Worker then
        pcall(task.cancel, State.Worker)
        State.Worker = nil
    end

    if State.Window and not State.Window.unloaded then
        pcall(State.Window.Unload, State.Window)
    end

    if State.FallbackGui then
        pcall(State.FallbackGui.Destroy, State.FallbackGui)
    end

    ENV.__FULL_AUTO_FISHING_DUAL_V16 = nil
    print("[FishingV16] Unloaded")
end

