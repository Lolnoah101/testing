-- Rayfield Gen2 adds a built-in Configurations section when autoSave is enabled.
-- Use it for named profiles; these buttons are just one-click current-config helpers.
-- v86: Match-result webhook. Scoped here to stay under Luau's 200-local limit.
-- The Discord webhook token is a PRIVATE local file, never baked into this
-- script, Rayfield's saved flags, the GitHub loader, or the ordinary backups.
Farm.initializeMatchWebhook = function()
    local PRIVATE_FILE = "HollowMoon_AOT_Webhook_private.json"
    local prefix = "[HollowMoonHub Webhook] "
    local hook = {
        url = "", enabled = false, sending = false, sendingSince = -100,
        pendingKey = nil, sentThisRun = {}, status = "Webhook not configured",
        collecting = false, collectingSince = -100,
    }
    Farm.Webhook = hook

    local function isValidWebhook(url)
        return type(url) == "string"
            and #url < 350
            and url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-%?=&]+$") ~= nil
    end

    local function savePrivateUrl()
        if type(writefile) ~= "function" or type(readfile) ~= "function" then
            return false, "Local readfile/writefile unavailable; URL lasts until this script stops"
        end
        local json = HttpService:JSONEncode({url = hook.url})
        local ok, err = pcall(writefile, PRIVATE_FILE, json)
        if not ok then return false, "Could not save private webhook file" end
        local readOk, saved = pcall(readfile, PRIVATE_FILE)
        if not readOk or saved ~= json then
            return false, "Private file verification failed"
        end
        return true, "Saved locally"
    end

    if type(readfile) == "function" then
        local readOk, raw = pcall(readfile, PRIVATE_FILE)
        if readOk and type(raw) == "string" and #raw < 2000 then
            local parsedOk, data = pcall(function() return HttpService:JSONDecode(raw) end)
            if parsedOk and type(data) == "table" and isValidWebhook(data.url) then
                hook.url = data.url
            end
        end
    end
    hook.status = hook.url ~= "" and "Configured (local file)" or "Not configured"

    local statusHandle
    local function setStatus(message)
        hook.status = tostring(message)
        if statusHandle then
            pcall(function() statusHandle:Set(hook.status) end)
        end
    end
    local function clean(value, maxLength)
        value = tostring(value or "")
        value = value:gsub("[%c]", " "):gsub("`", "'"):gsub("@", "＠")
        value = value:gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
        return value:sub(1, maxLength or 120)
    end
    local function formattedNumber(value)
        local number = tonumber(value)
        if not number then return nil end
        local str = tostring(math.floor(number + 0.5))
        local sign = ""
        if str:sub(1,1) == "-" then sign, str = "-", str:sub(2) end
        str = str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        return sign .. str
    end
    local function getStat(names)
        local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
        for _, name in ipairs(names) do
            local value = LocalPlayer:GetAttribute(name)
            if typeof(value) == "number" then return value end
            local node = leaderstats and leaderstats:FindFirstChild(name)
            if node and (node:IsA("IntValue") or node:IsA("NumberValue")) then
                return node.Value
            end
        end
        return nil
    end
    local function addNumberLine(out, label, names)
        local n = getStat(names)
        if n ~= nil then
            out[#out+1] = label .. ": " .. formattedNumber(n)
        end
    end
    -- v92: Rewards, drops and combat stats have different meanings.
    -- Parse only the visible match-results UI and never classify a bare
    -- "+number" or an "Inner" frame name as a special reward.
    local function rewardRoots()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local roots, seen = {}, {}
        if not pg then return roots, pg end
        local names = {
            rewards=true, reward=true, results=true, result=true,
            matchresults=true, matchresult=true, waveresults=true,
            waverewards=true, victory=true, victoryrewards=true,
            loot=true, lootresults=true, endresults=true, drops=true,
            endscreen=true, completed=true, rewardsframe=true,
            rewardspanel=true, rewardscontainer=true, resultsframe=true,
            rewardscreen=true, rewardpopup=true, rewardlist=true,
            matchsummary=true, missioncomplete=true, endmatch=true,
        }
        for _, node in ipairs(pg:GetDescendants()) do
            if node:IsA("GuiObject") and names[node.Name:lower()]
                and isGuiVisibleThroughParents(node, pg) and not seen[node] then
                seen[node] = true
                roots[#roots+1] = node
                if #roots >= 25 then break end
            end
        end
        return roots, pg
    end

    local function collectRewardLines()
        local ordinary, drops, special, stats = {}, {}, {}, {}
        local roots, pg = rewardRoots()
        if not pg then return ordinary, drops, special, stats, 0 end
        local seenNodes, seenPairs, seenStats = {}, {}, {}

        local function visibleText(node)
            if not (node:IsA("TextLabel") or node:IsA("TextButton"))
                or not isGuiVisibleThroughParents(node, pg) then return "" end
            return clean(tostring(node.Text or ""):gsub("<[^>]+>", ""), 180)
        end
        local function headingSection(value)
            local low = value:lower():gsub(":$", "")
            if low == "special rewards" or low == "special drops" then return "special" end
            if low == "drops" or low == "loot" or low == "items" then return "drops" end
            if low == "rewards" or low == "match rewards" or low == "earned" then return "rewards" end
            if low == "stats" or low == "match stats" or low == "statistics" then return "stats" end
            if low == "total stats" or low == "totals" or low == "player stats" then return "totals" end
            return nil
        end
        local function namedSection(value)
            local low = tostring(value or ""):lower():gsub("[%s_%-]", "")
            if low:find("specialreward", 1, true) or low:find("specialdrop",1,true) then return "special" end
            if low:find("rewarditems", 1, true) or low:find("earned",1,true) then return "rewards" end
            if low:find("drops",1,true) or low:find("loot",1,true) then return "drops" end
            if low:find("matchstats",1,true) or low:find("combatstats",1,true) then return "stats" end
            if low:find("totals",1,true) or low:find("playerstats",1,true) then return "totals" end
            return nil
        end
        local headings = {}
        for _, root in ipairs(roots) do
            for _, node in ipairs(root:GetDescendants()) do
                local val = visibleText(node)
                local section = val ~= "" and headingSection(val) or nil
                if section then
                    local p = node.AbsolutePosition
                    headings[#headings+1] = {section=section,x=p.X,y=p.Y,w=node.AbsoluteSize.X,root=root}
                end
            end
        end
        local function sectionFor(node, root)
            -- GetDescendants includes UIGradient, UIStroke, UIListLayout and
            -- ValueBase instances. Only GuiObjects have AbsolutePosition.
            -- Nonvisual metadata may still have a named section ancestor.
            if not node:IsA("GuiObject") then
                local cursor = node.Parent
                while cursor and cursor ~= root and cursor ~= pg do
                    local match = namedSection(cursor.Name)
                    if match then return match end
                    cursor = cursor.Parent
                end
                return nil
            end
            local parent = node.Parent
            while parent and parent ~= root and parent ~= pg do
                local match = namedSection(parent.Name)
                if match then return match end
                parent = parent.Parent
            end
            -- In many result interfaces the headings and item rows are sibling
            -- frames. If names give no section, use the nearest visible heading
            -- above and in the same column. Never use the outer "Rewards" root
            -- as proof that every value is an award.
            local p = node.AbsolutePosition
            local best, bestScore = nil, math.huge
            for _, h in ipairs(headings) do
                if h.root == root and h.y <= p.Y + 5 then
                    local dx = math.abs(p.X - h.x)
                    local dy = p.Y - h.y
                    if dx <= math.max(150, h.w + 50) and dy >= -5 and dy <= 470 then
                        local score = dy + dx * 0.28
                        if score < bestScore then best, bestScore = h.section, score end
                    end
                end
            end
            return best
        end
        local function isCurrency(low)
            return low:find("gold",1,true) or low:find("coin",1,true)
                or low:find("gem",1,true) or low:find("canes",1,true)
                or low:find("cash",1,true) or low:find("money",1,true)
                or low:find("experience",1,true) or low:match("%f[%a]xp%f[%A]")
        end
        local function isMetric(low)
            return low:find("damage",1,true) or low:find("titan",1,true)
                or low:find("critical",1,true) or low:find("kill",1,true)
                or low:find("time taken",1,true) or low:find("wave",1,true)
                or low:find("level",1,true) or low:find("prestige",1,true)
                or low:find("streak",1,true) or low:find("match",1,true)
                or low:find("health",1,true) or low:find("inner",1,true)
                or low:find("outer",1,true) or low:find("seconds",1,true)
        end
        local function addStat(value, section)
            local low = value:lower()
            local label
            if low:find("damage dealt",1,true) then label="Damage Dealt"
            elseif low:find("titans killed",1,true) or low:find("titan kills",1,true) then label="Titan Kills"
            elseif low:find("critical hits",1,true) then label="Critical Hits"
            elseif low:find("time taken",1,true) then label="Time Taken"
            elseif section == "stats" and value:match("^%d%d?:%d%d:?%d?%d?$") then label="Time Taken" end
            if not label or seenStats[label] then return false end
            local amount = value:match("([%d,]+)%s*$")
            local clock = value:match("(%d%d?:%d%d:?%d?%d?)")
            if label == "Time Taken" then amount = clock or amount end
            if not amount then return false end
            if label ~= "Time Taken" then
                local digits = amount:gsub(",", "")
                amount = formattedNumber(tonumber(digits)) or amount
            end
            seenStats[label]=true
            stats[#stats+1]=label .. ": " .. amount
            return true
        end
        local function isSpecial(low, section, context)
            if low:find("divine fragment",1,true) or low:find("serum",1,true) then return true end
            if not low:find("mythic",1,true) then return false end
            -- A mythical perk can be displayed as just "Immortal (Mythical)".
            -- Accept mythic-rarity drops but exclude other explicitly named
            -- equipment/material categories so they are not mislabeled perks.
            local other = low:find("artifact",1,true) or low:find("memory",1,true)
                or low:find("weapon",1,true) or low:find("blade",1,true)
                or low:find("skin",1,true) or low:find("mount",1,true)
            if other then return false end
            return low:find("perk",1,true) or context:find("perk",1,true)
                or low:find("immortal",1,true) or section == "drops"
                or section == "special" or section == "rewards"
        end
        local function isDropItem(low)
            return low:find("perk",1,true) or low:find("bp xp",1,true)
                or low:find("blueprint",1,true) or low:find("serum",1,true)
                or low:find("divine fragment",1,true)
                or low:find("artifact",1,true) or low:find("memory",1,true)
                or low:find("(rare)",1,true) or low:find("(legendary)",1,true)
                or low:find("(mythical)",1,true) or low:find("(mythic)",1,true)
        end
        local function hasQuantity(value)
            return value:find("[%d,]+") ~= nil
        end
        local function hasExplicitGain(value)
            return value:find("%+%s*[%d,]+") or value:find("[xX]%s*[%d,]+")
                or value:find("[%d,]+%s*[xX]")
        end
        local function addLine(value, section, context, fromPair)
            value = clean(value, 145)
            local low = value:lower()
            if value == "" or headingSection(value) or low == "none" or low == "n/a"
                or low == "leave" or low == "retry" or low == "continue"
                or low == "claim" or low == "claim all" or low == "close"
                or low == "next" or low == "victory" or low == "result" then return end
            if section ~= "totals" and addStat(value, section) then return end
            if isMetric(low) or value:match("^[%+%-]?[%d,%s%.]+$") then return end
            local currency, specialItem = isCurrency(low), isSpecial(low, section, context)
            local item = isDropItem(low)
            local explicitGain = hasExplicitGain(value)
            if specialItem then
                if #special < 12 then special[#special+1] = value end
            elseif section == "totals" or section == "stats" then
                return
            elseif currency and not item then
                -- Don't take lifetime Gold/XP/Gems from the results stats panel.
                -- A gain sign or known reward area is required.
                if (explicitGain or section == "rewards") and hasQuantity(value) then
                    if #ordinary < 12 then ordinary[#ordinary+1] = value end
                end
            elseif item and (section == "drops" or section == "rewards"
                or section == "special" or explicitGain) then
                if #drops < 12 then drops[#drops+1] = value end
            elseif section == "drops" and not currency
                and not low:find("total",1,true) and not low:find("bonus",1,true)
                and not low:find("percentage",1,true) and #value > 2 then
                if #drops < 12 then drops[#drops+1] = value end
            end
        end
        for _, root in ipairs(roots) do
            local nodes = root:GetDescendants()
            nodes[#nodes+1] = root
            for _, node in ipairs(nodes) do
                if not seenNodes[node] then
                    seenNodes[node] = true
                    local value = visibleText(node)
                    if value ~= "" then
                        local section = sectionFor(node, root)
                        local context = (tostring(node.Name).." "..tostring(node.Parent and node.Parent.Name or "")):lower()
                        -- Some games name the parent simply "Inner". Accept
                        -- explicit item names in a results container even when
                        -- the UI has no separate Drops heading. Stats are still
                        -- filtered by addLine and special types remain strict.
                        if not section then
                            local low = value:lower()
                            if isDropItem(low) or isSpecial(low, nil, context) then
                                section = "rewards"
                            end
                        end
                        -- Preserve individual lines in multiline results labels.
                        -- Only split when the original label actually uses newlines.
                        local raw = tostring(node.Text or ""):gsub("<[^>]+>", "")
                        if raw:find("\n",1,true) then
                            for line in raw:gmatch("[^\r\n]+") do
                                addLine(line, section, context, false)
                            end
                        else
                            addLine(value, section, context, false)
                        end
                        -- Some result UIs store a name and number in different
                        -- sibling labels (e.g. "Gold" next to "+189,624").
                        local parent = node.Parent
                        if parent and (value:match("^[%+%-]?[%d,]+$")
                            or value:match("^[xX]%s*[%d,]+$")) then
                            for _, sibling in ipairs(parent:GetChildren()) do
                                if sibling ~= node then
                                    local name = visibleText(sibling)
                                    local low = name:lower()
                                    if name ~= "" and (isCurrency(low) or isDropItem(low)
                                        or low:find("damage dealt",1,true)
                                        or low:find("titan kills",1,true)
                                        or low:find("critical hits",1,true)) then
                                        local pairKey = tostring(parent)..":"..name..":"..value
                                        if not seenPairs[pairKey] then
                                            seenPairs[pairKey] = true
                                            addLine(name .. ": " .. value, section, context, true)
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        -- Some reward cards keep the item name and count in ValueBase children
        -- or attributes rather than TextLabels. Read these only from actual
        -- results roots; never assume the current inventory equals rewards.
        if #ordinary == 0 or #drops == 0 or #special == 0 then
            for _, root in ipairs(roots) do
                local count = 0
                for _, node in ipairs(root:GetDescendants()) do
                    count = count + 1
                    if count > 450 then break end
                    local section = sectionFor(node, root)
                    if section ~= "totals" and section ~= "stats" then
                        if node:IsA("StringValue") then
                            local itemName = clean(node.Value,100)
                            local rarity = node:GetAttribute("Rarity")
                            local parent = node.Parent
                            if rarity == nil and parent then rarity=parent:GetAttribute("Rarity") end
                            if type(rarity)=="string" and rarity~="" then
                                itemName=itemName.." ("..clean(rarity,25)..")"
                            end
                            if isDropItem(itemName:lower()) or isSpecial(itemName:lower(), "drops", "perk") then
                                addLine(itemName, "drops", "result metadata", true)
                            end
                        elseif node:IsA("IntValue") or node:IsA("NumberValue") then
                            local low=tostring(node.Name):lower()
                            local parentLow=tostring(node.Parent and node.Parent.Name or ""):lower()
                            local label = isCurrency(low) and node.Name or (isCurrency(parentLow) and parentLow or nil)
                            if label and type(node.Value)=="number" and node.Value>0 then
                                addLine(label..": +"..formattedNumber(node.Value),"rewards","result metadata",true)
                            end
                        elseif node:IsA("GuiObject") then
                            local itemName=node:GetAttribute("ItemName") or node:GetAttribute("DropName")
                                or node:GetAttribute("RewardName")
                            local rarity=node:GetAttribute("Rarity")
                            if type(itemName)=="string" and itemName~="" then
                                local value=clean(itemName,100)
                                if type(rarity)=="string" and rarity~="" then
                                    value=value.." ("..clean(rarity,25)..")"
                                end
                                local low=value:lower()
                                if isDropItem(low) or isSpecial(low,"drops","perk") then
                                    addLine(value,"drops","result metadata",true)
                                end
                            end
                        end
                    end
                end
            end
        end
        -- v96 second pass: detect currency icons/names paired with nearby
        -- quantities across nested card frames. The previous parser only
        -- handled immediate siblings. This pass never guesses an amount.
        if #ordinary == 0 then
            local currencyKeys = {
                gold="Gold", coin="Coins", coins="Coins",
                gems="Gems", gem="Gems", xp="XP", experience="XP",
                canes="Canes", cane="Canes",
            }
            local uniqueCurrency = {}
            for _, root in ipairs(roots) do
                local textNodes = {}
                for _, node in ipairs(root:GetDescendants()) do
                    if node:IsA("TextLabel") or node:IsA("TextButton") then
                        local text = visibleText(node)
                        if text ~= "" then
                            textNodes[#textNodes+1] = {node=node, text=text}
                        end
                    elseif node:IsA("ImageLabel") or node:IsA("ImageButton") then
                        if isGuiVisibleThroughParents(node, pg) then
                            textNodes[#textNodes+1] = {node=node, text=node.Name}
                        end
                    end
                    if #textNodes >= 360 then break end
                end
                for _, entry in ipairs(textNodes) do
                    local node = entry.node
                    local label = entry.text:lower():gsub("[^%a]", "")
                    local kind = currencyKeys[label]
                    local section = sectionFor(node, root)
                    local parentName = tostring(node.Parent and node.Parent.Name or ""):lower()
                    if kind and section ~= "totals" and section ~= "stats"
                        and not parentName:find("balance",1,true)
                        and not parentName:find("total",1,true) then
                        local nearest, bestScore = nil, math.huge
                        for _, candidate in ipairs(textNodes) do
                            if candidate.node ~= node
                                and (candidate.text:match("^%+?[%d,]+$")
                                    or candidate.text:match("^[xX]%s*[%d,]+$")) then
                                local a=node.Parent
                                local related=false
                                for _=1,3 do
                                    if not a or a==root then break end
                                    if candidate.node:IsDescendantOf(a) then
                                        related=true;break
                                    end
                                    a=a.Parent
                                end
                                if related then
                                    local ap=node.AbsolutePosition
                                    local bp=candidate.node.AbsolutePosition
                                    local dx=math.abs(ap.X-bp.X)
                                    local dy=math.abs(ap.Y-bp.Y)
                                    if dx<=200 and dy<=110 then
                                        local score=dx*0.65+dy
                                        if score<bestScore then nearest,bestScore=candidate,score end
                                    end
                                end
                            end
                        end
                        if nearest then
                            local amount = nearest.text:match("([%d,]+)")
                            local key = kind..":"..tostring(amount)
                            if amount and not uniqueCurrency[key] then
                                uniqueCurrency[key]=true
                                addLine(kind..": +"..amount,"rewards","reward card",true)
                            end
                        end
                    end
                end
            end
        end
        return ordinary, drops, special, stats, #roots
    end
    -- The Stohess native Rewards.Setup controller uses the first return from
    -- S_Rewards/Get: result.Stats and result.Obtained. The GUI shows amounts
    -- as icon cards, so text-only scanning can miss them completely.
    -- Fetching this once at match completion is read-only; if it fails, use
    -- the normal GUI parser. Do not guess from lifetime wallet balances.
    local function decodeNativeObtained(result)
        local rewards, drops, special, stats = {}, {}, {}, {}
        if type(result) ~= "table" then return nil end
        local obtained = result.Obtained
        if type(obtained) ~= "table" then return nil end
        local function pretty(name)
            return clean(tostring(name):gsub("_", " "), 100)
        end
        local function addUnique(list, line)
            for _, old in ipairs(list) do if old == line then return end end
            if #list < 18 then list[#list + 1] = line end
        end
        local function specialDrop(itemName, category)
            local low = itemName:lower()
            if low:find("serum", 1, true) or low:find("divine fragment",1,true) then
                return true
            end
            -- Only Perks with an explicitly supplied mythic rarity qualify.
            return category == "Perks" and
                (low:find("mythic",1,true) or low:find("mythical",1,true)) ~= nil
        end
        for category, items in pairs(obtained) do
            local kind = tostring(category)
            if type(items) == "number" and items > 0 then
                local display = pretty(kind)
                local low = display:lower()
                local amount = formattedNumber(items) or tostring(items)
                local line = display .. ": +" .. amount
                if low == "bp xp" or low == "battlepass xp" then
                    addUnique(drops, line)
                elseif low:find("serum",1,true) or low:find("divine fragment",1,true) then
                    addUnique(special, line)
                elseif low:find("gold",1,true) or low:find("coin",1,true)
                    or low:find("gem",1,true) or low:find("xp",1,true)
                    or low:find("exp",1,true) or low:find("cane",1,true) then
                    addUnique(rewards, line)
                else
                    addUnique(drops, line)
                end
            elseif type(items) == "table" then
                for itemName, amount in pairs(items) do
                    if type(itemName) == "string" then
                        local label = pretty(itemName)
                        local count = tonumber(amount)
                        if count and count > 0 then
                            label = label .. " x" .. tostring(math.floor(count))
                        end
                        if specialDrop(label, kind) then
                            addUnique(special, label)
                        else
                            addUnique(drops, label)
                        end
                    end
                end
            end
        end
        local metrics = type(result.Stats) == "table" and result.Stats or {}
        for _, item in ipairs({
            {"Damage", "Damage Dealt"}, {"Kills", "Titan Kills"},
            {"Crits", "Critical Hits"},
        }) do
            local value = tonumber(metrics[item[1]])
            if value ~= nil then
                addUnique(stats, item[2] .. ": " .. (formattedNumber(value) or tostring(value)))
            end
        end
        local seconds = Workspace:GetAttribute("Seconds")
        if type(seconds) == "number" and seconds >= 0 then
            addUnique(stats, "Time Taken: " .. formatTime(seconds))
        end
        return {rewards=rewards,drops=drops,special=special,stats=stats}
    end

    -- The matching game-place export wasn't available. When rewards still
    -- aren't readable, keep a small LOCAL diagnostic of the real UI tree so
    -- we can identify the correct value source without inventing amounts.
    local function writeMissingRewardDiagnostic(key, numRewards, numDrops)
        local roots,pg=rewardRoots()
        local lines={
            "HollowMoonHub v96 missing rewards diagnostic",
            "Job: "..clean(game.JobId,60),
            "Match key: "..clean(key,80),
            "Parser: "..tostring(numRewards).." reward values; "..tostring(numDrops).." drops",
            "Results roots: "..tostring(#roots),
        }
        for _,root in ipairs(roots) do
            lines[#lines+1]="ROOT "..clean(root:GetFullName(),180)
            local count=0
            for _,node in ipairs(root:GetDescendants()) do
                if node:IsA("TextLabel") or node:IsA("TextButton")
                    or node:IsA("StringValue") or node:IsA("IntValue")
                    or node:IsA("NumberValue") or node:IsA("ImageLabel") then
                    local raw=""
                    if node:IsA("TextLabel") or node:IsA("TextButton") then
                        raw=tostring(node.Text or ""):gsub("<[^>]+>", "")
                    elseif node:IsA("ValueBase") then raw=tostring(node.Value)
                    else raw="[image]" end
                    raw=clean(raw,100)
                    if raw~="" then
                        local parents=clean(tostring(node.Parent and node.Parent.Name or ""),50)
                        lines[#lines+1]=string.format("%s / %s [%s]: %s",
                            parents,clean(node.Name,60),node.ClassName,raw)
                        count=count+1
                    end
                end
                if count>=100 then break end
            end
        end
        if type(writefile)=="function" then
            local ok=pcall(writefile,"HollowMoon_AOT_RewardDebug_v96.txt",table.concat(lines,"\n"))
            if ok then
                do end
            end
        end
        -- Also show a short preview for mobile users who cannot open files.
        do end
