        "Other active quests: "..Hub:QuestActiveIdSummary(),
        "Acceptance: "..tostring(Hub.QuestAcceptOutcome)
            .." | failures="..tostring(Hub.QuestAcceptFailures)
            .." | paused="..tostring(Hub.QuestAcceptPaused),
        "Quest giver: "..tostring(Hub.QuestGiverStatus),
        "Board navigation: "..tostring(Hub.QuestBoardNavigation),
        "Mob area search: "..tostring(Hub.QuestAreaStatus),
        "Nearby quest NPC detection: "..tostring(Hub.QuestScanSummary),
        "Nearby NPC names (sample): "..tostring(Hub.QuestScanCandidateNames),
        "Phase: "..tostring(Hub.QuestPhase),
        "Reason: "..tostring(Hub.QuestStatus),
        "Movement: "..tostring(Hub.QuestTravelStatus),
        "Goal: "..tostring(Hub.QuestMoveSource).." | "..v3(Hub.QuestMoveTo),
        "Goal distance: "..distance.." | Character: "..v3(root and root.Position),
        "Target: "..targetName.." | HP: "..targetHealth,
        "Combat: "..tostring(Hub.OffenseGate).." | locked "..tostring(Hub.CombatLock),
        "Target check: "..tostring(Hub.QuestDebugLastTarget),
        "Visible stage markers: "..tostring(Hub.QuestDebugVisibleMarkers),
        "Chosen marker: "..tostring(Hub.QuestDebugLastMarker),
        "Observed live NPCs: "..tostring(Hub.FarmMatchCount),
        "Boss area: "..v3(Hub.QuestBossPoint).." | source: "..tostring(Hub.QuestBossPointSource),
        "Boss area distance: "..tostring(Hub.QuestBossDistance and math.floor(Hub.QuestBossDistance) or "N/A").." studs",
        "Boss respawn: "..tostring(Hub.QuestBossRespawn).." | matching records: "..tostring(Hub.QuestBossCandidates),
