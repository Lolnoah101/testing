    local function GetNextSkillTreePurchase()
        local Data = GetAccountData()

        if not Data
            or type(Data.character) ~= "string"
            or Data.character == ""
            or not Data.CharactersData
        then
            return nil
        end

        local Character = Data.character
        local CharacterData = Data.CharactersData[Character]

        if not CharacterData
            or not CharacterData.Progression
            or type(CharacterData.Progression.Skills) ~= "table"
        then
            return nil
