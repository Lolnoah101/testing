local function invokeRoom(action, value)
    if not mainFunction then
        local folder = ReplicatedStorage:FindFirstChild("RemoteFunctions")
        mainFunction = folder and folder:FindFirstChild("MainRemoteFunction")
    end
    if not mainFunction then return nil, "MainRemoteFunction missing" end
    local ok, result
    if value ~= nil then
        ok, result = pcall(function() return mainFunction:InvokeServer(action, value) end)
    else
        ok, result = pcall(function() return mainFunction:InvokeServer(action) end)
    end
    if not ok then return nil, tostring(result) end
    if type(result) ~= "table" then return nil, "Unexpected room response" end
    return result, nil
end
local function autoStartWorker()
    if S.lobbyBusy or not S.alive or not inLobby() or not S.autoStart or S.sessionStopped then return end
    S.lobbyBusy = true
    S.lobbyGeneration = S.lobbyGeneration + 1
    local token = S.lobbyGeneration
    task.spawn(function()
        -- Wait for replicated stats without blocking the interface.
        local started = os.clock()
        while S.alive and S.autoStart and token == S.lobbyGeneration
            and (not statsReady() or not playerLevel())
            and os.clock() - started < 35 do task.wait(0.25) end
        if not (S.alive and S.autoStart and token == S.lobbyGeneration and inLobby()) then
            S.lobbyBusy = false; return
        end
        if not statsReady() then
            -- Stay armed for a future run, but do not create a lobby room
            -- before Roblox finishes loading all stats.
            S.lobbyBusy = false
            warnOnce("Auto Start waiting for loaded player stats")
            return
        end
        local request, why = buildRoomData()
        if not request then
            warnOnce("Auto Start: " .. tostring(why))
            S.autoStart = false
            savePreferences()
            if S.autoStartToggle then pcall(function() S.autoStartToggle:Set(false, true) end) end
            S.lobbyBusy = false
            return
        end
        local response, err = invokeRoom("CreateRoom", request)
        if not response or response.status ~= "Success" then
            warnOnce("CreateRoom failed: " .. tostring(err or (response and response.message)))
            S.lobbyBusy = false
            -- Transient failures retry at a moderate interval, without flooding.
            task.delay(8, function()
                if S.alive and S.autoStart and token == S.lobbyGeneration and inLobby() then
                    autoStartWorker()
                end
            end)
            return
        end
        S.createdOwnRoom = true
        task.wait(S.startDelay)
        if not (S.alive and S.autoStart and token == S.lobbyGeneration and inLobby()) then
            S.lobbyBusy = false; return
        end
        local startedResult, errorText = invokeRoom("TeleportPlayers")
        if not startedResult or startedResult.status ~= "Success" then
            warnOnce("TeleportPlayers failed: " .. tostring(errorText or (startedResult and startedResult.message)))
            S.lobbyBusy = false
            -- Never create multiple rooms when an owned party may still exist.
            return
        end
        S.roomStartRequested = true
        savePreferences()
        -- Don't send duplicate start commands while Roblox is teleporting.
        S.lobbyBusy = true
    end)
end

-- Each completed results screen is one match, not every Heartbeat it stays open.
local function resultsWorkflowTick(now, visible)
    if not visible then
        if not S.resultsHiddenSince then S.resultsHiddenSince = now end
        if now - S.resultsHiddenSince >= 1.5 then S.resultsHandled = false end
        return
    end
    S.resultsHiddenSince = nil
    if S.resultsHandled then return end
    S.resultsHandled = true
    if not (S.autoRetry or S.autoLeaveMatches) then return end
    S.matchesCompleted = S.matchesCompleted + 1
    savePreferences()
    local shouldLeave = S.autoLeaveMatches and S.matchesCompleted >= S.matchesToLeave
    if shouldLeave then
        S.sessionStopped = true
        S.autoStart = false
        S.autoRetry = false
        savePreferences()
        if S.autoStartToggle then pcall(function() S.autoStartToggle:Set(false, true) end) end
        if S.autoRetryToggle then pcall(function() S.autoRetryToggle:Set(false, true) end) end
    elseif not S.autoRetry then
        -- Count the completed match but don't take an action until limit.
        return
    end
    task.delay(0.4, function()
        if not S.alive or not inLobby() and game.PlaceId ~= 6990129309 then return end
        local gui = player:FindFirstChildOfClass("PlayerGui")
        local result = gui and gui:FindFirstChild("ResultUI", true)
        if not (result and result:IsA("GuiObject") and result.Visible) then return end
        if remote then
            remote:FireServer(shouldLeave and "LeaveDungeon" or "RetryDungeon")
        end
    end)
end

