-- Request local streaming only around coordinates previously seen in this
-- session. This does NOT expose distant server-only NPCs or guarantee loading.
function Hub.QuestFns.requestQuestStreaming(position, reason)
    if typeof(position) ~= "Vector3" or not (Hub.AutoQuest or Hub.AutoFarm) then return false end
    local now = os.clock()
    if Hub.QuestStreamPending or (Hub.QuestStreamLastAt>0
        and now - Hub.QuestStreamLastAt < 4.0) then return false end
    Hub.QuestStreamPending = true
    Hub.QuestStreamLastAt = now
    Hub.QuestStreamRequests += 1
    Hub.QuestStreamToken += 1
    local token = Hub.QuestStreamToken
    Hub.QuestStreamStatus = "Requesting nearby stream: " .. tostring(reason)
    Hub.QuestFns.questDebugEvent("STREAM", "Request: "..tostring(reason).." at "..tostring(position))
    task.spawn(function()
        local ok, err = pcall(function()
            LocalPlayer:RequestStreamAroundAsync(position)
        end)
        if not Hub.Running or token ~= Hub.QuestStreamToken then return end
        Hub.QuestStreamPending = false
        Hub.QuestStreamStatus = ok and "Streaming requested; awaiting NPC/props"
            or ("Streaming request unavailable: " .. tostring(err))
        Hub.QuestFns.questDebugEvent("STREAM", Hub.QuestStreamStatus)
    end)
    task.delay(10, function()
        if Hub.Running and token == Hub.QuestStreamToken and Hub.QuestStreamPending then
            Hub.QuestStreamPending = false
            Hub.QuestStreamStatus = "Streaming request timed out; using visible objects only"
        end
    end)
    return true
end
-- Expose a colon-call wrapper for farm and quest movement. The streaming
