function Hub.QuestFns.questProgressState(id)
    local active = Hub.QuestFns.questPlayerData("ActiveQuests")
    local value = type(active)=="table" and active[id] or nil
    if not value and id:sub(1,4)=="Kill" and type(active)=="table" then
        value = active[id:sub(5)]
    end
    if typeof(value) == "Instance" then value = value:GetAttributes() end
    return type(value)=="table" and value or nil
end
-- All active quest IDs are reported separately so an old objective cannot be
-- mistaken for the selected quest, and conflicts are visible in diagnostics.
function Hub:QuestActiveIdSummary()
    local active = Hub.QuestFns.questPlayerData("ActiveQuests")
    if type(active) ~= "table" then return "Unavailable / not replicated" end
    local names = {}
    for name, state in pairs(active) do
        if type(name) == "string" and (type(state) == "table" or typeof(state) == "Instance") then
            table.insert(names,name)
        end
    end
    table.sort(names)
    return #names>0 and table.concat(names,", ") or "None"
end
function Hub.QuestFns.questPreviouslyCompleted(id)
    local completed = Hub.QuestFns.questPlayerData("CompletedQuests")
    if type(completed)=="table" then return completed[id] ~= nil and completed[id] ~= false end
    if typeof(completed)=="Instance" then
        return completed:FindFirstChild(id) ~= nil or completed:GetAttribute(id) ~= nil
    end
    return false
end
-- Lightweight quest watcher. Only the server's ActiveQuests/CompletedQuests
-- determine accepted/completed state. Module reward numbers are the *base*
-- amounts, not necessarily the boosted totals shown in the active quest HUD.
function Hub.QuestFns.baseQuestRewards(info)
    local def = (info and info.definition) or {}
    local parts = {}
    local function add(key, label)
        local value = tonumber(def[key])
        if value and value ~= 0 then table.insert(parts, label .. " " .. tostring(math.floor(value))) end
    end
    add("XP_REWARD", "EXP")
    add("MONEY_REWARD", "Jenni")
    add("REP_REWARD", "Rep")
    return #parts > 0 and table.concat(parts, "  |  ") or "No module reward data"
end
function Hub.QuestFns.readLiveQuestHudRewards(info)
    -- In-game HUD can show adjusted totals (such as quest and XP bonuses).
    -- Only use visible labels on the *active quest* HUD while the selected
    -- quest is active. Never invent boosted amounts from base module values.
    if not info or not Hub.QuestFns.questProgressState(info.id) then return nil end
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local hud = gui:FindFirstChild("Hud") or gui:FindFirstChild("HUD")
    if not hud then return nil end
    local found
    local all = hud:GetDescendants()
    local selectedOnHud = false
    for _, desc in ipairs(all) do
        if desc:IsA("TextLabel") and desc.Visible then
            local text = tostring(desc.Text or ""):gsub("<[^>]+>", "")
            if text:lower():find(info.name:lower(), 1, true) then
                selectedOnHud = true
                break
            end
        end
    end
    if not selectedOnHud then return nil end
    for _, desc in ipairs(all) do
        if desc:IsA("TextLabel") and desc.Visible then
            local raw = tostring(desc.Text or "")
            local clean = raw:gsub("<[^>]+>", "")
            if clean:find("Rewards:", 1, true)
                and clean:find("EXP", 1, true)
                and clean:find("Jenni", 1, true) then
                local line = clean:match("Rewards:%s*([^\n]+)")
                found = line and line:gsub("^%s+", "") or nil
                if found then break end
            end
        end
    end
    return found
end
function Hub.QuestFns.questWatchContent(info)
    if not info then return "Choose a quest above to view its requirements and rewards." end
    local active = Hub.QuestFns.questProgressState(info.id)
    local done = Hub.QuestFns.questPreviouslyCompleted(info.id)
    local def = info.definition or {}
    local steps = def.STAGES or {}
    local title = info.name .. (info.level and ("  |  Lv "..info.level.."+") or "")
    local result = {title, "Category: "..info.category}
    if info.board then
        table.insert(result, "Quest Board: "..info.board
            .." | Board Lv "..tostring(info.boardMin).."-"..tostring(info.boardMax))
    end
    local liveReward = Hub.QuestFns.readLiveQuestHudRewards(info)
    if liveReward then
        table.insert(result, "Rewards shown in game: "..liveReward)
    else
        table.insert(result, "Base rewards: "..baseQuestRewards(info))
    end
    if active then
        local stage = math.max(1, tonumber(active.stage) or 1)
        local count = #steps
        local current = steps[stage]
        local need = tonumber(current and current.needs) or 1
        local progress = tonumber(active.stage_progress) or 0
        table.insert(result, ("ACTIVE  |  Stage %d/%d  |  %d/%d"):format(stage, count, progress, need))
        table.insert(result, "Current: "..tostring(current and current.label or "Waiting for completion"))
    elseif done then
        table.insert(result, "COMPLETED  |  Already finished")
    else
        table.insert(result, "NOT ACCEPTED  |  Ready to check prerequisites")
    end
    if #steps > 1 then
        table.insert(result, "Stages:")
        for i, step in ipairs(steps) do
            table.insert(result, ("%d. %s (%d)"):format(i, tostring(step.label or "Objective"), tonumber(step.needs) or 1))
        end
    elseif #steps == 1 and not active then
        table.insert(result, "Objective: "..tostring(steps[1].label))
    end
    if Hub.AutoQuest then
        table.insert(result, "Auto Quest: "..tostring(Hub.QuestPhase)
            .." | "..tostring(Hub.QuestStatus))
        if not active then
            table.insert(result,"Acceptance: "..tostring(Hub.QuestAcceptOutcome))
            table.insert(result,"Remote: "..tostring(Hub.QuestRemoteBackend or "Not requested"))
            table.insert(result,"Board travel: skipped for direct requests")
        end
    else
        table.insert(result, "Auto Quest: Off")
    end
    local questOwnsMovement = Hub:QuestOwnsFarmMovement()
    if Hub.AutoFarm and questOwnsMovement then
        table.insert(result, "Movement: Auto Quest has priority; Auto Farm is paused")
    elseif Hub.AutoFarm then
        table.insert(result, "Auto Farm: "..tostring(Hub.FarmMoveStatus))
    end
    return table.concat(result, "\n")
end
-- The watcher reads replicated ActiveQuests and CompletedQuests. A one-time
-- quest is only marked Completed when the server reports it completed.
function Hub.QuestFns.questCompactWatchContent(info)
    if not info then return "Select a quest" end
    local active=Hub.QuestFns.questProgressState(info.id)
    local done=Hub.QuestFns.questPreviouslyCompleted(info.id)
    local lines={info.name}
    if active then
        local stages=info.stages or {}
        local stage=math.max(1,tonumber(active.stage) or 1)
        local current=stages[stage]
        local needs=math.max(1,tonumber(current and current.needs) or 1)
        local progress=math.max(0,tonumber(active.stage_progress) or 0)
        table.insert(lines,("Tracking | Stage %d/%d | %d/%d"):format(
            stage, math.max(1,#stages), progress, needs))
        if current and current.label then
            table.insert(lines,"Objective: "..tostring(current.label))
        end
    elseif done then
        table.insert(lines,"Completed")
    else
        table.insert(lines,"Available / Not started")
        local step=info.stages and info.stages[1]
        if step then
            table.insert(lines,"Objective: "..tostring(step.label or info.stage or "Talk to the quest giver")
                .." ("..tostring(step.needs or 1)..")")
        elseif info.target then
            table.insert(lines,"Objective: Defeat "..tostring(info.target))
        elseif info.stage then
            table.insert(lines,"Objective: "..tostring(info.stage))
        end
    end
    if info.level then table.insert(lines,"Required level: "..tostring(info.level).."+") end
    if info.requiresNen and LocalPlayer:GetAttribute("NenUnlocked")~=true then
        table.insert(lines,"Requirement: Unlock Nen first")
    end
    if Hub.AutoQuest and Hub.QuestSelectedId==info.id then
        table.insert(lines,"Auto Quest: "..tostring(Hub.QuestPhase))
        if Hub.QuestCombatActive then
            local chosen=Hub.QuestTarget
            if chosen and chosen.Model and chosen.Hum then
                table.insert(lines,("Locked mob: %s | HP %.0f/%.0f"):format(
                    tostring(chosen.NPCName or chosen.Model.Name),chosen.Hum.Health,chosen.Hum.MaxHealth))
            end
            if not Hub.AutoAttack and not Hub.AutoCritical then
                table.insert(lines,"Combat: enable Auto Attack to deal damage")
            else
                table.insert(lines,"Combat: "..tostring(Hub.OffenseGate))
            end
        end
    end
    return table.concat(lines,"\n")
end
function Hub.QuestFns.questWatchPercent(info)
    if not info then return 0 end
    local active=Hub.QuestFns.questProgressState(info.id)
    if active then
        local stages=info.stages or {}
        local count=math.max(1,#stages)
        local stage=math.clamp(math.floor(tonumber(active.stage) or 1),1,count)
        local needs=math.max(1,tonumber(stages[stage] and stages[stage].needs) or 1)
        local progress=math.clamp(tonumber(active.stage_progress) or 0,0,needs)
        return math.clamp(math.floor(((stage-1)+progress/needs)/count*100),0,100)
    end
    return Hub.QuestFns.questPreviouslyCompleted(info.id) and 100 or 0
end
