-- ============================ MISC / QUESTS ============================
-- Exact routes verified in the game's Quest UI:
-- Bridge("General", "Quest", "Accept", questGiverId)
-- Bridge("General", "Quest", "Complete", questGiverId)
-- Quest_Utils:Status(Data, questGiverId) returns the authoritative client-side
-- quest state: "available", "active", "complete", "locked", "finished".
-- Quest targeting only supplies a temporary mob ID to Auto Farm. It never
-- turns Auto Farm on/off or changes the player's saved Farm selections.
local questData, questUtils
local function loadQuestModules()
    local clientShared = nativeController and nativeController.Shared
    if type(clientShared) == "table" then
        if type(clientShared.Quest_Data) == "table" then
            questData = clientShared.Quest_Data
        end
        if type(clientShared.Quest_Utils) == "table" then
            questUtils = clientShared.Quest_Utils
        end
    end
    if not questData and shared then
        local module = shared:FindFirstChild("Quest_Data")
        if module and module:IsA("ModuleScript") then
            local ok, result = pcall(require, module)
            if ok and type(result) == "table" then questData = result end
        end
    end
    if not questUtils and shared then
        local module = shared:FindFirstChild("Quest_Utils")
        if module and module:IsA("ModuleScript") then
            local ok, result = pcall(require, module)
            if ok and type(result) == "table" then questUtils = result end
        end
    end
    return questData ~= nil and questUtils ~= nil
end

local function currentQuestGiver(world)
    if not loadQuestModules() or type(questData.Npcs) ~= "table" then
        return nil
    end
    for npcName, npcWorld in pairs(questData.Npcs) do
        if npcWorld == world then return npcName end
    end
    return nil
end

