        if not E.AutoFish or (id~=E.FishSession and id~=E.FishNativeSession) then return end
        local outcome=typeof(packet)=="table" and packet.Outcome or "Unknown"
        if outcome=="Caught" then
            -- FishingController renders packet.Fish. Chest rewards are signaled
            -- separately by FishingService.ChestFished in this game capture.
            local fish=packet and packet.Fish
            local name=typeof(fish)=="table" and tostring(fish.Name or fish.ItemName or "")
                or tostring(fish or "")
            E.FishCaught=(E.FishCaught or 0)+1
            E.FishStatus="Caught fish: "..(name~="" and name or "unknown type")
        else
            E.FishStatus="Fishing result: "..tostring(outcome)
        end
        E.FishLastResult=tostring(outcome)
