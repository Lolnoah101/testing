    W.blessingText=waves:CreateText({name="Blessing Watcher",text="Waiting for Waves Host and blessing values"})
    waves:CreateToggle({name="Auto Reroll Blessings",value=false,flag="WavesAutoBlessV73",callback=function(v) W.flags.blessing=v==true end})
    waves:CreateSection({name="Live Status"})
    W.text=waves:CreateText({name="Wave Workflow Status",
        text=Farm.isTrostPlace and "Waiting for active Trost Waves" or "Inactive outside Trost Waves"})
    end -- gameplay Waves tab (actions still Trost-Waves-only)
    -- Heartbeat checks frequently; only ONE yielding intermission worker can
    -- run at a time. No RemoteFunction calls are fired each Heartbeat.
    W.connection=RunService.Heartbeat:Connect(function(dt)
        if Farm.unloaded then
            if W.connection then W.connection:Disconnect();W.connection=nil end
            return
        end
        -- Cinematic detection also runs in other gameplay places, even though
        -- Misc is lobby-only. Never start Trost workflows outside Trost.
        cinematicPromptStep(dt)
        -- Gameplay outside Trost keeps the Waves page but does not poll its
        -- market, crate, upgrade, vote, or leave workflows.
        if not Farm.isLobbyPlace and not Farm.isTrostPlace then return end
        W.farmSyncElapsed = (W.farmSyncElapsed or 0) + dt
        if W.farmSyncElapsed >= 0.3 then
            W.farmSyncElapsed = 0
            Farm:SyncFarmMode()
        end
        if not wavesActive() then
            -- v95: Keep the leave watcher running within Trost even when the
            -- gameplay Objective temporarily despawns. No other Waves worker runs.
            if game.PlaceId==TROST and W.flags.leave then
                W.leaveElapsed=(W.leaveElapsed or 0)+dt
                if W.leaveElapsed>=0.45 then
                    W.leaveElapsed=W.leaveElapsed%0.45
                    waveLeaveTask()
                end
            end
            -- Do not reset saved toggle values; only suspend Waves behavior.
            -- An in-flight worker owns inWorkflow until its cleanup runs.
            W.breakToken=nil
            W.previousOpen=false
            W.votedPhase=nil
            W.downtimeStatus="Paused outside Waves"
            W.statusElapsed=(W.statusElapsed or 0)+dt
            if W.statusElapsed>=2 then
                W.statusElapsed=0
                updateStatus()
            end
            W.lastMisc=(W.lastMisc or -100)
            if os.clock()-W.lastMisc>=5 then
                W.lastMisc=os.clock();task.spawn(miscTask)
            end
            return
        end
        W.voteElapsed=(W.voteElapsed or 0)+dt
        W.leaveElapsed=(W.leaveElapsed or 0)+dt
        W.jobElapsed=(W.jobElapsed or 0)+dt
        if W.leaveElapsed>=0.35 then
            W.leaveElapsed=W.leaveElapsed%0.35
            if game.PlaceId==TROST and type(Farm.onWavesMatchComplete)=="function" then
                Farm.onWavesMatchComplete()
            end
            local liveWaves=folder()
            local final=liveWaves and liveWaves:GetAttribute("Finalised")~=nil
            local busyWebhook=Farm.Webhook and (
                (Farm.Webhook.collecting and os.clock()-(Farm.Webhook.collectingSince or 0)<6)
                or (Farm.Webhook.sending and os.clock()-(Farm.Webhook.sendingSince or 0)<9))
            if not (final and busyWebhook) then waveLeaveTask() end
        end
        W.statusElapsed=(W.statusElapsed or 0)+dt
        if W.voteElapsed>=0.2 then
            W.voteElapsed=W.voteElapsed%0.2
            waveVote()
        end
        if W.statusElapsed>=0.75 then
            W.statusElapsed=W.statusElapsed%0.75
            updateStatus()
            if os.clock()-W.lastSnapshot>=1.8 and not W.inWorkflow then task.spawn(snapshot) end
            if os.clock()-W.lastRefresh>=4 then
                W.lastRefresh=os.clock();updateItems()
            end
            if os.clock()-W.lastMisc>=5 then W.lastMisc=os.clock();task.spawn(miscTask) end
        end
        if W.jobElapsed<0.14 then return end
        W.jobElapsed=W.jobElapsed%0.14
        if game.PlaceId==TROST then observeCurrentCrate() end
        if not W.worker then
            W.worker=true
            task.spawn(function()
                local ok,err=pcall(waveTick)
                if not ok then do end end
                W.worker=false
            end)
        end
    end)
    Farm:SyncFarmMode()
    if wavesActive() then startUtilityWatcher() end
    do end
end
