                            .. " ["
                            .. tostring(Route.Difficulty)
                            .. "] to wave "
                            .. tostring(Route.LeaveWave or 10)
                    )
                else
                    table.insert(
                        Lines,
                        "Next farm: HxH "
                            .. tostring(Route.Act)
                            .. " ["
                            .. tostring(Route.Difficulty)
                            .. "]"
                    )
                end

                if Route.MaterialId then
                    table.insert(
                        Lines,
                        "Bottleneck: "
                            .. (MaterialNames[Route.MaterialId]
                                or Route.MaterialId)
                    )
                end
            elseif Analysis.Complete then
                table.insert(Lines, "Status: Complete")
            else
                table.insert(
                    Lines,
                    "Status: No supported Story/Infinite drop route found"
                )
            end

            local Text = table.concat(Lines, "\n")

            print(
                "[Anime Zero][Accessory Farm Status]\n"
                    .. Text
            )

            Notify(
                "Accessory Farm / Craft",
                Text,
                10
            )
        end

    task.spawn(function()
        while Alive() do
            if Automation.AutoCraftAccessories ~= true then
                if type(Automation.Snapshot) == "table" then
                    RestoreSnapshot()
                end

                SetState("Idle")
                task.wait(0.4)
                continue
            end

            if SelectedCount() == 0 then
                Stop("Select at least one accessory first.")
                task.wait(0.5)
                continue
            end

            CaptureSnapshot()

            local Data = GetAccountData()

            if not Data then
                SetState("Waiting for account data")
                task.wait(0.5)
