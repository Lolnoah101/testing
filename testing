local MovementGeneration = 0

local function StopJobMovement()
    MovementGeneration += 1

    local Character =
        Player.Character

    if not Character then
        return
    end

    local RootPart =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local Humanoid =
        Character:FindFirstChildOfClass(
            "Humanoid"
        )

    if Humanoid
        and RootPart
    then
        Humanoid:MoveTo(
            RootPart.Position
        )
    end

    if RootPart then
        RootPart.AssemblyLinearVelocity =
            Vector3.zero

        RootPart.AssemblyAngularVelocity =
            Vector3.zero
    end
end

--========================================================
-- TARGET POSITION
--========================================================

local function GetTargetCFrame(
    Part
)
    if not Part
        or not Part.Parent
    then
        return nil
    end

    local Top =
        Part.CFrame:PointToWorldSpace(
            Vector3.new(
                0,
                Part.Size.Y / 2,
                0
            )
        )

    return CFrame.new(
        Top
        + Vector3.new(
            0,
            GetRootHeight(),
            0
        )
    )
end

--========================================================
-- PATHFINDING
--========================================================

local function ComputePath(
    StartPosition,
    EndPosition
)
    local Path =
        PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,

            WaypointSpacing =
                Settings.SmartTweenWaypointSpacing,
        })

    local Success, Error =
        pcall(function()

            Path:ComputeAsync(
                StartPosition,
                EndPosition
            )
        end)

    if not Success then
        SmartDebug(
            "Compute error:",
            Error
        )

        return nil
    end

    if Path.Status
        ~= Enum.PathStatus.Success
    then
        SmartDebug(
            "Path status:",
            Path.Status
        )

        return nil
    end

    local Waypoints =
        Path:GetWaypoints()

    if #Waypoints == 0 then
        return nil
    end

    return Path, Waypoints
end

--========================================================
-- SAFE WAYPOINT HEIGHT
--========================================================

local function ConvertWaypoints(
    RawWaypoints,
    FinalTarget
)
    local Result = {}

    local PreviousY = nil

    for Index, Waypoint in ipairs(
        RawWaypoints
    ) do
        if Index == 1 then
            continue
        end

        local Position

        if Index == #RawWaypoints then
            Position =
                FinalTarget
        else
            Position =
                Waypoint.Position
                + Vector3.new(
                    0,
                    GetRootHeight(),
                    0
                )
        end

        --================================================
        -- REMOVE TINY NAVMESH HEIGHT CHANGES
        --================================================

        if PreviousY
            and math.abs(
                Position.Y
                - PreviousY
            )
            <= Settings.SmartTweenYSnapTolerance
        then
            Position =
                Vector3.new(
                    Position.X,
                    PreviousY,
                    Position.Z
                )
        end

        PreviousY =
            Position.Y

        table.insert(
            Result,
            {
                Position = Position,
                Action = Waypoint.Action
            }
        )
    end

    return Result
end

--========================================================
-- DIRECT ROUTE TEST
--========================================================

local function GetRaycastParams()
    local Params =
        RaycastParams.new()

    Params.FilterType =
        Enum.RaycastFilterType.Exclude

    Params.FilterDescendantsInstances = {
        GetCharacter()
    }

    Params.IgnoreWater = false

    return Params
end

local function IsRouteClear(
    StartPosition,
    EndPosition
)
    local Difference =
        EndPosition
        - StartPosition

    if Difference.Magnitude <= 1 then
        return true
    end

    local Horizontal =
        Vector3.new(
            Difference.X,
            0,
            Difference.Z
        )

    local Right =
        Vector3.zero

    if Horizontal.Magnitude > 0.01 then
        Right =
            Horizontal.Unit:Cross(
                Vector3.new(
                    0,
                    1,
                    0
                )
            )
    end

    local Params =
        GetRaycastParams()

    for _, Side in ipairs({
        0,
        1.1,
        -1.1
    }) do
        local Origin =
            StartPosition
            + (Right * Side)

        local Destination =
            EndPosition
            + (Right * Side)

        local Result =
            Workspace:Raycast(
                Origin,
                Destination - Origin,
                Params
            )

        if Result
            and Result.Instance
            and Result.Instance.CanCollide
        then
            return false
        end
    end

    return true
end

--========================================================
-- QUADRATIC BEZIER
--========================================================

local function QuadraticBezier(
    A,
    B,
    C,
    T
)
    local AB =
        A:Lerp(
            B,
            T
        )

    local BC =
        B:Lerp(
            C,
            T
        )

    return AB:Lerp(
        BC,
        T
    )
end

--========================================================
-- CORNER SMOOTHING
--========================================================

local function SmoothPathPoints(
    StartPosition,
    Waypoints
)
    local Base = {
        {
            Position = StartPosition,
            Action = Enum.PathWaypointAction.Walk
        }
    }

    for _, Waypoint in ipairs(
        Waypoints
    ) do
        table.insert(
            Base,
            Waypoint
        )
    end

    if #Base <= 2 then
        local Simple = {}

        for _, Point in ipairs(Base) do
            table.insert(
                Simple,
                Point.Position
            )
        end

        return Simple
    end

    local Result = {
        Base[1].Position
    }

    for Index = 2, #Base - 1 do
        local Previous =
            Base[Index - 1]

        local Current =
            Base[Index]

        local Next =
            Base[Index + 1]

        --================================================
        -- JUMP WAYPOINT
        --================================================

        if Current.Action
            == Enum.PathWaypointAction.Jump
        then
            table.insert(
                Result,
                Current.Position
            )

            table.insert(
                Result,
                Current.Position
                    + Vector3.new(
                        0,
                        Settings.SmartTweenJumpLift,
                        0
                    )
            )

            continue
        end

        local Incoming =
            Current.Position
            - Previous.Position

        local Outgoing =
            Next.Position
            - Current.Position

        local IncomingLength =
            Incoming.Magnitude

        local OutgoingLength =
            Outgoing.Magnitude

        if IncomingLength < 0.25
            or OutgoingLength < 0.25
        then
            table.insert(
                Result,
                Current.Position
            )

            continue
        end

        local Dot =
            Incoming.Unit:Dot(
                Outgoing.Unit
            )

        --================================================
        -- ALMOST STRAIGHT
        --
        -- Don't stop at this waypoint at all.
        --================================================

        if Dot > 0.995 then
            continue
        end

        local Radius =
            math.min(
                Settings.SmartTweenCornerDistance,
                IncomingLength * 0.30,
                OutgoingLength * 0.30
            )

        if Radius < 0.35 then
            table.insert(
                Result,
                Current.Position
            )

            continue
        end

        local Entry =
            Current.Position
            - Incoming.Unit
                * Radius

        local Exit =
            Current.Position
            + Outgoing.Unit
                * Radius

        --================================================
        -- ONLY ROUND THE CORNER WHEN IT IS SAFE
        --================================================

        if not IsRouteClear(
            Entry,
            Exit
        ) then
            table.insert(
                Result,
                Current.Position
            )

            continue
        end

        table.insert(
            Result,
            Entry
        )

        for Sample = 1,
            Settings.SmartTweenCornerSamples
        do
            local T =
                Sample
                / (
                    Settings.SmartTweenCornerSamples
                    + 1
                )

            table.insert(
                Result,
                QuadraticBezier(
                    Entry,
                    Current.Position,
                    Exit,
                    T
                )
            )
        end

        table.insert(
            Result,
            Exit
        )
    end

    table.insert(
        Result,
        Base[#Base].Position
    )

    return Result
end

--========================================================
-- CONTINUOUS SMOOTH PATH FOLLOWER
--
-- No separate tween per waypoint.
-- One continuous movement loop.
--========================================================

local function FollowSmoothPath(
    Points,
    IsActive,
    ShouldRepath,
    Generation
)
    if #Points < 2 then
        return true
    end

    local RootPart =
        GetRootPart()

    local Rotation =
        RootPart.CFrame
        - RootPart.Position

    local CurrentPosition =
        RootPart.Position

    local PointIndex = 2

    while PointIndex <= #Points do
        if not IsActive() then
            return false, "Inactive"
        end

        if MovementGeneration
            ~= Generation
        then
            return false, "Cancelled"
        end

        if Settings.JobFarmingMethod
            ~= "Tween"
        then
            return false, "ChangedMethod"
        end

        if ShouldRepath() then
            return false, "Blocked"
        end

        local DeltaTime =
            RunService.Heartbeat:Wait()

        -- Clamp lag spikes so the character
        -- doesn't suddenly leap several studs.
        DeltaTime =
            math.min(
                DeltaTime,
                1 / 30
            )

        local RemainingMovement =
            math.max(
                tonumber(
                    Settings.TweenSpeed
                ) or 80,
                1
            ) * DeltaTime

        while RemainingMovement > 0
            and PointIndex <= #Points
        do
            local Target =
                Points[
                    PointIndex
                ]

            local Difference =
                Target
                - CurrentPosition

            local Distance =
                Difference.Magnitude

            if Distance <= 0.03 then
                CurrentPosition =
                    Target

                PointIndex += 1

            else
                local Step =
                    math.min(
                        RemainingMovement,
                        Distance
                    )

                CurrentPosition +=
                    Difference.Unit
                    * Step

                RemainingMovement -=
                    Step

                if Step >= Distance - 0.001 then
                    CurrentPosition =
                        Target

                    PointIndex += 1
                end
            end
        end

        RootPart.CFrame =
            CFrame.new(
                CurrentPosition
            ) * Rotation

        RootPart.AssemblyLinearVelocity =
            Vector3.zero

        RootPart.AssemblyAngularVelocity =
            Vector3.zero
    end

    return true, "Completed"
end

--========================================================
-- SMART SMOOTH TWEEN
--========================================================

local function SmartTweenMoveTo(
    TargetCFrame,
    IsActive
)
    local Generation =
        MovementGeneration

    local FinalTarget =
        TargetCFrame.Position

    for Attempt = 1,
        Settings.SmartTweenMaxRepaths
    do
        if not IsActive()
            or MovementGeneration
                ~= Generation
        then
            return false
        end

        local RootPart =
            GetRootPart()

        if (
            RootPart.Position
            - FinalTarget
        ).Magnitude
        <= Settings.SmartTweenFinalDistance
        then
            return true
        end

        SmartDebug(
            "Path attempt:",
            Attempt
        )

        local Path,
            RawWaypoints =
            ComputePath(
                RootPart.Position,
                FinalTarget
            )

        if not Path
            or not RawWaypoints
        then
            SmartDebug(
                "Unable to compute path"
            )

            task.wait(0.1)
            continue
        end

        local Converted =
            ConvertWaypoints(
                RawWaypoints,
                FinalTarget
            )

        local SmoothPoints =
            SmoothPathPoints(
                RootPart.Position,
                Converted
            )

        local RepathRequested =
            false

        local BlockedConnection =
            Path.Blocked:Connect(
                function(
                    BlockedWaypoint
                )
                    -- Ignore the first couple of
                    -- waypoints behind/currently under us.
                    if BlockedWaypoint > 2 then
                        RepathRequested =
                            true

                        SmartDebug(
                            "Path blocked:",
                            BlockedWaypoint
                        )
                    end
                end
            )

        local Success,
            Reason =
            FollowSmoothPath(
                SmoothPoints,

                IsActive,

                function()
                    return RepathRequested
                end,

                Generation
            )

        BlockedConnection:Disconnect()

        if Success then
            local Distance =
                (
                    GetRootPart().Position
                    - FinalTarget
                ).Magnitude

            if Distance
                <= Settings.SmartTweenFinalDistance
            then
                return true
            end
        end

        if Reason == "Inactive"
            or Reason == "Cancelled"
            or Reason == "ChangedMethod"
        then
            return false
        end

        SmartDebug(
            "Repath reason:",
            Reason
        )

        task.wait(0.05)
    end

    warn(
        "[SmartTween] Couldn't find a usable route."
    )

    return false
end

--========================================================
-- LEGIT PATHFINDING
--========================================================

local function LegitMoveTo(
    TargetCFrame,
    IsActive
)
    local Generation =
        MovementGeneration

    for Attempt = 1, 8 do
        if not IsActive()
            or MovementGeneration
                ~= Generation
        then
            return false
        end

        local RootPart =
            GetRootPart()

        local Humanoid =
            GetHumanoid()

        local Path =
            PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = true,
                AgentCanClimb = true,
                WaypointSpacing = 4,
            })

        local Success =
            pcall(function()

                Path:ComputeAsync(
                    RootPart.Position,
                    TargetCFrame.Position
                )
            end)

        if not Success
            or Path.Status
                ~= Enum.PathStatus.Success
        then
            return false
        end

        local Waypoints =
            Path:GetWaypoints()

        local Repath = false
        local CurrentIndex = 1

        local BlockedConnection =
            Path.Blocked:Connect(
                function(Index)
                    if Index >= CurrentIndex then
                        Repath = true
                    end
                end
            )

        for Index, Waypoint in ipairs(
            Waypoints
        ) do
            CurrentIndex = Index

            if Repath
                or not IsActive()
                or MovementGeneration
                    ~= Generation
            then
                break
            end

            if Waypoint.Action
                == Enum.PathWaypointAction.Jump
            then
                Humanoid.Jump = true
            end

            Humanoid:MoveTo(
                Waypoint.Position
            )

            local Started =
                os.clock()

            while
                (
                    RootPart.Position
                    - Waypoint.Position
                ).Magnitude
                > 4
            do
                if Repath
                    or not IsActive()
                    or MovementGeneration
                        ~= Generation
                then
                    break
                end

                if os.clock() - Started
                    > 8
                then
                    Repath = true
                    break
                end

                task.wait(0.05)
            end
        end

        BlockedConnection:Disconnect()

        if (
            RootPart.Position
            - TargetCFrame.Position
        ).Magnitude <= 6
        then
            return true
        end

        if not Repath then
            return false
        end
    end

    return false
end

