    --//========================================================
    --// AUTOMATION QUEUE
    --//========================================================

    local function CountSelected(
        T
    )

        local Count = 0


        for _, Enabled in pairs(
            type(T) == "table"
                and T
                or {}
        ) do

            if Enabled == true then
                Count += 1
            end
        end


        return Count
    end


    local function StopQueue(
        Message
    )

        Advanced.AutoQueue =
            false

        RequestUI(
            "AutomationQueue",
            false
        )

        Runtime.QueueStartedIndex =
            nil

        Runtime.QueueStartedTask =
            nil

        Persist()


        if Message then

            Notify(
                "Automation Queue",
                Message,
                7
            )
        end
    end


    local function AdvanceQueue()

        Advanced.QueueIndex =
            (
                tonumber(
                    Advanced.QueueIndex
                ) or 1
            ) + 1


        Runtime.QueueStartedIndex =
            nil

        Runtime.QueueStartedTask =
            nil


        if Advanced.QueueIndex
            > 5
        then

            if Advanced.QueueLoop
                == true
            then

                Advanced.QueueIndex =
                    1

            else

                StopQueue(
                    "Queue complete."
                )

                return
            end
        end


        Persist()
    end


    local function RunAutomationQueue()

        if Advanced.AutoQueue
            ~= true
        then

            Runtime.QueueStartedIndex =
                nil

            Runtime.QueueStartedTask =
                nil

            return
        end


        local Index =
            math.clamp(
                tonumber(
                    Advanced.QueueIndex
                ) or 1,
                1,
                5
            )


        Advanced.QueueIndex =
            Index


        local TaskName =
            tostring(
                Advanced.QueueSteps[
                    Index
                ]
                or "None"
            )


        if TaskName == "None"
            or TaskName == ""
        then

            AdvanceQueue()

            return
        end


        local Starting =
            Runtime.QueueStartedIndex
                ~= Index
            or Runtime.QueueStartedTask
                ~= TaskName


        if Starting then

            Runtime.QueueStartedIndex =
                Index

            Runtime.QueueStartedTask =
                TaskName


            if TaskName
                == "Multi-Title Grinder"
            then

                if CountSelected(
                    Advanced.MultiTitleTargets
                ) == 0
                then

                    StopQueue(
                        "Queue Step "
                        .. tostring(
                            Index
                        )
                        .. " has no Title Queue targets."
                    )

                    return
                end


                Advanced.AutoMultiTitle =
                    true

                RequestUI(
                    "MultiTitle",
                    true
                )


            elseif TaskName
                == "Full Auto Evolve"
            then

                if CountSelected(
                    Advanced.EvolutionTargets
                ) == 0
                then

                    StopQueue(
                        "Queue Step "
                        .. tostring(
                            Index
                        )
                        .. " has no Evolution Targets."
                    )

                    return
                end


                Advanced.AutoFullEvolve =
                    true

                RequestUI(
                    "FullEvolve",
                    true
                )


            elseif TaskName
                == "Auto Achievement Grinder"
            then

                if CountSelected(
                    Advanced.AchievementTargets
                ) == 0
                then

                    StopQueue(
                        "Queue Step "
                        .. tostring(
                            Index
                        )
                        .. " has no Achievement Targets."
                    )

                    return
                end


                Advanced.AutoAchievementGrinder =
                    true

                RequestUI(
                    "Achievement",
                    true
                )


            elseif TaskName
                == "Accessory Farm & Craft"
            then

                local Accessory =
                    GENV.__AZ_ACCESSORY_AUTOMATION_SETTINGS


                if type(Accessory)
                    ~= "table"
                    or CountSelected(
                        Accessory.SelectedAccessories
                    ) == 0
                then

                    StopQueue(
                        "Queue Step "
                        .. tostring(
                            Index
                        )
                        .. " has no Accessories selected."
                    )

                    return
                end


                Accessory.AutoCraftAccessories =
                    true

                GENV.__AZ_ACCESSORY_AUTOMATION_UI_QUEUE =
                    true


                local PersistAccessory =
                    GENV.__AZ_ACCESSORY_AUTOMATION_PERSIST_FUNCTION


                if type(PersistAccessory)
                    == "function"
                then

                    pcall(
                        PersistAccessory
                    )
                end


            elseif TaskName
                == "Auto Accessory Loadout"
            then

                Advanced.AutoAccessoryLoadout =
                    false


                local Complete =
                    ApplyBestAccessory()


                if Complete then

                    AdvanceQueue()
                end


                Persist()

                return


            else

                StopQueue(
                    "Unknown queue task: "
                    .. TaskName
                )

                return
            end


            Persist()
        end


        local Finished =
            false


        if TaskName
            == "Multi-Title Grinder"
        then

            Finished =
                Advanced.AutoMultiTitle
                ~= true


        elseif TaskName
            == "Full Auto Evolve"
        then

            Finished =
                Advanced.AutoFullEvolve
                ~= true


        elseif TaskName
            == "Auto Achievement Grinder"
        then

            Finished =
                Advanced.AutoAchievementGrinder
                ~= true


        elseif TaskName
            == "Accessory Farm & Craft"
        then

            local Accessory =
                GENV.__AZ_ACCESSORY_AUTOMATION_SETTINGS


            Finished =
                type(Accessory)
                    ~= "table"
                or Accessory.AutoCraftAccessories
                    ~= true


        elseif TaskName
            == "Auto Accessory Loadout"
        then

            Finished =
                ApplyBestAccessory()
        end


        if Finished then

            AdvanceQueue()
        else

            SetState(
                "Automation Queue: Step "
                .. tostring(
                    Index
                )
                .. " - "
                .. TaskName
            )
        end
    end


    GENV.__AZ_AUTOMATION_QUEUE_STATUS_FUNCTION =
        function()

            local Index =
                math.clamp(
                    tonumber(
                        Advanced.QueueIndex
                    ) or 1,
                    1,
                    5
                )


            Notify(
                "Automation Queue",
                "Current Step: "
