-- BELOW WAIT / LOOT TELEPORT SHARED MOVEMENT
-- Shared by the normal farm controller and the rescue/Trials controller.
-- The location is a raycast-confirmed WALKABLE surface, never a fixed Y height.
GENV.__AZ_FARM_EXT.GetBelowSurfaceGoal = function(Root, EnemyPosition, AreaToken)
    if not Root or not Root.Parent then
        return nil
    end

    local Ext = GENV.__AZ_FARM_EXT
    local World = workspace:FindFirstChild("World")
    local Token = tostring(AreaToken or "?")
        .. ":" .. tostring(workspace:GetAttribute("Floor") or "?")

    if Ext.BelowStandbyWorld ~= World
        or Ext.BelowStandbyArea ~= Token
        or Ext.BelowStandbyCharacter ~= Root.Parent
    then
        Ext.BelowStandbyWorld = World
        Ext.BelowStandbyArea = Token
        Ext.BelowStandbyCharacter = Root.Parent
        Ext.BelowStandbyCFrame = nil
        Ext.BelowStandbyEnemyPosition = nil
        Ext.BelowStandbyTeleportToken = nil
    end

    if typeof(EnemyPosition) == "Vector3" then
        Ext.BelowStandbyEnemyPosition = EnemyPosition
    end

    if typeof(Ext.BelowStandbyCFrame) == "CFrame" then
        return Ext.BelowStandbyCFrame
    end

    local Sample = Ext.BelowStandbyEnemyPosition or Root.Position
    local Ignore = { Root.Parent }
    local Enemies = workspace:FindFirstChild("enemies")
    if Enemies then
        table.insert(Ignore, Enemies)
    end
    if World then
        for _, Name in ipairs({"Enemies", "Mobs", "Drops", "RenderedDrops"}) do
            local Folder = World:FindFirstChild(Name)
            if Folder then
                table.insert(Ignore, Folder)
            end
        end
    end

    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.IgnoreWater = true

    -- Probe near the enemy's floor height, not arbitrary global world Y=0.
    -- Retry lower and higher probes for maps with raised platforms.
    for _, Above in ipairs({12, 32, 70}) do
        local Filter = table.clone(Ignore)
        for _ = 1, 8 do
            Params.FilterDescendantsInstances = Filter
            local Origin = Sample + Vector3.new(0, Above, 0)
            local Hit = workspace:Raycast(
                Origin,
                Vector3.new(0, -(Above + 45), 0),
                Params
            )
            if not Hit then
                break
            end
            local Part = Hit.Instance
            local Walkable = Hit.Normal.Y >= 0.72
                and (Part:IsA("Terrain") or (Part:IsA("BasePart") and Part.CanCollide))
            if Walkable then
                local Humanoid = Root.Parent:FindFirstChildOfClass("Humanoid")
                local Height = math.clamp(
                    (Humanoid and Humanoid.HipHeight or 2) + Root.Size.Y * 0.5,
                    2.5, 8
                )
                Ext.BelowStandbyCFrame = CFrame.new(Hit.Position + Vector3.new(0, Height, 0))
                return Ext.BelowStandbyCFrame
            end
            table.insert(Filter, Part)
        end
    end

    -- No confirmed surface: don't place the player in mid-air.
    return nil
end

-- A single instant move for each locked coin. Retargeting the same ID in
-- successive frames never causes another teleport or target oscillation.
GENV.__AZ_FARM_EXT.TeleportToLootOnce = function(Root, Goal)
    local Ext = GENV.__AZ_FARM_EXT
    local Token = Ext.LootTargetToken
    if not Root or typeof(Goal) ~= "CFrame" or Token == nil then
        return false
