local function isBasicAttack(n)
    n = tostring(n or ""):lower()
    if n == "m" or n == "hit" or n == "runninghit" or n == "arielhit"
        or n == "uptilt" or n == "downslam" or n == "kickupward"
        or n == "kickdownward" or n == "critical" or n == "m1" or n == "m2" then return true end
    if n:match("^hit%d+$") or n:match("^punch%d+$") or n:match("^%d+$") then return true end
    return false
end
local function isLikelyAttack(n)
    n = tostring(n or ""):lower()
    for _, skip in ipairs({"idle", "block", "parried", "stagger", "recoil",
        "reaction", "walk", "run", "sprint", "cutscene", "equip",
        "death", "taunt", "emote", "grip", "roll", "pose", "ready"}) do
        if n:find(skip, 1, true) then return false end
    end
    if isBasicAttack(n) then return true end
    for _, word in ipairs({"attack", "swing", "slash", "strike", "punch", "kick",
        "claw", "stomp", "smash", "pound", "whip", "lunge", "barrage",
        "uppercut", "thrust", "slam", "pierce", "stab", "blitz"}) do
        if n:find(word, 1, true) then return true end
    end
    return false
end
local function classifyMove(n, declaredSpecial)
    n = tostring(n or ""):lower()
    local kind = declaredSpecial and "Special" or "Basic"
    local ranged = n:find("rock",1,true) or n:find("boulder",1,true)
        or n:find("stone ball",1,true) or n:find("power ball",1,true)
        or n:find("projectile",1,true) or n:find("bolt",1,true)
        or n:find("bullet",1,true) or n:find("beam",1,true)
        or n:find("shot",1,true) or n:find("throw",1,true)
        or n:find("bomb",1,true) or n:find("ray",1,true)
        or n:find("fire ball",1,true) or n:find("spit",1,true)
        or n:find("javelin",1,true) or n:find("scatter",1,true)
        or n:find("roulette",1,true) or n:find("firing",1,true) or n:find("pierce",1,true)
    local aoe = n:find("storm",1,true) or n:find("tornado",1,true)
        or n:find("rain",1,true) or n:find("floor",1,true)
        or n:find("burst",1,true) or n:find("wave",1,true)
        or n:find("orbit",1,true) or n:find("shock",1,true)
        or n:find("flop",1,true) or n:find("pillar",1,true)
        or n:find("ground",1,true) or n:find("stomp",1,true)
        or n:find("eruption",1,true) or n:find("explosion",1,true)
        or n:find("meteor",1,true) or n:find("quake",1,true)
        or n:find("blizzard",1,true) or n:find("slam",1,true)
        or n:find("crash",1,true) or n:find("stun",1,true)
        or n:find("rage",1,true) or n:find("toxic",1,true)
        or n:find("inferno",1,true) or n:find("flood",1,true)
    local multi = n:find("barrage",1,true) or n:find("combo",1,true)
        or n:find("onslaught",1,true) or n:find("slashes",1,true)
        or n:find("roulette",1,true) or n:find("rushfire",1,true)
        or n:find("blitz",1,true) or n:find("orbit",1,true)
        or n:find("tornado",1,true) or n:find("rain",1,true)
    local rush = n:find("tornado",1,true) or n:find("lunge",1,true)
        or n:find("rush",1,true) or n:find("pounce",1,true)
        or n:find("charge",1,true) or n:find("blitz",1,true)
