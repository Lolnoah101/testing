local function findDungeonPrompt(portal)
    if type(portal) ~= "table" then return nil end
    local model = portal.Model
    if typeof(model) ~= "Instance" or not model:IsDescendantOf(Workspace) then
        local folder = Workspace:FindFirstChild("Dungeons")
        if not folder then return nil end
        local modelName = ({Natural = "Portal", Natural2 = "Portal2", Admin = "AdminPortal"})[portal.Key]
        if modelName then model = folder:FindFirstChild(modelName) end
        if not model then
            for _, item in ipairs(folder:GetChildren()) do
                if item:GetAttribute("DungeonPortal") == true
                    and normalizeIsland(item:GetAttribute("Island")) ==
                        normalizeIsland(portal.Island or portal.IslandName)
                    and tonumber(item:GetAttribute("Rank")) == tonumber(portal.Rank) then
                    model = item
                    break
                end
            end
        end
    end
    if typeof(model) ~= "Instance" or not model:IsDescendantOf(Workspace) then
        return nil
    end
    local prompt = model:FindFirstChild("DungeonPrompt", true)
    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
        return prompt
    end
    return nil
end

local function promptPosition(prompt)
    if not prompt then return nil end
    local parent = prompt.Parent
    if parent and parent:IsA("Attachment") then return parent.WorldPosition end
    if parent and parent:IsA("BasePart") then return parent.Position end
    local base = prompt:FindFirstAncestorWhichIsA("BasePart")
    return base and base.Position or nil
end

