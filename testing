local rewardRequestTimes = {}
local lastRewardGlobal = -math.huge
local lastRewardStatus = nil
local function rewardMessage(msg)
    if msg ~= lastRewardStatus then
        lastRewardStatus = msg
        pcall(function() rewardStatus:Set(msg) end)
    end
end
local function tickMiscRewards()
    if not (enabled.DailyReward or enabled.PlaytimeRewards or enabled.IndexRewards) then
        return
    end
    local data = dataNow()
    if not data then
        rewardMessage("Waiting for player data...")
        return
    end
    local gifts = data.gifts or {}
    local now = os.clock()
    local day = GiftRules.day(Workspace:GetServerTimeNow())
    local claimKind, claimId, status
    -- Prioritize complete-zone sword claims over daily/playtime gifts. A
    -- repeatedly rejected daily gift must not starve a ready Index sword.
    if enabled.IndexRewards then
        local discovered = (data.shadows or {}).discovered or {}
        local claimedZones = gifts.zones or {}
        for level = 0, #GateConfig.Ranks do
            local zone = GiftRules.zone(level, discovered, claimedZones)
            if zone and zone.Complete and not zone.Claimed then
                local weapon = zone.Weapon and WeaponConfig.ById[zone.Weapon]
                local displayName = weapon and weapon.Name or (level == 0 and "Tutorial" or "Zone")
                claimKind, claimId = "Zone", level
                status = "Index completion: " .. tostring(displayName)
                break
            end
        end
    end
    if not claimKind and enabled.DailyReward then
        local state = GiftRules.daily(gifts.daily, day)
        if state.Claimable then
            claimKind, status = "Daily", "Daily reward ready"
        end
    end
    if not claimKind and enabled.PlaytimeRewards then
        local recorded, claimed = GiftRules.playtime(gifts.playtime, day)
        local anchor = LocalPlayer:GetAttribute("PlaytimeAnchor")
        local played = type(anchor) == "number"
            and math.max(0, Workspace:GetServerTimeNow() - anchor) or recorded
        for i, info in ipairs(GiftConfig.Playtime) do
            if played >= info.At and claimed[tostring(i)] ~= true then
                claimKind, claimId, status = "Playtime", i, "Playtime reward " .. i .. " ready"
                break
            end
        end
    end
    -- Individual monster Index rewards remain supported.
    if not claimKind and enabled.IndexRewards then
        local discovered = (data.shadows or {}).discovered or {}
        local claimed = gifts.index or {}
        for _, monster in ipairs(MonsterConfig.Index) do
            local id = monster.Id
            if discovered[id] == true and claimed[id] ~= true
                and GiftRules.indexReward(id) ~= nil then
                claimKind, claimId, status = "Index", id, "Index reward: " .. tostring(monster.Name)
                break
            end
        end
    end
    if not claimKind then
        rewardMessage("No claimable rewards right now (checked daily, playtime, index).")
        return
    end
    local key = claimKind .. ":" .. tostring(claimId or "")
    if now - (rewardRequestTimes[key] or -math.huge) < 8
        or now - lastRewardGlobal < 1.2 then
        rewardMessage((status or claimKind) .. " | Waiting for verification / retry")
        return
    end
    lastRewardGlobal = now
    rewardRequestTimes[key] = now
    local ok, err = pcall(function()
        if claimKind == "Daily" then
            GiftClaim:FireServer("Daily")
        elseif claimKind == "Playtime" then
            GiftClaim:FireServer("Playtime", claimId)
        elseif claimKind == "Zone" then
            GiftClaim:FireServer("Zone", claimId)
        else
            GiftClaim:FireServer("Index", claimId)
        end
    end)
    if ok then
        rewardMessage("Requested " .. (status or claimKind) .. " (awaiting player-data confirmation)")
    else
        rewardMessage("Reward claim error: " .. tostring(err))
        warn("[Arise v14] Reward claim:", err)
    end
end

-- V14: Scan the ACTUAL owned inventory, not just post-toggle additions.
-- V13 initialized a baseline on enable and excluded all earlier shadow IDs.
-- In practice this showed New tracked: 0 and never tried to release those.
-- Selected-rank releases are permanent; leave locked, gifted, collectible,
-- equipped and commander shadows untouched. Only server data confirms removal.
local releaseSession = {
    firstSeen = {},
    pending = {},           -- shadow ID => {sentAt, count}
    confirmed = 0,
    requests = 0,
    lastGlobal = -math.huge,
}
local releaseStatusLast = nil
local function updateReleaseStatus(message)
    if autoReleaseStatus and releaseStatusLast ~= message then
        releaseStatusLast = message
        pcall(function() autoReleaseStatus:Set(message) end)
    end
end

local function getReleaseRankName(record)
    if type(record) ~= "table" then return nil end
    -- ArmyUIController displays record.Rank as a numeric RankConfig index.
    local value = record.Rank
    if value == nil then value = record.StatRank end
    if type(value) == "string" and RankConfig.IndexByName and RankConfig.IndexByName[value] then
        return value
    end
    local index = tonumber(value)
    local item = index and RankConfig.Ranks[math.floor(index + 0.5)]
    return item and item.Name or nil
end

local function processReleaseShadows()
    local data = dataNow()
    local owned = data and data.shadows and data.shadows.owned
    if type(owned) ~= "table" then
        updateReleaseStatus("Waiting for shadow inventory data...")
        return
    end
    local now = os.clock()
    for id in pairs(releaseSession.pending) do
        if owned[id] == nil then
            releaseSession.confirmed = releaseSession.confirmed + 1
            releaseSession.pending[id] = nil
            releaseSession.firstSeen[id] = nil
        end
    end
    for id in pairs(releaseSession.firstSeen) do
        if owned[id] == nil then releaseSession.firstSeen[id] = nil end
    end

    local selected, totalOwned, rankMatched, eligible, protected, unknown = 0, 0, 0, 0, 0, 0
    local awaiting = 0
    for _, chosen in pairs(settings.ReleaseRanks) do
        if chosen == true then selected = selected + 1 end
    end
    local shadows = data.shadows
    local active = shadows.active or {}
    local assigned = {}
    for _, id in pairs(shadows.commanders or {}) do
        if id ~= nil then assigned[id] = true end
    end

    local chosenId, oldestReady = nil, -math.huge
    for id, record in pairs(owned) do
        totalOwned = totalOwned + 1
        local rank = getReleaseRankName(record)
        if not rank then unknown = unknown + 1 end
        if rank and settings.ReleaseRanks[rank] then
            rankMatched = rankMatched + 1
            if type(record) ~= "table" or record.Locked or record.Gift
                or record.CollectibleSerial or active[id] or assigned[id] then
                protected = protected + 1
                releaseSession.firstSeen[id] = nil
            else
                eligible = eligible + 1
                if not releaseSession.firstSeen[id] then
                    releaseSession.firstSeen[id] = now
                end
                local req = releaseSession.pending[id]
                local retryAfter = req and math.min(35, 4 + (req.count or 1) * 3) or 0
                local age = now - releaseSession.firstSeen[id]
                -- Brief grace period lets Auto Equip Best protect useful drops.
                if age >= 2 and (not req or now - req.sentAt >= retryAfter) then
                    if age > oldestReady then
                        chosenId, oldestReady = id, age
                    end
                elseif req then
                    awaiting = awaiting + 1
                end
            end
        else
            releaseSession.firstSeen[id] = nil
        end
    end

    local msg = string.format(
        "Selected ranks: %d | Owned: %d | Matching: %d\nEligible: %d | Protected: %d | Unknown rank: %d\nRequested: %d | Confirmed removed: %d | Awaiting: %d",
        selected, totalOwned, rankMatched, eligible, protected, unknown,
        releaseSession.requests, releaseSession.confirmed, awaiting
    )
    if not enabled.ReleaseShadows then
        updateReleaseStatus("OFF | " .. msg)
        return
    end
    if selected == 0 then
        updateReleaseStatus("Choose Auto Release Ranks first.\n" .. msg)
        return
    end
    if chosenId and now - releaseSession.lastGlobal >= 1.25 then
        releaseSession.lastGlobal = now
        local req = releaseSession.pending[chosenId]
        local ok, err = pcall(function()
            -- Identical to the Army UI's release confirmation action.
            ShadowManage:FireServer("Release", chosenId, nil)
        end)
        if ok then
            releaseSession.pending[chosenId] = {
                sentAt = now, count = (req and req.count or 0) + 1
            }
            releaseSession.requests = releaseSession.requests + 1
            msg = msg .. "\nSent release for ID " .. tostring(chosenId) .. " (not yet confirmed)"
        else
            msg = msg .. "\nRemote error: " .. tostring(err)
            warn("[Arise v14] Release request:", err)
        end
    elseif eligible == 0 then
        msg = msg .. "\nNo eligible owned shadows of the selected ranks."
    end
    updateReleaseStatus(msg)
end

-- ShadowPrompts creates ArisePrompt only when corpse is eligible for this player.
-- That prompt sends Shadows.Arise:FireServer(corpse.CorpseId, nil).
-- Read the same player-specific attempts and rank as the game UI.
local lastAriseForCorpse = setmetatable({}, { __mode = "k" })
local nextAriseGlobal = 0
local function tickAutoArise()
    if not enabled.AutoArise or not gameActionReady() then return end
    local now = os.clock()
    if now < nextAriseGlobal then return end
    local _, root = getCharacter()
    if not root then return end
    local data = dataNow()
    local owned = data and data.shadows and data.shadows.owned
    if type(owned) ~= "table" then return end
    local count = 0
    for _ in pairs(owned) do count += 1 end
    if count >= ShadowConfig.MaxOwned then return end
    local attemptsKey = "Arise_" .. LocalPlayer.UserId
    local rankKey = "AriseRank_" .. LocalPlayer.UserId
    local chosen, chosenDistance
    local maxRange = math.max(0, ShadowConfig.Extraction.PromptRange - 1.5)
    for _, corpse in ipairs(CollectionService:GetTagged(Enums.Tags.Corpse)) do
        if corpse:IsA("Model") and corpse.Parent
            and corpse:GetAttribute("Corpse") == true
            and type(corpse:GetAttribute(attemptsKey)) == "number"
            and corpse:GetAttribute(attemptsKey) > 0
            and corpse:GetAttribute("CorpseId") ~= nil
            and now - (lastAriseForCorpse[corpse] or -math.huge) >= 0.9
        then
            local rankIndex = tonumber(corpse:GetAttribute(rankKey)) or tonumber(corpse:GetAttribute("Rank"))
            local rank = rankIndex and RankConfig.Ranks[rankIndex]
            local part = corpse:FindFirstChild("Root") or corpse.PrimaryPart
            if rank and settings.AriseRanks[rank.Name]
                and part and part:IsA("BasePart") then
                local distance = (root.Position - part.Position).Magnitude
                if distance <= maxRange and (not chosen or distance < chosenDistance) then
                    chosen, chosenDistance = corpse, distance
                end
            end
        end
    end
    if not chosen then return end
    nextAriseGlobal = now + 0.4
    lastAriseForCorpse[chosen] = now
    local corpseId = chosen:GetAttribute("CorpseId")
    local ok, err = pcall(function()
        ShadowArise:FireServer(corpseId, nil)
    end)
    if not ok then warn("[Arise V8] Auto Arise:", err) end
end

local function scoreShadow(shadow, kind)
    if type(shadow) ~= "table" then return 0 end
    local ok, value = pcall(function()
        local rank = ShadowMath.statRank(shadow)
        local scale = ShadowMath.statScale(shadow)
        if kind == "Commander" then
            return ShadowMath.commanderDamage(rank, scale, shadow.Age,
                ShadowMath.statLevel(shadow))
        end
        return ShadowMath.income(rank, scale, shadow.Age)
    end)
    return ok and type(value) == "number" and value or 0
end
local function bestAssignmentsNeeded(data, kind)
    local shadows = data.shadows or {}
    local owned = shadows.owned or {}
    local level = math.clamp((data.base or {}).level or 1, 1, BaseUpgradeConfig.maxLevel)
    local commanders = shadows.commanders or {}
    local commanderSet = {}
    for _, id in pairs(commanders) do commanderSet[id] = true end
    local wanted = kind == "Commander"
        and (BaseUpgradeConfig.commanderSlotsByLevel[level] or 1)
        or (BaseUpgradeConfig.roamingSlotsByLevel[level] or 3)
    local items = {}
    for id, shadow in pairs(owned) do
        if kind == "Commander" or not commanderSet[id] then
            items[#items + 1] = { id = id, score = scoreShadow(shadow, kind) }
        end
    end
    table.sort(items, function(a, b)
        return a.score == b.score and tostring(a.id) < tostring(b.id) or a.score > b.score
    end)
    local ideal = 0
    for i = 1, math.min(wanted, #items) do ideal += items[i].score end
    local current = 0
    if kind == "Commander" then
        for slot, id in pairs(commanders) do
            if (tonumber(slot) or 1000) <= wanted then
                current += scoreShadow(owned[id], kind)
            end
        end
    else
        for id, on in pairs(shadows.active or {}) do
            if on == true and not commanderSet[id] then
                current += scoreShadow(owned[id], kind)
            end
        end
    end
    return ideal > current + 1e-6
end
local function tickArmy()
    local data = dataNow()
    if not data or type(data.shadows) ~= "table" then return end
    if LocalPlayer:GetAttribute("Traveling") or isInRaid() then return end
    if enabled.BestCommanders and bestAssignmentsNeeded(data, "Commander") then
        attempt("BestCommanders", 8, function()
            ShadowManage:FireServer("AssignBest", nil, nil)
