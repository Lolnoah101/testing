local function getCharacter()
    local character = LocalPlayer.Character
    if not character or LocalPlayer:GetAttribute("Traveling") then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or humanoid.Health <= 0 or not root or root.Anchored then
        return nil
    end

    if character:GetAttribute("Stunned")
        or character:GetAttribute("Downed")
        or character:GetAttribute("Extracting")
        or humanoid.Sit
        or humanoid.PlatformStand
    then
        return nil
    end

    return character, root
end

local function findNearestEnemy(radius)
    local _, root = getCharacter()
    if not root then
        return nil
    end

    local bestModel = nil
    local bestPart = nil
    local bestDistance = radius

    for _, model in ipairs(CollectionService:GetTagged(EnemyTag)) do
        if model:IsA("Model") and model.Parent
            and model:GetAttribute("Corpse") ~= true
            and model:GetAttribute("Dormant") ~= true
        then
            local hp = model:GetAttribute("Health")
            if type(hp) == "number" and hp > 0 then
                local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local distance = (root.Position - part.Position).Magnitude
                    if distance <= bestDistance then
                        bestDistance = distance
                        bestModel = model
                        bestPart = part
                    end
                end
            end
        end
    end

    return bestModel, bestPart
end

local function faceEnemy(enemyPart)
    local _, root = getCharacter()
    if not root or not enemyPart then
        return
    end
    -- The Heartbeat farm controller owns facing while following a target.
    if enabled.FarmDungeon and LocalPlayer:GetAttribute("Raid") then return end

    local from = root.Position
    local to = Vector3.new(enemyPart.Position.X, from.Y, enemyPart.Position.Z)
    if (to - from).Magnitude > 0.2 then
        root.CFrame = CFrame.lookAt(from, to)
    end
end

local function gameActionReady()
    return not SkillState.Blocked and not SkillState.Cinematic
end

local function commanderCount()
    local ok, data = pcall(function()
        return PlayerDataController.getData({})
    end)
    if not ok or type(data) ~= "table" then
        return nil -- The player's data may still be loading.
    end

    local commanders = data.shadows and data.shadows.commanders
    if type(commanders) ~= "table" then
        return 0
    end

    local count = 0
    for _ in pairs(commanders) do
        count = count + 1
    end
    return count
end

