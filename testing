--//============================================================
--// NEW 2026 AREA MARKER HANDOFF (HxH)
--// The game's NextAreaMarker client creates workspace.NextAreaMarker.Pad
--// ONLY when: startedAt exists, finishedAt does not, wave == 0,
--// rubbleArmed is false, and the server's area is the new area.
--// Don't infer the destination from an old area-center calculation.
--//============================================================
GENV.__AZ_FARM_EXT.GetGameAreaMarkerGoal = function(TargetArea)
    local Ext = GENV.__AZ_FARM_EXT
    local Current = tonumber(GetRunValue("area"))
    if Current ~= tonumber(TargetArea) then
        return nil, "Server has not announced the next area"
    end
    if tonumber(GetRunValue("wave")) ~= 0 then
        return nil, "Waiting for new-area wave-zero window"
    end
    local Model = workspace:FindFirstChild("NextAreaMarker")
    local Pad = Model and Model:FindFirstChild("Pad")
    if not Pad or not Pad:IsA("BasePart") then
        return nil, "Waiting for the game's AREA marker to appear"
    end
    local Label = Pad:FindFirstChild("Label")
    local Title = Label and Label:FindFirstChild("Title")
    local LabelText = Title and Title:IsA("TextLabel") and Title.Text or ""
    local MarkerArea = tonumber(string.match(LabelText, "AREA%s+(%d+)"))
    if MarkerArea ~= tonumber(TargetArea) then
        return nil, "AREA marker number does not match destination"
    end
    local Root = GetRoot()
    if not Root then
        return nil, "Character not ready"
    end
    local Human = Root.Parent and Root.Parent:FindFirstChildOfClass("Humanoid")
    local Height = math.clamp(
        (Human and Human.HipHeight or 2) + Root.Size.Y * 0.5,
        2.5, 6.5
    )
    local Area = GetAreaPart(tonumber(TargetArea))
    local MarkerPosition = Pad.Position
    local EntryPosition = MarkerPosition
    -- NextAreaMarker is a NAVIGATION hint, not an arrival trigger.  Some
    -- placed AreaEntries sit on the rim of the zone; standing at their pad
    -- can leave the player outside the actual wave-activation volume.
    -- Keep the marker's road height, but move the landing X/Z inside the
    -- server-selected area box by roughly ten studs on each edge.
    if IsHxhMap() and Area then
        local Local = Area.CFrame:PointToObjectSpace(MarkerPosition)
        local Half = Area.Size * 0.5
        local InsetX = math.min(10, Half.X * 0.45)
        local InsetZ = math.min(10, Half.Z * 0.45)
        local Interior = Area.CFrame:PointToWorldSpace(Vector3.new(
            math.clamp(Local.X, -Half.X + InsetX, Half.X - InsetX),
            Local.Y,
            math.clamp(Local.Z, -Half.Z + InsetZ, Half.Z - InsetZ)
        ))
        -- This is a server-reported area volume paired with the actual AREA
        -- marker; unlike older versions, don't apply a guessed max-distance
        -- cutoff that could strand the player at the entrance.
        EntryPosition = Vector3.new(Interior.X, MarkerPosition.Y, Interior.Z)
    end
    local TargetPosition = EntryPosition + Vector3.new(0, Height, 0)
    local LookAt = Area and Vector3.new(Area.Position.X, TargetPosition.Y, Area.Position.Z)
        or (TargetPosition + Root.CFrame.LookVector)
    if (LookAt - TargetPosition).Magnitude < 0.1 then
        LookAt = TargetPosition + Root.CFrame.LookVector
    end
    Ext.GameAreaMarkerNumber = MarkerArea
    Ext.GameAreaMarkerPosition = MarkerPosition
    Ext.GameAreaActivationPosition = TargetPosition
    return CFrame.lookAt(TargetPosition, LookAt), "AREA marker verified; target inset into activation area"
end

--//============================================================
--// GROUNDED AREA TARGET
--//
--// Area volumes are tall (their center Y is not the floor). If the
--// character gets shoved under a ramp/floor, reusing Root.Position.Y
--// keeps recovery targets underground. Raycast the map at the target X/Z
--// and place the recovery target just above the real surface instead.
--//============================================================

GENV.__AZ_FARM_EXT.GetGroundedAreaCFrame = function(
    AreaNumber,
    TargetCF
)

    if not TargetCF then
        return nil
    end


    local Area =
        GetAreaPart(
            AreaNumber
        )


    local World =
        workspace
            :FindFirstChild(
                "World"
            )


    local Map =
        World
        and World
            :FindFirstChild(
                "Map"
            )


    if not Area
        or not Map
    then

        return TargetCF
    end


    local Params =
        RaycastParams.new()


    Params.FilterType =
        Enum.RaycastFilterType.Include


    Params.FilterDescendantsInstances = {
        Map,
    }


    Params.IgnoreWater =
        true


    local Origin =
        Vector3.new(
            TargetCF.Position.X,
            Area.Position.Y,
            TargetCF.Position.Z
        )


    local Result =
        workspace:Raycast(
            Origin,
            Vector3.new(
                0,
                -(math.max(
                    Area.Size.Y,
                    80
                ) + 80),
                0
            ),
            Params
        )


    if not Result then
        return TargetCF
    end


    local SafePosition =
        Result.Position
        + Vector3.new(
            0,
            3.5,
            0
        )


    local LookAt =
        Vector3.new(
            Area.Position.X,
            SafePosition.Y,
            Area.Position.Z
        )


    if (
        LookAt
        - SafePosition
    ).Magnitude < 0.01
    then

        LookAt =
            SafePosition
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        SafePosition,
        LookAt,
        Vector3.yAxis
    )
end


--//============================================================
--// INSIDE AREA
--//============================================================

local function IsPlayerInsideArea(
    AreaNumber
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return false
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    return math.abs(Relative.X)
            <= Half.X
                + AREA_INSIDE_TOLERANCE

        and math.abs(Relative.Y)
            <= Half.Y
                + AREA_INSIDE_TOLERANCE

        and math.abs(Relative.Z)
            <= Half.Z
                + AREA_INSIDE_TOLERANCE
end


--//============================================================
--// HxH AREA ACTIVATION: STRICT INTERIOR, NOT NEAR-EDGE ARRIVAL
--// Mirrors the game marker's X/Z-only area-box check, with a margin
--// to make sure the player crosses the boundary far enough for waves.
--//============================================================
GENV.__AZ_FARM_EXT.IsHxhEntryDeep = function(AreaNumber, Inset)
    local Root = GetRoot()
    local Area = GetAreaPart(AreaNumber)
    if not Root or not Area then return false end
    local Local = Area.CFrame:PointToObjectSpace(Root.Position)
    local Half = Area.Size * 0.5
    local Margin = math.max(0, tonumber(Inset) or 3)
    local XLimit = Half.X - math.min(Margin, Half.X * 0.45)
    local ZLimit = Half.Z - math.min(Margin, Half.Z * 0.45)
    return math.abs(Local.X) <= XLimit
        and math.abs(Local.Z) <= ZLimit
end

--//============================================================
--// AREA ENTRY
--//============================================================

local function ComputeAreaEntryCFrame(
    AreaNumber,
    Depth
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return nil
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            Depth,
            math.max(
                Half.X - 2,
                2
            )
        )


    local ZInset =
        math.min(
            Depth,
            math.max(
                Half.Z - 2,
                2
            )
        )


    local YInset =
        math.min(
            3,
            math.max(
                Half.Y - 1,
                1
            )
        )


    local LocalTarget =
        Vector3.new(

            math.clamp(
                Relative.X,
                -Half.X + XInset,
                Half.X - XInset
            ),

            math.clamp(
                Relative.Y,
                -Half.Y + YInset,
                Half.Y - YInset
            ),

            math.clamp(
                Relative.Z,
                -Half.Z + ZInset,
                Half.Z - ZInset
            )
        )


    local WorldTarget =
        Area.CFrame
            :PointToWorldSpace(
                LocalTarget
            )


    local LookPosition =
        Vector3.new(
            Area.Position.X,
            WorldTarget.Y,
            Area.Position.Z
        )


    if (
        LookPosition
        - WorldTarget
    ).Magnitude < 0.01
    then

        LookPosition =
            WorldTarget
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        WorldTarget,
        LookPosition,
        Vector3.yAxis
    )
end


--//============================================================
--// BOUNDS
--//============================================================

local function GetInstanceBounds(Object)

    if not Object
        or not Object.Parent
    then

        return nil, nil
    end


    if Object:IsA(
        "BasePart"
    )
    then

        return Object.CFrame,
            Object.Size
    end


    if Object:IsA(
        "Model"
    )
    then

        local Success,
            BoundingCF,
            BoundingSize =
            pcall(function()

                return Object:GetBoundingBox()
            end)


        if Success then

            return BoundingCF,
                BoundingSize
        end
    end


    local FirstPart =
        Object
            :FindFirstChildWhichIsA(
                "BasePart",
                true
            )


    if FirstPart then

        return FirstPart.CFrame,
            FirstPart.Size
    end


    return nil, nil
end


--//============================================================
--// CLAMP POINT
--//============================================================

local function ClampPointInsideArea(
    Area,
    WorldPosition,
    Inset
)

    local LocalPosition =
        Area.CFrame
            :PointToObjectSpace(
                WorldPosition
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            Inset,
            math.max(
                Half.X - 1,
                1
            )
        )


    local ZInset =
        math.min(
            Inset,
            math.max(
                Half.Z - 1,
                1
            )
        )


    local YInset =
        math.min(
            3,
            math.max(
                Half.Y - 1,
                1
            )
        )


    local LocalTarget =
        Vector3.new(

            math.clamp(
                LocalPosition.X,
                -Half.X + XInset,
                Half.X - XInset
            ),

            math.clamp(
                LocalPosition.Y,
                -Half.Y + YInset,
                Half.Y - YInset
            ),

            math.clamp(
                LocalPosition.Z,
                -Half.Z + ZInset,
                Half.Z - ZInset
            )
        )


    return Area.CFrame
        :PointToWorldSpace(
            LocalTarget
        )
end


--//============================================================
--// AREA 5
--//============================================================

local function ComputeArea5SafeEntryCFrame()

    local Root =
        GetRoot()


    local Area5 =
        GetAreaPart(
            5
        )


    if not Root
        or not Area5
    then

        return nil
    end


    local Border4 =
        GetRubbleForArea(
            4
        )


    if Border4
        and Border4.Rubble
        and Border4.Rubble.Parent
    then

        local RubbleCF,
            RubbleSize =
            GetInstanceBounds(
                Border4.Rubble
            )


        if RubbleCF
            and RubbleSize
        then

            local Direction =
                Area5.Position
                - RubbleCF.Position


            Direction =
                Vector3.new(
                    Direction.X,
                    0,
                    Direction.Z
                )


            if Direction.Magnitude > 0.01 then

                Direction =
                    Direction.Unit


                local Extent =
                    math.abs(
                        Direction:Dot(
                            RubbleCF.RightVector
                        )
                    )
                    * (RubbleSize.X / 2)

                    + math.abs(
                        Direction:Dot(
                            RubbleCF.UpVector
                        )
                    )
                    * (RubbleSize.Y / 2)

                    + math.abs(
                        Direction:Dot(
                            RubbleCF.LookVector
                        )
                    )
                    * (RubbleSize.Z / 2)


                local SafePosition =
                    RubbleCF.Position

                    + Direction
                    * (
                        Extent
                        + AREA5_RUBBLE_CLEARANCE
                    )


                SafePosition =
                    Vector3.new(
                        SafePosition.X,
                        Root.Position.Y,
                        SafePosition.Z
                    )


                SafePosition =
                    ClampPointInsideArea(
                        Area5,
                        SafePosition,
                        AREA5_VOLUME_INSET
                    )


                return CFrame.lookAt(
                    SafePosition,
                    SafePosition + Direction,
                    Vector3.yAxis
                )
            end
        end
    end


    return ComputeAreaEntryCFrame(
        5,
        AREA5_FALLBACK_DEPTH
    )
end


--//============================================================
--// LOCK ENTRY
--//============================================================

local function GetLockedAreaEntryCFrame(
    AreaNumber
)

    if LockedAreaEntryNumber == AreaNumber
        and LockedAreaEntryCFrame
        and LockedAreaEntryMethod == Settings.FarmMethod
    then

        return LockedAreaEntryCFrame
    end


    local Target


    if AreaNumber == 5 then

        Target =
            ComputeArea5SafeEntryCFrame()

    else

        local Depth


        if Settings.FarmMethod == "Tween" then

            Depth =
                TWEEN_AREA_ENTRY_DEPTH

        else

            Depth =
                TELEPORT_AREA_ENTRY_DEPTH
        end


        Target =
            ComputeAreaEntryCFrame(
                AreaNumber,
                Depth
            )
    end


    if Target then

        Target =
            GENV.__AZ_FARM_EXT.GetGroundedAreaCFrame(
                AreaNumber,
                Target
            )


        LockedAreaEntryNumber =
            AreaNumber


        LockedAreaEntryCFrame =
            Target


        LockedAreaEntryMethod =
            Settings.FarmMethod
    end


    return Target
end


--//============================================================
--// ENTRY COMPLETE
--//============================================================

local function DistanceToLockedAreaTarget()

    local Root =
        GetRoot()


    if not Root
        or not LockedAreaEntryCFrame
    then

        return math.huge
    end


    return (
        Root.Position
        - LockedAreaEntryCFrame.Position
    ).Magnitude
end


local function HasCompletedAreaEntry(
    AreaNumber
)

    if not IsPlayerInsideArea(
        AreaNumber
    )
    then

        return false
    end


    if not LockedAreaEntryCFrame then
        return false
    end


    local RequiredDistance


    if Settings.FarmMethod == "Tween" then

        RequiredDistance =
            TWEEN_AREA_CONFIRM_DISTANCE

    else

        RequiredDistance =
            TELEPORT_AREA_CONFIRM_DISTANCE
    end


    return DistanceToLockedAreaTarget()
        <= RequiredDistance
end


--//============================================================
--// WAVE RECOVERY POSITION
--//============================================================

local function ComputeWaveRecoveryCFrame(
    AreaNumber,
    Attempt
)

    local Root =
        GetRoot()


    local Area =
        GetAreaPart(
            AreaNumber
        )


    if not Root
        or not Area
    then

        return nil
    end


    local Relative =
        Area.CFrame
            :PointToObjectSpace(
                Root.Position
            )


    local Half =
        Area.Size / 2


    local XInset =
        math.min(
            WAVE_RECOVERY_EDGE_INSET,
            math.max(
                Half.X - 2,
                2
            )
        )


    local ZInset =
        math.min(
            WAVE_RECOVERY_EDGE_INSET,
            math.max(
                Half.Z - 2,
                2
            )
        )


    local TargetX
    local TargetZ


    if Attempt <= 1 then

        local Planar =
            Vector3.new(
                Relative.X,
                0,
                Relative.Z
            )


        if Planar.Magnitude > 0.01 then

            local Candidate =
                Relative
                - Planar.Unit
                * WAVE_RECOVERY_NUDGE


            TargetX =
                Candidate.X


            TargetZ =
                Candidate.Z

        else

            TargetX = 0
            TargetZ = 0
        end


    else

        local Patterns = {

            { 0, 0 },

            { 0.30, 0 },

            { -0.30, 0 },

            { 0, 0.30 },

            { 0, -0.30 },

            { 0.22, 0.22 },

            { -0.22, 0.22 },

            { 0.22, -0.22 },

            { -0.22, -0.22 },
        }


        local Pattern =
            Patterns[
                (
                    (Attempt - 2)
                    % #Patterns
                ) + 1
            ]


        TargetX =
            Pattern[1]
            * math.max(
                Half.X - XInset,
                0
            )


        TargetZ =
            Pattern[2]
            * math.max(
                Half.Z - ZInset,
                0
            )
    end


    TargetX =
        math.clamp(
            TargetX,
            -Half.X + XInset,
            Half.X - XInset
        )


    TargetZ =
        math.clamp(
            TargetZ,
            -Half.Z + ZInset,
            Half.Z - ZInset
        )


    local TargetY =
        math.clamp(
            Relative.Y,
            -Half.Y + 3,
            Half.Y - 3
        )


    local WorldTarget =
        Area.CFrame
            :PointToWorldSpace(
                Vector3.new(
                    TargetX,
                    TargetY,
                    TargetZ
                )
            )


    local LookAt =
        Vector3.new(
            Area.Position.X,
            WorldTarget.Y,
            Area.Position.Z
        )


    if (
        LookAt
        - WorldTarget
    ).Magnitude < 0.01
    then

        LookAt =
            WorldTarget
            + Area.CFrame.LookVector
    end


    return CFrame.lookAt(
        WorldTarget,
        LookAt,
        Vector3.yAxis
    )
end


--//============================================================
--// GENERAL FARM STILLNESS RECOVERY
--//
--// If the server says enemies remain but enemyStore has no living enemy
--// and the character has not moved for the configured delay, hard-snap to
--// a grounded point farther inside the current area. This handles the
--// Area 5 edge/under-map stall shown in the user's screenshot.
--//============================================================

GENV.__AZ_FARM_EXT.RunStillnessRecovery = function()

    local Ext = GENV.__AZ_FARM_EXT

    -- Hxh's AREA marker is authoritative. The old generic stillness
    -- watchdog jumped to rotating area-center points while the server was
    -- loading enemies in Area 5, fighting the marker/entry controller.
    if IsHxhMap() then
        Ext.ResetStillness()
        return false
    end

    if not Settings.AutoFarm
        or not IsAlive()
    then

        Ext.ResetStillness()
        return false
    end


    local Root = GetRoot()

    local Area =
        tonumber(
            GetRunValue(
                "area"
            )
        )

    local Remaining =
        tonumber(
            GetRunValue(
                "remaining"
            )
        )

    local FinishedAt =
        GetRunValue(
            "finishedAt"
        )


    if not Root
        or not Area
        or FinishedAt ~= nil
    then

        Ext.ResetStillness()
        return false
    end


    -- The area-entry engine owns movement until arrival is confirmed.
    -- Stillness recovery must not overwrite its target with a random
    -- destination when enemy replication is temporarily empty.
    if Ext.PendingAreaEntry or TargetAreaNumber
        or Ext.CrossingArea ~= nil
        or Ext.ProgressionFault ~= nil
        or CurrentFarmMode == "Area Sync Paused"
        or CurrentFarmMode == "Waiting For Next Area"
        or CurrentFarmMode == "Adjacent Area Crossing"
        or CurrentFarmMode == "Rubble"
        or CurrentFarmMode == "Waiting For Rubble To Drop"
        or (type(Ext.AreaEntryState) == "string"
            and string.find(Ext.AreaEntryState, "Waiting for server area", 1, true))
    then
        Ext.ResetStillness()
        return false
    end

    local LivingEnemies =
        GetLivingEnemyCount()


    -- Only force a relocation when the run still expects enemies but the
    -- replicated enemy store has nothing for Auto Farm to target.
    if not Remaining
        or Remaining <= 0
        or LivingEnemies > 0
    then

        Ext.StillPosition = Root.Position
        Ext.StillSince = os.clock()
        Ext.StillRecoveryArea = Area
        Ext.StillRecoveryAttempt = 0

        return false
    end


    local Now = os.clock()


    if Ext.StillRecoveryArea ~= Area then

        Ext.ResetStillness()

        Ext.StillRecoveryArea = Area
        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    if not Ext.StillPosition then

        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    if (
        Root.Position
        - Ext.StillPosition
    ).Magnitude >= 2.25
    then

        Ext.StillPosition = Root.Position
        Ext.StillSince = Now

        return false
    end


    local Delay =
        math.clamp(
            tonumber(
                Settings.StuckRecoveryDelay
            ) or 2.5,
            1,
            6
        )


    if (
        Now
        - (Ext.StillSince or Now)
    ) < Delay
    then

        return false
    end


    if (
        Now
        - (Ext.LastStillRecoveryAt or 0)
    ) < 1.25
    then

        return false
    end


    Ext.StillRecoveryAttempt =
        (Ext.StillRecoveryAttempt or 0) + 1


    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            Area,
            Ext.StillRecoveryAttempt
        )


    if not RecoveryCF then
        return false
    end


    RecoveryCF =
        Ext.GetGroundedAreaCFrame(
            Area,
            RecoveryCF
        )


    if not RecoveryCF then
        return false
    end


    CurrentTargetId = nil
    CurrentTargetState = nil
    CurrentRubbleInfo = nil
    CurrentRubbleCFrame = nil
    TargetAreaNumber = nil


    DesiredFarmCFrame =
        RecoveryCF


    Root.CFrame =
        RecoveryCF


    Root.AssemblyLinearVelocity =
        Vector3.zero


    Root.AssemblyAngularVelocity =
        Vector3.zero


    Ext.LastStillRecoveryAt =
        Now

    Ext.StillPosition =
        RecoveryCF.Position

    Ext.StillSince =
        Now


    SetFarmMode(
        "Stuck Recovery"
    )


    print(
        "[Anime Zero] Farm stillness recovery | Area:",
        Area,
        "| Remaining:",
        Remaining,
        "| Attempt:",
        Ext.StillRecoveryAttempt
    )


    return true
end


--//============================================================
--// AREA ENTRY RECOVERY
--//============================================================

GENV.__AZ_FARM_EXT.HandleAreaEntryRecovery = function(
    AreaNumber
)

    if not AreaNumber then
        return nil
    end


    local Ext =
        GENV.__AZ_FARM_EXT


    local Now =
        os.clock()


    if Ext.AreaEntryRecoveryArea
        ~= AreaNumber
    then

        Ext.ResetAreaEntryRecovery()

        Ext.AreaEntryRecoveryArea =
            AreaNumber

        Ext.AreaEntryStartedAt =
            Now
    end


    if not Ext.AreaEntryStartedAt then

        Ext.AreaEntryStartedAt =
            Now
    end


    if (
        Now
        - Ext.AreaEntryStartedAt
    ) < Ext.AreaEntryRecoveryDelay
    then

        return Ext.LastAreaEntryRecoveryTarget
    end



    if Ext.AreaEntryRecoveryAttempt > 0
        and (
            Now
            - Ext.LastAreaEntryRecoveryAt
        ) < Ext.AreaEntryRecoveryRetry
    then

        return Ext.LastAreaEntryRecoveryTarget
    end



    Ext.AreaEntryRecoveryAttempt =
        Ext.AreaEntryRecoveryAttempt + 1


    -- Attempt 2 in the existing recovery pattern begins at the
    -- center, then cycles through several alternate points.
    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            AreaNumber,
            Ext.AreaEntryRecoveryAttempt + 1
        )


    if not RecoveryCF then
        return Ext.LastAreaEntryRecoveryTarget
    end


    RecoveryCF =
        Ext.GetGroundedAreaCFrame(
            AreaNumber,
            RecoveryCF
        )


    Ext.LastAreaEntryRecoveryAt =
        Now


    Ext.LastAreaEntryRecoveryTarget =
        RecoveryCF


    -- Make completion checks use the new point too.
    LockedAreaEntryNumber =
        AreaNumber

    LockedAreaEntryCFrame =
        RecoveryCF

    LockedAreaEntryMethod =
        Settings.FarmMethod


    return RecoveryCF
end


--//============================================================
--// BETWEEN WAVES
--//============================================================

local function IsBetweenWaves()

    local Wave =
        GetRunValue(
            "wave"
        )


    local WaveCount =
        GetRunValue(
            "waveCount"
        )


    local Remaining =
        GetRunValue(
            "remaining"
        )


    local FinishedAt =
        GetRunValue(
            "finishedAt"
        )


    if FinishedAt ~= nil then
        return false
    end


    if Wave == nil
        or WaveCount == nil
        or Remaining == nil
    then

        return false
    end


    if Remaining ~= 0 then
        return false
    end


    if Wave == 0
        and WaveCount > 0
    then

        return true
    end


    return Wave > 0
        and Wave < WaveCount
end


--//============================================================
--// WAVE RECOVERY
--//============================================================

local function HandleWaveRecovery(
    AreaNumber
)

    if not AreaNumber then
        return false
    end

    -- On updated Hxh, wave gaps are NOT proof that the player should move.
    -- The server and NextAreaMarker determine area entry; rotating wave
    -- recovery locations can send us across a recently lowered barrier.
    if IsHxhMap() then
        ResetWaveRecovery()
        DesiredFarmCFrame = nil
        SetFarmMode("Waiting For Wave")
        return true
    end

    if GetLivingEnemyCount() > 0 then

        ResetWaveRecovery()

        return false
    end


    if not IsBetweenWaves() then

        ResetWaveRecovery()

        return false
    end


    local Now =
        os.clock()


    if WaveRecoveryArea ~= AreaNumber then

        ResetWaveRecovery()

        WaveRecoveryArea =
            AreaNumber
    end


    if not WaveNoEnemySince then

        WaveNoEnemySince =
            Now
    end


    local ParticipantArea =
        GetLocalParticipantValue(
            "area"
        )


    local PhysicallyInside =
        IsPlayerInsideArea(
            AreaNumber
        )


    local CorrectArea =
        ParticipantArea == nil
        or ParticipantArea == AreaNumber


    local Delay


    if not PhysicallyInside
        or not CorrectArea
    then

        Delay =
            WAVE_OUTSIDE_RECOVERY_DELAY

    else

        Delay =
            WAVE_RECOVERY_DELAY
    end


    if (
        Now
        - WaveNoEnemySince
    ) < Delay
    then

        SetFarmMode(
            "Waiting For Wave"
        )


        DesiredFarmCFrame =
            LastWaveRecoveryTarget


        return true
    end


    if WaveRecoveryAttempt > 0
        and (
            Now
            - LastWaveRecoveryAt
        ) < WAVE_RECOVERY_RETRY
    then

        SetFarmMode(
            "Wave Recovery"
        )


        DesiredFarmCFrame =
            LastWaveRecoveryTarget


        return true
    end


    WaveRecoveryAttempt =
        WaveRecoveryAttempt + 1


    local RecoveryCF =
        ComputeWaveRecoveryCFrame(
            AreaNumber,
            WaveRecoveryAttempt
        )


    if not RecoveryCF then
        return true
    end


    LastWaveRecoveryAt =
        Now


    LastWaveRecoveryTarget =
        RecoveryCF


    DesiredFarmCFrame =
        RecoveryCF


    SetFarmMode(
        "Wave Recovery"
    )


    local Root =
        GetRoot()


    if Root then

        Root.CFrame =
            RecoveryCF
    end


    return true
end


--//============================================================
--// TELEPORT MOVEMENT
--//============================================================

local function ShouldTeleportUpdate(
    Root,
    TargetCF,
    Now
)

    if (
        Now
        - LastTeleportTime
    ) < TELEPORT_UPDATE_RATE
    then

        return false
    end


    if not LastTeleportGoal then
        return true
    end


    if (
        LastTeleportGoal.Position
        - TargetCF.Position
    ).Magnitude
        >= TELEPORT_TARGET_MOVE
    then

        return true
    end


    if (
        Root.Position
        - TargetCF.Position
    ).Magnitude
        >= TELEPORT_PLAYER_ERROR
    then

        return true
    end


    return false
end


local function ApplyTeleportEnemyFollow(
    Root,
    TargetCF,
    DeltaTime
)

    local Distance =
        (
            Root.Position
            - TargetCF.Position
        ).Magnitude


    if Distance
        >= TELEPORT_ENEMY_EMERGENCY_DISTANCE
    then

        Root.CFrame =
            TargetCF


        TeleportFollowingEnemy =
            true


        return
    end


    if not TeleportFollowingEnemy
        and Distance
            >= TELEPORT_ENEMY_SNAP_DISTANCE
    then

        Root.CFrame =
            TargetCF


        TeleportFollowingEnemy =
            true


        return
    end


    local Alpha =
        1
        - math.exp(
            -TELEPORT_ENEMY_FOLLOW_SHARPNESS
            * DeltaTime
        )


    Root.CFrame =
        Root.CFrame:Lerp(
            TargetCF,
            math.clamp(
                Alpha,
                0,
                1
            )
        )


    TeleportFollowingEnemy =
        true
end


--//============================================================
--// FARM MOVEMENT
--//============================================================

local function ApplyFarmMovement(
    DeltaTime
)

    local MovementEnabled =
        Settings.AutoFarm
        or (
            Settings.AutoPickupLoot
            and CurrentFarmMode
                == "Loot"
        )


    -- End outstanding motion if rubble/area entry no longer owns movement.
    local Ext = GENV.__AZ_FARM_EXT
    if not Settings.AutoFarm or CurrentFarmMode ~= "Rubble" then
        if Ext.RubbleTween then
            pcall(function() Ext.RubbleTween:Cancel() end)
            Ext.RubbleTween = nil
        end
        Ext.RubbleJourney = nil
    end
    if Ext.AreaMarkerTween and (not Settings.AutoFarm
        or not string.find(string.lower(CurrentFarmMode), "area marker", 1, true)
        and not string.find(string.lower(CurrentFarmMode), "area entry", 1, true)) then
        pcall(function() Ext.AreaMarkerTween:Cancel() end)
        Ext.AreaMarkerTween = nil
    end

    -- Keep noclip enabled while an independent Rubble/AREA Tween is PLAYING.
    -- These tweens can run even when DesiredFarmCFrame is temporarily nil;
    -- that must not restore collisions mid-flight.
    local RubbleTweenPlaying = Ext.RubbleTween ~= nil
        and Ext.RubbleTween.PlaybackState == Enum.PlaybackState.Playing
    local MarkerTweenPlaying = Ext.AreaMarkerTween ~= nil
        and Ext.AreaMarkerTween.PlaybackState == Enum.PlaybackState.Playing
    local OrdinaryTweenActive = DesiredFarmCFrame ~= nil
        and CurrentFarmMode ~= "Loot"
        and CurrentFarmMode ~= "Below Standby"
        and CurrentFarmMode ~= "Rubble"
        and CurrentFarmMode ~= "Waiting For Rubble To Drop"
    local UseTweenNoclip = MovementEnabled
        and Settings.FarmMethod == "Tween"
        and (RubbleTweenPlaying or MarkerTweenPlaying or OrdinaryTweenActive)


    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(
        UseTweenNoclip
    )


    if not MovementEnabled
        or not DesiredFarmCFrame
    then
        if Settings.FarmMethod == "Legit" and not MovementEnabled
            and type(GENV.__AZ_LEGIT_NAV) == "table" then
            GENV.__AZ_LEGIT_NAV.Reset("Farm disabled")
        end
        return
    end


    local Root =
        GetRoot()


    if not Root then
        return
    end

    if Settings.FarmMethod == "Legit" then
        -- A separate owner handles AREA markers; regular farm supplies
        -- enemies, rubble and the remaining grounded destinations.
        if CurrentFarmMode == "Rubble" then
            GENV.__AZ_LEGIT_NAV.Go(DesiredFarmCFrame, 1.8, "Rubble")
        elseif CurrentFarmMode == "Enemy" then
            GENV.__AZ_LEGIT_NAV.Go(DesiredFarmCFrame,
                math.clamp(Settings.FarmDistance or 7, 4, 10), "Enemy")
        elseif CurrentFarmMode == "Loot" then
            GENV.__AZ_LEGIT_NAV.Go(DesiredFarmCFrame, 3.0, "Loot")
        else
            GENV.__AZ_LEGIT_NAV.Go(DesiredFarmCFrame, 2.5, CurrentFarmMode)
        end
        return
    end

    -- Emergency stuck recovery for area transitions. The normal selected
    -- farm method gets the first chance to move. If the character is not
    -- getting closer for 1.25s (for example, wedged under map geometry),
    -- force a CFrame snap to the grounded target and zero residual velocity.
    local IsAreaMovement =
        TargetAreaNumber
        and (
            CurrentFarmMode
                == (
                    "Entering Area "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
            or CurrentFarmMode
                == (
                    "Area Recovery "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
        )


    if IsAreaMovement then

        local Ext =
            GENV.__AZ_FARM_EXT


        local Now =
            os.clock()


        local TargetPosition =
            DesiredFarmCFrame.Position


        local Distance =
            (
                Root.Position
                - TargetPosition
            ).Magnitude


        if not Ext.AreaMoveTarget
            or (
                Ext.AreaMoveTarget
                - TargetPosition
            ).Magnitude > 2
        then

            Ext.AreaMoveTarget =
                TargetPosition

            Ext.AreaMoveBestDistance =
                Distance

            Ext.AreaMoveLastProgressAt =
                Now

        elseif Distance
            < (
                (Ext.AreaMoveBestDistance or Distance)
                - 1.25
            )
        then

            Ext.AreaMoveBestDistance =
                Distance

            Ext.AreaMoveLastProgressAt =
                Now

        elseif Distance > 3
            and (
                Now
                - (Ext.AreaMoveLastProgressAt or Now)
            ) >= 1.25
            and (
                Now
                - (Ext.LastAreaHardSnapAt or 0)
            ) >= 1.00
        then

            -- A failed area move can mean the server hasn't opened the gate.
            -- Don't hard-snap through it and trigger later areas prematurely.
            Ext.AreaEntryState = "Area movement stalled; waiting for server"
            Ext.LastAreaHardSnapAt =
                Now

            Ext.AreaMoveLastProgressAt =
                Now

            Ext.AreaMoveBestDistance =
                0

            Ext.AreaHardSnapCount =
                (Ext.AreaHardSnapCount or 0)
                + 1


            LastTeleportGoal =
                DesiredFarmCFrame


            LastTeleportTime =
                Now


            print(
                "[Anime Zero] Area stuck recovery hard-snap | Area:",
                TargetAreaNumber,
                "| Attempt:",
                Ext.AreaHardSnapCount
            )


            return
        end

    else

        local Ext =
            GENV.__AZ_FARM_EXT

        Ext.AreaMoveTarget = nil
        Ext.AreaMoveBestDistance = nil
        Ext.AreaMoveLastProgressAt = 0
        Ext.AreaHardSnapCount = 0
    end


    if CurrentFarmMode == "Wave Recovery"
        or CurrentFarmMode == "Waiting For Wave"
    then

        -- Defensive check: Hxh must NEVER hard-snap to a generic wave goal.
        if IsHxhMap() then
            return
        end

        if (
            Root.Position
            - DesiredFarmCFrame.Position
        ).Magnitude > 2
        then

            Root.CFrame =
                DesiredFarmCFrame
        end


        return
    end


    -- If the updated character controller continuously corrects the root while
    -- Tween mode is active, do not sit still forever.  Detect a target that is
    -- not getting closer and pivot the whole character once as a recovery.
    if CurrentFarmMode == "Enemy" then

        local Ext =
            GENV.__AZ_FARM_EXT


        local EnemyDistance =
            (
                Root.Position
                - DesiredFarmCFrame.Position
            ).Magnitude


        local Now =
            os.clock()


        if not Ext.EnemyMoveTarget
            or (
                Ext.EnemyMoveTarget
                - DesiredFarmCFrame.Position
            ).Magnitude > 2
        then

            Ext.EnemyMoveTarget =
                DesiredFarmCFrame.Position

            Ext.EnemyMoveBestDistance =
                EnemyDistance

            Ext.EnemyMoveLastProgressAt =
                Now

        elseif EnemyDistance
            < (
                (Ext.EnemyMoveBestDistance or EnemyDistance)
                - 0.75
            )
        then

            Ext.EnemyMoveBestDistance =
                EnemyDistance

            Ext.EnemyMoveLastProgressAt =
                Now

        elseif EnemyDistance > 3
            and (
                Now
                - (Ext.EnemyMoveLastProgressAt or Now)
            ) >= 0.80
            and (
                Now
                - (Ext.LastEnemyMoveSnapAt or 0)
            ) >= 0.80
        then

            local Character =
                GetCharacter()


            if Character then
                Character:PivotTo(
                    DesiredFarmCFrame
                )
            else
                Root.CFrame =
                    DesiredFarmCFrame
            end


            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero


            Ext.LastEnemyMoveSnapAt =
                Now

            Ext.EnemyMoveLastProgressAt =
                Now

            Ext.EnemyMoveBestDistance =
                0


            return
        end

    else

        GENV.__AZ_FARM_EXT.EnemyMoveTarget = nil
        GENV.__AZ_FARM_EXT.EnemyMoveBestDistance = nil
        GENV.__AZ_FARM_EXT.EnemyMoveLastProgressAt = 0
    end


    -- Above/Below use one damped movement path regardless of the selected
    -- method once close to the target. This prevents physics + repeated hard
    -- snaps from making the horizontal hold bounce or glitch. Farm Distance is
    -- still the existing single distance control; no new sliders are added.
    if CurrentFarmMode == "Enemy"
        and (
            Settings.FarmPosition == "Above"
            or Settings.FarmPosition == "Below"
        )
    then

        local HorizontalCharacter =
            GetCharacter()

        local HorizontalHumanoid =
            HorizontalCharacter
            and HorizontalCharacter:FindFirstChildOfClass("Humanoid")
            or nil

        if not GENV.__AZ_FARM_EXT.HorizontalHoldActive then
            GENV.__AZ_FARM_EXT.HorizontalAutoRotateWas =
                HorizontalHumanoid
                and HorizontalHumanoid.AutoRotate
                or nil
        end

        GENV.__AZ_FARM_EXT.HorizontalHoldActive = true

        if HorizontalHumanoid then
            HorizontalHumanoid.AutoRotate = false
        end


        local HoldDistance =
            (
                Root.Position
                - DesiredFarmCFrame.Position
            ).Magnitude


        if Settings.FarmMethod == "Teleport"
            and HoldDistance > 24
        then

            Root.CFrame =
                DesiredFarmCFrame

        else

            local HoldAlpha


            if Settings.FarmMethod == "Tween"
                and HoldDistance > 12
            then

                HoldAlpha =
                    math.clamp(
                        (TWEEN_SPEED * DeltaTime)
                        / math.max(
                            HoldDistance,
                            0.001
                        ),
                        0,
                        1
                    )

            else

                HoldAlpha =
                    math.clamp(
                        1
                        - math.exp(
                            -20 * DeltaTime
                        ),
                        0,
                        1
                    )
            end


            local SmoothPosition =
                Root.Position:Lerp(
                    DesiredFarmCFrame.Position,
                    HoldAlpha
                )

            Root.CFrame =
                CFrame.new(SmoothPosition)
                * DesiredFarmCFrame.Rotation
        end


        Root.AssemblyLinearVelocity =
            Vector3.zero

        Root.AssemblyAngularVelocity =
            Vector3.zero


        TeleportFollowingEnemy =
            true


        return
    end


    -- Restore normal Roblox rotation as soon as Above/Below no longer owns
    -- the enemy hold. This also prevents the setting from leaking into manual
    -- movement after Auto Farm is turned off or changes position mode.
    if GENV.__AZ_FARM_EXT.HorizontalHoldActive then
        local RestoreCharacter = GetCharacter()
        local RestoreHumanoid =
            RestoreCharacter
            and RestoreCharacter:FindFirstChildOfClass("Humanoid")
            or nil

        if RestoreHumanoid
            and GENV.__AZ_FARM_EXT.HorizontalAutoRotateWas ~= nil
        then
            RestoreHumanoid.AutoRotate =
                GENV.__AZ_FARM_EXT.HorizontalAutoRotateWas
        end

        GENV.__AZ_FARM_EXT.HorizontalHoldActive = false
        GENV.__AZ_FARM_EXT.HorizontalAutoRotateWas = nil
    end


    -- After defeating the last enemy, stand upright on the detected map
    -- floor. No repeated CFrame hold: Roblox gravity handles the standing.
    if CurrentFarmMode == "Below Standby" then
        local Ext = GENV.__AZ_FARM_EXT
        local Token = tostring(Ext.BelowStandbyWorld) .. ":" .. tostring(Ext.BelowStandbyArea)
        if Ext.BelowStandbyTeleportToken ~= Token then
            Ext.BelowStandbyTeleportToken = Token
            Root.CFrame = CFrame.new(DesiredFarmCFrame.Position) * CFrame.Angles(0, math.rad(Root.Orientation.Y), 0)
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end
        return
    end

    -- HxH RUBBLE: A single movement owner with a non-permanent retry state.
    -- If the game corrects our position after a move, retry the SAME visible
    -- rubble goal after a paced cooldown. Never chase rubble from another
    -- area, and never issue a new command while a Tween is still running.
    if CurrentFarmMode == "Rubble" then
        local Ext = GENV.__AZ_FARM_EXT
        local Goal = DesiredFarmCFrame
        local Blocker = Ext.RubbleLastBlocker
        local Now = os.clock()
        local Distance = (Root.Position - Goal.Position).Magnitude
        local Outside = Ext.RubbleLastVisual ~= nil
        Ext.RubbleLastMoveDistance = Distance
        Ext.RubbleLastExterior = Outside

        local J = Ext.RubbleJourney
        local DifferentTarget = J and (
            J.Blocker ~= Blocker
            or J.Character ~= Root.Parent
            or J.Area ~= Ext.RubbleLastArea
            or J.Method ~= Settings.FarmMethod
            or (J.Goal.Position - Goal.Position).Magnitude > 2
        )
        if DifferentTarget then
            if Ext.RubbleTween then
                pcall(function() Ext.RubbleTween:Cancel() end)
                Ext.RubbleTween = nil
            end
            Ext.SetTweenNoclipEnabled(false)
            Ext.RubbleJourney = nil
            Ext.RubbleLastDisplacement = nil
            Ext.RubbleMoveAttempts = 0
            J = nil
        end

        -- Goal is already about 3 studs IN FRONT of the visible rubble.
        -- Let a Tween reach the goal instead of stopping far from the wall.
        -- Require a short stable arrival period to catch server rollbacks.
        if Outside and Distance <= 1.8 then
            if Ext.RubbleTween then
                pcall(function() Ext.RubbleTween:Cancel() end)
                Ext.RubbleTween = nil
            end
            Ext.SetTweenNoclipEnabled(false)
            if not J then
                J = {
                    Blocker = Blocker, Character = Root.Parent,
                    Area = Ext.RubbleLastArea, Goal = Goal,
                    Method = Settings.FarmMethod,
                    State = "Near rubble", NearAt = Now,
                    Attempts = 0, StartedAt = Now,
                    Reason = "Within rubble attack position",
                }
                Ext.RubbleJourney = J
            end
            if not J.NearAt then
                J.NearAt = Now
            end
            J.State = (Now - J.NearAt >= 0.65)
                and "Arrived" or "Confirming arrival"
            J.Reason = J.State
            Ext.RubbleMotionState = J.State
            Ext.RubbleApproachReason = J.Reason
            Ext.RubbleUnsafeGoal = false
            return
        end

        local function ClearActiveTween()
            if Ext.RubbleTween then
                pcall(function() Ext.RubbleTween:Cancel() end)
                Ext.RubbleTween = nil
            end
            Ext.SetTweenNoclipEnabled(false)
        end

        -- Wait for an in-flight movement to finish before scheduling a retry.
        -- The server may correct a sudden Teleport; a Tween might be rejected
        -- at its end. Either outcome must not permanently disable farming.
        if J then
            if (J.State == "Moving" or J.State == "Settling")
                and Now < (J.FinishAt or 0)
            then
                Ext.RubbleMotionState =
                    J.Method .. " approach " .. tostring(J.Attempts or 1)
                return
            end

            if J.State == "Moving" or J.State == "Settling"
                or J.State == "Confirming arrival"
                or J.State == "Near rubble"
                or J.State == "Arrived"
            then
                ClearActiveTween()
                local Attempts = math.max(J.Attempts or 1, 1)
                local Delay = math.min(1.5 * (1.7 ^ math.min(Attempts - 1, 5)), 12)
                J.State = "Retry cooldown"
                J.NearAt = nil
                J.NextRetryAt = Now + Delay
                J.Reason = "Position moved away; retrying same rubble in "
                    .. tostring(math.floor(Delay * 10) / 10) .. "s"
                Ext.RubbleLastDisplacement = {
                    at = Now,
                    distance = Distance,
                    secondsAfterMove = Now - (J.StartedAt or Now),
                    position = Root.Position,
                    area = Ext.ValidatedArea,
                    attempt = Attempts,
                }
                warn("[Anime Zero][Rubble] Returned from rubble | distance:",
                    math.floor(Distance * 10) / 10,
                    "| attempt:", Attempts,
                    "| retry in:", math.floor(Delay * 10) / 10, "seconds")
            end
            if Now < (J.NextRetryAt or 0) then
                Ext.RubbleMotionState = J.Reason
                Ext.RubbleApproachReason = J.Reason
                return
            end
        end

        -- Re-check area and rubble health BEFORE EACH attempt. An area change,
        -- cleared rubble, or invalid goal may temporarily prevent travel, but
        -- the guard is re-evaluated instead of permanently becoming Paused.
        local Allowed, Reason = Ext.ValidateRubbleDirectRoute(
            Root, Goal, Ext.RubbleLastArea
        )
        Ext.RubbleApproachReason = Reason
        Ext.RubbleUnsafeGoal = not Allowed
        if not Allowed then
            ClearActiveTween()
            if not J then
                J = {
                    Blocker = Blocker, Character = Root.Parent,
                    Area = Ext.RubbleLastArea, Goal = Goal,
                    Method = Settings.FarmMethod,
                    Attempts = 0, StartedAt = Now,
                }
                Ext.RubbleJourney = J
            end
            J.State = "Waiting for valid rubble"
            J.Reason = Reason
            J.NextRetryAt = Now + 3
            Ext.RubbleMotionState = "Waiting for valid rubble: " .. tostring(Reason)
            if Now >= (J.NextWarnAt or 0) then
                warn("[Anime Zero][Rubble] Waiting:", tostring(Reason))
                J.NextWarnAt = Now + 12
            end
            return
        end

        local Method = Settings.FarmMethod == "Tween" and "Tween" or "Teleport"
        local Duration = Method == "Tween"
            and math.max(Distance / math.max(Settings.TweenSpeed or 95, 1), 0.12)
            or 0.8
        if not J then
            J = {
                Blocker = Blocker, Character = Root.Parent,
                Area = Ext.RubbleLastArea, Goal = Goal, Method = Method,
                Attempts = 0,
            }
            Ext.RubbleJourney = J
        end
        J.Attempts = (J.Attempts or 0) + 1
        J.State = Method == "Tween" and "Moving" or "Settling"
        J.FinishAt = Now + Duration + (Method == "Tween" and 0.35 or 0)
        J.StartedAt = Now
        J.NearAt = nil
        J.NextRetryAt = nil
        J.Reason = "Approach " .. tostring(J.Attempts)
        Ext.RubbleMoveGoal = Goal.Position
        Ext.RubbleMoveBlocker = Blocker
        Ext.RubbleMoveCharacter = Root.Parent
        Ext.RubbleMoveAttempts = J.Attempts
        Ext.RubbleLastMoveAt = Now
        Ext.RubbleMotionState = Method .. " approach " .. tostring(J.Attempts)
        if Method == "Tween" then
            Ext.SetTweenNoclipEnabled(true)
            local Tween = game:GetService("TweenService"):Create(
                Root,
                TweenInfo.new(Duration, Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out),
                {CFrame = Goal}
            )
            Ext.RubbleTween = Tween
            Tween:Play()
        else
            local Character = GetCharacter()
            if Character then
                Character:PivotTo(Goal)
            else
                Root.CFrame = Goal
            end
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end
        LastTeleportGoal = Goal
        LastTeleportTime = Now
        return
    end

    -- Loot ignores Farm Method: one instant move per locked drop, with
    -- confirmation/cooldown managed by RunAutoPickupLoot.
    if CurrentFarmMode == "Loot" then
        GENV.__AZ_FARM_EXT.TeleportToLootOnce(Root, DesiredFarmCFrame)
        return
    end


    if Settings.FarmMethod == "Teleport" then

        if CurrentFarmMode == "Enemy"
            and CurrentTargetId
        then

            ApplyTeleportEnemyFollow(
                Root,
                DesiredFarmCFrame,
                DeltaTime
            )


            return
        end


        TeleportFollowingEnemy =
            false


        local Now =
            os.clock()


        if ShouldTeleportUpdate(
            Root,
            DesiredFarmCFrame,
            Now
        )
        then

            Root.CFrame =
                DesiredFarmCFrame


            LastTeleportGoal =
                DesiredFarmCFrame


            LastTeleportTime =
                Now
        end


        return
    end


    TeleportFollowingEnemy =
        false


    local Distance =
        (
            Root.Position
            - DesiredFarmCFrame.Position
        ).Magnitude


    if Distance <= 0.05 then

        Root.CFrame =
            DesiredFarmCFrame


        return
    end


    local Speed =
        Settings.TweenSpeed or TWEEN_SPEED


    if TargetAreaNumber
        and (
            CurrentFarmMode
                == (
                    "Entering Area "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
            or CurrentFarmMode
                == (
                    "Area Recovery "
                    .. tostring(
                        TargetAreaNumber
                    )
                )
        )
    then

        Speed =
            Settings.TweenSpeed or AREA_TWEEN_SPEED
    end


    local Alpha =
        math.clamp(
            (
                Speed
                * DeltaTime
            )
            / Distance,
            0,
            1
        )


    Root.CFrame =
        Root.CFrame:Lerp(
            DesiredFarmCFrame,
            Alpha
        )
end


