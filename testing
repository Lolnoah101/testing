--//============================================================
--// TWEEN NOCLIP
--//
--// Tweening the HumanoidRootPart alone does NOT disable Roblox
--// collision. While Tween farm movement is active, temporarily
--// disable character-part collisions and restore their original
--// values as soon as Tween movement stops.
--//============================================================

GENV.__AZ_FARM_EXT.TweenNoclipOriginal =
    setmetatable(
        {},
        { __mode = "k" }
    )


GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled = function(
    Enabled
)

    local OriginalParts =
        GENV.__AZ_FARM_EXT.TweenNoclipOriginal


    if Enabled then

        local Character =
            GetCharacter()


        if not Character then
            return
        end


        for _, Part in ipairs(
            Character:GetDescendants()
        ) do

            if Part:IsA(
                "BasePart"
            )
            then

                if OriginalParts[
                    Part
                ] == nil
                then

                    OriginalParts[
                        Part
                    ] =
                        Part.CanCollide
                end


                if Part.CanCollide then
                    Part.CanCollide = false
                end
            end
        end


        return
    end


    for Part, Original in pairs(
        OriginalParts
    ) do

        if Part
            and Part.Parent
        then

            pcall(function()
                Part.CanCollide =
                    Original
            end)
        end


        OriginalParts[Part] =
            nil
    end
end


local function IsAlive()

    local Character =
