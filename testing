--========================================================
-- CHARACTER
--========================================================

local function GetCharacter()
    return Player.Character
        or Player.CharacterAdded:Wait()
end

local function GetHumanoid()
    local Character = GetCharacter()

    return Character:FindFirstChildOfClass("Humanoid")
        or Character:WaitForChild("Humanoid")
end

local function GetRootPart()
    local Character = GetCharacter()

    return Character:FindFirstChild("HumanoidRootPart")
        or Character:WaitForChild("HumanoidRootPart")
end

local function GetRootHeight()
    local Humanoid = GetHumanoid()
    local RootPart = GetRootPart()

    local Height =
        (tonumber(Humanoid.HipHeight) or 0)
        + (RootPart.Size.Y / 2)

    if Height < 2.5 then
        Height = 3
    end

    return Height
        + Settings.SmartTweenRootClearance
end

local function SmartDebug(...)
    if Settings.SmartTweenDebug then
        print(
            "[SmartTween]",
            ...
        )
    end
end

--========================================================
-- BANKING
--========================================================

local BankingBusy = false
local SuppressAutoDeposit = false
local AutoDepositThread = nil

local function GetBankCapacity()
    local Parts =
        string.split(
            tostring(ExtraSpaces.Value),
            " "
        )

    local UpgradeAmount =
        tonumber(Parts[1]) or 0

    if UpgradeAmount ~= UpgradeAmount
        or UpgradeAmount < 0
    then
        UpgradeAmount = 0
    end

    return
        5000000
        + (UpgradeAmount * 500000)
end

local function GetMaxDeposit()
    local WalletAmount =
        tonumber(Money.Value) or 0

    local BankAmount =
        tonumber(Bank.Value) or 0

    local BankRoom =
        math.max(
            0,
            GetBankCapacity()
                - BankAmount
        )

    return math.max(
        0,
        math.floor(
            math.min(
                WalletAmount,
                BankRoom,
                500000
            )
        )
    )
end

local function GetMaxWithdraw()
    local WalletAmount =
        tonumber(Money.Value) or 0

    local BankAmount =
        tonumber(Bank.Value) or 0

    local WalletRoom =
        math.max(
            0,
            2500000
                - WalletAmount
        )

    return math.max(
        0,
        math.floor(
            math.min(
                BankAmount,
                WalletRoom,
                500000
            )
        )
    )
end

local function WaitForBankChange(
    BeforeMoney,
    BeforeBank,
    Timeout
)
    Timeout = Timeout or 2.5

    local Started = os.clock()

    while os.clock() - Started < Timeout do
        if Money.Value ~= BeforeMoney
            or Bank.Value ~= BeforeBank
        then
            return true
        end

        task.wait(0.05)
    end

    return false
end

local function StartDepositSweep()
    if not Settings.AutoDeposit
        or SuppressAutoDeposit
        or AutoDepositThread
    then
        return
    end

    AutoDepositThread =
        task.spawn(function()

            while Settings.AutoDeposit
                and not SuppressAutoDeposit
            do
                local Amount =
                    GetMaxDeposit()

                if Amount <= 0 then
                    break
                end

                while BankingBusy do
                    if not Settings.AutoDeposit
                        or SuppressAutoDeposit
                    then
                        break
                    end

                    task.wait(0.05)
                end

                if not Settings.AutoDeposit
                    or SuppressAutoDeposit
                then
                    break
                end

                BankingBusy = true

                local BeforeMoney =
                    Money.Value

                local BeforeBank =
                    Bank.Value

                ATM:FireServer(
                    "Deposit",
                    Amount
                )

                local Changed =
                    WaitForBankChange(
                        BeforeMoney,
                        BeforeBank,
                        2.5
                    )

                BankingBusy = false

                if not Changed then
                    break
                end

                task.wait(0.12)
            end

            AutoDepositThread = nil
        end)
end

Money.Changed:Connect(function()
    if Settings.AutoDeposit
        and not SuppressAutoDeposit
        and not BankingBusy
    then
        StartDepositSweep()
    end
end)

local function WithdrawSelectedAmount()
    if BankingBusy then
        return
    end

    local MaxWithdraw =
        GetMaxWithdraw()

    if MaxWithdraw <= 0 then
        return
    end

    local Requested =
        math.floor(
            tonumber(
                Settings.WithdrawAmount
            ) or 0
        )

    if Requested <= 0 then
        return
    end

    local Amount =
        math.clamp(
            Requested,
            1,
            MaxWithdraw
        )

    SuppressAutoDeposit = true
    BankingBusy = true

    local BeforeMoney =
        Money.Value

    local BeforeBank =
        Bank.Value

    ATM:FireServer(
        "Withdraw",
        Amount
    )

    WaitForBankChange(
        BeforeMoney,
        BeforeBank,
        2.5
    )

    BankingBusy = false

    task.wait(0.35)

    SuppressAutoDeposit = false
end

--========================================================
-- PLAYTIME REWARDS
--========================================================

local PlaytimeClaimBusy = false

local function FindPlaytimeRewardButton(
    RewardID
)
    local PlayerGui =
        Player:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    RewardID = tostring(RewardID)

    for _, Object in ipairs(
        PlayerGui:GetDescendants()
    ) do
        if Object:IsA("ImageButton")
            and Object.Name == RewardID
            and Object:FindFirstChild("Reward")
            and Object:FindFirstChild("Timer")
        then
            return Object
        end
    end

    return nil
end

local function IsPlaytimeRewardClaimed(
    Button
)
    if not Button then
        return false
    end

    return
        Button.Image
            == "rbxassetid://111932831426204"

        or

        Button.Image
            == "rbxassetid://83991779313221"
end

local function IsPlaytimeRewardReady(
    RewardID
)
    RewardID =
        tostring(RewardID)

    local RequiredTime =
        PlayTimeRewards.Timer[
            RewardID
        ]

    if not RequiredTime then
        return false
    end

    if (tonumber(PlayTime.Value) or 0)
        < RequiredTime
    then
        return false
    end

    local Button =
        FindPlaytimeRewardButton(
            RewardID
        )

    if not Button
        or IsPlaytimeRewardClaimed(
            Button
        )
    then
        return false
    end

    local Timer =
        Button:FindFirstChild("Timer")

    if Timer
        and Timer.Visible
    then
        return false
    end

    return true, Button
end

local function TryClaimPlaytimeRewards()
    if not Settings.AutoClaimPlaytimeRewards
        or PlaytimeClaimBusy
    then
        return
    end

    PlaytimeClaimBusy = true

    for RewardNumber = 1, 8 do
        if not Settings.AutoClaimPlaytimeRewards then
            break
        end

        local RewardID =
            tostring(RewardNumber)

        local Ready, Button =
            IsPlaytimeRewardReady(
                RewardID
            )

        if Ready
            and Button
        then
            ClaimReward:FireServer(
                RewardID,
                Button
            )

            task.wait(0.25)
        end
    end

    PlaytimeClaimBusy = false
end

PlayTime.Changed:Connect(function()
    if Settings.AutoClaimPlaytimeRewards then
        task.defer(
            TryClaimPlaytimeRewards
        )
    end
end)

task.spawn(function()
    while true do
        if Settings.AutoClaimPlaytimeRewards then
            TryClaimPlaytimeRewards()
        end

        task.wait(1)
    end
end)

