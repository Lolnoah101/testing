function Systems.equipBait(baitId)
    local bait = Catalog.Bait.GetById(baitId)

    if not bait then
        State.BaitStatus = "Unknown bait"
        return false
    end

    local data = getPlayerData()

    if bait.isConsumable
        and Systems.getBaitCount(data, baitId) <= 0 then

        if Config.BaitFallbackToWorm then
            baitId = Catalog.Bait.DefaultBaitId
            bait = Catalog.Bait.GetById(baitId)
        else
            State.BaitStatus = "No " .. tostring(bait.name) .. " remaining"
            return false
        end
    end

    if safeFire(FishingPackets.SetBait, baitId) then
        State.BaitStatus = "Selected " .. tostring(bait.name)
        return true
    end

    State.BaitStatus = "SetBait failed"
    return false
end

