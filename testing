    if Farm.fastResumeFlags.KillAura then Farm:StartAura() end
    if Farm.fastResumeFlags.CombatAutoSkillsV46 then
        Farm.autoCombatSkills = true
        startOpWatcher()
    end
    Farm.fastResumeStatus = "Restored saved gameplay controls before Rayfield"
    do end
end
