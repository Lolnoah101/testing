        local function MoveFarm2(DeltaTime)
            local IsRaid =
                GENV.__AZ_IS_RAID_MODE()

            local FarmEnabled =
                (IsRaid and Settings.AutoRaidFarm == true)
                or (GENV.__AZ_IS_TRIALS_MODE() and Settings.AutoTrialsFarm == true)
                or (GENV.__AZ_IS_FLOOD_ESCAPE() and Settings.AutoTidalFarm == true)
                or (not IsRaid and not GENV.__AZ_IS_TRIALS_MODE()
                    and not GENV.__AZ_IS_FLOOD_ESCAPE()
                    and Settings.AutoFarm == true)

            local WantsHorizontalHold =
                FarmEnabled and not GENV.__AZ_IS_FLOOD_ESCAPE()
                and workspace:GetAttribute("Mode") ~= "fateraid"
                and (
                    Settings.FarmPosition == "Above"
                    or Settings.FarmPosition == "Below"
                )

            if not FarmEnabled or not Alive2() then
                Rescue.SetHorizontalHoldActive(false)
                Rescue.RaidDodgeActive = false
                Rescue.RaidDodgeGoal = nil
                Rescue.RaidDodgeCombatReady = false
                return
            end

            local _, EnemyRoot =
                NearestEnemy2()

            Rescue.SetHorizontalHoldActive(
                Settings.FarmMethod ~= "Legit"
                and WantsHorizontalHold and EnemyRoot ~= nil
                and not GENV.__AZ_IS_FLOOR_EXIT_READY()
            )

            local Root =
                GetRoot2()

            if not Root then
                return
            end

            -- Fate Raid: platform entry has exclusive movement ownership
            -- until the game activates the first wave. Never confuse the
            -- lower spawn/stairway with a fall from the arena.
            if IsRaid and workspace:GetAttribute("Mode") == "fateraid" then
                local _, ArenaArea = Rescue.GetRaidRouteObjects()
                if not ArenaArea then
                    Rescue.RaidState = "Fate: waiting for activation area"
                    return
                end
                if Rescue.HandleFateEntry(Root, ArenaArea, DeltaTime) then
                    return
                end
            end

            local EnemyFarmGoal =
                EnemyRoot
                and DesiredEnemyCFrame2(EnemyRoot)
                or nil

            if GENV.__AZ_IS_FLOOD_ESCAPE() and EnemyFarmGoal then
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
                local Project = GENV.__AZ_TIDAL_SAFE_COMBAT_GOAL
                local Safe = type(Project) == "function"
                    and Project(EnemyFarmGoal.Position, Root) or nil
                if not Safe then
                    Rescue.RaidState = "Tidal: no walkable combat surface"
                    return
                end
                EnemyFarmGoal = Safe
            end

            -- In Fate Raid, a Below-offset enemy goal would pass beneath the
            -- raised platform. Keep that goal at a verified floor height.
            if IsRaid and workspace:GetAttribute("Mode") == "fateraid"
                and EnemyFarmGoal
            then
                local _, ArenaArea = Rescue.GetRaidRouteObjects()
                local FloorGoal = ArenaArea
                    and Rescue.GetFateArenaGoal(Root, ArenaArea) or nil
                if FloorGoal and EnemyFarmGoal.Position.Y < FloorGoal.Position.Y - 0.5 then
                    local Position = EnemyFarmGoal.Position
                    EnemyFarmGoal = CFrame.new(
                        Position.X, FloorGoal.Position.Y, Position.Z
                    ) * EnemyFarmGoal.Rotation
                end
            end

            -- Trials elevator has absolute movement priority. Waiting for
            -- enemy count to be zero can fail because stale enemies survive
            -- for a few client frames after the end-of-room banner.
            if GENV.__AZ_IS_TRIALS_MODE()
                and GENV.__AZ_IS_FLOOR_EXIT_READY()
                and (tonumber(ReadRunValue2("remaining")) or 0) <= 0
            then
                if Rescue.HandleRaidRoute(Root, nil) then
                    return
                end
            end

            if not IsRaid then
                Rescue.RaidState = "Inactive"
                Rescue.RaidDodgeState = "Idle"

                if not GENV.__AZ_IS_TRIALS_MODE()
                    and not GENV.__AZ_IS_FLOOD_ESCAPE()
                    and not EnemyRoot
                    and Rescue.RunNormalProgressionAssist(DeltaTime)
                then
                    return
                end
            end

            -- AOE safety has first movement priority while the raid is active.
            -- It consumes the exact enemySpikes telegraph packet plus the
            -- game's own aoeIndicator parts for other telegraphed boss slams.
            if IsRaid
                and workspace:GetAttribute("Mode") ~= "fateraid"
                and workspace:GetAttribute("RaidExitOpen") ~= true
            then
                local _, RaidArea =
                    Rescue.GetRaidRouteObjects()

                local DodgeGoal =
                    Rescue.GetRaidDodgeGoal(
                        Root,
                        RaidArea,
                        EnemyFarmGoal
                    )

                if DodgeGoal then
                    -- Dodge movement has EXCLUSIVE priority. Move quickly but
                    -- smoothly to the locked safe point; do not teleport back
                    -- and forth between the boss and the hazard.
                    local DodgeDistance =
                        (Root.Position - DodgeGoal.Position).Magnitude

                    if DodgeDistance > 0.05 and Settings.FarmMethod == "Legit" then
                        GENV.__AZ_LEGIT_NAV.Go(DodgeGoal, 2.0, "Raid Dodge")
                    elseif DodgeDistance > 0.05 then
                        local DodgeAlpha =
                            math.clamp(
                                (240 * DeltaTime)
                                / math.max(DodgeDistance, 0.001),
                                0,
                                1
                            )

                        local DodgePosition =
                            Root.Position:Lerp(
                                DodgeGoal.Position,
                                DodgeAlpha
                            )

                        Root.CFrame =
                            CFrame.new(DodgePosition)
                            * Root.CFrame.Rotation
                    end

                    if Settings.FarmMethod ~= "Legit" then
                        Root.AssemblyLinearVelocity = Vector3.zero
                        Root.AssemblyAngularVelocity = Vector3.zero
                    end

                    -- Movement runs before combat every heartbeat. As soon as
                    -- we have reached the safe point, allow ranged/remote skills
                    -- and ultimate to continue while the AOE is still active.
                    -- Auto M1 remains paused so its lunge cannot pull us back in.
                    local _, StillInDanger =
                        Rescue.CollectRaidThreats(Root.Position)

                    Rescue.RaidDodgeCombatReady =
                        not StillInDanger
                        and (Root.Position - DodgeGoal.Position).Magnitude <= 3.5

                    Rescue.RaidState =
                        "Dodge "
                        .. tostring(
                            Rescue.RaidDodgeState
                        )
                    return
                end
            end

            -- A cleared raid elevator must outrank Auto Arise's hold.
            -- Otherwise a corpse prompt can keep the avatar from returning
            -- to the circular center pad at the end of a raid segment.
            if IsRaid and workspace:GetAttribute("RaidExitOpen") == true then
                if Rescue.HandleRaidRoute(Root, nil) then
                    return
                end
            end

            -- Arise gets a tiny prompt-first movement handoff after AOE safety.
            -- If a defeated enemy just became raisable, stay beside it for a
            -- few frames so its ProximityPrompt can replicate and confirm before
            -- Auto Farm teleports to the next target. Dodge safety still wins.
            if Rescue.ShouldHoldForArise(Root) then
                Rescue.RaidState = "Arise Prompt"
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero
                return
            end

            -- Trials' original controller owns normal loot movement. Never
            -- let the separate raid rescue heartbeat move us to another point
            -- while a locked drop is being approached.
            if not IsRaid
                and Settings.AutoPickupLoot
                and CurrentFarmMode == "Loot"
            then
                Rescue.RaidState = "Smooth loot (normal controller)"
                return
            end

            -- During an empty raid wave, let the common locked-drop controller
            -- supply a target. This is SMOOTH motion, not repeated CFrame snaps.
            -- Combat, dodge, arise and exit/lift checks above still win.
            if IsRaid
                and Settings.AutoPickupLoot
                and not EnemyRoot
                and (tonumber(ReadRunValue2("remaining")) or 0) <= 0
                and not GENV.__AZ_IS_FLOOR_EXIT_READY()
            then
                local Ext = GENV.__AZ_FARM_EXT
                local Goal = Ext
                    and type(Ext.GetLootTargetCFrame) == "function"
                    and Ext.GetLootTargetCFrame()
                    or nil
                if Goal then
                    if Settings.FarmMethod == "Legit" then
                        GENV.__AZ_LEGIT_NAV.Go(Goal, 3, "Raid Loot")
                    else
                        GENV.__AZ_FARM_EXT.TeleportToLootOnce(Root, Goal)
                    end
                    Rescue.RaidState = "Loot pickup confirmation"
                    return
                end
            end

            -- Raid routing handles no-enemy periods by staying inside the live
            -- World.Areas volume, then uses the elevator when RaidExitOpen opens.
            if IsRaid
                and Rescue.HandleRaidRoute(
                    Root,
                    EnemyRoot
                )
            then
                return
            end

            if not EnemyRoot then
                if Settings.FarmMethod ~= "Legit"
                    and not GENV.__AZ_IS_FLOOD_ESCAPE()
                    and not IsRaid and Settings.FarmPosition == "Below"
                    and not GENV.__AZ_IS_FLOOR_EXIT_READY()
                then
                    local Ext = GENV.__AZ_FARM_EXT
                    local Standby = Ext.GetBelowSurfaceGoal(
                        Root, nil, ReadRunValue2("area")
                    )
                    if Standby then
                        local Token = tostring(Ext.BelowStandbyWorld)
                            .. ":" .. tostring(Ext.BelowStandbyArea)
                        if Ext.BelowStandbyTeleportToken ~= Token then
                            Ext.BelowStandbyTeleportToken = Token
                            Root.CFrame = Standby
                            Root.AssemblyLinearVelocity = Vector3.zero
                            Root.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
                return
            end

            local Goal =
                EnemyFarmGoal
                or DesiredEnemyCFrame2(
                    EnemyRoot
                )

            if not Goal then
                return
            end

            if Settings.FarmMethod == "Legit" then
                -- Above/Below are aerial holds; walking uses a grounded
                -- approach regardless of the selected farm position.
                GENV.__AZ_LEGIT_NAV.Go(Goal,
                    math.clamp(Settings.FarmDistance or 7, 4, 10),
                    GENV.__AZ_IS_FLOOD_ESCAPE() and "Tidal Enemy"
                        or (GENV.__AZ_IS_TRIALS_MODE() and "Trials Enemy" or "Raid Enemy"))
                return
            end

            local HorizontalHold =
                workspace:GetAttribute("Mode") ~= "fateraid"
                and not GENV.__AZ_IS_FLOOD_ESCAPE()
                and (Settings.FarmPosition == "Above"
                    or Settings.FarmPosition == "Below")

            if HorizontalHold then
                local HoldDistance =
                    (
                        Root.Position
                        - Goal.Position
                    ).Magnitude

                -- Teleport mode still gets into range immediately when far
                -- away, but once in range it becomes a damped horizontal hold
                -- instead of hard-setting CFrame every heartbeat. Tween mode
                -- uses its normal travel speed while far away and the same
                -- damped hold once close. No extra UI sliders are needed.
                if Settings.FarmMethod ~= "Tween"
                    and HoldDistance > 24
                then
                    Root.CFrame = Goal

                else
                    local Alpha

                    if Settings.FarmMethod == "Tween"
                        and HoldDistance > 12
                    then
                        Alpha = math.clamp(
                            (135 * DeltaTime)
                            / math.max(HoldDistance, 0.001),
                            0,
                            1
                        )
                    else
                        Alpha = math.clamp(
                            1 - math.exp(-20 * DeltaTime),
                            0,
                            1
                        )
                    end

                    local SmoothPosition =
                        Root.Position:Lerp(
                            Goal.Position,
                            Alpha
                        )

                    -- Position is damped, orientation is exact. Lerp-ing the
                    -- full CFrame let the humanoid upright correction win part
                    -- of every frame, which looked like a forward lean.
                    Root.CFrame =
                        CFrame.new(SmoothPosition)
                        * Goal.Rotation
                end

                -- Kill leftover physics motion that otherwise makes a
                -- horizontal character bounce, roll, or wobble in place.
                Root.AssemblyLinearVelocity = Vector3.zero
                Root.AssemblyAngularVelocity = Vector3.zero

                return
            end

            if Settings.FarmMethod == "Tween" then
                local Distance =
                    (
                        Root.Position
                        - Goal.Position
                    ).Magnitude

                if Distance > 0.05 then
                    local Alpha =
                        math.clamp(
                            (
                                (GENV.__AZ_IS_FLOOD_ESCAPE()
                                    and (tonumber(Settings.TweenSpeed) or 95)
                                    or 135)
                                * DeltaTime
                            )
                            / math.max(
                                Distance,
                                0.001
                            ),
                            0,
                            1
                        )

                    Root.CFrame =
                        Root.CFrame:Lerp(
                            Goal,
                            Alpha
                        )
                end
            else
                Root.CFrame =
                    Goal
            end
        end


        local function CooldownReady2(Store, Slot)
            if not Store
                or not Store.state
                or not Store.state.cooldowns
            then
                return true
            end

            local CharacterName = nil

            pcall(function()
                CharacterName = Store.state.character:get()
            end)

            if not CharacterName then
                return true
            end

            local Key =
                type(PlayerNamespace2.skillCooldownKey) == "function"
                and PlayerNamespace2.skillCooldownKey(CharacterName, Slot)
                or (tostring(CharacterName) .. ".skill" .. tostring(Slot))

            local Success, CooldownLeaf = pcall(function()
                return Store.state.cooldowns:get(Key)
            end)

            if not Success or not CooldownLeaf then
                return true
            end

            local Till = tonumber(ReadLeaf(CooldownLeaf))

            return not Till
                or workspace:GetServerTimeNow() >= Till
        end


        local function FireSkill2(Slot)
            if not Alive2()
                or not CharacterPackets2.performSkill
            then
                return false
            end

            local Store = GetPlayerStore2()
            if not Store then
                return false
            end

            local CharacterName = nil
            pcall(function()
                CharacterName = Store.state.character:get()
            end)
            if not CharacterName then
                return false
            end

            -- Replicate native characterController.performSkill:
            -- during the character's own bonus window, requesting Ultimate 4
            -- uses the bonus slot (usually 5), not slot 4 again.
            local EffectiveSlot = Slot
            local CharacterInfo = CharacterConstants2
                and CharacterConstants2.charactersByName
                and CharacterConstants2.charactersByName[CharacterName]
            local SkillInfo = CharacterInfo and CharacterInfo.skills
                and CharacterInfo.skills[Slot]
            local BonusSlot = SkillInfo and SkillInfo.bonus
            local ServerNow = workspace:GetServerTimeNow()
            if BonusSlot
                and (tonumber(LocalPlayerObject:GetAttribute("BonusUntil")) or 0) > ServerNow
                and (LocalPlayerObject:GetAttribute("BonusSlot") or Slot) == Slot
                and CharacterInfo.skills[BonusSlot]
            then
                EffectiveSlot = BonusSlot
            end

            if not CooldownReady2(Store, EffectiveSlot) then
                return false
            end

            -- The base Ultimate requires the meter; a temporary bonus move
            -- does not (the official client makes this same distinction).
            if EffectiveSlot == 4 then
                local Progress = nil
                pcall(function()
                    Progress = Store.state.ultProgress:get()
                end)
                if (tonumber(Progress) or 0) < 100
                    or LocalPlayerObject:GetAttribute("UltimateLocked")
                then
                    return false
                end
            end

            if Settings.SkillMethod == "Use Skill Keys" then
                return GENV.__AZ_SEND_SKILL_KEY(Slot)
            end

            Rescue.Sequence =
                (Rescue.Sequence % 4294967295) + 1

            local Request = {
                id = Rescue.Sequence,
                char = CharacterName,
                character = LocalPlayerObject.Character,
                skill = EffectiveSlot,
                expiresAt = ServerNow + 1,
            }

            local Success = pcall(function()
                CharacterPackets2.performSkill:fire(Request)
            end)
            if Success then
                GENV.__AZ_FARM_EXT.LastSkillSentAt = ServerNow
                GENV.__AZ_FARM_EXT.LastSkillSentSlot = EffectiveSlot
                GENV.__AZ_FARM_EXT.LastSkillSentRequestId = Request.id
            end
            if Success and Slot == 4 then
                Rescue.LastUltimateRequestSlot = EffectiveSlot
                Rescue.LastUltimateRequestAt = ServerNow
            end
            return Success
        end


        local function RunCombat2()
            if not Alive2() then
                return
            end

            -- During an active Raid dodge, movement still owns the character,
            -- but once we are actually standing at the safe dodge point we may
            -- keep using selected skills/ultimate from there. M1 is suppressed
            -- until the boss farm point is safe again because M1 movement can
            -- drag the character straight back into the AOE.
            local DodgeSkillOnly =
                GENV.__AZ_IS_RAID_MODE()
                and Rescue.RaidDodgeActive

            if type(GENV.__AZ_FARM_EXT.TickAutoBlock) == "function" then
                GENV.__AZ_FARM_EXT.TickAutoBlock(DodgeSkillOnly == true)
            end

            if DodgeSkillOnly
                and not Rescue.RaidDodgeCombatReady
            then
                return
            end

            local _, EnemyRoot, EnemyDistance = NearestEnemy2()
            local Root = GetRoot2()
            local Now = os.clock()

            if not EnemyRoot then
                if not GENV.__AZ_IS_RAID_MODE()
                    and not GENV.__AZ_IS_TRIALS_MODE()
                    and Settings.AutoFarm
                    and Settings.AutoM1
                    and Root
                    and CharacterPackets2.performM1
                then
                    local Rubble = Rescue.FindNormalRubble(Root)

                    if Rubble and Rubble.Goal
                        and (Root.Position - Rubble.Goal.Position).Magnitude <= 12
                        and Now >= Rescue.NextM1
                    then
                        Rescue.NextM1 = Now + 0.40

                        pcall(function()
                            CharacterPackets2.performM1:fire()
                        end)
                    end
                end

                return
            end

            if Settings.AutoM1
                and not DodgeSkillOnly
                and Now >= Rescue.NextM1
                and CharacterPackets2.performM1
            then
                Rescue.NextM1 = Now + 0.42

                pcall(function()
                    CharacterPackets2.performM1:fire()
                end)
            end


            if Settings.AutoSkills
                and Now >= Rescue.NextSkill
            then
                Rescue.NextSkill = Now + 0.16

                local Slots = {}

                for Slot = 1, 3 do
                    local Name = "Skill " .. tostring(Slot)

                    if type(Settings.SelectedSkills) ~= "table"
                        or Settings.SelectedSkills[Name] ~= false
                    then
                        table.insert(Slots, Slot)
                    end
                end

                if #Slots > 0 then
                    Rescue.SkillCursor =
                        ((Rescue.SkillCursor - 1) % #Slots) + 1

                    FireSkill2(Slots[Rescue.SkillCursor])

                    Rescue.SkillCursor =
                        (Rescue.SkillCursor % #Slots) + 1
                end
            end


            if Settings.AutoUltimate
                and Now >= Rescue.NextUltimate
            then
                Rescue.NextUltimate = Now + 0.35
                FireSkill2(4)
            end


            if DodgeSkillOnly then
                return
            end

            -- Auto Block has one shared engine for Story, Trials and Raids.
            -- This former loop spammed hold requests and attempted blind parries
            -- merely because an enemy was close; the shared engine handles
            -- guard, cooldowns, true target + attack timing and release.

        end


        Rescue.ShouldHoldForArise = function(Root)
            if not Settings.AutoArise
                or not Root
                or os.clock() >= (Rescue.AriseMovementHoldUntil or 0)
            then
                return false
            end

            local Part = Rescue.ArisePendingPart

            if not Part
                or not Part.Parent
                or Part:GetAttribute("RaisedBy") ~= nil
            then
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return false
            end

            -- Never let Arise freeze the farm after we've already left the
            -- corpse. The hold exists only to stop the immediate next-target
            -- teleport while the prompt is still replicating/being confirmed.
            return (Root.Position - Part.Position).Magnitude <= 24
        end


        Rescue.RunArise = function()
            if not Settings.AutoArise then
                Rescue.AriseState = "Off"
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return
            end

            if not Alive2() then
                Rescue.AriseState = "NotAlive"
                return
            end

            if os.clock() < (Rescue.NextArise or 0)
                or Rescue.AriseBusy
            then
                return
            end

            -- Run faster than the movement handoff. This is intentionally a
            -- short polling interval: a shadow prompt can appear between the
            -- enemy dying and Auto Farm selecting the next enemy.
            Rescue.NextArise = os.clock() + 0.035

            -- Arise belongs to Sung Jinwoo. Checking the live player store
            -- prevents us from firing somebody else's prompts after switching.
            local Store = GetPlayerStore2()
            local CharacterName = nil

            if Store and Store.state and Store.state.character then
                pcall(function()
                    CharacterName = ReadLeaf(Store.state.character)
                end)
            end

            if CharacterName ~= "sung_jinwoo" then
                Rescue.AriseState = "Need Sung Jinwoo"
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return
            end

            local ShadowFolder = workspace:FindFirstChild("AriseShadows")

            if not ShadowFolder then
                Rescue.AriseState = "Waiting"
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return
            end

            local Raised = tonumber(LocalPlayerObject:GetAttribute("AriseShadows")) or 0
            local Slots = tonumber(LocalPlayerObject:GetAttribute("AriseSlots")) or 0

            if Slots > 0 and Raised >= Slots then
                Rescue.AriseState = "Full " .. tostring(Raised) .. "/" .. tostring(Slots)
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return
            end

            local BestPrompt = nil
            local BestPart = nil
            local BestExpires = math.huge
            local BestDistance = math.huge
            local Root = GetRoot2()
            local ServerNow = workspace:GetServerTimeNow()
            local Now = os.clock()
            local SawUnpromptedNearby = nil
            local SawUnpromptedDistance = math.huge

            for _, Spot in ipairs(ShadowFolder:GetChildren()) do
                if Spot:IsA("BasePart")
                    and Spot:GetAttribute("RaisedBy") == nil
                then
                    local ExpiresAt = tonumber(Spot:GetAttribute("ExpiresAt")) or math.huge
                    local Distance = Root and (Root.Position - Spot.Position).Magnitude or math.huge
                    local Prompt = Spot:FindFirstChildOfClass("ProximityPrompt")

                    if Prompt and Prompt.Enabled ~= false then
                        -- Prefer the shadow that will expire first; distance
                        -- breaks ties. The executor prompt trigger lets us do
                        -- this without permanently stealing farm movement.
                        if ExpiresAt < BestExpires
                            or (ExpiresAt == BestExpires and Distance < BestDistance)
                        then
                            BestPrompt = Prompt
                            BestPart = Spot
                            BestExpires = ExpiresAt
                            BestDistance = Distance
                        end
                    elseif Distance < SawUnpromptedDistance then
                        -- The part often arrives just before the prompt. Remember
                        -- the nearby corpse so movement can wait a couple frames.
                        SawUnpromptedNearby = Spot
                        SawUnpromptedDistance = Distance
                    end
                end
            end

            if not BestPart and SawUnpromptedNearby then
                if Rescue.ArisePendingPart ~= SawUnpromptedNearby then
                    Rescue.ArisePendingPart = SawUnpromptedNearby
                    Rescue.ArisePendingSince = Now
                    Rescue.AriseAttempts = 0
                end

                if SawUnpromptedDistance <= 24
                    and Now - (Rescue.ArisePendingSince or Now) <= 0.38
                then
                    Rescue.AriseMovementHoldUntil =
                        math.max(Rescue.AriseMovementHoldUntil or 0, Now + 0.08)
                    Rescue.AriseState = "Waiting Prompt"
                else
                    Rescue.AriseState = "Waiting"
                end

                return
            end

            if not BestPrompt or not BestPart then
                Rescue.AriseState = "Waiting"
                Rescue.ArisePendingPart = nil
                Rescue.AriseMovementHoldUntil = 0
                return
            end

            if BestExpires ~= math.huge and BestExpires <= ServerNow then
                Rescue.AriseState = "Expired"
                return
            end

            if Rescue.ArisePendingPart ~= BestPart then
                Rescue.ArisePendingPart = BestPart
                Rescue.ArisePendingSince = Now
                Rescue.AriseAttempts = 0
            end

            -- If we're still beside the defeated enemy, give the prompt a
            -- tiny confirmation window before farm movement chooses a new target.
            -- This is capped from first sight so a broken prompt can never trap us.
            if BestDistance <= 24
                and Now - (Rescue.ArisePendingSince or Now) <= 0.48
            then
                Rescue.AriseMovementHoldUntil =
                    math.max(Rescue.AriseMovementHoldUntil or 0, Now + 0.10)
            end

            -- A pcall success only means the executor accepted the trigger; it
            -- does NOT prove the server raised the shadow. Retry quickly until
            -- RaisedBy changes instead of waiting the old 0.85 seconds.
            if Rescue.AriseLastPrompt == BestPrompt
                and Now - (Rescue.AriseLastAt or 0) < 0.075
            then
                Rescue.AriseState = "Confirming"
                return
            end

            Rescue.AriseLastPrompt = BestPrompt
            Rescue.AriseLastAt = Now
            Rescue.AriseBusy = true
            Rescue.AriseAttempts = (Rescue.AriseAttempts or 0) + 1
            Rescue.AriseState =
                "Raising "
                .. tostring(BestPrompt.ObjectText ~= "" and BestPrompt.ObjectText or BestPart.Name)
                .. " #"
                .. tostring(Rescue.AriseAttempts)

            local Fired = false

            if type(fireproximityprompt) == "function" then
                Fired = pcall(function()
                    fireproximityprompt(BestPrompt)
                end)
            end

            -- Fallback for executors where fireproximityprompt is unavailable.
            -- Use Roblox's normal hold path only while we're already close.
            if not Fired and Root then
                local MaxDistance = tonumber(BestPrompt.MaxActivationDistance) or 10

                if (Root.Position - BestPart.Position).Magnitude <= MaxDistance + 1 then
                    Fired = pcall(function()
                        BestPrompt:InputHoldBegin()

                        task.delay(
                            math.max(tonumber(BestPrompt.HoldDuration) or 0, 0) + 0.03,
                            function()
                                pcall(function()
                                    BestPrompt:InputHoldEnd()
                                end)
                            end
                        )
                    end)
                end
            end

            if not Fired then
                Rescue.AriseState = "PromptUnsupported"
            end

            -- Clear busy almost immediately so an unconfirmed prompt gets more
            -- than one chance before Auto Farm leaves the corpse.
            task.delay(0.035, function()
                if Rescue.Active then
                    Rescue.AriseBusy = false
                end
            end)
        end



        -- Loot pickup and the target lock live in the common dropStore
        -- controller. This raid handler is diagnostic-only: a second caller
        -- firing recoverDrop/moving Root was fighting the smooth loot route.
        local function RunLoot2()
            local Ext = GENV.__AZ_FARM_EXT
            if not Settings.AutoPickupLoot then
                Rescue.LootState = "Disabled"
                return
            end

            Rescue.LootState =
                Ext and Ext.LootStatus
                or "Waiting for drop scanner"
        end


        -- Reliable end-action owner for the updated run place. Auto Retry is
        -- intentionally owned by this runtime only. The older Story loop is
        -- left as a fallback only when this runtime is unavailable.
        --
        -- Important: the game briefly returns to a waiting / wave-0 state when
        -- Retry begins. Sending another Retry during that transition can strand
        -- the run on "Get Ready". We therefore:
        --   1) wait for a stable result marker,
        --   2) send Retry once,
        --   3) lock Retry until the next run is genuinely active, and
        --   4) re-send the game's normal ready/boot handshake once if startup
        --      is still waiting several seconds later.
        Rescue.RunEndAction = function()
            if not Settings.AutoRetry
                or workspace:GetAttribute("Mode") == "infinite"
                or not Rescue.RunPackets
                or not Rescue.RunPackets.endAction
                or not RunStore2
                or not RunStore2.store
                or not RunStore2.store.state
            then
                Rescue.EndActionState = "Idle"
                Rescue.RetryResultSeenKey = nil
                Rescue.RetryResultSeenAt = 0
                Rescue.RetryAwaitingStart = false
                Rescue.RetryAwaitingSince = 0
                Rescue.RetryReadyNudged = false
                Rescue.RetryStuckLeaveAt = 0
                Rescue.PreRunWaitingSince = 0
                Rescue.PreRunReadyNudged = false
                Rescue.PreRunStuckLeaveAt = 0
                return
            end

            local Now = os.clock()
            local State = RunStore2.store.state
            local UserId = tostring(LocalPlayerObject.UserId)
            local Participant = nil

            pcall(function()
                Participant = State.participants:get(UserId)
            end)

            if not Participant then
                Rescue.EndActionState = "NoParticipant"
                return
            end

            local Status = ReadLeaf(Participant.status)
            local StartedAt = ReadRunValue2("startedAt")

            local ParticipantFinishedAt =
                ReadLeaf(Participant.finishedAt)

            local RunFinishedAt =
                ReadRunValue2("finishedAt")

            local ResultEndsAt =
                ReadRunValue2("resultEndsAt")

            local HasResultMarker =
                ParticipantFinishedAt ~= nil
                or RunFinishedAt ~= nil
                or ResultEndsAt ~= nil

            -- A real active run is the only thing that releases the post-Retry
            -- startup lock. This prevents a transient waiting state from being
            -- mistaken for another completed run.
            if Status == "active"
                and StartedAt ~= nil
            then
                if Rescue.RetryAwaitingStart then
                    print(
                        "[Anime Zero] Auto Retry | new run confirmed active | startedAt:",
                        tostring(StartedAt)
                    )
                end

                Rescue.RetryAwaitingStart = false
                Rescue.RetryAwaitingSince = 0
                Rescue.RetryReadyNudged = false
                Rescue.RetryStuckLeaveAt = 0
                Rescue.RetryResultSeenKey = nil
                Rescue.RetryResultSeenAt = 0
                Rescue.PreRunWaitingSince = 0
                Rescue.PreRunReadyNudged = false
                Rescue.PreRunStuckLeaveAt = 0
                Rescue.EndActionState = "RunActive"
                return
            end

            -- Once Retry has been sent, NEVER send another Retry while the new
            -- run is still starting. If the server remains on Get Ready for a
            -- few seconds, replay the same two readiness events the game's boot
            -- LocalScript normally fires. This is one-shot and does not touch
            -- farm movement, difficulty, or queue settings.
            if Rescue.RetryAwaitingStart then
                local Waited =
                    Now - (Rescue.RetryAwaitingSince or Now)

                Rescue.EndActionState =
                    "WaitingRunStart "
                    .. string.format("%.1fs", Waited)

                if Waited >= 4.0
                    and not Rescue.RetryReadyNudged
                    and StartedAt == nil
                then
                    Rescue.RetryReadyNudged = true

                    local ReadyFired = false
                    local BootedFired = false

                    if Rescue.RunPackets.clientReady then
                        ReadyFired = pcall(function()
                            Rescue.RunPackets.clientReady:fire()
                        end)
                    end

                    if Rescue.RunPackets.clientBooted then
                        BootedFired = pcall(function()
                            Rescue.RunPackets.clientBooted:fire()
                        end)
                    end

                    print(
                        "[Anime Zero] Auto Retry | startup ready nudge | ready:",
                        tostring(ReadyFired),
                        "| booted:",
                        tostring(BootedFired)
                    )
                end

                -- If Retry was accepted but the new run is still stuck on
                -- Get Ready / wave 0, abandon that broken run and return to the
                -- lobby. Arm the matching Auto Join mode first so the lobby
                -- immediately creates the dungeon again.
                local Wave = tonumber(ReadRunValue2("wave")) or 0
                local TravelStatus = ReadLeaf(Participant.travelStatus)

                if Waited >= 8.0
                    and StartedAt == nil
                    and Wave == 0
                    and TravelStatus == "idle"
                    and Now - (Rescue.RetryStuckLeaveAt or 0) >= 2.0
                then
                    Rescue.RetryStuckLeaveAt = Now

                    local CurrentMode =
                        tostring(workspace:GetAttribute("Mode") or "")

                    if type(GENV.__AZ_IS_RAID_MODE) == "function"
                        and GENV.__AZ_IS_RAID_MODE(CurrentMode)
                    then
                        Settings.AutoJoinRaid = true
                        Settings.AutoJoinMap = false
                        Settings.AutoJoinEndless = false

                        if type(Settings.SetLobbyUserPreference) == "function" then
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinRaid", true)
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinMap", false)
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinEndless", false)
                        end
                    else
                        Settings.AutoJoinMap = true
                        Settings.AutoJoinRaid = false
                        Settings.AutoJoinEndless = false

                        if type(Settings.SetLobbyUserPreference) == "function" then
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinMap", true)
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinRaid", false)
                            pcall(Settings.SetLobbyUserPreference, "AutoJoinEndless", false)
                        end
                    end

                    pcall(function()
                        if type(Settings.PersistLobbyPreferences) == "function" then
                            Settings.PersistLobbyPreferences()
                        end

                        if type(Settings.PersistEndActionSettings) == "function" then
                            Settings.PersistEndActionSettings()
                        end

                        if type(Settings.ArmRemoteAutoExecute) == "function" then
                            Settings.ArmRemoteAutoExecute()
                        end
                    end)

                    local Left = pcall(function()
                        Rescue.RunPackets.endAction:fire(3)
                    end)

                    Rescue.EndActionState =
                        Left
                        and "StuckLeavingLobby"
                        or "StuckLeaveRetry"

                    print(
                        "[Anime Zero] Auto Retry | Get Ready stuck | leaving to lobby for clean requeue | sent:",
                        tostring(Left)
                    )
                end

                return
            end

            -- If status has already flipped active but old result markers are
            -- still draining, treat it as a transition and never vote again.
            if Status == "active"
                and HasResultMarker
            then
                Rescue.EndActionState = "RunActiveTransition"
                return
            end

            -- Never vote from a generic pre-run waiting state. A completed run
            -- must expose at least one real result marker first. While wave 0 is
            -- waiting, run a one-shot readiness watchdog as a recovery for the
            -- exact "Get Ready / 00:00 / 0 enemies" state.
            if not HasResultMarker then
                Rescue.RetryResultSeenKey = nil
                Rescue.RetryResultSeenAt = 0

                local Wave = tonumber(ReadRunValue2("wave")) or 0

                if StartedAt == nil
                    and Wave == 0
                then
                    if (Rescue.PreRunWaitingSince or 0) <= 0 then
                        Rescue.PreRunWaitingSince = Now
                        Rescue.PreRunReadyNudged = false
                    end

                    local Waited =
                        Now - (Rescue.PreRunWaitingSince or Now)

                    Rescue.EndActionState =
                        "PreRunWaiting "
                        .. string.format("%.1fs", Waited)

                    if Waited >= 5.0
                        and not Rescue.PreRunReadyNudged
                    then
                        Rescue.PreRunReadyNudged = true

                        local ReadyFired = false
                        local BootedFired = false

                        if Rescue.RunPackets.clientReady then
                            ReadyFired = pcall(function()
                                Rescue.RunPackets.clientReady:fire()
                            end)
                        end

                        if Rescue.RunPackets.clientBooted then
                            BootedFired = pcall(function()
                                Rescue.RunPackets.clientBooted:fire()
                            end)
                        end

                        print(
                            "[Anime Zero] Get Ready watchdog | ready:",
                            tostring(ReadyFired),
                            "| booted:",
                            tostring(BootedFired)
                        )
                    end

                    -- Also recover if this updated script is injected while the
                    -- client is already stuck on Get Ready. Give a little more
                    -- time than the post-Retry path so a normal first load on a
                    -- slower phone is not mistaken for a broken run.
                    local TravelStatus = ReadLeaf(Participant.travelStatus)

                    if Waited >= 10.0
                        and TravelStatus == "idle"
                        and Now - (Rescue.PreRunStuckLeaveAt or 0) >= 2.0
                    then
                        Rescue.PreRunStuckLeaveAt = Now

                        local CurrentMode =
                            tostring(workspace:GetAttribute("Mode") or "")

                        if type(GENV.__AZ_IS_RAID_MODE) == "function"
                            and GENV.__AZ_IS_RAID_MODE(CurrentMode)
                        then
                            Settings.AutoJoinRaid = true
                            Settings.AutoJoinMap = false
                            Settings.AutoJoinEndless = false

                            if type(Settings.SetLobbyUserPreference) == "function" then
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinRaid", true)
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinMap", false)
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinEndless", false)
                            end
                        else
                            Settings.AutoJoinMap = true
                            Settings.AutoJoinRaid = false
                            Settings.AutoJoinEndless = false

                            if type(Settings.SetLobbyUserPreference) == "function" then
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinMap", true)
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinRaid", false)
                                pcall(Settings.SetLobbyUserPreference, "AutoJoinEndless", false)
                            end
                        end

                        pcall(function()
                            if type(Settings.PersistLobbyPreferences) == "function" then
                                Settings.PersistLobbyPreferences()
                            end

                            if type(Settings.ArmRemoteAutoExecute) == "function" then
                                Settings.ArmRemoteAutoExecute()
                            end
                        end)

                        local Left = pcall(function()
                            Rescue.RunPackets.endAction:fire(3)
                        end)

                        Rescue.EndActionState =
                            Left
                            and "PreRunStuckLeavingLobby"
                            or "PreRunStuckLeaveRetry"

                        print(
                            "[Anime Zero] Get Ready watchdog | stuck | leaving to lobby for clean requeue | sent:",
                            tostring(Left)
                        )
                    end
                else
                    Rescue.PreRunWaitingSince = 0
                    Rescue.PreRunReadyNudged = false
                    Rescue.PreRunStuckLeaveAt = 0
                    Rescue.EndActionState = "WaitingResult"
                end

                return
            end

            Rescue.PreRunWaitingSince = 0
            Rescue.PreRunReadyNudged = false

            local TravelStatus =
                ReadLeaf(Participant.travelStatus)

            if TravelStatus ~= "idle" then
                Rescue.EndActionState =
                    "Travel "
                    .. tostring(TravelStatus)
                return
            end

            local ResultKey =
                tostring(ParticipantFinishedAt or "-")
                .. "|"
                .. tostring(RunFinishedAt or "-")
                .. "|"
                .. tostring(ResultEndsAt or "-")

            -- Result timestamps are unique per completed run. Once this exact
            -- result has been handled, never act on it again even if resultVotes
            -- gets cleared while the server is resetting the run.
            if Rescue.RetryHandledKey == ResultKey then
                Rescue.EndActionState = "RetryAlreadyHandled"
                return
            end

            -- Give the result state a short settling window. This avoids firing
            -- Retry on the same replication beat that the match is finalised.
            if Rescue.RetryResultSeenKey ~= ResultKey then
                Rescue.RetryResultSeenKey = ResultKey
                Rescue.RetryResultSeenAt = Now
                Rescue.EndActionState = "ResultSettling"
                return
            end

            if Now - (Rescue.RetryResultSeenAt or Now) < 1.00 then
                Rescue.EndActionState = "ResultSettling"
                return
            end

            if Now < Rescue.NextEndAction then
                return
            end

            local OwnVote = nil

            pcall(function()
                local VoteLeaf =
                    State.resultVotes:get(UserId)

                OwnVote = ReadLeaf(VoteLeaf)
            end)

            -- If another part of the client already registered Retry for this
            -- result, adopt it and enter the same startup lock instead of firing
            -- a duplicate request.
            if tonumber(OwnVote) == 1 then
                Rescue.RetryHandledKey = ResultKey
                Rescue.RetryAwaitingStart = true
                Rescue.RetryAwaitingSince = Now
                Rescue.RetryReadyNudged = false
                Rescue.RetryStuckLeaveAt = 0
                Rescue.EndActionState = "RetryAccepted"
                return
            end

            if type(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION) == "function" then
                local GuardOK, Ready =
                    pcall(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION)

                if GuardOK and Ready == false then
                    Rescue.EndActionState = "WebhookPending"
                    Rescue.NextEndAction = Now + 0.30
                    return
                end
            end

            -- One result = one Retry request. Mark it handled immediately after
            -- the local network fire succeeds so a fast server reset cannot make
            -- us submit the same action a second time.
            local Fired, FireError =
                pcall(function()
                    Rescue.RunPackets.endAction:fire(1)
                end)

            if Fired then
                Rescue.RetryHandledKey = ResultKey
                Rescue.RetryAwaitingStart = true
                Rescue.RetryAwaitingSince = Now
                Rescue.RetryReadyNudged = false
                Rescue.RetryStuckLeaveAt = 0
                Rescue.NextEndAction = Now + 2.00
                Rescue.EndActionState = "RetrySentWaitingStart"

                print(
                    "[Anime Zero] Auto Retry | sent once | mode:",
                    tostring(workspace:GetAttribute("Mode")),
                    "| status:",
                    tostring(Status)
                )
            else
                Rescue.EndActionState = "RetryError"
                Rescue.NextEndAction = Now + 1.00
                warn(
                    "[Anime Zero][Auto Retry]",
                    tostring(FireError)
                )
            end
        end



