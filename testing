        Prompt
    )
        if not Prompt then
            return nil
        end

        local Current =
            Prompt.Parent

        while Current
            and Current ~= Workspace
        do
            if Current:IsA("Model")
                and Current.Name == "Pump"
            then
                return Current
            end

            Current = Current.Parent
        end

        return nil
    end

    local function PumpLooksAvailable(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
            or not Prompt.Enabled
        then
            return false
        end

        local Pump =
            GetPumpModel(
                Prompt
            )

        if not Pump then
            return true
        end

        local FoundStatus = false

        for _, Object in ipairs(
            Pump:GetDescendants()
        ) do
            if Object:IsA("TextLabel") then
                local Text =
                    string.upper(
                        tostring(
                            Object.Text
                            or ""
                        )
                    )

                if Text ~= "" then
                    FoundStatus = true

                    if string.find(
                        Text,
                        "AVAILABLE",
                        1,
                        true
                    )
                    then
                        return true
                    end
                end
            end
        end

        -- If the status label has not streamed yet, trust the prompt.
        return not FoundStatus
    end

