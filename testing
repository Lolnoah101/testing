--//============================================================
--// AREA HANDLER
--//============================================================

local function HandleAreaEntry(
    TargetArea
)

    ResetWaveRecovery()


    TargetAreaNumber =
        TargetArea


    CurrentTargetId =
        nil


    CurrentTargetState =
        nil


    local EntryCF =
        GetLockedAreaEntryCFrame(
            TargetArea
        )


    if HasCompletedAreaEntry(
        TargetArea
    )
    then

        GENV.__AZ_FARM_EXT.ResetAreaEntryRecovery()


        ConfirmedAreaEntry =
            true


        if TargetArea == 5 then

            DesiredFarmCFrame =
                EntryCF

        else

            DesiredFarmCFrame =
                nil
        end


        SetFarmMode(
            "Inside Area "
            .. tostring(
                TargetArea
            )
        )


        return
    end


    local PreviousArea =
        TargetArea - 1


    local PreviousRubble =
        GetRubbleForArea(
            PreviousArea
        )


    if PreviousRubble
        and PreviousRubble.Health
        and PreviousRubble.Health > 0
    then

        CurrentRubbleInfo =
            PreviousRubble


        RecordRubbleHeight(
            PreviousRubble
        )


        CurrentRubbleCFrame =
            GetRubbleFarmCFrame(
                PreviousRubble
            )


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Rubble"
        )


        return
    end


    if not RubbleBreakTime[
        PreviousArea
    ]
    then

        RubbleBreakTime[
            PreviousArea
        ] = os.clock()
    end


    if not IsRubblePhysicallyOpen(
        PreviousArea
    )
    then

        CurrentRubbleInfo =
            PreviousRubble


        CurrentRubbleCFrame =
            PreviousRubble
            and GetRubbleFarmCFrame(
                PreviousRubble
            )
            or nil


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Waiting For Rubble To Drop"
        )


        return
    end


    local RecoveryCF =
        GENV.__AZ_FARM_EXT.HandleAreaEntryRecovery(
            TargetArea
        )


    if RecoveryCF then

        EntryCF =
            RecoveryCF


        SetFarmMode(
            "Area Recovery "
            .. tostring(
                TargetArea
            )
        )

    else

        SetFarmMode(
            "Entering Area "
            .. tostring(
                TargetArea
            )
        )
    end


    DesiredFarmCFrame =
        EntryCF
end


--//============================================================
--// NORMAL FARM
--//============================================================

local function HandleNormalFarm()

    TargetAreaNumber =
        nil


    ResetAreaEntryTarget()


    local EnemyId,
        EnemyState =
        GetFreshFarmTarget()


    if EnemyId
        and EnemyState
    then

        ResetWaveRecovery()


        CurrentRubbleInfo =
            nil


        CurrentRubbleCFrame =
            nil


        DesiredFarmCFrame =
            GetEnemyFarmCFrame(
                EnemyId,
                EnemyState
            )


        SetFarmMode(
            "Enemy"
        )


        return
    end


    local Area =
        GetRunValue(
            "area"
        )


    if not Area then

        DesiredFarmCFrame =
            nil


        return
    end


    local Info =
        GetRubbleForArea(
            Area
        )


    CurrentRubbleInfo =
        Info


    if Info
        and Info.Health
        and Info.Health > 0
    then

        ResetWaveRecovery()


        RecordRubbleHeight(
            Info
        )


        CurrentRubbleCFrame =
            GetRubbleFarmCFrame(
                Info
            )


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Rubble"
        )


        return
    end


    if HandleWaveRecovery(
        Area
    )
    then

        return
    end


    if Info
        and Info.Health ~= nil
        and Info.Health <= 0
    then

        DesiredFarmCFrame =
            nil


        SetFarmMode(
            "Waiting For Next Area"
        )


        return
    end


    DesiredFarmCFrame =
        nil


    SetFarmMode(
        "Waiting"
    )
end


--//============================================================
--// AUTO FARM
--//============================================================

local function UpdateAutoFarm()

    if not IsAlive() then

        DesiredFarmCFrame =
            nil


        return
    end


    if Settings.AutoFarm then

        local ServerArea =
            GetRunValue(
                "area"
            )


        local ServerWave =
            GetRunValue(
                "wave"
            )


        if ServerArea ~= LastServerArea then

            LastServerArea =
                ServerArea


            CurrentTargetId =
                nil


            CurrentTargetState =
                nil


            ResetAreaEntryTarget()

            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        if ServerWave ~= LastObservedWave then

            LastObservedWave =
                ServerWave


            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        local RequestedArea =
            GetRequestedEntryArea()


        -- Never let a coin/drop pull us away while the server is asking
        -- us to enter the next area. Area transitions remain top priority.
        if RequestedArea then

            HandleAreaEntry(
                RequestedArea
            )


            return
        end
    end


    if Settings.AutoPickupLoot
        and type(
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame
        ) == "function"
    then

        local LootCF =
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame()


        if LootCF then

            CurrentTargetId =
                nil

            CurrentTargetState =
                nil

            CurrentRubbleInfo =
                nil

            CurrentRubbleCFrame =
                nil

            TargetAreaNumber =
                nil

            DesiredFarmCFrame =
                LootCF


            SetFarmMode(
                "Loot"
            )


            return
        end
    end


    if not Settings.AutoFarm then

        DesiredFarmCFrame =
            nil


        SetFarmMode(
            "Idle"
        )


        return
    end


    HandleNormalFarm()
end


--//============================================================
--// COMBAT LOOP
--//============================================================

local function RunCombatHeartbeat()

    if not IsAlive() then
        return
    end


    if Settings.AutoM1 then

        if Settings.AutoFarm then

            if CurrentFarmMode == "Rubble"
                and IsCurrentRubbleAlive()
                and IsNearRubble()
            then

                TryM1()


            elseif CurrentFarmMode == "Enemy"
                and GetNearbyEnemy()
            then

                TryM1()
            end


        elseif GetNearbyEnemy() then

            TryM1()
        end
    end


    if Settings.AutoSkills
        or Settings.AutoUltimate
    then

        if (
            not Settings.AutoFarm
            or CurrentFarmMode == "Enemy"
        )
            and GetNearbyEnemy()
        then

            RunAutoSkills()
        end
    end


    if Settings.AutoBlock then

        if Settings.BlockMode
            == "Hold Block"
        then

            RequestBlock(
                ShouldHoldBlock()
            )

        else

            RunPerfectParry()
        end


    else

        RequestBlock(
            false
        )
    end
end


--//============================================================
--// HEARTBEAT
--//============================================================

local HeartbeatConnection


HeartbeatConnection =
    RunService.Heartbeat
        :Connect(
            function(
                DeltaTime
            )

                if not SessionAlive() then

                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(
                        false
                    )


                    HeartbeatConnection
                        :Disconnect()


                    return
                end


                UpdateAutoFarm()


