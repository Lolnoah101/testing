local function stepOP()
    if State.OPShutdownBusy then
        return
    end

    local now = os.clock()

    if State.Phase == "Idle" then
        if now >= State.NextCastAt then
            sendOPCast()
        end
        return
    end

    if State.Phase == "Casting"
        and State.CastAckDeadline > 0
        and now >= State.CastAckDeadline then
        warnf("OP cast acknowledgement timed out; retrying")
        resetOPSession(Config.RecastDelay)
        return
    end

    if State.Phase ~= "Idle"
        and now - State.LastPacketAt >= Config.StallTimeout then
        warnf("OP session stalled; cancelling and retrying")
        safeFire(FishingPackets.FishCancel)
        resetOPSession(Config.RecastDelay)
        return
    end

    if State.Phase ~= "Reeling" then
        return
    end

    local qteActive = now < State.QTEActiveUntil
    local suppressed = now < State.SkillSuppressedUntil or now < State.BossStunnedUntil

    local holdForQuestFinisher = questFinisherHoldActive()

    if not qteActive
        and not suppressed
        and not holdForQuestFinisher
        and now >= State.NextReelAt then

        sendOPReelPull()
    end

    if Config.AutoSkills
        and not qteActive
        and not suppressed
        and now >= State.NextSkillAt then

        trySendOPSkill()
        State.NextSkillAt = now + math.max(0.35, Config.SkillInterval)
    end
end

