            or not LobbyPackets.equipCharacterSlot
        then
            return false
        end

        local Equipped = Data
            and Data.EquippedCharacterSlots
            and tonumber(Data.EquippedCharacterSlots.Slot1)
            or 0

        if Equipped == SlotNumber then
            return true
        end

        local Now = os.clock()

        if Now - Runtime.LastEquipAt >= 1.5 then
            Runtime.LastEquipAt = Now

            pcall(function()
                LobbyPackets.equipCharacterSlot:fire({
                    slot = SlotNumber,
                    gameSlot = 1,
                    requestId = NextRequestId(),
