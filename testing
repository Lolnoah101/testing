            local function NumberText(Value)

                local Number =
                    tonumber(Value) or 0

                local Negative =
                    Number < 0

                Number =
                    math.floor(math.abs(Number) + 0.5)

                local Text =
                    tostring(Number)

                Text =
                    Text:reverse()
                        :gsub(
                            "(%d%d%d)",
                            "%1,"
                        )
                        :reverse()
                        :gsub(
                            "^,",
                            ""
                        )


                return (Negative and "-" or "")
                    .. Text
            end


            local function TimeText(Value)

                local Seconds =
                    math.max(
                        0,
                        math.floor(
                            tonumber(Value) or 0
                        )
                    )

                local Hours =
                    math.floor(Seconds / 3600)

                local Minutes =
                    math.floor(
                        (Seconds % 3600) / 60
                    )

                local Remaining =
                    Seconds % 60


                if Hours > 0 then
                    return string.format(
                        "%d:%02d:%02d",
                        Hours,
                        Minutes,
                        Remaining
                    )
                end


                return string.format(
                    "%d:%02d",
                    Minutes,
                    Remaining
                )
            end


