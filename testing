                AutoExecuteOnTeleport = true,
                AntiAFK = true,

                AdvancedEvolutionTargets = true,
                AdvancedEvolutionAcquire = true,
                AdvancedEvolutionRollSlot = true,
                AutoFullEvolve = true,

                MultiTitleTargets = true,
                AutoMultiTitle = true,

                AchievementTargets = true,
                AutoClaimGrinderRewards = true,
                AutoAchievementGrinder = true,

                AccessoryLoadoutMode = true,
                AutoAccessoryLoadout = true,

                AutomationQueueStep1 = true,
                AutomationQueueStep2 = true,
                AutomationQueueStep3 = true,
                AutomationQueueStep4 = true,
                AutomationQueueStep5 = true,
                AutomationQueueLoop = true,
                RunAutomationQueue = true,

                MainAutomationMode = true,
                MainRunAutomation = true,
                AutomationMaterialStrategy = true,
                TitleEquipMode = true,
                AccessoryCraftMode = true,
                AdvancedEvolutionAcquireMode = true,
                AchievementRewardMode = true,
                AutomationQueueLoopMode = true,
            }


            for Flag, Value in pairs(
                Snapshot
            ) do

                if not DedicatedFlags[
                    tostring(Flag)
                ]
                then

                    local Success,
                        Changed =
                        pcall(function()

                            return Window:Set(
