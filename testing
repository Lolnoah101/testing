    local function NextRequestId(State, Key)
        State[Key] = ((State[Key] or 0) % 65535) + 1
        return State[Key]
    end

    local RequestIds = {
        Skill = 1000,
        Milestone = 20000,
        Quest = 30000,
        Achievement = 40000,
