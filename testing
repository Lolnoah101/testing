-- v46: no distance-based target stealing. Even if knockback, orbiting,
-- a brief stun, or another mob makes the first target appear inconvenient,
-- ownership stays on that NPC until it dies, despawns, or selection changes.
function Hub:RecheckFarmLock(myRoot,now)
    if now<self.TargetRecheckAt then return end
    self.TargetRecheckAt=now+0.45
    local record=self.FarmTarget
    if record and self:FarmLockPersistent(record) then
        self.TargetState="Locked: "..tostring(record.NPCName or record.Model.Name)
            .." ("..math.floor((record.Root.Position-myRoot.Position).Magnitude).." studs)"
    end
end

-- Body movers are client-only pose stabilizers; Heartbeat remains the sole
-- position/target controller. Zero-velocity physics resists gravity BETWEEN
-- Heartbeats instead of letting a flying rig drop before every PivotTo.
function Hub:ReleaseFarmFlight()
    if self.FarmFlightVelocity then pcall(function() self.FarmFlightVelocity:Destroy() end) end
    if self.FarmFlightGyro then pcall(function() self.FarmFlightGyro:Destroy() end) end
    self.FarmFlightVelocity=nil
    self.FarmFlightGyro=nil
    self.FarmFlightRoot=nil
    self.FarmFlightPose=nil
end
function Hub:HoldFarmFlight(root,pose)
    if not root or not root.Parent then self:ReleaseFarmFlight(); return end
    if self.FarmFlightRoot~=root or not self.FarmFlightVelocity
        or not self.FarmFlightVelocity.Parent or not self.FarmFlightGyro
        or not self.FarmFlightGyro.Parent then
        self:ReleaseFarmFlight()
        local velocity=Instance.new("BodyVelocity")
        velocity.Name="HollowMoonHoverVelocity"
        velocity.Velocity=Vector3.zero
        velocity.P=18000
        velocity.MaxForce=Vector3.new(1e8,1e8,1e8)
        velocity.Parent=root
        local gyro=Instance.new("BodyGyro")
        gyro.Name="HollowMoonHoverOrientation"
        gyro.P=150000
        gyro.D=3200
        gyro.MaxTorque=Vector3.new(1e9,1e9,1e9)
        gyro.CFrame=pose.Rotation
        gyro.Parent=root
        self.FarmFlightRoot=root
        self.FarmFlightVelocity=velocity
        self.FarmFlightGyro=gyro
    end
    self.FarmFlightPose=pose
    self.FarmFlightGyro.CFrame=pose.Rotation
    self.FarmFlightVelocity.Velocity=Vector3.zero
end
function Hub:ApplyFarmPose(char,root,pose)
    -- Node Master travel owns the avatar until the recorded activity is restored.
    if self.V70NenPriority then return end
    -- Check UpVector too. Checking LookVector alone missed roll/pitch errors
    -- from combat poses that share the same forward direction.
    if (root.Position-pose.Position).Magnitude>.012
        or (root.CFrame.LookVector-pose.LookVector).Magnitude>.0015
        or (root.CFrame.UpVector-pose.UpVector).Magnitude>.0015 then
        char:PivotTo(pose)
    end
    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero
    self:HoldFarmFlight(root,pose)
end
-- The quest's claim/repeat request path should not drop a horizontally
-- hovering character while it is waiting for replicated quest state.
-- Keeps the current pose only when stationary; travel/combat/dodge takes priority.
function Hub:QuestHandoffHover(char,root,hum,now)
    if not self.AutoQuest or now>self.QuestHandoffUntil or self.QuestCombatActive
        or self.DodgeActive or now<self.DodgeHoldUntil or self.QuestFarmMethod=="Legit" then
        if not self.QuestCombatActive and now>self.QuestHandoffUntil then
            self.QuestHandoffStatus="Idle"
        end
        return
    end
    -- Any actual quest movement has priority over the claim hover, even
    -- when the new destination is only a few studs away.
    if self.QuestMoveTo then
        self.QuestHandoffPose=nil
        self.QuestHandoffStatus="Traveling to next quest step"
        return
    end
    if hum.MoveDirection.Magnitude>.08 then
        self.QuestHandoffPose=nil
        self.QuestHandoffStatus="Manual movement"
        return
    end
    if not self.QuestHandoffPose
        or (self.QuestHandoffPose.Position-root.Position).Magnitude>5 then
        self.QuestHandoffPose=root.CFrame
    end
    self:ApplyFarmPose(char,root,self.QuestHandoffPose)
    self.QuestHandoffStatus="Hover held during quest handoff"
end
