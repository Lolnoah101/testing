    local function StartRequiredWeaponSpin(Profile, SlotNumber)
        local Extra = GENV.__AZ_EXTRA_SETTINGS
        local Request = GENV.__AZ_EXTRA_REQUEST_TOGGLE

        if type(Extra) ~= "table" then
            return false
        end

        Extra.WeaponSlot = SlotNumber
        Extra.WeaponTargets = {
            [Profile.character] = true,
        }
        Extra.AutoSpinWeapon = true

        if type(Request) == "function" then
            Request("WeaponAuto", true)
        end

        return true
