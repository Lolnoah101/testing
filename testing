    local RedeemingCodes = false

    local function BuildRedeemedCodeSet(Data)
        local Set = {}

        if Data and type(Data.cdk) == "table" then
            for _, Code in pairs(Data.cdk) do
                if type(Code) == "string" then
                    Set[string.upper(Code)] = true
                end
            end
        end

        return Set
    end

    RedeemAllAvailableCodes = function()
        if RedeemingCodes then
            Notify(
                "Codes",
                "Code redemption is already running.",
                4
            )
            return
        end

        if not Packets.redeemCode
            or type(CodesConfig) ~= "table"
        then
            Notify(
                "Codes",
                "Code configuration is unavailable.",
                5
            )
            return
        end

        local Data = GetAccountData()
        local Level = GetPlayerLevel(Data)

        if not Data or Level == nil then
            Notify(
                "Codes",
                "Account level is not ready yet.",
                5
            )
            return
        end

        RedeemingCodes = true

        local Redeemed = BuildRedeemedCodeSet(Data)
        local Available = {}
        local Locked = 0
        local AlreadyRedeemed = 0

        for _, Definition in pairs(CodesConfig) do
            if type(Definition) == "table"
                and type(Definition.Code) == "string"
            then
                local Code = Definition.Code
                local MinimumLevel =
                    tonumber(Definition.MinimumLevel) or 0

                if Redeemed[string.upper(Code)] then
                    AlreadyRedeemed += 1
                elseif Level < MinimumLevel then
                    Locked += 1
                else
                    table.insert(
                        Available,
                        {
                            code = Code,
                            minimumLevel = MinimumLevel,
                        }
                    )
                end
            end
        end

        table.sort(
            Available,
            function(A, B)
                if A.minimumLevel == B.minimumLevel then
                    return string.lower(A.code)
                        < string.lower(B.code)
                end

                return A.minimumLevel < B.minimumLevel
            end
        )

        local Attempted = 0

        for _, Entry in ipairs(Available) do
            if not Alive() then
                break
            end

            local Current = GetAccountData()
            local CurrentRedeemed =
                BuildRedeemedCodeSet(Current)

            if not CurrentRedeemed[
                string.upper(Entry.code)
            ]
            then
                local Fired = pcall(function()
                    Packets.redeemCode:fire(
                        Entry.code
                    )
                end)

                if Fired then
                    Attempted += 1
                end

                task.wait(0.55)
            end
        end

        RedeemingCodes = false

        Notify(
            "Codes",
            "Attempted "
                .. tostring(Attempted)
                .. " usable code(s). "
                .. tostring(AlreadyRedeemed)
                .. " already redeemed; "
                .. tostring(Locked)
                .. " level-locked.",
            7
        )
    end

    GENV.__AZ_PLAYER_MISC_REDEEM_FUNCTION =
        RedeemAllAvailableCodes

