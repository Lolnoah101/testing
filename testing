local function selectDropdownValue(handle, option)
    if not handle then return end
    pcall(function() handle:Set(option) end)
end

local function refreshDropdown(handle, options, selected)
    if not handle then return end
    local ok = pcall(function() handle:Refresh(options) end)
    if not ok then
        pcall(function() handle:Update({ options = options, value = selected }) end)
    end
    selectDropdownValue(handle, selected)
end

