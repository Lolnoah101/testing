    local function ScoreAccessory(
        Definition,
        Mode
    )

        local Weights =
            LoadoutWeights[
                Mode
            ]
            or LoadoutWeights
                .Damage


        local Score = 0


        for _, Buff in ipairs(
            type(
                Definition.Buffs
            ) == "table"
                and Definition.Buffs
                or {}
        ) do

            local Weight =
                tonumber(
                    Weights[
                        tostring(
                            Buff.Type
                        )
                    ]
                ) or 0


            local Value =
                tonumber(
                    Buff.Percent
                    or Buff.Amount
                ) or 0


            Score +=
                Weight
                * Value
        end


        Score +=
            (
                tonumber(
                    Definition.Tier
                ) or 0
            )
            * 0.001


        return Score
    end


    local function BestOwnedAccessory(
        Data
    )

        if not AccessoryConfig
            or type(
                Data
                and Data.accessory
            ) ~= "table"
        then

            return nil
        end


        local BestId =
            nil

        local BestDefinition =
            nil

        local BestScore =
            -math.huge


        for Id, Definition in pairs(
            AccessoryConfig
        ) do

            local Owned =
                tonumber(
                    Data.accessory[
                        tostring(Id)
                    ]
                ) or 0


            if Owned > 0 then

                local Score =
                    ScoreAccessory(
                        Definition,
                        Advanced
                            .AccessoryLoadoutMode
                    )


                if Score > BestScore then

                    BestScore =
                        Score

                    BestId =
                        tostring(
                            Id
                        )

                    BestDefinition =
                        Definition
                end
            end
        end


        return BestId,
            BestDefinition,
            BestScore
    end


    local function ApplyBestAccessory()

        local Data =
            GetData()


        if not Data then
            return false
        end


        local Id,
            Definition,
            Score =
            BestOwnedAccessory(
                Data
            )


        if not Id then

            SetState(
                "Accessory Loadout: no owned accessories"
            )

            return false
        end


        local Equipped =
            tostring(
                Data.equippedAccessory
                or ""
            )


        if Equipped == Id then

            return true,
                Id,
                Definition,
                Score
        end


        if not IsLobby()
            or not LobbyPackets
            or not LobbyPackets
                .setEquippedAccessory
        then

            SetState(
                "Accessory Loadout: waiting for lobby to equip "
                .. tostring(
                    Definition.Name
                    or Id
                )
            )

            return false
        end


        if os.clock()
            - Runtime.LastAccessoryEquip
            < 1.25
        then

            return false
        end


        Runtime.LastAccessoryEquip =
            os.clock()


        pcall(function()

            LobbyPackets
                .setEquippedAccessory
                :fire(
                    Id
                )
        end)


        SetState(
            "Accessory Loadout: equipping "
            .. tostring(
                Definition.Name
                or Id
            )
        )


        return false,
            Id,
            Definition,
            Score
    end


