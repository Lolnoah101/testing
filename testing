                Vector3.new(
                    0,
                    -45,
                    0
                ),

                Params
            )

        if Result
            and Result.Instance
            and Result.Instance.CanCollide
        then
            return Result.Position
        end

        return nil
    end

    --========================================================
    -- OIL RIG ACCESS ROUTE
    --
    -- Streaming revealed that the Oil Rig is not on the same
    -- navmesh island as the mainland.  The real map has a pier,
    -- a short gap to the lower rig deck, and multiple stair sets.
    -- Keep normal SmartTween everywhere else and only bridge the
    -- short disconnected pieces using the existing smooth follower.
    --========================================================

    local function IsInsideOilRigBounds()
        local Position =
            GetRootPart().Position

        return Position.X <= -258
            and Position.X >= -355
            and Position.Z <= -1635
            and Position.Z >= -1745
            and Position.Y >= 37
    end

    local function IsOnOilMainDeck()
        local Y =
            GetRootPart().Position.Y

        return IsInsideOilRigBounds()
            and Y >= 66
            and Y < 77
    end

    local function IsOnOilUpperDeck()
        return IsInsideOilRigBounds()
            and GetRootPart().Position.Y >= 78
    end

    local function MoveOilStage(
        Position,
        Label
    )
        if not Settings.AutoOil then
            return false
        end

        RequestOilStreaming(
            Position
        )

        local RootPart =
            GetRootPart()

        if (
            RootPart.Position
            - Position
        ).Magnitude <= 5
        then
            return true
        end

        if Label then
            OilStatus(
                Label,
                0.8
            )
        end

        return MoveToJobTarget(
            CFrame.new(Position),

            function()
                return Settings.AutoOil
            end
        )
    end

    local function FollowOilSegment(
        Points,
        Label
    )
        if not Settings.AutoOil then
            return false
        end

        if Label then
            OilStatus(
                Label,
                0.8
            )
        end

        local Route = {
            GetRootPart().Position,
        }

        for _, Point in ipairs(
            Points
        ) do
            table.insert(
                Route,
                Point
            )
        end

        local Generation =
            MovementGeneration

        return FollowSmoothPath(
            Route,

            function()
                return Settings.AutoOil
            end,

            function()
                return false
            end,

            Generation
        )
    end

    local function EnsureOilRigLowerDeck()
        if IsInsideOilRigBounds() then
            return true
        end

        RequestOilStreaming(
            Oil.RigAnchor
        )

        -- SecondPier is connected to the mainland.  Stop near the
        -- landward side first, then walk to its Oil-Rig-facing edge.
        if not MoveOilStage(
            Oil.PierApproach,
            "Going to Oil Rig pier"
        )
        then
            return false
        end

        if not MoveOilStage(
            Oil.PierEdge,
            "Going to end of Oil Rig pier"
        )
        then
            return false
        end

        -- The pier and rig are two separate navmesh islands with only
        -- a small physical gap between them.  Bridge that gap without
        -- changing collision state.
        if not FollowOilSegment(
            {
                Oil.RigLowerEntry,
            },
            "Crossing Oil Rig access gap"
        )
        then
            return false
        end

        RequestOilStreaming(
            Oil.RigAnchor
        )

        task.wait(0.25)

        return IsInsideOilRigBounds()
            or (
                GetRootPart().Position
                - Oil.RigLowerEntry
            ).Magnitude <= 8
    end

    local function EnsureOilRigMidDeck()
        if GetRootPart().Position.Y >= 57
            and IsInsideOilRigBounds()
        then
            return true
        end

        if not EnsureOilRigLowerDeck() then
            return false
        end

        -- First two stair runs raise the character from the lower
        -- Oil-Rig deck to the intermediate deck.
        if not MoveOilStage(
            Oil.Stair1Low,
            "Going to Oil Rig lower stairs"
        )
        then
            return false
        end

        if not FollowOilSegment(
            {
                Oil.Stair1High,
                Oil.Stair2Low,
                Oil.Stair2High,
            },
            "Climbing Oil Rig lower stairs"
        )
        then
            return false
        end

        return true
    end

    local function EnsureOilRigMainDeck()
        if IsOnOilMainDeck() then
            return true
        end

        -- If pumping left us on the upper pump deck, descend the
        -- last stair run before trying to reach a Fill Oil table.
        if IsOnOilUpperDeck() then
            if not MoveOilStage(
                Oil.Stair5High,
                "Going down to Oil Filling Tables"
            )
            then
                return false
            end

            return FollowOilSegment(
                {
                    Oil.Stair5Low,
                },
                "Descending to Oil Rig main deck"
            )
        end

        if not EnsureOilRigMidDeck() then
            return false
        end

        -- Traverse the intermediate deck to the next real stair set.
        if not MoveOilStage(
            Oil.Stair4Low,
            "Going to Oil Rig main stairs"
        )
        then
            return false
        end

        if not FollowOilSegment(
            {
                Oil.Stair4High,
            },
            "Climbing to Oil Rig main deck"
        )
        then
            return false
        end

        return true
    end

    local function EnsureOilRigUpperDeck()
        if IsOnOilUpperDeck() then
            return true
        end

        if not EnsureOilRigMainDeck() then
            return false
        end

        if not MoveOilStage(
            Oil.Stair5Low,
            "Going to Oil Rig pump stairs"
        )
        then
            return false
        end

        if not FollowOilSegment(
            {
                Oil.Stair5High,
            },
            "Climbing to Oil Rig pumps"
        )
        then
            return false
        end

        return true
    end

    local function ExitOilRigToPier()
        if not IsInsideOilRigBounds() then
            return true
        end

        OilStatus(
            "Leaving Oil Rig",
            0.8
        )

        -- Upper deck -> main deck.
        if GetRootPart().Position.Y >= 76 then
            if not MoveOilStage(
                Oil.Stair5High,
                "Going to Oil Rig exit stairs"
            )
            then
                return false
            end

            if not FollowOilSegment(
                {
                    Oil.Stair5Low,
                },
                "Descending from Oil Rig pumps"
            )
            then
                return false
            end
        end

        -- Main deck -> intermediate deck.
        if GetRootPart().Position.Y >= 64 then
            if not MoveOilStage(
                Oil.Stair4High,
                "Going to Oil Rig lower exit"
            )
            then
                return false
            end

            if not FollowOilSegment(
                {
                    Oil.Stair4Low,
                },
                "Descending Oil Rig main stairs"
            )
            then
                return false
            end
        end

        -- Intermediate deck -> lower deck.
        if not MoveOilStage(
            Oil.Stair2High,
            "Going to Oil Rig lower deck"
        )
        then
            return false
        end

        if not FollowOilSegment(
            {
                Oil.Stair2Low,
                Oil.Stair1High,
                Oil.Stair1Low,
            },
            "Descending Oil Rig lower stairs"
        )
        then
            return false
        end

        if not MoveOilStage(
            Oil.RigLowerEntry,
            "Going to Oil Rig pier exit"
        )
        then
            return false
        end

        -- Reverse the same short disconnected gap.
        if not FollowOilSegment(
            {
                Oil.PierEdge,
            },
            "Crossing back to Oil Rig pier"
        )
        then
            return false
        end

        return MoveOilStage(
            Oil.PierApproach,
            "Leaving Oil Rig pier"
        )
    end

    local function GetOilApproachCFrame(
        Prompt
    )
        local PromptPosition =
            GetOilPromptPosition(
                Prompt
            )

        if not PromptPosition then
            return nil
        end

        RequestOilStreaming(
            PromptPosition
        )

        local RootPart =
            GetRootPart()

        local RootHeight =
            GetRootHeight()

        local MaxDistance =
            tonumber(
                Prompt.MaxActivationDistance
            )
            or 5

        local Radius =
            math.clamp(
                MaxDistance - 1.15,
                2.4,
                4.2
            )

        local FlatDirection =
            Vector3.new(
                RootPart.Position.X
                    - PromptPosition.X,

                0,

                RootPart.Position.Z
                    - PromptPosition.Z
            )

        if FlatDirection.Magnitude
            < 0.1
        then
            FlatDirection =
                Vector3.new(
                    1,
                    0,
                    0
                )
        else
            FlatDirection =
                FlatDirection.Unit
        end

        local Directions = {
            FlatDirection,

            Vector3.new(
                -FlatDirection.Z,
                0,
                FlatDirection.X
            ),

            Vector3.new(
                FlatDirection.Z,
                0,
                -FlatDirection.X
            ),

            -FlatDirection,
        }

        local Best
        local BestDistance =
            math.huge

        for _, Direction in ipairs(
            Directions
        ) do
            local Wanted =
                PromptPosition
                + Direction
                    * Radius

            local Ground =
                GetOilGroundPoint(
                    Wanted
                )

            if Ground then
                local TargetPosition =
                    Ground
                    + Vector3.new(
                        0,
                        RootHeight,
                        0
                    )

                local Distance =
                    (
                        RootPart.Position
                        - TargetPosition
                    ).Magnitude

                if Distance
                    < BestDistance
                then
                    BestDistance =
                        Distance

                    Best =
                        CFrame.lookAt(
                            TargetPosition,

                            Vector3.new(
                                PromptPosition.X,
                                TargetPosition.Y,
                                PromptPosition.Z
                            )
                        )
                end
            end
        end

        if Best then
            return Best
        end

        local Part =
            GetPromptPart(
                Prompt
            )

        return Part
            and GetTargetCFrame(
                Part
            )
            or nil
    end

    local function MoveToOilPrompt(
        Prompt,
        Label
    )
        if not Prompt
            or not Prompt.Parent
        then
            return false
        end

        if IsOilPromptInRange(
            Prompt,
            true
        )
        then
            return true
        end

        local Target =
            GetOilApproachCFrame(
                Prompt
            )

        if not Target then
            warn(
                "[Oil] Missing approach target for: "
                .. tostring(Label)
            )

            return false
        end

        OilStatus(
            "Going to: "
            .. tostring(Label)
        )

        local Reached =
            MoveToJobTarget(
                Target,

                function()
                    return Settings.AutoOil
                end
            )

        -- Machinery can create tiny local navmesh islands even after
        -- we are already on the correct rig deck.  For only this short
        -- final approach, use the same collision-preserving smooth
        -- follower when the straight segment is physically clear.
        if not Reached
            and Settings.AutoOil
            and Settings.JobFarmingMethod == "Tween"
        then
            local RootPart =
                GetRootPart()

            local Distance =
                (
                    RootPart.Position
                    - Target.Position
                ).Magnitude

            if Distance <= 32
                and IsRouteClear(
                    RootPart.Position,
                    Target.Position
                )
            then
                OilStatus(
                    "Using local Oil Rig approach"
                )

                local Generation =
                    MovementGeneration

                Reached =
                    FollowSmoothPath(
                        {
                            RootPart.Position,
                            Target.Position,
                        },

                        function()
                            return Settings.AutoOil
                        end,

                        function()
                            return false
                        end,

                        Generation
                    )
            end
        end

        return Reached
            and Settings.AutoOil
            and Prompt.Parent ~= nil
            and IsOilPromptInRange(
                Prompt,
                true
            )
    end

    local function MoveToOilArea(
        Position,
        Label
    )
        if not Settings.AutoOil then
            return false
        end

        RequestOilStreaming(
            Position
        )

        OilStatus(
            "Going to "
            .. tostring(Label),
            1.5
        )

        local Reached =
            MoveToJobTarget(
                CFrame.new(
                    Position
                ),

                function()
                    return Settings.AutoOil
                end
            )

        if not Reached
            or not Settings.AutoOil
        then
            return false
        end

        RequestOilStreaming(
            Position
        )

        task.wait(0.8)

        return true
    end

    local function WaitForOilInventoryChange(
        CrudeBefore,
        RefinedBefore,
        Timeout
    )
        local Started =
            os.clock()

        while Settings.AutoOil
            and os.clock() - Started
                < Timeout
        do
            local CrudeNow =
                CountOilItems(
                    "Crude Oil"
                )

            local RefinedNow =
                CountOilItems(
                    "Refined Oil"
                )

            if CrudeNow
                    ~= CrudeBefore
                or RefinedNow
                    ~= RefinedBefore
            then
                return true,
                    CrudeNow,
                    RefinedNow
            end

            task.wait(
                Settings.OilStateDelay
            )
        end

        return false,
            CountOilItems(
                "Crude Oil"
            ),
            CountOilItems(
                "Refined Oil"
            )
    end

    local function EnsureRigLoaded()
        local Pumps =
            GetOilPrompts(
                "Pump Oil"
            )

        local Fills =
            GetOilPrompts(
                "Fill Oil"
            )

        if #Pumps > 0
            and #Fills > 0
        then
            return true
        end

        RequestOilStreaming(
            Oil.RigAnchor
        )

        -- Move only to the connected pier.  Do not ask normal
        -- PathfindingService to walk directly onto the offshore rig.
        if not IsInsideOilRigBounds()
            and not MoveOilStage(
                Oil.PierApproach,
                "Going to Oil Rig"
            )
        then
            return false
        end

        local Started =
            os.clock()

        while Settings.AutoOil
            and os.clock() - Started
                < 6
        do
            Pumps =
                GetOilPrompts(
                    "Pump Oil"
                )

            Fills =
                GetOilPrompts(
                    "Fill Oil"
                )

            if #Pumps > 0
                and #Fills > 0
            then
                OilStatus(
                    "Oil Rig loaded"
                )

                return true
            end

            RequestOilStreaming(
                Oil.RigAnchor
            )

            task.wait(0.25)
        end

        warn(
            "[Oil] Oil Rig prompts did not stream in"
        )

        return false
    end

    local function EnsureRefineryLoaded()
        local Prompts =
            GetOilPrompts(
                "Refine Oil"
            )

        if #Prompts > 0 then
            return true
        end

        if not MoveToOilArea(
            Oil.RefineryAnchor,
            "refinery"
        )
        then
            return false
        end

        local Started =
            os.clock()

        while Settings.AutoOil
            and os.clock() - Started
                < 5
        do
            Prompts =
                GetOilPrompts(
                    "Refine Oil"
                )

            if #Prompts > 0 then
                OilStatus(
                    "Refinery loaded"
                )

                return true
            end

            RequestOilStreaming(
                Oil.RefineryAnchor
            )

            task.wait(0.25)
        end

        warn(
            "[Oil] Refinery prompts did not stream in"
        )

        return false
    end

    local function GetOilBuyerPrompt()
        for _, Object in ipairs(
            Workspace:GetDescendants()
        ) do
            if Object:IsA(
                "ProximityPrompt"
            )
                and Object.ObjectText
                    == "Object Buyer"
                and (
                    Object.ActionText
                        == "Sell Loot"
                    or Object.ActionText
                        == ""
                )
            then
                return Object
            end
        end

        return nil
    end

    local function EnsureBuyerLoaded()
        local Prompt =
            GetOilBuyerPrompt()

        if Prompt then
            return Prompt
        end

        if not MoveToOilArea(
            Oil.BuyerAnchor,
            "Object Buyer"
        )
        then
            return nil
        end

        local Started =
            os.clock()

        while Settings.AutoOil
            and os.clock() - Started
                < 5
        do
            Prompt =
                GetOilBuyerPrompt()

            if Prompt then
                return Prompt
            end

            RequestOilStreaming(
                Oil.BuyerAnchor
            )

            task.wait(0.25)
        end

        return nil
    end

    --========================================================
    -- OIL PUMP FUNDING
    --
    -- The Oil Rig exposes the pump price through Prompt.ActionText
    -- (for example "$5000").  Read that live instead of hardcoding
    -- the cost.  If the wallet is short, withdraw only the missing
    -- amount from the bank before using the pump.
    --========================================================

    local function GetOilPumpPrice(
        Prompt
    )
        if not Prompt
            or not Prompt.Parent
        then
            return 0
        end

        local Text =
            tostring(
                Prompt.ActionText
                or ""
            )

        -- Support "$5000", "$5,000", "5000 Cash", etc.
        Text =
            string.gsub(
                Text,
                ",",
                ""
            )

        local Digits =
            string.match(
                Text,
                "%d+"
            )

        return math.max(
            0,
            math.floor(
                tonumber(Digits)
                or 0
            )
        )
    end

    local function ReleaseOilPumpFunds()
        if not Oil.HoldingPumpFunds then
            return
        end

        Oil.HoldingPumpFunds = false
        SuppressAutoDeposit = false

        if Settings.AutoDeposit
            and not BankingBusy
        then
            StartDepositSweep()
        end
    end

    local function EnsureOilPumpFunds(
        Prompt
    )
        local Required =
            GetOilPumpPrice(
                Prompt
            )

        -- If this pump does not advertise a price, do not invent one.
        if Required <= 0 then
            return true
        end

        -- Reserve wallet cash for the pump.  This also stops an
        -- in-progress auto-deposit sweep from taking the money back.
        Oil.HoldingPumpFunds = true
        SuppressAutoDeposit = true

        local BusyStarted =
            os.clock()

        while BankingBusy
            and Settings.AutoOil
            and os.clock() - BusyStarted < 4
        do
            task.wait(0.05)
        end

        if not Settings.AutoOil then
            ReleaseOilPumpFunds()
            return false
        end

        if BankingBusy then
            OilStatus(
                "Bank is busy - retrying pump funding",
                2
            )

            ReleaseOilPumpFunds()
            return false
        end

        local Wallet =
            math.floor(
                tonumber(
                    Money.Value
                ) or 0
            )

        if Wallet >= Required then
            OilStatus(
                "Pump cost $"
                .. tostring(Required)
                .. " | wallet ready: $"
                .. tostring(Wallet)
            )

            return true
        end

        local BankAmount =
            math.floor(
                tonumber(
                    Bank.Value
                ) or 0
            )

        if Wallet + BankAmount
            < Required
        then
            OilStatus(
                "Need $"
                .. tostring(Required)
                .. " to pump | wallet: $"
                .. tostring(Wallet)
                .. " | bank: $"
                .. tostring(BankAmount),
                2
            )

            ReleaseOilPumpFunds()
            return false
        end

        local Missing =
            Required - Wallet

        OilStatus(
            "Pump requires $"
            .. tostring(Required)
            .. " | withdrawing $"
            .. tostring(Missing)
        )

        -- The game caps a single ATM withdrawal. Loop so this remains
        -- correct even if a future pump price exceeds that cap.
        while Settings.AutoOil do
            Wallet =
                math.floor(
                    tonumber(
                        Money.Value
                    ) or 0
                )

            if Wallet >= Required then
                break
            end

            Missing =
                Required - Wallet

            local MaxWithdraw =
                GetMaxWithdraw()

            if MaxWithdraw <= 0 then
                break
            end

            local Amount =
                math.min(
                    Missing,
                    MaxWithdraw
                )

            if Amount <= 0 then
                break
            end

            BankingBusy = true

            local BeforeMoney =
                Money.Value

            local BeforeBank =
                Bank.Value

            ATM:FireServer(
                "Withdraw",
                Amount
            )

            local Changed =
                WaitForBankChange(
                    BeforeMoney,
                    BeforeBank,
                    2.5
                )

            BankingBusy = false

            if not Changed then
                break
            end

            task.wait(0.12)
        end

        Wallet =
            math.floor(
                tonumber(
                    Money.Value
                ) or 0
            )

        if Wallet >= Required then
            OilStatus(
                "Pump funds ready | wallet: $"
                .. tostring(Wallet)
            )

            -- Keep Auto Deposit suppressed until after the pump has
            -- actually processed this attempt.
            return true
        end

        OilStatus(
            "Could not withdraw enough for pump",
            2
        )

        ReleaseOilPumpFunds()
        return false
    end

    local function PumpOil()
        if not EnsureRigLoaded() then
            return false
        end

        if not EnsureOilRigUpperDeck() then
            return false
        end

        if CountOilItems(
            "Crude Oil"
        ) > 0
            or CountOilItems(
                "Refined Oil"
            ) > 0
        then
            return true
        end

        local Pumps =
            GetAvailablePumpPrompts()

        if #Pumps == 0 then
            OilStatus(
                "No pump is available yet",
                3
            )

            task.wait(1)

            return false
        end

        for _, Prompt in ipairs(
            Pumps
        ) do
            if not Settings.AutoOil then
                return false
            end

            if Prompt.Parent
                and Prompt.Enabled
                and PumpLooksAvailable(
                    Prompt
                )
                and MoveToOilPrompt(
                    Prompt,
                    "oil pump"
                )
            then
                if not EnsureOilPumpFunds(
                    Prompt
                )
                then
                    return false
                end

                local CrudeBefore =
                    CountOilItems(
                        "Crude Oil"
                    )

                local RefinedBefore =
                    CountOilItems(
                        "Refined Oil"
                    )

                OilStatus(
                    "Pumping oil"
                )

                if TriggerPrompt(
                    Prompt
                )
                then
                    local HoldTime =
                        tonumber(
                            Prompt.HoldDuration
                        )
                        or 5

                    local Changed =
                        WaitForOilInventoryChange(
                            CrudeBefore,
                            RefinedBefore,
                            math.max(
                                1.25,
                                HoldTime + 0.75
                            )
                        )

                    -- The pump has now had time to charge/process the
                    -- interaction, so normal Auto Deposit can resume.
                    ReleaseOilPumpFunds()

                    if Changed then
                        OilStatus(
                            "Oil item received from pump"
                        )

                        return true
                    end

                    -- Pumping and filling are separate interactions in
                    -- the streamed Oil Rig. A successful pump does not
                    -- have to immediately create a carried item.
                    OilStatus(
                        "Pump complete - going to filling table"
                    )

                    return true
                end

                ReleaseOilPumpFunds()
            end
        end

        return false
    end

    local function FillOil()
        if CountOilItems(
            "Crude Oil"
        ) > 0
            or CountOilItems(
                "Refined Oil"
            ) > 0
        then
            return true
        end

        if not EnsureRigLoaded() then
            return false
        end

        if not EnsureOilRigMainDeck() then
            return false
        end

        local Fills =
            GetOilPrompts(
                "Fill Oil"
            )

        if #Fills == 0 then
            warn(
                "[Oil] No Fill Oil prompts found"
            )

            return false
        end

        for _, Prompt in ipairs(
            Fills
        ) do
            if not Settings.AutoOil then
                return false
            end

            if Prompt.Parent
                and Prompt.Enabled
                and MoveToOilPrompt(
                    Prompt,
                    "Oil Filling Table"
                )
            then
                local CrudeBefore =
                    CountOilItems(
                        "Crude Oil"
                    )

                local RefinedBefore =
                    CountOilItems(
                        "Refined Oil"
                    )

                OilStatus(
                    "Filling crude oil"
                )

                TriggerPrompt(
                    Prompt
                )

                local Changed,
                    CrudeNow,
                    RefinedNow =
                    WaitForOilInventoryChange(
                        CrudeBefore,
                        RefinedBefore,
                        4
                    )

                if Changed
                    or CrudeNow > CrudeBefore
                    or RefinedNow > RefinedBefore
                then
                    OilStatus(
                        "Crude oil collected"
                    )

                    return true
                end
            end
        end

        OilStatus(
            "Fill did not produce crude oil - repumping",
            2
        )

        return false
    end

    local function RefineOil()
        local CrudeBefore =
            CountOilItems(
                "Crude Oil"
            )

        if CrudeBefore <= 0 then
            return true
        end

        if IsInsideOilRigBounds()
            and not ExitOilRigToPier()
        then
            return false
        end

        if not EnsureRefineryLoaded() then
            return false
        end

        local Prompts =
            GetOilPrompts(
                "Refine Oil"
            )

        EquipOilItem(
            "Crude Oil"
        )

        for _, Prompt in ipairs(
            Prompts
        ) do
            if not Settings.AutoOil then
                return false
            end

            if Prompt.Parent
                and Prompt.Enabled
                and MoveToOilPrompt(
                    Prompt,
                    "refinery"
                )
            then
                local RefinedBefore =
                    CountOilItems(
                        "Refined Oil"
                    )

                OilStatus(
                    "Refining crude oil"
                )

                TriggerPrompt(
                    Prompt
                )

                local Changed,
                    CrudeNow,
                    RefinedNow =
                    WaitForOilInventoryChange(
                        CrudeBefore,
                        RefinedBefore,
                        Settings.OilPromptWaitTimeout
                    )

                if Changed
                    and (
                        CrudeNow < CrudeBefore
                        or RefinedNow > RefinedBefore
                    )
                then
                    OilStatus(
                        "Oil refined"
                    )

                    return true
                end
            end
        end

        return false
    end

    local function SellOil()
        local RefinedBefore =
            CountOilItems(
                "Refined Oil"
            )

        if RefinedBefore <= 0 then
            return true
        end

        if IsInsideOilRigBounds()
            and not ExitOilRigToPier()
        then
            return false
        end

        local Prompt =
            EnsureBuyerLoaded()

        if not Prompt then
            warn(
                "[Oil] Object Buyer prompt not found"
            )

            return false
        end

        EquipOilItem(
            "Refined Oil"
        )

        if not MoveToOilPrompt(
            Prompt,
            "Object Buyer"
        )
        then
            return false
        end

        OilStatus(
            "Selling refined oil"
        )

        local Started =
            os.clock()

        local LastTrigger =
            0

        while Settings.AutoOil
            and Prompt.Parent
            and os.clock() - Started
                < math.max(
                    8,
                    Settings.OilPromptWaitTimeout
                )
        do
            local RefinedNow =
                CountOilItems(
                    "Refined Oil"
                )

            if RefinedNow
                < RefinedBefore
            then
                OilStatus(
                    "Oil sold"
                )

                return true
            end

            if os.clock()
                    - LastTrigger
                    >= 0.9
                and IsOilPromptInRange(
                    Prompt,
                    true
                )
            then
                TriggerPrompt(
                    Prompt
                )

                LastTrigger =
                    os.clock()
            end

            task.wait(
                Settings.OilStateDelay
            )
        end

        return CountOilItems(
            "Refined Oil"
        ) < RefinedBefore
    end

    local function RunOilCycle()
        local Refined =
            CountOilItems(
                "Refined Oil"
            )

        if Refined > 0 then
            return SellOil()
        end

        local Crude =
            CountOilItems(
                "Crude Oil"
            )

        if Crude > 0 then
            return RefineOil()
        end

        if not PumpOil() then
            return false
        end

        -- Some servers may award Crude Oil directly from the pump.
        if CountOilItems(
            "Crude Oil"
        ) > 0
            or CountOilItems(
                "Refined Oil"
            ) > 0
        then
            return true
        end

        return FillOil()
    end

    StartAutoOil =
        function()
            if Oil.Thread then
                return
            end

            Oil.Thread =
                task.spawn(function()
                    local Success,
                        Error =
                        xpcall(
                            function()
                                OilStatus(
                                    "Started"
                                )

                                while Settings.AutoOil do
                                    local Worked =
                                        RunOilCycle()

                                    if not Worked then
                                        task.wait(
                                            Settings.OilRetryDelay
                                        )
                                    end

                                    task.wait(
                                        Settings.OilStateDelay
                                    )
                                end
                            end,

                            debug.traceback
                        )

                    Oil.Thread = nil

                    ReleaseOilPumpFunds()

                    if not Success then
                        warn(
                            "[Oil] Worker error:\n"
                            .. tostring(
                                Error
                            )
                        )

                        if Settings.AutoOil then
                            task.wait(0.5)
                            StartAutoOil()
                            return
                        end
                    end

                    print(
                        "[Oil] Stopped"
                    )
                end)
        end

    StopAutoOil =
        function()
            Settings.AutoOil =
                false

            ReleaseOilPumpFunds()
            StopJobMovement()
        end
end

