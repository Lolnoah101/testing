local function setReconnectMarker(enabled)
    local writer = executorFileAPIs()
    if type(writer) ~= "function" then return false end
    return pcall(writer, RECONNECT_MARKER, enabled and "1" or "0")
end

local function queueReconnectScript()
    if idleRuntime.QueuePrepared then return true end
    local queue = executorQueueAPI()
    local writer, reader = executorFileAPIs()
    if type(queue) ~= "function" or type(writer) ~= "function"
        or type(reader) ~= "function" then
        return false, "Script restart unavailable (queue/file APIs missing)"
    end
    local src = AUTO_EXEC_BUNDLED_SOURCE
    if type(src) ~= "string" or #src < 50000 then
        local ok, cached = pcall(reader, AUTOEXEC_MAIN_FILE)
        if ok then src = cached end
    end
    if type(src) ~= "string" or #src < 50000 then
        return false, "V44 source cache unavailable"
    end
    local saved, saveErr = pcall(writer, AUTOEXEC_MAIN_FILE, src)
    if not saved then return false, tostring(saveErr) end
    local loaderSaved, loaderErr = pcall(writer, RECONNECT_LOADER_FILE, RECONNECT_TELEPORT_LOADER)
    if not loaderSaved then return false, tostring(loaderErr) end
    if not setReconnectMarker(true) then return false, "Reconnect marker save failed" end
    local queued, err = pcall(queue, RECONNECT_TELEPORT_LOADER)
    if not queued then
        setReconnectMarker(false)
        return false, tostring(err)
    end
    idleRuntime.QueuePrepared = true
    return true
end

local function permitted(manual)
    return running and idleRuntime.Active and (idleRuntime.AutoReconnect or manual)
        and (game.PlaceId == MAIN_PLACE_ID or game.PlaceId == DUNGEON_PLACE_ID)
end

local advanceReconnect, attemptSameServer, fallbackToLobby

fallbackToLobby = function(cycle, reason)
    if not permitted(idleRuntime.Manual) or cycle ~= idleRuntime.Cycle
        or idleRuntime.TeleportStarted then return end
    if idleRuntime.LobbyAttempts >= 2 then
        idleRuntime.Busy = false
        idleRuntime.State = "Recovery exhausted"
        setReconnectStatus("Recovery failed | Lobby retries exhausted | " .. tostring(reason))
        return
    end
    idleRuntime.LobbyAttempts += 1
    local attempt = idleRuntime.LobbyAttempts
    local step = idleRuntime.Step + 1
    idleRuntime.Step = step
    idleRuntime.State = "Lobby fallback"
    local delaySec = math.clamp(idleRuntime.ReconnectDelay + (attempt - 1) * 3, 2, 30)
    setReconnectStatus(string.format("Lobby fallback %d/2 in %ds | %s", attempt, delaySec, tostring(reason)))
    task.delay(delaySec, function()
        if not permitted(idleRuntime.Manual) or idleRuntime.Cycle ~= cycle
            or idleRuntime.Step ~= step or idleRuntime.TeleportStarted then return end
        persistBeforeReconnect()
        local queued, queueErr = queueReconnectScript()
        if not queued then warn("[Tame V44 Reconnect] " .. tostring(queueErr)) end
        local ok, err = pcall(function()
            TeleportService:Teleport(MAIN_PLACE_ID, Player)
        end)
        if not ok then
            setReconnectStatus("Lobby teleport request failed: " .. tostring(err))
            fallbackToLobby(cycle, "Lobby request rejected")
            return
        end
        setReconnectStatus("Lobby teleport requested | Waiting for transfer")
        task.delay(15, function()
            if idleRuntime.Cycle == cycle and idleRuntime.Step == step
                and idleRuntime.Busy and not idleRuntime.TeleportStarted then
                fallbackToLobby(cycle, "Lobby request timed out")
            end
        end)
    end)
end

advanceReconnect = function(cycle, reason)
    if idleRuntime.Cycle ~= cycle or not idleRuntime.Busy
        or idleRuntime.TeleportStarted then return end
    -- Invalidate the previous watchdog and failed-event callback.
    idleRuntime.Step += 1
    if idleRuntime.SameServerAttempts < idleRuntime.MaxSameServerAttempts
        and game.JobId and game.JobId ~= "" then
        attemptSameServer(cycle)
    else
        fallbackToLobby(cycle, reason)
    end
end

attemptSameServer = function(cycle)
    if not permitted(idleRuntime.Manual) or cycle ~= idleRuntime.Cycle
        or idleRuntime.TeleportStarted then return end
    if idleRuntime.SameServerAttempts >= idleRuntime.MaxSameServerAttempts
        or not game.JobId or game.JobId == "" then
        fallbackToLobby(cycle, "Current server unavailable")
        return
    end
    idleRuntime.SameServerAttempts += 1
    local attempt = idleRuntime.SameServerAttempts
    idleRuntime.Step += 1
    local step = idleRuntime.Step
    local delaySec = math.clamp(idleRuntime.ReconnectDelay + (attempt - 1) * 3, 2, 30)
    idleRuntime.State = "Same-server wait"
    setReconnectStatus(string.format("Same-server attempt %d/%d in %ds", attempt,
        idleRuntime.MaxSameServerAttempts, delaySec))
    task.delay(delaySec, function()
        if not permitted(idleRuntime.Manual) or idleRuntime.Cycle ~= cycle
            or idleRuntime.Step ~= step or idleRuntime.TeleportStarted then return end
        idleRuntime.State = "Same-server request"
        persistBeforeReconnect()
        local queued, queueErr = queueReconnectScript()
        if not queued then warn("[Tame V44 Reconnect] " .. tostring(queueErr)) end
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, Player)
        end)
        if not ok then
            setReconnectStatus("Same-server request failed: " .. tostring(err))
            advanceReconnect(cycle, "Same-server request rejected")
            return
        end
        setReconnectStatus(string.format("Same-server %d/%d requested | Waiting for transfer",
            attempt, idleRuntime.MaxSameServerAttempts))
        task.delay(12, function()
            if idleRuntime.Cycle == cycle and idleRuntime.Step == step
                and idleRuntime.Busy and not idleRuntime.TeleportStarted then
                advanceReconnect(cycle, "Same-server timeout")
            end
        end)
    end)
end

local function startReconnect(reason, manual)
    manual = manual == true
    if not permitted(manual) then return end
    if isBlockedReason(reason) then
        setReconnectStatus("Blocked/kick reason | Auto reconnect skipped")
        return
    end
    if idleRuntime.Busy then return end
    local now = os.clock()
    if not manual and now - idleRuntime.LastTriggerAt < 2 then return end
    idleRuntime.LastTriggerAt = now
    idleRuntime.LastRejoinReason = tostring(reason or "Connection error")
    idleRuntime.Cycle += 1
    idleRuntime.Step += 1
    idleRuntime.SameServerAttempts = 0
    idleRuntime.LobbyAttempts = 0
    idleRuntime.QueuePrepared = false
    idleRuntime.TeleportStarted = false
    idleRuntime.Busy = true
    idleRuntime.Manual = manual
    local cycle = idleRuntime.Cycle
    idleRuntime.State = "Recovering"
    if isDeadServer(reason) then
        fallbackToLobby(cycle, "Server shutdown")
    else
        attemptSameServer(cycle)
    end
end

