-- At most every 0.12s, confirm that the combat character remains over a
-- walkable arena surface. If it drops well BELOW the last known arena floor,
-- recover while the farm still owns noclip/flight instead of falling into void.
-- We deliberately don't reject ordinary Above/Below positions near the floor.
local function arenaSafetyTick(root, now)
    if not S.autoFarm or S.farmMethod == "Legit" then return end
    if now - S.lastSupportCheck < 0.12 then return end
    S.lastSupportCheck = now
    local floorY = groundSupportAt(root.Position)
    local baseline = S.lastSupportedFloorY
        or (S.groundBackup and S.groundBackup.Y - 3.5)
    local droppedUnderArena = baseline and root.Position.Y < baseline - 22
    local unrelatedLowerFloor = floorY and baseline and floorY < baseline - 30

    if droppedUnderArena and (not floorY or unrelatedLowerFloor) then
        if now - S.lastSafetyRecovery >= 0.65 then
            S.lastSafetyRecovery = now
            local pose = S.lastSupportedPose
            if not pose and S.groundBackup then
                pose = CFrame.new(S.groundBackup) * root.CFrame.Rotation
            end
            if pose then
                root.CFrame = pose
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                S.smoothPose = pose
                S.dodgeGoal = nil
                S.dodgeHoldUntil = -HUGE
                S.dodgeLastClear = nil
                S.dodgeResumeUntil = now + REENGAGE_BOOST_TIME
                -- Re-evaluate target from the recovered location immediately.
                setTarget(nil)
                S.lastTargetScan = -HUGE
            end
        end
        return
    end

    if floorY and not unrelatedLowerFloor
        and root.Position.Y >= floorY - 5
        and root.Position.Y <= floorY + 180 then
        S.lastSupportedPose = root.CFrame
        S.lastSupportedFloorY = floorY
    end
end

-- One Heartbeat controls the timeline. Combat is checked first so a busy
-- hazard scan, grounded pathfinder, or pose update cannot postpone ready skills.
S.connections[#S.connections+1] = RunService.Heartbeat:Connect(function(dt)
    if not S.alive then return end
    if inLobby() then return end
    if not statsReady() then return end
    local now = os.clock()
    if S.autoRetry or S.autoLeaveMatches then
        local results = resultScreenVisible(now)
        resultsWorkflowTick(now, results)
    end
    if not (S.autoFarm or S.autoAttack or S.autoSkills or S.autoDodge) then return end
    local _, humanoid, root = getCharacter()
    if not root then return end
    if S.autoFarm then
        local safe, errorMessage = pcall(arenaSafetyTick, root, now)
        if not safe then warnOnce(errorMessage) end
    end
    local showingResults = resultScreenVisible(now)
    local target = nil
    if not showingResults then
        target = findTarget(root)
        if target and not validTarget(target) then
            setTarget(nil)
            target = findTarget(root)
        end
    end

    if not showingResults then
        local ok, err = pcall(function()
            if S.autoAttack then
                if not S.autoFarm and target then faceFlat(root, target) end
                fireBasic(root, characterData(), now)
            end
            if S.autoSkills and target then
                if not S.autoFarm then faceFlat(root, target) end
                fireSkills(root, target, now)
            end
        end)
        if not ok then warnOnce(err) end
    end

    local dodging = false
    if S.autoDodge and not showingResults then
        local ok, result = pcall(dodgeTick, dt, root, humanoid, target, now)
        if ok then dodging = result == true else warnOnce(result) end
    end
    if S.autoFarm and showingResults then
        if S.oldCharacter then releaseMovement() end
    elseif not dodging and S.autoFarm and target then
        local moveTarget = S.target and validTarget(S.target) and S.target or target
        local ok, err = pcall(farmTick, dt, root, humanoid, moveTarget, now)
        if not ok then warnOnce(err) end
    elseif not dodging and S.autoFarm and S.oldCharacter then
        local ok, err = pcall(holdFarmPose, root, humanoid)
        if not ok then warnOnce(err) end
    end
end)

