local function isCastPointMapBlocked(root, target)
    local world = workspace:FindFirstChild("World")
    local islands =
        world and world:FindFirstChild("Islands")

    if not islands then
        return false
    end

    if CastMapGuard and CastMapGuard.IsBlocked then
        local ok, blocked = pcall(function()
            return CastMapGuard.IsBlocked(
                root,
                target,
                islands
            )
        end)

        if ok then
            return blocked == true
        end
    end

    local params = RaycastParams.new()
    params.FilterType =
        Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {
        islands,
    }

    return workspace:Raycast(
        target + Vector3.new(0, 100, 0),
        Vector3.new(0, -100, 0),
        params
    ) ~= nil
end

local function findClearWaterFacing()
    local character = LocalPlayer.Character
    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    local humanoid =
        character
        and character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0 then
        return nil, nil
    end

    if humanoid.SeatPart ~= nil
        or humanoid.Sit
        or humanoid:GetState()
            == Enum.HumanoidStateType.Swimming then
        return nil, nil
    end

    local islandId = getCurrentIslandId()

    if islandId == "" then
        return nil, nil
    end

    local look = Vector3.new(
        root.CFrame.LookVector.X,
        0,
        root.CFrame.LookVector.Z
    )

    if look.Magnitude < 0.001 then
        look = Vector3.new(0, 0, -1)
    else
        look = look.Unit
    end

    local waterY = getWaterY()
    local powers =
        FishingConfig.AutoFishing
        and FishingConfig.AutoFishing.CastProbePowers
        or { 1, 0.75, 0.5, 0.25 }

    for _, offset in ipairs(
        WATER_LOOK_OFFSETS
    ) do
        local rotation =
            CFrame.Angles(
                0,
                math.rad(offset),
                0
            )

        local direction =
            rotation:VectorToWorldSpace(look)

        direction = Vector3.new(
            direction.X,
            0,
            direction.Z
        ).Unit

        for _, power in ipairs(powers) do
            local distance =
                FishingConfig.Cast.BaitMinDist
                + power
                    * (
                        FishingConfig.Cast.BaitMaxDist
                        - FishingConfig.Cast.BaitMinDist
                    )

            local target = Vector3.new(
                root.Position.X
                    + direction.X * distance,
                waterY,
                root.Position.Z
                    + direction.Z * distance
            )

            if not isCastPointMapBlocked(
                root,
                target
            ) then
                return direction, target
            end
        end
    end

    return nil, nil
end

local function ensureLookingAtWater()
    if not Config.AutoLookAtWater then
        return true
    end

    if Config.AutoBossFarm
        and State.BossSessionActive then
        return true
    end

    local direction, target =
        findClearWaterFacing()

    if not direction then
        State.WaterLookStatus =
            "No clear water within cast range"
        return false
    end

    local character = LocalPlayer.Character
    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root
        or not root:IsA("BasePart") then
        return false
    end

    root.CFrame =
        CFrame.lookAt(
            root.Position,
            root.Position + direction
        )

    State.WaterLookStatus =
        "Facing clear water"
    State.LastWaterLookAt = os.clock()

    return true
end

local function calculateCastTarget(power)
    if Config.AutoBossFarm
        and State.BossSessionActive
        and typeof(State.BossTargetPosition) == "Vector3" then

        local p = State.BossTargetPosition
        return Vector3.new(p.X, getWaterY(), p.Z)
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (root and root:IsA("BasePart")) then
        return nil
    end

    local horizontal = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if horizontal.Magnitude < 0.001 then
        return nil
    end

    local cast = FishingConfig.Cast
    local distance = cast.BaitMinDist + power * (cast.BaitMaxDist - cast.BaitMinDist)
    local unit = horizontal.Unit

    return Vector3.new(
        root.Position.X + unit.X * distance,
        getWaterY(),
        root.Position.Z + unit.Z * distance
    )
end

local function hasEquippedRod()
    local ok, data = pcall(function()
        return PlayerDataV2Controller:Fetch()
    end)

    if not ok or not data then
        return true
    end

    local rodId = data.RodEquip

    return type(rodId) == "string"
        and rodId ~= ""
        and rodId ~= "None"
        and type(data.Rods) == "table"
        and data.Rods[rodId] ~= nil
        and Catalog.Rod.GetById(rodId) ~= nil
end

local function sendOPCast()
    if not Config.Enabled or Config.Mode ~= "OP" or State.Phase ~= "Idle" then
        return false
    end

    if not hasEquippedRod() then
        State.NextCastAt = os.clock() + 1
        log("OP cast skipped: equip a rod")
        return false
    end

    if not ensureLookingAtWater() then
        State.NextCastAt =
            os.clock() + 0.50
        return false
    end

    local power = Config.PerfectCast and math.clamp(Config.CastThreshold, 0, 1) or 0.50
    local target = calculateCastTarget(power)

    if not target then
        State.NextCastAt = os.clock() + 1
        return false
    end

    if not safeFire(FishingPackets.FishCast, power, target) then
        State.NextCastAt = os.clock() + 1
        return false
    end

    State.LastCastStarted = os.clock()
    State.CastAckDeadline = State.LastCastStarted + math.max(1, Config.CastAckTimeout)
    touchPacket()
    setPhase("Casting")
    log("OP FishCast", string.format("power=%.3f", power))
    return true
end

local function scheduleOPFirstPull(startServerTime)
    State.FirstPullGeneration += 1
    local generation = State.FirstPullGeneration
    local startedAt = os.clock()

    task.spawn(function()
        while State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.Phase == "FirstPull"
            and State.FirstPullGeneration == generation do

            local now = os.clock()
            local pull = 0

            if type(startServerTime) == "number" then
                local ok, result = pcall(function()
                    local elapsed = workspace:GetServerTimeNow() - startServerTime
                    return PullBarMath.Position(elapsed, FishingConfig.FirstPull.OscillateSpeed)
                end)

                if ok then
                    pull = tonumber(result) or 0
                end
            end

            local shouldPull
            if Config.PerfectFirstPull then
                shouldPull = pull >= Config.FirstPullThreshold
                    or now - startedAt >= Config.FirstPullFallbackSeconds
            else
                shouldPull = now - startedAt >= 0.45
            end

            if shouldPull then
                if safeFire(FishingPackets.FishFirstPull) then
                    State.FirstPullSentAt = now
                    log("OP FishFirstPull", string.format("bar=%.3f", pull))
                end
                return
            end

            RunService.Heartbeat:Wait()
        end
    end)
end

local function sendOPReelPull()
    State.ReelSequence = State.ReelSequence % 65535 + 1

    if safeFire(FishingPackets.FishReelPull, State.ReelSequence) then
        State.NextReelAt = os.clock() + (1 / math.clamp(Config.ReelCPS, 0.5, 5.8))
        return true
    end

    State.NextReelAt = os.clock() + 0.2
    return false
end

local function getSkillForSlot(index)
    local ok, data = pcall(function()
        return PlayerDataV2Controller:Fetch()
    end)

    if not ok or not data then
        return nil, nil
    end

    local rodId = data.RodEquip
    local rodData = rodId and data.Rods and data.Rods[rodId]
    local slots = rodData and rodData.BookSlots
    local slotName = "Slot" .. tostring(index)
    local skillId = slots and slots[slotName]

    if type(skillId) ~= "string" or skillId == "" then
        return slotName, nil
    end

    return slotName, skillId
end

local function isSkillOnCooldown(slotName)
    if not RodController then
        return false
    end

    local cooldowns = RodController.CooldownActive
    return type(cooldowns) == "table" and cooldowns[slotName] ~= nil
end

local function getBestReadySkillSlot()
    local bestIndex = nil
    local bestScore = -math.huge

    for index = 1, 4 do
        local slotName, skillId = getSkillForSlot(index)

        if skillId and not isSkillOnCooldown(slotName) then
            local info = Catalog.Skill.GetById(skillId)
            local score = info and tonumber(info.damageCoef) or 0

            if score > bestScore then
                bestScore = score
                bestIndex = index
            end
        end
    end

    return bestIndex
end

local function trySendOPSkill()
    if not RodController or not RodController.Moveset then
        return false
    end

    if LocalPlayer:GetAttribute("IsUsingSkill") then
        return false
    end

    -- Quest finisher quests force the required skill/slot so another
    -- equipped skill cannot accidentally take the final blow.
    if State.QuestForcedSkillSlot then
        local index = State.QuestForcedSkillSlot
        local slotName, skillId = getSkillForSlot(index)

        if skillId
            and skillId == State.QuestForcedSkillId
            and not isSkillOnCooldown(slotName) then

            if safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP quest skill", slotName, skillId)
                return true
            end
        end

        return false
    end

    if Config.SkillRotationMode == "Strongest Ready" then
        local index = getBestReadySkillSlot()

        if index then
            local slotName, skillId = getSkillForSlot(index)

            if skillId
                and safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP strongest skill", slotName, skillId)
                return true
            end
        end

        return false
    end

    for _ = 1, 4 do
        local index = State.SkillIndex
        local slotName, skillId = getSkillForSlot(index)
        State.SkillIndex = index % 4 + 1

        if skillId and not isSkillOnCooldown(slotName) then
            if safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP skill", slotName, skillId)
                return true
            end
        end
    end

    return false
end

local function questFinisherHoldActive()
    if not State.QuestForcedSkillId
        or not State.QuestForcedSkillSlot then
        return false
    end

    local hp = tonumber(State.CurrentFishHP) or 0
    local maxHp = tonumber(State.CurrentFishMaxHP) or 0

    if hp <= 0 or maxHp <= 0 then
        return false
    end

    return (hp / maxHp)
        <= math.clamp(
            tonumber(Config.QuestFinisherThreshold) or 0.20,
            0.05,
            0.75
        )
end

local function scheduleOPResultReset(skipLoot)
    State.ResultGeneration += 1
    local generation = State.ResultGeneration

    task.spawn(function()
        if not skipLoot then
            if not Config.AutoConfirmLoot then
                return
            end

            local readyDelay = Config.LootClickDelay
            pcall(function()
                readyDelay = math.max(readyDelay, FishingConfig.Loot.ConfirmReadyDelay)
            end)

            task.wait(readyDelay)

            if not State.Alive
                or not Config.Enabled
                or Config.Mode ~= "OP"
                or State.Phase ~= "Caught"
                or State.ResultGeneration ~= generation then
                return
            end

            safeFire(FishingPackets.FishLootConfirm)
            log("OP FishLootConfirm")
        end

        local resetDelay = 0.50
        pcall(function()
            resetDelay = math.max(resetDelay, FishingConfig.General.CastCancelDelay)
        end)
        task.wait(resetDelay)

        if State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.ResultGeneration == generation
            and State.Phase == "Caught" then
            resetOPSession(Config.RecastDelay)
        end
    end)
end

local function scheduleOPEscapeReset()
    State.ResultGeneration += 1
    local generation = State.ResultGeneration

    task.spawn(function()
        local delaySeconds = 0.50
        pcall(function()
            delaySeconds = math.max(delaySeconds, FishingConfig.General.ResultDisplayTime)
        end)
        task.wait(delaySeconds)

        if State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.ResultGeneration == generation
            and State.Phase == "Escaped" then
            resetOPSession(Config.RecastDelay)
        end
    end)
end

