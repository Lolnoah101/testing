                    ) > 5
                    then

                        AdvancedAutomationSettings
                            .QueueIndex =
                            1
                    end


                    AdvancedAutomationSettings
                        .AutoQueue =
                        true


                elseif Mode == "Auto Accessory Loadout" then

                    AdvancedAutomationSettings
                        .AutoAccessoryLoadout =
                        true


                elseif Mode == "Daily Routine" then

                    Master.DailyRoutine =
                        true
                end


                GENV.__AZ_MAIN_CONTROLLER_APPLYING =
                    false


                AdvancedAutomationSettings
                    .RunAutomation =
                    true


                PersistAdvanced()


                return true
            end


