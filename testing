function Systems.getAuraScore(entry, strategy)
    local catalog =
        type(entry) == "table"
        and entry.catalogId
        and Catalog.Aura.GetById(entry.catalogId)
        or nil

    if not catalog then
        return -math.huge
    end

    local rolled =
        type(entry.rolled) == "table"
        and entry.rolled
        or {}

    local rarityScore =
        (Systems.RarityRank[catalog.rarity] or 0) * 1000000

    if strategy == "Highest Rarity" then
        local sum = 0

        for _, mod in ipairs(rolled) do
            sum += math.abs(tonumber(mod.value) or 0)
        end

        return rarityScore + sum
    end

    local score = 0

    for _, mod in ipairs(rolled) do
        local stat = tostring(mod.stat or "")
        local value = tonumber(mod.value) or 0

        if strategy == "Luck" and stat == "luck" then
            score += value
        elseif strategy == "Sell Value"
            and stat == "sellValuePct" then
            score += value * 100
        elseif strategy == "Mastery"
            and stat == "masteryXpPct" then
            score += value * 100
        elseif strategy == "Damage" then
            if stat == "skillDamageById"
                or stat == "skillDamageByGroup" then
                score += value * 100
            elseif stat == "critChance" then
                score += value * 80
            elseif stat == "cooldownReductionPct" then
                score += value * 60
            end
        end
    end

    if score <= 0 then
        return rarityScore * 0.000001
    end

    return score + (Systems.RarityRank[catalog.rarity] or 0) * 0.001
end

