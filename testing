task.spawn(function()
    while state.Running do
        local nowMode = player:GetAttribute("Mode")
        -- Keep a rolling safe position for manual joins as well. The snapshot
        -- taken immediately before an automated join always takes precedence.
        if state.IsInWorld() and not state.ModeReturnSpot
            and not state.ModeReturnRestoring then
            local root = getParts()
            if root then
                state.ModeReturnLastWorldSpot = {
                    cf = (state.WasBelowFarming and state.BelowReturnCFrame) or root.CFrame,
                    world = getWorld() or state.CurrentWorld,
                    at = os.clock(),
                }
            end
        end
        local returning = state.ModeReturnSpot
        if state.IsInGameMode() and not returning then
            local previousSpot = state.ModeReturnLastWorldSpot
            if previousSpot and os.clock() - previousSpot.at < 15 then
                state.ModeReturnSpot = {
                    cf = previousSpot.cf, world = previousSpot.world,
                    at = previousSpot.at, entered = true,
                    completedMode = nowMode, requestedMode = nowMode,
                }
                returning = state.ModeReturnSpot
            end
        end
        if returning and state.IsInGameMode() then
            returning.entered = true
            returning.completedMode = nowMode
        end
        if nowMode ~= state.LastSeenMode then
            if returning and returning.entered and state.IsInWorld() then
                state.BeginModeReturn()
            end
            -- Never return to an old game-mode floor after a teleport out.
            if state.WasBelowFarming then
                clearReturnPosition()
                removeBelowPlatform()
            end
            changeTarget()
            state.LastSeenMode = nowMode
        end
        if state.ModeReturnRestoring then
            -- Freeze only movement (not toggles) while the game transitions
            -- and the saved position is being restored.
            stopMoving()
        elseif state.AutoFarm or hasActiveQuestTarget() or activeModeFarm() then
            local ok, err = pcall(updateAutoFarm)
            if not ok then warn("[Paraiso] Farm/Quest movement:", err) end
        else
            -- Quest finished/disabled while Below farming: don't strand player
            -- on the underground platform after movement stops.
            if state.WasBelowFarming then
                local ok, err = pcall(returnAboveMap)
                if not ok then warn("[Paraiso] Surface recovery:", err) end
                changeTarget()
            elseif state.FarmTarget then
                changeTarget()
            end
            if state.AutoAttack then
                local ok, err = pcall(updateUnitAutoAttack)
                if not ok then warn("[Paraiso Farm] Units Auto Attack:", err) end
            end
        end
        task.wait(0.1)
    end
end)

