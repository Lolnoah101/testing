                    )
                    .. "\nRunning: "
                    .. tostring(
                        Advanced.AutoQueue
                        == true
                    )
                    .. "\nLoop: "
                    .. tostring(
                        Advanced.QueueLoop
                        == true
                    ),
                8
            )
        end


    --//========================================================
    --// MAIN ADVANCED LOOP
    --//========================================================

    task.spawn(function()

        while Alive() do

            pcall(
                RunMultiTitle
            )


            pcall(
                RunFullEvolve
            )


            pcall(
                RunAchievementGrinder
            )


            pcall(
                RunAccessoryLoadout
            )


            pcall(
                RunAutomationQueue
            )


            task.wait(
                0.50
            )
        end
    end)


    Persist()


    task.delay(
        1,
        function()

            if Advanced.RunAutomation == true then

                local Start =
                    GENV.__AZ_MAIN_AUTOMATION_START_SELECTED


                if type(Start) == "function" then
                    pcall(Start)
                end
            end
        end
    )


    print(
        "[Anime Zero] Advanced automation ready."
    )

end)()


