function Systems.getESPAdornee(instance)
    if not instance then
        return nil
    end

    if instance:IsA("BasePart") then
        return instance
    end

    if instance:IsA("Model") then
        return instance.PrimaryPart
            or instance:FindFirstChild("HumanoidRootPart", true)
            or instance:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

function Systems.removeESP(key)
    local gui = State.ESPObjects[key]

    if gui then
        pcall(function()
            gui:Destroy()
        end)
        State.ESPObjects[key] = nil
    end
end

function Systems.ensureESP(key, instance, label)
    local adornee = Systems.getESPAdornee(instance)

    if not adornee then
        Systems.removeESP(key)
        return
    end

    local root = getCharacterRoot()

    if root
        and (root.Position - adornee.Position).Magnitude
            > math.max(
                100,
                tonumber(Config.ESPMaxDistance) or 3000
            ) then
        Systems.removeESP(key)
        return
    end

    local gui = State.ESPObjects[key]

    if not gui or not gui.Parent then
        gui = Instance.new("BillboardGui")
        gui.Name = "_FishingSuiteESP"
        gui.AlwaysOnTop = true
        gui.Size = UDim2.fromOffset(180, 36)
        gui.StudsOffset = Vector3.new(0, 3, 0)
        gui.Adornee = adornee
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

        local labelObject = Instance.new("TextLabel")
        labelObject.Name = "Label"
        labelObject.Size = UDim2.fromScale(1, 1)
        labelObject.BackgroundTransparency = 0.25
        labelObject.TextScaled = false
        labelObject.TextSize = 13
        labelObject.Font = Enum.Font.GothamBold
        labelObject.TextColor3 = Color3.new(1, 1, 1)
        labelObject.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
        labelObject.Parent = gui

        State.ESPObjects[key] = gui
    end

    gui.Adornee = adornee

    local labelObject = gui:FindFirstChild("Label")

    if labelObject then
        labelObject.Text = label
    end
end

function Systems.clearESP()
    for key in pairs(State.ESPObjects) do
        Systems.removeESP(key)
    end
end

function Systems.stepESP()
    local now = os.clock()

    if now - State.LastESPUpdate
        < math.max(
            0.25,
            tonumber(Config.ESPUpdateInterval) or 1
        ) then
        return
    end

    State.LastESPUpdate = now

    if not Config.FishESP
        and not Config.BossRegionESP
        and not Config.NpcESP then
        Systems.clearESP()
        return
    end

    local wanted = {}

    if Config.FishESP and State.CurrentFishModel then
        local fishInfo = Catalog.Fish.GetById(State.CurrentFishId)

        local label =
            tostring(
                fishInfo and fishInfo.name
                or State.CurrentFishId
                or "Fish"
            )

        wanted["current_fish"] = true
        Systems.ensureESP(
            "current_fish",
            State.CurrentFishModel,
            label
        )
    end

    if Config.BossRegionESP then
        for _, part in ipairs(
            CollectionService:GetTagged(RegionConfig.BossTag)
        ) do
            if part:IsA("BasePart") then
                local fx = BossSpawnerFX.GetForRegion(part)

                if fx and BossSpawnerFX.IsActive(fx) then
                    local key = "boss_region:" .. part:GetDebugId()
                    local regionId =
                        part:GetAttribute(RegionConfig.BossAttribute)
                    local info =
                        regionId
                        and Catalog.BossRegion.GetById(regionId)
                        or nil

                    wanted[key] = true

                    Systems.ensureESP(
                        key,
                        part,
                        "BOSS: "
                            .. tostring(
                                info and info.name
                                or regionId
                                or "Active Region"
                            )
                    )
                end
            end
        end
    end

    if Config.NpcESP then
        local count = 0

        for _, instance in ipairs(workspace:GetDescendants()) do
            if count >= 40 then
                break
            end

            local lower = string.lower(instance.Name)

            if string.sub(lower, 1, 4) == "npc_" then
                local adornee = Systems.getESPAdornee(instance)

                if adornee then
                    local key = "npc:" .. instance:GetDebugId()
                    wanted[key] = true

                    Systems.ensureESP(
                        key,
                        instance,
                        string.gsub(instance.Name, "^npc_", "")
                    )

                    count += 1
                end
            end
        end
    end

    for key in pairs(State.ESPObjects) do
        if not wanted[key] then
            Systems.removeESP(key)
        end
    end
end

