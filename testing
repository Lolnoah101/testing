local function updateAutoQuest()
    if not state.AutoQuest then
        state.QuestMob = nil
        state.QuestWorld = nil
        state.QuestProgressState = nil
        setQuestStatus("Auto Quest OFF | Farm settings unchanged.")
        return
    end
    -- Clear stale quest world/target on world transitions before checking data.
    local currentWorld = getWorld()
    if state.QuestWorld and currentWorld ~= state.QuestWorld then
        state.QuestMob = nil
        state.QuestWorld = nil
        state.QuestProgressState = nil
    end
    if not nativeController or not nativeController.ClientLoaded
        or type(nativeController.Data) ~= "table" then
        setQuestStatus("Waiting for your game quest data...")
        return
    end

    local world = getWorld()
    if type(world) ~= "string" or world == "" then
        setQuestStatus("Waiting for current world...")
        return
    end

    local giver = currentQuestGiver(world)
    if not giver then
        setQuestStatus(world .. " | No world storyline available.")
        return
    end

    local ok, quest, progressState, status = pcall(
        questUtils.Status, questUtils, nativeController.Data, giver
    )
    if not ok then
        setQuestStatus(world .. " | Unable to read quest status: " .. tostring(quest))
        return
    end
    -- Store quest status even when this is a non-combat step. This makes the
    -- 0.1s farm loop wait for quest progression before swapping targets.
    state.QuestWorld = world
    state.QuestProgressState = status
    if status ~= "active" then state.QuestMob = nil end
    if status == "locked" then
        setQuestStatus(world .. " | Storyline locked. Finish the previous world's quests first.")
        return
    end
    if status == "finished" then
        setQuestStatus(world .. " | All storyline quests completed!")
        return
    end
    if type(quest) ~= "table" or type(progressState) ~= "table" then
        setQuestStatus(world .. " | Waiting for quest information...")
        return
    end

    local title = tostring(quest.Title or ("Quest " .. tostring(quest.Id or "?")))
    local required = tonumber(quest.Required) or 0
    local progress = math.max(0, tonumber(progressState.Progress) or 0)
    local displayProgress = string.format("%s | %s: %d/%d", world, title,
        math.floor(progress), math.floor(required))

    if status == "active" then
        local questMob = type(quest.Enemy) == "string" and quest.Enemy or nil
        -- Validate against the game's world quest definitions. A quest outside
        -- the current world or a non-combat objective must never cause travel.
        local hasWorldMob = false
        for _, mobId in ipairs(WORLD_MOBS[world] or {}) do
            if mobId == questMob then hasWorldMob = true; break end
        end
        state.QuestMob = hasWorldMob and questMob or nil
        if not state.QuestMob then
            setQuestStatus(displayProgress .. " | Quest mob unavailable; no movement.")
        else
            setQuestStatus(displayProgress .. " | Auto traveling/attacking " .. questMob
                .. " via " .. state.Method .. " / " .. state.Position
                .. ". Auto Farm: " .. (state.AutoFarm and "ON" or "OFF")
                .. "; manual mobs unchanged.")
        end
        return
    end

    -- Only accept/complete quests that the game's Quest_Utils says are ready.
    -- Travel/attacking uses the shared engine, enabled by Auto Quest itself.
    if status ~= "available" and status ~= "complete" then
        setQuestStatus(displayProgress .. " | State: " .. tostring(status))
        return
    end

    local action = status == "complete" and "Complete" or "Accept"
    local questIndex = tonumber(progressState.Current) or tonumber(quest.Id) or 1
    local requestKey = table.concat({world, giver, action, tostring(questIndex)}, "|")
    local now = os.clock()
    -- Wait for the game to replicate a changed quest before retrying the same
    -- action; this prevents repeated requests while the server processes it.
    if now - (state.QuestLastAttempt[requestKey] or -math.huge) < 15 then
        setQuestStatus(displayProgress .. " | " .. action .. " requested; waiting for game update.")
        return
    end
    if now - state.QuestLastRequestAt < 1.5 then return end

    state.QuestLastAttempt[requestKey] = now
    state.QuestLastRequestAt = now
    local sent, requestError = pcall(function()
        bridge:FireServer("General", "Quest", action, giver)
    end)
    if sent then
        setQuestStatus(displayProgress .. " | " .. action .. " requested; awaiting confirmation.")
    else
        setQuestStatus(displayProgress .. " | Request failed: " .. tostring(requestError))
        warn("[Paraiso Misc] Auto Quest request failed:", requestError)
    end
end

