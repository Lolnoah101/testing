        local UserStay = Settings.StayNoclip == true
        -- Keep persistent noclip in place through combat, gate/lever waits,
        -- stairs, the garage, and Floor 10's two-deck transition.
        GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(
            UserStay or InTransit == true,
            not UserStay and not InTransit
        )
    elseif Settings.StayNoclip == true and Settings.FarmMethod ~= "Legit" then
        GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(true)
    end
end)
table.insert(Runtime.Connections, GENV.__AZ_FARM_EXT.StayNoclipConnection)


