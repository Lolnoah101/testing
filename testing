        if type(data)~="table" then return end
        for key,value in pairs(data) do
            local weight=weights[key]
            if weight then
                if type(value)=="number" then total=total+value*weight
                elseif type(value)=="table" then total=total+(tonumber(value.Value) or 0)*weight end
            end
        end
    end
