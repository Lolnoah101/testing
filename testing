track(FishingPackets.FishCatchResult.OnClientEvent:Connect(function(
    success,
    fishId,
    _quantity,
    weight,
    isHuge,
    skipLoot,
    _items,
    value,
    isNew
)
    if not State.Alive or not Config.Enabled then
        return
    end

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0

    if success then
        State.Caught += 1
        State.LastFishId = tostring(fishId or "")
        State.LastWeight = tonumber(weight) or 0
        State.LastValue = tonumber(value) or 0
        State.LastHuge = isHuge == true
        State.LastNew = isNew == true

        State.SessionValue += State.LastValue
        State.SessionWeight += State.LastWeight

        if State.LastHuge then
            State.HugeCaught += 1
        end

        if State.LastNew then
            State.NewCaught += 1
        end

        State.CatchByFish[State.LastFishId] =
            (State.CatchByFish[State.LastFishId] or 0) + 1

        local fishInfo = Catalog.Fish.GetById(State.LastFishId)
        local stopReason = nil

        if Config.StopOnHuge and State.LastHuge then
            stopReason = "Huge fish caught"
        elseif Config.StopOnNewFish and State.LastNew then
            stopReason = "New fish discovered"
        elseif Config.StopFishIds[State.LastFishId] == true then
            stopReason =
                "Target fish caught: "
                .. tostring(fishInfo and fishInfo.name or State.LastFishId)
        elseif fishInfo
            and Config.StopRarities[fishInfo.rarity] == true then
            stopReason = "Target rarity caught: " .. tostring(fishInfo.rarity)
        end

        if stopReason then
            State.TargetStopReason =
                stopReason

            if Systems.setEnabled then
                Systems.setEnabled(
                    false,
                    "target stop"
                )
            else
                Config.Enabled = false
                mouseUp()
            end

            log(
                "Target stop:",
                stopReason
            )
        end

        log("Caught", State.LastFishId, string.format("%.2f kg", State.LastWeight), "mode=" .. Config.Mode)

        if State.BossSessionActive
            and State.BossId ~= ""
            and State.LastFishId == State.BossId then
            State.BossCatches += 1
            State.BossLastStatus = "Caught " .. tostring(State.BossName)
        end

        if Config.Mode == "OP" then
            touchPacket()
            setPhase("Caught")
            scheduleOPResultReset(skipLoot == true)
        end
    else
        State.Escaped += 1
        log("Fish escaped", "mode=" .. Config.Mode)

        if Config.Mode == "OP" then
            touchPacket()
            setPhase("Escaped")
            scheduleOPEscapeReset()
        end
    end
end))

