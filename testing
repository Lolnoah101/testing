local function loadSession()
    local result = table.clone(SESSION_DEFAULT)
    if type(readfile) == "function" then
        local ok, raw = pcall(readfile, SESSION_FILE)
        if ok and type(raw) == "string" and #raw < 20000 then
            local decodedOk, decoded = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if decodedOk and type(decoded) == "table" then
                for k, v in pairs(SESSION_DEFAULT) do
                    if type(decoded[k]) == type(v) then result[k] = decoded[k] end
                end
            end
        end
    end
    if result.startedAt > os.time() or os.time() - result.startedAt > 86400 then
        result = table.clone(SESSION_DEFAULT)
    end
    return result
end

