function Hub.QuestFns.buildQuestOptions()
    local boardMap = Hub.QuestFns.getQuestBoardData()
    local options, lookup = {}, {None=false}
    local perCategory = {MainStory={"None"},Explorative={"None"}}
    local entries = {}
    for _, base in ipairs(QuestCatalog) do
        local def = Hub.QuestFns.questIndexDefinition(base.id) or {}
        local board = boardMap[base.id]
        -- The duplicate Phantom Goon quest is not present on this board.
        if base.id == "KillPhantomGoon" and not board
            and Hub.QuestSelectedId ~= "KillPhantomGoon" then
            continue
        end
        -- Only show actually cataloged quest-board contracts in Main Story;
        -- speculative unboarded enemy quests were cluttering the old selector.
        if (base.kind=="Combat" or base.kind=="Boss") and not board then
            continue
        end
        local gameCategory = Hub.QuestFns.questCategory(base, board)
        local uiCategory = board and "MainStory" or "Explorative"
        local level = tonumber(def.LEVEL_REQUIREMENT) or base.level
        if board and board.min then level = math.max(level or 0, board.min) end
        local meta = {
            id=base.id, name=Hub.QuestFns.questHumanName(base), level=level,
            stage=base.stage, category=gameCategory, uiCategory=uiCategory,
            board=board and board.name, boardMin=board and board.min,
            boardMax=board and board.max, boardSource=board and board.source,
            order=board and board.order or math.huge,
            target=def.KILL_TARGET or base.target,
            oneTime=def.CAN_ONLY_BE_DONE_ONCE == true,
            multipleStages=#(def.STAGES or {}) > 1,
            cannotAbandon=def.CANT_ABANDON == true,
            requiresNen=def.REQUIRES_NENUNLOCKED == true,
            stages=def.STAGES or {}, definition=def,
        }
        table.insert(entries,{cat=uiCategory,meta=meta})
    end
    table.sort(entries,function(a,b)
        if a.cat~=b.cat then return a.cat=="MainStory" end
        if a.cat=="Explorative" then
            return a.meta.name:lower()<b.meta.name:lower()
        end
        local x,y=a.meta,b.meta
        local la,lb=x.boardMin or x.level or math.huge,y.boardMin or y.level or math.huge
        if la~=lb then return la<lb end
        local ma,mb=x.boardMax or math.huge,y.boardMax or math.huge
        if ma~=mb then return ma<mb end
        if (x.board or "")~=(y.board or "") then
            return (x.board or "")<(y.board or "")
        end
        if x.order~=y.order then return x.order<y.order end
        return x.name<y.name
    end)
    for _, entry in ipairs(entries) do
        local cat, meta=entry.cat, entry.meta
        local display=Hub.MainStoryDisplayNames[meta.id] or meta.name
        if cat=="MainStory" then
            -- A boss not part of a known board still uses the genuine quest title.
            if meta.board then
                display=("Lv %s-%s | %s"):format(
                    tostring(meta.boardMin or "?"),tostring(meta.boardMax or "?"),display)
            elseif meta.level then
                display=("Lv %s+ | %s"):format(tostring(meta.level),display)
            end
        end
        if lookup[display] then display=display.." ["..meta.id.."]" end
        table.insert(perCategory[cat],display)
        table.insert(options,display)
        lookup[display]=meta
    end
    return options,lookup,perCategory
end
function Hub.QuestFns.updateQuestDetails(content)
    if not QuestRefreshDetails then return end
    pcall(function()
        if QuestDetailIsParagraph then
            QuestRefreshDetails:Set({title="Quest Details", content=content,
                Title="Quest Details", Content=content})
        else
            QuestRefreshDetails:Set(content)
        end
    end)
end
function Hub.QuestFns.questLabelFor(meta)
    if not meta then return "Select a quest from one of the categories above." end
    local stages = {}
    for i, step in ipairs(meta.stages or {}) do
        table.insert(stages, tostring(i)..". "..tostring(step.label or "Objective")
            .." ("..tostring(step.needs or 1)..")")
    end
    local level = meta.level and ("Level "..meta.level.."+") or "Level requirement not published"
    local labels = {
        meta.name.." | "..level,
        "Type: "..meta.category .. (meta.oneTime and " | One-time" or " | Repeatable/unflagged"),
        "Board: "..(meta.board or "Not a quest-board entry in saved place"),
        meta.board and ("Board level band: "..tostring(meta.boardMin).."-"..tostring(meta.boardMax)
            .." | Source: "..tostring(meta.boardSource)) or "",
        meta.requiresNen and "Prerequisite: Nen unlocked" or "Prerequisite: see game state",
        "Stages ("..tostring(#stages).."): ",
        table.concat(stages,"\n"),
        "Quest ID: "..meta.id
    }
    return table.concat(labels,"\n")
end
