-- Player: Auto Respawn. Matches DeathScreenController in the supplied place:
-- the game sets Character.Dead, applies RespawnUnlockAt, then calls
-- knit.GetService("DeathService"):Respawn() from the normal Respawn button.
-- We do not try to bypass the native server cooldown.
function Hub:AutoRespawnTick()
    if not self.Running or not self.AutoRespawn then return end
    local now = os.clock()
    local char = LocalPlayer.Character
    local ui = LocalPlayer:FindFirstChild("PlayerGui")
    local deathScreen = ui and ui:FindFirstChild("DeathScreen")
    local deathScene = deathScreen and deathScreen:FindFirstChild("DeathScene")
    local showingDeath = deathScreen and deathScreen:IsA("ScreenGui")
        and deathScreen.Enabled and ((deathScene and deathScene.Visible)
            or (not deathScene and deathScreen:FindFirstChild("RespawnButton")
                and deathScreen.RespawnButton.Visible))
    local dead = (char and char:GetAttribute("Dead") == true) or showingDeath
    if not dead then
        if char and char.Parent then
            self.RespawnStatus = "Alive / ready"
            self.RespawnDeathSeenAt = 0
            self.RespawnDeathCharacter = nil
            self.RespawnRequestBusy = false
        else
            self.RespawnStatus = "Waiting for character"
        end
        return
    end
    if self.RespawnDeathSeenAt == 0 then
        self.RespawnDeathSeenAt = now
        self.RespawnDeathCharacter = char
        self.RespawnStatus = "Death detected"
    end
    if now < self.RespawnNextAt then return end
    -- If a promise stops responding, allow a guarded retry after its deadline.
    if self.RespawnRequestBusy then self.RespawnRequestBusy = false end

    local unlock = LocalPlayer:GetAttribute("RespawnUnlockAt")
    if typeof(unlock) == "number" then
        local okTime, serverNow = pcall(function() return workspace:GetServerTimeNow() end)
        if okTime and serverNow < unlock then
            self.RespawnStatus = string.format("Respawn unlock in %.1fs", unlock - serverNow)
            return
        end
    end
    -- In an older UI layout, do not send before the actual button unlocks.
    -- When no unlock attribute or button exists, the game's fallback is 5s.
    local button
    if deathScene then
        local panel = deathScene:FindFirstChild("Panel")
        button = panel and panel:FindFirstChild("Respawn")
    end
    if not button and deathScreen then
        local legacy = deathScreen:FindFirstChild("RespawnButton")
        button = legacy and legacy:FindFirstChild("Btn")
    end
    if button and button:IsA("GuiButton") and not button.Interactable then
        self.RespawnStatus = "Waiting for respawn button unlock"
        return
    end
    if typeof(unlock) ~= "number" and not button
        and now - self.RespawnDeathSeenAt < 5.8 then
        self.RespawnStatus = "Waiting for native respawn cooldown"
        return
    end

    self.RespawnRequestBusy = true
    self.RespawnAttempts += 1
    self.RespawnNextAt = now + 4.5
    self.RespawnStatus = "Requesting respawn"
    local token = self.RespawnToken
    local ok, response = pcall(function()
        return Knit.GetService("DeathService"):Respawn()
    end)
    if not ok then
        self.RespawnRequestBusy = false
        self.RespawnLastError = tostring(response)
        self.RespawnStatus = "Respawn request error"
        self.RespawnNextAt = now + 2
        return
    end
    -- Normal Knit returns a promise; do not assume the RPC's acknowledgement
    -- means the new character already replicated.
    local attached, err = pcall(function()
        response:andThen(function(accepted)
            if not self.Running or not self.AutoRespawn or token ~= self.RespawnToken then return end
            self.RespawnRequestBusy = false
            if accepted == true then
                self.RespawnStatus = "Accepted / loading character"
                self.RespawnNextAt = os.clock() + 4
            else
                self.RespawnStatus = "Server did not approve respawn"
                self.RespawnNextAt = os.clock() + 2
            end
        end):catch(function(reason)
            if not self.Running or not self.AutoRespawn or token ~= self.RespawnToken then return end
            self.RespawnRequestBusy = false
            self.RespawnLastError = tostring(reason)
            self.RespawnStatus = "Respawn denied / retrying"
            self.RespawnNextAt = os.clock() + 2
        end)
    end)
    if not attached then
        self.RespawnRequestBusy = false
        self.RespawnLastError = tostring(err)
        self.RespawnStatus = "Respawn response unavailable"
        self.RespawnNextAt = now + 2
    end
end

function Hub:InstallAutoRespawn()
    if self.RespawnWorkerInstalled then return end
    self.RespawnWorkerInstalled = true
    task.spawn(function()
        while self.Running do
            if self.AutoRespawn then
                local ok, err = pcall(function() self:AutoRespawnTick() end)
                if not ok then
                    self.RespawnStatus = "Respawn watcher error"
                    self.RespawnLastError = tostring(err)
                end
            end
            task.wait(self.AutoRespawn and 0.16 or 0.55)
        end
    end)
end

