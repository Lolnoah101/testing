local SKILL_KEYS = {
    Enum.KeyCode.Z,
    Enum.KeyCode.X,
    Enum.KeyCode.C,
    Enum.KeyCode.V,
}

local function handleLegitIdling(now)
    -- Never leave a stale virtual click held while the FishingController
    -- remains Idling. A fresh rod cast needs a fresh MouseButton1 down.
    if State.MouseHeld then
        if now - State.LastCastStarted
            >= 0.30 then

            mouseUp()
            State.LastCastStarted =
                now
        end

        return
    end

    if now - State.LastCastStarted
        < Config.RecastDelay then
        return
    end

    if not hasHeldRodTool() then
        mouseUp()
        return
    end

    orientLegitTowardWater()

    mouseDown()
    State.LastCastStarted = now
end

local function handleLegitHolding()
    mouseDown()
end

local function handleLegitThrowing(now)
    mouseDown()

    local stateAge = now - State.StateEnteredAt
    local luck = 0

    if FishingController then
        pcall(function()
            luck = tonumber(FishingController:GetLuckBarValue()) or 0
        end)
    end

    local shouldRelease
    if not Config.PerfectCast then
        shouldRelease = stateAge >= 0.35
    else
        shouldRelease = luck >= Config.CastThreshold or stateAge >= Config.CastFallbackSeconds
    end

    if shouldRelease then
        mouseUp()
    end
end

local function handleLegitFirstPull(now)
    mouseUp()

    if now - State.LastPrimaryClick < 0.12 then
        return
    end

    local stateAge = now - State.StateEnteredAt
    local pull = 0

    if FishingController then
        pcall(function()
            pull = tonumber(FishingController:GetPullBarValue()) or 0
        end)
    end

    local shouldPull
    if not Config.PerfectFirstPull then
        shouldPull = stateAge >= 0.45
    else
        shouldPull = pull >= Config.FirstPullThreshold
            or stateAge >= Config.FirstPullFallbackSeconds
    end

    if shouldPull then
        primaryClick()
    end
end

local function handleLegitReeling(now)
    mouseUp()

    local qteActive = now < State.QTEActiveUntil

    local holdForQuestFinisher = questFinisherHoldActive()

    if not qteActive
        and not holdForQuestFinisher
        and now >= State.NextReelAt then

        primaryClick()
        State.NextReelAt = now + (1 / math.clamp(Config.ReelCPS, 0.5, 5.8))
    end

    if Config.AutoSkills
        and not qteActive
        and now >= State.NextSkillAt then

        local attempted =
            false

        if State.QuestForcedSkillSlot then
            local slotName,
                skillId =
                getSkillForSlot(
                    State.QuestForcedSkillSlot
                )

            if skillId
                == State.QuestForcedSkillId
                and not isSkillOnCooldown(
                    slotName
                ) then

                attempted =
                    tryUseLegitSkill(
                        State.QuestForcedSkillSlot
                    )
            end

        elseif Config.SkillRotationMode
            == "Strongest Ready" then

            local bestIndex =
                getBestReadySkillSlot()

            if bestIndex then
                attempted =
                    tryUseLegitSkill(
                        bestIndex
                    )
            end

            -- If cooldown replication briefly made the "best" lookup stale,
            -- check the remaining slots immediately instead of waiting.
            if not attempted then
                for index = 1, 4 do
                    if index ~= bestIndex
                        and tryUseLegitSkill(
                            index
                        ) then

                        attempted = true
                        break
                    end
                end
            end

        else
            local index =
                State.SkillIndex

            attempted =
                tryUseLegitSkill(
                    index
                )

            State.SkillIndex =
                index % #SKILL_KEYS + 1
        end

        State.NextSkillAt =
            now
            + (
                attempted
                and math.max(
                    0.35,
                    Config.SkillInterval
                )
                or 0.10
            )
    end
end

local function handleLegitCaught(now)
    mouseUp()

    if not Config.AutoConfirmLoot or now < State.NextLootClickAt then
        return
    end

    primaryClick()
    State.NextLootClickAt = now + Config.LootRetryDelay
end

local function stepLegit()
    if not FishingController then
        State.LegitBlockReason =
            "FishingController unavailable"
        return
    end

    local now = os.clock()

    local swimming =
        type(Systems.isCharacterSwimming) == "function"
        and Systems.isCharacterSwimming()
        or false

    if swimming then

        mouseUp()

        State.LegitBlockReason =
            "Swimming; recovering to nearby land"

        if type(
            Systems.recoverLegitToNearbyLand
        ) == "function"
            and not State.LegitLandRecoveryBusy
            and now >= State.LegitLandRecoveryAt then

            Systems.recoverLegitToNearbyLand()
        end

        return
    end

    if not hasHeldRodTool() then
        mouseUp()
        State.WaitingForManualRod = true
        State.RodWatchStatus =
            "Waiting for equipped rod"
        State.LegitBlockReason =
            "Waiting for equipped rod"
        return
    end

    local hasSkillLoadout =
        type(
            Systems.hasAnySkillEquippedOnSelectedRod
        ) ~= "function"
        or Systems.hasAnySkillEquippedOnSelectedRod()

    if not hasSkillLoadout then
        mouseUp()

        State.LegitBlockReason =
            Config.AutoEquipBestSkills
            and "Waiting for a skill loadout"
            or "Legit fishing needs at least one equipped skill"

        return
    end

    if now < State.LegitResumeAt then
        mouseUp()
        State.LegitBlockReason =
            "Waiting for fishing state to settle"
        return
    end

    State.LegitBlockReason = "Ready"
    local fishingState = getFishingState()
    updateFishingState(fishingState)

    if fishingState == FState.Idling then
        handleLegitIdling(now)
    elseif fishingState == FState.Holding then
        handleLegitHolding()
    elseif fishingState == FState.Throwing then
        handleLegitThrowing(now)
    elseif fishingState == FState.Waiting then
        mouseUp()
    elseif fishingState == FState.FirstPull then
        handleLegitFirstPull(now)
    elseif fishingState == FState.Reeling then
        handleLegitReeling(now)
    elseif fishingState == FState.Caught then
        handleLegitCaught(now)
    else
        mouseUp()
    end
end

