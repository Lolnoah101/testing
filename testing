-- Full recipe requirement check against the replicated selected-slot inventory.
function Hub:V67InventoryCountByName()
    local counts={}
    local P=self.Progression
    local data=self:V44Data()
    local inventory=data and data:FindFirstChild("Inventory")
    local items=P and P.itemList and P.itemList()
    if not inventory or not items then return nil end
    for _,node in ipairs(inventory:GetChildren()) do
        local info=P.itemInfo(node:GetAttribute("item_id"),items)
        if type(info)=="table" and type(info.ItemName)=="string" then
            local quantity=math.max(0,tonumber(node:GetAttribute("quantity")) or 0)
            counts[info.ItemName]=(counts[info.ItemName] or 0)+quantity
        end
    end
    return counts
end
function Hub:V67Missing(recipe)
    local module=ReplicatedStorage.Shared.Data:FindFirstChild("CraftingData")
    local ok,recipes=pcall(function() return module and require(module) end)
    if not ok or type(recipes)~="table" or type(recipes[recipe])~="table" then
        return nil,nil,"Recipe not found"
    end
    local amounts=self:V67InventoryCountByName()
    if not amounts then return nil,nil,"Inventory not replicated" end
    local required=recipes[recipe]
    local missing={}
    for name,detail in pairs(required) do
        local count=math.max(1,math.floor(tonumber(detail.quantity) or 1))
        local owned=amounts[name] or 0
        if owned<count then
            table.insert(missing,{Name=name,Need=count,Have=owned,Missing=count-owned})
        end
    end
    table.sort(missing,function(a,b) return a.Name<b.Name end)
    return missing,required,nil
end
function Hub:V67MaterialSource(name)
    local ore={ ["Lime Stone"]=true,["Refined Stone"]=true,Aluminium=true,
        Iron=true,Gold=true,Ruby=true,["Nen Crystal"]=true }
    if ore[name] then return "Mine",name,100 end
    local ok,npcs=pcall(function() return require(ReplicatedStorage.NpcDataLibrary) end)
    if not ok or type(npcs)~="table" then return nil,nil,0 end
    local best,bestScore=nil,-math.huge
    for npc,info in pairs(npcs) do
        if type(npc)=="string" and type(info)=="table" then
            local drop=type(info.Drops)=="table" and tonumber(info.Drops[name])
            local score=drop or -math.huge
            if type(info.DropGroups)=="table" then
                for _,group in pairs(info.DropGroups) do
                    if type(group)=="table" and type(group.Items)=="table" then
                        for _,item in pairs(group.Items) do
                            if item==name then score=math.max(score,tonumber(group.Chance) or 1) end
                        end
                    end
                end
            end
            if score>bestScore then best,bestScore=npc,score end
        end
    end
    if best then return "Mob",best,bestScore end
    return nil,nil,0
end
function Hub:V67StopMaterialFarm()
    local E=self.V44
    if E.MaterialSaved then
        local old=E.MaterialSaved
        self.AutoFarm=old.Farm
        self.BossSelection=old.Boss
        self.MobSelection=old.Mob
        self.MobSelections=old.Mobs
        E.AutoMine=old.Mine
        E.MineOre=old.Ore
    end
    E.MaterialFarmName=nil;E.MaterialFarmMode=nil;E.MaterialSaved=nil
end
function Hub:V67FarmMissing(missing)
    local E=self.V44
    if not E.AutoFarmRequiredMaterials then
        self:V67StopMaterialFarm()
        return false
    end
    local mode,target,score
    for _,item in ipairs(missing) do
        local kind,source,value=self:V67MaterialSource(item.Name)
        if kind and (not score or value>score) then
            mode,target,score=kind,source,value
        end
    end
    if not mode then
        self:V67StopMaterialFarm()
        E.CraftStatus="Missing material has no verified farm source: "..missing[1].Name
        return false
    end
    if E.MaterialFarmName==target and E.MaterialFarmMode==mode then return true end
    if not E.MaterialSaved then
        local selection={}
        for k,v in pairs(self.MobSelections or {}) do selection[k]=v end
        E.MaterialSaved={Farm=self.AutoFarm,Boss=self.BossSelection,
            Mob=self.MobSelection,Mobs=selection,Mine=E.AutoMine,Ore=E.MineOre}
    end
    -- Release previous sub-job while keeping its original settings for restoration.
    self.AutoFarm=false;E.AutoMine=false
    if mode=="Mine" then
        E.MineOre=target
        E.MineAt=0;E.MineNodeNext=0;E.MineTarget=nil
        E.AutoMine=true
        E.CraftStatus="Farming required ore: "..target
    else
        self.BossSelection=(BossSet[target] or AllLibraryBosses[target]) and target or "None"
        self.MobSelection=target
        self.MobSelections={[target]=true}
        self.FarmTarget=nil;self.FarmNextSearch=0
        self.AutoFarm=true
        E.CraftStatus="Farming material drops from "..target
    end
    E.MaterialFarmName=target;E.MaterialFarmMode=mode
    return true
end
-- Mirrors native CraftingController: each slot gets the matching inventory UUID,
-- quantity and name, then the real CraftingService receives the forge request.
-- When the crafting GUI is unavailable, use the game's own QuickCraft pathway.
function Hub:V67SetCraftSlots(requirements)
    local pg=LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local main=pg and pg:FindFirstChild("Main")
    local gui=main and main:FindFirstChild("Crafting")
    local slotFolder=gui and gui:FindFirstChild("Items")
    if not slotFolder then return false end
    local P=self.Progression
    local data=self:V44Data();local inventory=data and data:FindFirstChild("Inventory")
    local itemList=P and P.itemList and P.itemList()
    if not inventory or not itemList then return false end
    for name,detail in pairs(requirements) do
        local slot=slotFolder:FindFirstChild("Item"..tostring(detail.slot))
        if not slot then return false end
        local matched
        for _,item in ipairs(inventory:GetChildren()) do
            local info=P.itemInfo(item:GetAttribute("item_id"),itemList)
            if type(info)=="table" and info.ItemName==name
                and (tonumber(item:GetAttribute("quantity")) or 0)>= (detail.quantity or 1) then
                matched=item;break
            end
        end
        if not matched then return false end
        slot:SetAttribute("item_name",name)
        slot:SetAttribute("item_uuid",matched.Name)
        slot:SetAttribute("item_quantity",detail.quantity or 1)
        if slot:IsA("TextLabel") then slot.Text=name.." ("..(detail.quantity or 1).."x)" end
    end
    return gui.Visible==true
end
