-- Observe the game's own combat-decision feedback; these counters are
-- acknowledgements, not evidence that an NPC lost health.
function Hub:InstallCombatNetFeedback()
    if not CombatV2 then return end
    task.spawn(function()
        local folder=ReplicatedStorage:WaitForChild("CombatNet",12)
        if not folder or not self.Running then
            self.CombatDecision="CombatNet remotes not replicated"
            return
        end
        local decision=folder:FindFirstChild("Decision") or folder:WaitForChild("Decision",5)
        if not decision or not decision:IsA("RemoteEvent") then
            self.CombatDecision="CombatNet.Decision unavailable"
            return
        end
        table.insert(self.Connections,decision.OnClientEvent:Connect(function(id,accepted,reason)
            if not self.Running then return end
            if accepted==true then
                self.CombatAccepted+=1
                self.CombatDecision="Request "..tostring(id).." accepted"
            elseif accepted==false then
                self.CombatRejected+=1
                self.CombatDecision="Rejected #"..tostring(id)..": "..tostring(reason or "unknown")
                self.FarmLastM1Gate=self.CombatDecision
            end
        end))
        self.CombatDecision="CombatNet decision listener ready"
    end)
end
