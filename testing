-- Dracolith is AutoSpawn=false. The game requires a Dracolith Stone at an altar.
-- We do not fake a stone, invent a server remote, or spam the summon input.
local DRACOLITH_ALTAR = Vector3.new(-27,401,-2885)
function Hub.QuestFns.inventoryHasDracolithStone()
    -- Inventory schemas differ across versions. Only a POSITIVE match is
    -- conclusive; nil means the inventory was not readable, not "missing".
    local function contains(value,depth,seen)
        if depth>5 or type(value)~="table" or seen[value] then return false end
        seen[value]=true
        for k,item in pairs(value) do
            local name=type(k)=="string" and k:lower() or ""
            if name=="dracolith stone" or name=="dracolithstone" then
                if type(item)=="number" then return item>0 end
                if type(item)=="boolean" then return item end
                if type(item)=="table" then
                    local n=item.Amount or item.Count or item.Quantity or item.Stack or item.amount
                    if n~=nil then return tonumber(n)~=nil and tonumber(n)>0 end
                    return true
                end
                return item~=nil
            end
            if type(item)=="table" then
                local itemName=item.ItemName or item.Name or item.Id
                if type(itemName)=="string" and itemName:lower()=="dracolith stone" then
                    local n=item.Amount or item.Count or item.Quantity or item.Stack
                    return n==nil or (tonumber(n) or 0)>0
                end
                if contains(item,depth+1,seen) then return true end
            end
        end
        return false
    end
    for _,key in ipairs({"Inventory","Items","Materials","Backpack"}) do
        local value=Hub.QuestFns.questPlayerData(key)
        if type(value)=="table" and contains(value,0,{}) then return true end
    end
    return nil
end
function Hub.QuestFns.dracolithErrorOnScreen()
    local gui=LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return false end
    for _,obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local label=tostring(obj.Text or ""):lower()
            if label:find("dracolith stone",1,true)
                and (label:find("need",1,true) or label:find("require",1,true)) then
                return true
            end
        end
    end
    return false
end
function Hub.QuestFns.findDracolithPrompt()
    local overlap=OverlapParams.new()
    overlap.FilterType=Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances={LocalPlayer.Character}
    -- The saved place did not include the runtime-only T-to-Summon prompt;
    -- search only currently streamed altar-area geometry when nearby.
    local parts=workspace:GetPartBoundsInRadius(DRACOLITH_ALTAR,36,overlap)
    local best,closest=nil,math.huge
    local function candidate(prompt)
        if not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return end
        local action=(tostring(prompt.ActionText).." "..tostring(prompt.ObjectText)):lower()
        if not action:find("summon",1,true) and not action:find("dracol",1,true) then return end
        local part=prompt.Parent
        local spot=part and (part:IsA("Attachment") and part.WorldPosition
            or (part:IsA("BasePart") and part.Position))
        if not spot or typeof(spot)~="Vector3" then return end
        local distance=(spot-DRACOLITH_ALTAR).Magnitude
        if distance<36 and distance<closest then best,closest=prompt,distance end
    end
    for _,part in ipairs(parts) do
        for _,item in ipairs(part:GetDescendants()) do candidate(item) end
    end
    return best
end
function Hub.QuestFns.dracolithSummonStep()
    if not Hub.AutoSummonDracolith or not Hub.Running then return end
    local wantBoss=Hub.AutoFarm and not Hub.AutoQuest and Hub.BossSelection=="Dracolith"
    local questBoss=Hub.AutoQuest and Hub.QuestSelectedId=="KillDrakolith"
        and Hub.QuestCombatActive
    if not (wantBoss or questBoss) then
        Hub.DracolithSummonStatus="Waiting for Dracolith boss / quest selection"
        return
    end
    local _,root=myCharacter()
    if not root then return end
    -- Confirm whether a living Dracolith is already present, no input needed.
    for _,record in pairs(Hub.Observed) do
        if activeNpcRecord(record) and selectionMatches(record,"Dracolith") then
            Hub.DracolithSummonStatus="Dracolith alive: pursuing boss"
            return
        end
    end
    local distance=(root.Position-DRACOLITH_ALTAR).Magnitude
    if distance>32 then
        Hub.DracolithSummonStatus=string.format("Travel to altar: %d studs",distance)
        if wantBoss then
            Hub.FarmAreaGoal=DRACOLITH_ALTAR
            Hub.FarmAreaName="Dracolith"
        end
        if type(Hub.RequestAreaStreaming)=="function" then
            Hub:RequestAreaStreaming(DRACOLITH_ALTAR,"Dracolith altar")
        end
        return
    end
    if Hub.QuestFns.dracolithErrorOnScreen() then
        Hub.DracolithSummonStatus="Needs a Dracolith Stone (game rejected summon)"
        Hub.DracolithLastAttempt=os.clock()
        return
    end
    local now=os.clock()
    if now-Hub.DracolithLastAttempt<28 then return end
    local prompt=Hub.QuestFns.findDracolithPrompt()
    if not prompt then
        Hub.DracolithSummonStatus="At altar; real Summon prompt not streamed"
        return
    end

    local spot=prompt.Parent
    local promptPos=spot and (spot:IsA("Attachment") and spot.WorldPosition
        or (spot:IsA("BasePart") and spot.Position))
    if not promptPos or (root.Position-promptPos).Magnitude
        > math.max(8,prompt.MaxActivationDistance+1) then
        Hub.DracolithSummonStatus="Moving closer to Dracolith summon prompt"
        return
    end
    Hub.DracolithLastAttempt=now
    local owned=Hub.QuestFns.inventoryHasDracolithStone()
    Hub.DracolithSummonStatus=owned and "Using Dracolith summon prompt"
        or "Trying altar once; stone required if game rejects it"
    -- Only interact with a real, in-range ProximityPrompt. Use the original
    -- prompt hold behavior rather than assuming a valid Knit method name.
    local ok,err=pcall(function()
        if type(fireproximityprompt)=="function" then
            fireproximityprompt(prompt, math.max(.2,prompt.HoldDuration))
        else
            prompt:InputHoldBegin()
            task.delay(math.max(.1,prompt.HoldDuration)+.15,function()
                if prompt and prompt.Parent then pcall(function() prompt:InputHoldEnd() end) end
            end)
        end
    end)
    if not ok then
