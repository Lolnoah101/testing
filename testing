    return type(close) == "number" and close or nil
end
function halloweenFlow.formatGateWait(timestamp)
    local seconds = (type(timestamp) == "number")
        and math.max(0, math.ceil(timestamp - Workspace:GetServerTimeNow())) or nil
    if not seconds then return "awaiting schedule" end
    if seconds >= 3600 then
        return string.format("%dh %02dm", math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
    end
    return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- Actual event gate with server-published event ID and open state.
EventState.halloweenGate = function()
    local gates = Workspace:FindFirstChild("Gates")
    if not gates then return nil end
    local emptyGate = nil
    for _, gate in ipairs(gates:GetChildren()) do
        if gate:IsA("Model") and gate:GetAttribute("EventId") == EventState.HalloweenEvent.Id
            and gate:GetAttribute("State") == "Open" then
            local ownerId = gate:GetAttribute("OwnerId")
            local spawnedBy = gate:GetAttribute("SpawnerId")
            if ownerId == LocalPlayer.UserId then return gate end
            -- Event gates are generated by the server, unlike normal dungeon
            -- gates. Only try to BECOME the leader of a genuinely empty one.
            if ownerId == nil and (tonumber(gate:GetAttribute("Queued")) or 0) == 0
                and (spawnedBy == nil or spawnedBy == LocalPlayer.UserId) then
                emptyGate = emptyGate or gate
            end
        end
    end
    return emptyGate
end

function halloweenFlow.watchCompletion(raid)
    if not (raid and EventState.isHalloweenRaid(raid)
        and raid:GetAttribute("State") == "Cleared") then return end
    if halloweenFlow.seenClearedRaid == raid then return end
    halloweenFlow.seenClearedRaid = raid
    halloweenFlow.completedRound = {
        closeAt = halloweenFlow.gateCloseAt(),
        gate = EventState.halloweenGate(),
        nextAt = Workspace:GetAttribute("NextEventAt"),
    }
end

-- The server's GateRefused == "Cleared" is the authoritative block.
-- Also use a local fallback to avoid racing back to the queue just as
-- the prior raid finishes and the server is still setting its attributes.
function halloweenFlow.reentryBlocked(gate)
    local refusal = LocalPlayer:GetAttribute("GateRefused")
    if refusal == "Cleared" then return true, "Cleared this opening" end
    if refusal == "Closed" then return true, "Entry is closed" end
    if refusal == "Tutorial" then return true, "Finish tutorial first" end
    if refusal == "Loading" then return true, "Waiting for game data" end

    if not halloweenFlow.completedRound then return false, nil end
    local prior = halloweenFlow.completedRound
    local closeAt = halloweenFlow.gateCloseAt()
    local newerWindow = closeAt and prior.closeAt and closeAt > prior.closeAt + 1
    local differentGate = gate and prior.gate and gate ~= prior.gate
    local nextOpeningReached = gate and type(prior.nextAt) == "number"
        and Workspace:GetServerTimeNow() >= prior.nextAt
    if newerWindow or differentGate or nextOpeningReached then
        halloweenFlow.completedRound = nil
        return false, nil
    end
    return true, "Completed this gate opening"
end

-- Used by the regular dungeon join scheduler: let normal dungeon queues
-- work while the Halloween gate is unavailable or its entry is locked.
EventState.halloweenJoinEligible = function()
    if not enabled.JoinHalloween then return false end
    local gate = EventState.halloweenGate()
    if not gate then return false end
    -- Never interrupt normal dungeon farming for a Halloween queue owned
    -- by another hunter. Only our queue or an empty gate takes priority.
    local ownerId = gate:GetAttribute("OwnerId")
    local queued = tonumber(gate:GetAttribute("Queued")) or 0
    if ownerId ~= LocalPlayer.UserId and (ownerId ~= nil or queued > 0) then
        return false
    end
    local blocked = halloweenFlow.reentryBlocked(gate)
    return not blocked
end

local function tickHalloweenJoin()
    if not enabled.JoinHalloween then
        eventJoinState = "Auto Join disabled"
        return
    end
    local raid = currentRaid()
    halloweenFlow.watchCompletion(raid)
    if isInRaid() or moneyWalkBusy or LocalPlayer:GetAttribute("Traveling")
        or SkillState.Cinematic then
        eventJoinState = isInRaid() and "Inside a dungeon" or "Busy / traveling"
        return
    end

    -- If another player took the queue while we approached, leave it even
    -- when the empty/owned gate lookup now returns nil.
    local queuedName = LocalPlayer:GetAttribute("GateQueue")
    if queuedName ~= nil then
        local allGates = Workspace:FindFirstChild("Gates")
        local queuedGate = allGates and allGates:FindFirstChild(tostring(queuedName))
        if queuedGate and queuedGate:GetAttribute("EventId") == EventState.HalloweenEvent.Id then
            local leaderId = queuedGate:GetAttribute("OwnerId")
            if leaderId ~= nil and leaderId ~= LocalPlayer.UserId then
                Scheduler.stepOffForeignQueue(queuedGate)
                eventJoinState = "Another hunter became event leader · Leaving queue"
                return
            end
        end
    end

    local gate = EventState.halloweenGate()
    local blocked, blockedReason = halloweenFlow.reentryBlocked(gate)
    if blocked then
        if blockedReason == "Cleared this opening" or blockedReason == "Completed this gate opening" then
            eventJoinState = blockedReason .. " · Next: "
                .. halloweenFlow.formatGateWait(Workspace:GetAttribute("NextEventAt"))
        else
            eventJoinState = blockedReason
        end
        return
    end
    if not gate then
        local gates = Workspace:FindFirstChild("Gates")
        local otherQueue = false
        if gates then
            for _, candidate in ipairs(gates:GetChildren()) do
                if candidate:IsA("Model") and candidate:GetAttribute("State") == "Open"
                    and candidate:GetAttribute("EventId") == EventState.HalloweenEvent.Id then
                    otherQueue = true
                    break
                end
            end
        end
        if otherQueue then
            eventJoinState = "Another hunter leads the event · Waiting for your own queue"
        elseif type(Workspace:GetAttribute("NextEventAt")) == "number" then
            eventJoinState = "Waiting for next opening: "
                .. halloweenFlow.formatGateWait(Workspace:GetAttribute("NextEventAt"))
        else
            eventJoinState = "Event gate not available"
        end
        return
    end

    local queue = LocalPlayer:GetAttribute("GateQueue")
    if queue == gate.Name then
        if gate:GetAttribute("State") == "Launching" then
            eventJoinState = "Halloween gate launching"
            return
        end
        local leaderId = gate:GetAttribute("OwnerId")
        if leaderId == LocalPlayer.UserId then
            if os.clock() - halloweenFlow.lastGateStart >= 4 then
                halloweenFlow.lastGateStart = os.clock()
                attempt("HalloweenStart:" .. gate.Name, 4, function()
                    GateStart:FireServer()
                end)
            end
            eventJoinState = "Queue leader · Sending START request"
        else
            -- A race can happen if another hunter became leader while we
            -- moved onto the pad. Leave instead of farming their event.
            Scheduler.stepOffForeignQueue(gate)
            eventJoinState = "Lost leadership · Leaving another player's event queue"
        end
        return
    end
    if queue ~= nil then
        eventJoinState = "Already queued at another gate · Will not join"
        return
    end

    local leaderId = gate:GetAttribute("OwnerId")
    local queued = tonumber(gate:GetAttribute("Queued")) or 0
    if leaderId ~= LocalPlayer.UserId and (leaderId ~= nil or queued > 0) then
        eventJoinState = "Another hunter owns this event queue · Skipping"
        return
    end
    local pad = gate:FindFirstChild("QueuePad", true)
    if not (pad and pad:IsA("BasePart")) then
        eventJoinState = "Waiting for Halloween queue pad"
        return
    end
    local character, root = getCharacter()
    if not character or not root then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    -- Match the game's PortalPromptController's standing height, so the
    -- player actually contacts the queue area rather than floating above it.
    local standingY = pad.Size.Y / 2
        + (humanoid and humanoid.HipHeight or 2) + root.Size.Y / 2
    local desired = pad.Position + Vector3.new(0, standingY, 0)
    if os.clock() - eventLastJoinMove >= 0.8 then
        eventLastJoinMove = os.clock()
        if (root.Position - desired).Magnitude > 2.5 then
            root.AssemblyLinearVelocity = Vector3.zero
            character:PivotTo(CFrame.new(desired))
        end
    end
    eventJoinState = "Standing on Halloween queue pad · Waiting to queue"
end

local function halloweenLanternGoal(raid)
    if not EventState.isHalloweenRaid(raid) then return nil end
    local _, root = getCharacter()
    if not root then return nil end
    local chosenId, chosenPos, nearest = nil, nil, math.huge
    local notReady = 0
    for key, value in pairs(raid:GetAttributes()) do
        local id = type(key) == "string" and key:match("^LanternGoal_(.+)$")
        if id and typeof(value) == "Vector3" then
            local state = raid:GetAttribute("LanternState_" .. id)
            if state == "Ready" then
                local distance = (root.Position - value).Magnitude
                if distance < nearest then
                    nearest, chosenId, chosenPos = distance, id, value
                end
            elseif state ~= "Lit" then
                notReady = notReady + 1
            end
        end
    end
    return chosenId, chosenPos, nearest, notReady
end

local function findLanternPrompt(raid, id, goal)
    local geometry = raid:FindFirstChild("Geometry")
    if geometry then
        for _, object in ipairs(geometry:GetDescendants()) do
            if object.Name == "Lantern_" .. tostring(id) then
                if object:IsA("ProximityPrompt") then return object end
                local prompt = object:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then return prompt end
            end
        end
    end
    -- Some event builds put the interaction prompt in a separate model.
    -- Search only actual lantern/light prompts near the server's goal marker.
    for _, object in ipairs(raid:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            local label = (tostring(object.Name) .. " "
                .. tostring(object.ActionText) .. " " .. tostring(object.ObjectText)):lower()
            if label:find("lantern", 1, true) or label:find("light", 1, true) then
                local anchor = object.Parent
                local part = anchor and (anchor:IsA("BasePart") and anchor
                    or anchor:IsA("Attachment") and anchor.Parent)
                if part and part:IsA("BasePart")
                    and (part.Position - goal).Magnitude < 20 then
                    return object
                end
            end
        end
    end
    return nil
end

local function tickHalloweenLanterns(raid)
    if not enabled.LightLanterns or not EventState.isHalloweenRaid(raid) then
        EventState.eventGoalRaid, EventState.eventGoalPosition, EventState.eventGoalId = nil, nil, nil
        return
    end
    local id, goal, distance, guarded = halloweenLanternGoal(raid)
    if not id then
        EventState.eventGoalRaid, EventState.eventGoalPosition, EventState.eventGoalId = nil, nil, nil
        eventLanternState = (guarded or 0) > 0 and "Lanterns guarded: defeat enemies first"
            or "No unlit READY lanterns"
        return
    end
    EventState.eventGoalRaid, EventState.eventGoalPosition, EventState.eventGoalId = raid, goal, id
    if distance > math.max(4, (EventState.HalloweenEvent.Lanterns.Distance or 12) - 3) then
        eventLanternState = "Approaching lantern " .. id .. " (" .. math.floor(distance) .. " studs)"
        -- The existing Heartbeat farm controller follows this goal.
        if not farmHeartbeatConnection then
            farmHeartbeatConnection = RunService.Heartbeat:Connect(farmHeartbeat)
        end
        return
    end
    eventLanternState = "At lantern " .. id .. ": checking prompt"
    local prompt = findLanternPrompt(raid, id, goal)
    if prompt and prompt.Enabled and not eventPromptBusy
        and os.clock() - eventLastLanternPrompt >= 2.5 then
        eventLastLanternPrompt = os.clock()
        eventPromptBusy = true
        task.spawn(function()
            local ok, err = pcall(function()
                if type(fireproximityprompt) == "function" then
                    fireproximityprompt(prompt, (prompt.HoldDuration or 0) + 0.1)
                else
                    prompt:InputHoldBegin()
                    task.wait((prompt.HoldDuration or 0) + 0.1)
                    prompt:InputHoldEnd()
                end
            end)
            if not ok then warn("[Arise v15] Lantern prompt:", err) end
            eventPromptBusy = false
        end)
        eventLanternState = "Lighting lantern " .. id
    elseif not prompt then
        eventLanternState = "At lantern " .. id .. ": no prompt replicated; manual interaction may be required"
    end
end

local function tickHalloweenPass()
    if not enabled.ClaimHalloweenPass then return end
    local data = dataNow()
    if not data then eventPassState = "Waiting for player data"; return end
    if Workspace:GetServerTimeNow() >= EventState.HalloweenEvent.ClaimUntil then
        eventPassState = "Event rewards claim period ended"
        return
    end
    local ok, claims = pcall(EventState.EventPass.claimable, data, EventState.HalloweenEvent)
    if not ok or type(claims) ~= "table" then
        eventPassState = "Unable to read claimable pass rewards"
        return
    end
    if #claims == 0 then
        eventPassState = "All unlocked Halloween pass rewards claimed"
        return
    end
    eventPassState = tostring(#claims) .. " pass rewards ready"
    if os.clock() - eventLastPassRequest >= 8 then
        eventLastPassRequest = os.clock()
        local sent, err = pcall(function()
            EventState.EventRequest:FireServer("ClaimAll", EventState.HalloweenEvent.Id, nil)
        end)
        if not sent then eventPassState = "ClaimAll request error: " .. tostring(err) end
    end
end

-- Halloween Exchange is *not* a premium purchase. The game's Exchange UI
-- calls Events.Request:FireServer("Buy", eventId, offerId) and the server
-- validates Candy and per-offer purchase limits. Never use Robux paths.
do
    local exchangeFlow = {
        nextRequest = 0, cursor = 1, lastSent = nil,
        sent = 0,
    }
    local function tickHalloweenExchange()
        if not enabled.AutoExchange then
            EventState.setExchangeStatus("Disabled · No Halloween Candy will be spent")
            return
        end
        local selected = EventState.exchangeSelected or {}
        if next(selected) == nil then
            EventState.setExchangeStatus("Choose at least one Exchange item above")
            return
        end
        local event = EventState.HalloweenEvent
        if Workspace:GetServerTimeNow() >= event.ClaimUntil then
            EventState.setExchangeStatus("Halloween Exchange claim period has ended")
            return
        end
        local data = dataNow()
        if not data or type(data.events) ~= "table"
            or type(data.events[event.Id]) ~= "table" then
            EventState.setExchangeStatus("Waiting for Halloween event inventory data")
            return
        end
        local record = EventState.EventPass.record(data, event)
        local offers = event.Exchange
        local remainingSelected, affordableSelected = 0, 0
        local lines = {
            string.format("Candy: %d | Requests sent: %d", math.floor(record.candy), exchangeFlow.sent),
        }
        local chosen = 0
        for _, offer in ipairs(offers) do
            if selected[offer.Id] then
                chosen += 1
                local owned = tonumber(record.exchange[offer.Id]) or 0
                local left = math.max(0, offer.Limit - owned)
                if left > 0 then
                    remainingSelected += 1
                    if record.candy >= offer.Price then affordableSelected += 1 end
                end
                table.insert(lines, string.format("%s: %d/%d · %d Candy",
                    offer.Id, owned, offer.Limit, offer.Price))
            end
        end
        if chosen == 0 then
            EventState.setExchangeStatus("Selected item names do not match any current offers")
            return
        end
        if remainingSelected == 0 then
            table.insert(lines, "All selected offers SOLD OUT")
        elseif affordableSelected == 0 then
            table.insert(lines, "Waiting for enough Halloween Candy")
        elseif os.clock() < exchangeFlow.nextRequest then
            table.insert(lines, "Waiting for purchase confirmation / request cooldown")
        else
            -- Round-robin keeps multiple selected items from starving one
            -- another when limited Candy arrives after each dungeon clear.
            for step = 0, #offers - 1 do
                local i = ((exchangeFlow.cursor + step - 1) % #offers) + 1
                local offer = offers[i]
                if selected[offer.Id] then
                    local purchasable = EventState.EventPass.canBuy(event, record, offer.Id)
                    if purchasable then
                        exchangeFlow.cursor = i % #offers + 1
                        exchangeFlow.nextRequest = os.clock() + 2.5
                        local ok, err = pcall(function()
                            EventState.EventRequest:FireServer("Buy", event.Id, offer.Id)
                        end)
                        if ok then
                            exchangeFlow.sent += 1
                            exchangeFlow.lastSent = offer.Id
                            table.insert(lines, "Requested: " .. offer.Id .. " (server confirmation pending)")
                        else
                            table.insert(lines, "Exchange request failed: " .. tostring(err))
                        end
                        break
                    end
                end
            end
        end
        EventState.setExchangeStatus(table.concat(lines, "\n"))
    end
    Scheduler.add("HalloweenExchange", 0.7, tickHalloweenExchange)
end

local function updateHalloweenStatus()
    local now = Workspace:GetServerTimeNow()
    local close = Workspace:GetAttribute("EventGateClosesAt")
        or Workspace:GetAttribute("EventGateOpenUntil")
    local nextAt = Workspace:GetAttribute("NextEventAt")
    local timeText = "Gate: Closed / waiting for schedule"
    if EventState.halloweenGate() and type(close) == "number" then
        timeText = "Gate: OPEN (" .. math.max(0, math.ceil(close - now)) .. "s left)"
    elseif type(nextAt) == "number" then
        timeText = "Next gate: " .. math.max(0, math.ceil(nextAt - now)) .. "s"
    end
    local raid = currentRaid()
    local phase = EventState.isHalloweenRaid(raid) and tostring(raid:GetAttribute("PhaseId")) or "Outside event raid"
    local status = table.concat({
        "Hollowmoon Harvest | " .. timeText,
        "Gate: " .. eventJoinState,
        "Raid phase: " .. phase,
        "Lanterns: " .. eventLanternState,
        "Pass: " .. eventPassState,
    }, "\n")
    EventState.setEventStatus(status)
end

Scheduler.add("Halloween", 0.28, function()
    local raid = currentRaid()
    halloweenFlow.watchCompletion(raid)
    tickHalloweenLanterns(raid)
    tickHalloweenJoin()
    tickHalloweenPass()
    updateHalloweenStatus()
end)

