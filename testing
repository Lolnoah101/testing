-- The RankUp remote is accepted by the server only after the required
-- NPC interaction. Each island has its own Elder NPC + NPCPrompt.
local rankWorkflow = "Monitoring requirements"
local rankNextPromptAt = 0
local rankPromptBusy = false
local rankMoveGoal = nil
local rankNextMoveAt = 0

local function finishRankApproach()
    Aux.rankApproachActive = false
    rankMoveGoal = nil
    if Aux.rankMoveTween then
        pcall(function() Aux.rankMoveTween:Cancel() end)
        Aux.rankMoveTween = nil
    end
end

local function findRankNpc()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    local currentIsland = Player:GetAttribute("Island")
    if type(currentIsland) ~= "string" or not Islands[currentIsland] then
        -- Prefer the actual island nearest to the player if its attribute
        -- is missing. Do not pick a random elder on another island.
        local root = getRoot()
        local nearest, best = nil, math.huge
        if root then
            for _, id in ipairs(Islands.Order or {}) do
                local island = Islands[id]
                if island and typeof(island.Center) == "Vector3" then
                    local dist = (root.Position - island.Center).Magnitude
                    if dist < best then nearest, best = id, dist end
                end
            end
        end
        currentIsland = nearest
    end
    local island = currentIsland and Islands[currentIsland]
    local islandModel = currentIsland and map:FindFirstChild(currentIsland)
    local npcs = islandModel and islandModel:FindFirstChild("NPCs")
    local elderName = island and island.NPCNames and island.NPCNames.RankUp
    local npc = elderName and npcs and npcs:FindFirstChild(elderName)
    if not npc then return nil, nil, elderName or "Rank elder not loaded" end
    local prompt = npc:FindFirstChild("NPCPrompt", true)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return npc, nil, elderName
    end
    return npc, prompt, elderName
end

local function npcPromptPosition(npc, prompt)
    local parent = prompt and prompt.Parent
    if parent and parent:IsA("Attachment") then return parent.WorldPosition end
    if parent and parent:IsA("BasePart") then return parent.Position end
    local part = npc and (npc:FindFirstChild("HumanoidRootPart")
        or npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart", true))
    return part and part.Position or nil
end

local function approachRankNpc(root, position)
    if not root or not position then return end
    -- Give the rank visit exclusive ownership of movement; avoid having the
    -- farming Heartbeat and a rank tween write to the root simultaneously.
    if not Aux.rankApproachActive and farmMover.Stop then farmMover.Stop(true) end
    Aux.rankApproachActive = true
    local now = os.clock()
    local relative = root.Position - position
    local flat = Vector3.new(relative.X, 0, relative.Z)
    if flat.Magnitude < 0.1 then flat = Vector3.new(1, 0, 0) end
    local goal = position + flat.Unit * 3.5 + Vector3.new(0, 1.0, 0)
    if Aux.rankMoveTween and Aux.rankMoveTween.PlaybackState == Enum.PlaybackState.Playing
        and rankMoveGoal and (rankMoveGoal - goal).Magnitude < 2 then
        return
    end
    if now < rankNextMoveAt then return end
    if Aux.rankMoveTween then pcall(function() Aux.rankMoveTween:Cancel() end) end
    local delta = goal - root.Position
    local yaw = math.atan2(-flat.X, -flat.Z)
    local cf = CFrame.new(goal) * CFrame.Angles(0, yaw, 0)
    local duration = math.clamp(delta.Magnitude / 60, 0.15, 2.5)
    rankMoveGoal = goal
    Aux.rankMoveTween = TweenService:Create(root, TweenInfo.new(
        duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out
    ), {CFrame = cf})
    Aux.rankMoveTween:Play()
    rankNextMoveAt = now + math.max(0.6, duration)
end

local function startRankPrompt(prompt)
    if rankPromptBusy or os.clock() < rankNextPromptAt then return end
    rankNextPromptAt = os.clock() + 3
    rankPromptBusy = true
    task.spawn(function()
        local ok = false
        if running and autoRank and prompt and prompt.Enabled then
            if type(fireproximityprompt) == "function" then
                ok = pcall(fireproximityprompt, prompt)
            end
            if not ok then
                ok = pcall(function()
                    prompt:InputHoldBegin()
                    task.wait(math.max(0.08, tonumber(prompt.HoldDuration) or 0) + 0.12)
                    prompt:InputHoldEnd()
                end)
            end
        end
        rankPromptBusy = false
        rankWorkflow = ok and "Elder prompt activated; waiting for Rank Up menu"
            or "Elder prompt unavailable; retrying nearby"
    end)
end

local function doAutoRank()
    if not running or not autoRank or not ClientData.IsReady() then return end
    local rank, _, nextRank = nextRankData()
    if not nextRank then
        rankWorkflow = "Maximum rank"
        finishRankApproach()
        return
    end
    if not rankIsAffordable(nextRank) then
        rankWorkflow = "Waiting for level, coins or gems"
        finishRankApproach()
        rankPending = nil
        return
    end
    if game.PlaceId == 131528475614757 then
        rankWorkflow = "Return to the main islands to visit the rank elder"
        return
    end
    if Aux.travelBusy or Aux.spiritPriorityActive then
        rankWorkflow = "Waiting for travel or spirit interaction to finish"
        return
    end
    local root = getRoot()
    if not root then rankWorkflow = "Waiting for character" return end
    local npc, prompt, name = findRankNpc()
    if not npc then
        rankWorkflow = "Rank elder is not loaded: " .. tostring(name)
        return
    end
    local position = npcPromptPosition(npc, prompt)
    if not position then
        rankWorkflow = "Waiting for elder position: " .. tostring(name)
        return
    end
    local distance = (root.Position - position).Magnitude
    local activation = math.max(3, (prompt and prompt.MaxActivationDistance or 10) - 1.5)
    if distance > math.min(activation, 5) then
        rankWorkflow = string.format("Approaching %s (%.1f studs)", tostring(name), distance)
        approachRankNpc(root, position)
        return
    end
    Aux.rankApproachActive = true -- hold here while the elder processes Rank Up
    if Aux.rankMoveTween then
        pcall(function() Aux.rankMoveTween:Cancel() end)
        Aux.rankMoveTween = nil
    end
    if not prompt then
        rankWorkflow = "Near " .. tostring(name) .. " but NPCPrompt is missing"
        return
    end
    if ClientState.OpenMenuName ~= "RankUp" then
        rankWorkflow = "Opening " .. tostring(name) .. " Rank Up prompt"
        startRankPrompt(prompt)
        return
    end
    local now = os.clock()
    if rankPending and rankPending.rank ~= rank then
        rankPending = nil
        rankAttempts = 0
    end
    if rankPending and now - rankPending.at < 5 then
        rankWorkflow = "Rank request sent; awaiting confirmation"
        return
    end
    if rankPending then
        rankAttempts += 1
        if rankAttempts >= 3 then
            rankWorkflow = "Rank not confirmed; check NPC or additional requirements"
            finishRankApproach()
            if rankToggle then rankToggle:Set(false) else autoRank = false end
            warn("[Tame V44] Auto Rank paused: three requests received no rank confirmation")
            return
        end
    end
    rankPending = {rank = rank, at = now}
    rankWorkflow = "Requesting next rank from " .. tostring(name)
    RankUpRemote:FireServer()
end

