--==============================================================
-- HELPERS
--==============================================================

local function log(...)
    if Config.Debug then
        print("[FishingV16]", ...)
    end
end

local function warnf(...)
    warn("[FishingV16]", ...)
end

local function track(connection)
    table.insert(State.Connections, connection)
    return connection
end

local function safeFire(packet, ...)
    if not packet then
        return false
    end

    local args = table.pack(...)
    local ok, err = pcall(function()
        packet:Fire(table.unpack(args, 1, args.n))
    end)

    if not ok then
        warnf("Packet fire failed:", err)
        return false
    end

    return true
end

local function touchPacket()
    State.LastPacketAt = os.clock()
end

local function setPhase(newPhase)
    if State.Phase == newPhase then
        return
    end

    State.Phase = newPhase
    State.PhaseEnteredAt = os.clock()
    log("OP phase ->", newPhase)
end

