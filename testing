local function allPortals()
    local portals, seen = {}, {}
    for key, portal in pairs(portalStates) do
        if type(portal) == "table" then
            portals[#portals + 1] = portal
            local pos = portal.Model and select(1, getInstancePosition(portal.Model))
            if pos then seen[tostring(normalizeIsland(portal.Island)) .. ":" .. tostring(portal.Rank)] = true end
        end
    end
    for _, portal in ipairs(fallbackVisiblePortals()) do
        local sig = tostring(normalizeIsland(portal.Island)) .. ":" .. tostring(portal.Rank)
        if not seen[sig] then portals[#portals+1] = portal end
    end
    return portals
end

local function bestPortal()
    local root = getRoot()
    local nearest, nearestDist = nil, math.huge
    local portals = allPortals()
    local matchCount = 0
    for _, portal in ipairs(portals) do
        if matchesDungeon(portal) then
            matchCount += 1
            local pos = select(1, getInstancePosition(portal.Model))
            local dist = root and pos and (root.Position-pos).Magnitude or math.huge
            if not nearest or dist < nearestDist then
                nearest, nearestDist = portal, dist
            end
        end
    end
    return nearest, nearestDist, #portals, matchCount
end

