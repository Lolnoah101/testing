local VALID_RAYFIELD_THEMES = {
    default = true,
    cobalt = true,
    ember = true,
    amethyst = true,
    frost = true,
    rose = true,
}

local function normalizeRayfieldTheme(value)
    if type(value) == "table" then
        value = value[1]
    end

    value =
        type(value) == "string"
        and string.lower(value)
        or "cobalt"

    if not VALID_RAYFIELD_THEMES[value] then
        value = "cobalt"
    end

    Config.UITheme = value
    return value
end

local function tryLoadRayfieldSource(url, label)
    State.RayfieldLoadAttempts += 1

    local okHttp, source =
        pcall(function()
            return game:HttpGet(url)
        end)

    if not okHttp then
        return nil,
            label
            .. " HttpGet failed: "
            .. tostring(source)
    end

    if type(source) ~= "string"
        or #source < 100 then

        return nil,
            label
            .. " returned invalid source"
    end

    local chunk, compileError =
        loadstring(source)

    if not chunk then
        return nil,
            label
            .. " compile failed: "
            .. tostring(compileError)
    end

    local okRun, result =
        pcall(chunk)

    if not okRun then
        return nil,
            label
            .. " runtime failed: "
            .. tostring(result)
    end

    if type(result) ~= "table"
        or type(result.CreateWindow)
            ~= "function" then

        return nil,
            label
            .. " returned no usable Rayfield table"
    end

    State.RayfieldSource =
        label

    return result, nil
end

local function loadRayfield()
    local errors = {}

    for attempt = 1, 3 do
        local result, err =
            tryLoadRayfieldSource(
                "https://sirius.menu/gen2",
                "stable #" .. tostring(attempt)
            )

        if result then
            State.RayfieldError = ""
            return result
        end

        table.insert(
            errors,
            tostring(err)
        )

        task.wait(0.20 * attempt)
    end

    local preview, previewError =
        tryLoadRayfieldSource(
            "https://sirius.menu/gen2-preview",
            "preview fallback"
        )

    if preview then
        State.RayfieldError = ""
        return preview
    end

    table.insert(
        errors,
        tostring(previewError)
    )

    State.RayfieldError =
        table.concat(
            errors,
            " | "
        )

    warnf(
        "Rayfield Gen2 load failed:",
        State.RayfieldError
    )

    return nil
end

