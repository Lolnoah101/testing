    end
    task.delay(0.4, function()
        if Hub.Running and Hub.Observed[model] == record then
            record.IdentityCache, record.IdentityRefreshAt = nil, 0
            record.NPCName = canonicalNpcName(model, hum)
            queueLiveNpcLabel(record)
        end
    end)
    -- Overhead labels often replicate after the Humanoid. Capture late names.
    task.delay(1.5, function()
        if Hub.Running and Hub.Observed[model] == record then
            record.IdentityCache, record.IdentityRefreshAt = nil, 0
            record.NPCName = canonicalNpcName(model, hum) or record.NPCName
            queueLiveNpcLabel(record)
        end
    end)
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then bindAnimator(animator) end
    table.insert(record.Signals, hum.ChildAdded:Connect(function(child)
        if child:IsA("Animator") then bindAnimator(child) end
    end))
    table.insert(record.Signals, hum.Died:Connect(function()
        Hub.RetiredModels[model] = true
        disposeEnemy(model)
    end))
    table.insert(record.Signals, hum.HealthChanged:Connect(function(health)
        if health <= 0 then
            Hub.RetiredModels[model] = true
            disposeEnemy(model)
        end
    end))
    table.insert(record.Signals, hum.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Dead then
            Hub.RetiredModels[model] = true
            disposeEnemy(model)
        end
    end))
    table.insert(record.Signals, model.AncestryChanged:Connect(function(_, parent)
        if parent == nil then disposeEnemy(model) end
    end))
end

