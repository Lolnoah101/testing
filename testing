            info[#info+1] = "Time: " .. approx .. formatTime(elapsed)
        end
        local ordinary, drops, special, stats = rewardOrdinary, rewardDrops, rewardSpecial, matchStats
        -- Test messages must not scan a live Rewards UI at all. An unrelated
        -- UIGradient used to crash this path before Discord was called.
        if testMode then
