-- v98: Run the post-UI fast-resume reconciliation inside a separate function.
-- The main Luau chunk already contains nearly 200 live local registers.
-- Adding the v97 Waves farm setting there previously caused a COMPILE failure
-- at `local wantSkills`; separate function scope avoids consuming any more
-- main-chunk local registers while preserving the original execution order.
Farm.reconcileFastResumeAfterUI = function()
    if Farm.fastResumePendingUI then
    Farm.fastResumePendingUI = false
    local function isEnabled(flag, fallback)
        local ok, value = pcall(function() return window:Get(flag) end)
        if ok and type(value)=="boolean" then return value end
        return fallback == true
    end
    local wantFarm = isEnabled("AutoFarm", Farm.fastResumeFlags.AutoFarm)
    local wantWaveFarm = isEnabled("WavesAutoFarmV97", Farm.fastResumeFlags.WavesAutoFarmV97)
    local wantAura = isEnabled("KillAura", Farm.fastResumeFlags.KillAura)
    Farm.generalFarmEnabled = wantFarm
    Farm.waveFarmEnabled = wantWaveFarm
    if Farm.Waves then Farm.Waves.flags.farm = wantWaveFarm end
    Farm:SyncFarmMode()
    if wantAura and not Farm.auraEnabled then Farm:StartAura() end
    if not wantAura and Farm.auraEnabled then Farm:StopAura() end
    local wantReload = isEnabled("AutoReloadBlades", Farm.fastResumeFlags.AutoReloadBlades)
    local wantRefill = isEnabled("AutoRefillBlades", Farm.fastResumeFlags.AutoRefillBlades)
    Farm.utilityAutoReload = wantReload
    Farm.utilityAutoRefill = wantRefill
    if wantReload or wantRefill then startUtilityWatcher() else stopUtilityWatcherIfIdle() end
    local wantSkills = isEnabled("CombatAutoSkillsV46", Farm.fastResumeFlags.CombatAutoSkillsV46)
    if wantSkills and not Farm.autoCombatSkills then
        Farm.autoCombatSkills=true
        startOpWatcher()
    elseif not wantSkills and Farm.autoCombatSkills then
        Farm.autoCombatSkills=false
        Farm.opRunId=Farm.opRunId+1
        Farm.skillReservation=false
    end
    do end
    end
end
