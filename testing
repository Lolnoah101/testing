local DESYNC_OFFSET = CFrame.new(0, 14, 0)
local function restoreDesyncFrame()
    local frame = settingsState.desyncFrame
    settingsState.desyncFrame = nil
    if not frame then return end
    local root = frame.root
    if not root or not root.Parent or not player.Character
        or not root:IsDescendantOf(player.Character) then return end
    pcall(function()
        -- Preserve short, real Humanoid movement that occurred during physics.
        -- Do not erase walking/gravity velocity every frame.
        local localDelta = frame.spoofCf:ToObjectSpace(root.CFrame)
        root.CFrame = frame.cf * (
            localDelta.Position.Magnitude <= 6 and localDelta or CFrame.identity
        )
    end)
end

local function setDesync(enabled)
    enabled = enabled == true
    -- Disconnect first so no new spoof frame can start while we clean up.
    if settingsState.desyncBefore then
        settingsState.desyncBefore:Disconnect()
        settingsState.desyncBefore = nil
    end
    if settingsState.desyncAfter then
        settingsState.desyncAfter:Disconnect()
        settingsState.desyncAfter = nil
    end
    restoreDesyncFrame()
    settingsState.desync = enabled and settingsState.alive
    if not settingsState.desync then return end

    local ok, err = pcall(function()
        settingsState.desyncBefore = RunService.PreSimulation:Connect(function()
            if not settingsState.alive or not settingsState.desync then return end
            -- Restore an older spoof before checking the new zone/state.
            restoreDesyncFrame()
            -- Skip lobby training, rebirth, any below-ground farm, or a parked root.
            if player:GetAttribute("Zone") ~= "Arena" or s.enabled then return end
            local char, humanoid, root = characterReady()
            if not char or not root or root.Anchored or humanoid.SeatPart
                or humanoid.Sit then return end
            local original = root.CFrame
            local frame = {root = root, cf = original, spoofCf = original * DESYNC_OFFSET}
            settingsState.desyncFrame = frame
            local spoofed, spoofError = pcall(function()
                root.CFrame = frame.spoofCf
            end)
            if not spoofed then
                restoreDesyncFrame()
                local now = os.clock()
                if now - settingsState.desyncLastError > 8 then
                    settingsState.desyncLastError = now
                    settingsWarn("Desync frame failed: " .. tostring(spoofError))
                end
            end
        end)
        settingsState.desyncAfter = RunService.PostSimulation:Connect(restoreDesyncFrame)
    end)
    if not ok then
        settingsWarn("Desync unavailable in this environment: " .. tostring(err))
        setDesync(false)
    end
end

