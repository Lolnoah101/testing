        Rescue.GetRaidRouteObjects = function()
            local World = workspace:FindFirstChild("World")
            if not World then
                return nil, nil, nil, nil
            end

            local Areas = World:FindFirstChild("Areas")
            local Area = Areas and Areas:FindFirstChild("1")
            if not Area and Areas then
                for _, Object in ipairs(Areas:GetChildren()) do
                    if Object:IsA("BasePart") then
                        Area = Object
                        break
                    end
                end
            end

            local Markers = World:FindFirstChild("Markers")
            -- The updated 2026-10-11 dungeon dump names the center pad Lift.
            -- Resolve Lift first in Trials to avoid grabbing distant old exit
            -- markers carried over from another segment.
            local Exit = Markers and (
                (GENV.__AZ_IS_TRIALS_MODE() and Markers:FindFirstChild("Lift"))
                or Markers:FindFirstChild("Exit")
                or Markers:FindFirstChild("Elevator")
                or Markers:FindFirstChild("Lift")
            )
            local ExitPrompt = Exit and (
                Exit:FindFirstChild("ExitPrompt", true)
                or Exit:FindFirstChildWhichIsA("ProximityPrompt", true)
            )

            -- Lift's real prompt is often simply named "ProximityPrompt".
            if not ExitPrompt then
                ExitPrompt = World:FindFirstChild("ExitPrompt", true)
                    or (Markers and Markers:FindFirstChild("Lift")
                        and Markers.Lift:FindFirstChildWhichIsA("ProximityPrompt", true))
            end
            if ExitPrompt and not ExitPrompt:IsA("ProximityPrompt") then
                ExitPrompt = nil
            end
            if not Exit and ExitPrompt then
                local Parent = ExitPrompt.Parent
                if Parent and Parent:IsA("Attachment") then
                    Exit = Parent.Parent
                else
                    Exit = Parent
                end
            end

            return World, Area, Exit, ExitPrompt
        end


        Rescue.FireRaidExitPrompt = function(Prompt)
            if not Prompt then
                return false
            end

            if os.clock() - Rescue.RaidLastPromptAt < 0.80 then
                return false
            end

            Rescue.RaidLastPromptAt =
                os.clock()

            if type(fireproximityprompt) == "function" then
                local Success =
                    pcall(
                        fireproximityprompt,
                        Prompt
                    )

                if Success then
                    return true
                end
            end

            task.spawn(function()
                pcall(function()
                    Prompt:InputHoldBegin()

                    task.wait(
                        math.max(
                            tonumber(Prompt.HoldDuration) or 0,
