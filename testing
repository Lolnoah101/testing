--// AREA REQUEST
--//============================================================

local function GetRequestedEntryArea()

    local Area =
        GetRunValue(
            "area"
        )


    local Wave =
        GetRunValue(
            "wave"
        )


    local StartedAt =
        GetRunValue(
            "startedAt"
        )


    if not Area
        or Area <= 1
        or Wave ~= 0
        or not StartedAt
    then

        return nil
    end


    -- Do not let transition recovery take priority while the updated client
    -- already has live/visible enemies spawned for this area.
    if GetLivingEnemyCount() > 0 then
        return nil
    end


    local EnemyFolder =
        workspace:FindFirstChild(
            "enemies"
        )


    if EnemyFolder
        and #EnemyFolder:GetChildren() > 0
    then
        return nil
    end


    return Area
end


--//============================================================
--// AREA HANDLER
--//============================================================

local function HandleAreaEntry(
    TargetArea
)

    ResetWaveRecovery()


    TargetAreaNumber =
        TargetArea


    CurrentTargetId =
        nil


    CurrentTargetState =
        nil


    local EntryCF =
        GetLockedAreaEntryCFrame(
            TargetArea
        )


    if HasCompletedAreaEntry(
        TargetArea
    )
    then

        GENV.__AZ_FARM_EXT.ResetAreaEntryRecovery()


        ConfirmedAreaEntry =
            true


        if TargetArea == 5 then

            DesiredFarmCFrame =
                EntryCF

        else

            DesiredFarmCFrame =
                nil
        end


        SetFarmMode(
            "Inside Area "
            .. tostring(
                TargetArea
            )
        )


        return
    end


    local PreviousArea =
        TargetArea - 1


    local PreviousRubble =
        GetRubbleForArea(
            PreviousArea
        )


    if PreviousRubble
        and PreviousRubble.Health
        and PreviousRubble.Health > 0
    then

        CurrentRubbleInfo =
            PreviousRubble


        RecordRubbleHeight(
            PreviousRubble
        )


        CurrentRubbleCFrame =
            GetRubbleFarmCFrame(
                PreviousRubble
            )


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Rubble"
        )


        return
    end


    if not RubbleBreakTime[
        PreviousArea
    ]
    then

        RubbleBreakTime[
            PreviousArea
        ] = os.clock()
    end


    if not IsRubblePhysicallyOpen(
        PreviousArea
    )
    then

        CurrentRubbleInfo =
            PreviousRubble


        CurrentRubbleCFrame =
            PreviousRubble
            and GetRubbleFarmCFrame(
                PreviousRubble
            )
            or nil


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Waiting For Rubble To Drop"
        )


        return
    end


    local RecoveryCF =
        GENV.__AZ_FARM_EXT.HandleAreaEntryRecovery(
            TargetArea
        )


    if RecoveryCF then

        EntryCF =
            RecoveryCF


        SetFarmMode(
            "Area Recovery "
            .. tostring(
                TargetArea
            )
        )

    else

        SetFarmMode(
            "Entering Area "
            .. tostring(
                TargetArea
            )
        )
    end


    DesiredFarmCFrame =
        EntryCF
end


--//============================================================
--// RAID EXIT
--//
--// Raid segments expose RaidExitOpen instead of normal rubble. Move toward
--// the next area volume when possible; if the active map uses a runtime
--// elevator part instead, fall back to the nearest named elevator/exit.
--//============================================================

GENV.__AZ_FARM_EXT.HandleRaidExit = function()

    if not GENV.__AZ_IS_RAID_MODE()
        or workspace:GetAttribute("RaidExitOpen") ~= true
    then
        return false
    end


    local EnemyId =
        GetFreshFarmTarget()


    if EnemyId then
        return false
    end


    local Root =
        GetRoot()


    if not Root then
        return false
    end


    local Area =
        tonumber(
            GetRunValue("area")
        ) or 1


    local NextArea =
        Area + 1


    local Target =
        ComputeAreaEntryCFrame(
            NextArea,
            Settings.FarmMethod == "Tween"
                and TWEEN_AREA_ENTRY_DEPTH
                or TELEPORT_AREA_ENTRY_DEPTH
        )


    if not Target then

        local World =
            workspace:FindFirstChild("World")

        local BestPart = nil
        local BestDistance = math.huge


        if World then

            for _, Object in ipairs(
                World:GetDescendants()
            ) do

                if Object:IsA("BasePart") then

                    local Name =
                        string.lower(Object.Name)


                    if string.find(Name, "elevator", 1, true)
                        or string.find(Name, "exit", 1, true)
                    then

                        local Distance =
                            (
                                Root.Position
                                - Object.Position
                            ).Magnitude


                        if Distance < BestDistance then

                            BestDistance = Distance
                            BestPart = Object
                        end
                    end
                end
            end
        end


        if BestPart then

            Target =
                BestPart.CFrame
                + Vector3.new(0, 2.5, 0)
        end
    end


    if not Target then
        return false
    end


    CurrentTargetId = nil
    CurrentTargetState = nil
    CurrentRubbleInfo = nil
    CurrentRubbleCFrame = nil
    TargetAreaNumber = NextArea
    DesiredFarmCFrame = Target


    SetFarmMode(
        "Raid Exit -> Area "
        .. tostring(NextArea)
    )


    return true
end


--//============================================================
--// NORMAL FARM
--//============================================================

local function HandleNormalFarm()

    TargetAreaNumber =
        nil


    ResetAreaEntryTarget()


    local EnemyId,
        EnemyState =
        GetFreshFarmTarget()


    if EnemyId
        and EnemyState
    then

        ResetWaveRecovery()


        CurrentRubbleInfo =
            nil


        CurrentRubbleCFrame =
            nil


        DesiredFarmCFrame =
            GetEnemyFarmCFrame(
                EnemyId,
                EnemyState
            )


        SetFarmMode(
            "Enemy"
        )


        return
    end


    local Area =
        GetRunValue(
            "area"
        )


    if not Area then

        DesiredFarmCFrame =
            nil


        return
    end


    local Info =
        GetRubbleForArea(
            Area
        )


    CurrentRubbleInfo =
        Info


    if Info
        and Info.Health
        and Info.Health > 0
    then

        ResetWaveRecovery()


        RecordRubbleHeight(
            Info
        )


        CurrentRubbleCFrame =
            GetRubbleFarmCFrame(
                Info
            )


        DesiredFarmCFrame =
            CurrentRubbleCFrame


        SetFarmMode(
            "Rubble"
        )


        return
    end


    if HandleWaveRecovery(
        Area
    )
    then

        return
    end


    if Info
        and Info.Health ~= nil
        and Info.Health <= 0
    then

        DesiredFarmCFrame =
            nil


        SetFarmMode(
            "Waiting For Next Area"
        )


        return
    end


    DesiredFarmCFrame =
        nil


    SetFarmMode(
        "Waiting"
    )
end


--//============================================================
--// AUTO FARM
--//============================================================

local function UpdateAutoFarm()

    if GENV.__AZ_IS_RAID_MODE() then
        DesiredFarmCFrame = nil
        SetFarmMode("Raid Uses Auto Raid Farm")
        return
    end


    if not IsAlive() then

        DesiredFarmCFrame =
            nil


        return
    end


    if Settings.AutoFarm then

        local ServerArea =
            GetRunValue(
                "area"
            )


        local ServerWave =
            GetRunValue(
                "wave"
            )


        if ServerArea ~= LastServerArea then

            LastServerArea =
                ServerArea


            CurrentTargetId =
                nil


            CurrentTargetState =
                nil


            ResetAreaEntryTarget()

            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        if ServerWave ~= LastObservedWave then

            LastObservedWave =
                ServerWave


            ResetWaveRecovery()

            if type(GENV.__AZ_FARM_EXT.ResetStillness) == "function" then
                GENV.__AZ_FARM_EXT.ResetStillness()
            end
        end


        local RequestedArea =
            GetRequestedEntryArea()


        -- Never let a coin/drop pull us away while the server is asking
        -- us to enter the next area. Area transitions remain top priority.
        if RequestedArea then

            HandleAreaEntry(
                RequestedArea
            )


            return
        end


        if type(
            GENV.__AZ_FARM_EXT
                .HandleRaidExit
        ) == "function"
            and GENV.__AZ_FARM_EXT
                .HandleRaidExit()
        then

            return
        end
    end


    if Settings.AutoPickupLoot
        and type(
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame
        ) == "function"
    then

        local LootCF =
            GENV.__AZ_FARM_EXT
                .GetLootTargetCFrame()


        if LootCF then

            CurrentTargetId =
                nil

            CurrentTargetState =
                nil

            CurrentRubbleInfo =
                nil

            CurrentRubbleCFrame =
                nil

            TargetAreaNumber =
                nil

            DesiredFarmCFrame =
                LootCF


            SetFarmMode(
                "Loot"
            )


            return
        end
    end


    if not Settings.AutoFarm then

        DesiredFarmCFrame =
            nil


        SetFarmMode(
            "Idle"
        )


        return
    end


    HandleNormalFarm()
end


--//============================================================
--// COMBAT LOOP
--//============================================================

local function RunCombatHeartbeat()

    if not IsAlive() then
        return
    end


    if Settings.AutoM1 then

        if Settings.AutoFarm
            and not GENV.__AZ_IS_RAID_MODE()
        then

            if CurrentFarmMode == "Rubble"
                and IsCurrentRubbleAlive()
                and IsNearRubble()
            then

                TryM1()


            elseif CurrentFarmMode == "Enemy"
                and GetNearbyEnemy()
            then

                TryM1()
            end


        elseif GetNearbyEnemy() then

            TryM1()
        end
    end


    if Settings.AutoSkills
        or Settings.AutoUltimate
    then

        if (
            not Settings.AutoFarm
            or CurrentFarmMode == "Enemy"
        )
            and GetNearbyEnemy()
        then

            RunAutoSkills()
        end
    end


    if Settings.AutoBlock then

        if Settings.BlockMode
            == "Hold Block"
        then

            RequestBlock(
                ShouldHoldBlock()
            )

        else

            RunPerfectParry()
        end


    else

        RequestBlock(
            false
        )
    end
end


