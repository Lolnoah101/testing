local function findAliveMob(container)
    if not container then return nil end
    local cached=X.MobCache[container]
    if cached and os.clock()<cached.At+.45 and cached.Model and cached.Model.Parent then
        local hum=cached.Model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health>0 then return cached.Model end
    end
    local myRoot = rootHum()
    if not myRoot then return nil end
    local best, dist
    for _, item in ipairs(container:GetDescendants()) do
        if item:IsA("Humanoid") and item.Health > 0 and item.Parent then
            local model = item.Parent
            if model ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(model) then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root then
                    local d = (root.Position - myRoot.Position).Magnitude
                    if not dist or d < dist then best = model; dist = d end
                end
            end
        end
    end
    X.MobCache[container]={At=os.clock(),Model=best}
    return best
end
