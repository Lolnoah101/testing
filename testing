    --//========================================================
    --// AUTO DELIVERY QUEST
    --//
    --// Delivery flow from the game:
    --// none -> request -> carrying -> delivered -> claim
    --// capped means the daily delivery limit has been reached.
    --// When carrying, DeliveryState.target identifies the real NPC.
    --//========================================================

    local DeliveryState = nil
    local LastDeliveryStateAt = 0
    local LastDeliveryActionAt = 0
    local LastDeliveryTeleportAt = 0
    local LastDeliveryCappedNotice = 0

    local function SendDeliveryAction(Action)
        if not Packets.deliveryAction then
            return false
        end

        local Now = os.clock()

        if Now - LastDeliveryActionAt < 1.15 then
            return false
        end

        LastDeliveryActionAt = Now

        local Id = NextRequestId(
            RequestIds,
            "Delivery"
        )

        return pcall(function()
            Packets.deliveryAction:fire({
                action = Action,
                requestId = Id,
            })
        end)
    end

    local function FindDeliveryTarget(TargetName)
        if type(TargetName) ~= "string"
            or TargetName == ""
        then
            return nil, nil
        end

        local Systems = workspace:FindFirstChild("Systems")

        if not Systems then
            return nil, nil
        end

        local NPCS = Systems:FindFirstChild("NPCS")
        local Model = NPCS
            and NPCS:FindFirstChild(TargetName)

        if not Model then
            local Scattered =
                Systems:FindFirstChild("ScatteredNPCS")

            Model = Scattered
                and Scattered:FindFirstChild(TargetName)
        end

        if not Model then
            return nil, nil
        end

        local Root = Model:FindFirstChild(
            "HumanoidRootPart"
        )

        if Root and Root:IsA("BasePart") then
            return Model, Root
        end

        if Model:IsA("BasePart") then
            return Model, Model
        end

        return Model, nil
    end

    local function TeleportToDeliveryTarget(TargetName)
        local Character = LocalPlayer.Character

        if not Character then
            return false
        end

        local PlayerRoot = Character:FindFirstChild(
            "HumanoidRootPart"
        )

        local _, TargetRoot =
            FindDeliveryTarget(TargetName)

        if not PlayerRoot
            or not TargetRoot
        then
            return false
        end

        local Goal =
            TargetRoot.CFrame
            * CFrame.new(0, 0, 2.5)

        local Success = pcall(function()
            Character:PivotTo(Goal)
            PlayerRoot.AssemblyLinearVelocity = Vector3.zero
            PlayerRoot.AssemblyAngularVelocity = Vector3.zero
        end)

        return Success
    end

    if Packets.deliveryState then
        local Connection =
            Packets.deliveryState
                :on(function(State)
                    if not Alive() or not State then
                        return
                    end

                    DeliveryState = State
                    LastDeliveryStateAt = os.clock()

                    if tostring(State.reason or "") ~= "" then
                        warn(
                            "[Anime Zero][Delivery]",
                            State.reason
                        )
                    end
                end)

        table.insert(Runtime.Connections, Connection)
    end

    task.spawn(function()
        while Alive() do
            if Settings.AutoDeliveryQuest then
                local Now = os.clock()

                if not DeliveryState
                    or Now - LastDeliveryStateAt >= 5
                then
                    SendDeliveryAction("refresh")
                else
                    local Status =
                        tostring(DeliveryState.status or "none")

                    if Status == "none" then
                        SendDeliveryAction("request")

                    elseif Status == "carrying" then
                        local Target =
                            tostring(DeliveryState.target or "")

                        if Target ~= ""
                            and Now - LastDeliveryTeleportAt
                                >= 0.80
                        then
                            LastDeliveryTeleportAt = Now
                            TeleportToDeliveryTarget(Target)
                        end

                    elseif Status == "delivered" then
                        SendDeliveryAction("claim")

                    elseif Status == "capped" then
                        if Now - LastDeliveryCappedNotice
                            >= 30
                        then
                            LastDeliveryCappedNotice = Now

                            Notify(
                                "Auto Delivery Quest",
                                "Daily delivery limit reached ("
                                    .. tostring(
                                        DeliveryState.dailyCount or "?"
                                    )
                                    .. "/"
                                    .. tostring(
                                        DeliveryState.dailyLimit or "?"
                                    )
                                    .. ").",
                                6
                            )
                        end
                    end
                end
            else
                -- Force a fresh state the next time the toggle is enabled.
                DeliveryState = nil
            end

            task.wait(0.15)
        end
    end)

    print(
        "[Anime Zero] Player + Misc automation ready."
    )
end)()


