    local function GetLobbyData()
        if not IsLobby() then return nil end

        local Lobby = ReplicatedStorage:FindFirstChild("lobby")
        local Assets = ReplicatedStorage:FindFirstChild("assets")
        local Global = ReplicatedStorage:FindFirstChild("global")
        local Config = Assets and Assets:FindFirstChild("config")
        local Stores = Global and Global:FindFirstChild("stores")

        local PacketsModule = Lobby and Lobby:FindFirstChild("packets")
        local ShopModule = Config and Config:FindFirstChild("MaterialShopConfig")
        local AccountModule = Stores and Stores:FindFirstChild("accountNamespace")

        if not PacketsModule or not ShopModule or not AccountModule then
            return nil
        end

        local Ok, Result = pcall(function()
            local AccountNamespace = require(AccountModule)
            local Account = AccountNamespace.getLocalPlayerAccount()
            return {
                Packets = require(PacketsModule),
                Shop = require(ShopModule),
                Data = Account and Account:toTable() or nil,
            }
        end)

        return Ok and Result or nil
    end

    local function RunMarket()
        if not IsLobby()
            or os.clock() - Runtime.LastMarketAction < 2
        then
            return
        end

        if Master.AutoBuyMissingMaterials ~= true
            and Master.AutoConvertMissingMaterials ~= true
        then
            return
        end

        local Accessory = GENV.__AZ_ACCESSORY_AUTOMATION_SETTINGS
        local Needs = GENV.__AZ_ACCESSORY_AUTOMATION_NEEDS

        if type(Accessory) ~= "table"
            or Accessory.AutoCraftAccessories ~= true
            or type(Needs) ~= "table"
        then
            return
        end

        local Live = GetLobbyData()
        if not Live or not Live.Data then return end

        local function Owned(Id)
            return tonumber(
                Live.Data.material
                and Live.Data.material[tostring(Id)]
            ) or 0
        end

        if Master.AutoBuyMissingMaterials == true
            and Live.Packets.buyMaterial
        then
            local Day = Live.Shop.GetDay(workspace:GetServerTimeNow())
            local Money = tonumber(Live.Data.money) or 0

            for Id, Missing in pairs(Needs) do
                Missing = math.floor(tonumber(Missing) or 0)
                local Price = tonumber(Live.Shop.GetPrice(tostring(Id))) or math.huge

                if Missing > 0
                    and tostring(Id) ~= "113"
                    and tostring(Id) ~= "114"
                    and Live.Shop.IsInStock(tostring(Id), Day)
                    and Money >= Price
                then
                    local Amount = math.min(Missing, math.floor(Money / Price), 255)

                    if Amount > 0 then
                        local Ok = pcall(function()
                            Live.Packets.buyMaterial:fire({
                                itemId = tostring(Id),
                                amount = Amount,
                                requestId = NextId(),
                            })
                        end)

                        if Ok then
                            Runtime.LastMarketAction = os.clock()
                            Runtime.LastAction =
                                "Market buy: " .. tostring(Id) .. " x" .. tostring(Amount)
                            return
                        end
                    end
                end
            end
        end

        if Master.AutoConvertMissingMaterials == true
            and Live.Packets.convertMaterial
        then
            for Target, Missing in pairs(Needs) do
                Missing = math.floor(tonumber(Missing) or 0)

                if Missing > 0
                    and tostring(Target) ~= "113"
                    and tostring(Target) ~= "114"
                then
                    for _, SourceInfo in ipairs(
                        Live.Shop.GetSources(tostring(Target)) or {}
                    ) do
                        local Source = tostring(SourceInfo.Id)
                        local Rate = tonumber(SourceInfo.Rate) or 0
                        local Reserved =
                            Master.ReserveNeededMaterials ~= false
                            and math.max(tonumber(Needs[Source]) or 0, 0)
                            or 0
                        local Spare = math.max(Owned(Source) - Reserved, 0)
                        local Possible = Rate > 0 and math.floor(Spare / Rate) or 0
                        local Amount = math.min(
                            Missing,
                            Possible,
