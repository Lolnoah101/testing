-- Only request hit registration after the Actor-local client has started and
-- released an actual slash. Server rules still determine whether damage counts.
-- v103: Gameplay flags and Rayfield may restore early on Delta, but combat
-- must be initialized only AFTER the Roblox character, actual game combat
-- Actor Host, and POST RemoteEvent are available. This is nonblocking: UI,
-- saved flags, and other noncombat systems still initialize immediately.
Farm.combatStartup = {
    ready = false, reason = "Waiting for Roblox character and remotes",
    character = nil, actor = nil, post = nil,
    nextCheck = 0, lastCheck = 0,
}
function Farm:CombatStartupReady()
    local state = self.combatStartup
    if self.unloaded then return false end
    local character = LocalPlayer.Character
    local actor = character and character:FindFirstChildOfClass("Actor")
    local root = getPlayerRoot()
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local livePost = remotes and remotes:FindFirstChild("POST")
    if livePost and not livePost:IsA("RemoteEvent") then livePost = nil end
    local changed = state.character ~= character or state.actor ~= actor or state.post ~= livePost
    if changed then
        state.ready = false
        state.character = character
        state.actor = actor
        state.post = livePost
        state.nextCheck = 0
        -- Resolve the live Host again after respawn/Actor replacement.
        if actor ~= self.slashActor then
            self.slashBridge = nil
            self.slashActor = nil
            self.attackHeld = false
        end
    end
    if state.ready and root and livePost then return true end
    state.ready = false
    local now = os.clock()
    if now < state.nextCheck then return false end
    state.nextCheck = now + 0.7 -- avoid expensive Actor scans every frame
    -- v109: game:IsLoaded() includes unrelated assets that load slowly on
    -- mobile. The required RootPart, POST, Actor, and native Host are checked
    -- separately below; they are the actual combat readiness prerequisites.
    if not root then
        state.reason = "Character/HumanoidRootPart not ready"
        return false
    end
    if not livePost then
        state.reason = "Assets.Remotes.POST not replicated"
        return false
    end
    POST = livePost
    if not actor then
        state.reason = "Character combat Actor not ready"
        return false
    end
    local bridge, why = resolveSlashBridge()
    if not bridge then
        state.reason = "Actor bridge: " .. tostring(why)
        return false
    end
    -- A bridge existing is not sufficient: the game's native Host can still
    -- be absent or busy while loading, making early slashes ineffective.
    local callOK, hostReady, info = pcall(function()
        return bridge:Invoke("status")
    end)
    if not callOK or not hostReady then
        state.reason = "Native combat Host: " .. tostring(callOK and info or hostReady)
        return false
    end
    local idleOK, idle, idleReason = pcall(function()
        return bridge:Invoke("reload_window")
    end)
    if not idleOK or not idle then
        state.reason = "Waiting for native combat idle: " .. tostring(idleOK and idleReason or idle)
        return false
    end
    state.ready = true
    state.reason = "Ready"
    state.lastCheck = now
    self.attackWarned = false
    do end
    return true
end

local function registerAuraHits(root)
    if not Farm.auraEnabled or Farm.utilityBusy then return end
    if not Farm:CombatStartupReady() then return end
    -- On Delta, early auto-execution can run before Assets.Remotes replicates.
    -- Re-resolve POST when a server finishes loading instead of permanently
    -- using a nil/stale remote captured at the top of the script.
    if not POST or not POST.Parent or not POST:IsA("RemoteEvent") then
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local remotes = assets and assets:FindFirstChild("Remotes")
        POST = remotes and remotes:FindFirstChild("POST")
    end
    if not POST or not POST:IsA("RemoteEvent") then
        if not Farm.remoteWarned then
            Farm.remoteWarned = true
            do end
        end
        return
    end
    Farm.remoteWarned = false

    local targets, availableCount = getPrioritizedAuraTargets(root.Position)
    Farm.auraLastTargetCount = availableCount
    Farm.auraLastFocus = targets[1] and targets[1].titan.Name or "None"
    Farm.auraLastUniqueTitans = #targets
    local hitLimit = Farm.auraMode == "Turbo" and TURBO_MAX_REGISTRATIONS
        or (Farm.auraMode == "Aggressive" and AGGRESSIVE_AURA_TARGETS
        or MAX_AURA_TARGETS_PER_SWING)
    local sent = 0
    -- FIRST PASS: one Nape registration for as many DISTINCT Titans as possible.
    -- Normal client limb collisions resolve to Nape; repeated limbs on the same
    -- Titan may be ignored by strike limits, so we never trade away a new Titan.
    for _, target in ipairs(targets) do
        if sent >= hitLimit or not Farm.auraEnabled or Farm.unloaded or Farm.utilityBusy then break end
        local currentNape = getNape(target.titan)
        if currentNape and currentNape:IsDescendantOf(Workspace)
            and canAttackTitan(target.titan) then
            local ok, err = pcall(function()
                POST:FireServer("Hitboxes", "Register", currentNape, ATTACK_HOLD)
            end)
            if ok then
                sent = sent + 1
                Farm.auraAttempts = Farm.auraAttempts + 1
            else
                do end
            end
        end
    end
    -- OPTIONAL TEST: a few extra limb/eye references, only if the core nape
    -- sweep left capacity. This is EXPERIMENTAL: the game's normal client
    -- resolves limb contacts to Nape, and the server may reject these.
    if Farm.auraHitboxMode == "Nape + Limbs (Test)" and sent < hitLimit then
        local names = {"Eyes", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}
        local cursor = Farm.auraLimbCursor
        local extraCap = math.min(4, hitLimit - sent)
        for i = 1, extraCap do
            if #targets == 0 or Farm.unloaded or not Farm.auraEnabled or Farm.utilityBusy then break end
            local target = targets[((cursor + i - 2) % #targets) + 1]
            if canAttackTitan(target.titan) then
                local hitboxes = target.titan:FindFirstChild("Hitboxes")
                local hitFolder = hitboxes and hitboxes:FindFirstChild("Hit")
                local name = names[((cursor + i - 2) % #names) + 1]
                local part = hitFolder and hitFolder:FindFirstChild(name)
                if part and part:IsA("BasePart") and part:IsDescendantOf(Workspace) then
                    local ok = pcall(function()
                        POST:FireServer("Hitboxes", "Register", part, ATTACK_HOLD)
                    end)
                    if ok then
                        Farm.auraAttempts = Farm.auraAttempts + 1
                        Farm.auraLimbAttempts = Farm.auraLimbAttempts + 1
                    end
                end
            end
        end
        Farm.auraLimbCursor = cursor + extraCap
    end
end

local function tryAttack(runId, withAura)
