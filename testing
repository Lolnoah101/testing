        LeftCenter
        and LeftCenter:FindFirstChild(
            "zQuestsFrame"
        )

    return QuestsFrame
        and QuestsFrame:FindFirstChild(
            "Panel"
        )
end


function QuestController:GetTitleObject(Card)
    local ATitle =
        Card
        and Card:FindFirstChild(
            "aTitle"
        )

    local Holder =
        ATitle
        and ATitle:FindFirstChild(
            "Holder"
        )

    return Holder
        and Holder:FindFirstChild(
            "Text"
        )
end


function QuestController:GetTitle(Card)
    local Object =
        self:GetTitleObject(
            Card
        )

    if not Object then
        return ""
    end

    local Value =
        Object.ContentText

    if type(Value) ~= "string"
        or Value == ""
    then
        Value = Object.Text
    end

    return tostring(
        Value or ""
    )
end


function QuestController:TitleMatches(
    Title,
    Config
)
    local Lower =
        string.lower(
            tostring(Title or "")
        )

    if Lower == "" then
        return false
    end

    for _, Term in ipairs(
        Config.MatchTerms or {}
    ) do
        if not string.find(
            Lower,
            string.lower(
                tostring(Term)
            ),
            1,
            true
        ) then
            return false
        end
    end

    return true
end


function QuestController:FindQuestCard(
    Config
)
    local Panel =
        self:GetQuestPanel()

    if not Panel then
        return nil
    end

    if Config.PanelName then
        local Exact =
            Panel:FindFirstChild(
                Config.PanelName
            )

        if Exact then
            return Exact
        end
    end

    for _, Card in ipairs(
        Panel:GetChildren()
    ) do
        local Title =
            self:GetTitle(
                Card
            )

        if self:TitleMatches(
            Title,
            Config
        ) then
            return Card
        end
    end

    return nil
end


function QuestController:ReadProgress(
    Card,
    Config
)
    -- The quest title currently exposes progress like:
    -- "Defeat 3 bandits 0/1"
    local Title =
        self:GetTitle(
            Card
        )

    local Current, Total =
        Title:match(
            "(%d+)%s*/%s*(%d+)"
        )

    if Current and Total then
        return tonumber(Current),
            tonumber(Total),
            Title
    end

    -- Fallback to the task progress path supplied for the
    -- three-bandit quest:
    -- cTasksHolder["Bandits remaining"].Holder.Txt
    if Config.TaskName then
        local Tasks =
            Card:FindFirstChild(
                "cTasksHolder"
            )

        local Task =
            Tasks
            and Tasks:FindFirstChild(
                Config.TaskName
            )

        local Holder =
            Task
            and Task:FindFirstChild(
                "Holder"
            )

        local Txt =
            Holder
            and Holder:FindFirstChild(
                "Txt"
            )

        if Txt then
            local TaskText =
                tostring(
                    Txt.ContentText ~= ""
                    and Txt.ContentText
                    or Txt.Text
                    or ""
                )

            Current, Total =
                TaskText:match(
                    "(%d+)%s*/%s*(%d+)"
                )

            if Current and Total then
                return tonumber(Current),
                    tonumber(Total),
                    TaskText
            end
        end
    end

    return nil, nil, Title
end


function QuestController:IsComplete(
    Card,
    Config
)
    local Current, Total =
        self:ReadProgress(
            Card,
            Config
        )

    return Current ~= nil
        and Total ~= nil
        and Total > 0
        and Current >= Total
end


function QuestController:GetNPC(
    Config
)
    local Path =
        Config
        and Config.NPCPath
        or self.NPCPath

    if not Path then
        return nil
    end

    local Current =
        workspace

    for _, Name in ipairs(
        Path
    ) do
        Current =
            Current
            and Current:FindFirstChild(
                Name
            )

        if not Current then
            return nil
        end
    end

    return Current
end


function QuestController:GetObjectCFrame(
    Object
)
    if not Object then
        return nil
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.CFrame
    end

    if Object:IsA(
        "Model"
    ) then
        return Object:GetPivot()
    end

    if Object:IsA(
        "Attachment"
    ) then
        return Object.WorldCFrame
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.CFrame
        or nil
end


function QuestController:TeleportToQuestNPC(
    Config
)
    local NPC =
        self:GetNPC(
            Config
        )

    local Target =
        self:GetObjectCFrame(
            NPC
        )

    if not Target then
        return false,
            "Quest NPC was not found"
    end

    local Character =
        LocalPlayer.Character

    if not Character then
        return false,
            "Character was not found"
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false,
            "HumanoidRootPart was not found"
    end

    -- Small offset keeps the character from spawning inside Krue.
    Character:PivotTo(
        Target
        * CFrame.new(
            0,
            2.5,
            4
        )
    )

    return true
end


function QuestController:AcceptSelected()
    if not HubRunning
        or not Settings.AutoQuest
        or self.Busy
    then
        return false
    end

    local Config =
        self:GetConfig()

    if not Config then
        return false
    end

    -- Keep retrying until the quest is visibly active, but space
    -- requests enough that we do not hammer the remote every frame.
    if os.clock()
        - self.LastAcceptAt
        < self.AcceptRetryDelay
    then
        return false
    end

    self.Busy = true

    -- Teleport to the configured quest NPC once per acceptance cycle.
    -- The Bamboo Grove Bear Cub quest currently has no captured quest-NPC
    -- path, so it intentionally skips this step instead of teleporting
    -- back to Krue in Windy Peak.
    if not self.TeleportedForAcceptance then
        if not Config.SkipQuestNPCTeleport then
            local TeleportSuccess,
                TeleportError =
                self:TeleportToQuestNPC(
                    Config
                )

            if not TeleportSuccess then
                self.Busy = false

                warn(
                    "[Combat Hub] Auto Quest: "
                        .. tostring(
                            TeleportError
                        )
                )

                return false
            end

            task.wait(0.30)
        end

        self.TeleportedForAcceptance =
            true
    end

    local Success, ErrorMessage =
        pcall(function()
            CombatEvent:FireServer(
                "AddQuest",
                Config.Request
            )
        end)

    self.LastAcceptAt =
        os.clock()

    self.Busy = false

    if not Success then
        warn(
            "[Combat Hub] Auto Quest: "
                .. tostring(
                    ErrorMessage
                )
        )

        return false
    end

    return true
end


function QuestController:ResetState()
    self.Busy = false
    self.LastAcceptAt = 0
    self.CompletionSeenAt = nil
    self.TeleportedForAcceptance = false
end


function QuestController:Start()
    self.LoopID += 1

    local MyLoopID =
        self.LoopID

    self:ResetState()

    task.spawn(function()
        while HubRunning
            and Settings.AutoQuest
            and MyLoopID == self.LoopID
        do
            local Success,
                ErrorMessage =
                pcall(function()
                    local Config =
                        self:GetConfig()

                    if not Config then
                        return
                    end

                    local Card =
                        self:FindQuestCard(
                            Config
                        )

                    local QuestConfirmed =
                        Card
                        and not self:IsComplete(
                            Card,
                            Config
                        )

                    if QuestConfirmed then
                        -- The quest is really active now. Stop sending
                        -- AddQuest and re-arm the one-time Krue teleport
                        -- for the NEXT quest cycle.
                        self.CompletionSeenAt =
                            nil

                        self.TeleportedForAcceptance =
                            false

                        return
                    end

                    -- No active quest, or the old quest card is complete.
                    -- Keep retrying AddQuest until the UI confirms a fresh,
                    -- incomplete copy of the selected quest.
                    if Card then
                        if not self.CompletionSeenAt then
                            self.CompletionSeenAt =
                                os.clock()
                        end
                    else
                        self.CompletionSeenAt =
                            nil
                    end

                    self:AcceptSelected()
                end)

            if not Success then
                warn(
                    "[Combat Hub] Auto Quest recovered: "
                        .. tostring(
                            ErrorMessage
                        )
                )

                self.Busy = false
            end

            task.wait(
                self.UpdateInterval
            )
        end
    end)
end


function QuestController:Stop()
    Settings.AutoQuest =
        false

    self.LoopID += 1
    self:ResetState()
end


--// ============================================================
--// AUTO FARM QUEST
--// ============================================================

local QuestFarmController = {
    LoopID = 0,
    CurrentTarget = nil,
    ActiveTween = nil,

    LastTweenAt = 0,
    LastTweenDestination = nil,

    FrozenRoot = nil,
    FrozenRootWasAnchored = false,

    SpawnConnection = nil,
    WatchedFolder = nil,
    LastForcedTargetRefresh = 0,
    ForcedTargetRefreshInterval = 0.50,

    -- Main farm scan can stay responsive, but actual tween
    -- retargets are throttled to prevent jitter.
    UpdateInterval = 0.05,
    TweenRefreshInterval = 0.15,
    TweenDestinationEpsilon = 1.25,

    -- Once Above mode reaches the enemy, stop using physics/tweens
    -- and hard-lock the player's root in the air.
    FreezeLockDistance = 1.00,
}


function QuestFarmController:GetActiveNpcsFolder()
    local Config =
        QuestController:GetConfig()

    local RegionName =
        Config
        and Config.RegionName
        or "Windy Peak"

    local Humanoids =
        workspace:FindFirstChild(
            "Humanoids"
        )

    local Regions =
        Humanoids
        and Humanoids:FindFirstChild(
            "Regions"
        )

    local Region =
        Regions
        and Regions:FindFirstChild(
            RegionName
        )

    return Region
        and Region:FindFirstChild(
            "ActiveNpcs"
        )
end


function QuestFarmController:DisconnectSpawnWatcher()
    if self.SpawnConnection then
        self.SpawnConnection:Disconnect()
        self.SpawnConnection = nil
    end

    self.WatchedFolder = nil
end


function QuestFarmController:EnsureSpawnWatcher()
    local Folder =
        self:GetActiveNpcsFolder()

    if Folder == self.WatchedFolder
        and self.SpawnConnection
    then
        return
    end

    self:DisconnectSpawnWatcher()

    if not Folder then
        return
    end

    self.WatchedFolder =
        Folder

    self.SpawnConnection =
        Folder.DescendantAdded:Connect(
            function(Object)
                if not HubRunning
                    or not Settings.AutoFarmQuest
                then
                    return
                end

                local Config =
                    QuestController:GetConfig()

                if not Config
                    or not Config.EnemyName
                then
                    return
                end

                -- New NPCs can replicate as a container first and their
                -- actual model a moment later. Any matching descendant
                -- wakes the farm and forces a fresh target search.
                if Object.Name
                    == Config.EnemyName
                    or (
                        Object.Parent
                        and Object.Parent.Name
                            == Config.EnemyName
                    )
                then
                    self.CurrentTarget =
                        nil

                    self.LastForcedTargetRefresh =
                        0
                end
            end
        )
end


function QuestFarmController:GetEnemyObject(
    Container,
    EnemyName
)
    if not Container then
        return nil
    end

    -- Known structures include:
    -- Windy Peak: ActiveNpcs.Bandit.Bandit / Zuko.Zuko
    -- Bamboo Grove: a container containing "Bear Cub"
    local NamedChild =
        Container:FindFirstChild(
            EnemyName
        )

    if NamedChild
        and (
            NamedChild:IsA("Model")
            or NamedChild:IsA("BasePart")
        )
    then
        return NamedChild
    end

    if Container.Name == EnemyName
        and (
            Container:IsA("Model")
            or Container:IsA("BasePart")
        )
    then
        return Container
    end

    for _, Object in ipairs(
        Container:GetDescendants()
    ) do
        if Object.Name == EnemyName
            and (
                Object:IsA("Model")
                or Object:IsA("BasePart")
            )
        then
            return Object
        end
    end

    return nil
end


function QuestFarmController:GetTargetPosition(
    Object
)
    if not Object
        or not Object.Parent
    then
        return nil
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.Position
    end

    if Object:IsA(
        "Model"
    ) then
        return Object:GetPivot().Position
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.Position
        or nil
end


function QuestFarmController:GetTargetCFrame(
    Object
)
    if not Object
        or not Object.Parent
    then
        return nil
    end

    if Object:IsA(
        "BasePart"
    ) then
        return Object.CFrame
    end

    if Object:IsA(
        "Model"
    ) then
        return Object:GetPivot()
    end

    local Part =
        Object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    return Part
        and Part.CFrame
        or nil
end


function QuestFarmController:IsAlive(
    Object
)
    if not Object
        or not Object.Parent
    then
        return false
    end

    local Humanoid =
        Object:FindFirstChildWhichIsA(
            "Humanoid",
            true
        )

    if Humanoid then
        return Humanoid.Health > 0
    end

    local Dead =
        Object:GetAttribute(
            "Dead"
        )

    if Dead == true then
        return false
    end

    local Health =
        tonumber(
            Object:GetAttribute(
                "Health"
            )
            or Object:GetAttribute(
                "HP"
            )
        )

    if Health ~= nil
        and Health <= 0
    then
        return false
    end

    return true
end


function QuestFarmController:FindTarget(
    EnemyName
)
    local Folder =
        self:GetActiveNpcsFolder()

    if not Folder then
        return nil
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    local RootPosition =
        Root
        and Root.Position
        or Vector3.zero

    local BestTarget = nil
    local BestDistance = math.huge
    local Seen = {}

    local function Consider(
        Enemy
    )
        if not Enemy
            or Seen[Enemy]
            or Enemy.Name ~= EnemyName
            or not (
                Enemy:IsA("Model")
                or Enemy:IsA("BasePart")
            )
            or not Enemy:IsDescendantOf(
                Folder
            )
        then
            return
        end

        Seen[Enemy] = true

        if not self:IsAlive(
            Enemy
        ) then
            return
        end

        local TargetRoot =
            self:GetStableTargetRoot(
                Enemy
            )

        if not TargetRoot
            or not TargetRoot.Parent
        then
            return
        end

        local Position =
            TargetRoot.Position

        local Distance =
            (
                Position
                - RootPosition
            ).Magnitude

        if Distance
            < BestDistance
        then
            BestDistance =
                Distance

            BestTarget =
                Enemy
        end
    end

    -- Keep the known container layout fast.
    for _, Container in ipairs(
        Folder:GetChildren()
    ) do
        if Container.Name == EnemyName then
            Consider(
                self:GetEnemyObject(
                    Container,
                    EnemyName
                )
            )
        end
    end

    -- Fallback: NPC replication/order can change, so also search every
    -- descendant for a matching model/part.
    for _, Object in ipairs(
        Folder:GetDescendants()
    ) do
        Consider(
            Object
        )
    end

    return BestTarget
end


function QuestFarmController:GetCurrentTarget(
    EnemyName
)
    local Folder =
        self:GetActiveNpcsFolder()

    local Target =
        self.CurrentTarget

    local TargetValid =
        Folder
        and Target
        and Target.Parent
        and Target.Name == EnemyName
        and Target:IsDescendantOf(
            Folder
        )
        and self:IsAlive(
            Target
        )
        and self:GetStableTargetRoot(
            Target
        ) ~= nil

    local Now =
        os.clock()

    local ForceRefresh =
        Now - self.LastForcedTargetRefresh
            >= self.ForcedTargetRefreshInterval

    if TargetValid
        and not ForceRefresh
    then
        return Target
    end

    local FreshTarget =
        self:FindTarget(
            EnemyName
        )

    self.LastForcedTargetRefresh =
        Now

    if FreshTarget then
        self.CurrentTarget =
            FreshTarget

        return FreshTarget
    end

    if not TargetValid then
        self.CurrentTarget =
            nil

        return nil
    end

    -- If the old target is still genuinely valid and no better target
    -- was found, keep it instead of unnecessarily dropping the farm.
    return Target
end


function QuestFarmController:GetStableTargetRoot(
    Target
)
    if not Target
        or not Target.Parent
    then
        return nil
    end

    if Target:IsA(
        "BasePart"
    ) then
        return Target
    end

    if Target:IsA(
        "Model"
    ) then
        local Root =
            Target:FindFirstChild(
                "HumanoidRootPart",
                true
            )
            or Target.PrimaryPart
            or Target:FindFirstChild(
                "RootPart",
                true
            )
            or Target:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        return Root
    end

    return Target:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end


function QuestFarmController:UnfreezeCharacter()
    local Root =
        self.FrozenRoot

    if Root
        and Root.Parent
    then
        pcall(function()
            Root.AssemblyLinearVelocity =
                Vector3.zero

            Root.AssemblyAngularVelocity =
                Vector3.zero

            Root.Anchored =
                self.FrozenRootWasAnchored
        end)
    end

    self.FrozenRoot = nil
    self.FrozenRootWasAnchored = false
end


function QuestFarmController:FreezeAt(
    Root,
    FarmCFrame
)
    if not Root
        or not Root.Parent
    then
        return false
    end

    self:CancelTween()

    if self.FrozenRoot ~= Root then
        self:UnfreezeCharacter()

        self.FrozenRoot =
            Root

        self.FrozenRootWasAnchored =
            Root.Anchored
    end

    Root.AssemblyLinearVelocity =
        Vector3.zero

    Root.AssemblyAngularVelocity =
        Vector3.zero

    Root.Anchored =
        true

    -- While anchored there is no physics fighting the farm CFrame,
    -- so the player stays perfectly fixed above the enemy.
    Root.CFrame =
        FarmCFrame

    self.LastTweenDestination =
        FarmCFrame

    return true
end


function QuestFarmController:CancelTween()
    local Tween =
        self.ActiveTween

    self.ActiveTween = nil

    if Tween then
        pcall(function()
            Tween:Cancel()
        end)
    end
end


function QuestFarmController:MoveToFarmCFrame(
    Character,
    Root,
    FarmCFrame
)
    local IsAbove =
        Settings.QuestFarmPosition
        == "Above"

    local Distance =
        (
            FarmCFrame.Position
            - Root.Position
        ).Magnitude

    -- ABOVE MODE:
    -- Once the tween gets close enough, anchor the HumanoidRootPart.
    -- From that point on the character is "frozen" in the air and we
    -- only update the exact locked CFrame as the enemy position changes.
    if IsAbove then
        if self.FrozenRoot == Root
            and Root.Anchored
        then
            return self:FreezeAt(
                Root,
                FarmCFrame
            )
        end

        if Distance
            <= self.FreezeLockDistance
        then
            return self:FreezeAt(
                Root,
                FarmCFrame
            )
        end
    else
        self:UnfreezeCharacter()
    end

    local Now =
        os.clock()

    local DestinationMoved =
        math.huge

    if self.LastTweenDestination then
        DestinationMoved =
            (
                FarmCFrame.Position
                - self.LastTweenDestination.Position
            ).Magnitude
    end

    -- Let the current tween keep running instead of recreating it
    -- every scan. This is only the travel phase; Above switches to
    -- a hard anchored lock as soon as it arrives.
    if self.ActiveTween
        and Now - self.LastTweenAt
            < self.TweenRefreshInterval
        and DestinationMoved
            < self.TweenDestinationEpsilon
    then
        return true
    end

    local Speed =
        math.clamp(
            tonumber(
                Settings.QuestTweenSpeed
            )
            or 100,
            10,
            300
        )

    local Duration =
        math.max(
            Distance / Speed,
            0.06
        )

    self:CancelTween()

    local Tween =
        TweenService:Create(
            Root,
            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                CFrame = FarmCFrame,
            }
        )

    self.ActiveTween =
        Tween

    self.LastTweenAt =
        Now

    self.LastTweenDestination =
        FarmCFrame

    Tween:Play()

    return true
end


function QuestFarmController:HoverOverTarget(
    Target
)
    local TargetCFrame =
        self:GetTargetCFrame(
            Target
        )

    if not TargetCFrame then
        return false
    end

    local Character =
        LocalPlayer.Character

    local Root =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Character
        or not Root
    then
        return false
    end

    local Distance =
        math.clamp(
            tonumber(
                Settings.QuestFarmDistance
            )
            or 10,
            3,
            30
        )

    local Mode =
        Settings.QuestFarmPosition
        or "Above"

    local FarmPosition
    local FarmCFrame

    if Mode == "Behind" then
        local TargetPosition =
            TargetCFrame.Position

        FarmPosition =
            TargetPosition
            - (
                TargetCFrame.LookVector
                * Distance
            )

        FarmCFrame =
            CFrame.lookAt(
                FarmPosition,
                TargetPosition,
                Vector3.yAxis
            )

    elseif Mode == "Below" then
        local TargetPosition =
            TargetCFrame.Position

        FarmPosition =
            TargetPosition
            - Vector3.new(
                0,
                Distance,
                0
            )

        FarmCFrame =
            CFrame.lookAt(
                FarmPosition,
                TargetPosition,
                Vector3.new(
                    0,
                    0,
                    1
                )
            )

    else
        -- ABOVE MODE uses the NPC's stable root instead of the animated
        -- Model pivot / Head position. That prevents attack animations
        -- from making the player's locked position shake.
        local StableTargetRoot =
            self:GetStableTargetRoot(
                Target
            )

        if not StableTargetRoot then
            return false
        end

        local StableTargetCFrame =
            StableTargetRoot.CFrame

        local StableTargetPosition =
            StableTargetCFrame.Position

        -- Aim approximately at the enemy's head while keeping the actual
        -- tracking source on HumanoidRootPart for stability.
        local HeadOffset = 2.5

        local Head =
            Target:FindFirstChild(
                "Head",
                true
            )

        if Head
            and Head:IsA(
                "BasePart"
            )
        then
            HeadOffset =
                math.clamp(
                    Head.Position.Y
                        - StableTargetPosition.Y,
                    1.5,
                    4.5
                )
        end

        local AimPosition =
            StableTargetPosition
            + Vector3.new(
                0,
                HeadOffset,
                0
            )

        FarmPosition =
            AimPosition
            + Vector3.new(
                0,
                Distance,
                0
            )

        -- Use the enemy's horizontal facing direction as the roll
        -- reference. The player's FRONT (-Z) points down at the head.
        local StableUp =
            Vector3.new(
                StableTargetCFrame.LookVector.X,
                0,
                StableTargetCFrame.LookVector.Z
            )

        if StableUp.Magnitude
            < 0.001
        then
            StableUp =
                Vector3.new(
                    0,
                    0,
                    -1
                )
        else
            StableUp =
                StableUp.Unit
        end

        FarmCFrame =
            CFrame.lookAt(
                FarmPosition,
                AimPosition,
                StableUp
            )
    end

    return self:MoveToFarmCFrame(
        Character,
        Root,
        FarmCFrame
    )
end


function QuestFarmController:ResetTarget()
    self.CurrentTarget = nil
    self:CancelTween()
    self:UnfreezeCharacter()

    self.LastTweenAt = 0
    self.LastTweenDestination = nil
    self.LastForcedTargetRefresh = 0
end


function QuestFarmController:Start()
    self.LoopID += 1

    local MyLoopID =
        self.LoopID

    self:ResetTarget()
    self:EnsureSpawnWatcher()

    task.spawn(function()
        while HubRunning
            and Settings.AutoFarmQuest
            and MyLoopID == self.LoopID
        do
            local Success,
                ErrorMessage =
                pcall(function()
                    self:EnsureSpawnWatcher()

                    local Config =
                        QuestController:GetConfig()

                    local Card =
                        Config
                        and QuestController:FindQuestCard(
                            Config
                        )
                        or nil

                    local QuestActive =
                        Config
                        and Config.EnemyName
                        and Card
                        and not QuestController:IsComplete(
                            Card,
                            Config
                        )

                    if not QuestActive then
                        self:ResetTarget()
                        return
                    end

                    local Target =
                        self:GetCurrentTarget(
                            Config.EnemyName
                        )

                    if Target then
                        self:HoverOverTarget(
                            Target
                        )
                    else
                        -- Do NOT stop the farm worker when the current wave
                        -- is empty. Keep the loop alive and force another
                        -- target search as soon as anything respawns.
                        self.CurrentTarget =
                            nil
                    end
                end)

            if not Success then
                warn(
                    "[Combat Hub] Auto Farm Quest recovered: "
                        .. tostring(
                            ErrorMessage
                        )
                )

                self.CurrentTarget =
                    nil

                self.LastForcedTargetRefresh =
                    0
            end

            task.wait(
                self.UpdateInterval
            )
        end
    end)
end


function QuestFarmController:Stop()
    Settings.AutoFarmQuest =
        false

    self.LoopID += 1
    self:ResetTarget()
    self:DisconnectSpawnWatcher()
end


