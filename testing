local function walkPathTo(goal, token)
    local root = getRoot()
    local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local waypoints
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, AgentHeight = 5, AgentCanJump = true,
        WaypointSpacing = 4,
    })
    local ok = pcall(function() path:ComputeAsync(root.Position, goal) end)
    if ok and path.Status == Enum.PathStatus.Success then
        waypoints = path:GetWaypoints()
    else
        waypoints = {{Position = goal}}
    end
    for _, point in ipairs(waypoints) do
        if not running or not (autoDungeonFarm or autoDungeonJoin or Aux.autoMobFarm or Aux.autoTravel)
            or token ~= dungeonMovementToken then break end
        root = getRoot()
        if not root then break end
        if point.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
        hum:MoveTo(point.Position)
        local deadline = os.clock() + 1.6
        while running and token == dungeonMovementToken
            and os.clock() < deadline do
            root = getRoot()
            if not root or (root.Position - point.Position).Magnitude < 3.5 then break end
            task.wait(0.12)
        end
    end
end

-- Navigation is only used for an eligible dungeon portal, or an enemy
-- identified inside the dungeon. There is no path to unavailable instances.
local function navigateTo(goal, lookAt, useMethod, closeEnough)
    local root = getRoot()
    if not root then return end
    local now = os.clock()
    local dist = (root.Position - goal).Magnitude
    if dist <= (closeEnough or 2) then
        if useMethod == "Legit" then return end
        cancelDungeonTween() -- do not drift past a settled target
        currentMovementGoal = nil
        if now < nextMovementAction then return end
        if lookAt and dist > 0.4 then
            root.CFrame = CFrame.lookAt(root.Position, lookAt)
        end
        nextMovementAction = now + 0.4
        return
    end
    if now < nextMovementAction then return end

    -- Avoid restarting the same tween every 0.3 seconds. It causes movement
    -- jitter even when a target barely moves. Continue the existing tween
    -- unless the goal moved by more than 2 studs.
    if useMethod == "Tween" and currentDungeonTween and currentMovementGoal
        and (currentMovementGoal - goal).Magnitude < 2.0
        and currentDungeonTween.PlaybackState == Enum.PlaybackState.Playing then
        nextMovementAction = now + 0.2
        return
    end

    if useMethod == "Legit" then
        if now < nextLegitRepath then return end
        nextLegitRepath = now + 1.6
        dungeonMovementToken += 1
        local token = dungeonMovementToken
        cancelDungeonTween()
        task.spawn(function()
            local ok, err = pcall(walkPathTo, goal, token)
            if not ok then warn("[Tame V13] Pathfinding:", err) end
        end)
        nextMovementAction = now + 0.4
        return
    end

    dungeonMovementToken += 1
    cancelDungeonTween()
    currentMovementGoal = goal
    local destination = (lookAt and (lookAt - goal).Magnitude > 0.05)
        and CFrame.lookAt(goal, lookAt) or CFrame.new(goal)
    if useMethod == "Teleport" then
        root.CFrame = destination
        nextMovementAction = now + 0.28
    else
        local duration = math.clamp(dist / 65, 0.14, 2.2)
        currentDungeonTween = TweenService:Create(root, TweenInfo.new(
            duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out
        ), {CFrame = destination})
        currentDungeonTween:Play()
        nextMovementAction = now + math.min(0.75, math.max(0.3, duration * 0.7))
    end
end

