function Hub:V50ReelTick(now)
    local E=self.V44
    if not E.FishControl or not (E.FishSession or E.FishNativeSession) then return end
    local t=now-E.FishStartAt
    E.FishReel.Advance(E.FishControl,t)
    local start,width=E.FishReel.GoalSpan(E.FishControl,t)
    local current=E.FishReel.BarLeft(E.FishControl.Value)
    local goal=start+width*.5-E.FishConfig.Bar.Width*.5
    local want=E.FishLastHold
    if current<goal-.006 then want=true elseif current>goal+.006 then want=false end
    if want~=E.FishLastHold and now>=(E.FishHoldNextAt or 0) then
        E.FishReel.SetHolding(E.FishControl,t,want)
        E.FishLastHold=want
        E.FishHoldNextAt=now+.034 -- avoid exceeding FishingConfig.MaxMessagesPerSecond
        if E.FishBackend=="Native" then
            self:V60NativeFishInput(want)
        else
            pcall(function() E.FishService.Hold:Fire(E.FishSession,want,t) end)
        end
    end
    if now>=(E.FishReelStatusAt or 0) then
        E.FishReelStatusAt=now+.3
        E.FishStatus=string.format("Reeling %s | %d%%",tostring(E.FishBite.Tier or "fish"),math.floor(100*E.FishReel.Progress(E.FishControl)))
    end
    if t>(E.FishControl.Tier.Time+3) then
        pcall(function() E.FishService:Reel(E.FishSession or E.FishNativeSession) end)
        if E.FishBackend=="Native" then self:V60NativeFishInput(false) end
        E.FishState="Idle";E.FishSession=nil;E.FishNativeSession=nil
        E.FishControl=nil;E.FishAt=now+2
        E.FishStatus="Fishing result timed out; recovering"
    end
end
function Hub:V50FishWaters()
    local E=self.V44
    local tagged=game:GetService("CollectionService"):GetTagged("FishingWater")
    local waters={}
    for _,part in ipairs(tagged) do
        if part:IsA("BasePart") and part:IsDescendantOf(workspace) then table.insert(waters,part) end
    end
    table.sort(waters,function(a,b)
        if math.abs(a.Position.X-b.Position.X)>1 then return a.Position.X<b.Position.X end
        return a.Position.Z<b.Position.Z
    end)
    for _,part in ipairs(waters) do
        if not E.FishSpotNames[part] then
            local label="Water "..tostring(#E.FishSpots+1).." ("..math.floor(part.Position.X)..", "..math.floor(part.Position.Z)..")"
            E.FishSpotNames[part]=label
            E.FishSpots[#E.FishSpots+1]={Part=part,Label=label}
