--//============================================================
--// STUNS
--//============================================================

local function HasActiveStun(
    Store,
    IgnoreM1
)

    if not Store then
        return false
    end


    local Now =
        workspace:GetServerTimeNow()


    local Success,
        Stuns =
        pcall(function()

            return Store
                .state
                .stuns
                :getAll()
        end)


    if not Success
        or not Stuns
    then

        return false
    end


    for StunName, Stun
        in pairs(
            Stuns
        )
    do

        -- Updated skill input ignores the short M1 stun, while M1 itself
        -- still treats every active stun as blocking.
        if not (IgnoreM1 and StunName == "m1") then

            local SuccessTill,
                Till =
                pcall(function()

                    return Stun
                        .till
                        :get()
                end)


            if SuccessTill
                and Till
                and Now < Till
            then

                return true
            end
        end
    end


    return false
end


-- Mirrors the updated client-only dash / skill-busy state.
GENV.__AZ_FARM_EXT.IsLocalClientBusy = function()

    if not GENV.__AZ_FARM_EXT.LocalClientStore
        or not GENV.__AZ_FARM_EXT.LocalClientStore.state
    then
        return false
    end


    local Success,
        Busy =
        pcall(function()

            if GENV.__AZ_FARM_EXT.LocalClientStore.state.dashing
                and GENV.__AZ_FARM_EXT.LocalClientStore.state.dashing:get()
            then
                return true
            end


            local SkillState =
                GENV.__AZ_FARM_EXT.LocalClientStore.state.skill


            if SkillState then

                if SkillState.pending
                    and SkillState.pending:get()
                then
                    return true
                end


                if SkillState.till
                    and workspace:GetServerTimeNow()
                        < (SkillState.till:get() or 0)
                then
                    return true
                end
            end


            return false
        end)


    return Success
        and Busy == true
end

