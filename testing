-- The income pile is only a client visual. No usable collectible TouchInterest
-- or public cash-claim remote was identified in the client dump. Income is
-- collected by entering the owned base's real collection zone, so we briefly
-- visit that zone and return to the original spot (without buying the pass).
-- Collection waits until outside raids/queues and limits repeated teleports.
local moneyWalkBusy = false -- shared with Auto Join to prevent movement races
local lastMoneyStatus = nil
local lastMoneyTeleport = -math.huge
local MONEY_COLLECT_INTERVAL = 30 -- seconds between teleports
local function setMoneyStatus(status)
    if status == lastMoneyStatus then return end
    lastMoneyStatus = status
    pcall(function() moneyStatus:Set(status) end)
end
local function tickCollectMoney()
    if not enabled.CollectMoney or moneyWalkBusy then return end
    local data = dataNow()
    if not data then return end
    if (data.monetization or {}).passes
        and data.monetization.passes.AutoCollect == true then
        setMoneyStatus("Auto Collect pass already active: income collects without movement.")
        return
    end
    if isInRaid() or LocalPlayer:GetAttribute("GateQueue")
        or LocalPlayer:GetAttribute("Traveling") or SkillState.Cinematic then
        setMoneyStatus("Money collection paused while in a dungeon, gate queue or cinematic.")
        return
    end
    local base = getOwnedBase()
    local character, root = getCharacter()
    if not base or not character or not root then
        setMoneyStatus("Waiting for your character and owned base.")
        return
    end
    local ok, anchor = pcall(IncomeMath.anchor, base)
    if not ok or typeof(anchor) ~= "CFrame" then
        setMoneyStatus("Could not find your base's collection marker.")
        return
    end
    local balance = tonumber(base:GetAttribute(IncomeConfig.BalanceAttribute)) or 0
    if balance <= 0 then
        setMoneyStatus("Your base has no unclaimed money.")
        return
    end
    local incomeRate = tonumber(LocalPlayer:GetAttribute("IncomePerSecond")) or 0
    local radius = IncomeMath.collectionRadius(base, anchor, balance, incomeRate)
    if IncomeMath.inCollectionZone(root.Position, anchor, radius) then
        setMoneyStatus("Already in your base's collection zone; server handles collection.")
        return
    end
    local secondsToNext = MONEY_COLLECT_INTERVAL - (os.clock() - lastMoneyTeleport)
    if secondsToNext > 0 then
        setMoneyStatus("Unclaimed $" .. formatNum(balance)
            .. " | Next collection in " .. math.ceil(secondsToNext) .. "s")
        return
    end

    -- Save the actual character orientation and position before teleporting.
    -- We return to it even when claiming fails, without interrupting raids.
    moneyWalkBusy = true
    lastMoneyTeleport = os.clock()
    local originalCFrame = character:GetPivot()
    local collectionPosition = anchor.Position + Vector3.new(0, 2.5, 0)
    local originalOrientation = originalCFrame - originalCFrame.Position
    setMoneyStatus("Collecting $" .. formatNum(balance) .. " from your base...")
    task.spawn(function()
        local claimed = false
        local okVisit, err = pcall(function()
            if not alive or not enabled.CollectMoney or isInRaid()
                or LocalPlayer:GetAttribute("GateQueue") or LocalPlayer.Character ~= character then
                return
            end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            character:PivotTo(CFrame.new(collectionPosition) * originalOrientation)
            -- The collection-zone check runs on the server's own interval.
            local deadline = os.clock() + 3
            while os.clock() < deadline and alive and LocalPlayer.Character == character do
                task.wait(0.2)
                local newBalance = tonumber(base:GetAttribute(IncomeConfig.BalanceAttribute)) or 0
                if newBalance + math.max(1, incomeRate * 0.2) < balance then
                    claimed = true
                    break
                end
            end
        end)
        if not okVisit then warn("[Arise V10] Money collection visit:", err) end
        if LocalPlayer.Character == character and root.Parent
            and not isInRaid() and not LocalPlayer:GetAttribute("Traveling") then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                character:PivotTo(originalCFrame)
            end)
        end
        moneyWalkBusy = false
        if alive then
            setMoneyStatus(claimed
                and "Collected base income and returned to your original position."
                or "Returned to your original position; collection not confirmed.")
        end
    end)
end

-- Auto Buy ignores the equip preference. That dropdown belongs exclusively
-- to Auto Equip Aura, as requested.
local function bestAura(data, onlyUnowned, cash, selectedTypes)
    local best
    for id, aura in pairs(AuraConfig.ById or {}) do
        if type(aura) == "table"
            and (selectedTypes == nil or selectedTypes[aura.Stat]) then
            local owned = AuraRules.owns(data, id)
            local eligible = onlyUnowned
                and not owned and type(aura.Cost) == "number" and not aura.Pass
                and not aura.Event and aura.Cost <= cash
                or (not onlyUnowned and owned)
            if eligible and (not best
                or (aura.Multiplier or 0) > (best.Multiplier or 0)
                or ((aura.Multiplier or 0) == (best.Multiplier or 0) and id < best.Id)) then
                best = { Id = id, Multiplier = aura.Multiplier or 0, Cost = aura.Cost or 0 }
            end
        end
    end
    return best
end

local function tickAuras()
    local data = dataNow()
    if not data then return end
    local cash = (data.base or {}).money or 0
    if enabled.BuyAura and type(cash) == "number" then
