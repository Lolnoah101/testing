            local function GetAccountStats(Participant)

                local Loaded =
                    LoadModules()

                local Stats = {
                    Level = "N/A",
                    Money = 0,
                    Gems = 0,
                    Rolls = 0,
                    TraitRerolls = 0,
                    Played = 0,
                    Wins = 0,
                    Kills = 0,
                    Deaths = 0,
                    Damage = 0,
                }


                if not Loaded
                    or not Loaded.AccountNamespace
                then
                    return Stats
                end


                local Account =
                    Loaded.AccountNamespace
                        .getLocalPlayerAccount()


                if not Account
                    or not Account.state
                then
                    return Stats
                end


                local Currency =
                    Account.state.currencies


                if Currency then

                    Stats.Money =
                        tonumber(
                            ReadLeaf(Currency.money)
                        ) or 0

                    Stats.Gems =
                        tonumber(
                            ReadLeaf(Currency.gems)
                        ) or 0

                    Stats.Rolls =
                        tonumber(
                            ReadLeaf(Currency.rolls)
                        ) or 0

                    Stats.TraitRerolls =
                        tonumber(
