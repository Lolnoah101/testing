local function getInventoryCapacity(data)
    local slots = (data.Gamepasses and data.Gamepasses["Extra Inventory Slots"]) and 250 or 50
    local achievements = data.Achievements
    local sharedAchievements = nativeController and nativeController.Shared
        and nativeController.Shared.Achievements
    if type(achievements) == "table" and type(sharedAchievements) == "table" then
        for achievement, achieved in pairs(achievements) do
            local definition = achieved and sharedAchievements[achievement]
            if definition and type(definition.Perks) == "table" then
                for perk, amount in pairs(definition.Perks) do
                    if perk == "Inventory" and type(amount) == "number" then
                        slots = slots + amount
                    end
                end
            end
        end
    end
    return slots
end


-- Full-cycle inventory cleanup. Reaching the configured fullness threshold
-- STARTS a cycle. Continue that cycle even after the inventory becomes less
-- than the trigger percentage, until there are no more eligible materials to
-- fuse/sell. This avoids leaving most selected units behind.
--
-- Each native Fuse request accepts ONE destination ID plus a complete list of
-- material IDs. The server can change inventory after each request, so only
-- send one BULK request per snapshot, then wait for replicated confirmation.
-- Sell_Bulk also accepts an entire list of matching unit IDs.
local function updateUnitsInventory()
    local data, err = getInventoryData()
    if not data then
        setCleanupStatus(err or "Inventory not ready")
        return
    end

    local now = os.clock()
    local inventorySignature = unitInventorySignature(data) -- material IDs
    local eligibilitySignature = state.UnitEligibilitySignature(data) -- states/levels too
    local capacity = getInventoryCapacity(data)
    if type(capacity) ~= "number" or capacity < 1 then
        setCleanupStatus("Cannot determine unit inventory capacity")
        return
    end

    local ownedCount = 0
    for _ in pairs(data.Shadows) do ownedCount = ownedCount + 1 end
    local threshold = math.ceil(capacity * state.CleanupThreshold / 100)
    local prefix = string.format("Inventory: %d/%d | Cleanup starts at %d (%d%%). ",
        ownedCount, capacity, threshold, state.CleanupThreshold)

    -- Unlock cleanup when new units arrive OR when lock/equip/level changes.
    -- ID-only checks previously left the automation blocked indefinitely.
    if state.LastFuseInventorySignature ~= eligibilitySignature then
        state.LastFuseInventorySignature = eligibilitySignature
        state.FuseAttemptedBatches = {}
        state.LastSellSignature = nil
        state.CleanupBlockedSignature = nil
        state.CleanupBlockedReason = nil
        state.CleanupBlockedUntil = 0
        -- Per-operation failures persist until the corresponding operation
        -- succeeds. Otherwise unrelated inventory changes defeat backoff.
    end

    local function scheduleRetry(kind, attemptedCount, reason)
        local action = kind == "Bulk Fuse" and "Fuse" or "Sell"
        local failures = math.min((state.CleanupFailures[action] or 0) + 1, 7)
        local delaySeconds = math.min(180, 15 * (2 ^ (failures - 1)))
        state.CleanupFailures[action] = failures
        state.CleanupRetryAt[action] = now + delaySeconds
        -- Keep the overall cycle alive, but delay ONLY the failed action.
        -- An unconfirmed Fuse no longer prevents a valid Sell from running.
        state.CleanupCycleActive = true
        if attemptedCount and attemptedCount > 1 then
            local reduced = math.max(1, math.floor(attemptedCount / 2))
            if action == "Fuse" then
                state.FuseBatchLimit = math.min(state.FuseBatchLimit or math.huge, reduced)
            else
                state.SellBatchLimit = math.min(state.SellBatchLimit or math.huge, reduced)
            end
        end
        local status = string.format("%s Next %s retry in %ds (failed %d time(s), batch limit=%s).",
            reason, action, delaySeconds, failures,
            tostring(action == "Fuse" and (state.FuseBatchLimit or "all")
                or (state.SellBatchLimit or "all")))
        setCleanupStatus(prefix .. status)
        warn("[Paraiso Units] " .. status)
    end

    local pending = state.PendingCleanupAction
    if pending then
        -- Summoning can add unrelated units while cleanup waits. That must
        -- NOT be mistaken for confirmation that Fuse/Sell actually worked.
        local consumedOne = false
        if type(pending.materialIds) == "table" then
            for _, usedId in ipairs(pending.materialIds) do
                if data.Shadows[usedId] == nil then
                    consumedOne = true
                    break
                end
            end
        else
            consumedOne = pending.inventorySignature ~= inventorySignature
        end
        if consumedOne then
            -- At least one of the requested material IDs actually disappeared.
            state.PendingCleanupAction = nil
            local action = pending.kind == "Bulk Fuse" and "Fuse" or "Sell"
            state.CleanupFailures[action] = 0
            state.CleanupRetryAt[action] = 0
            state.CleanupBlockedSignature = nil
            state.CleanupBlockedUntil = 0
            if pending.kind == "Bulk Fuse" and state.FuseBatchLimit then
                state.FuseBatchLimit = math.min(128, state.FuseBatchLimit * 2)
            elseif pending.kind == "Bulk Sell" and state.SellBatchLimit then
                state.SellBatchLimit = math.min(128, state.SellBatchLimit * 2)
            end
        elseif now - pending.sentAt < 12 then
            setCleanupStatus(prefix .. string.format(
                "Waiting for %s confirmation (%d IDs).", pending.kind, pending.count))
            return
        else
            -- Server rejected or delayed a request: never freeze forever.
            -- Retry with exponential backoff and smaller batches.
            state.PendingCleanupAction = nil
            scheduleRetry(pending.kind, pending.count,
                pending.kind .. " was not confirmed by inventory replication.")
            return
        end
    end

    local cleanEnabled = state.AutoFuse or state.AutoSell
    if not cleanEnabled then
        state.CleanupCycleActive = false
    end

    local function maybeEquipBest()
        if not state.AutoEquipBest then return false end
        if now - state.LastInventoryActionAt < 1.5 then return false end
        if inventorySignature == state.LastEquipSignature
            and now - state.LastEquipBestAt < 30 then
            return false
        end
        state.LastEquipSignature = inventorySignature
        state.LastEquipBestAt = now
        state.LastInventoryActionAt = now
        bridge:FireServer("General", "Shadows", "Equip_Best")
        return true
    end

    if state.CleanupBlockedSignature == eligibilitySignature
        and now < (state.CleanupBlockedUntil or math.huge) then
        local untilRetry = state.CleanupBlockedUntil
        if untilRetry == math.huge then
            setCleanupStatus(prefix .. (state.CleanupBlockedReason
                or "Waiting for eligible units or settings to change."))
        else
            setCleanupStatus(prefix .. string.format("%s Next retry in %ds.",
                state.CleanupBlockedReason or "Cleanup temporarily paused.",
                math.ceil(untilRetry - now)))
        end
        return
    end

    if not state.CleanupCycleActive then
        if cleanEnabled and ownedCount >= threshold then
            state.CleanupCycleActive = true
            state.CleanupCycleStartCount = ownedCount
        else
            maybeEquipBest()
            if not cleanEnabled then
                setCleanupStatus(prefix .. "Auto Fuse and Auto Sell are OFF.")
            else
                setCleanupStatus(prefix .. "Waiting for cleanup threshold.")
            end
            return
        end
    end

    if now - state.LastInventoryActionAt < 1.5 then
        setCleanupStatus(prefix .. "Full cleanup active; waiting for action cooldown.")
        return
    end

    -- The game has its own Auto Fuse/Sell. Running two controllers at once
    -- can produce conflicting inventory snapshots; pause with a clear reason.
    local options = data.AntiAfk
    if type(options) == "table" then
        if (type(options.Auto_Fuse) == "table" and options.Auto_Fuse.Enabled)
            or (type(options.Auto_Sell) == "table" and options.Auto_Sell.Enabled) then
            setCleanupStatus(prefix .. "Disable the GAME'S built-in Auto Fuse/Sell first.")
            return
        end
    end

    local targetIds, materialIds, sellIds = {}, {}, {}
    local maxLevel = (gameStats and tonumber(gameStats.MaxLevel)) or 45
    local protectedCount, unrecognizedCount = 0, 0
    for id, owned in pairs(data.Shadows) do
        local definition = getUnitDefinition(owned)
        local rarity = definition and definition.Rarity
        if rarity then
            if data.Shadows_Equipped[id] then
                if not definition.VIP and rarity ~= "Exclusive"
                    and (tonumber(owned.Level) or 0) < maxLevel then
                    targetIds[#targetIds + 1] = id
                end
            elseif isProtectedUnit(data, id, owned, definition) then
                protectedCount = protectedCount + 1
            else
                if state.AutoFuse and state.FuseMaterials[rarity] then
                    materialIds[#materialIds + 1] = id
                end
                if state.AutoSell and state.SellRarities[rarity] then
                    sellIds[#sellIds + 1] = id
                end
            end
        else
            unrecognizedCount = unrecognizedCount + 1
        end
    end
    sortedIds(targetIds)
    sortedIds(materialIds)
    sortedIds(sellIds)

    local fusePossible = state.AutoFuse and hasSelections(state.FuseMaterials)
        and #targetIds > 0 and #materialIds > 0

    if fusePossible and now >= (state.CleanupRetryAt.Fuse or 0) then
        -- Rotate the first destination each time to feed all equipped units
        -- rather than repeatedly putting every material into the first unit.
        local rotation = ((state.NextFuseTargetIndex - 1) % #targetIds) + 1
        local rotatedTargets = {}
        for i = 1, #targetIds do
            rotatedTargets[i] = targetIds[((rotation + i - 2) % #targetIds) + 1]
        end
        local groups = {}
        for i = 1, #rotatedTargets do groups[i] = {} end
        for i, id in ipairs(materialIds) do
            local groupNumber = ((i - 1) % #rotatedTargets) + 1
            local group = groups[groupNumber]
            group[#group + 1] = id
        end
        local destination = rotatedTargets[1]
        local batch = groups[1]
        if state.FuseBatchLimit and #batch > state.FuseBatchLimit then
            local limited = {}
            for index = 1, state.FuseBatchLimit do
                limited[index] = batch[index]
            end
            batch = limited
        end
        -- Starts with the entire eligible group. Smaller batches are only
        -- used as a recovery strategy after an unconfirmed server request.
        state.LastInventoryActionAt = now
        local ok, requestError = pcall(function()
            bridge:FireServer("General", "Shadows", "Fuse", destination, batch)
        end)
        if ok then
            state.NextFuseTargetIndex = rotation + 1
            state.PendingCleanupAction = {
                kind = "Bulk Fuse", inventorySignature = inventorySignature,
                materialIds = batch, count = #batch, sentAt = os.clock()
            }
            setCleanupStatus(prefix .. string.format(
                "Full cleanup: fusing %d materials into 1 equipped unit; %d eligible material IDs found across %d targets.",
                #batch, #materialIds, #targetIds))
        else
            scheduleRetry("Bulk Fuse", #batch,
                "Bulk Fuse request errored: " .. tostring(requestError))
        end
        return
    end

    -- Fuse first when a rarity is selected for both options. Sell the
    -- remaining selected-rarity units in one request afterward.
    if state.AutoSell and hasSelections(state.SellRarities)
        and now >= (state.CleanupRetryAt.Sell or 0) then
        local saleCandidates = {}
        for _, id in ipairs(sellIds) do
            local owned = data.Shadows[id]
            local definition = owned and getUnitDefinition(owned)
            local rarity = definition and definition.Rarity
            -- Do not accidentally sell fusion materials while Fuse is merely
            -- cooling down. A unit selected for both operations is fused first.
            if not (fusePossible and rarity and state.FuseMaterials[rarity]) then
                saleCandidates[#saleCandidates + 1] = id
            end
        end
        if #saleCandidates == 0 then
            -- A pending fusion retry is handled below without ending the cycle.
        else
        local sellBatch = saleCandidates
        if state.SellBatchLimit and #saleCandidates > state.SellBatchLimit then
            sellBatch = {}
            for index = 1, state.SellBatchLimit do
                sellBatch[index] = saleCandidates[index]
            end
        end
        state.LastInventoryActionAt = now
        local ok, requestError = pcall(function()
            bridge:FireServer("General", "Shadows", "Sell_Bulk", sellBatch)
        end)
        if ok then
            state.PendingCleanupAction = {
                kind = "Bulk Sell", inventorySignature = inventorySignature,
                materialIds = sellBatch, count = #sellBatch, sentAt = os.clock()
            }
            setCleanupStatus(prefix .. string.format(
                "Full cleanup: requested sale of %d eligible units (%d total remaining).",
                #sellBatch, #saleCandidates))
        else
            scheduleRetry("Bulk Sell", #sellBatch,
                "Bulk Sell request errored: " .. tostring(requestError))
        end
        return
        end -- saleCandidates > 0
    end

    -- If either selected operation has eligible units but is in backoff, DO
    -- NOT mark cleanup completed. The next pass will retry automatically.
    local fuseWaiting = fusePossible and now < (state.CleanupRetryAt.Fuse or 0)
    local sellWaiting = state.AutoSell and #sellIds > 0
        and now < (state.CleanupRetryAt.Sell or 0)
    if fuseWaiting or sellWaiting then
        state.CleanupCycleActive = true
        local remaining = math.huge
        if fuseWaiting then
            remaining = math.min(remaining, state.CleanupRetryAt.Fuse - now)
        end
        if sellWaiting then
            remaining = math.min(remaining, state.CleanupRetryAt.Sell - now)
        end
        setCleanupStatus(prefix .. string.format(
            "Cleanup retry pending: %d fuse materials, %d sell candidates; next attempt in %ds.",
            #materialIds, #sellIds, math.max(1, math.ceil(remaining))))
        return
    end

    -- No more work left in this cleanup cycle. Resume the normal trigger:
    -- wait for capacity to reach the threshold again after new units arrive.
    state.CleanupCycleActive = false
    local detail
    if state.AutoFuse and #materialIds > 0 and #targetIds == 0 then
        detail = string.format("%d selected fusion materials remain, but no eligible equipped unit can receive XP.",
            #materialIds)
    elseif state.AutoFuse and not hasSelections(state.FuseMaterials)
        and not (state.AutoSell and hasSelections(state.SellRarities)) then
        detail = "Select at least one Fuse or Sell rarity."
    else
        detail = string.format("Full cleanup completed; %d protected units skipped, %d units of unknown rarity.",
            protectedCount, unrecognizedCount)
    end
    -- Avoid immediately restarting at the same inventory count if every
    -- remaining item is protected or no selected materials remain.
    state.CleanupBlockedSignature = eligibilitySignature
    -- Don't freeze this inventory signature forever: a later game-mode exit,
    -- native Auto Lock change or replication refresh may make it actionable.
    state.CleanupBlockedUntil = now + 20
    state.CleanupBlockedReason = detail
    setCleanupStatus(prefix .. detail)
end

