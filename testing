end

local function nextBoatToBuy()
    local owned = ClientData.Get("OwnedBoats") or {}
    for _, id in ipairs(Boats.Order) do
        local info = Boats[id]
        if info and not ownsBoat(id, owned) then
            return id, info
        end
    end
