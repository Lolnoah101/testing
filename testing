        for Key, Value in pairs(Snapshot) do
            Settings[Key] = Value
        end

        Runtime.Snapshot = nil
        Runtime.LastQueueProfile = nil

        GENV.__AZ_SUPPRESS_ULTIMATE = false

        local Misc =
