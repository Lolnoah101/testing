function Systems.transferBestSkillsToRod(targetRodId)
    if State.SkillTransferBusy
        or not Config.AutoEquipBestSkills then
        return false
    end

    local data = getPlayerData()

    if not data
        or type(data.Rods) ~= "table"
        or data.Rods[targetRodId] == nil then
        State.SkillTransferStatus = "Target rod unavailable"
        return false
    end

    local unlockedSlots =
        Systems.getUnlockedSkillSlotCount(
            data,
            targetRodId
        )

    if unlockedSlots <= 0 then
        State.SkillTransferStatus =
            "No unlocked skill slots on "
            .. tostring(
                Systems.RodIdToName[targetRodId]
                or targetRodId
            )
        State.LastSkillTransferRodId = targetRodId
        return true
    end

    local desired =
        Systems.getBestOwnedSkillIds(
            data,
            unlockedSlots
        )

    if #desired == 0 then
        State.SkillTransferStatus = "No owned skill books"
        State.LastSkillTransferRodId = targetRodId
        return true
    end

    if not EquipmentsController
        or not EquipmentsController.EquipMoveset then
        State.SkillTransferStatus = "EquipMoveset unavailable"
        return false
    end

    State.SkillTransferBusy = true
    State.SkillTransferStatus =
        "Moving best skills to "
        .. tostring(
            Systems.RodIdToName[targetRodId]
            or targetRodId
        )

    local desiredSet = {}

    for _, skillId in ipairs(desired) do
        desiredSet[skillId] = true
    end

    -- First free the desired skill books from every other rod.
    -- EquipMoveset always edits the currently equipped rod, so source
    -- rods are equipped briefly, their desired skills are removed,
    -- then the target rod is restored.
    local sourceRemovals = {}

    for rodId, rodData in pairs(data.Rods) do
        if rodId ~= targetRodId
            and type(rodData) == "table"
            and type(rodData.BookSlots) == "table" then

            for index = 1, 4 do
                local slotName = "Slot" .. tostring(index)
                local skillId = rodData.BookSlots[slotName]

                if desiredSet[skillId] then
                    sourceRemovals[rodId] =
                        sourceRemovals[rodId] or {}

                    table.insert(
                        sourceRemovals[rodId],
                        index
                    )
                end
            end
        end
    end

    local function fail(message)
        pcall(function()
            Systems.rawEquipRod(targetRodId)
        end)

        State.SkillTransferBusy = false
        State.SkillTransferStatus = message
        State.LastObservedRodId = nil
        State.LastRodWatchCheck = 0
        State.AutoEquipRodLastAt = 0
        State.AutoEquipRodPendingUntil = 0

        if Config.Enabled then
            resetOPSession(0.35)
        end

        return false
    end

    for sourceRodId, slotIndexes in pairs(sourceRemovals) do
        if not Systems.rawEquipRod(sourceRodId) then
            return fail(
                "Could not equip source rod for skill transfer"
            )
        end

        for _, slotIndex in ipairs(slotIndexes) do
            local ok, response = pcall(function()
                return EquipmentsController.EquipMoveset:Fire(
                    "",
                    slotIndex
                )
            end)

            if not ok or response ~= "Success" then
                return fail(
                    "Could not remove skill from old rod"
                )
            end

            task.wait(0.06)
        end
    end

    if not Systems.rawEquipRod(targetRodId) then
        return fail("Could not restore target rod")
    end

    -- Clear the target loadout so the new ranking is deterministic.
    for index = 1, unlockedSlots do
        local refreshed = getPlayerData()
        local targetData =
            refreshed
            and refreshed.Rods
            and refreshed.Rods[targetRodId]

        local slotName = "Slot" .. tostring(index)
        local currentSkill =
            targetData
            and targetData.BookSlots
            and targetData.BookSlots[slotName]
            or ""

        if currentSkill ~= "" then
            local ok, response = pcall(function()
                return EquipmentsController.EquipMoveset:Fire(
                    "",
                    index
                )
            end)

            if not ok or response ~= "Success" then
                return fail(
                    "Could not clear target skill slot "
                    .. tostring(index)
                )
            end

            task.wait(0.06)
        end
    end

    -- Equip strongest owned skills into every currently unlocked slot.
    local equippedNames = {}

    for index, skillId in ipairs(desired) do
        if index > unlockedSlots then
            break
        end

        local ok, response = pcall(function()
            return EquipmentsController.EquipMoveset:Fire(
                skillId,
                index
            )
        end)

        if not ok or response ~= "Success" then
            return fail(
                "Skill equip failed: "
                .. tostring(skillId)
                .. " -> Slot"
                .. tostring(index)
                .. " ("
                .. tostring(response)
                .. ")"
            )
        end

        local info = Catalog.Skill.GetById(skillId)

        table.insert(
            equippedNames,
            tostring(info and info.name or skillId)
        )

        task.wait(0.08)
    end

    State.SkillTransferBusy = false
    State.LastSkillTransferRodId = targetRodId
    State.LastObservedRodId = targetRodId
    State.SkillTransferStatus =
        "Best skills: "
        .. table.concat(equippedNames, ", ")

    Systems.resetFishingForRodChange(
        "Skill loadout ready; fishing resumed"
    )

    return true
end

function Systems.isBestSkillLoadout(data, rodId)
    if not data or not rodId then
        return true
    end

    local unlocked =
        Systems.getUnlockedSkillSlotCount(data, rodId)

    if unlocked <= 0 then
        return true
    end

    local desired =
        Systems.getBestOwnedSkillIds(data, unlocked)

    local rod =
        data.Rods
        and data.Rods[rodId]

    local slots =
        rod
        and rod.BookSlots

    if type(slots) ~= "table" then
        return false
    end

    for index = 1, unlocked do
        local current =
            slots["Slot" .. tostring(index)]
            or ""

        local wanted =
            desired[index]
            or ""

        if current ~= wanted then
            return false
        end
    end

    return true
end

function Systems.stepBestSkillLoadoutWatcher()
    if not Config.AutoEquipBestSkills then
        return true
    end

    if State.SkillTransferBusy
        or State.RodRecoveryBusy
        or State.RodBusy then
        return false
    end

    if State.TravelBusy
        or State.AutoSellBusy
        or State.ProgressionNavigationBusy then
        return true
    end

    local now = os.clock()

    if now - State.LastBestSkillCheck < 0.75 then
        return true
    end

    State.LastBestSkillCheck = now

    local data = getPlayerData()
    local rodId =
        data
        and type(data.RodEquip) == "string"
        and data.RodEquip ~= ""
        and data.RodEquip ~= "None"
        and data.RodEquip
        or nil

    if not rodId then
        return false
    end

    if Systems.isBestSkillLoadout(data, rodId) then
        State.SkillTransferStatus = "Best skills equipped"
        State.LastSkillTransferRodId = rodId
        return true
    end

    if not Systems.isRodChangeSafe() then
        State.SkillTransferStatus =
            "Better skill loadout found; waiting for fishing idle"
        return true
    end

    local changed =
        Systems.transferBestSkillsToRod(rodId)

    if changed then
        State.LastRodWatchCheck = 0
        State.AutoLookForceCheck = true
        State.AutoLookLastWatchAt = 0
    end

    return false
end

function Systems.hasAnySkillEquippedOnSelectedRod()
    local data =
        getPlayerData()

    if not data
        or type(data.RodEquip) ~= "string"
        or type(data.Rods) ~= "table" then

