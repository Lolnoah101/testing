        return true
    end

    local now =
        os.clock()

    if State.TravelBusy
        or State.AutoSellBusy
        or State.ProgressionNavigationBusy
        or State.BossBusy
        or State.BossOwnedMovement
        or now < State.RodRecoveryHoldUntil then

        return false
    end

    if now - State.LastRodWatchCheck
        < math.max(
            0.08,
            tonumber(
                Config.RodWatchInterval
            ) or 0.20
        ) then

        return not State.RodRecoveryBusy
            and not State.SkillTransferBusy
            and State.LastObservedRodId ~= nil
    end

    State.LastRodWatchCheck =
        now

    if State.SkillTransferBusy
        or State.RodRecoveryBusy then

        return false
    end

    local data =
        getPlayerData()

    local selectedRodId =
        data
        and type(data.RodEquip)
            == "string"
        and data.RodEquip ~= ""
        and data.RodEquip ~= "None"
        and type(data.Rods)
            == "table"
        and data.Rods[
            data.RodEquip
        ] ~= nil
        and Catalog.Rod.GetById(
            data.RodEquip
        ) ~= nil
        and data.RodEquip
        or nil

    if not selectedRodId then
        State.LastObservedRodId =
            nil

        State.LastSkillTransferRodId =
            nil

        State.RodWatchStatus =
            "Waiting for selected rod"

        return false
    end

    local heldRodId =
        getHeldRodId()

    -- OP fishing uses the replicated selected rod. If Auto Equip Rod is
    -- enabled, also wait until the physical Tool matches that selected rod.
    if Config.AutoEquipRod
        and heldRodId ~= selectedRodId then

        State.WaitingForManualRod =
            true

        State.RodWatchStatus =
            "Auto Equip Rod: "
            .. tostring(
                State.AutoEquipRodStatus
            )

        return false
    end

    local rodChanged =
        State.LastObservedRodId
            ~= selectedRodId

    if rodChanged then
        State.LastObservedRodId =
            selectedRodId

        State.LastHeldRodToolId =
            heldRodId

        State.LastSkillTransferRodId =
            nil

        State.LastBestSkillCheck =
            0

        State.WaitingForManualRod =
            false

        Systems.resetFishingForRodChange(
            "Selected rod changed; OP fishing resumed"
        )
    else
        State.LastHeldRodToolId =
            heldRodId
    end

    State.RodMissingSince = 0

    State.WaitingForManualRod =
        false

    State.RodWatchStatus =
        (
            heldRodId == selectedRodId
            and "Rod ready: "
            or "OP rod selected: "
        )
        .. tostring(
            Systems.RodIdToName[
                selectedRodId
            ]
            or selectedRodId
        )

    return true
end

function Systems.getRodStat(rod, statName)
    if type(rod) ~= "table" or type(rod.stats) ~= "table" then
        return 0
    end

    for _, modifier in ipairs(rod.stats) do
        if type(modifier) == "table"
            and modifier.stat == statName
            and modifier.op == "add" then
            return tonumber(modifier.value) or 0
        end
    end

    return 0
end

for _, rod in ipairs(Catalog.Rod.GetAll()) do
    if type(rod) == "table" and type(rod.id) == "string" then
        local entry = {
            id = rod.id,
            name = tostring(rod.name or rod.id),
            attack = Systems.getRodStat(rod, "attackDamage"),
            luck = Systems.getRodStat(rod, "luck"),
            rarity = tostring(rod.rarity or ""),
            shop = RodShopConfig[rod.id],
        }

        table.insert(Systems.RodDefinitions, entry)
        Systems.RodNameToId[entry.name] = entry.id
        Systems.RodIdToName[entry.id] = entry.name

        -- All scanned rods increase monotonically in attack and luck.
        -- Attack is the main sort value; luck breaks an unlikely tie.
        Systems.RodScore[entry.id] = entry.attack * 1000 + entry.luck
    end
end

table.sort(Systems.RodDefinitions, function(a, b)
    local aScore = Systems.RodScore[a.id] or 0
    local bScore = Systems.RodScore[b.id] or 0

    if aScore == bScore then
        return a.name < b.name
    end

    return aScore < bScore
end)

for _, rod in ipairs(Systems.RodDefinitions) do
    table.insert(Systems.RodOptions, rod.name)
end

function Systems.isIslandUnlocked(data, islandId)
    if not islandId or islandId == "" then
        return true
    end

    local islandConfig = IslandConfig[islandId]
    if islandConfig and islandConfig.defaultUnlocked then
        return true
    end

    return type(data) == "table"
        and type(data.UnlockedIslands) == "table"
        and data.UnlockedIslands[islandId] == true
end

function Systems.getBestOwnedRod(data)
    if type(data) ~= "table" or type(data.Rods) ~= "table" then
        return nil
    end

    local bestId = nil
    local bestScore = -math.huge

    for rodId, owned in pairs(data.Rods) do
        if owned ~= nil then
            local score = Systems.RodScore[rodId]

            if score and score > bestScore then
                bestScore = score
                bestId = rodId
            end
        end
    end

    return bestId
end

function Systems.getNextPurchasableShopRod(data, requireAffordable)
    if type(data) ~= "table" or type(data.Rods) ~= "table" then
        return nil
    end

    local candidates = {}

    for _, rod in ipairs(Systems.RodDefinitions) do
        local shop = rod.shop

        if shop and data.Rods[rod.id] == nil then
            table.insert(candidates, {
                id = rod.id,
                name = rod.name,
                price = tonumber(shop.price) or 0,
                islandId = shop.islandId,
                score = Systems.RodScore[rod.id] or 0,
            })
        end
    end

    table.sort(candidates, function(a, b)
        if a.score == b.score then
            return a.price < b.price
        end

        return a.score < b.score
    end)

    local coins = tonumber(data.Coin) or 0

    for _, candidate in ipairs(candidates) do
        if Systems.isIslandUnlocked(data, candidate.islandId) then
            if not requireAffordable or coins >= candidate.price then
                return candidate
            end
        end
    end

    return nil
end

function Systems.getRodGameReleaseSnapshot()
    local controllerState = getFishingState()
    local loadoutLocked = false
    local preLocked = false

    if FishingController then
        if type(FishingController.IsLoadoutLocked) == "function" then
            local ok, value = pcall(function()
                return FishingController:IsLoadoutLocked()
            end)
            if ok then
                loadoutLocked = value == true
            end
        end

        if type(FishingController.IsLoadoutPreLocked) == "function" then
            local ok, value = pcall(function()
                return FishingController:IsLoadoutPreLocked()
            end)
            if ok then
                preLocked = value == true
            end
        end
    end

    local skillBusy =
        LocalPlayer:GetAttribute("IsUsingSkill") == true

    local heldReady = true
    local heldInputEnabled = true

    if HeldToolController then
        if type(HeldToolController.IsReady) == "function" then
            local ok, value = pcall(function()
                return HeldToolController:IsReady()
            end)
            if ok then
                heldReady = value == true
            end
        end

        if type(HeldToolController.IsInputEnabled) == "function" then
            local ok, value = pcall(function()
                return HeldToolController:IsInputEnabled()
            end)
            if ok then
                heldInputEnabled = value == true
            end
        end
    end

    local controllerSafe =
        controllerState == nil
        or controllerState == FState.Idling
        or controllerState == FState.Holding

    local released =
        controllerSafe
        and not loadoutLocked
        and not preLocked
        and not skillBusy
        and heldReady
        and heldInputEnabled

    return released,
        controllerState,
        loadoutLocked,
        preLocked,
        skillBusy,
        heldReady,
        heldInputEnabled
end

function Systems.waitForRodTransactionRelease(reason, timeoutSeconds)
    State.RodTransactionAttempts += 1
    State.RodTransactionLastAt = os.clock()

    local deadline =
        os.clock() + math.max(2.5, tonumber(timeoutSeconds) or 5)

    local cancelSent = false
    local retrySent = false
    local retryAt = os.clock() + 0.80

    while State.Alive
        and os.clock() < deadline do

        local released,
            controllerState,
            loadoutLocked,
            preLocked,
            skillBusy,
            heldReady,
            heldInputEnabled =
            Systems.getRodGameReleaseSnapshot()

        local opIdle = State.Phase == "Idle"

        if released and opIdle then
            State.RodTransactionStatus =
                "Fishing/loadout released"

            task.wait(0.12)
            return true
        end

        State.RodTransactionStatus =
            "Waiting unlock: "
            .. tostring(controllerState or "nil")
            .. (loadoutLocked and " [loadout]" or "")
            .. (preLocked and " [pre-lock]" or "")
            .. (skillBusy and " [skill]" or "")
            .. (not heldReady and " [backpack]" or "")
            .. (not heldInputEnabled and " [input]" or "")
            .. (
                not opIdle
                and " [OP " .. tostring(State.Phase) .. "]"
                or ""
            )

        if not cancelSent then
            cancelSent = true
            Systems.requestOPCancel(reason or "rod transaction")
        elseif not retrySent
            and os.clock() >= retryAt then

            retrySent = true
            Systems.requestOPCancel("rod unlock retry")
        end

        task.wait(0.05)
    end

    State.RodTransactionFailures += 1
    State.RodTransactionStatus =
        "Cancelled: fishing/loadout stayed locked"

    return false
end

function Systems.beginRodTransaction(reason)
    if State.RodBusy
        or State.AutoSellBusy
        or State.TravelBusy
        or State.BossBusy
        or State.BossOwnedMovement
        or State.ProgressionNavigationBusy
        or State.QuestBusy
        or State.SkillTransferBusy
        or State.OPShutdownBusy then

        return false
    end

    State.RodBusy = true
    State.RodTransactionStatus =
        "Preparing: " .. tostring(reason or "rod change")

    mouseUp()

    local ready =
        Systems.waitForRodTransactionRelease(reason, 5)

    if not ready then
        State.RodBusy = false
        return false
    end

    resetOPSession(0)
    return true
end

function Systems.finishRodTransaction(success, status)
    State.LastObservedRodId = nil
    State.LastHeldRodToolId = nil
    State.LastSkillTransferRodId = nil
    State.LastRodWatchCheck = 0
    State.LastBestSkillCheck = 0
    State.AutoEquipRodLastAt = 0
    State.AutoEquipRodPendingUntil = 0
    State.AutoLookForceCheck = true
    State.AutoLookLastWatchAt = 0
    State.CoordinatorForceRecheck = true

    State.RodBusy = false
    State.RodTransactionStatus =
        tostring(
            status
            or (
                success
                and "Rod transaction complete"
                or "Rod transaction failed"
            )
        )

    if Config.Enabled then
        State.LastPacketAt = os.clock()
        resetOPSession(success and 0.20 or 0.35)
    end

    if Config.AutoEquipRod then
        task.delay(0.15, function()
            if State.Alive
                and Config.AutoEquipRod
                and not State.RodBusy then

                pcall(Systems.stepAutoEquipRod)
            end
        end)
    end
end

function Systems.isRodChangeSafe()
    if State.AutoSellBusy
        or State.RodBusy
        or State.TravelBusy
        or State.BossBusy
        or State.BossOwnedMovement
        or State.ProgressionNavigationBusy
        or State.QuestBusy
        or State.SkillTransferBusy
        or State.OPShutdownBusy then

        return false
    end

    if State.Phase ~= "Idle" then
        return false
    end

    local released =
        Systems.getRodGameReleaseSnapshot()

    return released == true
end

function Systems.equipRodById(rodId)
    if State.RodBusy then
        return false
    end

    local data = getPlayerData()

    if not data
        or type(data.Rods) ~= "table" then

        State.RodLastStatus = "Player data unavailable"
        return false
    end

    if not rodId
        or data.Rods[rodId] == nil then

        State.RodLastStatus = "Rod not owned"
        return false
    end

    if data.RodEquip == rodId then
        State.RodLastEquipped = rodId
        State.RodLastStatus =
            "Already equipped: "
            .. tostring(Systems.RodIdToName[rodId] or rodId)
        return true
    end

    if not EquipmentsController
        or not EquipmentsController.EquipmentEquip then

        State.RodLastStatus = "Equipment controller unavailable"
        return false
    end

    if not Systems.beginRodTransaction(
        "equip "
        .. tostring(Systems.RodIdToName[rodId] or rodId)
    ) then

        State.RodLastStatus = State.RodTransactionStatus
        return false
    end

    State.RodTransactionStatus =
        "Equipping "
        .. tostring(Systems.RodIdToName[rodId] or rodId)

    local ok, accepted = pcall(function()
        return EquipmentsController.EquipmentEquip:Fire("rod", rodId)
    end)

    if not ok or accepted ~= true then
        State.RodLastStatus =
            "Equip rejected: "
            .. tostring(Systems.RodIdToName[rodId] or rodId)

        Systems.finishRodTransaction(false, State.RodLastStatus)
        return false
    end

    if not Systems.waitForRodEquip(rodId, 3) then
        State.RodLastStatus =
            "Equip did not replicate: "
            .. tostring(Systems.RodIdToName[rodId] or rodId)

        Systems.finishRodTransaction(false, State.RodLastStatus)
        return false
    end

    State.RodLastEquipped = rodId
    State.RodLastStatus =
        "Equipped: "
        .. tostring(Systems.RodIdToName[rodId] or rodId)

    Systems.finishRodTransaction(
        true,
        "Equipped/unlocked: "
        .. tostring(Systems.RodIdToName[rodId] or rodId)
    )

    log("Rod:", State.RodLastStatus)
    return true
end

function Systems.equipBestOwnedRod()
    local data = getPlayerData()
    local bestId = Systems.getBestOwnedRod(data)

    if not bestId then
        State.RodLastStatus = "No owned rod found"
        return false
    end

    return Systems.equipRodById(bestId)
end

function Systems.purchaseNextRod()
    if State.RodBusy then
        return false
    end

    local data = getPlayerData()
    local nextRod =
        Systems.getNextPurchasableShopRod(data, false)

    if not nextRod then
        State.RodLastStatus =
            "No remaining unlocked shop rod"
        return false
    end

    local coins =
        tonumber(data and data.Coin) or 0

    if coins < nextRod.price then
        State.RodLastStatus =
            string.format(
                "Need %d Coins for %s",
                nextRod.price,
                nextRod.name
            )
        return false
    end

    if not FishingRodShopController
        or not FishingRodShopController.PurchaseRod then

        State.RodLastStatus =
            "Rod shop controller unavailable"
        return false
    end

    if not Systems.beginRodTransaction(
        "buy " .. tostring(nextRod.name)
    ) then

        State.RodLastStatus = State.RodTransactionStatus
        return false
    end

    State.RodTransactionStatus =
        "Purchasing " .. tostring(nextRod.name)

    local ok, accepted = pcall(function()
        return FishingRodShopController.PurchaseRod:Fire(nextRod.id)
    end)

    if not ok or accepted ~= true then
        State.RodLastStatus =
            "Purchase rejected: " .. tostring(nextRod.name)

        Systems.finishRodTransaction(false, State.RodLastStatus)
        return false
    end

    State.RodLastPurchased = nextRod.id
    State.RodLastStatus =
        string.format(
            "Purchased %s for %d Coins",
            nextRod.name,
            nextRod.price
        )

    log("Rod:", State.RodLastStatus)

    State.RodTransactionStatus =
        "Waiting for purchased rod data"

    local owned = false
    local ownershipDeadline = os.clock() + 3.5

    while State.Alive
        and os.clock() < ownershipDeadline do

        local refreshed = getPlayerData()

        if refreshed
            and type(refreshed.Rods) == "table"
            and refreshed.Rods[nextRod.id] ~= nil then

            owned = true
            break
        end

        task.wait(0.05)
    end

    if not owned then
        State.RodLastStatus =
            "Purchase accepted but rod data did not replicate"

        Systems.finishRodTransaction(false, State.RodLastStatus)
        return false
    end

    if Config.AutoEquipBestRod then
        local refreshed = getPlayerData()
        local bestId =
            Systems.getBestOwnedRod(refreshed)
            or nextRod.id

        State.RodTransactionStatus =
            "Equipping new best rod"

        if not Systems.rawEquipRod(bestId) then
            State.RodLastStatus =
                "Bought rod, but best-rod equip did not replicate"

            Systems.finishRodTransaction(false, State.RodLastStatus)
            return false
        end

        State.RodLastEquipped = bestId
    end

    Systems.finishRodTransaction(
        true,
        "Purchase/equip complete; configuring skills"
    )

    State.LastBestSkillCheck = 0
    State.LastSkillTransferRodId = nil
    State.LastRodWatchCheck = 0

    return true
end

function Systems.stepRodAutomation()
    -- Quest-required rods take priority over ordinary "best rod" automation.
    if (
        Config.AutoAllQuests
        or Config.AutoProgression
        or Config.AutoQuestManager
    )
        and Config.AutoQuestConfigure
        and State.QuestForcedRodId then

        local data = getPlayerData()
        if data and data.RodEquip ~= State.QuestForcedRodId then
            Systems.equipRodById(State.QuestForcedRodId)
        end
        return
    end

    if not Config.AutoEquipBestRod and not Config.AutoBuyNextRod then
        return
    end

    local now = os.clock()

    if now - State.LastRodAutomationCheck
        < math.max(0.25, tonumber(Config.RodAutomationCheckInterval) or 1) then
        return
    end

    State.LastRodAutomationCheck = now

    if Config.AutoBuyNextRod then
        local data = getPlayerData()
        local affordable = Systems.getNextPurchasableShopRod(data, true)

        if affordable then
            Systems.purchaseNextRod()
            return
        end
    end

    if Config.AutoEquipBestRod then
        Systems.equipBestOwnedRod()
    end
end

