--//============================================================
--// STORY END ACTION ENGINE
--//
--// Runs only in the dungeon place. Uses the same run store and
--// packet the game's own result screen uses. Nested scope keeps
--// these locals out of the already-tight main register budget.
--//============================================================

;(function()

    local RunPacketsModule =
        GameFolder
            :FindFirstChild(
                "packets"
            )
        and GameFolder
            .packets
            :FindFirstChild(
                "runPackets"
            )


    if not RunPacketsModule then
        return
    end


    local Success,
        RunPackets =
        pcall(
            require,
            RunPacketsModule
        )


    if not Success
        or not RunPackets
        or not RunPackets.endAction
    then

        return
    end


    local UserId =
        tostring(
            LocalPlayer.UserId
        )


    local WasActive =
        false

    local CountedThisMatch =
        false

    local LastActionSent =
        nil

    local LastActionAt =
        0

    local LimitLeavePending =
        false


    local function Persist()

        if type(
            Settings.PersistEndActionSettings
        ) == "function"
        then

            Settings
                .PersistEndActionSettings()
        end
    end


    local function SetLeaveAfterOff()

        Settings.AutoLeaveAfterMatches =
            false

        Settings.CompletedMatches =
            0


        local Controls =
            Settings.EndActionControls


        if Controls
            and Controls.LeaveAfter
        then

            pcall(function()

                Controls.LeaveAfter:Set(
                    false,
                    true
                )
            end)
        end


        Persist()
    end


    local function GetOwnResultVote()

        local VoteState =
            RunStore.state
                .resultVotes
                :get(UserId)


        if not VoteState then
            return nil
        end


        local Success,
            Vote =
            pcall(function()
                return VoteState:get()
            end)


        if Success then
            return tonumber(Vote)
        end


        return nil
    end


    task.spawn(function()

        while SessionAlive() do

            -- These controls are for Story result screens, not Infinite.
            if workspace:GetAttribute(
                "Mode"
            ) == "infinite"
            then

                task.wait(0.20)
                continue
            end


            local Participant =
                RunStore.state
                    .participants
                    :get(UserId)


            if not Participant then

                WasActive = false
                CountedThisMatch = false
                LastActionSent = nil
                LimitLeavePending = false

                task.wait(0.20)
                continue
            end


            local Status =
                Participant.status:get()


            if Status == "active" then

                WasActive = true
                CountedThisMatch = false
                LastActionSent = nil
                LastActionAt = 0
                LimitLeavePending = false

                task.wait(0.15)
                continue
            end


            if WasActive
                and not CountedThisMatch
            then

                CountedThisMatch =
                    true

                Settings.CompletedMatches =
                    math.max(
                        0,
                        tonumber(
                            Settings.CompletedMatches
                        ) or 0
                    ) + 1


                Persist()


                print(
                    "[Anime Zero] Match count:",
                    Settings.CompletedMatches,
                    "/",
                    Settings.LeaveAfterMatches
                )
            end


            local TravelStatus =
                Participant.travelStatus:get()


            if TravelStatus ~= "idle" then

                if LimitLeavePending then

                    LimitLeavePending =
                        false

                    SetLeaveAfterOff()
                end


                task.wait(0.15)
                continue
            end


            local Action =
                nil

            local LimitTriggered =
                false


            if Settings.AutoLeave then

                Action = 3


            elseif Settings.AutoLeaveAfterMatches
                and Settings.CompletedMatches
                    >= math.max(
                        1,
                        Settings.LeaveAfterMatches
                    )
            then

                Action = 3
                LimitTriggered = true


            elseif Settings.AutoNext
                and RunStore.state
                    .canNext:get() == true
            then

                Action = 2


            elseif Settings.AutoRetry then

                Action = 1
            end



            if Action then

                local Now =
                    os.clock()


                -- Retry/Next are result votes. Once our vote is visible in
                -- resultVotes, the server accepted it and no resend is needed.
                -- Leave is a direct travel action, so keep retrying until
                -- travelStatus changes away from idle.
                local Accepted =
                    Action ~= 3
                    and GetOwnResultVote()
                        == Action


                if Accepted then

                    LastActionSent =
                        Action

                elseif LastActionSent ~= Action
                    or (
                        Now - LastActionAt
                    ) >= 1.25
                then

                    pcall(function()
                        local Saver =
                            GENV.__AZ_FORCE_CONFIG_SAVE

                        if type(Saver) == "function" then
                            Saver(
                                "before run action",
                                true
                            )
                        else
                            Window:Save()
                        end
                    end)


                    local Allowed = true
                    if type(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION) == "function" then
                        local GuardOK, Ready = pcall(GENV.__AZ_WEBHOOK_BEFORE_END_ACTION)
                        Allowed = not GuardOK or Ready ~= false
                    end

                    local Fired = false
                    if Allowed then
                        Fired = pcall(function()
                            RunPackets.endAction:fire(Action)
                        end)
                    end


                    if Fired then

                        LastActionSent =
                            Action

                        LastActionAt =
                            Now


                        if LimitTriggered then
                            LimitLeavePending =
                                true
                        end


                        print(
                            "[Anime Zero] End Action:",
                            Action == 1
                                and "Retry"
                                or (
                                    Action == 2
                                    and "Next"
                                    or "Leave"
                                )
                        )
                    end
                end
            end


            task.wait(0.15)
        end
    end)
end)()


--//============================================================
--// AUTO PICKUP LOOT + ENDLESS WAVE LEAVE
--//
--// Loot:
--//   game/stores/dropStore exposes each replicated drop id/kind/position.
--//   The normal client attracts a drop from <= 12 studs and finally sends
--//   rewardPackets.recoverDrop(dropId). Auto Pickup now exposes the
--//   nearest settled drop as a temporary farm target so Teleport/Tween
--//   moves into the normal <= 12 stud pickup range before recovering it.
--//
--// Endless:
--//   InfiniteStore.Store.state.Wave is the authoritative live wave.
--//   The game's Leave Run button sends runPackets.endAction(3).
--//
--// Nested scope keeps these locals out of the main 200-register budget.
--//============================================================

;(function()

    local DropStoreObject =
        StoresFolder
        and StoresFolder
            :FindFirstChild(
                "dropStore"
            )


    local RewardPacketsObject =
        PacketsFolder
        and PacketsFolder
            :FindFirstChild(
                "rewardPackets"
            )


    local InfiniteStoreObject =
        StoresFolder
        and StoresFolder
            :FindFirstChild(
                "InfiniteStore"
            )


    local RunPacketsObject =
        PacketsFolder
        and PacketsFolder
            :FindFirstChild(
                "runPackets"
            )


    local DropStoreModule
    local RewardPackets
    local InfiniteStoreModule
    local RunPackets


    if DropStoreObject then
        pcall(function()
            DropStoreModule =
                require(DropStoreObject)
        end)
    end


    if RewardPacketsObject then
        pcall(function()
            RewardPackets =
                require(RewardPacketsObject)
        end)
    end


    if InfiniteStoreObject then
        pcall(function()
            InfiniteStoreModule =
                require(InfiniteStoreObject)
        end)
    end


    if RunPacketsObject then
        pcall(function()
            RunPackets =
                require(RunPacketsObject)
        end)
    end


    -- First-seen/attempt times avoid hammering the same drop every frame.
    local SeenDrops = {}
    local LastDropAttempt = {}

    local DROP_PICKUP_RANGE = 12
    local DROP_SETTLE_TIME = 1.60
    local DROP_RETRY_TIME = 0.75

    local LastInfiniteLeaveAt = 0


    local function ReadDropPosition(
        DropState
    )

        if not DropState
            or not DropState.position
        then
            return nil
        end


        local Success,
            Position =
            pcall(function()

                return DropState
                    .position
                    :get()
            end)


        if Success then
            return Position
        end


        return nil
    end


    local function RunAutoPickupLoot()

        local Ext =
            GENV.__AZ_FARM_EXT


        if not Settings.AutoPickupLoot
            or not DropStoreModule
            or not DropStoreModule.store
            or not RewardPackets
            or not RewardPackets.recoverDrop
        then

            Ext.LootTargetCFrame =
                nil


            if not Settings.AutoPickupLoot then
                table.clear(SeenDrops)
                table.clear(LastDropAttempt)
            end

            return
        end


        local Character =
            LocalPlayer.Character


        local Root =
            Character
            and Character:FindFirstChild(
                "HumanoidRootPart"
            )


        if not Root then

            Ext.LootTargetCFrame =
                nil

            return
        end


        local Success,
            Drops =
            pcall(function()

                return DropStoreModule
                    .store
                    .state
                    :getAll()
            end)


        if not Success
            or type(Drops) ~= "table"
        then

            Ext.LootTargetCFrame =
                nil

            return
        end


        local Now =
            os.clock()

        local NearestDistance =
            math.huge

        local NearestCFrame =
            nil


        for DropId, DropState
            in pairs(Drops)
        do

            if SeenDrops[DropId] == nil then
                SeenDrops[DropId] = Now
            end


            local Position =
                ReadDropPosition(
                    DropState
                )


            if Position
                and Now
                    - SeenDrops[DropId]
                    >= DROP_SETTLE_TIME
            then

                local Distance =
                    (
                        Root.Position
                        - Position
                    ).Magnitude


                if Distance < NearestDistance then

                    NearestDistance =
                        Distance

                    NearestCFrame =
                        CFrame.new(
                            Position
                            + Vector3.new(
                                0,
                                2.5,
                                0
                            )
                        )
                end


                if Distance <= DROP_PICKUP_RANGE
                    and (
                        LastDropAttempt[DropId] == nil
                        or Now
                            - LastDropAttempt[DropId]
                            >= DROP_RETRY_TIME
                    )
                then

                    LastDropAttempt[DropId] =
                        Now


                    pcall(function()

                        RewardPackets
                            .recoverDrop
                            :fire(DropId)
                    end)
                end
            end
        end


        Ext.LootTargetCFrame =
            NearestCFrame


        -- Forget ids that the replicated store has removed.
        for DropId in pairs(SeenDrops) do

            if Drops[DropId] == nil then
                SeenDrops[DropId] = nil
                LastDropAttempt[DropId] = nil
            end
        end
    end


    GENV.__AZ_FARM_EXT.GetLootTargetCFrame =
        function()

            if Settings.AutoPickupLoot then
                return GENV.__AZ_FARM_EXT
                    .LootTargetCFrame
            end


            return nil
        end


    local function GetInfiniteWave()

        if not InfiniteStoreModule
            or not InfiniteStoreModule.Store
            or not InfiniteStoreModule.Store.state
            or not InfiniteStoreModule.Store.state.Wave
        then
            return nil
        end


        local Success,
            Wave =
            pcall(function()

                return InfiniteStoreModule
                    .Store
                    .state
                    .Wave
                    :get()
            end)


        if Success then
            return tonumber(Wave)
        end


        return nil
    end


    local function RunInfiniteWaveLeave()

        if not Settings.AutoLeaveEndlessAtWave
            or not RunPackets
            or not RunPackets.endAction
            or workspace:GetAttribute(
                "Mode"
            ) ~= "infinite"
        then
            return
        end


        local Wave =
            GetInfiniteWave()


        local TargetWave =
            math.max(
                1,
                tonumber(
                    Settings.EndlessLeaveWave
                ) or 10
            )


        if not Wave
            or Wave < TargetWave
        then
            return
        end


        local Participant =
            RunStore.state
                .participants
                :get(
                    tostring(
                        LocalPlayer.UserId
                    )
                )


        if Participant then

            local TravelStatus =
                Participant.travelStatus:get()


            if TravelStatus ~= "idle" then
                return
            end
        end


        local Now =
            os.clock()


        -- Keep retrying the direct leave action until the run store says
        -- travel has started. This avoids losing a request sent during a
        -- short server transition window.
        if Now
            - LastInfiniteLeaveAt
            < 1.50
        then
            return
        end


        pcall(function()
            local Saver =
                GENV.__AZ_FORCE_CONFIG_SAVE

            if type(Saver) == "function" then
                Saver(
                    "before endless leave",
                    true
                )
            else
                Window:Save()
            end
        end)


        local Fired =
            pcall(function()

                RunPackets
                    .endAction
                    :fire(3)
            end)


        if Fired then

            LastInfiniteLeaveAt =
                Now


            print(
                "[Anime Zero] Auto Leave Endless | Wave:",
                Wave,
                "| Target:",
                TargetWave
            )
        end
    end


    task.spawn(function()

        while SessionAlive() do

            RunAutoPickupLoot()
            RunInfiniteWaveLeave()

            task.wait(0.15)
        end
    end)
end)()


