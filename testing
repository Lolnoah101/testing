local function isCastPointMapBlocked(root, target)
    local world = workspace:FindFirstChild("World")
    local islands =
        world and world:FindFirstChild("Islands")

    if not islands then
        return false
    end

    if CastMapGuard and CastMapGuard.IsBlocked then
        local ok, blocked = pcall(function()
            return CastMapGuard.IsBlocked(
                root,
                target,
                islands
            )
        end)

        if ok then
            return blocked == true
        end
    end

    local params = RaycastParams.new()
    params.FilterType =
        Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = {
        islands,
    }

    return workspace:Raycast(
        target + Vector3.new(0, 100, 0),
        Vector3.new(0, -100, 0),
        params
    ) ~= nil
end

local function isCurrentIslandValidForFishing()
    local islandId =
        getCurrentIslandId()

    if islandId == "" then
        return false,
            "Not inside an island fishing region"
    end

    local islandInfo =
        Catalog.Island.GetById(
            islandId
        )

    if islandInfo
        and islandInfo.fishable == false then
        return false,
            "Current island is not fishable"
    end

    local meta =
        IslandConfig[islandId]

    if meta
        and meta.defaultUnlocked ~= true then

        local ok, data =
            pcall(function()
                return PlayerDataV2Controller:
                    Fetch()
            end)

        if ok
            and data
            and (
                type(data.UnlockedIslands)
                    ~= "table"
                or data.UnlockedIslands[
                    islandId
                ] ~= true
            ) then

            return false,
                "Current island is locked"
        end
    end

    return true, islandId
end

local function findClearWaterFacing()
    local character =
        LocalPlayer.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not root
        or not root:IsA("BasePart")
        or not humanoid
        or humanoid.Health <= 0 then

        return nil, nil,
            "Character unavailable"
    end

    if humanoid.SeatPart ~= nil
        or humanoid.Sit
        or humanoid:GetState()
            == Enum.HumanoidStateType.Swimming then

        return nil, nil,
            "Cannot fish while seated/swimming"
    end

    local regionOk, reason =
        isCurrentIslandValidForFishing()

    if not regionOk then
        return nil, nil, reason
    end

    local look =
        Vector3.new(
            root.CFrame.LookVector.X,
            0,
            root.CFrame.LookVector.Z
        )

    if look.Magnitude < 0.001 then
        look = Vector3.new(0, 0, -1)
    else
        look = look.Unit
    end

    local waterY =
        getWaterY()

    local powers =
        FishingConfig.AutoFishing
        and FishingConfig.AutoFishing.CastProbePowers
        or {
            1,
            0.75,
            0.5,
            0.25,
        }

    -- First test the direction the player is already facing.
    -- This avoids unnecessary rotation when their current angle is valid.
    for _, offset in ipairs(
        WATER_LOOK_OFFSETS
    ) do
        local rotation =
            CFrame.Angles(
                0,
                math.rad(offset),
                0
            )

        local direction =
            rotation:
                VectorToWorldSpace(
                    look
                )

        direction =
            Vector3.new(
                direction.X,
                0,
                direction.Z
            )

        if direction.Magnitude > 0.001 then
            direction =
                direction.Unit

            for _, power in ipairs(
                powers
            ) do
                local distance =
                    FishingConfig.Cast.BaitMinDist
                    + power
                        * (
                            FishingConfig.Cast.BaitMaxDist
                            - FishingConfig.Cast.BaitMinDist
                        )

                local target =
                    Vector3.new(
                        root.Position.X
                            + direction.X
                                * distance,
                        waterY,
                        root.Position.Z
                            + direction.Z
                                * distance
                    )

                -- Match the game's map-block check before choosing
                -- this facing direction.
                if not isCastPointMapBlocked(
                    root,
                    target
                ) then
                    return direction,
                        target,
                        nil
                end
            end
        end
    end

    return nil, nil,
        "No valid clear cast direction"
end

local function ensureLookingAtWater()
    if not Config.AutoLookAtWater then
        State.WaterLookReadyAt = 0
        State.WaterLookDirection = nil
        return true
    end

    if Config.AutoBossFarm
        and State.BossSessionActive then

        return true
    end

    local direction,
        target,
        reason =
        findClearWaterFacing()

    if not direction then
        State.WaterLookStatus =
            tostring(
                reason
                or "No valid water direction"
            )

        State.WaterLookReadyAt = 0
        State.WaterLookDirection = nil
        return false
    end

    local character =
        LocalPlayer.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root
        or not root:IsA("BasePart") then
        return false
    end

    local now =
        os.clock()

    local current =
        Vector3.new(
            root.CFrame.LookVector.X,
            0,
            root.CFrame.LookVector.Z
        )

    if current.Magnitude < 0.001 then
        current = direction
    else
        current = current.Unit
    end

    local alignment =
        math.clamp(
            current:Dot(direction),
            -1,
            1
        )

    -- If we actually need to turn, rotate once and give the character/
    -- fishing controller a brief moment to observe the new facing before
    -- sending the cast input. The old code rotated and clicked in the
    -- same frame, which could leave Legit casts stuck in Idling.
    if alignment < 0.998 then
        root.CFrame =
            CFrame.lookAt(
                root.Position,
                root.Position
                    + direction
            )

        root.AssemblyAngularVelocity =
            Vector3.zero

        State.WaterLookDirection =
            direction

        State.WaterLookReadyAt =
            now + 0.12

        State.WaterLookStatus =
            "Turning toward valid water"

        State.LastWaterLookAt =
            now

        mouseUp()
        return false
    end

    if now
        < State.WaterLookReadyAt then

        State.WaterLookStatus =
            "Waiting for facing to settle"

        mouseUp()
        return false
    end

    State.WaterLookDirection =
        direction

    State.WaterLookStatus =
        "Facing valid fishing water"

    State.LastWaterLookAt =
        now

    return true
end

local function orientLegitTowardWater()
    if not Config.AutoLookAtWater then
        return true
    end

    local direction,
        _target,
        reason =
        findClearWaterFacing()

    if not direction then
        State.WaterLookDirection =
            nil

        State.WaterLookStatus =
            "No water-facing correction: "
            .. tostring(
                reason
                or "no clear cast direction"
            )

        return true
    end

    local character =
        LocalPlayer.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not root
        or not root:IsA("BasePart")
        or not humanoid then

        return true
    end

    local current =
        Vector3.new(
            root.CFrame.LookVector.X,
            0,
            root.CFrame.LookVector.Z
        )

    if current.Magnitude < 0.001 then
        current = direction
    else
        current = current.Unit
    end

    local alignment =
        math.clamp(
            current:Dot(direction),
            -1,
            1
        )

    State.WaterLookDirection =
        direction

    -- Already aimed correctly: do NOT touch AutoRotate/CFrame.
    if alignment >= 0.9985 then
        State.WaterLookStatus =
            "Water-facing lock active"

        State.LastWaterLookAt =
            os.clock()

        return true
    end

    local previousAutoRotate =
        humanoid.AutoRotate

    State.AutoLookTurnGeneration += 1

    local generation =
        State.AutoLookTurnGeneration

    humanoid.AutoRotate = false

    root.CFrame =
        CFrame.lookAt(
            root.Position,
            root.Position + direction
        )

    root.AssemblyAngularVelocity =
        Vector3.zero

    State.AutoLookCorrections += 1

    State.WaterLookReadyAt = 0

    State.WaterLookStatus =
        "Corrected toward fishing water"

    State.LastWaterLookAt =
        os.clock()

    task.delay(0.22, function()
        if generation
                ~= State.AutoLookTurnGeneration
            or not humanoid.Parent then

            return
        end

        humanoid.AutoRotate =
            previousAutoRotate
    end)

    return true
end

local function stepAutoLookWatcher(forceNow)
    if not Config.AutoLookAtWater then
        State.AutoLookForceCheck =
            false

        return
    end

    -- Pause only while another system is physically moving the character.
    -- Auto Quest / Auto Progression ownership alone no longer suppresses
    -- water-facing after arrival.
    if State.BossSessionActive
        or State.TravelBusy
        or State.AutoSellBusy then

        if State.BossSessionActive then
            State.WaterLookStatus =
                "Paused for Boss"

        elseif State.TravelBusy then
            State.WaterLookStatus =
                "Paused while traveling"

        else
            State.WaterLookStatus =
                "Paused for Auto Sell"
        end

        State.AutoLookForceCheck =
            true

        return
    end

    local now =
        os.clock()

    local islandId =
        getCurrentIslandId()
        or ""

    if islandId
        ~= State.AutoLookLastIslandId then

        State.AutoLookLastIslandId =
            islandId

        State.AutoLookForceCheck =
            true

        State.AutoLookLastWatchAt =
            0
    end

    if not forceNow
        and not State.AutoLookForceCheck
        and now - State.AutoLookLastWatchAt
            < State.AutoLookWatchInterval then

        return
    end

    State.AutoLookLastWatchAt =
        now

    State.AutoLookForceCheck =
        false

    local character =
        LocalPlayer.Character

    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not humanoid
        or humanoid.Health <= 0 then

        State.WaterLookStatus =
            "Waiting for character"

        State.AutoLookForceCheck =
            true

        return
    end

    if humanoid.SeatPart ~= nil
        or humanoid.Sit then

        State.WaterLookStatus =
            "Paused while seated"

        State.AutoLookForceCheck =
            true

        return
    end

    if humanoid:GetState()
        == Enum.HumanoidStateType.Swimming then

        State.WaterLookStatus =
            "Paused while swimming"

        State.AutoLookForceCheck =
            true

        return
    end

    -- OP-only build: the packet engine's phase is authoritative.
    -- Face water while idle, and don't rotate during an active catch.
    if State.Phase ~= "Idle" then
        State.WaterLookStatus =
            "Waiting for OP fishing idle"

        State.AutoLookForceCheck =
            true

        return
    end

    orientLegitTowardWater()
end

local function calculateCastTarget(power)
    if Config.AutoBossFarm
        and State.BossSessionActive
        and typeof(State.BossTargetPosition) == "Vector3" then

        local p = State.BossTargetPosition
        return Vector3.new(p.X, getWaterY(), p.Z)
    end

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (root and root:IsA("BasePart")) then
        return nil
    end

    local horizontal = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if horizontal.Magnitude < 0.001 then
        return nil
    end

    local cast = FishingConfig.Cast
    local distance = cast.BaitMinDist + power * (cast.BaitMaxDist - cast.BaitMinDist)
    local unit = horizontal.Unit

    return Vector3.new(
        root.Position.X + unit.X * distance,
        getWaterY(),
        root.Position.Z + unit.Z * distance
    )
end

local function getHeldRodTool()
    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    for _, child in ipairs(
        character:GetChildren()
    ) do
        if child:IsA("Tool")
            and Catalog.Rod.GetById(
                child.Name
            ) then

            return child
        end
    end

    return nil
end

local function getHeldRodId()
    local tool =
        getHeldRodTool()

    return tool
        and tool.Name
        or nil
end

local function hasHeldRodTool()
    return getHeldRodTool() ~= nil
end

local function hasEquippedRod()
    local ok, data = pcall(function()
        return PlayerDataV2Controller:Fetch()
    end)

    if not ok or not data then
        return true
    end

    local rodId = data.RodEquip

    return type(rodId) == "string"
        and rodId ~= ""
        and rodId ~= "None"
        and type(data.Rods) == "table"
        and data.Rods[rodId] ~= nil
        and Catalog.Rod.GetById(rodId) ~= nil
end

local function sendOPCast()
    if not Config.Enabled or Config.Mode ~= "OP" or State.Phase ~= "Idle" then
        return false
    end

    if not hasEquippedRod() then
        State.NextCastAt = os.clock() + 1
        log("OP cast skipped: equip a rod")
        return false
    end

    if not ensureLookingAtWater() then
        State.NextCastAt =
            os.clock() + 0.50
        return false
    end

    local power = Config.PerfectCast and math.clamp(Config.CastThreshold, 0, 1) or 0.50
    local target = calculateCastTarget(power)

    if not target then
        State.NextCastAt = os.clock() + 1
        return false
    end

    if not safeFire(FishingPackets.FishCast, power, target) then
        State.NextCastAt = os.clock() + 1
        return false
    end

    State.OPSessionActive = true
    State.LastCastStarted = os.clock()
    State.CastAckDeadline = State.LastCastStarted + math.max(1, Config.CastAckTimeout)
    touchPacket()
    setPhase("Casting")
    log("OP FishCast", string.format("power=%.3f", power))
    return true
end

local function scheduleOPFirstPull(startServerTime)
    State.FirstPullGeneration += 1
    local generation = State.FirstPullGeneration
    local startedAt = os.clock()

    task.spawn(function()
        while State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.Phase == "FirstPull"
            and State.FirstPullGeneration == generation do

            local now = os.clock()
            local pull = 0

            if type(startServerTime) == "number" then
                local ok, result = pcall(function()
                    local elapsed = workspace:GetServerTimeNow() - startServerTime
                    return PullBarMath.Position(elapsed, FishingConfig.FirstPull.OscillateSpeed)
                end)

                if ok then
                    pull = tonumber(result) or 0
                end
            end

            local shouldPull
            if Config.PerfectFirstPull then
                shouldPull = pull >= Config.FirstPullThreshold
                    or now - startedAt >= Config.FirstPullFallbackSeconds
            else
                shouldPull = now - startedAt >= 0.45
            end

            if shouldPull then
                if safeFire(FishingPackets.FishFirstPull) then
                    State.FirstPullSentAt = now
                    log("OP FishFirstPull", string.format("bar=%.3f", pull))
                end
                return
            end

            RunService.Heartbeat:Wait()
        end
    end)
end

local function sendOPReelPull()
    State.ReelSequence = State.ReelSequence % 65535 + 1

    if safeFire(FishingPackets.FishReelPull, State.ReelSequence) then
        State.NextReelAt = os.clock() + (1 / math.clamp(Config.ReelCPS, 0.5, 5.8))
        return true
    end

    State.NextReelAt = os.clock() + 0.2
    return false
end

local function getSkillForSlot(index)
    local ok, data = pcall(function()
        return PlayerDataV2Controller:Fetch()
    end)

    if not ok or not data then
        return nil, nil
    end

    local rodId = data.RodEquip
    local rodData = rodId and data.Rods and data.Rods[rodId]
    local slots = rodData and rodData.BookSlots
    local slotName = "Slot" .. tostring(index)
    local skillId = slots and slots[slotName]

    if type(skillId) ~= "string" or skillId == "" then
        return slotName, nil
    end

    return slotName, skillId
end

local function isSkillOnCooldown(slotName)
    if not RodController then
        return false
    end

    local cooldowns = RodController.CooldownActive
    return type(cooldowns) == "table" and cooldowns[slotName] ~= nil
end

local function getBestReadySkillSlot()
    local bestIndex = nil
    local bestScore = -math.huge

    for index = 1, 4 do
        local slotName, skillId = getSkillForSlot(index)

        if skillId and not isSkillOnCooldown(slotName) then
            local info = Catalog.Skill.GetById(skillId)
            local score = info and tonumber(info.damageCoef) or 0

            if score > bestScore then
                bestScore = score
                bestIndex = index
            end
        end
    end

    return bestIndex
end

local function isLegitSkillUseAllowed()
    if not FishingController
        or not RodController
        or not RodController.Moveset then
        return false
    end

    -- handleLegitReeling already means the normal FishingController
    -- reported Reeling. Re-check the state directly so this helper cannot
    -- fire while casting, waiting, caught, or after a reset.
    if getFishingState()
        ~= FState.Reeling then
        return false
    end

    if LocalPlayer:GetAttribute(
        "IsUsingSkill"
    ) == true then
        return false
    end

    return true
end

local function tryUseLegitSkill(index)
    if not Config.AutoSkills
        or not isLegitSkillUseAllowed() then
        return false
    end

    local slotName,
        skillId =
        getSkillForSlot(index)

    if not skillId
        or isSkillOnCooldown(
            slotName
        ) then
        return false
    end

    -- RodController's normal Z/X/C/V bind eventually calls this exact
    -- Moveset packet with (SlotN, skillId). Use that same action directly
    -- while Legit is genuinely Reeling, avoiding VirtualInput/keybind
    -- focus issues.
    if not safeFire(
        RodController.Moveset,
        slotName,
        skillId
    ) then
        return false
    end

    State.SkillsSent += 1

    if FishingController
        and type(
            FishingController
                .CancelQtePrompt
        ) == "function" then

        pcall(function()
            FishingController:
                CancelQtePrompt()
        end)
    end

    -- Give the replicated cooldown state time to arrive before considering
    -- this slot again.
    State.LegitSkillFallbackGeneration += 1

    log(
        "Legit skill",
        slotName,
        skillId
    )

    return true
end

local function trySendOPSkill()
    if not RodController or not RodController.Moveset then
        return false
    end

    if LocalPlayer:GetAttribute("IsUsingSkill") then
        return false
    end

    -- Quest finisher quests force the required skill/slot so another
    -- equipped skill cannot accidentally take the final blow.
    if State.QuestForcedSkillSlot then
        local index = State.QuestForcedSkillSlot
        local slotName, skillId = getSkillForSlot(index)

        if skillId
            and skillId == State.QuestForcedSkillId
            and not isSkillOnCooldown(slotName) then

            if safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP quest skill", slotName, skillId)
                return true
            end
        end

        return false
    end

    if Config.SkillRotationMode == "Strongest Ready" then
        local index = getBestReadySkillSlot()

        if index then
            local slotName, skillId = getSkillForSlot(index)

            if skillId
                and safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP strongest skill", slotName, skillId)
                return true
            end
        end

        return false
    end

    for _ = 1, 4 do
        local index = State.SkillIndex
        local slotName, skillId = getSkillForSlot(index)
        State.SkillIndex = index % 4 + 1

        if skillId and not isSkillOnCooldown(slotName) then
            if safeFire(RodController.Moveset, slotName, skillId) then
                State.SkillsSent += 1
                log("OP skill", slotName, skillId)
                return true
            end
        end
    end

    return false
end

local function questFinisherHoldActive()
    if not State.QuestForcedSkillId
        or not State.QuestForcedSkillSlot then
        return false
    end

    local hp = tonumber(State.CurrentFishHP) or 0
    local maxHp = tonumber(State.CurrentFishMaxHP) or 0

    if hp <= 0 or maxHp <= 0 then
        return false
    end

    return (hp / maxHp)
        <= math.clamp(
            tonumber(Config.QuestFinisherThreshold) or 0.20,
            0.05,
            0.75
        )
end

local function scheduleOPResultReset(skipLoot)
    State.ResultGeneration += 1
    local generation = State.ResultGeneration

    task.spawn(function()
        if not skipLoot then
            if not Config.AutoConfirmLoot then
                return
            end

            local readyDelay = Config.LootClickDelay
            pcall(function()
                readyDelay = math.max(readyDelay, FishingConfig.Loot.ConfirmReadyDelay)
            end)

            task.wait(readyDelay)

            if not State.Alive
                or not Config.Enabled
                or Config.Mode ~= "OP"
                or State.Phase ~= "Caught"
                or State.ResultGeneration ~= generation then
                return
            end

            safeFire(FishingPackets.FishLootConfirm)
            log("OP FishLootConfirm")
        end

        local resetDelay = 0.50
        pcall(function()
            resetDelay = math.max(resetDelay, FishingConfig.General.CastCancelDelay)
        end)
        task.wait(resetDelay)

        if State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.ResultGeneration == generation
            and State.Phase == "Caught" then
            resetOPSession(Config.RecastDelay)
        end
    end)
end

local function scheduleOPEscapeReset()
    State.ResultGeneration += 1
    local generation = State.ResultGeneration

    task.spawn(function()
        local delaySeconds = 0.50
        pcall(function()
            delaySeconds = math.max(delaySeconds, FishingConfig.General.ResultDisplayTime)
        end)
        task.wait(delaySeconds)

        if State.Alive
            and Config.Enabled
            and Config.Mode == "OP"
            and State.ResultGeneration == generation
            and State.Phase == "Escaped" then
            resetOPSession(Config.RecastDelay)
        end
    end)
end

