        E.MissionStatus="Hunter Exam required";return
    end
    if self.QuestCombatActive or self.ChestSession then E.MissionStatus="Waiting for current activity";return end
    local service=self:V44Service("MissionQueueService")
    if not service then E.MissionStatus="MissionQueueService unavailable";return end
    local queue=E.MissionType:find("Hunter",1,true) and "Hunter" or "PvP"
    local data={PvE=E.MissionType~="PvP" and E.MissionType~="Hunter PvP",PvP=E.MissionType~="Hunter PvE",Invasions=false}
    E.MissionStatus="Queueing "..E.MissionType
    self:StartJob("v44_mission",nil,function(alive)
        if not E.AutoMissions or not alive() then return end
        local ok,reply=pcall(function() return service:Join(queue,data) end)
        local accepted,val=false,nil
        if ok then accepted,val=self:AwaitReply(reply,alive,6) end
        if alive() then
            E.MissionStatus=accepted and val~=false and "Matchmaking (mission-place runner not verified)" or "Queue not confirmed"
            if accepted and val~=false then E.Stats.MissionsQueued+=1 end
            E.MissionAt=os.clock()+(accepted and val~=false and 45 or 15)
        end
    end)
end
-- v50 Mining & Fishing uses confirmed client data and game services.
-- Unlike a generic Mine() request, ore-specific mining waits for a matching
-- replicated node. The server may choose only nodes within its own range.
function Hub:V50PickaxeInCharacter()
    local c,_,h=myCharacter()
    local b=LocalPlayer:FindFirstChildOfClass("Backpack")
    local best,rank=nil,-1
    for _,container in ipairs({c,b}) do
        for _,t in ipairs(container and container:GetChildren() or {}) do
            if t:IsA("Tool") then
                local power=({PickAxe=1,["Super PickAxe"]=2,["Legendary Pickaxe"]=3})[t.Name]
                if power and power>rank then best=t;rank=power end
            end
        end
    end
    return best
end
function Hub:V50OwnedTool(names)
    local H=self.Progression
    if not H or not H.playerData or not H.itemList or not H.itemInfo then return nil end
    local data=H.playerData()
    local folder=data and data:FindFirstChild("Inventory")
    local list=H.itemList()
    if not folder or not list then return nil end
    local best,rank=nil,-1
    for _,item in ipairs(folder:GetChildren()) do
        local info=H.itemInfo(item:GetAttribute("item_id"),list)
        local name=type(info)=="table" and info.ItemName or nil
        local power=name and names[name]
        if power and power>rank then
            best={UUID=tostring(item.Name),Name=name,Power=power};rank=power
        end
    end
    return best
end
function Hub:V50EquipStoredTool(item,jobName)
    if not item then return false end
    local E=self.V44
    local service=self:V44Service("InventoryService")
    if not service then return false end
    return self:StartJob(jobName,nil,function(alive)
        if not alive() then return end
        local sent,promise=pcall(function() return service:put_in_hotbar_backpack(item.UUID) end)
        if sent then self:AwaitReply(promise,alive,4) end
        if not alive() then return end
        local ok,result=pcall(function() return service:equip(item.UUID) end)
        if ok then self:AwaitReply(result,alive,4) end
    end)
end
function Hub:V50MerchantModel()
    local w=workspace:FindFirstChild("World") or workspace
    local model=w:FindFirstChild("Merchant",true)
    if model and model:IsA("Model") then return model end
    return nil
end
-- v63: The game's QuestMarkersController identifies live ore deposits as
-- Workspace's direct child Models named after ReplicatedStorage.Assets.Materials.
-- The previous recursive World scan matched decorative static ore meshes and
-- did not discover these server-spawned models at Workspace's root.
function Hub:V50MineNode(selected)
    local E=self.V44
    local now=os.clock()
    local cached=E.MineNodeCache
    if cached and now<(E.MineNodeNext or 0)
        and cached.Object and cached.Object.Parent==workspace
        and cached.Part and cached.Part.Parent
        and (E.MineVisited[cached.Object] or 0)<=now
        and (selected=="All Ores" or cached.Name==selected) then
        return cached
    end
    if now<(E.MineNodeNext or 0) then return nil end
    E.MineNodeNext=now+0.65
    local materials=ReplicatedStorage:FindFirstChild("Assets")
    materials=materials and materials:FindFirstChild("Materials")
    if not materials then E.MineStatus="Waiting for material definitions";return nil end
    local _,root=myCharacter()
    if not root then return nil end
    local zoneModule=ReplicatedStorage.Shared.Data:FindFirstChild("MinesArea")
    local ok,zone=pcall(function() return require(zoneModule) end)
    if not ok or not zone then return nil end
    local allowed={}
    for _,entry in ipairs(materials:GetChildren()) do allowed[entry.Name]=true end
    local best,score=nil,nil
    local total=0
    for _,model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and allowed[model.Name]
            and (selected=="All Ores" or model.Name==selected)
            and (E.MineVisited[model] or 0)<=now then
            local part=model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart",true)
            if part and zone.Contains(part.Position) then
                total+=1
                local distance=(part.Position-root.Position).Magnitude
                if not score or distance<score then
                    score=distance
                    best={Object=model,Part=part,Position=part.Position,Name=model.Name}
                end
            end
        end
    end
    E.MineObservedCount=total
    E.MineNodeCache=best
    return best
end

-- A destination is a confirmed ore model or a clearly labeled scouting point.
-- We never mistake shop decorative meshes or quest-board props for ores.
function Hub:V63MineGroundPoint(pos,zone)
    local char=LocalPlayer.Character
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char,self.V44.MineTemporaryFloor}
    params.RespectCanCollide=true
    for _,offset in ipairs({Vector3.zero,Vector3.new(4,0,0),Vector3.new(-4,0,0),
            Vector3.new(0,0,4),Vector3.new(0,0,-4)}) do
        local test=pos+offset
        local hit=workspace:Raycast(test+Vector3.new(0,24,0),Vector3.new(0,-88,0),params)
        if hit and hit.Instance and hit.Instance.CanCollide and hit.Normal.Y>0.55
            and hit.Material~=Enum.Material.Water then
            local standing=hit.Position+Vector3.new(0,3.0,0)
            if zone.Contains(standing) then return standing end
        end
    end
end

function Hub:V63MineScout(zone,root,now)
    local E=self.V44
    local anchor=zone.ExitPosition
    if typeof(anchor)~="Vector3" then E.MineStatus="Mine coordinates unavailable";return end
    local offsets={
        Vector3.zero,Vector3.new(180,0,0),Vector3.new(0,0,180),
        Vector3.new(-180,0,0),Vector3.new(0,0,-180),
        Vector3.new(350,0,130),Vector3.new(-350,0,130),
        Vector3.new(-350,0,-250),Vector3.new(350,0,-250),
        Vector3.new(-550,0,0),Vector3.new(0,0,410),
        Vector3.new(-550,0,410),Vector3.new(330,0,410)
    }
    if now<(E.MineScoutNext or 0) then
        E.MineStatus="Looking for streamed "..tostring(E.MineOre).." ore models"
        return
    end
    E.MineScoutNext=now+3.0
    E.MineScoutIndex=((E.MineScoutIndex or 0)%#offsets)+1
    local index=E.MineScoutIndex
    local pos=anchor+offsets[index]
    if not zone.Contains(pos) then return end
    E.MineStatus=string.format("Scouting mine sector %d/%d; ore not streamed",index,#offsets)
    task.spawn(function()
        pcall(function() LocalPlayer:RequestStreamAroundAsync(pos,2.5) end)
    end)
    local land=self:V63MineGroundPoint(pos,zone)
    if (pos-root.Position).Magnitude>25 then
        local char=LocalPlayer.Character
        if char then
            if land then
                if E.MineTemporaryFloor then
                    pcall(function() E.MineTemporaryFloor:Destroy() end)
                    E.MineTemporaryFloor=nil
                end
                pcall(function() char:PivotTo(CFrame.new(land)) end)
            else
                -- Requesting remote streaming is insufficient on some clients.
                -- Move to a bounded scout point with temporary local support;
                -- never claim it is a verified ore location.
                local floor=E.MineTemporaryFloor
                if not floor or not floor.Parent then
                    floor=Instance.new("Part")
                    floor.Name="HollowMoon_MineScoutSupport"
                    floor.Size=Vector3.new(12,1,12)
                    floor.Anchored=true
                    floor.CanCollide=true
                    floor.Transparency=1
                    floor.Parent=workspace
                    E.MineTemporaryFloor=floor
                end
                floor.Position=pos-Vector3.new(0,3.5,0)
                pcall(function() char:PivotTo(CFrame.new(pos)) end)
                E.MineStatus="Scouting for streamed ores; terrain not loaded"
            end
        end
    end
end

function Hub:V63ApproachOre(node,zone,root,now)
    local E=self.V44
    if not node or not node.Object or node.Object.Parent~=workspace then
        E.MineNodeCache=nil;E.MineNodeNext=0;return false
    end
    local delta=root.Position-node.Position
    if delta.Magnitude<=6 then return true end
    if now<(E.MineApproachNext or 0) then return false end
    E.MineApproachNext=now+0.7
    local flat=Vector3.new(delta.X,0,delta.Z)
    if flat.Magnitude<0.1 then flat=Vector3.new(1,0,0) end
    local desired=node.Position+flat.Unit*5
    local standing=self:V63MineGroundPoint(desired,zone)
    if not standing then
        E.MineStatus="Ore found ("..node.Name.."), waiting for nearby mine floor"
        task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(desired,2.0) end) end)
        return false
    end
    local char=LocalPlayer.Character
    if char then
        if E.MineTemporaryFloor then
            pcall(function() E.MineTemporaryFloor:Destroy() end)
            E.MineTemporaryFloor=nil
        end
        local face=Vector3.new(node.Position.X,standing.Y,node.Position.Z)
        pcall(function() char:PivotTo(CFrame.lookAt(standing,face)) end)
    end
    E.MineStatus="Traveling to "..node.Name.." ore ("..math.floor(delta.Magnitude).." studs)"
    return false
end

-- v52 mine arrival: ExitPosition points to an underground region, NOT
-- guaranteed replicated collidable geometry. Never blind-PivotTo it.
function Hub:V52MineArrival(zone,root,now)
    local E=self.V44
    local anchor=self.V52MineSafeAnchor
    if typeof(anchor)~="Vector3" or not zone.Contains(anchor) then
        anchor=zone.ExitPosition
    end
    if not zone.Contains(anchor) then
        E.MineStatus="Underground mine coordinates unavailable";return
    end
    if now>=(E.MineNextStream or 0) then
        E.MineNextStream=now+2.5
        task.spawn(function()
            pcall(function() LocalPlayer:RequestStreamAroundAsync(anchor,3) end)
        end)
    end
    if now<(E.MineArrivalNext or 0) then return end
    E.MineArrivalNext=now+1.2
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LocalPlayer.Character}
    params.RespectCanCollide=true
    local candidates={anchor,anchor+Vector3.new(8,0,0),anchor+Vector3.new(-8,0,0),
        anchor+Vector3.new(0,0,8),anchor+Vector3.new(0,0,-8),zone.ExitPosition}
    local landing=nil
    for _,near in ipairs(candidates) do
        local hit=workspace:Raycast(near+Vector3.new(0,65,0),Vector3.new(0,-145,0),params)
        if hit and hit.Instance.CanCollide and hit.Material~=Enum.Material.Water
            and hit.Normal.Y>0.5 and zone.Contains(hit.Position+Vector3.new(0,4,0))
            and math.abs(hit.Position.Y-near.Y)<=45 then
            landing=hit.Position+Vector3.new(0,3.3,0)
            break
        end
    end
    local char=LocalPlayer.Character
    if not char then return end
    if landing then
        if E.MineTemporaryFloor then
            pcall(function() E.MineTemporaryFloor:Destroy() end)
            E.MineTemporaryFloor=nil
        end
        if (landing-root.Position).Magnitude>8 then
            pcall(function() char:PivotTo(CFrame.new(landing)) end)
        end
        E.MineStatus="Arrived at underground mining area"
        E.MineAt=now+.6
        return
    end
    -- The saved inside-mine anchor is a known location, not Jacob's surface NPC.
    -- On streaming-enabled clients the floor may arrive after the character.
    -- A temporary local support prevents falling during that short load.
    if (anchor-root.Position).Magnitude>18 then
        local floor=E.MineTemporaryFloor
        if not floor or not floor.Parent then
            floor=Instance.new("Part")
            floor.Name="HollowMoon_MineStreamingSupport"
            floor.Anchored=true;floor.CanCollide=true;floor.Transparency=1
            floor.Size=Vector3.new(12,1,12)
            floor.Parent=workspace
            E.MineTemporaryFloor=floor
        end
        floor.Position=anchor-Vector3.new(0,3.2,0)
        pcall(function() char:PivotTo(CFrame.new(anchor)) end)
        E.MineStatus="Teleporting underground; waiting for mine floor"
        E.MineAt=now+1
    else
        E.MineStatus="Streaming underground mine around current position"
    end
end

function Hub:V44MineTick(now)
    local E=self.V44
    if self.V70NenPriority then
        E.MineStatus="Paused for Node Master; will resume mining"
        return
    end
    if not E.AutoMine or now<E.MineAt then return end
    E.MineAt=now+1.1
    if self.ChestSession then
        self:V44ActivityRelease("Mining")
        E.MineStatus="Paused: collecting chest rewards"
        return
    end
    if self.AutoFarm or self:QuestOwnsFarmMovement() then
        self:V44ActivityRelease("Mining")
        E.MineStatus="Paused: Auto Farm / Auto Quest has movement priority"
        return
    end
    if E.AutoFish and E.ActivityOwner=="Fishing" and os.clock()<E.ActivityUntil then
        E.MineStatus="Waiting for fishing";return
    end
    local char,root,hum=myCharacter()
    if not root then E.MineStatus="Waiting for character";return end
    if not self:V44CanWork() and E.ActivityOwner~="Mining" then E.MineStatus="Waiting for combat or quest";return end
    if not self:V44Activity("Mining",4) then return end
    local tool=self:V50PickaxeInCharacter()
    local owned=self:V50OwnedTool({PickAxe=1,["Super PickAxe"]=2,["Legendary Pickaxe"]=3})
    local ranks={PickAxe=1,["Super PickAxe"]=2,["Legendary Pickaxe"]=3}
    if owned and ((not tool) or owned.Power>(ranks[tool.Name] or 0)) then
        if now>=(E.MineEquipAt or 0) then
            E.MineEquipAt=now+6
            self:V50EquipStoredTool(owned,"v50_mine_equip")
        end
        E.MineStatus="Equipping owned "..owned.Name.." from inventory";return
    end
    if not tool then
        local playerData=self:V44Data()
        if not playerData or not playerData:FindFirstChild("Inventory") then
            E.MineStatus="Waiting for inventory sync before purchasing";return
        end
        local jenni=tonumber(LocalPlayer:GetAttribute("Jenni")) or 0
        local want=jenni>=5000 and "Super PickAxe" or jenni>=500 and "PickAxe" or nil
        if not want then E.MineStatus="No pickaxe; need at least 500 Jenni";return end
        local merchant=self:V50MerchantModel()
        if not merchant then
            -- The actual town quest-board coordinates are captured. The shop NPC
            -- position isn't verified, so use this as a STREAMING SEARCH anchor.
            local spots={Vector3.new(-835.94,269.35,-317.1),Vector3.new(-1282,342,-644)}
            E.MineMerchantStep=math.max(1,(E.MineMerchantStep or 0))
            local spot=spots[E.MineMerchantStep]
            if now>=E.MineNextStream then
                E.MineNextStream=now+4
                E.MineMerchantStep=E.MineMerchantStep%#spots+1
                pcall(function() char:PivotTo(CFrame.new(spot+Vector3.new(0,4,0))) end)
                task.spawn(function() pcall(function() LocalPlayer:RequestStreamAroundAsync(spot,1.5) end) end)
            end
            E.MineStatus="Searching town for Basic Merchant ("..want..")";return
        end
        local pos=merchant:GetPivot().Position
        if (pos-root.Position).Magnitude>12 then
            pcall(function() char:PivotTo(CFrame.new(pos+Vector3.new(0,3,5))) end)
            E.MineStatus="Approaching Basic Merchant for "..want;return
        end
        if now<E.MineNextBuy then E.MineStatus="Waiting for "..want.." purchase confirmation";return end
        E.MineNextBuy=now+9
        local service=self:V44Service("MerchantService")
        if not service then E.MineStatus="MerchantService unavailable";return end
        E.MineStatus="Purchasing "..want.." ("..(want=="Super PickAxe" and "5000" or "500").." Jenni)"
        self:StartJob("v50_pickaxe_buy",nil,function(alive)
            if not alive() or not E.AutoMine then return end
            local sent,reply=pcall(function() return service:purchase(want) end)
            local ok=false
            if sent then ok=self:AwaitReply(reply,alive,5) end
            if alive() then
                E.MineStatus=sent and (ok and "Purchase acknowledged; verifying pickaxe" or "Purchase unconfirmed; checking inventory")
                    or "Merchant rejected pickaxe request"
            end
        end)
        return
    end
    if tool.Parent~=char then
        pcall(function() hum:EquipTool(tool) end)
        E.MineStatus="Equipping "..tool.Name;return
    end
    if tool.Name=="Super PickAxe" then
        local wear=tonumber(tool:GetAttribute("wear"))
        if wear and wear>=200 then
            E.MineStatus="Super PickAxe worn out; waiting for replacement";return
        end
    end
    local ok,zone=pcall(function() return require(ReplicatedStorage.Shared.Data.MinesArea) end)
    if not ok or not zone then E.MineStatus="MinesArea data missing";return end
    if not zone.Contains(root.Position) then
        self:V52MineArrival(zone,root,now)
        return
    end
    -- The server's Mine() request takes no ore argument, but the native world
    -- tracker exposes actual streamed material models for positioning.
    -- We approach a REAL live ore model first, then use Mine() at close range.
    local pickaxes=ReplicatedStorage.Shared.Data:FindFirstChild("Pickaxes")
    local okPick, rules=pcall(function() return pickaxes and require(pickaxes) end)
    if okPick and rules and not rules.Has(char) then
        E.MineStatus="Pickaxe needs to be equipped before mining";return
    end
    if E.MineObservedCharacter~=char then
        if E.MineStateConnection then pcall(function() E.MineStateConnection:Disconnect() end) end
        E.MineObservedCharacter=char
        E.MineConfirmedThisLife=false
        E.MineStateConnection=char:GetAttributeChangedSignal("Mining"):Connect(function()
            if not self.Running or not E.AutoMine then return end
            if char:GetAttribute("Mining")==true then
                E.MineConfirmedThisLife=true
                E.MineUnconfirmed=0
                E.MineVerifyAt=nil
                E.MinePending=false
                E.MineStatus="Mining "..tostring(E.MineTarget and E.MineTarget.Name or "ore").." (confirmed)"
            elseif E.MineConfirmedThisLife then
                E.MineConfirmedThisLife=false
                if E.MineTarget and E.MineTarget.Object then
                    E.MineVisited[E.MineTarget.Object]=os.clock()+8
                end
                E.MineNodeCache=nil;E.MineNodeNext=0
                E.MineAt=0;E.MineNextAction=0
                E.MineStatus="Finished mining; finding next ore"
            end
        end)
        table.insert(self.Connections,E.MineStateConnection)
    end
    if char:GetAttribute("Mining")==true then
        E.MineVerifyAt=nil
        E.MineUnconfirmed=0
        E.MinePending=false
        E.MineStatus="Mining "..tostring(E.MineTarget and E.MineTarget.Name or "ore").." (server confirmed)"
        E.MineStartedAt=E.MineStartedAt or now
        -- No movement while Mining=true: the native client StopMine()s on movement.
        return
    end
    E.MineStartedAt=nil
    if E.MineVerifyAt and now>=E.MineVerifyAt then
        E.MineVerifyAt=nil
        E.MinePending=false
        E.MineUnconfirmed=(E.MineUnconfirmed or 0)+1
        E.MineStatus="Mine not confirmed (attempt "..E.MineUnconfirmed
            ..") | Area="..tostring(char:GetAttribute("CurrentArea") or "unknown")
            .." | Pickaxe="..tostring(tool.Name)
        E.MineNextAction=now+1.4
        if E.MineUnconfirmed>=2 and E.MineTarget and E.MineTarget.Object then
            E.MineVisited[E.MineTarget.Object]=now+10
            E.MineNodeCache=nil
            E.MineNodeNext=0
            E.MineTarget=nil
            E.MineStatus="Mine request not confirmed; trying another ore model"
        end
        if E.MineUnconfirmed>=3 then
            local area=tostring(char:GetAttribute("CurrentArea") or "unknown")
            E.MineStatus="Mine not confirmed ("..tostring(E.MineUnconfirmed)
                .." attempts) | Area="..area.." | Pickaxe="..tostring(tool.Name)
            if now>=(E.MineNativeNext or 0) then
                E.MineNativeNext=now+12
                local inputOk=pcall(function()
                    local vim=game:GetService("VirtualInputManager")
                    local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
                    if not viewport then error("No active camera") end
                    local x,y=viewport.X/2,viewport.Y/2
                    vim:SendMouseButtonEvent(x,y,0,true,game,0)
                    vim:SendMouseButtonEvent(x,y,0,false,game,0)
                end)
                E.MineStatus=inputOk and "Trying native mouse mining input; waiting for state"
                    or "Direct Mine refused; native input unavailable (check area/tool)"
                E.MineNextAction=now+3.0
            else
                E.MineNextAction=now+2.4
            end
        end
        return
    end
    if E.MinePending and E.MineVerifyAt and now<E.MineVerifyAt then
        E.MineStatus="Waiting for server Mining state"
        return
    end
    if now<(E.MineNextAction or 0) then
        E.MineStatus="Next mining attempt in "..string.format("%.1fs",E.MineNextAction-now)
        return
    end
    local node=self:V50MineNode(E.MineOre)
    if not node then
        E.MineTarget=nil
        self:V63MineScout(zone,root,now)
        E.MineNextAction=now+0.65
        return
    end
    E.MineTarget=node
    if not self:V63ApproachOre(node,zone,root,now) then
        E.MineNextAction=now+0.8
        return
    end
    local service=self:V44Service("MaterialService")
    if not service then E.MineStatus="MaterialService unavailable";return end
    E.MineStatus="Mining "..node.Name.." ore; requesting server action"
    E.MineNextAction=now+2.2
    if E.MinePending then E.MineStatus="Waiting for mine response";return end
    E.MinePending=true
    local ok,reply=pcall(function() return service:Mine() end)
    if ok then
        E.MineStatus="Mine() sent beside "..node.Name.."; verifying Mining state"
        E.MineLastRequest=now
        E.MineVerifyAt=now+2.5
        E.MineAt=now+.30
        if type(reply)=="table" and type(reply.andThen)=="function" then
            local bound=pcall(function()
                reply:andThen(function(result)
                    if not self.Running or not E.AutoMine then return end
                    if result==false or (type(result)=="table" and result.Success==false) then
                        E.MineStatus="Server denied Mine(): "..tostring(result)
                        E.MineVerifyAt=os.clock()+0.2
                    end
                end):catch(function(reason)
                    if self.Running and E.AutoMine then
                        E.MineStatus="Mine() rejected: "..tostring(reason):sub(1,100)
                        E.MineVerifyAt=os.clock()+0.2
                    end
                end)
            end)
        end
    else
        E.MinePending=false
        E.MineNextAction=now+1.5
        E.MineStatus="Mine() request error: "..tostring(reply)
    end
    if E.MineOre~="All Ores" then
