            -- Restore an older spoof before checking the new zone/state.
            restoreDesyncFrame()
            -- Skip lobby training, rebirth, any below-ground farm, or a parked root.
            if player:GetAttribute("Zone") ~= "Arena" or s.enabled then return end
            local char, humanoid, root = characterReady()
            if not char or not root or root.Anchored or humanoid.SeatPart
                or humanoid.Sit then return end
            local original = root.CFrame
            local frame = {root = root, cf = original, spoofCf = original * DESYNC_OFFSET}
            settingsState.desyncFrame = frame
            local spoofed, spoofError = pcall(function()
                root.CFrame = frame.spoofCf
            end)
            if not spoofed then
                restoreDesyncFrame()
                local now = os.clock()
                if now - settingsState.desyncLastError > 8 then
                    settingsState.desyncLastError = now
                    settingsWarn("Desync frame failed: " .. tostring(spoofError))
                end
            end
        end)
        settingsState.desyncAfter = RunService.PostSimulation:Connect(restoreDesyncFrame)
    end)
    if not ok then
        settingsWarn("Desync unavailable in this environment: " .. tostring(err))
        setDesync(false)
    end
end

local function cleanupSettings(disableFutureAutoExec)
    if not settingsState.alive then return end
    setDesync(false)
    settingsState.alive = false
    settingsState.autoReconnect = false
    settingsState.antiAFK = false
    settingsState.autoExecute = false
    if disableFutureAutoExec then saveAutoExecuteEnabled(false) end
    if settingsState.idleConnection then
        settingsState.idleConnection:Disconnect()
        settingsState.idleConnection = nil
    end
    for _, conn in ipairs(settingsState.connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(settingsState.connections)
end

-- Also clean up Settings connections if a later version unloads this hub.
local previousSettingsDestroy = s.Destroy
function s:Destroy()
    cleanupSettings(false)
    previousSettingsDestroy(self)
end

settingsTab:CreateSection({name = "Automation"})
