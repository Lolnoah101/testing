        if points<1 then Hub.StatStatus="No unspent points";return end
        local choice=Hub.V44 and Hub.V44.AutoStatBuild and Hub:V44StatChoice() or Hub.StatChoice
        local key=choice and Hub.StatKeys[choice]
        local service=H.service("StatsService")
        if not key or not service then Hub.StatStatus="Waiting for stats service";return end
        local before=tonumber(LocalPlayer:GetAttribute(key))
        if not H.Scaling then
            local valid,config=pcall(function() return require(ReplicatedStorage.Shared.StatScaling) end)
            if valid and type(config)=="table" then H.Scaling=config end
        end
        local cap=H.Scaling and tonumber(H.Scaling.MaxStat) or 160
        if before and before>=cap then Hub.StatStatus=choice.." reached the stat cap ("..cap..")";return end
        local amount=math.min(points,10,before and math.max(0,math.floor(cap-before)) or 10)
        if amount<1 then return end
        Hub.StatBusy=true;Hub.StatStatus="Adding "..amount.." to "..choice
        Hub:StartJob("stats","AutoStatPoints",function(alive)
            if not alive() then return end
            local sent,reply=pcall(function() return service:RequestIncrementStat(key,amount) end)
            local accepted,value=false,nil
            if sent then accepted,value=Hub:AwaitReply(reply,alive) end
            local confirmed=sent and accepted and value~=false and Hub:WaitConfirmed(function()
                local remaining=tonumber(LocalPlayer:GetAttribute("StatPoints")) or points
                local after=tonumber(LocalPlayer:GetAttribute(key))
                return remaining<points and (not before or not after or after>before)
            end,alive,3)
            if not alive() then return end
            Hub.StatStatus=confirmed and ("Allocated "..choice) or "Stat increment unconfirmed"
            Hub.StatNext=os.clock()+(confirmed and .6 or 6)
        end,function() if Hub.Running then Hub.StatBusy=false end end)
    end
    function H.levelGate(info,item)
        local level=tonumber(LocalPlayer:GetAttribute("Level")) or 0
        local d=type(info.Data)=="table" and info.Data or {}
        local required=tonumber(info.RequiredLevel) or tonumber(info.LevelRequirement)
            or tonumber(info.MinLevel) or tonumber(info.LevelRequired)
            or tonumber(d.RequiredLevel) or tonumber(d.LevelRequirement) or tonumber(d.MinLevel)
            or (item and tonumber(item:GetAttribute("RequiredLevel")))
        return required==nil or level>=required, required
    end
    function H.gear()
        if not Hub.AutoEquipGear or Hub.GearBusy or os.clock()<Hub.GearNext then return end
        Hub.GearNext=os.clock()+2
        if not Hub:MaintenanceSafe() then Hub.GearStatus="Waiting for combat / inventory action";return end
        local data=H.playerData()
        local inventory=data and data:FindFirstChild("Inventory")
        local list=H.itemList()
        if not inventory or not list or not H.buffReader() then Hub.GearStatus="Waiting for gear data";return end
        local equipped=H.currentEquipped(data)
        local chosen={}
        H.GearBackoff=H.GearBackoff or {}
        for _,item in ipairs(inventory:GetChildren()) do
            local info=H.itemInfo(item:GetAttribute("item_id"),list)
            if type(info)=="table" and (info.Type=="Accessory" or info.Type=="Outfit") then
                local eligible,levelReq=H.levelGate(info,item)
                if not eligible then
                    Hub.GearStatus="Skipping locked gear (Lv "..tostring(levelReq)..")"
                    continue
                end
                local uuid=tostring(item.Name)
                local slot=info.Type=="Accessory" and info.AccessoryType or "Outfit"
                if type(slot)~="string" or slot=="" then continue end
                local score=H.score(info,item,Hub.GearPreset)
                local prev=chosen[slot]
                if score and (not prev or score>prev.Score+.0001 or (math.abs(score-prev.Score)<=.0001 and equipped[uuid] and not equipped[prev.UUID])) then
                    chosen[slot]={UUID=uuid,Slot=slot,Score=score,Name=info.ItemName}
                end
            end
        end
        local candidates={}
        for _,item in pairs(chosen) do
            if item.Score>0 and not equipped[item.UUID] and os.clock()>=(H.GearBackoff[item.UUID] or 0) then table.insert(candidates,item) end
        end
        table.sort(candidates,function(a,b) return a.Slot==b.Slot and a.UUID<b.UUID or a.Slot<b.Slot end)
        Hub.GearCandidates=chosen
        local target=candidates[1]
        if not target then Hub.GearStatus="Best scored gear equipped";Hub.GearNext=os.clock()+6;return end
        local service=H.service("InventoryService")
        if not service then Hub.GearStatus="Waiting for inventory service";return end
        Hub.GearBusy=true;Hub.GearStatus="Equipping "..target.Name
        Hub:StartJob("gear","AutoEquipGear",function(alive)
            -- Native accessory/cloth flow equips directly; Humanoid:EquipTool would
            -- replace the active weapon and is deliberately not used for gear.
            if not alive() or H.currentEquipped(H.playerData())[target.UUID] then return end
            if not Hub:MaintenanceSafe() then Hub.GearStatus="Waiting for combat to end";return end
            local sent,reply=pcall(function() return service:put_in_hotbar_backpack(target.UUID) end)
            local accepted,value=false,nil
            if sent then accepted,value=Hub:AwaitReply(reply,alive) end
            local confirmed=sent and accepted and value~=false and Hub:WaitConfirmed(function()
                return H.currentEquipped(H.playerData())[target.UUID]==true
            end,alive,2)
            -- Placing a gear UUID in the hotbar is not proof it was equipped.
            -- Try the same native inventory equip action used for weapons.
            if not confirmed and alive() and type(service.equip)=="function" then
                local equippedOk,request=pcall(function() return service:equip(target.UUID) end)
                if equippedOk then Hub:AwaitReply(request,alive,4) end
                confirmed=Hub:WaitConfirmed(function()
                    return H.currentEquipped(H.playerData())[target.UUID]==true
                end,alive,2)
            end
            if not alive() then return end
            if confirmed then Hub.GearChanges+=1;Hub.GearStatus="Equipped "..target.Name
            else H.GearBackoff[target.UUID]=os.clock()+90;Hub.GearStatus="Equip unconfirmed / locked: "..target.Name end
            Hub.GearNext=os.clock()+(confirmed and .8 or 4)
        end,function() if Hub.Running then Hub.GearBusy=false end end)
    end
    function H.findTool(uuid)
        local char=LocalPlayer.Character
        local backpack=LocalPlayer:FindFirstChildOfClass("Backpack")
        if char then for _,tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tostring(tool:GetAttribute("UUID"))==uuid then return tool end
        end end
        if backpack then for _,tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tostring(tool:GetAttribute("UUID"))==uuid then return tool end
        end end
    end
    function H.inventoryChests()
        if not Hub.AutoInventoryChests or Hub.InventoryChestBusy then return end
        local now=os.clock()
        if Hub.V70NenPriority then
            Hub.InventoryChestStatus="Paused for spawned Node Master";return
        end
        if now<(Hub.InventoryChestLast or 0)+0.08
            or now<(Hub.InventoryChestPendingUntil or 0) then return end
        if not Hub:MaintenanceSafe() then Hub.InventoryChestStatus="Waiting for combat / loot";return end
        local world=workspace:FindFirstChild("World")
        local chests=world and world:FindFirstChild("Chests")
        local data=H.playerData()
        local inventory=data and data:FindFirstChild("Inventory")
        local list=H.itemList()
        if not chests or not inventory or not list then Hub.InventoryChestStatus="Waiting for chest data";return end
        H.ChestNoIdSince=H.ChestNoIdSince or setmetatable({}, {__mode="k"})
        for _,obj in ipairs(chests:GetChildren()) do
            local items=obj:FindFirstChild("Items")
            local ignoreUntil=Hub.ChestSkipped[obj]
            if (not ignoreUntil or (type(ignoreUntil)=="number" and now>=ignoreUntil))
                and tostring(obj:GetAttribute("Owner"))==tostring(LocalPlayer.UserId)
                and obj:GetAttribute("PickedUp")~=true
                and (obj:GetAttribute("OwnerOpened")~=true or (items and #items:GetChildren()>0))
                and not (Hub.ChestDrained[obj] and (not items or #items:GetChildren()==0)) then
                local id=obj:GetAttribute("Id") or obj:GetAttribute("ChestId")
                if id==nil then
                    H.ChestNoIdSince[obj]=H.ChestNoIdSince[obj] or now
                    if now-H.ChestNoIdSince[obj]<2.0 then
                        Hub.InventoryChestStatus="Waiting for placed chest ID"
                        Hub.InventoryChestLast=now;return
                    end
                    Hub.ChestSkipped[obj]=now+90
                    Hub.InventoryChestStatus="Unready chest skipped; next chest"
                else
                    Hub.InventoryChestStatus="Collecting already-placed chest"
                    Hub.InventoryChestLast=now;return
                end
            end
        end
        local found=nil
        for _,item in ipairs(inventory:GetChildren()) do
            local info=H.itemInfo(item:GetAttribute("item_id"),list)
            if type(info)=="table" and info.Type=="Chest" and info.ChestType and Hub.ChestRarities[info.ChestRarity or info.Rarity]
                and (tonumber(item:GetAttribute("quantity")) or 1)>0 and (info.ChestRarity~="Mythical" or LocalPlayer:GetAttribute("IsHunter")==true) then
                local uuid=tostring(item.Name)
                if now>=(H.Failures["chest:"..uuid] or 0) and (not found or uuid<found.UUID) then found={UUID=uuid,Info=info} end
            end
        end
        Hub.InventoryChestLast=now
        if not found then
            Hub.InventoryChestStatus="No selected chests available"
            Hub:V70RestoreChestBatchTool()
            return
        end
        local invService,chestService=H.service("InventoryService"),H.service("ChestService")
        if not invService or not chestService then return end
        local character=LocalPlayer.Character
        local previousTool=character and character:FindFirstChildOfClass("Tool")
        if not Hub.V70ChestBatchRestore then
            Hub.V70ChestBatchRestore={Character=character,Tool=previousTool}
        end
        Hub.InventoryChestBusy=true;Hub.InventoryChestStatus="Placing "..found.Info.ItemName
        local deadline=now+26
        local startingHealth=character and character:FindFirstChildOfClass("Humanoid")
        startingHealth=startingHealth and startingHealth.Health or 0
        Hub.Runtime.InventoryOwner="inventoryChest";Hub.Runtime.InventoryUntil=deadline
        Hub.Runtime.InventoryRestore={Character=character,Tool=previousTool,UUID=found.UUID}
        Hub:StartJob("inventoryChest","AutoInventoryChests",function(alive)
            local function sameCharacter()
                if not alive() or os.clock()>=deadline or LocalPlayer.Character~=character or not character.Parent then return false end
                local current=character:FindFirstChildOfClass("Humanoid")
                return current and current.Health>0 and current.Health>=startingHealth and not character:HasTag("InCombat")
            end
            -- Waiting for the SERVICE promise and then waiting for REPLICATION
            -- doubles latency. Watch replicated state immediately after sending.
            local function quicklyConfirmed(check,timeout)
                local deadline=os.clock()+timeout
                repeat
                    if not sameCharacter() then return false end
                    local ok,ready=pcall(check)
                    if ok and ready then return true end
                    task.wait(0.04)
                until os.clock()>=deadline
                return false
            end
            local tool=H.findTool(found.UUID)
            if not tool and sameCharacter() then
                Hub.InventoryChestStatus="Loading chest tool"
                pcall(function() invService:put_in_hotbar_backpack(found.UUID) end)
                quicklyConfirmed(function() tool=H.findTool(found.UUID);return tool~=nil end,2.6)
            end
            if not tool or not sameCharacter() then Hub.InventoryChestStatus="Chest tool not available";H.Failures["chest:"..found.UUID]=os.clock()+7;return end
            if tool.Parent~=character then
                Hub.InventoryChestStatus="Equipping chest"
                pcall(function() invService:equip(found.UUID) end)
                quicklyConfirmed(function() return tool.Parent==character end,2.6)
            end
            if not sameCharacter() then return end
            if tool.Parent~=character then Hub.InventoryChestStatus="Chest equip unconfirmed";return end
            local root=character:FindFirstChild("HumanoidRootPart")
            local hum=character:FindFirstChildOfClass("Humanoid")
            if not root or not hum or hum.Health<=0 then return end
            local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
            params.RespectCanCollide=true;params.FilterDescendantsInstances={character}
            local forward=workspace:Raycast(root.Position,root.CFrame.LookVector*9,params)
            local distance=forward and math.clamp(forward.Distance-4,0,5) or 5
            local ahead=root.Position+root.CFrame.LookVector*distance
            local hit=workspace:Raycast(ahead+Vector3.new(0,3,0),Vector3.new(0,-56,0),params)
            if not hit then Hub.InventoryChestStatus="Waiting for solid ground";return end
            local existing={};for _,obj in ipairs(chests:GetChildren()) do existing[obj]=true end
            if not sameCharacter() then return end
            local sent,reply=pcall(function() return chestService:PlaceChest(CFrame.new(hit.Position)) end)
            local confirmed=sent and quicklyConfirmed(function()
                for _,obj in ipairs(chests:GetChildren()) do
                    if not existing[obj] and tostring(obj:GetAttribute("Owner"))==tostring(LocalPlayer.UserId) then return true end
                end
                return false
            end,3.1)
            -- Chest placement is confirmed by the new owned model, not by
            -- delaying several seconds for a promise that may resolve later.
            if not sameCharacter() then return end
            if confirmed then
                Hub.InventoryChestPlaced+=1
                Hub.InventoryChestStatus="Placed chest; claiming rewards"
                Hub.ChestNextScan=0
                -- The placed model now blocks new placement until the collector drains it.
                Hub.InventoryChestPendingUntil=os.clock()+0.07
            else
                H.Failures["chest:"..found.UUID]=os.clock()+20
                Hub.InventoryChestStatus="Placement unconfirmed"
                Hub.InventoryChestPendingUntil=os.clock()+0.7
            end
        end,function(ok)
            -- Do not equip the previous sword/rod between every chest in a batch.
            -- Restore it only when chest opening stops or no selected chests remain.
            Hub.Runtime.InventoryRestore=nil
            Hub.InventoryChestBusy=false
            Hub.InventoryChestLast=os.clock()
            if not ok then Hub.InventoryChestStatus="Chest action error; retry delayed" end
        end)
    end
    task.spawn(function()
        while Hub.Running do
            local ok,err=pcall(function()
                H.refreshBindings();H.milestones();H.stats();H.gear()
            end)
            if not ok then Hub.Stats.Errors+=1;Hub.Stats.LastError="Progression: "..tostring(err) end
            task.wait(.35)
        end
    end)
    -- v68: Chest queue reacts within ~0.1s of the previous chest being drained,
    -- without multiplying the unrelated progression-service polling.
    task.spawn(function()
        while Hub.Running do
            if Hub.AutoInventoryChests then
                local ok,err=pcall(H.inventoryChests)
                if not ok then
                    Hub.Stats.Errors+=1
                    Hub.Stats.LastError="Inventory chests: "..tostring(err)
                end
            end
            task.wait(.055)
        end
    end)
end


