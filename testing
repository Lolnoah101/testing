        end
        if type(tbl.byId) == "table" and type(tbl.byId[id]) == "table" then return tbl.byId[id] end
        if type(tbl[id]) == "table" then return tbl[id] end
        if type(tbl.list) == "table" then
            for _, x in ipairs(tbl.list) do
                if type(x) == "table" and x.id == id then return x end
            end
        end
