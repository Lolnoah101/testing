--==============================================================
-- ANTI AFK
-- Event-driven only: sends a tiny virtual controller input when Roblox
-- reports this client as idle. It does not move the character around.
--==============================================================

function Systems.pulseAntiAFK()
    if not Config.AntiAFK
        or not State.Alive then

        return false
    end

    State.AntiAFKTriggers += 1
    State.AntiAFKLastAt =
        os.clock()

    State.AntiAFKStatus =
        "Idle pulse #"
        .. tostring(
            State.AntiAFKTriggers
        )

    local ok, err =
        pcall(function()
            VirtualUser:
                CaptureController()

            local camera =
                workspace.CurrentCamera

            local cf =
                camera
                and camera.CFrame
                or CFrame.new()

            VirtualUser:
                Button2Down(
                    Vector2.new(
                        0,
                        0
                    ),
                    cf
                )

            task.wait(0.03)

            VirtualUser:
                Button2Up(
                    Vector2.new(
                        0,
                        0
                    ),
                    cf
                )
        end)

    if not ok then
        State.AntiAFKStatus =
            "Pulse failed: "
            .. tostring(err)

        return false
    end

    return true
end

--==============================================================
-- AFK STABILITY WATCHDOG
-- Keeps the script's own automation from getting stuck while unattended.
-- It does NOT spoof user input or bypass Roblox idle enforcement.
--==============================================================

function Systems.markAFKProgress(reason)
    State.AFKLastProgressAt =
        os.clock()

    State.AFKLastCaught =
        tonumber(State.Caught) or 0

    State.AFKLastEscaped =
        tonumber(State.Escaped) or 0

    State.AFKLastPhase =
        tostring(State.Phase or "Idle")

    State.AFKLastOwner =
        tostring(
            State.CoordinatorOwner
            or "Idle"
        )

    if reason then
        State.AFKStatus =
            tostring(reason)
    end
end

function Systems.hasAFKProgress()
    local caught =
        tonumber(State.Caught) or 0

    local escaped =
        tonumber(State.Escaped) or 0

    local phase =
        tostring(State.Phase or "Idle")

    local owner =
        tostring(
            State.CoordinatorOwner
            or "Idle"
        )

    if caught ~= State.AFKLastCaught
        or escaped ~= State.AFKLastEscaped
        or phase ~= State.AFKLastPhase
        or owner ~= State.AFKLastOwner then

        Systems.markAFKProgress(
            "Progress detected"
        )

        return true
    end

    return false
end

function Systems.softAFKRecovery()
    State.AFKSoftResets += 1

    State.AFKStatus =
        "Soft recovery"

    State.LastRodWatchCheck = 0
    State.LastBestSkillCheck = 0
    State.AutoEquipRodLastAt = 0
    State.AutoEquipRodPendingUntil = 0
    State.AutoLookForceCheck = true
    State.AutoLookLastWatchAt = 0
    State.CoordinatorForceRecheck = true

    if Config.Enabled
        and State.Phase == "Idle" then

        resetOPSession(0.10)
    end

    task.defer(function()
        if not State.Alive then
            return
        end

        if Config.AutoEquipRod then
            pcall(
                Systems.stepAutoEquipRod
            )
        end

        pcall(
            Systems.stepFishingRodWatchdog
        )

        if Config.AutoEquipBestSkills then
            pcall(
                Systems.stepBestSkillLoadoutWatcher
            )
        end

        if Config.AutoLookAtWater then
            State.AutoLookForceCheck = true
        end
    end)

    Systems.markAFKProgress(
        "Soft recovery completed"
    )
end

function Systems.hardAFKRecovery()
    State.AFKHardResets += 1

    State.AFKStatus =
        "Hard OP reset"

    mouseUp()

    pcall(function()
        safeFire(
            FishingPackets.FishCancel
        )
    end)

    State.QTEGeneration += 1
    State.QTEActiveUntil = 0
    State.FirstPullGeneration += 1
    State.ResultGeneration += 1

    State.LastCastStarted = 0
    State.LastPrimaryClick = 0
    State.NextReelAt = 0
    State.NextSkillAt = 0
    State.NextLootClickAt = 0

    State.LastRodWatchCheck = 0
    State.LastBestSkillCheck = 0
    State.AutoEquipRodLastAt = 0
    State.AutoEquipRodPendingUntil = 0

    State.AutoLookForceCheck = true
    State.AutoLookLastWatchAt = 0
    State.CoordinatorForceRecheck = true

    resetOPSession(0.20)

    Systems.markAFKProgress(
        "Hard OP reset completed"
    )
end

function Systems.stepAFKStabilityWatchdog()
    if not Config.AFKWatchdog
        or not State.Alive then

        State.AFKStatus =
            "Disabled"

        return
    end

    if State.AFKLastProgressAt <= 0 then
        Systems.markAFKProgress(
            "Watching automation"
        )

        return
    end

    if Systems.hasAFKProgress() then
        return
    end

    -- Don't reset while expected movement/action owners are actively busy.
    if State.TravelBusy
        or State.AutoSellBusy
        or State.BossBusy
        or State.BossOwnedMovement
        or State.ProgressionNavigationBusy
        or State.QuestBusy
        or State.SkillTransferBusy
        or State.RodRecoveryBusy then

        State.AFKStatus =
            "Waiting on active task"

        State.AFKLastProgressAt =
            os.clock()

        return
    end

    if not Config.Enabled then
        State.AFKStatus =
            "Fishing disabled"

        State.AFKLastProgressAt =
            os.clock()

        return
    end

    local elapsed =
        os.clock()
        - State.AFKLastProgressAt

    local hardTimeout =
        math.max(
            60,
            tonumber(
                Config.AFKHardResetTimeout
            ) or 90
        )

    local softTimeout =
        math.max(
            20,
            math.min(
                hardTimeout - 10,
                tonumber(
                    Config.AFKStuckTimeout
                ) or 45
            )
        )

    if elapsed >= hardTimeout then
        Systems.hardAFKRecovery()

    elseif elapsed >= softTimeout then
        Systems.softAFKRecovery()

    else
        State.AFKStatus =
            string.format(
                "Watching • %.0fs since progress",
                elapsed
            )
    end
end

