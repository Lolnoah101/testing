        if status == "rejected" or status == "failed" or status == "error" then
            lobbyState.queueRejected = true
            lobbyState.queueIssued = false
            local reason = packet.reason or packet.message
            if type(reason) ~= "string" then reason = status end
            lobbyState.queueStatus = "Server declined queue: " .. reason:sub(1, 110)
        elseif queueEnded[status] then
