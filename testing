function Hub:V53WaterDistance(part,point)
    if typeof(point)~="Vector3" then return math.huge end
    local water=self.V44.FishWater
    local ok,size=pcall(function() return water.EffectiveSize(part) end)
    local half=(ok and typeof(size)=="Vector3" and size or part.Size)*.5
    local localPoint=part.CFrame:PointToObjectSpace(point)
    local dx=math.max(0,math.abs(localPoint.X)-half.X)
    local dz=math.max(0,math.abs(localPoint.Z)-half.Z)
    -- Prefer the closest surface footprint; center-of-part distances can
    -- exclude enormous fishing water planes right beside the player.
    return math.sqrt(dx*dx+dz*dz)+math.abs(localPoint.Y-half.Y)*.025
end
function Hub:V50FishSurface(part,root)
    local config=self.V44.FishConfig
    if not part or not root then return nil,nil end
    local water=self.V44.FishWater
    local ok,size=pcall(function() return water.EffectiveSize(part) end)
    local half=(ok and typeof(size)=="Vector3" and size or part.Size)*.5
    local localRoot=part.CFrame:PointToObjectSpace(root.Position)
    local function castAt(localPosition)
        local safeX=math.clamp(localPosition.X,-math.max(1,half.X-2),math.max(1,half.X-2))
        local safeZ=math.clamp(localPosition.Z,-math.max(1,half.Z-2),math.max(1,half.Z-2))
        return part.CFrame:PointToWorldSpace(Vector3.new(safeX,half.Y,safeZ))
    end
    local point=castAt(localRoot)
    local horizontal=Vector3.new(point.X-root.Position.X,0,point.Z-root.Position.Z)
    if horizontal.Magnitude<config.MinCastRange+2 then
        local direction=Vector3.new(part.Position.X-root.Position.X,0,part.Position.Z-root.Position.Z)
        if direction.Magnitude<.1 then
            direction=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
        end
        if direction.Magnitude>.1 then
            local aim=root.Position+direction.Unit*(config.MinCastRange+5)
            local candidate=castAt(part.CFrame:PointToObjectSpace(aim))
            local d=Vector3.new(candidate.X-root.Position.X,0,candidate.Z-root.Position.Z).Magnitude
            if d>=config.MinCastRange+1 and d<=config.CastRange-1 then
                point=candidate
                horizontal=Vector3.new(point.X-root.Position.X,0,point.Z-root.Position.Z)
            end
        end
    end
    if horizontal.Magnitude>=config.MinCastRange+1 and horizontal.Magnitude<=config.CastRange-1 then
        local valid,surface=pcall(function() return water.SurfaceAt({part},point) end)
        if valid and surface then return point,nil end
    end
    -- Candidate banks near the water edge. Only select confirmed dry terrain.
    local candidates={Vector3.new(half.X+8,0,0),Vector3.new(-half.X-8,0,0),Vector3.new(0,0,half.Z+8),Vector3.new(0,0,-half.Z-8)}
    local rp=RaycastParams.new();rp.FilterType=Enum.RaycastFilterType.Exclude;rp.FilterDescendantsInstances={LocalPlayer.Character,part}
    local best,score
    for _,offset in ipairs(candidates) do
        local bank=part.CFrame:PointToWorldSpace(offset)
        local hit=workspace:Raycast(bank+Vector3.new(0,35,0),Vector3.new(0,-110,0),rp)
        if hit and hit.Instance and not hit.Instance:IsDescendantOf(part) then
            local dest=hit.Position+Vector3.new(0,3.5,0)
            local d=(dest-root.Position).Magnitude
            if not score or d<score then best=dest;score=d end
        end
    end
    return point,best
end
function Hub:V45FishingTick(now)
