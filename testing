local GENV = getgenv()


--// Any current/future mode whose internal key ends in "raid" is handled by
--// the dedicated Raid farm runtime instead of Story/Endless progression.
GENV.__AZ_IS_RAID_MODE = function(Mode)
    Mode = Mode or workspace:GetAttribute("Mode")

    return type(Mode) == "string"
        and string.sub(string.lower(Mode), -4) == "raid"
end


--//============================================================
--// LOAD-SAFE BOOTSTRAP
--//
--// queue_on_teleport / executor auto-execute can run this script before
--// Anime Zero has finished replicating its lobby/dungeon modules.  The old
--// code used FindFirstChild immediately, so a too-early run could create a
--// working-looking UI and then permanently return from the automation
--// engines. Wait for the actual place modules BEFORE building/starting them.
--//
--// Kept inside its own scope so it does not consume the main Luau local
--// register budget.
--//============================================================

GENV.__AZ_BOOT_PLACE = nil

;(function()

    if not game:IsLoaded() then
        game.Loaded:Wait()
    end


    local ReplicatedStorageService =
        game:GetService(
            "ReplicatedStorage"
        )


    local Deadline =
        os.clock() + 60


    while os.clock() < Deadline do

        -- Dungeon/endless/story place readiness.  Wait for the exact modules
        -- the farm engine later checks with FindFirstChild so it cannot return
        -- just because replication was a fraction of a second late.
        local GameFolderReady =
            ReplicatedStorageService
                :FindFirstChild(
                    "game"
                )


        if GameFolderReady then

            local Stores =
                GameFolderReady
                    :FindFirstChild(
                        "stores"
                    )


            local Packets =
                GameFolderReady
                    :FindFirstChild(
                        "packets"
                    )


            local Global =
                ReplicatedStorageService
                    :FindFirstChild(
                        "global"
                    )


            if Stores
                and Packets
                and Stores:FindFirstChild("enemyStore")
                and Stores:FindFirstChild("playerNamespace")
                and Stores:FindFirstChild("runStore")
                and Packets:FindFirstChild("characterPackets")
                and Global
                and Global:FindFirstChild("constants")
            then

                GENV.__AZ_BOOT_PLACE =
                    "Dungeon"

                return
            end
        end




        -- Lobby place readiness.  Do not require anything here; Rayfield UI
        -- still needs to be created before the game's lobby ModuleScripts.
        local Lobby =
            ReplicatedStorageService
                :FindFirstChild(
                    "lobby"
                )


        if Lobby then

            local Global =
                ReplicatedStorageService
                    :FindFirstChild(
                        "global"
                    )


            local Assets =
                ReplicatedStorageService
                    :FindFirstChild(
                        "assets"
                    )


            if Lobby:FindFirstChild("packets")
                and Lobby:FindFirstChild("enums")
                and Lobby:FindFirstChild("stores")
                and Global
                and Assets
            then

                GENV.__AZ_BOOT_PLACE =
                    "Lobby"

                return
            end
        end


        task.wait(0.10)
    end
end)()


if not GENV.__AZ_BOOT_PLACE then

    warn(
        "[Anime Zero] Startup timed out waiting for game modules. Re-execute after the place finishes loading."
    )

    return
end


print(
    "[Anime Zero] Load-safe bootstrap ready:",
    GENV.__AZ_BOOT_PLACE
)

if type(GENV.__AZ_RUNTIME) == "table" then
    if type(GENV.__AZ_RUNTIME.Connections) == "table" then
        for _, Connection in pairs(GENV.__AZ_RUNTIME.Connections) do
            pcall(function()
                Connection:Disconnect()
            end)
        end
    end
end

GENV.__AZ_RUNTIME = nil


for _, Name in ipairs({
    "__ANIME_ZERO_SESSION",
    "__ANIME_ZERO_FARM",
    "__ANIME_ZERO_FARM_SESSION",
    "__AZ_FARM_SESSION",
}) do
    shared[Name] = {}
end


for _, Name in ipairs({
