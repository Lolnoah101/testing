    local function GetEvolutionRequirements(
        Character
    )

        local Definition =
            GetEvolutionDefinition(
                Character
            )


        if not Definition then
            return nil
        end


        local Requirements = {}

        local MaterialText =
            Definition.ultimate


        if type(MaterialText) == "string"
            and MaterialText ~= ""
        then

            for Entry in string.gmatch(
                MaterialText,
                "[^|]+"
            ) do

                local MaterialId,
                    AmountText =
                    string.match(
                        Entry,
                        "^%s*([^,]+)%s*,%s*(%d+)%s*$"
                    )


                local Amount =
                    tonumber(AmountText)


                if MaterialId
                    and Amount
                then

                    table.insert(
                        Requirements,
                        {
                            Kind = "material",
                            Id = tostring(MaterialId),
                            Need = Amount,
                        }
                    )
                end
            end
        end


        if type(Definition.currencies)
            == "table"
        then

            for _, Requirement in ipairs(
                Definition.currencies
            ) do

                if type(Requirement) == "table"
                    and type(Requirement.currency)
                        == "string"
                    and tonumber(Requirement.amount)
                then

                    table.insert(
                        Requirements,
                        {
                            Kind = "currency",
                            Id = Requirement.currency,
                            Need = tonumber(
                                Requirement.amount
                            ),
                        }
                    )
                end
            end
        end


        return Requirements
    end


    local function GetEvolutionRequirementHave(
        Data,
        Requirement
    )

        if Requirement.Kind
            == "material"
        then

            return tonumber(
                Data.material
                and Data.material[
                    Requirement.Id
                ]
            ) or 0
        end


        if Requirement.Kind
            == "currency"
        then

            return tonumber(
                Data.currencies
                and Data.currencies[
                    Requirement.Id
                ]
            ) or 0
        end


        return 0
    end


    local function GetEvolutionRequirementName(
        Requirement
    )

        if Requirement.Kind
            == "material"
        then

            return MaterialNames[
                Requirement.Id
            ]
                or (
                    "Material "
                    .. tostring(
                        Requirement.Id
                    )
                )
        end


        return CurrencyNames[
            Requirement.Id
        ]
            or tostring(
                Requirement.Id
            )
    end


    local function CheckEvolutionRequirements(
        Character,
        Data
    )

        local Requirements =
            GetEvolutionRequirements(
                Character
            )


        if not Requirements then
            return false, nil, nil
        end


        local Missing = {}


        for _, Requirement in ipairs(
            Requirements
        ) do

            local Have =
                GetEvolutionRequirementHave(
                    Data,
                    Requirement
                )


            if Have < Requirement.Need then

                table.insert(
                    Missing,
                    {
                        Name =
                            GetEvolutionRequirementName(
                                Requirement
                            ),
                        Have = Have,
                        Need = Requirement.Need,
                        Missing =
                            Requirement.Need
                            - Have,
                    }
                )
            end
        end


        return #Missing == 0,
            Missing,
            Requirements
    end


