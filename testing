            == "table"
        then

            for _, Requirement in ipairs(
                Definition.currencies
            ) do

                if type(Requirement) == "table"
                    and type(Requirement.currency)
                        == "string"
                    and tonumber(Requirement.amount)
                then

                    table.insert(
                        Requirements,
                        {
                            Kind = "currency",
                            Id = Requirement.currency,
                            Need = tonumber(
                                Requirement.amount
                            ),
                        }
                    )
                end
            end
        end


        return Requirements
    end


    local function GetEvolutionRequirementHave(
        Data,
        Requirement
    )

        if Requirement.Kind
            == "material"
        then

            return tonumber(
                Data.material
                and Data.material[
                    Requirement.Id
                ]
            ) or 0
        end


        if Requirement.Kind
            == "currency"
        then

            return tonumber(
                Data.currencies
                and Data.currencies[
                    Requirement.Id
                ]
            ) or 0
        end


        return 0
    end


    local function GetEvolutionRequirementName(
        Requirement
    )

        if Requirement.Kind
            == "material"
        then

            return MaterialNames[
                Requirement.Id
            ]
                or (
                    "Material "
                    .. tostring(
                        Requirement.Id
                    )
                )
        end


        return CurrencyNames[
            Requirement.Id
        ]
            or tostring(
                Requirement.Id
            )
    end


    local function CheckEvolutionRequirements(
        Character,
        Data
    )

        local Requirements =
            GetEvolutionRequirements(
                Character
            )


        if not Requirements then
            return false, nil, nil
        end


        local Missing = {}


        for _, Requirement in ipairs(
            Requirements
        ) do

            local Have =
                GetEvolutionRequirementHave(
                    Data,
                    Requirement
                )


            if Have < Requirement.Need then

                table.insert(
                    Missing,
                    {
                        Name =
                            GetEvolutionRequirementName(
                                Requirement
                            ),
                        Have = Have,
                        Need = Requirement.Need,
                        Missing =
                            Requirement.Need
                            - Have,
                    }
                )
            end
        end


        return #Missing == 0,
            Missing,
            Requirements
    end


    local function EvolutionMissingText(
        Missing
    )

        local Lines = {}


        for _, Info in ipairs(
            Missing or {}
        ) do

            table.insert(
                Lines,
                Info.Name
                    .. ": Have "
                    .. tostring(
                        Info.Have
                    )
                    .. " / Need "
                    .. tostring(
                        Info.Need
                    )
                    .. " / Missing "
                    .. tostring(
                        Info.Missing
                    )
            )
        end


        return table.concat(
            Lines,
            "\n"
        )
    end


    local function OwnsEvolutionCharacter(
        Data,
        Character
    )

        if not Data
            or not Data.UnlockedCharacters
        then

            return false
        end


        for SlotNumber = 1, 4 do

            local SlotData =
                Data.UnlockedCharacters[
                    "Slot"
                    .. tostring(
                        SlotNumber
                    )
                ]


            if SlotData
                and SlotData.Unlocked == true
                and tostring(
                    SlotData.Character or ""
                ) == Character
            then

                return true
            end
        end


        return false
    end


    RefreshEvolutionSlots = function(
        NotifyIfEmpty
    )

        local Data =
            GetExtraAccountData()


        if not Data
            or not Data.UnlockedCharacters
        then

            if NotifyIfEmpty then
                QueueNotification(
                    "Evolutions",
                    "Account slot data is not ready yet.",
                    4
                )
            end

            return false
        end


        local PreviousCharacter =
            ExtraSettings.EvolutionSelection

        local Options = {}

        local PreferredOption = nil


        table.clear(
            EvolutionOptionToCharacter
        )

        table.clear(
            EvolutionOptionToSlot
        )


        for SlotNumber = 1, 4 do

            local SlotName =
                "Slot"
                .. tostring(
                    SlotNumber
                )

            local SlotData =
                Data.UnlockedCharacters[
                    SlotName
                ]


            if SlotData
                and SlotData.Unlocked == true
            then

                local Character =
                    tostring(
                        SlotData.Character
                        or ""
                    )


                if Character ~= "" then

                    local DisplayName =
                        WeaponIdToName[
                            Character
                        ]
                        or Character

                    local IsEvolved =
                        Data.CharactersData
                        and Data.CharactersData[
                            Character
                        ]
                        and Data.CharactersData[
                            Character
                        ].IsUltimateUnlocked
                            == true

                    local Label =
                        "Slot "
                        .. tostring(
                            SlotNumber
                        )
                        .. " - "
                        .. DisplayName
                        .. (
                            IsEvolved
                            and " [Evolved]"
                            or ""
                        )


                    table.insert(
                        Options,
                        Label
                    )

                    EvolutionOptionToCharacter[
                        Label
                    ] = Character

                    EvolutionOptionToSlot[
                        Label
                    ] = SlotNumber


                    if Character
                        == PreviousCharacter
                        and not PreferredOption
                    then

                        PreferredOption = Label
                    end
                end
            end
        end


        pcall(function()
            EvolutionDropdown:Refresh(
                Options
            )
        end)


        if #Options == 0 then

            ExtraSettings.EvolutionSelection =
                nil


            if NotifyIfEmpty then
                QueueNotification(
                    "Evolutions",
                    "No unlocked slot characters were found.",
                    5
                )
            end


            return false
        end


        local Selection =
            PreferredOption
            or Options[1]


        ExtraSettings.EvolutionSelection =
            EvolutionOptionToCharacter[
                Selection
            ]


        pcall(function()
            EvolutionDropdown:Set(
                Selection,
                true
            )
        end)


        return true
    end


    -- Populate the slot dropdown once account data is available.
    -- This is event-driven; there is no continuous status watcher.
    task.spawn(function()

        if GetExtraAccountData() then

            RefreshEvolutionSlots(
                false
            )

            return
        end


        if ExtraAccountNamespace
            and type(
                ExtraAccountNamespace.onLocalAccountLoad
            ) == "function"
        then

            local Success,
                Cleanup =
                pcall(function()

                    return ExtraAccountNamespace
                        .onLocalAccountLoad(
                            function()

                                if ExtraAlive() then
                                    RefreshEvolutionSlots(
                                        false
                                    )
                                end
                            end
                        )
                end)


            if Success
                and Cleanup
            then

                table.insert(
                    ExtraRuntime.Connections,
                    Cleanup
                )
            end
        end
    end)


