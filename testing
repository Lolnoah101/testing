            if state.currency~="Lucky" then state.currency="Normal" end
            updateWatcher()
        end,
    })
    tab:CreateToggle({
        name="Auto Roll Family",value=false,flag="MenuAutoRollFamilyV130",
        callback=function(v)
            state.enabled=v==true
            if state.enabled then
                state.status="Checking family and spins"
                state.data=nil;state.lastRead=-100;state.nextAttemptAt=0
            else
                state.status="Paused"
            end
            updateWatcher()
        end,
    })
    state.connection=RunService.Heartbeat:Connect(function(dt)
        if Farm.unloaded then return end
        state.elapsed=state.elapsed+dt
        if state.elapsed<0.12 then return end
        state.elapsed=state.elapsed%0.12
        local now=os.clock()
        if not state.busy and not state.reading and
            (state.data==nil and now-state.lastRead>=1.0
             or not state.enabled and now-state.lastRead>=2.0) then
            task.spawn(readData)
        elseif state.enabled and state.data and not state.busy and not state.reading
            and now>=state.nextAttemptAt then
            state.busy=true
            task.spawn(function()
                local ok=pcall(rollOnce)
                if not ok then stop("Roll error; stopped") end
                state.busy=false
                state.nextAttemptAt=os.clock()+0.16
                updateWatcher()
            end)
        end
        updateWatcher()
    end)
    task.defer(readData)
    updateWatcher()
end

