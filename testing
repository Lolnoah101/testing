-- Reconnect only after a persistent, explicit network disconnect (code 277).
-- Never reconnect due to general ErrorPrompt text, teleport initialization
-- failures, normal transitions, or while the player is still loading.
-- One attempt is allowed per 10 minutes ACROSS places/script executions.
-- On a genuine disconnect, return to the lobby, not a reserved battle instance.
local MAIN_LOBBY_PLACE_ID = 6938803436
local RECONNECT_COOLDOWN_SECONDS = 600
local function attemptReconnect()
    if not (S.alive and S.autoReconnect) or S.reconnectTriggered then return end
    if os.clock() < (S.reconnectArmedAt or math.huge) then return end
    if not statsReady() then return end
    if S.lobbyBusy or S.roomStartRequested then return end
    local epoch = os.time()
    if epoch - (S.lastReconnectEpoch or 0) < RECONNECT_COOLDOWN_SECONDS then return end

    S.reconnectTriggered = true
    S.lastReconnectEpoch = epoch
    S.lastReconnectAttempt = os.clock()
    -- Prevent a saved Auto Start setting from sending the player straight
    -- back into another room after recovery, appearing to reconnect forever.
    S.autoStart = false
    S.sessionStopped = true
    savePreferences()  -- Persist cooldown and paused Auto Start before teleport.
    if S.autoExecute then installTeleportBootstrap() end
    task.spawn(function()
        local ok, err = pcall(function()
            TeleportService:Teleport(MAIN_LOBBY_PLACE_ID, player)
        end)
        if not ok then
            -- Do NOT clear reconnectTriggered; a failed one-shot rejoin
            -- should not result in repeated teleports from the same prompt.
            warnOnce("Network reconnect could not start: " .. tostring(err))
        end
    end)
end

local function watchDisconnectPrompt()
    local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if not ok or not coreGui then return end
    local hooked, pending = {}, {}
    local function confirmedNetworkDisconnect(gui)
        if not gui or not gui.Parent then return false end
        local node = gui
        while node and node ~= coreGui do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("ScreenGui") and not node.Enabled then return false end
            node = node.Parent
        end
        local words = {}
        for _, child in ipairs(gui:GetDescendants()) do
            if (child:IsA("TextLabel") or child:IsA("TextButton")) and child.Visible then
                words[#words+1] = tostring(child.Text):lower()
            end
        end
        local msg = table.concat(words, " ")
        -- Deliberately require code 277. Generic text such as 'disconnected'
        -- can be shown during an interrupted transition, and 279 is commonly
        -- a failed JOIN, not a confirmed disconnect from an active server.
        return msg:find("error code: 277", 1, true) ~= nil
            or msg:find("error code 277", 1, true) ~= nil
            or msg:find("error code (277)", 1, true) ~= nil
    end
    local function examine(gui)
        if gui.Name ~= "ErrorPrompt" or hooked[gui] then return end
        hooked[gui] = true
        local function check()
            if pending[gui] then return end
            pending[gui] = true
            -- The exact error must persist for five seconds, not a brief
            -- dialog that appears during ordinary place transitions.
            task.delay(5, function()
                pending[gui] = nil
                if S.alive and S.autoReconnect and confirmedNetworkDisconnect(gui) then
                    attemptReconnect()
                end
            end)
        end
        check()
        local function watchText(child)
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local good, con = pcall(function()
                    return child:GetPropertyChangedSignal("Text"):Connect(check)
                end)
                if good and con then S.connections[#S.connections+1] = con end
            end
        end
        for _, child in ipairs(gui:GetDescendants()) do watchText(child) end
        if gui:IsA("GuiObject") then
            local good, con = pcall(function()
                return gui:GetPropertyChangedSignal("Visible"):Connect(check)
            end)
            if good and con then S.connections[#S.connections+1] = con end
        end
        local good, con = pcall(function()
            return gui.DescendantAdded:Connect(function(child)
                watchText(child)
                check()
            end)
        end)
        if good and con then S.connections[#S.connections+1] = con end
    end
    local good, con = pcall(function()
        return coreGui.DescendantAdded:Connect(examine)
    end)
    if good and con then S.connections[#S.connections+1] = con end
    local listed, descendants = pcall(function() return coreGui:GetDescendants() end)
    if listed then
        for _, item in ipairs(descendants) do examine(item) end
    end
end
