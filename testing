    local function formatField(lines)
        if #lines == 0 then return "`Not available from game results`" end
        local raw = table.concat(lines, "\n")
        if #raw > 990 then raw = raw:sub(1, 985) .. "..." end
        return "```\n" .. raw .. "\n```"
    end
    -- A shadow-ban status cannot be inferred from missed hits, matchmaking,
    -- rewards, client timing, or the lack of a visible ban warning.
    -- Only report definite status if the game explicitly provides a boolean
    -- on the local Player. Without that signal, avoid a false "not banned".
    local function getShadowBanStatus()
        local keys = {"ShadowBanned", "Shadow_Banned", "ShadowBan"}
        for _, key in ipairs(keys) do
            local value = LocalPlayer:GetAttribute(key)
            if type(value) == "boolean" then
                return value
                    and "You are shadow banned (game-reported)"
                    or "You are not shadow banned (game-reported)"
            end
        end
        return "Unable to verify — game does not expose a confirmed status"
    end
    local function buildEmbed(testMode, rewardOrdinary, rewardDrops, rewardSpecial, matchStats)
