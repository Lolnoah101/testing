            end
            -- The previous default was Refills only; upgrade that default to
            -- the newly requested five-step priority. Preserve custom picks.
            if #values==0 or (#values==1 and values[1]=="Refills") then
                value={"Refills","Revive","Replenish","Regen","Max"}
            else
                value=values
            end
        end
        if value==nil and oldWaveFlags[flag] and prefs[oldWaveFlags[flag]]~=nil then
            local old=prefs[oldWaveFlags[flag]]
            value=type(old)=="string" and {old} or old
        end
        -- One-time migration: previous Orbit Width allowed up to 400%.
        -- The new control accepts only 25..100; reject stale out-of-range values.
        if flag=="MomentumOrbitWidthV69" then
            if value==nil then value=prefs.MomentumOrbitWidthV67 end
            value=math.clamp(tonumber(value) or 100,25,100)
        end
        if value == nil then return end
        local category=flag:match("^WavesChoice(.-)V76$")
        if category and (category=="Perks" or category=="Artifacts"
            or category=="Memories" or category=="Shifting")
            and Farm.Waves then
            Farm.Waves.pick[category]=type(value)=="table" and value or {value}
            -- Once live Items arrive, updateItems will reflect the saved picks.
            return
        end
        -- Do not attempt to restore hidden controls. Rayfield maintains
        -- distinct files for each mode; shared JSON retains their values.
        local hasControl, current = pcall(function() return window:Get(flag) end)
        if not hasControl or current == nil then return end
        if flag=="LobbyModifiersV52" then
            local selected=normalizeModifierSelection(value,Farm.lobbyModifier,
                Farm.lobbyMode,Farm.lobbyObjective,Farm.lobbyDifficulty)
            value=modifierDisplaySelection(selected,Farm.lobbyMode)
        end
        local ok, result = pcall(function() return window:Set(flag, value) end)
        if ok and result ~= false then restored=restored+1 end
    end
    for _, flag in ipairs(RESTORE_FIRST) do apply(flag) end
    for _, flag in ipairs(ALL_SETTING_FLAGS) do
        if not attempted[flag] then apply(flag) end
    end
    inPreferencesRestore = false
    return restored, "Restored saved UI selections; dynamic owned-item choices require their inventory to load"
end
