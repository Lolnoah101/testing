        -- Track CURRENT floor enemies, not FloodGateCrowd (player occupancy).
        -- The lobby/other raids still use their original enemy selection.
        local function TidalLivingFloorEnemies(Floor)
            if not TidalHeight[Floor] then return 0 end
            local Snapshot = GetEnemySnapshot2()
            local Count = 0
            for _, Enemy in ipairs(Snapshot) do
                if Enemy.Root and Enemy.Root.Parent and not Enemy.Guarded
                    and TidalEnemyOnFloorY(Enemy.Root.Position.Y, Floor)
                then
                    local HealthLeaf = Enemy.State and Enemy.State.health
                    local Health = HealthLeaf and tonumber(ReadLeaf(HealthLeaf)) or nil
                    local Humanoid = Enemy.Model
                        and Enemy.Model:FindFirstChildOfClass("Humanoid")
                    if (Health == nil or Health > 0)
                        and (not Humanoid or Humanoid.Health > 0) then
                        Count += 1
                    end
                end
            end
            return Count
        end

        local function TickAutoTidal(T, DeltaTime)
            if not Settings.AutoTidalFarm then
                T.stage = "Disabled"
                T.goal = nil
                T.tweenTravelActive = false
                if T.wasEnabled and GENV.__AZ_LEGIT_NAV then
                    GENV.__AZ_LEGIT_NAV.Reset("Tidal disabled")
                end
                if T.wasEnabled and GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
                T.wasEnabled = false
                T.parkingCombatActive = false
                return
            end
            T.wasEnabled = true
            local Root = GetRoot2()
            if not Root or not Alive2() then
                T.stage = "Waiting for character"
                return
            end
            local Floor = math.clamp(math.floor(tonumber(T.floor) or 0), 0, 12)
            local Phase = tostring(T.phase or "waiting"):lower()
            if T.locked then
                T.stage = "Flood-locked: waiting for recovery"
                return
            end
            local _, Map, Markers = TidalMap()
            if not Map or not Markers then
                T.stage = "Waiting for Flood map/markers"
                return
            end
            if T.roof then Floor = 12 end
            -- A Floor 10 Tween may legitimately travel THROUGH geometry
            -- between the upper gate and lower enemy deck. Do not restore
            -- collisions every heartbeat in the middle of that transition:
            -- it would trap the avatar against a rail, floor or ceiling.
            -- The moving controller owns temporary noclip until arrival.
            if Settings.FarmMethod ~= "Tween"
                or T.tweenTravelActive ~= true
            then
                T.tweenTravelActive = false
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
            end
            if TidalFallRecovery(T, Root, Floor) then return end
            if (T.recoveryGraceUntil or 0) > os.clock() then
                T.stage = "Underground recovery: waiting to settle onto solid floor"
                return
            end
            local TargetFloor = Floor == 0 and 1 or math.min(Floor + 1, 12)
            local Fight = Phase == "fight" or T.roof
            local GateContested = Phase == "block"
                and workspace:GetAttribute("FloodGateContested") == true
            local FloorEnemyCount = TidalLivingFloorEnemies(Floor)
            local ServerRemaining = tonumber(T.remaining)
            -- runStore.remaining is authoritative for the FIGHT portion of
            -- a floor, when enemies may be outside replication distance.
            -- Crucially, it is NOT a gate-clear condition: the official HUD
            -- switches to FloodPhase="block" for gate/lever objectives while
            -- runStore.remaining may still be nonzero or behind replication.
            -- Once block begins, only *living visible enemies on this floor*
            -- hold combat ownership; otherwise approach the physical gate.
            local VisibleFloorEnemies = FloorEnemyCount > 0
            local ServerFightEnemies = Phase == "fight"
                and ServerRemaining ~= nil and ServerRemaining > 0
            local HasEnemies = VisibleFloorEnemies or ServerFightEnemies
            T.floorEnemies = FloorEnemyCount
            T.serverRemaining = ServerRemaining
            T.blockRemainingIgnored = Phase == "block"
                and ServerRemaining ~= nil and ServerRemaining > 0
            T.gateWaitingForEnemies = Phase == "block" and VisibleFloorEnemies
            T.parkingCombatActive = false

            -- GARAGE START INTERLOCK (Floor 0): an empty enemy folder while
            -- the match is replicating is NOT evidence that the garage wave
            -- was cleared. The old `(Floor == 0 and Phase ~= "fight")` route
            -- climbed immediately from the initial waiting/drain state.
            -- Hold position until we've observed authoritative or visible
            -- first-wave activity AND the server actually advances to drain.
            -- No fixed timer can safely stand in for that server transition.
            if Floor == 0 then
                local WaveStartedAt = tonumber(ReadRunValue2("waveStartedAt"))
                local ParkingEnemies = FloorEnemyCount
                T.parkingEnemyCount = ParkingEnemies
                if ParkingEnemies > 0
                    or (ServerRemaining ~= nil and ServerRemaining > 0)
                    or (WaveStartedAt ~= nil and WaveStartedAt > 0)
                then
                    T.parkingWaveSeen = true
                    T.parkingWaveStartedAt = WaveStartedAt or T.parkingWaveStartedAt
                end
                local ServerPermitsClimb = Phase == "drain"
                local ParkingEnemiesCleared = ParkingEnemies == 0
                T.parkingExitAllowed = ServerPermitsClimb
                    and T.parkingWaveSeen == true and ParkingEnemiesCleared
                if not T.parkingExitAllowed then
                    T.parkingWaitReason = not T.parkingWaveSeen
                        and "Awaiting first garage wave spawn"
                        or not ParkingEnemiesCleared
                            and "Clearing first garage wave"
                            or not ServerPermitsClimb
                                and "Waiting for server drain phase"
                                or "Waiting for garage clearance"
                    if Phase ~= "fight" and ParkingEnemies == 0 then
                        T.goal = nil
                        T.combatDeckTransit = false
                        T.tweenTravelActive = false
                        T.stage = "Parking garage: " .. T.parkingWaitReason
                        if GENV.__AZ_FARM_EXT then
                            GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                        end
                        return
                    end
                    -- During fight/wave replication, the combat branch below
                    -- still handles existing enemies. It must never promote
                    -- a zero-target fight to stair or gate navigation.
                else
                    T.parkingWaitReason = "Garage wave cleared; drain authorized"
                end
            elseif Floor == 1 and Root.Position.Y < 83 then
                -- Some builds advertise Floor=1 while we're physically still
                -- on the parking deck. Never infer that Floor=1 alone means
                -- the initial enemies are gone or that the ramp is ready.
                local GarageEnemies = TidalLivingFloorEnemies(0)
                local WaveStartedAt = tonumber(ReadRunValue2("waveStartedAt"))
                T.parkingEnemyCount = GarageEnemies
                if GarageEnemies > 0
                    or (ServerRemaining ~= nil and ServerRemaining > 0)
                    or (WaveStartedAt ~= nil and WaveStartedAt > 0)
                then
                    T.parkingWaveSeen = true
                    T.parkingWaveStartedAt = WaveStartedAt or T.parkingWaveStartedAt
                end
                local MustWaitAtGarage = GarageEnemies > 0
                    or (FloorEnemyCount == 0 and
                        (Phase == "waiting" or Phase == "fight"
                            or (Phase == "drain" and not T.parkingWaveSeen)))
                if MustWaitAtGarage then
                    T.parkingCombatActive = true
                    T.parkingExitAllowed = false
                    T.combatDeckTransit = false
                    T.tweenTravelActive = false
                    if GarageEnemies > 0 then
                        -- Target actual garage enemies using parking-height
                        -- ground projection, even if FloodFloor says 1.
                        T.parkingWaitReason = "Clearing garage enemies before ramp"
                        local _, EnemyRoot = NearestEnemy2()
                        if EnemyRoot then
                            local Goal = TidalGroundGoal(
                                EnemyRoot.Position, Root, false, 0)
                            if Goal then
                                local Arrived = TidalMove(T, Root, Goal,
                                    DeltaTime, "Parking garage first wave",
                                    math.clamp(tonumber(Settings.FarmDistance) or 7, 4, 9))
                                if Arrived then RunCombat2() end
                            else
                                T.stage = "Parking: waiting for verified enemy deck"
                                T.goal = nil
                            end
                        else
                            T.stage = "Parking: waiting for garage enemy replication"
                            T.goal = nil
                        end
                    else
                        T.parkingWaitReason = "Waiting for first garage wave or server advance"
                        T.stage = "Parking garage: " .. T.parkingWaitReason
                        T.goal = nil
                        if GENV.__AZ_FARM_EXT then
                            GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                        end
                    end
                    return
                end
                T.parkingWaitReason = "Server advanced or active upper floor detected"
                T.parkingExitAllowed = true
            end

            -- Floor 10 has a lower combat/lever deck and a higher gate
            -- landing. An enabled local prompt is also a valid lever signal
            -- if the FloodLeverAt attribute has not replicated yet.
            local ActiveLeverPrompt, ActiveLeverPart = nil, nil
            local AnyLeverPrompt, AnyLeverPart = nil, nil
            if Phase == "block" then
                ActiveLeverPrompt, ActiveLeverPart = TidalLever(Floor, true)
                -- The prompt may be replicated before the server enables it.
                AnyLeverPrompt, AnyLeverPart = TidalLever(Floor, false)
            end
            local LeverRequested = Phase == "block"
                and (T.lever ~= nil or ActiveLeverPrompt ~= nil)
            local AtLanding = select(1, TidalOnFloor(Root, Floor))
            local AtCombatDeck = select(1, TidalOnFloor(Root, Floor, TidalCombatHeight(Floor)))
            local FightingHere = Fight or (Phase == "block" and HasEnemies)
            -- Floor 10's combat pad is ~39 studs BELOW the gate landing.
            -- Being supported on stairs/railings between those two levels,
            -- or already transitioning there, must not force the farm back
            -- to the upper Respawn marker before each enemy target.
            local CombatY, GateY = TidalCombatHeight(Floor), TidalHeight[Floor]
            local Floor10CombatRoute = Floor == 10 and FightingHere
                and CombatY and GateY
                and (T.combatDeckTransit == true
                    or (T.tweenTravelActive == true and T.goal
                        and math.abs(T.goal.Y - CombatY) <= 12
                        and Root.Position.Y >= CombatY - 2)
                    or (T.groundSupported == true
                        and Root.Position.Y >= CombatY - 7
                        and Root.Position.Y <= GateY + 10))
            -- When a real, enabled lever is available, it is the navigation
            -- destination. Do not constantly reroute back to Respawn while
            -- Tween/Legit descends from the gate landing to the lever deck.
            -- TidalFallRecovery separately guards true below-map falls.
            local LeverTravel = LeverRequested and AnyLeverPart ~= nil
            local MustReachFloor = Floor >= 1 and Floor <= 12
                and not AtLanding
                and not (FightingHere and AtCombatDeck)
                and not Floor10CombatRoute
                and not LeverTravel
            T.leverTravel = LeverTravel
            T.leverObjective = LeverRequested
            T.leverPromptFound = AnyLeverPrompt ~= nil
            T.leverPromptEnabled = ActiveLeverPrompt ~= nil
            T.leverPartPosition = AnyLeverPart and AnyLeverPart.Position or nil

            -- The current floor can be advancing server-side even while the
            -- player is still climbing it; keep the entrance ahead of combat.
            if MustReachFloor then
                -- Do not touch levers/gates or chase enemies until the
                -- current level's solid surface is actually underneath us.
                TidalReachRegisteredFloor(T, Root, Floor, DeltaTime)
                return
            end

            -- During any gate/block phase, combat has EXCLUSIVE movement
            -- priority while a living enemy exists on this floor.  Do not
            -- alternate between the gate point and an enemy every heartbeat.
            -- Gate occupancy (FloodGateCrowd) must not activate combat.
            if HasEnemies then
                T.gateClearSince = nil
                T.gateCombatLock = Phase == "block"
            end
            if Fight or (Phase == "block" and HasEnemies) then
                local _, EnemyRoot = NearestEnemy2()
                if EnemyRoot then
                    -- Validate a real deck position near THIS enemy, rather
                    -- than targeting its raw CFrame beneath/inside a floor.
                    local Desired = DesiredEnemyCFrame2(EnemyRoot)
                    local CombatGoal = Desired and TidalGroundGoal(
                        Desired.Position, Root, false, Floor) or nil
                    -- Narrow combat decks may not support the "Behind"
                    -- offset even though the enemy stands on solid ground.
                    -- Try the actual enemy pad before abandoning the target.
                    if not CombatGoal then
                        CombatGoal = TidalGroundGoal(
                            EnemyRoot.Position, Root, false, Floor)
                    end
                    if not CombatGoal then
                        T.tweenTravelActive = false
                        T.combatDeckTransit = false
                        if GENV.__AZ_FARM_EXT then
                            GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                        end
                        T.stage = "Waiting for verified enemy-deck surface"
                        T.goal = nil
                        return
                    end
                    local CombatDeckY = TidalCombatHeight(Floor)
                    local UpperDeckY = TidalHeight[Floor]
                    local IsLowerDeck = Floor == 10
                        and CombatDeckY and UpperDeckY
                        and UpperDeckY - CombatDeckY > 12
                        and math.abs(CombatGoal.Position.Y - CombatDeckY) <= 10
                    local NeedsDeckTransition = IsLowerDeck
                        and math.abs(Root.Position.Y - CombatGoal.Position.Y) > 10
                    -- Keep transition ownership until the verified lower
                    -- deck is reached, even during the last few studs.
                    local DeckTransitionActive = IsLowerDeck and
                        (NeedsDeckTransition or
                            (T.combatDeckTransit == true and not AtCombatDeck))
                    T.combatDeckTransit = DeckTransitionActive
                    T.combatTargetHeight = CombatGoal.Position.Y
                    T.stage = Phase == "block"
                        and ("Clear floor " .. Floor .. " enemies BEFORE gate ("
                            .. FloorEnemyCount .. " visible)")
                        or ("Fighting floor " .. tostring(Floor))

                    -- TidalMove coordinates Teleport, Tween and Legit.
                    -- In particular, Tween enables temporary noclip BEFORE
                    -- crossing upper-deck collision and keeps it enabled
                    -- until the verified lower-deck landing is reached.
                    -- The old MoveFarm2 forcibly restored collision each
                    -- heartbeat, cancelling the very transition we need.
                    if DeckTransitionActive or Settings.FarmMethod == "Tween" then
                        local Arrived = TidalMove(T, Root, CombatGoal,
                            DeltaTime,
                            DeckTransitionActive and "Descend to floor 10 enemies"
                                or "Approach floor enemy",
                            math.clamp(tonumber(Settings.FarmDistance) or 7, 4, 9))
                        if not Arrived then return end
                        T.combatDeckTransit = false
                        RunCombat2()
                        return
                    end
                    T.tweenTravelActive = false
                    if GENV.__AZ_FARM_EXT then
                        GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                    end
                    T.goal = CombatGoal.Position
                    MoveFarm2(DeltaTime)
                    RunCombat2()
                    return
                end
                T.tweenTravelActive = false
                T.combatDeckTransit = false
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
                if Phase == "block" and HasEnemies then
                    T.stage = "Gate paused: " .. tostring(ServerRemaining or "unknown")
                        .. " reported left; " .. tostring(FloorEnemyCount)
                        .. " visible, searching current floor"
                    T.goal = nil
                    RunCombat2()
                    return
                end
                if Fight and Floor < 12 and HasEnemies then
                    T.stage = "Waiting for floor enemies"
                    RunCombat2()
                    return
                end
                if Fight and Floor == 0 and not HasEnemies then
                    T.goal = nil
                    T.stage = "Parking garage: waiting for first-wave enemies / server phase"
                    return
                end
            end

            if not HasEnemies then
                T.combatDeckTransit = false
                T.tweenTravelActive = false
                if GENV.__AZ_FARM_EXT then
                    GENV.__AZ_FARM_EXT.SetTweenNoclipEnabled(false, true)
                end
            end
            if Phase == "block" then
                if HasEnemies then
                    T.gateClearSince = nil
                    T.stage = "Gate suppressed: enemies remaining"
                    return
                end
                -- Brief empty-floor confirmation prevents flicker between mobs
                -- and the gate when enemy models are temporarily unavailable.
                T.gateClearSince = T.gateClearSince or os.clock()
                if os.clock() - T.gateClearSince < 1.25 then
                    T.stage = "Confirming gate enemies cleared"
                    T.goal = nil
                    RunCombat2()
                    return
                end
                T.gateCombatLock = false
                -- During the server's block phase, prefer the requested
                -- or enabled floor lever. In particular the Floor 10 lever
                -- is physically DOWN on the enemy deck, not at gate height.
                if LeverRequested then
                    local Prompt = ActiveLeverPrompt or AnyLeverPrompt
                    local LeverPart = ActiveLeverPart or AnyLeverPart
                    if Prompt and LeverPart then
                        local CombatY, GateY = TidalCombatHeight(Floor), TidalHeight[Floor]
                        local LeverY = math.abs(LeverPart.Position.Y - CombatY)
                            < math.abs(LeverPart.Position.Y - GateY)
                            and CombatY or GateY
                        T.leverDeckHeight = LeverY
                        local Goal = TidalGroundGoal(LeverPart.Position, Root, true, Floor)
                        if TidalMove(T, Root, Goal, DeltaTime,
                                "Floor " .. Floor .. " lever / deck "
                                .. math.floor(LeverY), 3)
                            and select(1, TidalOnFloor(Root, Floor, LeverY))
                        then
                            if Prompt.Enabled then
                                TidalTryLever(T, Root, Prompt, LeverPart)
                            else
                                T.stage = "At Floor " .. Floor
                                    .. " lever; waiting for prompt activation"
                            end
                        end
                    else
                        T.goal = nil
                        T.stage = "Waiting for floor " .. Floor
                            .. " lever object (not using gate as fallback)"
                    end
                    return
                end
                -- The live FloodGateZone is the actual gate occupancy area.
                -- Find a WALKABLE surface nearest its center. If a runtime
                -- gate zone is still loading or its origin cannot be grounded,
                -- try the floor barrier/lever targets instead of freezing at
                -- "No verified ground" indefinitely.
                local World = workspace:FindFirstChild("World")
                local Objects = World and World:FindFirstChild("MapObjects")
                local Zone = Objects and Objects:FindFirstChild("FloodGateZone")
                local FloorY = TidalHeight[Floor]
                local CandidatePoints = {}
                if Zone and Zone:IsA("BasePart") and FloorY
                    and math.abs(Zone.Position.Y - FloorY) <= 15 then
                    table.insert(CandidatePoints, {
                        part = Zone, source = "Live gate occupancy zone"})
                end
                local Group = Markers:FindFirstChild("Floor" .. tostring(Floor))
                local Barrier = Group and Group:FindFirstChild("Barrier")
                if Barrier and Barrier:IsA("BasePart") then
