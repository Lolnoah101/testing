local function refreshMobs(force)
    local detectedWorld = getWorld()
    local worldChanged = detectedWorld ~= state.CurrentWorld
    if not force and not worldChanged then return end
    -- A world transfer invalidates the old map's return coordinates.
    if worldChanged and state.WasBelowFarming then
        clearReturnPosition()
        removeBelowPlatform()
    end

    -- Reload in the same world preserves valid selections. Changing worlds
    -- clears previous selections so we never attack an unselected new type.
    local previousLabels = worldChanged and {} or selectedLabels(mobDropdown)
    state.CurrentWorld = detectedWorld
    local options, mapping = buildMobOptions(detectedWorld)
    state.MobByLabel = mapping

    local keepLabels = {}
    for _, label in ipairs(previousLabels) do
        if mapping[label] then table.insert(keepLabels, label) end
    end
    local ids = selectedIdsFromLabels(keepLabels)
    local changed = not sameMobIds(state.SelectedMobs, ids)

    dropdownBusy = true
    mobDropdown:Refresh(options)
    mobDropdown:Set(keepLabels, true)
    dropdownBusy = false

    state.SelectedMobs = ids
    if changed or worldChanged then
        if worldChanged or (not hasActiveQuestTarget() and not activeModeFarm()) then
            changeTarget()
            if worldChanged then removeBelowPlatform() end
            if state.AutoFarm and not (nativeController and nativeController.Auto_Attack) then
                bridge:FireServer("Shadows", "Attack", "Retreat_All")
            end
        end
    end
    print(string.format("[Paraiso Farm] Mob list: %s (%d options, %d selected)",
        detectedWorld or "waiting for map", #options, #keepLabels))
end

