    local Recipes = {}

    local function ParseMaterials(Text)
        local Materials = {}

        if type(Text) ~= "string" then
            return Materials
        end

        for Entry in string.gmatch(Text, "[^|]+") do
            local Id, Amount =
                string.match(
                    Entry,
                    "^%s*([^,]+)%s*,%s*(%d+)%s*$"
                )

            Amount = tonumber(Amount)

            if Id and Amount then
                Materials[tostring(Id)] = Amount
            end
        end

        return Materials
    end

    if type(CraftConfig) == "table" then
        for CraftId, Definition in pairs(CraftConfig) do
            local Name =
                CraftNames[tostring(CraftId)]

            if Name and type(Definition) == "table" then
                Recipes[Name] = {
                    CraftId = tostring(CraftId),
                    AccessoryId = tostring(
                        Definition.CarftID
                        or Definition.CraftID
                        or ""
                    ),
                    Materials = ParseMaterials(
                        Definition.Misc
                    ),
                }
            end
        end
    end

    local function GetAccountData()
        if not AccountNamespace
            or type(AccountNamespace.getLocalPlayerAccount)
                ~= "function"
        then
            return nil
        end

        local Success, Account = pcall(function()
            return AccountNamespace.getLocalPlayerAccount()
        end)

        if not Success or not Account then
            return nil
        end

        local DataSuccess, Data = pcall(function()
            return Account:toTable()
        end)

        if DataSuccess then
            return Data
        end

        return nil
    end

    local function MaterialCount(Data, Id)
        return tonumber(
            Data
            and Data.material
            and Data.material[tostring(Id)]
        ) or 0
    end

    local function AccessoryCount(Data, Id)
        return tonumber(
            Data
            and Data.accessory
            and Data.accessory[tostring(Id)]
        ) or 0
    end

    local function SelectedCount()
        local Count = 0

        for _, Selected in pairs(
            Automation.SelectedAccessories or {}
        ) do
            if Selected == true then
                Count = Count + 1
            end
        end

        return Count
    end

    -- Returns aggregate materials needed to make the next desired copy of
    -- every selected incomplete accessory, plus whether any recipe can be
    -- crafted immediately with the current inventory.
    local function Analyze(Data)
        local Needs = {}
        local Pending = 0
        local CraftableName = nil
        local Complete = true

        for CraftId = 1, 14 do
            local Name =
                CraftNames[tostring(CraftId)]

            if Name
                and type(Automation.SelectedAccessories) == "table"
                and Automation.SelectedAccessories[Name] == true
            then
                local Recipe = Recipes[Name]

                if Recipe then
                    local Owned =
                        AccessoryCount(
                            Data,
                            Recipe.AccessoryId
                        )

                    local Done =
                        Automation.CraftOneEach == true
                        and Owned >= 1

                    if not Done then
                        Complete = false
                        Pending = Pending + 1

                        local RecipeReady = true

                        for MaterialId, Required in pairs(
                            Recipe.Materials
                        ) do
                            local Have =
                                MaterialCount(
                                    Data,
                                    MaterialId
                                )

                            if Have < Required then
                                RecipeReady = false
                            end

                            Needs[MaterialId] =
                                (Needs[MaterialId] or 0)
                                + Required
                        end

                        if RecipeReady
                            and not CraftableName
                        then
                            CraftableName = Name
                        end
                    end
                end
            end
        end

        -- Convert aggregate requirements into shortages against inventory.
        for MaterialId, Required in pairs(Needs) do
            Needs[MaterialId] =
                math.max(
                    Required
                        - MaterialCount(Data, MaterialId),
                    0
                )
        end

        if Automation.CraftOneEach ~= true then
            -- Continuous mode never has a terminal completion state.
            Complete = false
        end

        GENV.__AZ_ACCESSORY_AUTOMATION_NEEDS = Needs

        return {
            Needs = Needs,
            Pending = Pending,
            CraftableName = CraftableName,
            Complete = Complete,
        }
    end

    local function GetDropTable(
        Name,
        ActNumber,
        Difficulty
    )
        if not MaterialDropConfig
            or type(MaterialDropConfig.GetTable)
                ~= "function"
        then
            return nil
        end

        local Success, Drops = pcall(function()
            return MaterialDropConfig.GetTable(
                Name,
                ActNumber or 1,
                Difficulty or "Nightmare"
            )
        end)

        if Success and type(Drops) == "table" then
            return Drops
        end

        return nil
    end

    local function ChooseRoute(Needs)
        local Candidates = {}

        local function AddCandidate(Candidate)
            local Score = 0
            local Covered = 0
            local ChanceById = {}

            for _, Drop in ipairs(Candidate.Drops or {}) do
                local Id = tostring(Drop.Item or "")
                local Missing = tonumber(Needs[Id]) or 0
                local Chance = tonumber(Drop.Chance) or 0

                if Missing > 0 and Chance > 0 then
                    local Multiplier = 1

                    if Candidate.Mode == "Infinite"
                        and MaterialDropConfig
                        and type(MaterialDropConfig.GetDepth) == "function"
                    then
                        local Success, Depth = pcall(
                            MaterialDropConfig.GetDepth,
                            Candidate.LeaveWave or 10
                        )

                        if Success then
                            Multiplier = tonumber(Depth) or 1
                        end
                    end

                    Chance = math.min(Chance * Multiplier, 1)
                    ChanceById[Id] = math.max(ChanceById[Id] or 0, Chance)
                    Score = Score + Missing * Chance
                    Covered = Covered + 1
                end
            end

            if Covered <= 0 then
                return
            end

            Candidate.ChanceById = ChanceById
            Candidate.Score = Score / math.max(Candidate.Cost or 1, 0.25)

            local BottleneckId = nil
            local BottleneckCost = -1

            for Id, Chance in pairs(ChanceById) do
                local Missing = tonumber(Needs[Id]) or 0
                local Expected = Missing / math.max(Chance, 0.0001)

                if Expected > BottleneckCost then
                    BottleneckCost = Expected
                    BottleneckId = Id
                end
            end

            Candidate.MaterialId = BottleneckId
            table.insert(Candidates, Candidate)
        end

        for Act = 1, 3 do
            AddCandidate({
                Mode = "Story",
                Map = "Hxh",
                Act = "Act " .. tostring(Act),
                Difficulty = "Nightmare",
                Cost = 1,
                Drops = GetDropTable(
                    "hxh",
                    Act,
                    "Nightmare"
                ),
            })
        end

        local InfiniteDrops =
            GetDropTable(
                "infinite",
                1,
                "Nightmare"
            ) or {}

        local InfiniteBossDrops =
            GetDropTable(
                "infiniteBoss",
                1,
                "Nightmare"
            ) or {}

        local InfiniteRelevant = {}
        local HighestUnlock = 0
        local NeedsBoss = false

        for _, Source in ipairs({
            InfiniteDrops,
            InfiniteBossDrops,
        }) do
            for _, Drop in ipairs(Source) do
                local Id = tostring(Drop.Item or "")

                if (tonumber(Needs[Id]) or 0) > 0 then
                    table.insert(InfiniteRelevant, Drop)
                    HighestUnlock = math.max(
                        HighestUnlock,
                        tonumber(Drop.Unlock) or 1
                    )

                    if Source == InfiniteBossDrops
                        and (Id == "109" or Id == "111")
                    then
                        NeedsBoss = true
                    end
                end
            end
        end

        if #InfiniteRelevant > 0 then
            local LeaveWave =
                math.max(10, math.ceil(HighestUnlock / 5) * 5)

            if NeedsBoss and LeaveWave < 50 then
                LeaveWave = 50
            end

            AddCandidate({
                Mode = "Infinite",
                EndlessMap = "ZZZ World",
                Difficulty = "Nightmare",
                LeaveWave = LeaveWave,
                Cost = math.max(LeaveWave / 10, 1),
                Drops = InfiniteRelevant,
            })
        end

        local Best = nil

        for _, Candidate in ipairs(Candidates) do
            if not Best
                or Candidate.Score > Best.Score
            then
                Best = Candidate
            end
        end

        return Best
    end

