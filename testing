-- Collect the reasons an eligible action is not currently being sent.
-- This is a snapshot of our known spirits, not a server-side eligibility oracle.
local function diagnosticSnapshot()
    local d = {
        tracked = 0, nearby = 0, outOfRange = 0, noPosition = 0,
        expired = 0, withAttempts = 0, exhausted = 0,
        protected = 0, inFlight = 0, cooldownWaiting = 0,
        releaseMaxed = 0, blocked = 0,
    }
    local root = getRoot()
    local now, serverNow = os.clock(), Workspace:GetServerTimeNow()
    local position = root and root.Position
    for _, s in pairs(spirits) do
        d.tracked += 1
        if s.expiresAt and serverNow >= s.expiresAt then
            d.expired += 1
        else
            local pos = findPosition(s)
            if not pos then
                d.noPosition += 1
            elseif not position or (pos - position).Magnitude > RANGE then
                d.outOfRange += 1
            else
                d.nearby += 1
                if (tonumber(s.attempts) or 0) > 0 then
                    d.withAttempts += 1
                else
                    d.exhausted += 1
                end
                if s.noRelease then d.protected += 1 end
                if s.blocked then d.blocked += 1 end
                if now < s.tamePendingUntil then d.inFlight += 1 end
                if now < s.nextAction then d.cooldownWaiting += 1 end
                if s.releaseTries >= RELEASE_MAX_TRIES then
                    d.releaseMaxed += 1
                end
            end
        end
    end
    return d
end

