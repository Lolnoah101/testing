-- v73: Native recipe-item learning, independent of blacksmith crafting and movement.
-- Derived from the client's RecipeBook / item Recipe handler. The server accepts
-- CraftingService:claim_recipe_item(inventoryUUID) and replicates UnlockedRecipes.
function Hub:V73RecipeSnapshot()
    local P=self.Progression
    if not P or not P.playerData or not P.itemList or not P.itemInfo then return nil,"Inventory reader unavailable" end
    local data,slot=P.playerData()
    local inventory=data and data:FindFirstChild("Inventory")
    if not inventory then return nil,"Waiting for selected-slot inventory" end
    local items=P.itemList()
    if type(items)~="table" then return nil,"Waiting for item definitions" end
    local shared=ReplicatedStorage:FindFirstChild("Shared")
    local definitions=shared and shared:FindFirstChild("Data")
    local craftingModule=definitions and definitions:FindFirstChild("CraftingData")
    local ok,recipes=pcall(function() return craftingModule and require(craftingModule) end)
    if not ok or type(recipes)~="table" then return nil,"Waiting for recipe definitions" end
    local function normalize(value)
        if type(value)~="string" then return nil end
        return value:gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$",""):lower()
    end
    local aliases={}
    for name in pairs(recipes) do
        if type(name)=="string" then
            aliases[normalize(name)]=name
            aliases[normalize(name.." Recipe")]=name
        end
    end
    for _,info in pairs(items) do
        if type(info)=="table" and type(info.RecipeName)=="string"
            and type(recipes[info.RecipeName])=="table" then
            aliases[normalize(info.RecipeName)]=info.RecipeName
            if type(info.ItemName)=="string" then aliases[normalize(info.ItemName)]=info.RecipeName end
        end
    end

    -- Same source priority as the native CraftingController: replicated save slot,
    -- then DataController.get when the save's folder hasn't streamed yet.
    local unlockedFolder=data and data:FindFirstChild("UnlockedRecipes")
    local raw=nil
    if unlockedFolder then
        raw=unlockedFolder:GetAttributes()
        for _,node in ipairs(unlockedFolder:GetChildren()) do
            if node:IsA("ValueBase") then
                raw[node.Name]=node.Value
            else
                local value=node:GetAttribute("Value")
                raw[node.Name]=value==nil and true or value
            end
        end
    else
        local ctrlOk,controller=pcall(function() return Knit.GetController("DataController") end)
        if ctrlOk and controller and type(controller.get)=="function" then
            local readOk,readValue=pcall(function()
                return controller.get(slot,"PlayerData","UnlockedRecipes")
            end)
            if readOk and type(readValue)=="table" then raw=readValue end
        end
    end
    if type(raw)~="table" then return nil,"Waiting for unlocked-recipe data" end
    local known={}
    for key,value in pairs(raw) do
        if value~=nil and value~=false then
            local name=aliases[normalize(tostring(key))]
            if name then known[name]=true end
        end
    end
    local totalKnown=0
    for _ in pairs(known) do totalKnown+=1 end
    local candidates,alreadyOwned={},0
    for _,entry in ipairs(inventory:GetChildren()) do
        local info=P.itemInfo(entry:GetAttribute("item_id"),items)
        if type(info)=="table" and (info.Type=="Recipe" or type(info.RecipeName)=="string") then
            local quantity=entry:GetAttribute("quantity")
            if quantity==nil or (tonumber(quantity) or 0)>0 then
                local name=type(info.RecipeName)=="string" and aliases[normalize(info.RecipeName)] or nil
                if not name and type(info.ItemName)=="string" then
                    name=aliases[normalize(info.ItemName)]
                end
                if name then
                    if known[name] then alreadyOwned+=1
                    else table.insert(candidates,{Name=name,UUID=tostring(entry.Name)}) end
                end
            end
        end
    end
    table.sort(candidates,function(a,b) return a.Name==b.Name and a.UUID<b.UUID or a.Name<b.Name end)
    return {Candidates=candidates,Known=known,KnownCount=totalKnown,OwnedKnown=alreadyOwned,Slot=slot},nil
end

function Hub:V73LearnRecipesTick(now)
    local E=self.V44
    if not E or not E.AutoLearnOwnedRecipes or now<(E.RecipeLearnNext or 0) then return end
    E.RecipeLearnNext=now+0.28
    if E.RecipeLearnBusy or self.Runtime.Jobs["v73_learn_recipe"] then return end
    if self.V70NenPriority or self.V69Trip or self:InventoryBusy() or self.ChestSession
        or self.InventoryChestBusy or E.V69CraftBusy or E.V69SellBusy then
        E.RecipeLearnStatus="Waiting for current inventory / priority activity"
        return
    end
    local snapshot,reason=self:V73RecipeSnapshot()
    if not snapshot then E.RecipeLearnStatus=tostring(reason or "Waiting for inventory");return end
    E.RecipeKnown=snapshot.KnownCount
    E.RecipeOwnedPending=#snapshot.Candidates
    if #snapshot.Candidates==0 then
        E.RecipeLearnStatus=string.format("Watching for new recipes | learned: %d | already known: %d",
            E.RecipeLearnedCount or 0,snapshot.KnownCount)
        return
    end
    E.RecipeRetryAt=E.RecipeRetryAt or {}
    local candidate=nil
    local earliest=math.huge
    for _,entry in ipairs(snapshot.Candidates) do
        local untilAt=E.RecipeRetryAt[entry.UUID] or 0
        if now>=untilAt then candidate=entry;break end
        earliest=math.min(earliest,untilAt-now)
    end
    if not candidate then
        E.RecipeLearnStatus="Waiting for server confirmation / retry ("..string.format("%.1fs",earliest)..")"
        return
    end
    local service=self:V44Service("CraftingService")
    if not service or type(service.claim_recipe_item)~="function" then
        E.RecipeLearnStatus="Waiting for CraftingService recipe learning"
        return
    end
    E.RecipeLearnBusy=true
    E.RecipeLastName=candidate.Name
    E.RecipeLearnStatus="Learning "..candidate.Name.." | "..#snapshot.Candidates.." unlearned owned"
    local started=self:StartJob("v73_learn_recipe",nil,function(alive)
        local function valid()
            if not alive() or not E.AutoLearnOwnedRecipes then return false end
            local _,slot=self.Progression.playerData()
            return slot==snapshot.Slot
        end
        if not valid() then E.RecipeLearnBusy=false;return end
        -- Recheck before every server call: a manual unlock or other automation
        -- may have updated the recipe book since the candidate was scanned.
        local fresh=self:V73RecipeSnapshot()
        if not fresh or fresh.Known[candidate.Name] then
            E.RecipeLearnStatus="Skipped already learned: "..candidate.Name
            E.RecipeLearnBusy=false
            return
        end
        local stillOwned=false
        for _,item in ipairs(fresh.Candidates) do
            if item.UUID==candidate.UUID and item.Name==candidate.Name then stillOwned=true;break end
        end
        if not stillOwned then E.RecipeLearnBusy=false;return end
        local sent,reply=pcall(function() return service:claim_recipe_item(candidate.UUID) end)
        local accepted,value=false,nil
        if sent then accepted,value=self:AwaitReply(reply,valid,5) end
        if not valid() then E.RecipeLearnBusy=false;return end
        local confirmed=self:WaitConfirmed(function()
            local latest=self:V73RecipeSnapshot()
            return latest and latest.Known[candidate.Name]==true
        end,valid,2.5)
        if not valid() then E.RecipeLearnBusy=false;return end
        if confirmed then
            E.RecipeLearnedCount=(E.RecipeLearnedCount or 0)+1
            E.RecipeLearnStatus="Learned "..candidate.Name.." | total this session: "..E.RecipeLearnedCount
            E.RecipeRetryAt[candidate.UUID]=nil
            E.RecipeLearnNext=0
        else
            -- Never report an unlock solely because a remote returned success.
            -- If the UUID was consumed, the next scan will naturally skip it.
            E.RecipeRetryAt[candidate.UUID]=os.clock()+(accepted and value~=false and 25 or 12)
            E.RecipeLearnStatus="Unconfirmed: "..candidate.Name.." | rechecking before retry"
            E.RecipeLearnNext=0
        end
        E.RecipeLearnBusy=false
    end,function(ok,err)
        E.RecipeLearnBusy=false
        if not ok then
            E.RecipeLearnStatus="Recipe job failed: "..tostring(err):sub(1,100)
            E.RecipeRetryAt[candidate.UUID]=os.clock()+10
        end
    end)
    if not started then E.RecipeLearnBusy=false end
end

