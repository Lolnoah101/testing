-- Only suppress animations known to belong to the equipped skill, and
-- only for the window after our own Auto Ability request. The server may
-- play them on acceptance even when the client did not call ActivateSkill().
local function refreshSkillAnimationIds(character)
    skillAnimationIds = {}
    if not character then return nil end
    local ok, skill = pcall(function()
        return WeaponSkillConfig.get(character:GetAttribute("EquippedWeapon"))
    end)
    if not ok or type(skill) ~= "table" then return nil end
    local animationsR15 = Animations.R15 or {}
    for _, clips in ipairs({skill.Clip or {}, skill.Fallback or {}}) do
        for _, clip in ipairs(clips) do
            local asset = animationsR15[clip.Name]
            local id = tonumber(tostring(asset or ""):match("(%d+)"))
            if id then skillAnimationIds[id] = true end
        end
    end
    return skill
end

local function shouldHideAttackAnimation(track)
    if not track then return false end
    if not enabled.KillAura and not enabled.AutoAbility then return false end
    local animation = track.Animation
    if not animation then return false end
    local id = tonumber(tostring(animation.AnimationId):match("(%d+)"))
    if not id then return false end
    if enabled.KillAura and attackAnimationIds[id] then return true end
    return enabled.AutoAbility and os.clock() < abilityHideUntil
        and skillAnimationIds[id] == true
end

local function stopAttackTracks(animator)
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        if shouldHideAttackAnimation(track) then
            pcall(function() track:Stop(0) end)
        end
    end
end

local function bindCharacterAnimations(character)
    if animatorConnection then
        animatorConnection:Disconnect()
        animatorConnection = nil
    end
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 12)
        if not humanoid or LocalPlayer.Character ~= character or not alive then return end
        local animator = humanoid:FindFirstChildOfClass("Animator")
            or humanoid:WaitForChild("Animator", 12)
        if not animator or LocalPlayer.Character ~= character or not alive then return end
        animatorConnection = animator.AnimationPlayed:Connect(function(track)
            if shouldHideAttackAnimation(track) then
                pcall(function() track:Stop(0) end)
            end
        end)
        stopAttackTracks(animator)
    end)
end

