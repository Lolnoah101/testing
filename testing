--// RUBBLE Y
--//============================================================

local function GetRubbleY(Rubble)

    if not Rubble
        or not Rubble.Parent
    then

        return nil
    end


    if Rubble:IsA(
        "BasePart"
    )
    then

        return Rubble.Position.Y
    end


    if Rubble:IsA(
        "Model"
    )
    then

        return Rubble
            :GetPivot()
            .Position
            .Y
    end


    local Part =
        Rubble
            :FindFirstChildWhichIsA(
                "BasePart",
                true
            )


    if Part then
        return Part.Position.Y
    end


    return nil
end


local function RecordRubbleHeight(Info)

    if not Info
        or not Info.Rubble
    then

        return
    end


    if RubbleInitialY[
        Info.Area
    ] == nil
    then

        local Y =
            GetRubbleY(
                Info.Rubble
            )


        if Y then

            RubbleInitialY[
                Info.Area
            ] = Y
        end
    end
end


--//============================================================
--// RUBBLE OPEN
--//============================================================

local function IsRubblePhysicallyOpen(
    PreviousArea
)

    local Info =
        GetRubbleForArea(
            PreviousArea
        )


    local StartTime =
        RubbleBreakTime[
            PreviousArea
        ]


    if not StartTime then

        RubbleBreakTime[
            PreviousArea
        ] = os.clock()


        StartTime =
            RubbleBreakTime[
                PreviousArea
            ]
    end


    local Elapsed =
        os.clock()
        - StartTime


    if Elapsed < RUBBLE_MIN_WAIT then
        return false
    end


    if not Info then
        return true
    end


    if Info.Blocker
        and Info.Blocker:IsA(
            "BasePart"
        )
        and Info.Blocker.CanCollide
            == false
    then

        return true
    end


    if not Info.Rubble
        or not Info.Rubble.Parent
    then

        return true
    end


    local InitialY =
        RubbleInitialY[
            PreviousArea
        ]


    local CurrentY =
        GetRubbleY(
            Info.Rubble
        )


    if InitialY
        and CurrentY
    then

        if (
            InitialY
            - CurrentY
        ) >= RUBBLE_DROP_DISTANCE
        then

            return true
        end
    end


    if Elapsed >= RUBBLE_MAX_WAIT then
        return true
    end


    return false
end


--//============================================================
--// RUBBLE FARM POSITION
--//============================================================

local function GetRubbleFarmCFrame(Info)

    if not Info then
        return nil
    end


    local Root =
        GetRoot()


    if not Root then
        return nil
    end


    local TargetPosition = nil


    if Info.RubbleBar
        and Info.RubbleBar:IsA(
            "Attachment"
        )
    then

        local Position =
            Info.RubbleBar.WorldPosition


        TargetPosition =
            Vector3.new(
                Position.X,
                Root.Position.Y,
                Position.Z
            )
    end


    if not TargetPosition
        and Info.Blocker
    then

        local Look =
            Info.Blocker.CFrame.LookVector


        local Flat =
            Vector3.new(
                Look.X,
                0,
                Look.Z
            )


        if Flat.Magnitude < 0.01 then

            Flat =
                Vector3.new(
                    0,
                    0,
                    1
                )

        else

            Flat =
                Flat.Unit
        end


        TargetPosition =
            Info.Blocker.Position
            + Flat * 8


        TargetPosition =
            Vector3.new(
                TargetPosition.X,
                Root.Position.Y,
                TargetPosition.Z
            )
    end


    if not TargetPosition then
        return nil
    end


    local LookAt =
        Info.Blocker
        and Info.Blocker.Position
        or TargetPosition
            + Vector3.new(
                0,
                0,
                -1
            )


    LookAt =
        Vector3.new(
            LookAt.X,
            Root.Position.Y,
            LookAt.Z
        )


    return CFrame.lookAt(
        TargetPosition,
        LookAt,
        Vector3.yAxis
    )
end


