local function getSkillModule()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local folder = gui and gui:FindFirstChild("Modules")
    local instance = folder and folder:FindFirstChild("ClientSkillModule")
    if not instance then skillInstance, skillModule = nil, nil; return nil end
    if instance ~= skillInstance then skillInstance, skillModule = instance, nil end
    if skillModule then return skillModule end
    if os.clock() - lastModuleCheck < 1 then return nil end
    lastModuleCheck = os.clock()
    local ok, data = pcall(require, instance)
    if ok and type(data) == "table" then skillModule = data end
    return skillModule
end

