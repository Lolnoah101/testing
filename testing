local AUTOEXEC_MAIN_FILE = "TameAnAnimal_AutoExecute_Source.lua"
local AUTOEXEC_QUEUE_FILE = "TameAnAnimal_AutoExecute_Loader.lua"
local AUTOEXEC_ENABLED_FILE = "TameAnAnimal_AutoExecute.enabled"
local AUTOEXEC_OLD_ENABLED_FILE = "TameAnAnimal_V44.enabled"
local autoExecuteEnabled = false
