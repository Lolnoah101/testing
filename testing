        end

        if Object.Name == "Crude Oil"
            or Object.Name == "Refined Oil"
        then
            return Object.Name
        end

        if Object:IsA("StringValue") then
            local Success, Value =
                pcall(function()
                    return Object.Value
                end)

            if Success
                and (
                    Value == "Crude Oil"
                    or Value == "Refined Oil"
                )
            then
                return Value
            end
        end

        return nil
    end

    local function CountOilItems(
        ItemName
    )
        local Count = 0
        local Seen = {}

        local function Scan(
            Root
        )
            if not Root then
                return
            end

            local function Check(
                Object
            )
                if Seen[Object] then
                    return
                end

                Seen[Object] = true

                if ReadOilItemName(Object)
                    == ItemName
                then
                    Count = Count + 1
                end
            end

            Check(Root)

            for _, Object in ipairs(
                Root:GetDescendants()
            ) do
                Check(Object)
            end
        end

        Scan(
            Player:FindFirstChildOfClass(
                "Backpack"
            )
        )

        Scan(
            Player.Character
        )

        Scan(
            Player:FindFirstChild(
                "Data"
            )
        )

        return Count
    end

    local function EquipOilItem(
        ItemName
    )
        local Character =
            GetCharacter()

        local Existing =
            Character
            and Character:FindFirstChild(
                ItemName
            )

        if Existing
            and Existing:IsA("Tool")
        then
            return true
        end

        local Backpack =
            Player:FindFirstChildOfClass(
                "Backpack"
            )

        if not Backpack then
            return false
        end

        local Tool =
            Backpack:FindFirstChild(
                ItemName
            )

        if not Tool
            or not Tool:IsA("Tool")
        then
            return false
        end

        local Humanoid =
            GetHumanoid()

        if not Humanoid then
            return false
        end

        pcall(function()
            Humanoid:EquipTool(
                Tool
            )
        end)

        task.wait(0.1)

        return Tool.Parent
            == GetCharacter()
    end

