--==============================================================
-- LEGIT ENGINE
--==============================================================

local SKILL_KEYS = {
    Enum.KeyCode.Z,
    Enum.KeyCode.X,
    Enum.KeyCode.C,
    Enum.KeyCode.V,
}

local function handleLegitIdling(now)
    if now - State.LastCastStarted < Config.RecastDelay then
        return
    end

    if not ensureLookingAtWater() then
        return
    end

    mouseDown()
    State.LastCastStarted = now
end

local function handleLegitHolding()
    mouseDown()
end

local function handleLegitThrowing(now)
    mouseDown()

    local stateAge = now - State.StateEnteredAt
    local luck = 0

    if FishingController then
        pcall(function()
            luck = tonumber(FishingController:GetLuckBarValue()) or 0
        end)
    end

    local shouldRelease
    if not Config.PerfectCast then
        shouldRelease = stateAge >= 0.35
    else
        shouldRelease = luck >= Config.CastThreshold or stateAge >= Config.CastFallbackSeconds
    end

    if shouldRelease then
        mouseUp()
    end
end

local function handleLegitFirstPull(now)
    mouseUp()

    if now - State.LastPrimaryClick < 0.12 then
        return
    end

    local stateAge = now - State.StateEnteredAt
    local pull = 0

    if FishingController then
        pcall(function()
            pull = tonumber(FishingController:GetPullBarValue()) or 0
        end)
    end

    local shouldPull
    if not Config.PerfectFirstPull then
        shouldPull = stateAge >= 0.45
    else
        shouldPull = pull >= Config.FirstPullThreshold
            or stateAge >= Config.FirstPullFallbackSeconds
    end

    if shouldPull then
        primaryClick()
    end
end

local function handleLegitReeling(now)
    mouseUp()

    local qteActive = now < State.QTEActiveUntil

    local holdForQuestFinisher = questFinisherHoldActive()

    if not qteActive
        and not holdForQuestFinisher
        and now >= State.NextReelAt then

        primaryClick()
        State.NextReelAt = now + (1 / math.clamp(Config.ReelCPS, 0.5, 5.8))
    end

    if Config.AutoSkills
        and not qteActive
        and now >= State.NextSkillAt then

        if State.QuestForcedSkillSlot then
            local slotName, skillId =
                getSkillForSlot(State.QuestForcedSkillSlot)

            if skillId == State.QuestForcedSkillId
                and not isSkillOnCooldown(slotName) then

                keyTap(SKILL_KEYS[State.QuestForcedSkillSlot], 0.025)
            end
        elseif Config.SkillRotationMode == "Strongest Ready" then
            local bestIndex = getBestReadySkillSlot()

            if bestIndex then
                keyTap(SKILL_KEYS[bestIndex], 0.025)
            end
        else
            keyTap(SKILL_KEYS[State.SkillIndex], 0.025)
            State.SkillIndex = State.SkillIndex % #SKILL_KEYS + 1
        end

        State.NextSkillAt = now + math.max(0.35, Config.SkillInterval)
    end
end

local function handleLegitCaught(now)
    mouseUp()

    if not Config.AutoConfirmLoot or now < State.NextLootClickAt then
        return
    end

    primaryClick()
    State.NextLootClickAt = now + Config.LootRetryDelay
end

local function stepLegit()
    if not FishingController then
        return
    end

    local now = os.clock()

    if now < State.LegitResumeAt then
        mouseUp()
        return
    end
    local fishingState = getFishingState()
    updateFishingState(fishingState)

    if fishingState == FState.Idling then
        handleLegitIdling(now)
    elseif fishingState == FState.Holding then
        handleLegitHolding()
    elseif fishingState == FState.Throwing then
        handleLegitThrowing(now)
    elseif fishingState == FState.Waiting then
        mouseUp()
    elseif fishingState == FState.FirstPull then
        handleLegitFirstPull(now)
    elseif fishingState == FState.Reeling then
        handleLegitReeling(now)
    elseif fishingState == FState.Caught then
        handleLegitCaught(now)
    else
        mouseUp()
    end
end

--==============================================================
-- OP ENGINE
--==============================================================

local function stepOP()
    local now = os.clock()

    if State.Phase == "Idle" then
        if now >= State.NextCastAt then
            sendOPCast()
        end
        return
    end

    if State.Phase == "Casting"
        and State.CastAckDeadline > 0
        and now >= State.CastAckDeadline then
        warnf("OP cast acknowledgement timed out; retrying")
        resetOPSession(Config.RecastDelay)
        return
    end

    if State.Phase ~= "Idle"
        and now - State.LastPacketAt >= Config.StallTimeout then
        warnf("OP session stalled; cancelling and retrying")
        safeFire(FishingPackets.FishCancel)
        resetOPSession(Config.RecastDelay)
        return
    end

    if State.Phase ~= "Reeling" then
        return
    end

    local qteActive = now < State.QTEActiveUntil
    local suppressed = now < State.SkillSuppressedUntil or now < State.BossStunnedUntil

    local holdForQuestFinisher = questFinisherHoldActive()

    if not qteActive
        and not suppressed
        and not holdForQuestFinisher
        and now >= State.NextReelAt then

        sendOPReelPull()
    end

    if Config.AutoSkills
        and not qteActive
        and not suppressed
        and now >= State.NextSkillAt then

        trySendOPSkill()
        State.NextSkillAt = now + math.max(0.35, Config.SkillInterval)
    end
end

