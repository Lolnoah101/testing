    State.CurrentFishingState = newState
    State.StateEnteredAt = os.clock()

    if newState ~= FState.Holding and newState ~= FState.Throwing then
        mouseUp()
    end

    if newState == FState.Reeling then
        State.NextReelAt = 0
        State.NextSkillAt = 0
        State.SkillIndex = 1
    elseif newState == FState.Caught then
        State.NextLootClickAt = State.StateEnteredAt + Config.LootClickDelay
    elseif newState == FState.Idling then
        State.LastCastStarted = math.max(State.LastCastStarted, os.clock())
    end

    if Config.Mode == "Legit" then
        log("Legit state ->", newState)
    end
end

