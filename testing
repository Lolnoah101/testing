Aux.installExtensions = function()
local function collectFarmMobs()
    local now = os.clock()
    if now - Aux.mobFarmLastScan < 0.30 then return Aux.mobFarmCandidates end
    Aux.mobFarmLastScan = now
    local result = {}
    local folder = Workspace:FindFirstChild("Enemies")
    if not folder then
        Aux.mobFarmCandidates = result
        return result
    end
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("Model") then
            local species = item:GetAttribute("Species") or item.Name
            local dungeonTag = item:GetAttribute("Dungeon")
            if Aux.selectedMobIds[species]
                and (dungeonTag == nil or dungeonTag == false or dungeonTag == "")
                and (item:GetAttribute("EnemyId") ~= nil or item:GetAttribute("Species") ~= nil) then
                local pos, cf, hp = validDungeonEnemy(item)
                if pos then
                    result[#result + 1] = {
                        model = item, pos = pos, cf = cf, hp = hp,
                        bossPriority = Aux.selectedBossMobIds[species] == true,
                    }
                end
            end
        end
    end
    Aux.mobFarmCandidates = result
    return result
end

Aux.updateMobFarm = function()
    if not Aux.autoMobFarm then return end
    if Aux.mobFarmTargetModel and Aux.noteFarmKill then
        Aux.noteFarmKill(Aux.mobFarmTargetModel, Aux.mobFarmTargetLastPos)
    end
    if Aux.spiritPriorityActive then
        Aux.mobFarmStatus = "PAUSED: " .. Aux.spiritPriorityStatus
        if not priority.focusId and farmMover.Hold then farmMover.Hold() end
        return
    end
    if Aux.rankApproachActive then
        Aux.mobFarmStatus = "Paused: visiting rank elder"
        return
    end
    if isDungeonPlace() then
        Aux.mobFarmStatus = "Paused inside dungeon"
        return
    end
    if Aux.travelBusy then
        if farmMover.Stop then farmMover.Stop(true) end
        Aux.mobFarmStatus = "Paused while traveling"
        return
    end
    if Aux.pauseMobFarmForDungeon then
        if farmMover.Stop then farmMover.Stop(true) end
        Aux.mobFarmStatus = "Paused: joining available dungeon portal"
        return
    end
    if not next(Aux.selectedMobIds) then
        if farmMover.Hold then farmMover.Hold() end
        Aux.mobFarmStatus = "Select one or more mobs in the dropdown"
        return
    end
    local root = getRoot()
    if not root then Aux.mobFarmStatus = "Waiting for character" return end
    local candidates = collectFarmMobs()
    Aux.mobFarmCount = #candidates
    -- Boss priority applies to selected bosses only. If a boss appears while
    -- farming a normal mob, switch to that boss on the next scan. Once locked
    -- on a live boss, keep it until defeated/despawned rather than thrashing.
    local closestBoss, bossDistance = nil, math.huge
    local closestNormal, normalDistance = nil, math.huge
    local lockedBoss, lockedNormal = nil, nil
    local visibleBosses = 0
    for _, mob in ipairs(candidates) do
        local dist = (root.Position - mob.pos).Magnitude
        if mob.bossPriority then
            visibleBosses += 1
            if dist < bossDistance then
                closestBoss, bossDistance = mob, dist
            end
            if mob.model == Aux.mobFarmTargetModel then lockedBoss = mob end
        else
            if dist < normalDistance then
                closestNormal, normalDistance = mob, dist
            end
            if mob.model == Aux.mobFarmTargetModel then lockedNormal = mob end
        end
    end
    Aux.mobFarmVisibleBosses = visibleBosses
    local nearest
    if closestBoss then
        nearest = lockedBoss or closestBoss
    else
        nearest = (lockedNormal
            and (lockedNormal.pos - root.Position).Magnitude < 100)
            and lockedNormal or closestNormal
    end
    if not nearest then
        if farmMover.Hold then farmMover.Hold() end
        Aux.mobFarmTarget = "None"
        Aux.mobFarmTargetModel = nil
        Aux.mobFarmStatus = next(Aux.selectedBossMobIds)
            and "Selected bosses/mobs not spawned; waiting"
            or "No selected mobs loaded/spawned; waiting"
        return
    end
    if Aux.mobFarmTargetModel ~= nearest.model then
        Aux.mobFarmTargetModel = nearest.model
        dungeonMovementToken += 1
        cancelDungeonTween()
        currentMovementGoal = nil
        nextMovementAction = 0
        nextLegitRepath = 0
    end
    local species = nearest.model:GetAttribute("Species") or nearest.model.Name
    Aux.mobFarmTarget = tostring((Animals[species] and Animals[species].DisplayName) or species)
    Aux.mobFarmTargetLastPos = nearest.pos
    local distanceToMob = (root.Position - nearest.pos).Magnitude
    local priorityText = nearest.bossPriority and "BOSS PRIORITY"
        or (next(Aux.selectedBossMobIds) and "Boss not spawned; farming mobs"
            or "Normal mob farming")
    Aux.mobFarmStatus = string.format("%s | Target: %s | %.1f studs | HP: %s",
        priorityText, Aux.mobFarmTarget, distanceToMob, tostring(nearest.hp or "?"))
    local position = targetPosition(nearest) -- shared Combat position & distance
    if farmMethod == "Legit" then
        if farmMover.Stop then farmMover.Stop() end
        navigateTo(position, nearest.pos, "Legit", 4)
    else
        cancelDungeonTween()
        farmMover.SetTarget(nearest)
    end
    local now = os.clock()
    if now - Aux.mobFarmLastAttack < getWeaponInterval() then return end
    root = getRoot()
    if not root or (root.Position-nearest.pos).Magnitude > 18 then return end
    local direction = farmMover.AttackDirection(nearest, root)
    if not direction then return end
    if now-Aux.mobFarmLastAttack > (Progression.ComboResetTime or 1.1) then
        Aux.mobFarmCombo=0
    end
    local count=#Progression.ComboMultipliers
    Aux.mobFarmCombo=count > 0 and (Aux.mobFarmCombo % count + 1) or 1
    AttackRemote:FireServer(Aux.mobFarmCombo,direction)
    Aux.mobFarmLastAttack=now
end

