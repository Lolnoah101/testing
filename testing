    local notifyKey = key .. ":" .. reason .. ":" .. message
    if now - (state.AvatarNoticeHistory[notifyKey] or -math.huge) < (cooldown or 18) then return end
    state.AvatarNoticeHistory[notifyKey] = now
    notifyAvatar(reason, message, 5)
end

local function tryCraftAvatar(data)
    if type(data.Avatars) ~= "table" or type(data.Inventory) ~= "table" then return false end
    local key = state.AvatarName .. (state.AvatarShiny and " Shiny" or "")
    local info = avatarDefinitions()[key]
    -- Never show a crafted-success notification before replicated data confirms it.
    local pending = state.AvatarCraftPending
    if pending then
        local confirmed = type(data.Avatars[pending.key]) == "table"
            and data.Avatars[pending.key][pending.part]
        if confirmed then
            notifyAvatar("Craft successful", pending.key .. " " .. pending.part .. " crafted successfully!", 5)
            state.AvatarCraftPending = nil
        elseif os.clock() - pending.sentAt > 12 then
            craftNotice(pending.key .. pending.part, "Craft not confirmed",
                "The server did not confirm crafting. Check your materials.", 25)
            state.AvatarCraftPending = nil
        else
            return false -- no second craft while waiting
        end
    end
    if not state.AutoCraftAvatars then return false end
    if not info or type(info.Crafts) ~= "table" then return false end
    local already = data.Avatars[key] or {}
    for _, part in ipairs({ "Head", "Torso", "Arms", "Legs" }) do
        if state.AvatarParts[part] and not already[part] then
            -- Shiny avatar parts require their matching normal part first.
            if state.AvatarShiny and not ((data.Avatars[state.AvatarName] or {})[part]) then
                craftNotice(key .. part, "Normal avatar required",
                    "Craft " .. state.AvatarName .. " " .. part .. " before the shiny version.", 25)
            else
                local costs = info.Crafts[part]
                local costList, missing = {}, {}
                if type(costs) == "table" then
                    for _, cost in ipairs(costs) do
                        if type(cost) == "table" then
                            local item, required = cost[2], tonumber(cost[3])
                            if cost[1] == "Item" and item ~= nil and required then
                                local owned = tonumber(data.Inventory[item]) or 0
                                costList[#costList+1] = item
                                if owned < required then
                                    missing[#missing+1] = string.format(
                                        "%s: missing %d (have %d/%d)", tostring(item),
                                        required-owned, owned, required)
                                end
                            else
                                missing[#missing+1] = "Unknown required material"
                            end
                        end
                    end
                end
                if #missing > 0 or #costList == 0 then
                    craftNotice(key .. part, "Cannot craft " .. key .. " " .. part,
                        table.concat(missing, "; ") ~= "" and table.concat(missing, "; ")
                        or "Craft requirements are unavailable.", 25)
                else
                    local attemptKey = key .. ":" .. part
                    local now = os.clock()
                    if now - (state.LastAvatarCraft[attemptKey] or -math.huge) > 8 then
                        state.LastAvatarCraft[attemptKey] = now
                        state.AvatarCraftPending = { key = key, part = part, sentAt = now }
                        bridge:FireServer("General", "Avatars", "Craft", key, part)
                        return true
                    end
                end
            end
        end
    end
    return false
end

