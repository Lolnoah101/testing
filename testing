function Hub:InstallV44Runtime()
    local E=self.V44
    local nextUpdate=0
    local running=false
    table.insert(self.Connections,RunService.Heartbeat:Connect(function()
        if not self.Running or running then return end
        local now=os.clock()
        if now<nextUpdate then return end
        nextUpdate=now+.16
        running=true
        task.spawn(function()
            local success,reason=pcall(function()
                if self.V69Trip then
                    E.ActivityOwner=self.V69Trip.Owner
                    E.ActivityUntil=now+3
                elseif E.ActivityOwner and now>E.ActivityUntil then
                    E.ActivityOwner=nil
                end
                local jobs={"V44NenUnlockTick","V44MeditationTick",
                    "V44SkillTick","V44AbilitiesTick","V44WeaponTick","V44MissionTick",
                    "V44MineTick","V45FishingTick","V44CraftTick","V73LearnRecipesTick","V44LineageTick","V44SellTick"}
                for _,fn in ipairs(jobs) do
                    if not self.Running then break end
                    if self.V70NenPriority and fn~="V44NenUnlockTick" then continue end
                    local ok,err=pcall(self[fn],self,now)
                    if not ok then
                        E.LastError=fn..": "..tostring(err)
                        E.Status=E.LastError
                        self.Stats.Errors+=1;self.Stats.LastError=E.LastError
                        self:V44Log(E.LastError)
                    end
                end
                local experience=tonumber(LocalPlayer:GetAttribute("Experience"))
                    or tonumber(LocalPlayer:GetAttribute("Exp")) or tonumber(LocalPlayer:GetAttribute("XP"))
                if experience and now-E.XPLastAt>=5 then
                    if E.XPPrevious and experience>=E.XPPrevious then
                        local elapsed=now-E.XPLastAt
                        local rate=(experience-E.XPPrevious)*60/math.max(elapsed,.01)
                        E.XPPerMinute=E.XPPerMinute and E.XPPerMinute*.7+rate*.3 or rate
                    end
                    E.XPLastAt=now;E.XPPrevious=experience
                end
            end)
            running=false
            if not success and self.Running then
                self.Stats.Errors+=1
                self.Stats.LastError="V53 worker scheduler: "..tostring(reason)
            end
        end)
    end))
end
