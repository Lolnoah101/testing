-- v120: Multi-select Raid CHESTS workflow (Free, Premium, or both).
-- Open each eligible selected chest using the native Chests.Open controller,
-- allow its animation to complete, and only then call native Chests.Finish.
-- If Premium is selected without a key, skip it and FINISH normally.
Farm.initializeRaidsUI = function()
    if Farm.isLobbyPlace or Farm.isMenuPlace then return end
    local raid = {
        choices = {Free = true, Premium = false},
        autoOpen = false, phase = "idle", lastStatus = "Waiting for Raid chests",
        activeChoice = nil, openedAt = nil, claimedAt = nil, finishAt = nil,
        lastProbe = 0, lastSnapshot = nil, pending = false,
        skippedPremium = false, runToken = 0,
        waitingSince = nil, probePending = false, probeStartedAt = nil,
        probeTimedOut = false, actionStartedAt = nil,
    }
    Farm.RaidChest = raid

    local function clearRun()
        raid.runToken = raid.runToken + 1
        raid.phase = "idle"
        raid.activeChoice = nil
        raid.openedAt = nil
        raid.claimedAt = nil
        raid.finishAt = nil
        raid.lastProbe = 0
        raid.lastSnapshot = nil
        raid.pending = false
        raid.skippedPremium = false
        raid.waitingSince = nil
        raid.probePending = false
        raid.probeStartedAt = nil
        raid.probeTimedOut = false
        raid.actionStartedAt = nil
    end

    Farm.resetRaidChestForNewMatch = clearRun

    -- This is still the game's native Actor-local controller, not a direct
    -- S_Rewards request or a simulated mouse click.
    local function nativeCall(action, choice)
        local bridge, reason = resolveSlashBridge()
        if not bridge then return false, tostring(reason or "Actor bridge unavailable") end
        local ok, accepted, response = pcall(function()
            return bridge:Invoke("raid_chest", {action = action, choice = choice})
        end)
        if not ok then return false, "Actor invocation error: " .. tostring(accepted) end
        return accepted == true, response
    end

    local function takeAction(action, nextPhase, atField, choice)
        if raid.pending then return end
        raid.pending = true
        raid.actionStartedAt = os.clock()
        local token = raid.runToken
        raid.lastStatus = "Calling native " .. action .. " controller"
        task.spawn(function()
            local accepted, detail = nativeCall(action, choice)
            if Farm.unloaded or token ~= raid.runToken then return end
            raid.pending = false
            raid.actionStartedAt = nil
            if not raid.autoOpen then return end
            if not accepted then
                raid.phase = "failed"
                raid.lastStatus = tostring(detail or "Native controller unavailable")
            else
                raid[atField] = os.clock()
                raid.phase = nextPhase
                raid.lastStatus = tostring(detail or ("Native " .. action .. " invoked"))
            end
        end)
    end

    local function isClaimed(info, choice)
        return choice == "Free" and info.freeClaimed == true
            or choice == "Premium" and info.premiumClaimed == true
    end

    -- Called from the existing 0.5 second session Heartbeat. Do not attempt
    -- new opens while the previous chest's animation/controller is busy.
    Farm.tryRaidChest = function(resultVisible)
        if Farm.unloaded or not raid.autoOpen then return false end
        if Workspace:GetAttribute("Type") ~= "Raids" then
            if raid.phase ~= "idle" then clearRun() end
            return false
        end
        if not raid.choices.Free and not raid.choices.Premium then
            raid.lastStatus = "Select Free Chest and/or Premium Chest"
            return false
        end
        local now = os.clock()
        if resultVisible and not raid.waitingSince then raid.waitingSince = now end
        if raid.pending then
            if now - (raid.actionStartedAt or now) <= 20 then return true end
            raid.runToken = raid.runToken + 1
            raid.pending = false
            raid.phase = "failed"
            raid.lastStatus = "Chest action timed out; Auto Retry released"
            return false
        end
        if raid.probePending then
            if now - (raid.probeStartedAt or now) > 12 then
                -- A hung BindableFunction invoke must not spawn more probes.
                raid.probeTimedOut = true
                raid.phase = "failed"
                raid.lastStatus = "Chest status timed out; Auto Retry released"
                return false
            end
        elseif not raid.probeTimedOut and now - (raid.lastProbe or 0) >= 0.8 then
            raid.lastProbe = now
            raid.probePending = true
            raid.probeStartedAt = now
            local token = raid.runToken
            task.spawn(function()
                local ok, info = nativeCall("status")
                if Farm.unloaded or token ~= raid.runToken or raid.probeTimedOut then return end
                raid.probePending = false
                if ok and type(info) == "table" then
                    raid.lastSnapshot = info
                else
                    raid.lastStatus = "Waiting for native controller: " .. tostring(info)
                end
            end)
        end
        local info = raid.lastSnapshot
        if not info then
            if raid.waitingSince and now - raid.waitingSince > 25 then
                raid.phase = "failed"
                raid.lastStatus = "Chest controller unavailable; Auto Retry released"
                return false
            end
            -- Do not block a visible normal Rewards/Retry screen just because
            -- the independent CHESTS controller hasn't loaded.
            return not resultVisible
        end

        if raid.phase == "idle" then
            if not info.ready then
                raid.lastStatus = "Waiting for CHESTS controller (" .. tostring(info.state) .. ")"
                -- On the normal results UI, this is not an active chest
                -- animation; do not block Auto Retry indefinitely.
                if resultVisible and raid.waitingSince
                    and now - raid.waitingSince >= 15 then return false end
                return not resultVisible
            end
            if info.credit == nil then
                raid.lastStatus = "Waiting for raid credit data"
                return true
            end
            -- Free first. This leaves Premium for second, if both are selected.
            local choice = nil
            if raid.choices.Free and not info.freeClaimed then
                choice = "Free"
            elseif raid.choices.Premium and not info.premiumClaimed then
                choice = "Premium"
            end
            if choice == "Premium" and info.keys == nil then
                raid.lastStatus = "Waiting for Emperor's Key inventory"
                return true
            end
            if choice == "Premium" and info.keys < 1 then
                raid.skippedPremium = true
                choice = nil
            end
            if choice and info.credit < 5 then
                -- Chest.Open would reject this claim. Continue through the
                -- native FINISH flow rather than repeatedly attempting it.
                choice = nil
                raid.lastStatus = "Raid credit below 5%; finishing without opening"
            end
            if choice then
                raid.activeChoice = choice
                raid.phase = "opening"
                takeAction("open", "verify_open", "openedAt", choice)
            else
                raid.phase = "finishing"
                takeAction("finish", "verify_finish", "finishAt", nil)
            end
            return true
        end

        if raid.phase == "opening" or raid.phase == "finishing" then return true end
        if raid.phase == "verify_open" then
            if isClaimed(info, raid.activeChoice) then
                raid.phase = "animation"
                raid.claimedAt = now
                raid.lastStatus = raid.activeChoice .. " claimed; waiting for animation"
            elseif now - (raid.openedAt or now) > 10 then
                raid.phase = "failed"
                raid.lastStatus = "Native OPEN returned, but the claim was not confirmed"
            end
            return true
        end
        if raid.phase == "animation" then
            if not isClaimed(info, raid.activeChoice) then
                raid.phase = "failed"
                raid.lastStatus = "Chest claim state disappeared; FINISH not sent"
                return true
            end
            -- The game hides the CHESTS UI during opening and restores it
            -- after the reveal. Await that reset before the next chest.
            if not info.ready or info.animating
                or now - (raid.claimedAt or now) < 3 then
                if now - (raid.claimedAt or now) > 45 then
                    raid.phase = "failed"
                    raid.lastStatus = "Chest animation did not finish; no new claim sent"
                end
                return true
            end
            raid.lastStatus = raid.activeChoice .. " opened successfully"
            raid.activeChoice = nil
            raid.phase = "idle"
            return true
        end
        if raid.phase == "verify_finish" then
            if info.finished then
                raid.phase = "done"
                raid.lastStatus = raid.skippedPremium
                    and "CHESTS finished (Premium skipped: no Emperor's Key)"
                    or "Native CHESTS flow completed"
                return false
            elseif now - (raid.finishAt or now) > 12 then
                raid.phase = "failed"
                raid.lastStatus = "FINISH called but chest screen is still open"
            end
            return true
        end
        if raid.phase == "failed" or raid.phase == "done" then
            -- Do not reissue opening or FINISH after a completed attempt.
            return false
        end
        return false
    end

    local raidsTab = window:CreateTab({name = "Raids"})
    raidsTab:CreateSection({name = "Raid Chests"})
    raid.statusText = raidsTab:CreateText({
        name = "Chest Status", text = "Waiting for Raid chests",
    })
    raidsTab:CreateDropdown({
        name = "Chest Type", options = {"Free Chest", "Premium Chest"},
        multiSelect = true,
        value = {"Free Chest"}, flag = "RaidChestChoicesV120",
        callback = function(selected)
            local chosen = {Free = false, Premium = false}
            if type(selected) == "string" then selected = {selected} end
            if type(selected) == "table" then
                for key, value in pairs(selected) do
                    local option = type(key) == "number" and value
                        or (value == true and key or nil)
                    if option == "Free Chest" then chosen.Free = true end
                    if option == "Premium Chest" then chosen.Premium = true end
                end
            end
            if raid.choices.Free ~= chosen.Free or raid.choices.Premium ~= chosen.Premium then
                raid.choices = chosen
                clearRun()
            end
        end,
    })
    raidsTab:CreateToggle({
        name = "Auto Open Chest", value = false, flag = "RaidAutoOpenChestV115",
        callback = function(enabled)
            raid.autoOpen = enabled == true
            if not raid.autoOpen then
                clearRun()
                raid.lastStatus = "Auto Open Chest off"
            end
        end,
    })
end
