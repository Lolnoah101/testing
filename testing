        or n:find("roll",1,true) or n:find("plunge",1,true)
        or n:find("onslaught",1,true)
        or n:find("drill",1,true) or n:find("assult",1,true)
        or n:find("assault",1,true) or n:find("pierce",1,true)
    return {Kind=kind, Ranged=not not ranged, AOE=not not aoe,
        Multi=not not multi, Rush=not not rush, Move=tostring(n)}
end
local knownMeta, knownFractions = {}, Hub.MarkerCache
local function animId(animation)
    if not animation then return nil end
    return tostring(animation.AnimationId):match("(%d+)")
end
local animations = ReplicatedStorage:FindFirstChild("Assets")
animations = animations and animations:FindFirstChild("Animations")
if animations then
    for _, anim in ipairs(animations:GetDescendants()) do
        if anim:IsA("Animation") then
            local parent = anim.Parent
            local ancestry = {}
            while parent and parent ~= animations do
                table.insert(ancestry, 1, parent.Name)
                parent = parent.Parent
            end
            local branch = ancestry[1]
            local npc = branch == "Npcs" and ancestry[2] or nil
            local special = npc and SpecialLookup[npc]
                and SpecialLookup[npc][anim.Name:lower()]
            local basic = npc and isBasicAttack(anim.Name)
            local otherAttack = (branch == "Styles" or branch == "Skills"
                or branch == "NewCombat" or branch == "Fist") and isLikelyAttack(anim.Name)
            if special or basic or otherAttack then
                local id = animId(anim)
                if id then
                    local meta = classifyMove(anim.Name, special == true or (branch == "Skills"))
                    meta.Npc = npc
                    -- Preserve the special classification when IDs overlap.
                    if not knownMeta[id] or meta.Kind == "Special" then knownMeta[id] = meta end
                end
            end
        end
    end
end
local function attackTrack(track)
    local anim = track and track.Animation
    if not anim then return nil end
    local id = animId(anim)
    if id and knownMeta[id] then return knownMeta[id] end
    -- Fallback for animation clones whose library IDs aren't exposed.
    if isLikelyAttack(anim.Name) and not (anim.Name == "Hit" or anim.Name == "M") then
        return classifyMove(anim.Name, false)
    end
    return nil
end
-- Adaptive client-side attack timing, keyed by actual NPC + animation ID.
-- Marker samples are highest confidence; health loss is only circumstantial.
-- Learning cannot reveal server-only hurtboxes or guarantee successful parries.
function Hub:AttackProfile(record, track, create)
    if not record or not track or not track.Animation then return nil end
    local id = animId(track.Animation) or tostring(track.Animation.Name)
    local key = tostring(record.NPCName or record.Model.Name) .. "|" .. id
    local profile = self.AttackPatterns[key]
    if not profile and create then
        profile = {Key=key, Npc=tostring(record.NPCName or record.Model.Name),
            Animation=tostring(track.Animation.Name), Id=id, Seen=0,
            MarkerSamples=0, DamageSamples=0, MeanFraction=nil,
            MarkerGap=nil, GapSamples=0, LastSeen=0, Multi=false,
            TypicalInterval=nil, IntervalSamples=0, PreviousMoves={}}
        self.AttackPatterns[key] = profile
    end
    return profile
end
function Hub:LearnAttackImpact(entry, source)
    if not self.LearnAttacks or not entry or not entry.Track then return end
    local profile = entry.Learned or self:AttackProfile(entry.Record,entry.Track,true)
    if not profile then return end
    entry.Learned=profile
    local track=entry.Track
    local length=track.Length
    if not length or length<0.14 then return end
    local fraction=math.clamp(track.TimePosition/length,0.05,0.95)
    if source=="Marker" then
        profile.MarkerSamples=(profile.MarkerSamples or 0)+1
        self.AttackLearningMarkers+=1
        profile.MeanFraction=profile.MeanFraction and
            (profile.MeanFraction*0.72+fraction*0.28) or fraction
    elseif source=="Damage" then
        profile.DamageSamples=(profile.DamageSamples or 0)+1
        self.AttackLearningDamageSamples+=1
        -- Only use damage timing after repeated observations and only when
        -- no animation marker is available. Nearby hazards can also hurt us.
        if (profile.MarkerSamples or 0)==0 then
            profile.DamageFraction=profile.DamageFraction and
                (profile.DamageFraction*0.82+fraction*0.18) or fraction
        end
    end
    self.AttackLearningLast=profile.Npc.." / "..profile.Animation
end
function Hub:LearnFromDamage(health)
    if not self.LearnAttacks then
        self.AttackLearningPreviousHealth=health
        return
    end
    local prior=self.AttackLearningPreviousHealth
    self.AttackLearningPreviousHealth=health
    if type(prior)~="number" or health>=prior-0.25 then return end
    local _,playerRoot=myCharacter()
    if not playerRoot then return end
    local best,bestScore=nil,math.huge
    local now=os.clock()
    for _,entry in pairs(self.Tracks) do
        local record=entry.Record
        if entry.Track and entry.Track.IsPlaying and record and record.Root
            and record.Root.Parent and now-entry.Started<2.5 then
            local d=(record.Root.Position-playerRoot.Position).Magnitude
            local limit=(entry.Meta.AOE or entry.Meta.Ranged) and 40 or 18
            if d<=limit then
                local score=d + (now-entry.Started)*4
                if score<bestScore then best,bestScore=entry,score end
            end
        end
    end
    if best and now-(best.LastDamageSampleAt or 0)>.16 then
        best.LastDamageSampleAt=now
        self:LearnAttackImpact(best,"Damage")
    end
end
function Hub:AttachAttackLearningHealth(char)
    if self.AttackLearningHealthConnection then
        pcall(function() self.AttackLearningHealthConnection:Disconnect() end)
        self.AttackLearningHealthConnection=nil
    end
    self.AttackLearningHealthHum=nil
    self.AttackLearningPreviousHealth=nil
    if not char then return end
    task.spawn(function()
        local hum=char:FindFirstChildOfClass("Humanoid")
            or char:WaitForChild("Humanoid",5)
        if not self.Running or LocalPlayer.Character~=char or not hum then return end
        self.AttackLearningHealthHum=hum
        self.AttackLearningPreviousHealth=hum.Health
        self.AttackLearningHealthConnection=hum.HealthChanged:Connect(function(h)
            if self.Running then self:LearnFromDamage(h) end
        end)
    end)
end
function Hub:LearnedAttackSummary()
    local count,markers,damage=0,0,0
    for _,profile in pairs(self.AttackPatterns) do
        count+=1; markers+=profile.MarkerSamples or 0
        damage+=profile.DamageSamples or 0
    end
    return count,markers,damage
end

