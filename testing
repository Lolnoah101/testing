            Notify(
                "Codes",
                "Account level is not ready yet.",
                5
            )
            return
        end

        RedeemingCodes = true

        local Redeemed = BuildRedeemedCodeSet(Data)
        local Available = {}
        local Locked = 0
        local AlreadyRedeemed = 0

        local SeenCodes = {}


        local function AddCode(Code, MinimumLevel)

            if type(Code) ~= "string"
                or Code == ""
            then
                return
            end


            local Upper =
                string.upper(Code)


            if SeenCodes[Upper] then
                return
            end


            SeenCodes[Upper] = true
            MinimumLevel = tonumber(MinimumLevel) or 0


            if Redeemed[Upper] then
                AlreadyRedeemed += 1
            elseif Level < MinimumLevel then
                Locked += 1
            else
                table.insert(
                    Available,
                    {
                        code = Code,
                        minimumLevel = MinimumLevel,
                    }
                )
            end
        end


        if type(CodesConfig) == "table" then

            for _, Definition in pairs(CodesConfig) do

                if type(Definition) == "table" then

                    AddCode(
                        Definition.Code,
                        Definition.MinimumLevel
                    )
                end
            end
        end


        -- These two are published in the current Update Log but are not
        -- present in codesConfig in this build. Keep them as an additional
        -- source and de-duplicate automatically if the config gains them.
        AddCode("SORRYFORDELAY", 25)
        AddCode("NEWRAID", 50)

        table.sort(
            Available,
            function(A, B)
                if A.minimumLevel == B.minimumLevel then
                    return string.lower(A.code)
                        < string.lower(B.code)
                end

                return A.minimumLevel < B.minimumLevel
