-- For ordinary attacks the controller transmits ("Attack", nil, clientSequence).
-- Training attacks use only ("Attack"). Actual acceptance, power gains, damage,
-- and combo timing are owned by the server; bypassing client animations cannot
-- force the server to award anything.
local function directAttack(character)
    if enabled._swordSwap.active and enabled.BestSword then return end
    if enabled.AutoDodge and Scheduler.dodge and Scheduler.dodge.active then return end
    local now = os.clock()
    if now < nextAttackTime or now < Scheduler.combat.attackPauseUntil
        or Scheduler.combat.preparing then return end
    if character:GetAttribute("StationTraining") then return end
    if character:GetAttribute("Training") == true then
        local ok, err = pcall(function()
            CombatRequest:FireServer("Attack")
        end)
        if not ok then
            warn("[Arise Combat] Training remote:", err)
        end
        nextAttackTime = now + math.max(0.1, CombatConfig.RequestInterval or 0.08)
        comboIndex = 0
        lastAttackTime = -math.huge
        return
    end

    local weapon = nil
    local okWeapon, config = pcall(function()
        return WeaponConfig.get(character:GetAttribute("EquippedWeapon"))
    end)
    if okWeapon and type(config) == "table" then
        weapon = config
    end
    local combo = weapon and weapon.Combo or CombatConfig.Combo
    if type(combo) ~= "table" or #combo == 0 then return end

    local reset = CombatConfig.ComboReset or 1.15
    local nextIndex = (now - lastAttackTime > reset) and 1 or (comboIndex % #combo + 1)
    local step = combo[nextIndex]
    local interval = type(step) == "table" and step.Chain or 0.36
    interval = math.max(CombatConfig.RequestInterval or 0.08, tonumber(interval) or 0.36)

    sequence = sequence + 1
    local ok, err = pcall(function()
        CombatRequest:FireServer("Attack", nil, sequence)
    end)
    if ok then
        comboIndex = nextIndex
        lastAttackTime = now
        nextAttackTime = now + interval
    else
        warn("[Arise Combat] Attack remote:", err)
        nextAttackTime = now + 1
    end
end

