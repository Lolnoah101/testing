        if not model or model == LocalPlayer.Character or not model.Parent then return end
        local hum=model:FindFirstChildOfClass("Humanoid")
        local part=model:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health<=0 or not part or model:GetAttribute("non_hit_npc")==true then return end
        if model:HasTag("Knocked") or model:GetAttribute("Dead")==true then return end
        if mode == 3 then
            local owner=Players:GetPlayerFromCharacter(model)
            if owner and (owner:GetAttribute("Spectating") == true or owner:GetAttribute("WaitingSpectator") == true) then return end
        end
        local d=(part.Position-root.Position).Magnitude
        if not dist or d<dist then closest=model;dist=d end
    end
    if mode == 4 then
        local left,right=workspace:GetAttribute("DuelLeft"),workspace:GetAttribute("DuelRight")
        local selected
        if left==LocalPlayer.Name or left==LocalPlayer.DisplayName then selected=right
        elseif right==LocalPlayer.Name or right==LocalPlayer.DisplayName then selected=left end
        if type(selected)~="string" or selected=="" then return nil end
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr.Name==selected or plr.DisplayName==selected then consider(plr.Character) end
        end
        for _,m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and (m.Name==selected or m:GetAttribute("ExamDuelName")==selected) then consider(m) end
        end
    else
        if X.HasOwnTag==false and X.Holder then
            local holder=X.Holder
            if holder:IsA("Player") then holder=holder.Character end
            consider(holder)
            if closest then return closest end
        end
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LocalPlayer then consider(plr.Character) end
        end
        for _,m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and m:GetAttribute("ZevilNpc")==true then consider(m) end
        end
    end
    return closest
end
