-- v125: The Outskirts client Rewards.Setup script only READS Workspace.Seconds
-- to display Time Taken after the match completes. The uploaded client place
-- has no live Seconds writer; the attribute must not be treated as a running
-- stopwatch. Otherwise a stale 0:33 snapshot falsely becomes a live clock.
-- The active-match timer is an independent *estimate*, starting on the first
-- locally visible live Titan (or a user-requested manual reset). Its timebase
-- is the server-synchronized monotonic clock, not executor CPU time. It does
-- not claim to control the server's official Time Taken statistic.
Farm.clockNow = function()
    local ok, val = pcall(function() return Workspace:GetServerTimeNow() end)
    if ok and type(val) == "number" and val > 0 then return val end
    return os.clock() -- fallback for executors lacking server-time support
end

local function formatTime(seconds)
    seconds = math.max(0, math.floor((tonumber(seconds) or 0) + 0.001))
    return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function parseTime(raw)
    local minutes, seconds = tostring(raw or ""):match("^%s*(%d+)%s*:%s*(%d%d?)%s*$")
    minutes, seconds = tonumber(minutes), tonumber(seconds)
    if not minutes or not seconds or seconds > 59 or minutes > 999 then
        return nil
    end
    return minutes * 60 + seconds
end

local function getMatchElapsed()
    local now = Farm.clockNow()
    local reported = Workspace:GetAttribute("Seconds")
    if type(reported) == "number" and reported >= 0 and reported < 36000 then
        -- Remember the reported value only for display and post-match comparison.
        -- DO NOT reset or re-anchor the active stopwatch when it changes.
        Farm.matchServerSecondsLast = reported
    end
    if Farm.timerSawResults then
        if type(reported) == "number" and reported >= 0 then
            Farm.matchLastElapsed = reported
            Farm.matchSource = "Official results (game Seconds)"
            return reported, Farm.matchSource
        end
        -- A result UI might appear before Seconds replicates; distinguish the
        -- pending official value from the local match estimate.
        Farm.matchSource = "Results (official time pending)"
        return math.max(0, Farm.matchLastElapsed or 0), Farm.matchSource
    end

    if Farm.matchClockManual then
        local start = Farm.matchActiveSince
        if type(start) ~= "number" then
            start = now
            Farm.matchActiveSince = start
        end
        local elapsed = math.max(0, now - start)
        Farm.matchLastElapsed = elapsed
        Farm.matchSource = "Manual start (estimate)"
        return elapsed, Farm.matchSource
    end

    -- Only the actual live Titan detection establishes a reliable approximate
    -- active-game start in the exported client. A match's Finalised attribute
    -- can change during player loading and is not the server's stopwatch.
    if Farm.matchActiveSince == nil and type(Farm.clockHasActiveTarget) == "function"
        and os.clock() - (Farm.matchClockLastProbeAt or 0) >= 0.25 then
        Farm.matchClockLastProbeAt = os.clock()
        local ok, hasTarget = pcall(Farm.clockHasActiveTarget)
        if ok and hasTarget then
            Farm.matchActiveSince = now
            Farm.matchStartedLocal = os.clock()
        end
    end
    if type(Farm.matchActiveSince) == "number" then
        local elapsed = math.max(0, now - Farm.matchActiveSince)
        Farm.matchLastElapsed = elapsed
        Farm.matchSource = "First Titan (estimate)"
        return elapsed, Farm.matchSource
    end
    Farm.matchLastElapsed = 0
    Farm.matchSource = "Waiting for first Titan"
    return 0, Farm.matchSource
end

