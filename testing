    state.AutoEquipRelics = autoEquipToggle.value == true

    local function equippedUnitRank(data, id)
        local owned = data.Shadows[id]
        local def = owned and getUnitDefinition(owned)
        if not owned or not def then return -math.huge end
        -- Use the game's own damage calculation, excluding existing Relics,
        -- so moving a Relic doesn't reorder the units in a feedback loop.
        if shadowStats and type(shadowStats.calculate_stats_with_multiplier) == "function"
            and type(shadowStats.calculate_stats) == "function" then
            local ownedWithoutRelic = table.clone(owned)
            ownedWithoutRelic.Relic = nil
            local ok, score = pcall(function()
                local base = shadowStats:calculate_stats(def, ownedWithoutRelic)
                return shadowStats:calculate_stats_with_multiplier(
                    data, def, ownedWithoutRelic, base, 1, 1)
            end)
            if ok and type(score) == "number" and score > 0 then return score end
        end
        -- Fallback if this game version changes the shared stat API.
        local level = math.max(0, tonumber(owned.Level) or 0)
        local base = tonumber(def.Damage) or 1
        local rarity = rarityRank[def.Rarity] or 1
        return base * (3 ^ (level / 10)) * rarity
            * (owned.Shiny and 1.75 or 1)
    end

    local function normalizeID(value)
        return value == nil and nil or tostring(value)
    end

    local function runOnce()
        if not state.AutoEquipRelics then return end
        local now = os.clock()
        if now < state.RelicEquipRetryAfter then return end
        local data = getInventoryData()
        if not data or type(data.Relics) ~= "table" then
            state.RelicEquipStatus = "Waiting for Relics inventory"
            return
        end
        local defs = nativeController and nativeController.Shared
            and nativeController.Shared.Relics or relicDefinitions
        if type(defs) ~= "table" then
            state.RelicEquipStatus = "Waiting for Relics definitions"
            return
        end

        local pending = state.RelicEquipPending
        if pending then
            local item = data.Relics[pending.relic]
            local current = item and normalizeID(item.Shadow)
            local confirmed = (pending.kind == "Unequip" and current == nil)
                or (pending.kind == "Equip" and current == pending.target)
            if confirmed then
                state.RelicEquipPending = nil
                state.RelicEquipNextAction = now + 1.5
            elseif now - pending.sentAt <= 8 then
                state.RelicEquipStatus = "Waiting for " .. pending.kind .. " confirmation"
                return
            else
                -- A remote returning without an error is NOT server acceptance.
                state.RelicEquipStatus = pending.kind .. " was not confirmed; retrying later"
                state.RelicEquipPending = nil
                state.RelicEquipRetryAfter = now + 20
                return
            end
        end
        if now < state.RelicEquipNextAction then return end

        local units = {}
        for uid in pairs(data.Shadows_Equipped) do
            if data.Shadows[uid] then
                units[#units + 1] = { id = uid, score = equippedUnitRank(data, uid) }
            end
        end
        table.sort(units, function(a, b)
            if a.score ~= b.score then return a.score > b.score end
            return tostring(a.id) < tostring(b.id)
        end)
        if #units == 0 then
            state.RelicEquipStatus = "No equipped units"
            return
        end

        local relics = {}
        for rid, item in pairs(data.Relics) do
            if type(item) == "table" then
                local def = defs[item.Name]
                local perk = def and def.Perks
                local strength = perk and tonumber(perk[state.RelicEquipPreset]) or 0
                if strength and strength > 0 then
                    relics[#relics + 1] = { id = rid, strength = strength }
                end
            end
        end
        table.sort(relics, function(a, b)
            if a.strength ~= b.strength then return a.strength > b.strength end
            return tostring(a.id) < tostring(b.id)
        end)
        if #relics == 0 then
            state.RelicEquipStatus = "No matching " .. state.RelicEquipPreset .. " Relics"
            return
        end

        -- Assign the best Relic to the strongest equipped Shadow, etc.
        local desiredByRelic = {}
        local desiredByUnit = {}
        for index = 1, math.min(#units, #relics) do
            desiredByRelic[normalizeID(relics[index].id)] = normalizeID(units[index].id)
            desiredByUnit[normalizeID(units[index].id)] = normalizeID(relics[index].id)
        end

        local function send(kind, rid, target)
            local ok = pcall(function()
                if kind == "Unequip" then
                    bridge:FireServer("General", "Relics", "Unequip", rid)
                else
                    bridge:FireServer("General", "Relics", "Equip", target, rid)
                end
            end)
            if ok then
                state.RelicEquipPending = {
                    kind = kind, relic = rid, target = normalizeID(target), sentAt = now
                }
                state.RelicEquipStatus = kind .. " requested; waiting for server"
            else
                state.RelicEquipRetryAfter = now + 20
                state.RelicEquipStatus = "Relic remote failed; retry pending"
            end
        end

        -- Free any desired Relic still attached to a different unit (including
        -- an unequipped unit), and free outdated Relics occupying target slots.
        for rid, item in pairs(data.Relics) do
            if type(item) == "table" and item.Shadow then
                local unitID = normalizeID(item.Shadow)
                local ridText = normalizeID(rid)
                local intendedOwner = desiredByRelic[ridText]
                if intendedOwner and intendedOwner ~= unitID then
                    send("Unequip", rid)
                    return
                end
                if desiredByUnit[unitID] and desiredByUnit[unitID] ~= ridText then
                    send("Unequip", rid)
                    return
                end
            end
        end

        -- Only equip to a genuinely free slot, one confirmed remote at a time.
        local occupied = {}
        for _, item in pairs(data.Relics) do
            if type(item) == "table" and item.Shadow then
                occupied[normalizeID(item.Shadow)] = true
            end
        end
        for index = 1, math.min(#units, #relics) do
            local targetID, relicID = units[index].id, relics[index].id
            local relic = data.Relics[relicID]
            if relic and normalizeID(relic.Shadow) ~= normalizeID(targetID)
                and not relic.Shadow and not occupied[normalizeID(targetID)] then
                send("Equip", relicID, targetID)
                return
            end
        end
        state.RelicEquipStatus = "Best " .. state.RelicEquipPreset .. " Relics equipped"
    end

    task.spawn(function()
        while state.Running do
            local ok, err = pcall(runOnce)
            if not ok then
                state.RelicEquipStatus = "Equipment check error: " .. tostring(err)
                warn("[Paraiso Auto Equip Relics]", err)
                state.RelicEquipRetryAfter = os.clock() + 15
            end
            task.wait(2.5)
        end
    end)
end
