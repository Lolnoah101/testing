-- Stay in the CURRENT SERVER AREA while approaching a far-away rubble wall.
-- A 70-stud cutoff alone stranded the character even for legitimate walks
-- across a long Hxh area. This sends at most a few short, verified steps.
-- If navigation is ambiguous, pause instead of risking a server area skip.
-- HxH rubble approach: one route check followed by exactly one movement
-- order. The old 24-stud safe-step routine was responsible for the repeated
-- short teleports and mid-travel tween resets.
GENV.__AZ_FARM_EXT.RubbleJourney = nil
GENV.__AZ_FARM_EXT.ValidateRubbleDirectRoute = function(Root, Goal, AreaToken)
    local Ext = GENV.__AZ_FARM_EXT
    if not Root or typeof(Goal) ~= "CFrame" then
        return false, "Missing character or rubble goal"
    end
    if Ext.ProgressionFault then
        return false, "Server area progression is paused"
    end
    -- The current area's border is authoritative. The world Area volume
    -- does not necessarily include the visible rubble or its front approach.
    local Token = tonumber(AreaToken)
    if not Token or Token ~= tonumber(Ext.ValidatedArea) then
        return false, "Rubble does not belong to confirmed area"
    end
    local Border = Ext.RubbleLastBorder
    local Rubble = Ext.RubbleLastVisual
    if not Border or not Border.Parent or not Rubble or not Rubble.Parent then
        return false, "Visible rubble is not available"
    end
    local MaxHealth = tonumber(Border:GetAttribute("RubbleMaxHealth"))
    local Health = tonumber(Border:GetAttribute("RubbleHealth")) or MaxHealth
    if not Health or Health <= 0 then
        return false, "Rubble is no longer armed"
    end
    -- The landing position was already raycast onto the real ground in
    -- GetCloseRubbleGoal. Validate it against the visual/marker, NOT the
    -- invisible Blocker length and NOT how far the player currently is.
    local Marker = Ext.RubbleLastMarker
    if Marker and Marker.Parent then
        local FlatGoal = Vector3.new(Goal.Position.X, 0, Goal.Position.Z)
        local FlatMarker = Vector3.new(Marker.WorldPosition.X, 0, Marker.WorldPosition.Z)
        if (FlatGoal - FlatMarker).Magnitude > 15 then
            return false, "Landing position differs from visible rubble marker"
        end
    end
    return true, "Verified current-area visible rubble approach"
end

GENV.__AZ_FARM_EXT.GetCloseRubbleGoal = function(Root, Blocker, Marker, AreaToken)
    local Ext = GENV.__AZ_FARM_EXT
    local World = workspace:FindFirstChild("World")
    -- Use the actual parent of the blocker: it contains the VISUAL Rubble
    -- model and the server-owned health attributes for this border.
    local Border = Blocker and Blocker.Parent
    local Visual = Border and Border:FindFirstChild("Rubble")
    local Token = tostring(AreaToken or "?")
    if not Root or not Root.Parent or not Blocker
        or not Blocker:IsA("BasePart") or not Visual or not Visual.Parent
    then
        Ext.RubbleLastStatus = "Waiting for current border and visible Rubble"
        return nil
    end
    local VisualCF, VisualSize
    if Visual:IsA("Model") then
        VisualCF, VisualSize = Visual:GetBoundingBox()
    elseif Visual:IsA("BasePart") then
        VisualCF, VisualSize = Visual.CFrame, Visual.Size
    else
        Ext.RubbleLastStatus = "Unsupported visible rubble geometry"
        return nil
    end
    local Cache = Ext.RubbleGoals[Blocker]
    local LiveMarker = Marker and Marker:IsA("Attachment") and Marker.Parent
    if Cache and Cache.Area == Token and Cache.Character == Root.Parent
        and Cache.Visual == Visual and typeof(Cache.Goal) == "CFrame"
        and (Cache.Marker == Marker or not LiveMarker)
    then
        Ext.RubbleLastGoal = Cache.Goal
        Ext.RubbleLastBlocker = Blocker
        Ext.RubbleLastVisual = Visual
        Ext.RubbleLastBorder = Border
        Ext.RubbleLastMarker = Cache.Marker
        Ext.RubbleLastSide = Cache.Side
        Ext.RubbleLastArea = Token
        Ext.RubbleLastStatus = "Locked front of visible rubble"
        return Cache.Goal
    end

    -- This is the SAME forward axis and approach side used by the game's
    -- RubbleBar renderer. Its Attachment is placed 5 studs from the actual
    -- visible rubble face; shift ~2 studs toward it for a 3-stud goal.
    local Unit = Vector3.new(Blocker.CFrame.LookVector.X, 0,
        Blocker.CFrame.LookVector.Z)
    if Unit.Magnitude < 0.01 then
        Ext.RubbleLastStatus = "Rubble front axis unavailable"
        return nil
    end
    Unit = Unit.Unit
    local Spawns = World and World:FindFirstChild("Spawns")
    local Spawn = Spawns and Spawns:FindFirstChild(Token)
    if Spawn and Spawn:IsA("BasePart") then
        if (Spawn.Position - Blocker.Position):Dot(Unit) < 0 then
            Unit = -Unit
        end
    elseif LiveMarker then
        if (Marker.WorldPosition - Blocker.Position):Dot(Unit) < 0 then
            Unit = -Unit
        end
    elseif (Root.Position - Blocker.Position):Dot(Unit) < 0 then
        Unit = -Unit
    end

    local TargetXZ, AnchorY, UsedMarker
    if LiveMarker then
        TargetXZ = Marker.WorldPosition - Unit * 2
        AnchorY = Marker.WorldPosition.Y - 14
        UsedMarker = true
    else
        -- While the client creates RubbleBar, reproduce the game's
        -- horizontal raycast AGAINST the visible Rubble, never the Blocker.
        local Ray = RaycastParams.new()
        Ray.FilterType = Enum.RaycastFilterType.Include
        Ray.FilterDescendantsInstances = {Visual}
        local Origin = Vector3.new(Blocker.Position.X,
            VisualCF.Position.Y + VisualSize.Y * 0.5,
            Blocker.Position.Z)
        local Hit = workspace:Raycast(Origin + Unit * 150, -Unit * 300, Ray)
        if not Hit then
            Ext.RubbleLastStatus = "Waiting for visible rubble front raycast"
            return nil
        end
        TargetXZ = Hit.Position + Unit * 3
        AnchorY = VisualCF.Position.Y - VisualSize.Y * 0.5
        UsedMarker = false
    end

    -- Anchor the root to the roadway near the rubble rather than using the
    -- attachment's health-bar height (which is about 14 studs in the air).
    local Human = Root.Parent:FindFirstChildOfClass("Humanoid")
    local RootHeight = math.clamp((Human and Human.HipHeight or 2)
        + Root.Size.Y * 0.5, 2.5, 6.5)
    local Filter = {Root.Parent, Border}
    local Areas = World and World:FindFirstChild("Areas")
    if Areas then table.insert(Filter, Areas) end
    local Enemies = workspace:FindFirstChild("enemies")
    if Enemies then table.insert(Filter, Enemies) end
    local AreaEntries = World and World:FindFirstChild("AreaEntries")
    if AreaEntries then table.insert(Filter, AreaEntries) end
    local RayParams = RaycastParams.new()
    RayParams.FilterType = Enum.RaycastFilterType.Exclude
    RayParams.IgnoreWater = true
    local GroundY
    for _ = 1, 8 do
        RayParams.FilterDescendantsInstances = Filter
        local Hit = workspace:Raycast(
            Vector3.new(TargetXZ.X, AnchorY + 75, TargetXZ.Z),
            Vector3.new(0, -165, 0), RayParams)
        if not Hit then break end
        if Hit.Normal.Y >= 0.65 and math.abs(Hit.Position.Y - AnchorY) < 17
            and Hit.Instance:IsA("BasePart") and Hit.Instance.CanCollide then
            GroundY = Hit.Position.Y
            break
        end
        table.insert(Filter, Hit.Instance)
    end
    if not GroundY then
        Ext.RubbleLastStatus = "No valid roadway at visible rubble front"
        return nil
    end

    local Position = Vector3.new(TargetXZ.X, GroundY + RootHeight, TargetXZ.Z)
    local Face = Position - Unit * 3
    local Goal = CFrame.lookAt(Position, Face, Vector3.yAxis)
    Ext.RubbleGoals[Blocker] = {
        Goal = Goal, Area = Token, Character = Root.Parent,
        Visual = Visual, Marker = LiveMarker and Marker or nil,
        Side = "Visible rubble front",
    }
    Ext.RubbleLastGoal = Goal
    Ext.RubbleLastBlocker = Blocker
    Ext.RubbleLastVisual = Visual
    Ext.RubbleLastBorder = Border
    Ext.RubbleLastMarker = LiveMarker and Marker or nil
    Ext.RubbleLastSide = "Visible rubble front"
    Ext.RubbleLastArea = Token
    Ext.RubbleLastStatus = UsedMarker
        and "3 studs in front of RubbleBar's visible rubble face"
        or "3 studs in front of raycast visible rubble face"
    Ext.RubbleGoalDistanceAtLock = (Root.Position - Position).Magnitude
    Ext.RubbleMarkerDistanceAtLock = LiveMarker
        and (Root.Position - Marker.WorldPosition).Magnitude or nil
    print("[Anime Zero][Rubble] Visible face goal | area:", Token,
        "| distance:", math.floor(Ext.RubbleGoalDistanceAtLock + 0.5),
        "| source:", UsedMarker and "RubbleBar" or "Visual Raycast")
    return Goal
end

